--[[
    Wayfinding: the trail that tells a party which way the run goes.

    Bramblewake learned this the expensive way. A twelve-module walk with
    no thread through it reads as twelve unrelated clearings, and players
    wander back the way they came -- so it grew a lit trail between module
    centres, and the wandering stopped. A new region needs the same thread
    in its own materials, which is all this is: a line of low markers from
    each module to the next, lit enough to find at night and quiet enough
    to ignore in daylight.
]]
function RegionBuilders.buildWayfinding(
    parent: Instance,
    manifest: any,
    catalog: any,
    origin: Vector3,
    markerColor: Color3,
    glowColor: Color3
): number
    local placed = 0
    for index = 1, #manifest.modules - 1 do
        local here = manifest.modules[index]
        local next = manifest.modules[index + 1]
        local from = origin
            + Vector3.new(here.cellX * catalog.CellSize, 0, here.cellZ * catalog.CellSize)
        local to = origin
            + Vector3.new(next.cellX * catalog.CellSize, 0, next.cellZ * catalog.CellSize)
        local span = to - from
        local steps = 5
        for step = 1, steps do
            local at = from + span * (step / (steps + 1))
            local marker = Instance.new("Part")
            marker.Name = "WayMarker"
            marker.Size = Vector3.new(2.2, 1.4, 2.2)
            marker.CFrame = CFrame.new(at + Vector3.new(0, 0.7, 0))
                * CFrame.Angles(0, math.rad((index * 37 + step * 19) % 360), 0)
            marker.Color = markerColor
            marker.Material = Enum.Material.Slate
            marker.Anchored = true
            marker.CanCollide = false
            marker.Parent = parent

            local cue = Instance.new("Part")
            cue.Name = "WayGlow"
            cue.Shape = Enum.PartType.Ball
            cue.Size = Vector3.new(0.6, 0.6, 0.6)
            cue.CFrame = CFrame.new(at + Vector3.new(0, 1.7, 0))
            cue.Color = glowColor
            cue.Material = Enum.Material.Neon
            cue.Anchored = true
            cue.CanCollide = false
            cue.CanQuery = false
            cue.CastShadow = false
            cue.Transparency = 0.55
            cue.Parent = parent
            placed += 1
        end
    end
    return placed
end

--[[
    The look of each region's trail. Ironroot marks its way with the same
    lamps it works by; the Fen uses witchlight on stone, because a lantern
    in the Fen is exactly the thing a player has learned not to trust.
]]
RegionBuilders.Wayfinding = table.freeze({
    region_ironroot = table.freeze({
        marker = Color3.fromRGB(62, 58, 56),
        glow = Color3.fromRGB(255, 206, 128),
    }),
    region_tempest = table.freeze({
        marker = Color3.fromRGB(88, 92, 96),
        glow = Color3.fromRGB(255, 216, 150),
    }),
    region_cinderfall = table.freeze({
        marker = Color3.fromRGB(148, 142, 134),
        glow = Color3.fromRGB(255, 148, 62),
    }),
    region_frostmere = table.freeze({
        marker = Color3.fromRGB(126, 128, 130),
        glow = Color3.fromRGB(238, 128, 54),
    }),
    region_mireglass = table.freeze({
        marker = Color3.fromRGB(76, 78, 74),
        glow = Color3.fromRGB(146, 214, 226),
    }),
})

return table.freeze(RegionBuilders)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="167">
          <Properties>
            <string name="Name">TempestBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Tempest Reach's geometry.

    The Delve reads as underground because every module carries a roof.
    The Fen reads as drowned because every module carries water it wants
    you to mistrust. The Reach reads as exposed: every module carries
    something a person built to stand against weather, and the weather is
    winning. Sea walls with pieces out of them, jetties missing planks,
    rigging still strung between hulls nobody will sail again.

    Its light is not warm. Lamps here are signals rather than comforts --
    a beacon, a mast lantern, a storm kite -- and the only colour with any
    heat in it is the amberglass the lightning leaves behind.
]]

local TempestBuilder = {}

local STONE = Color3.fromRGB(88, 92, 96)
local DARK_STONE = Color3.fromRGB(54, 58, 62)
local PLANK = Color3.fromRGB(96, 84, 68)
local DARK_PLANK = Color3.fromRGB(62, 54, 44)
local HULL = Color3.fromRGB(74, 70, 64)
local IRON = Color3.fromRGB(92, 96, 100)
local ROPE = Color3.fromRGB(158, 142, 106)
local SEA = Color3.fromRGB(44, 68, 78)
local FOAM = Color3.fromRGB(206, 220, 224)
local AMBERGLASS = Color3.fromRGB(238, 178, 96)
local SIGNAL = Color3.fromRGB(255, 216, 150)
local KELP = Color3.fromRGB(66, 88, 62)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function glow(
    parent: Instance,
    name: string,
    position: Vector3,
    size: number,
    color: Color3,
    brightness: number
)
    local orb = part(
        parent,
        name,
        Vector3.new(size, size, size),
        CFrame.new(position),
        color,
        Enum.Material.Neon,
        false
    )
    orb.Shape = Enum.PartType.Ball
    orb.CanQuery = false
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = size * 8
    light.Brightness = brightness
    light.Shadows = false
    light.Parent = orb
end

-- Open water, moving enough to read as weather rather than glass. The Fen
-- mirrors; the Reach churns, which is why this is rough and unreflective.
local function seaWater(parent: Instance, center: Vector3, size: number)
    local water = part(
        parent,
        "ReachWater",
        Vector3.new(size, 1, size * 0.9),
        CFrame.new(center + Vector3.new(0, 0.5, 0)),
        SEA,
        Enum.Material.Water,
        false
    )
    water.Transparency = 0.3
    water.CanQuery = false
    for index = -2, 2 do
        local crest = part(
            parent,
            "Whitecap",
            Vector3.new(size * 0.7, 0.5, 2.2),
            CFrame.new(center + Vector3.new(index * 3, 1.1, index * (size * 0.16)))
                * CFrame.Angles(0, math.rad(index * 7), 0),
            FOAM,
            Enum.Material.Neon,
            false
        )
        crest.Transparency = 0.72
        crest.CanQuery = false
    end
end

-- A worked stone edge: sea wall, breakwater, quay. Pieces missing on
-- purpose, because an intact wall on this coast would be a lie.
local function seaWall(parent: Instance, center: Vector3, length: number, seed: number)
    local blocks = math.max(3, math.floor(length / 7))
    for index = 0, blocks - 1 do
        if (seed + index * 13) % 7 ~= 0 then
            local drift = (seed + index * 29) % 5 - 2
            part(
                parent,
                "SeaWallBlock",
                Vector3.new(6.5, 5 + (index % 2), 7),
                CFrame.new(center + Vector3.new(0, 2.5, -length * 0.5 + index * (length / blocks)))
                    * CFrame.Angles(0, math.rad(drift * 3), math.rad(drift)),
                if index % 3 == 0 then DARK_STONE else STONE,
                Enum.Material.Slate
            )
        end
    end
end

-- Decking on piles: the jetty, the quay, the boat shed floor.
local function jettyDeck(parent: Instance, center: Vector3, length: number, width: number)
    part(
        parent,
        "JettyDeck",
        Vector3.new(width, 0.6, length),
        CFrame.new(center + Vector3.new(0, 3, 0)),
        PLANK,
        Enum.Material.Wood
    )
    local piles = math.max(2, math.floor(length / 8))
    for index = 0, piles do
        for side = -1, 1, 2 do
            part(
                parent,
                "JettyPile",
                Vector3.new(0.9, 6, 0.9),
                CFrame.new(
                    center
                        + Vector3.new(
                            side * (width * 0.5 - 1),
                            0.5,
                            -length * 0.5 + index * (length / piles)
                        )
                ),
                DARK_PLANK,
                Enum.Material.Wood
            )
        end
    end
end

-- A hull, aground and open. The Reach's most repeated silhouette.
local function wreckHull(parent: Instance, center: Vector3, heel: number, scale: number)
    local hull = part(
        parent,
        "WreckHull",
        Vector3.new(7 * scale, 6 * scale, 22 * scale),
        CFrame.new(center + Vector3.new(0, 3 * scale, 0)) * CFrame.Angles(0, 0, math.rad(heel)),
        HULL,
        Enum.Material.Wood
    )
    for index = -2, 2 do
        part(
            parent,
            "HullRib",
            Vector3.new(0.6, 5.5 * scale, 0.6),
            hull.CFrame
                * CFrame.new(0, 3 * scale, index * 3.6 * scale)
                * CFrame.Angles(math.rad(index * 4), 0, 0),
            DARK_PLANK,
            Enum.Material.Wood,
            false
        )
    end
    part(
        parent,
        "WreckMast",
        Vector3.new(0.9, 16 * scale, 0.9),
        hull.CFrame * CFrame.new(0, 8 * scale, -2) * CFrame.Angles(math.rad(-12), 0, 0),
        DARK_PLANK,
        Enum.Material.Wood
    )
end

-- Rope between two points, sagging. Rigging, tow lines, signal chains.
local function ropeRun(parent: Instance, from: Vector3, to: Vector3, sag: number)
    local steps = 6
    for index = 0, steps - 1 do
        local a = from:Lerp(to, index / steps)
        local b = from:Lerp(to, (index + 1) / steps)
        local droop = math.sin((index / steps) * math.pi) * sag
        local mid = a:Lerp(b, 0.5) - Vector3.new(0, droop, 0)
        local length = (b - a).Magnitude + 0.4
        part(
            parent,
            "Rope",
            Vector3.new(0.25, 0.25, length),
            CFrame.lookAt(mid, mid + (b - a).Unit),
            ROPE,
            Enum.Material.Fabric,
            false
        )
    end
end

local function signalMast(parent: Instance, position: Vector3, lit: boolean)
    part(
        parent,
        "SignalMast",
        Vector3.new(0.8, 14, 0.8),
        CFrame.new(position + Vector3.new(0, 7, 0)),
        IRON,
        Enum.Material.Metal
    )
    part(
        parent,
        "SignalArm",
        Vector3.new(5, 0.5, 0.5),
        CFrame.new(position + Vector3.new(0, 12.5, 0)),
        IRON,
        Enum.Material.Metal,
        false
    )
    if lit then
        glow(parent, "SignalLamp", position + Vector3.new(0, 13.4, 0), 1.3, SIGNAL, 2.4)
    end
end

-- A grounding rod: the answer to the storm ray and to the Titan's crown.
local function groundingRod(parent: Instance, position: Vector3)
    part(
        parent,
        "GroundingRod",
        Vector3.new(0.5, 9, 0.5),
        CFrame.new(position + Vector3.new(0, 4.5, 0)),
        IRON,
        Enum.Material.Metal
    )
    local plate = part(
        parent,
        "GroundingPlate",
        Vector3.new(0.4, 4, 4),
        CFrame.new(position + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
        DARK_STONE,
        Enum.Material.Metal,
        false
    )
    plate.Shape = Enum.PartType.Cylinder
    glow(parent, "RodTip", position + Vector3.new(0, 9.2, 0), 0.7, AMBERGLASS, 1.1)
end

-- Amberglass: sand the lightning fused, warm underfoot after dark.
local function amberglassPatch(parent: Instance, center: Vector3, seed: number)
    for index = 0, 3 do
        local angle = (seed + index * 41) % 360
        local shard = part(
            parent,
            "Amberglass",
            Vector3.new(2.4 - index * 0.3, 0.5, 2.8 - index * 0.3),
            CFrame.new(center + Vector3.new(math.cos(angle) * 2.4, 0.4, math.sin(angle) * 2.4))
                * CFrame.Angles(0, math.rad(angle), math.rad((index % 3) * 4)),
            AMBERGLASS,
            Enum.Material.Glass,
            false
        )
        shard.Transparency = 0.25
        shard.Reflectance = 0.3
    end
    glow(parent, "AmberglassWarmth", center + Vector3.new(0, 0.9, 0), 1.1, AMBERGLASS, 0.9)
end

local function kelpRack(parent: Instance, center: Vector3)
    for side = -1, 1, 2 do
        part(
            parent,
            "RackPost",
            Vector3.new(0.6, 7, 0.6),
            CFrame.new(center + Vector3.new(side * 5, 3.5, 0)),
            DARK_PLANK,
            Enum.Material.Wood
        )
    end
    part(
        parent,
        "RackBeam",
        Vector3.new(11, 0.5, 0.5),
        CFrame.new(center + Vector3.new(0, 7, 0)),
        DARK_PLANK,
        Enum.Material.Wood,
        false
    )
    for index = -2, 2 do
        part(
            parent,
            "HangingKelp",
            Vector3.new(0.7, 5, 0.2),
            CFrame.new(center + Vector3.new(index * 2, 4.2, 0))
                * CFrame.Angles(0, 0, math.rad(index * 3)),
            KELP,
            Enum.Material.Fabric,
            false
        )
    end
end

--[[
    The Reach's ground: wet stone and shingle, with a tide line the
    weather has drawn and redrawn.
]]
local function reachGround(parent: Instance, center: Vector3)
    local ground = part(
        parent,
        "ReachGround",
        Vector3.new(56, 1, 56),
        CFrame.new(center + Vector3.new(0, 0.2, 0)),
        DARK_STONE,
        Enum.Material.Slate,
        false
    )
    ground.CanQuery = false
    local tideLine = part(
        parent,
        "TideLine",
        Vector3.new(56, 0.3, 3),
        CFrame.new(center + Vector3.new(0, 0.8, 8)),
        Color3.fromRGB(102, 96, 74),
        Enum.Material.Sand,
        false
    )
    tideLine.CanQuery = false
end

--[[
    Assemble one module's visual. Unknown keys return false, which is what
    keeps the region honest about being half-built and what the coverage
    spec reads.
]]
function TempestBuilder.buildModuleVisual(
    parent: Instance,
    visual: string,
    center: Vector3
): boolean
    if visual == "harbour_steps" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(0, 0, -16), 30)
        for index = 0, 4 do
            part(
                parent,
                "HarbourStep",
                Vector3.new(20 - index, 1.4, 4),
                CFrame.new(center + Vector3.new(0, 0.9 + index * 1.2, -2 - index * 3.4)),
                STONE,
                Enum.Material.Slate
            )
        end
        signalMast(parent, center + Vector3.new(-11, 0, 6), true)
        return true
    elseif visual == "lee_shore" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(0, 0, -18), 26)
        -- The one place on this coast the wind does not reach: a wall with
        -- its back to the weather, which is what "lee" means and what a
        -- party is looking for by the time they get here.
        seaWall(parent, center + Vector3.new(0, 0, -8), 40, 3)
        jettyDeck(parent, center + Vector3.new(0, 0, 8), 26, 12)
        signalMast(parent, center + Vector3.new(9, 0, 10), true)
        return true
    elseif visual == "salvage_flats" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(0, 0, -20), 22)
        wreckHull(parent, center + Vector3.new(-8, 0, -4), 22, 0.8)
        wreckHull(parent, center + Vector3.new(10, 0, 8), -14, 0.6)
        amberglassPatch(parent, center + Vector3.new(4, 0, -8), 17)
        return true
    elseif visual == "saltworks" then
        reachGround(parent, center)
        for index = -1, 1 do
            local pan = part(
                parent,
                "SaltPan",
                Vector3.new(14, 1, 10),
                CFrame.new(center + Vector3.new(index * 16, 0.8, 0)),
                Color3.fromRGB(196, 196, 186),
                Enum.Material.Sand
            )
            pan.Transparency = 0.05
        end
        seaWall(parent, center + Vector3.new(0, 0, -14), 34, 11)
        return true
    elseif visual == "kelp_racks" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(0, 0, -14), 26)
        kelpRack(parent, center + Vector3.new(-9, 0, 2))
        kelpRack(parent, center + Vector3.new(4, 0, 6))
        kelpRack(parent, center + Vector3.new(13, 0, -2))
        return true
    elseif visual == "amberglass_shoal" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(0, 0, 10), 34)
        for index = -1, 1 do
            amberglassPatch(
                parent,
                center + Vector3.new(index * 9, 0, index % 2 * 6 - 4),
                23 + index
            )
        end
        groundingRod(parent, center + Vector3.new(11, 0, -8))
        return true
    elseif visual == "rope_walk" then
        reachGround(parent, center)
        -- A ropewalk is a long shed: rope is laid, not coiled, and it
        -- needs the length of the building to lay it in.
        jettyDeck(parent, center, 44, 10)
        for side = -1, 1, 2 do
            ropeRun(
                parent,
                center + Vector3.new(side * 4, 6, -20),
                center + Vector3.new(side * 4, 6, 20),
                1.2
            )
        end
        signalMast(parent, center + Vector3.new(-10, 0, -14), false)
        return true
    elseif visual == "storm_glass_beds" then
        reachGround(parent, center)
        for index = -2, 2 do
            amberglassPatch(
                parent,
                center + Vector3.new(index * 7, 0, (index % 2) * 8 - 4),
                31 + index
            )
        end
        groundingRod(parent, center + Vector3.new(0, 0, 12))
        groundingRod(parent, center + Vector3.new(-12, 0, -10))
        return true
    elseif visual == "gull_colony" then
        reachGround(parent, center)
        seaWall(parent, center + Vector3.new(0, 0, -10), 30, 7)
        for index = 0, 6 do
            local angle = index * math.pi * 0.28
            part(
                parent,
                "NestLedge",
                Vector3.new(3, 0.8, 2.4),
                CFrame.new(
                    center
                        + Vector3.new(
                            math.cos(angle) * 11,
                            4 + (index % 3) * 2.4,
                            math.sin(angle) * 8
                        )
                ),
                STONE,
                Enum.Material.Slate,
                false
            )
        end
        return true
    elseif visual == "breakwater_run" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(-16, 0, 0), 24)
        seaWater(parent, center + Vector3.new(16, 0, 0), 24)
        -- The run itself: a broken wall a party crosses with water on
        -- both sides and gaps where blocks have gone.
        seaWall(parent, center, 48, 5)
        return true
    elseif visual == "rigging_climb" then
        reachGround(parent, center)
        wreckHull(parent, center + Vector3.new(-6, 0, 0), 26, 1)
        wreckHull(parent, center + Vector3.new(12, 0, -6), -20, 0.8)
        ropeRun(parent, center + Vector3.new(-6, 14, 0), center + Vector3.new(12, 12, -6), 2.4)
        ropeRun(parent, center + Vector3.new(-6, 10, 4), center + Vector3.new(12, 9, -2), 1.8)
        return true
    elseif visual == "tide_stair" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(0, 0, -16), 28)
        for index = 0, 5 do
            part(
                parent,
                "TideStep",
                Vector3.new(12, 1.2, 3.4),
                CFrame.new(center + Vector3.new(0, 0.8 + index * 1.4, 6 - index * 3.6)),
                if index % 2 == 0 then STONE else DARK_STONE,
                Enum.Material.Slate
            )
        end
        return true
    elseif visual == "gale_crossing" then
        reachGround(parent, center)
        -- Nothing to hide behind and a rail to hold: the module is the
        -- wind, and the rail is the only concession anyone made to it.
        for index = -3, 3 do
            part(
                parent,
                "StormRail",
                Vector3.new(0.5, 4, 0.5),
                CFrame.new(center + Vector3.new(index * 6, 2, 0)),
                IRON,
                Enum.Material.Metal
            )
        end
        ropeRun(parent, center + Vector3.new(-18, 4, 0), center + Vector3.new(18, 4, 0), 0.8)
        seaWater(parent, center + Vector3.new(0, 0, -20), 22)
        return true
    elseif visual == "hull_bridge" then
        reachGround(parent, center)
        seaWater(parent, center, 40)
        -- A hull laid across the gap on purpose, which is the most
        -- Tempest thing anyone here has done.
        wreckHull(parent, center, 90, 1.1)
        jettyDeck(parent, center + Vector3.new(0, 3, 0), 26, 7)
        return true
    elseif visual == "sea_cave_mouth" then
        reachGround(parent, center)
        for side = -1, 1, 2 do
            part(
                parent,
                "CaveJaw",
                Vector3.new(8, 14, 12),
                CFrame.new(center + Vector3.new(side * 10, 7, -8))
                    * CFrame.Angles(0, 0, math.rad(side * 6)),
                DARK_STONE,
                Enum.Material.Rock
            )
        end
        part(
            parent,
            "CaveLintel",
            Vector3.new(26, 5, 12),
            CFrame.new(center + Vector3.new(0, 15, -8)),
            DARK_STONE,
            Enum.Material.Rock,
            false
        )
        amberglassPatch(parent, center + Vector3.new(0, 0, -4), 47)
        return true
    elseif visual == "imp_reef" then
        reachGround(parent, center)
        seaWater(parent, center, 44)
        for index = 0, 5 do
            local angle = index * math.pi / 3
            part(
                parent,
                "ReefTooth",
                Vector3.new(3, 6 + (index % 3) * 2, 3),
                CFrame.new(center + Vector3.new(math.cos(angle) * 12, 3, math.sin(angle) * 12))
                    * CFrame.Angles(math.rad((index % 4) * 5), angle, 0),
                DARK_STONE,
                Enum.Material.Rock
            )
        end
        return true
    elseif visual == "wreck_yard" then
        reachGround(parent, center)
        wreckHull(parent, center + Vector3.new(-11, 0, -6), 30, 0.9)
        wreckHull(parent, center + Vector3.new(3, 0, 8), -24, 1)
        wreckHull(parent, center + Vector3.new(14, 0, -4), 12, 0.7)
        ropeRun(parent, center + Vector3.new(-11, 12, -6), center + Vector3.new(3, 12, 8), 2.2)
        return true
    elseif visual == "grounding_field" then
        reachGround(parent, center)
        for index = 0, 5 do
            local angle = index * math.pi / 3
            groundingRod(
                parent,
                center + Vector3.new(math.cos(angle) * 12, 0, math.sin(angle) * 12)
            )
        end
        amberglassPatch(parent, center, 53)
        return true
    elseif visual == "husk_shallows" then
        reachGround(parent, center)
        seaWater(parent, center, 46)
        for index = -2, 2 do
            part(
                parent,
                "SaltCrust",
                Vector3.new(6, 0.6, 6),
                CFrame.new(center + Vector3.new(index * 7, 1, (index % 2) * 6 - 3)),
                Color3.fromRGB(206, 202, 190),
                Enum.Material.Sand,
                false
            )
        end
        return true
    elseif visual == "breaker_line" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(0, 0, -12), 40)
        seaWall(parent, center + Vector3.new(0, 0, 4), 44, 19)
        for index = -1, 1 do
            part(
                parent,
                "BrokenBlock",
                Vector3.new(7, 4, 7),
                CFrame.new(center + Vector3.new(index * 10, 2, -6))
                    * CFrame.Angles(math.rad(index * 12), math.rad(index * 20), math.rad(8)),
                STONE,
                Enum.Material.Slate
            )
        end
        return true
    elseif visual == "jetty_span" then
        reachGround(parent, center)
        seaWater(parent, center, 44)
        jettyDeck(parent, center, 46, 9)
        return true
    elseif visual == "boat_shed" then
        reachGround(parent, center)
        jettyDeck(parent, center, 24, 14)
        for side = -1, 1, 2 do
            part(
                parent,
                "ShedWall",
                Vector3.new(0.8, 9, 22),
                CFrame.new(center + Vector3.new(side * 7, 7.5, 0)),
                PLANK,
                Enum.Material.Wood
            )
        end
        part(
            parent,
            "ShedRoof",
            Vector3.new(16, 1, 24),
            CFrame.new(center + Vector3.new(0, 12.2, 0)) * CFrame.Angles(math.rad(4), 0, 0),
            DARK_PLANK,
            Enum.Material.Wood,
            false
        )
        return true
    elseif visual == "signal_post" then
        reachGround(parent, center)
        signalMast(parent, center, true)
        signalMast(parent, center + Vector3.new(-12, 0, 6), false)
        ropeRun(parent, center + Vector3.new(0, 12, 0), center + Vector3.new(-12, 12, 6), 1.6)
        return true
    elseif visual == "sea_wall_gate" then
        reachGround(parent, center)
        seaWall(parent, center + Vector3.new(-14, 0, 0), 22, 29)
        seaWall(parent, center + Vector3.new(14, 0, 0), 22, 37)
        for side = -1, 1, 2 do
            part(
                parent,
                "GateLeaf",
                Vector3.new(1, 9, 9),
                CFrame.new(center + Vector3.new(side * 4, 4.5, 0))
                    * CFrame.Angles(0, math.rad(side * 18), 0),
                IRON,
                Enum.Material.DiamondPlate
            )
        end
        return true
    elseif visual == "harbourmaster_office" then
        reachGround(parent, center)
        jettyDeck(parent, center + Vector3.new(0, 0, 6), 18, 16)
        for side = -1, 1, 2 do
            part(
                parent,
                "OfficeWall",
                Vector3.new(0.8, 9, 14),
                CFrame.new(center + Vector3.new(side * 8, 8, 4)),
                PLANK,
                Enum.Material.Wood
            )
        end
        part(
            parent,
            "OfficeBack",
            Vector3.new(16, 9, 0.8),
            CFrame.new(center + Vector3.new(0, 8, -3)),
            PLANK,
            Enum.Material.Wood
        )
        signalMast(parent, center + Vector3.new(10, 0, -6), true)
        return true
    elseif visual == "widows_walk" then
        reachGround(parent, center)
        -- A railed platform on a roof, built for watching a horizon that
        -- has not given anything back.
        part(
            parent,
            "WalkHouse",
            Vector3.new(14, 12, 12),
            CFrame.new(center + Vector3.new(0, 6, 0)),
            PLANK,
            Enum.Material.Wood
        )
        part(
            parent,
            "WalkDeck",
            Vector3.new(10, 0.6, 10),
            CFrame.new(center + Vector3.new(0, 12.4, 0)),
            DARK_PLANK,
            Enum.Material.Wood
        )
        for index = 0, 7 do
            local angle = index * math.pi * 0.25
            part(
                parent,
                "WalkRail",
                Vector3.new(0.4, 3, 0.4),
                CFrame.new(center + Vector3.new(math.cos(angle) * 4.6, 14, math.sin(angle) * 4.6)),
                DARK_PLANK,
                Enum.Material.Wood,
                false
            )
        end
        return true
    elseif visual == "drowned_bell_tower" then
        reachGround(parent, center)
        seaWater(parent, center, 44)
        part(
            parent,
            "TowerShaft",
            Vector3.new(9, 20, 9),
            CFrame.new(center + Vector3.new(0, 9, 0)) * CFrame.Angles(0, 0, math.rad(7)),
            STONE,
            Enum.Material.Slate
        )
        part(
            parent,
            "TowerBell",
            Vector3.new(5, 5, 5),
            CFrame.new(center + Vector3.new(1.4, 17, 0)),
            Color3.fromRGB(122, 108, 78),
            Enum.Material.Metal,
            false
        )
        return true
    elseif visual == "signal_chain_room" then
        reachGround(parent, center)
        jettyDeck(parent, center, 20, 16)
        -- Three lamps in a row, which is what the signal chain event asks
        -- a party to raise in order.
        for index = -1, 1 do
            signalMast(parent, center + Vector3.new(index * 7, 3, -2), index == 0)
        end
        ropeRun(parent, center + Vector3.new(-7, 15, -2), center + Vector3.new(7, 15, -2), 1)
        return true
    elseif visual == "tide_gauge" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(0, 0, -10), 30)
        part(
            parent,
            "GaugeColumn",
            Vector3.new(1.6, 16, 1.6),
            CFrame.new(center + Vector3.new(0, 8, 0)),
            STONE,
            Enum.Material.Slate
        )
        for index = 0, 6 do
            part(
                parent,
                "GaugeMark",
                Vector3.new(3, 0.3, 0.4),
                CFrame.new(center + Vector3.new(0, 2 + index * 2, 1)),
                FOAM,
                Enum.Material.SmoothPlastic,
                false
            )
        end
        for side = -1, 1, 2 do
            part(
                parent,
                "GaugeGate",
                Vector3.new(8, 6, 1),
                CFrame.new(center + Vector3.new(side * 9, 3, -6)),
                IRON,
                Enum.Material.DiamondPlate
            )
        end
        return true
    elseif visual == "titan_approach" then
        reachGround(parent, center)
        seaWater(parent, center + Vector3.new(0, 0, -14), 46)
        -- Where the harbour was. Four wrecks to climb, two rods to earth
        -- the storm, and the gates that lower the tide -- the Titan's three
        -- verbs, standing in the world before the fight is wired to them.
        wreckHull(parent, center + Vector3.new(-14, 0, -4), 28, 1)
        wreckHull(parent, center + Vector3.new(-2, 0, 6), -18, 0.9)
        wreckHull(parent, center + Vector3.new(12, 0, -8), 34, 1.1)
        wreckHull(parent, center + Vector3.new(18, 0, 6), -12, 0.8)
        groundingRod(parent, center + Vector3.new(-8, 0, 12))
        groundingRod(parent, center + Vector3.new(8, 0, 12))
        for side = -1, 1, 2 do
            part(
                parent,
                "TideGate",
                Vector3.new(12, 10, 1.4),
                CFrame.new(center + Vector3.new(side * 16, 5, -18)),
                IRON,
                Enum.Material.DiamondPlate
            )
        end
        signalMast(parent, center + Vector3.new(0, 0, 18), true)
        return true
    end
    return false
end

return table.freeze(TempestBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="168">
          <Properties>
            <string name="Name">TerrainBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Sculpted Bramblewake terrain for the arrival valley.

    WHY THIS EXISTS

    The arrival world used to stand on a single 320 x 6 x 340 Part called
    "Ground". A flat rectangle has no horizon, no silhouette, and no sense of
    distance, so a valley that the design documents describe as a fracturing
    wilderness read as a small yard with props on it. No amount of prop detail
    fixes that: the eye reads ground shape and depth layers before it reads
    individual objects.

    Real Terrain fixes four things a Part floor cannot:

      * an actual horizon line, so the world stops ending in mid-air;
      * elevation the camera can look along, which is what produces depth;
      * material blending at the ground plane instead of one flat colour;
      * blended terrain materials instead of one repeated ground texture.

    WHAT IS DELIBERATELY *NOT* SCULPTED

    Every gameplay coordinate in WorldService is a hardcoded Vector3 authored
    against a flat plane at y = 0 -- spawns, interaction prompts, the lantern
    ring, the night defense route, incident sites, enemy spawn points. Sculpting
    under those would drop props into hillsides and leave prompts floating.

    So the playable bowl is filled flat, with its surface exactly at y = 0, and
    all relief happens *outside* it. The valley floor the player walks stays
    byte-for-byte the geometry the systems were authored against; the world
    around it gains hills, ridges, and a far skyline. That split is the whole
    reason this can land without re-authoring 5,000 lines of positions.

    COST

    Terrain is voxel data, not instances, so this adds zero parts to the
    streaming budget. Fills are bulk operations on 4-stud voxels; the whole
    valley is a few hundred FillBlock/FillBall calls rather than a per-voxel
    loop. Generation is deterministic from a fixed seed so two servers build an
    identical valley and a Studio build matches a live one.
]]

local Workspace = game:GetService("Workspace")

local TerrainBuilder = {}

-- The flat region every authored gameplay coordinate lives inside. Relief is
-- only generated outside this rectangle. Widened past the actual play area so
-- the transition to hills never crowds the walkable route.
local BOWL_MIN_X = -190
local BOWL_MAX_X = 190
local BOWL_MIN_Z = -260
local BOWL_MAX_Z = 90

-- Ground surface height. Must stay 0: it is the plane every authored Vector3
-- in WorldService was placed against.
local GROUND_Y = 0

--[[
    How far above a fill's top face Roblox actually renders the walkable
    surface.

    Terrain voxels are 4 studs. A FillBlock whose top face is authored at y = 0
    does not produce a surface at y = 0 -- it produces one at y = 2, half a
    voxel higher. Measured directly in Studio with a control fill far from any
    other geometry: top face at y = 0, raycast surface at y = 2.000, and every
    sample across the real valley floor returns 2.000 as well.

    This module used to report GROUND_Y as the floor's top and be wrong by
    exactly this amount, which is why so much authored content sat two studs
    into the ground: the town square (top face 0.80) was underground and had
    never once rendered, and every character authored to stand at y = 0 stood
    shin-deep in the grass. The road network reads correctly only because it
    was empirically nudged to 2.2-2.5 at some point without the cause being
    understood.

    The comment above stays true -- GROUND_Y is still the plane the authored
    coordinates were written against. What changed is that this module now
    tells callers where the ground actually is.
]]
local VOXEL_SURFACE_RISE = 2

--[[
    The Y every terrain fill is authored against, as opposed to the Y the
    engine then renders the surface at.

    Fills are placed VOXEL_SURFACE_RISE lower than the plane they are meant to
    produce, so the surface Roblox actually renders lands on GROUND_Y -- the
    plane every authored Vector3 in WorldService was written against. Before
    this, the fills were placed AT GROUND_Y and the surface rendered two studs
    above it, so the entire authored world was underground and individual props
    were being lifted one at a time to compensate. The main street still
    carries such a lift (a +1.77 "visual skin"), added when this was diagnosed
    as a road problem rather than a datum problem.

    Reporting is unchanged: groundHeight() and surfaceHeight() still describe
    the authored plane, and now they are telling the truth.
]]
local FILL_Y = GROUND_Y - VOXEL_SURFACE_RISE

-- How deep the solid ground slab runs. Enough that a Blackout crater or a
-- future dug-out cannot punch through into empty space.
local BEDROCK_DEPTH = 90

-- Outer extent of generated terrain. StreamingTargetRadius is 1024, so terrain
-- past roughly 1200 studs is only ever seen as a horizon silhouette; beyond
-- this the sky takes over.
local WORLD_EXTENT = 1450

local VOXEL = 4

local DEFAULT_SEED = 20260801

-- The Bramblewake expedition is built around x = 1600 (BramblewakeBuilder's
-- ORIGIN) as its own streamed area. No generated terrain may reach past this
-- line, or hills and peaks grow through the expedition modules. The hill grid
-- already stops at WORLD_EXTENT = 1450; this bounds the peak ring too, whose
-- radius would otherwise carry it further out than its centre suggests.
local BRAMBLEWAKE_KEEP_OUT_X = 1400

export type Palette = {
    valley: Enum.Material,
    meadow: Enum.Material,
    slope: Enum.Material,
    ridge: Enum.Material,
    peak: Enum.Material,
    shore: Enum.Material,
}

local DEFAULT_PALETTE: Palette = {
    valley = Enum.Material.Grass,
    meadow = Enum.Material.LeafyGrass,
    slope = Enum.Material.Ground,
    ridge = Enum.Material.Rock,
    peak = Enum.Material.Slate,
    shore = Enum.Material.Sand,
}

-- Rounds a span up to a whole number of voxels. Terrain snaps fills to its own
-- 4-stud grid, and unrounded sizes leave single-voxel seams between adjacent
-- fills that read as cracks in the ground from a low camera.
local function toVoxelSpan(value: number): number
    return math.max(VOXEL, math.ceil(value / VOXEL) * VOXEL)
end

local function isInsideBowl(x: number, z: number, margin: number): boolean
    return x > BOWL_MIN_X - margin
        and x < BOWL_MAX_X + margin
        and z > BOWL_MIN_Z - margin
        and z < BOWL_MAX_Z + margin
end

--[[
    Two-octave value noise in [-1, 1], seeded so every server sculpts the same
    valley.

    math.noise is Perlin and already deterministic for a given input, so the
    seed only has to offset the sample position. Two octaves is enough for a
    natural ridgeline; more detail is invisible once terrain smoothing and
    grass decoration land on top of it.
]]
local function terrainNoise(seed: number, x: number, z: number, scale: number): number
    local base = math.noise(x / scale + seed, z / scale + seed, seed * 0.37)
    local detail = math.noise(x / (scale * 0.42) - seed, z / (scale * 0.42) + seed, seed * 0.11)
    return math.clamp(base + detail * 0.38, -1, 1)
end

--[[
    Fills the flat valley floor that all authored gameplay geometry sits on.

    Filled as one block rather than per-column so the walkable surface is
    guaranteed level -- noise anywhere in here would tilt props and prompts.
]]
local function fillValleyFloor(terrain: Terrain, palette: Palette)
    local width = toVoxelSpan(BOWL_MAX_X - BOWL_MIN_X)
    local depth = toVoxelSpan(BOWL_MAX_Z - BOWL_MIN_Z)
    local centerX = (BOWL_MIN_X + BOWL_MAX_X) / 2
    local centerZ = (BOWL_MIN_Z + BOWL_MAX_Z) / 2

    -- Centre from the SAME rounded span that is passed as the size. Deriving
    -- the centre from the raw BEDROCK_DEPTH while filling the voxel-rounded
    -- span puts the floor half a voxel out: 90 rounds up to 92, so the surface
    -- landed at GROUND_Y + 1 instead of GROUND_Y. Every road is only ~0.9
    -- studs thick, so that one stud buried the entire road network -- main
    -- street, arrival route, and district roads -- under the grass. The
    -- surrounding column fill below already derives its centre this way, which
    -- is why the hills sat correctly while the valley floor did not.
    local depthSpan = toVoxelSpan(BEDROCK_DEPTH)

    terrain:FillBlock(
        CFrame.new(centerX, FILL_Y - depthSpan / 2, centerZ),
        Vector3.new(width, depthSpan, depth),
        palette.valley
    )
end

--[[
    Rolling ground outside the bowl, rising with distance so the valley reads as
    sheltered and the skyline closes the world off.

    Columns are sampled on a coarse grid and filled as blocks. A finer grid
    would cost proportionally more fills for detail that terrain smoothing and
    the tree line hide anyway.

    `minRadius`/`maxRadius` select an annulus by distance from the bowl centre,
    which is what lets the near ground be generated before a player can join
    and the horizon be generated after. Splitting by radius rather than by grid
    index guarantees the two passes tile exactly: no cell is filled twice, and
    no cell between them is missed.

    `onProgress` is called once per grid row so a deferred caller can yield.
    Yielding inside the row loop instead of per cell keeps the number of
    scheduler round-trips proportional to the grid edge, not its area.
]]
--[[
    The height of the ground surface at a world position.

    This is the single source of truth for the terrain's shape. Both the fill
    loop and anything placed *on* the terrain must read it, or they disagree:
    foliage was originally planted at a hardcoded y = 0 while the ground
    outside the bowl rose by up to ~90 studs, which buried the mid and far
    tree bands -- the exact depth layers this module exists to create.

    Inside the bowl this is always GROUND_Y, which is the flat-floor guarantee
    every authored gameplay coordinate depends on.
]]
local function surfaceHeightAt(x: number, z: number, seed: number): number
    if isInsideBowl(x, z, 0) then
        return GROUND_Y
    end

    local bowlCenterX = (BOWL_MIN_X + BOWL_MAX_X) / 2
    local bowlCenterZ = (BOWL_MIN_Z + BOWL_MAX_Z) / 2
    local dx = x - bowlCenterX
    local dz = z - bowlCenterZ
    local distance = math.sqrt(dx * dx + dz * dz)

    -- Ramp relief in with distance from the valley so the ground leaves the
    -- flat bowl gradually instead of at a wall.
    local ramp = math.clamp((distance - 230) / 620, 0, 1)
    local rise = terrainNoise(seed, x, z, 320) * 58 + 34
    return GROUND_Y + math.max(0, rise * ramp * ramp)
end

--[[
    Surface height for callers outside this module, using the same seed the
    world was built with. Foliage placement uses this so trunks sit on the
    ground rather than inside it.
]]
function TerrainBuilder.surfaceHeight(x: number, z: number, seed: number?): number
    return surfaceHeightAt(x, z, seed or DEFAULT_SEED)
end

local function fillHillAnnulus(
    terrain: Terrain,
    seed: number,
    palette: Palette,
    minRadius: number,
    maxRadius: number,
    onProgress: (() -> ())?
)
    local step = 24
    local bowlCenterX = (BOWL_MIN_X + BOWL_MAX_X) / 2
    local bowlCenterZ = (BOWL_MIN_Z + BOWL_MAX_Z) / 2

    for x = -WORLD_EXTENT, WORLD_EXTENT, step do
        if onProgress ~= nil then
            onProgress()
        end
        for z = -WORLD_EXTENT, WORLD_EXTENT, step do
            if not isInsideBowl(x, z, 0) then
                local dx = x - bowlCenterX
                local dz = z - bowlCenterZ
                local distance = math.sqrt(dx * dx + dz * dz)

                if distance < minRadius or distance >= maxRadius then
                    continue
                end

                -- Stop the grid short of the Bramblewake expedition. Bounding
                -- only the peak ring was not enough: ExpeditionGenerator's
                -- ROUTES[2] walks to cellX = -2, putting a module centre at
                -- x = 1456 whose 72-stud cell reaches x = 1420, while this
                -- grid fills all the way to WORLD_EXTENT = 1450. That 30-stud
                -- overlap would grow hills through the first modules.
                if x >= BRAMBLEWAKE_KEEP_OUT_X then
                    continue
                end

                -- Same function foliage placement reads, so a tree can never
                -- disagree with the ground it stands on.
                local height = surfaceHeightAt(x, z, seed) - GROUND_Y

                -- Every cell outside the bowl is filled, including the ones
                -- with no relief at all. Skipping flat cells left a void ring
                -- between the bowl's rectangular edge and where the distance
                -- ramp starts producing height -- a cell just past x = 190 is
                -- outside the bowl but still under the 230-stud ramp, so it
                -- got no terrain and no floor. Players walking off the bowl
                -- edge fell through it into fall recovery, and removing the
                -- old DistantCliff ring took away the fence that had been
                -- accidentally hiding the gap.
                local material = palette.slope
                if height > 96 then
                    material = palette.peak
                elseif height > 46 then
                    material = palette.ridge
                elseif height < 1 then
                    -- Flat skirt immediately outside the bowl reads as the
                    -- same meadow, not as a different biome starting at a
                    -- straight line.
                    material = palette.valley
                end

                local columnHeight = toVoxelSpan(height + BEDROCK_DEPTH)
                terrain:FillBlock(
                    CFrame.new(x, FILL_Y + height - columnHeight / 2, z),
                    Vector3.new(toVoxelSpan(step), columnHeight, toVoxelSpan(step)),
                    material
                )
            end
        end
    end
end

--[[
    Distant peaks that close the horizon.

    Placed as overlapping balls rather than blocks: a ball reads as a rounded
    massif once smoothed, and at this distance silhouette is the only property
    that survives. This is the "distant silhouette" depth layer the art
    direction asks every background to have.
]]
local function fillHorizonPeaks(terrain: Terrain, seed: number, palette: Palette)
    local random = Random.new(seed)
    local peakCount = 26

    for index = 1, peakCount do
        local angle = (index / peakCount) * math.pi * 2 + random:NextNumber(-0.06, 0.06)
        local distance = random:NextNumber(1020, 1330)
        local x = math.cos(angle) * distance
        local z = math.sin(angle) * distance - 70
        local radius = random:NextNumber(110, 210)
        local height = random:NextNumber(150, 320)

        -- The Bramblewake expedition is authored as a separate streamed area
        -- around x = 1600. A peak at distance 1330 with radius 210 reaches
        -- x = 1540, close enough to push a mountain through the first
        -- expedition modules. Skipping peaks that reach into it keeps the two
        -- areas from fighting over the same space.
        if x + radius > BRAMBLEWAKE_KEEP_OUT_X then
            continue
        end

        -- Two stacked balls give a shoulder and a cap, which reads as a
        -- mountain rather than a dome.
        terrain:FillBall(Vector3.new(x, FILL_Y + height * 0.15, z), radius, palette.ridge)
        terrain:FillBall(Vector3.new(x, FILL_Y + height * 0.55, z), radius * 0.62, palette.peak)
    end
end

--[[
    A stream running past the east edge of the valley into a pond.

    Water is the cheapest large-scale visual interest terrain offers: it moves,
    it reflects the sky and the lanterns, and it gives the flat bowl a readable
    boundary on one side. Kept outside the bowl so it can never flood a spawn
    or an interaction, and carved before it is filled so the banks read as cut
    earth rather than a puddle sitting on grass.
]]
local function fillStream(terrain: Terrain, palette: Palette)
    local points = {
        Vector3.new(232, FILL_Y, 60),
        Vector3.new(252, FILL_Y, -20),
        Vector3.new(268, FILL_Y, -104),
        Vector3.new(296, FILL_Y, -186),
        Vector3.new(342, FILL_Y, -252),
    }

    local channelDepth = 16
    local waterDepth = 8
    local waterSurfaceY = FILL_Y - 2

    for index = 1, #points - 1 do
        local from = points[index]
        local to = points[index + 1]
        local delta = to - from
        local center = from + delta * 0.5
        local width = toVoxelSpan(28 + math.sin(index * 1.7) * 4)
        local length = toVoxelSpan(delta.Magnitude + width)
        local horizontalTarget = Vector3.new(to.X, FILL_Y, to.Z)
        local orientation = CFrame.lookAt(Vector3.new(center.X, FILL_Y, center.Z), horizontalTarget)

        -- Repaint two flat bank strips before carving. Their top face remains
        -- exactly at ground level; unlike a sphere, they cannot create dunes.
        for side = -1, 1, 2 do
            terrain:FillBlock(
                orientation * CFrame.new(side * (width * 0.5 + 5), -4, 0),
                Vector3.new(10, 8, length),
                palette.shore
            )
        end

        -- Both channel and water are blocks aligned along the stream segment.
        -- The water top is a single flat plane below the banks. Overlapping
        -- segment ends hide the joints without the above-ground domes produced
        -- by FillBall water.
        terrain:FillBlock(
            orientation * CFrame.new(0, -2, 0),
            Vector3.new(width + 8, channelDepth, length),
            Enum.Material.Air
        )
        terrain:FillBlock(
            orientation * CFrame.new(0, waterSurfaceY - waterDepth * 0.5, 0),
            Vector3.new(width, waterDepth, length),
            Enum.Material.Water
        )
    end

    -- A flat octagonal pond assembled from voxel-aligned rows. Every row shares
    -- the same water height, so the lake reads as a surface instead of a bubble.
    local pondCenter = Vector3.new(362, FILL_Y, -286)
    local pondWidths = { 64, 96, 112, 120, 112, 96, 64 }
    terrain:FillBlock(
        CFrame.new(pondCenter + Vector3.new(0, -4, 0)),
        Vector3.new(136, 8, 128),
        palette.shore
    )
    for rowIndex, rowWidth in pondWidths do
        local zOffset = (rowIndex - 4) * 16
        terrain:FillBlock(
            CFrame.new(pondCenter + Vector3.new(0, -2, zOffset)),
            Vector3.new(rowWidth + 12, channelDepth, 20),
            Enum.Material.Air
        )
        terrain:FillBlock(
            CFrame.new(pondCenter + Vector3.new(0, waterSurfaceY - waterDepth * 0.5, zOffset)),
            Vector3.new(rowWidth, waterDepth, 20),
            Enum.Material.Water
        )
    end
end

-- How deep a surface material patch reaches. Only needs to cover the topmost
-- voxel layer that is actually visible; deeper is wasted writes.
local SURFACE_PATCH_DEPTH = 8

--[[
    Meadow and worn-earth colour variation across the valley floor.

    Every patch is a block whose TOP FACE sits exactly at GROUND_Y and whose
    body runs downward, and it is only ever yaw-rotated. Both properties are
    load-bearing:

      * The bowl is already solid from GROUND_Y down to bedrock, so a fill
        entirely at or below GROUND_Y replaces the material of existing voxels
        without changing occupancy. The walkable surface stays exactly flat.
      * Yaw keeps the top face horizontal at a fixed height. Pitch or roll
        would tip a corner up through the surface.

    The first version used FillBall centred at GROUND_Y - 0.55 * radius, which
    put the top of every ball 0.45 * radius ABOVE the ground -- up to a 19.8
    stud solid mound, in the middle of the area this module promises is flat,
    potentially burying the spawn and authored props. FillBall adds terrain; it
    does not merely repaint it. A ball cannot repaint a flat surface at all:
    any ball whose top is at or below the surface only touches it at a single
    tangent point, so a block is the right primitive here, not a rounder one.
]]
local function paintValleyVariation(terrain: Terrain, seed: number, palette: Palette)
    local random = Random.new(seed + 991)

    for _ = 1, 46 do
        local x = random:NextNumber(BOWL_MIN_X + 20, BOWL_MAX_X - 20)
        local z = random:NextNumber(BOWL_MIN_Z + 20, BOWL_MAX_Z - 20)
        local width = toVoxelSpan(random:NextNumber(26, 78))
        local depth = toVoxelSpan(random:NextNumber(26, 78))
        local material = if random:NextNumber() < 0.62 then palette.meadow else palette.slope

        terrain:FillBlock(
            CFrame.new(x, FILL_Y - SURFACE_PATCH_DEPTH / 2, z)
                * CFrame.Angles(0, random:NextNumber(0, math.pi), 0),
            Vector3.new(width, SURFACE_PATCH_DEPTH, depth),
            material
        )
    end
end

--[[
    Where the join-blocking core pass stops and the deferred pass begins.

    Everything a player can reach, fall off, or see close up in their first
    moments is inside this radius; past it the ground is scenery. Comfortably
    beyond the 620-stud tree line so the transition is never the first thing
    in view.
]]
local CORE_RADIUS = 760

local function applyWaterStyle(terrain: Terrain)
    terrain.WaterColor = Color3.fromRGB(44, 92, 104)
    terrain.WaterReflectance = 0.28
    terrain.WaterTransparency = 0.62
    terrain.WaterWaveSize = 0.08
    terrain.WaterWaveSpeed = 8
end

--[[
    Sculpts everything a joining player needs: the flat valley floor, the
    ground immediately around it, the stream, and surface variation.

    This runs before the spawn exists and before the world is marked ready, so
    it is deliberately the smaller half of the work. Config.BootstrapTimeoutSeconds
    is 8, and AGENTS.md is explicit that joining must never block on the whole
    world loading -- the first version generated the entire 121 x 121 hill grid
    and the horizon here, which is optional scenery no one can reach.

    Safe to call more than once: every fill is deterministic for a given seed,
    so re-running writes identical voxels.
]]
function TerrainBuilder.buildCore(seed: number?, palette: Palette?)
    local terrain = Workspace.Terrain
    local resolvedSeed = seed or DEFAULT_SEED
    local resolvedPalette = palette or DEFAULT_PALETTE

    fillValleyFloor(terrain, resolvedPalette)
    fillHillAnnulus(terrain, resolvedSeed, resolvedPalette, 0, CORE_RADIUS, nil)
    fillStream(terrain, resolvedPalette)
    paintValleyVariation(terrain, resolvedSeed, resolvedPalette)
    applyWaterStyle(terrain)
end

--[[
    Sculpts the horizon: the far hills and the peak ring.

    Meant to be called after the world is marked ready. `onProgress` fires once
    per grid row so the caller can yield between rows and keep the server
    responsive while this fills in behind the tree line.

    Everything here is past CORE_RADIUS, so it can only ever add scenery a
    player is looking at from a distance -- never ground they are standing on.
]]
function TerrainBuilder.buildDistant(seed: number?, palette: Palette?, onProgress: (() -> ())?)
    local terrain = Workspace.Terrain
    local resolvedSeed = seed or DEFAULT_SEED
    local resolvedPalette = palette or DEFAULT_PALETTE

    fillHillAnnulus(terrain, resolvedSeed, resolvedPalette, CORE_RADIUS, math.huge, onProgress)
    fillHorizonPeaks(terrain, resolvedSeed, resolvedPalette)
end

-- Exposed so world code and tests can reason about the flat region without
-- duplicating the numbers.
function TerrainBuilder.bowlBounds(): (number, number, number, number)
    return BOWL_MIN_X, BOWL_MAX_X, BOWL_MIN_Z, BOWL_MAX_Z
end

function TerrainBuilder.isInsidePlayableBowl(x: number, z: number): boolean
    return isInsideBowl(x, z, 0)
end

function TerrainBuilder.groundHeight(): number
    return GROUND_Y
end

--[[
    The world-space Y of the valley floor's top face, derived the same way
    fillValleyFloor derives it.

    Exposed so a test can prove the filled surface and `surfaceHeight` agree.
    They silently disagreed once: the fill centred on the raw BEDROCK_DEPTH
    while sizing the voxel-rounded span, so the floor rendered one stud above
    the height every authored coordinate was placed against, and the entire
    road network -- none of it thicker than about 0.9 studs -- was buried under
    the grass with nothing in the logs to say so.
]]
function TerrainBuilder.valleyFloorTop(): number
    return FILL_Y
        + toVoxelSpan(BEDROCK_DEPTH) / 2
        - toVoxelSpan(BEDROCK_DEPTH) / 2
        + VOXEL_SURFACE_RISE
end

-- The surface a character or prop must stand on to look like it is standing on
-- the valley floor rather than buried in it. Now simply the authored plane,
-- because the fills were corrected to render there.
function TerrainBuilder.standingSurface(): number
    return GROUND_Y
end

return table.freeze(TerrainBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="169">
          <Properties>
            <string name="Name">WardenStagBuilder</string>
            <string name="Source"><![CDATA[--!strict

local WardenStagBuilder = {}

local function part(
    parent: Model,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?
): Part
    local item = Instance.new("Part")
    item.Name = name
    item.Size = size
    item.CFrame = cframe
    item.Color = color
    item.Material = material
    item.Shape = shape or Enum.PartType.Block
    item.Anchored = true
    item.CanCollide = false
    item.CanTouch = false
    item.CastShadow = true
    item.TopSurface = Enum.SurfaceType.Smooth
    item.BottomSurface = Enum.SurfaceType.Smooth
    item.Parent = parent
    return item
end

local function antlerBranch(model: Model, origin: Vector3, side: number, branchIndex: number): Part
    return part(
        model,
        if side < 0 then "AntlerLeft" else "AntlerRight",
        Vector3.new(1.15, 7 + branchIndex * 1.4, 1.15),
        CFrame.new(
            origin
                + Vector3.new(
                    side * (3.2 + branchIndex * 1.6),
                    3 + branchIndex * 2.1,
                    branchIndex * 0.35
                )
        ) * CFrame.Angles(0, 0, math.rad(side * (24 + branchIndex * 8))),
        Color3.fromRGB(212, 207, 178),
        Enum.Material.SmoothPlastic,
        nil
    )
end

function WardenStagBuilder.build(origin: Vector3, target: Vector3, maxHealth: number): Model
    local model = Instance.new("Model")
    model.Name = "WardenStagBoss"
    model:SetAttribute("BossId", "boss_warden_stag")
    model:SetAttribute("BossDisplayName", "Warden Stag")
    model:SetAttribute("BossHealth", maxHealth)
    model:SetAttribute("BossMaxHealth", maxHealth)
    model:SetAttribute("BossStatus", "cleansing")
    model:SetAttribute("BossOutcome", "")

    local body = part(
        model,
        "AncientBody",
        Vector3.new(11, 8, 18),
        CFrame.new(origin + Vector3.new(0, 10, 0)),
        Color3.fromRGB(66, 48, 37),
        Enum.Material.Wood,
        Enum.PartType.Ball
    )
    model.PrimaryPart = body
    part(
        model,
        "MossMantle",
        Vector3.new(11.5, 3.8, 13),
        CFrame.new(origin + Vector3.new(0, 13, 1.5)),
        Color3.fromRGB(48, 83, 57),
        Enum.Material.Grass,
        Enum.PartType.Ball
    )
    local head = part(
        model,
        "WardenHead",
        Vector3.new(6.5, 7, 7.5),
        CFrame.new(origin + Vector3.new(0, 15.5, -9)),
        Color3.fromRGB(72, 52, 40),
        Enum.Material.Wood,
        Enum.PartType.Ball
    )
    for side = -1, 1, 2 do
        for branchIndex = 1, 3 do
            antlerBranch(model, head.Position + Vector3.new(0, 3, 0), side, branchIndex)
        end
        part(
            model,
            "MemoryEye",
            Vector3.new(0.85, 0.85, 0.45),
            CFrame.new(head.Position + Vector3.new(side * 1.5, 0.8, -3.4)),
            Color3.fromRGB(112, 220, 179),
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
        for legIndex = -1, 1, 2 do
            part(
                model,
                "RootLeg",
                Vector3.new(2.4, 10, 2.4),
                CFrame.new(origin + Vector3.new(side * 3.7, 4.5, legIndex * 5.5))
                    * CFrame.Angles(math.rad(legIndex * 6), 0, math.rad(side * 5)),
                Color3.fromRGB(57, 40, 32),
                Enum.Material.Wood,
                nil
            )
        end
    end

    local heart = part(
        model,
        "MemoryHeart",
        Vector3.new(4.5, 5.8, 1.8),
        CFrame.new(origin + Vector3.new(0, 11, -8.5)),
        Color3.fromRGB(255, 190, 85),
        Enum.Material.Neon,
        Enum.PartType.Ball
    )
    heart:SetAttribute("WeakPoint", true)
    -- Same contract as the Old Growth heart: the weak point lives inside the
    -- authored mesh's cavity and must survive the enemy-visual blanking pass,
    -- or the boss cannot be struck at all.
    heart:SetAttribute("KeepVisibleOnReplacement", true)

    local highlight = Instance.new("Highlight")
    highlight.Name = "BossOutline"
    highlight.FillColor = Color3.fromRGB(48, 82, 56)
    highlight.FillTransparency = 0.84
    highlight.OutlineColor = Color3.fromRGB(255, 190, 85)
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = model

    local flatTarget = Vector3.new(target.X, body.Position.Y, target.Z)
    if (flatTarget - body.Position).Magnitude > 0.01 then
        model:PivotTo(CFrame.lookAt(body.Position, flatTarget))
    end
    return model
end

function WardenStagBuilder.setState(
    model: Model,
    health: number,
    status: string,
    marked: boolean,
    brokenAntlers: { [string]: boolean },
    outcome: string?
)
    model:SetAttribute("BossHealth", math.max(0, health))
    model:SetAttribute("BossStatus", status)
    model:SetAttribute("BossOutcome", outcome or "")
    model:SetAttribute("LastLightMarked", marked)
    local exposed = status == "vulnerable"
    local complete = status == "complete"
    local heart = model:FindFirstChild("MemoryHeart")
    if heart ~= nil and heart:IsA("BasePart") then
        heart.Color = if complete
            then Color3.fromRGB(112, 220, 179)
            elseif exposed then Color3.fromRGB(255, 190, 85)
            else Color3.fromRGB(92, 117, 96)
        heart.Material = if exposed or complete
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        heart.Transparency = if exposed or complete then 0 else 0.38
    end
    local highlight = model:FindFirstChild("BossOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        highlight.OutlineColor = if complete
            then Color3.fromRGB(112, 220, 179)
            elseif marked then Color3.fromRGB(255, 226, 124)
            elseif exposed then Color3.fromRGB(255, 190, 85)
            else Color3.fromRGB(112, 155, 119)
        highlight.FillTransparency = if marked then 0.62 else 0.84
    end
    for _, descendant in model:GetChildren() do
        if descendant:IsA("BasePart") then
            if descendant.Name == "AntlerLeft" then
                descendant.Transparency = if brokenAntlers.antler_left then 0.78 else 0
            elseif descendant.Name == "AntlerRight" then
                descendant.Transparency = if brokenAntlers.antler_right then 0.78 else 0
            end
        end
    end
    if model:GetAttribute("EnemyVisualReady") == true then
        local authored = model:FindFirstChild("AuthoredEnemyVisual")
        local hiddenAuthoredAntlerParts = 0
        if authored ~= nil and authored:IsA("Model") then
            local _, authoredBounds = authored:GetBoundingBox()
            local authoredPivot = authored:GetPivot()
            for _, descendant in authored:GetDescendants() do
                if descendant:IsA("BasePart") then
                    local relativePosition = authoredPivot:PointToObjectSpace(descendant.Position)
                    local sourceTransparency = descendant:GetAttribute("WardenSourceTransparency")
                    if type(sourceTransparency) ~= "number" then
                        sourceTransparency = descendant.Transparency
                        descendant:SetAttribute("WardenSourceTransparency", sourceTransparency)
                    end
                    local upperSilhouette = relativePosition.Y > authoredBounds.Y * 0.5
                        and descendant.Size.Y
                            > math.max(descendant.Size.X, descendant.Size.Z) * 1.35
                    local brokenSide = (brokenAntlers.antler_left and relativePosition.Z < 0)
                        or (brokenAntlers.antler_right and relativePosition.Z > 0)
                    if upperSilhouette and brokenSide then
                        descendant.Transparency = 1
                        descendant.CastShadow = false
                        hiddenAuthoredAntlerParts += 1
                    else
                        descendant.Transparency = sourceTransparency
                    end
                end
            end
        end
        model:SetAttribute("AuthoredBrokenAntlerParts", hiddenAuthoredAntlerParts)
        for _, descendant in model:GetDescendants() do
            if
                descendant:IsA("BasePart")
                and (authored == nil or not descendant:IsDescendantOf(authored))
            then
                descendant.Transparency = 1
                descendant.CastShadow = false
            end
        end
    end
end

return table.freeze(WardenStagBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="170">
          <Properties>
            <string name="Name">WorldArtRegistry</string>
            <string name="Source"><![CDATA[--!strict

-- Data-only cloud art mapping. Keep this synchronized with
-- assets/images/manifest.json so pure Luau tests can validate every atlas cell
-- without Roblox engine types.

local WorldArtRegistry = {}

export type Panel = {
    assetId: number,
    offsetX: number,
    offsetY: number,
    width: number,
    height: number,
}

local ASSET_ID = 83727643922166
local CELL_WIDTH = 627
local CELL_HEIGHT = 418

local PANELS: { [string]: Panel } = table.freeze({
    evacuation_route = {
        assetId = ASSET_ID,
        offsetX = 0,
        offsetY = 0,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    lantern_maintenance = {
        assetId = ASSET_ID,
        offsetX = CELL_WIDTH,
        offsetY = 0,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    supply_inventory = {
        assetId = ASSET_ID,
        offsetX = 0,
        offsetY = CELL_HEIGHT,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    bramble_hazard = {
        assetId = ASSET_ID,
        offsetX = CELL_WIDTH,
        offsetY = CELL_HEIGHT,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    field_botany = {
        assetId = ASSET_ID,
        offsetX = 0,
        offsetY = CELL_HEIGHT * 2,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    community_watch = {
        assetId = ASSET_ID,
        offsetX = CELL_WIDTH,
        offsetY = CELL_HEIGHT * 2,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
})

local ORDER = table.freeze({
    "evacuation_route",
    "lantern_maintenance",
    "supply_inventory",
    "bramble_hazard",
    "field_botany",
    "community_watch",
})

function WorldArtRegistry.noticePanel(panelId: string): Panel?
    return PANELS[panelId]
end

function WorldArtRegistry.noticePanelIds(): { string }
    return table.clone(ORDER)
end

return table.freeze(WorldArtRegistry)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="171">
          <Properties>
            <string name="Name">WorldSignBuilder</string>
            <string name="Source"><![CDATA[--!strict

local WorldArtRegistry = require(script.Parent.WorldArtRegistry)

local WorldSignBuilder = {}

local BARK = Color3.fromRGB(62, 39, 30)
local WET_BARK = Color3.fromRGB(36, 26, 24)
local PARCHMENT = Color3.fromRGB(210, 190, 146)
local IRON = Color3.fromRGB(50, 54, 58)
local WAX = Color3.fromRGB(142, 71, 49)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = false
    instance.CanTouch = false
    instance.CanQuery = false
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

-- Both the shadow and the face copy must be laid out identically. TextScaled
-- sizes glyphs to fill whatever box the label ends up with, so giving only one
-- of them padding makes the two copies render at different sizes -- the shadow
-- spills out from behind the letters and the sign reads as doubled, mirrored
-- garbage rather than as a drop shadow. Keep the padding on both.
local function applySignTextPadding(label: TextLabel)
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0.16, 0)
    padding.PaddingBottom = UDim.new(0.16, 0)
    padding.PaddingLeft = UDim.new(0.08, 0)
    padding.PaddingRight = UDim.new(0.08, 0)
    padding.Parent = label
end

-- `singleLine` keeps the whole title on one row. A narrow header plank that
-- lets its title wrap ends up rendering two lines of glyphs a fraction of a
-- stud tall -- unreadable mush spilling over the plank edges, which is
-- exactly what the owner photographed on the notice-board headers.
local function addSurfaceText(board: BasePart, title: string, accent: Color3, singleLine: boolean?)
    local surface = Instance.new("SurfaceGui")
    surface.Name = "PhysicalSignText"
    surface.Face = Enum.NormalId.Front
    surface.LightInfluence = 0.3
    surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surface.PixelsPerStud = 42
    surface.Parent = board

    local shadow = Instance.new("TextLabel")
    shadow.Name = "SignLetterShadow"
    shadow.BackgroundTransparency = 1
    shadow.Position = UDim2.fromOffset(2, 2)
    shadow.Size = UDim2.fromScale(1, 1)
    shadow.Font = Enum.Font.GothamBold
    shadow.Text = title
    shadow.TextColor3 = Color3.fromRGB(19, 17, 15)
    shadow.TextScaled = true
    shadow.TextWrapped = singleLine ~= true
    shadow.Parent = surface
    applySignTextPadding(shadow)

    local label = Instance.new("TextLabel")
    label.Name = "SignLetters"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.Text = title
    label.TextColor3 = accent
    label.TextScaled = true
    label.TextWrapped = singleLine ~= true
    label.Parent = surface
    applySignTextPadding(label)
end

local function addBoardFrame(board: BasePart, style: string): Folder
    local existing = board:FindFirstChild("PhysicalSignDetails")
    if existing ~= nil then
        existing:Destroy()
    end
    local details = Instance.new("Folder")
    details.Name = "PhysicalSignDetails"
    details.Parent = board

    local width = board.Size.X
    local height = board.Size.Y
    local front = -(board.Size.Z * 0.5 + 0.1)
    local railDepth = math.max(0.22, board.Size.Z * 0.48)
    for side = -1, 1, 2 do
        if style ~= "direction" then
            part(
                details,
                "SignFrameSide",
                Vector3.new(0.42, height + 0.7, railDepth),
                board.CFrame * CFrame.new(side * (width * 0.5 + 0.1), 0, front),
                if side < 0 then WET_BARK else BARK,
                Enum.Material.Wood
            )
        end
        part(
            details,
            "SignFrameRail",
            Vector3.new(width + 0.9, 0.38, railDepth),
            board.CFrame
                * CFrame.new(0, side * (height * 0.5 + 0.1), front)
                * CFrame.Angles(0, 0, math.rad(side * 1.5)),
            if side < 0 then BARK else WET_BARK,
            Enum.Material.Wood
        )
    end
    for pinX = -1, 1, 2 do
        local pinRows = if style == "direction" then { 0 } else { -1, 1 }
        for _, pinY in pinRows do
            local pin = part(
                details,
                "SignIronPin",
                Vector3.new(0.2, 0.2, 0.16),
                board.CFrame * CFrame.new(pinX * width * 0.43, pinY * height * 0.38, front - 0.2),
                IRON,
                Enum.Material.Metal
            )
            pin.Shape = Enum.PartType.Ball
        end
    end
    if style == "direction" then
        local arrowColor = Color3.fromRGB(149, 112, 62)
        part(
            details,
            "CarvedDirectionShaft",
            Vector3.new(width * 0.22, 0.18, 0.12),
            board.CFrame * CFrame.new(width * 0.31, -height * 0.28, front - 0.2),
            arrowColor,
            Enum.Material.WoodPlanks
        )
        local head = part(
            details,
            "CarvedDirectionHead",
            Vector3.new(0.48, 0.6, 0.12),
            board.CFrame
                * CFrame.new(width * 0.44, -height * 0.28, front - 0.2)
                * CFrame.Angles(0, math.rad(90), 0),
            arrowColor,
            Enum.Material.WoodPlanks
        )
        head.Shape = Enum.PartType.Wedge
    end
    board:SetAttribute("PhysicalSignStyle", style)
    return details
end

function WorldSignBuilder.dressBoard(board: BasePart, title: string, accent: Color3, style: string?)
    for _, child in board:GetChildren() do
        if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
            child:Destroy()
        end
    end
    addBoardFrame(board, style or "plaque")
    addSurfaceText(board, title, accent)
end

function WorldSignBuilder.createDirectionSign(
    parent: Instance,
    name: string,
    at: CFrame,
    title: string,
    accent: Color3
): Model
    local model = Instance.new("Model")
    model.Name = name
    model:SetAttribute("PhysicalSign", true)
    model.Parent = parent

    local board = part(
        model,
        "DirectionBoard",
        Vector3.new(8, 2.45, 0.52),
        at,
        Color3.fromRGB(83, 57, 38),
        Enum.Material.WoodPlanks
    )
    part(
        model,
        "DirectionPost",
        Vector3.new(0.68, 5.8, 0.68),
        at * CFrame.new(-2.65, -3.7, 0.18) * CFrame.Angles(0, 0, math.rad(-4)),
        WET_BARK,
        Enum.Material.Wood
    )
    part(
        model,
        "DirectionPostBrace",
        Vector3.new(0.4, 3.1, 0.4),
        at * CFrame.new(-3.25, -4.25, 0.3) * CFrame.Angles(0, 0, math.rad(24)),
        BARK,
        Enum.Material.Wood
    )
    WorldSignBuilder.dressBoard(board, title, accent, "direction")
    model.PrimaryPart = board
    return model
end

local function addNoticeArtwork(paper: BasePart, panelId: string)
    local panel = WorldArtRegistry.noticePanel(panelId)
    assert(panel ~= nil, "unknown notice artwork " .. panelId)
    local surface = Instance.new("SurfaceGui")
    surface.Name = "NoticeArtwork"
    surface.Face = Enum.NormalId.Front
    surface.LightInfluence = 0.2
    surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surface.PixelsPerStud = 96
    surface.Parent = paper

    local image = Instance.new("ImageLabel")
    image.Name = "NoticeImage_" .. panelId
    image.BackgroundTransparency = 1
    image.Size = UDim2.fromScale(1, 1)
    image.Image = "rbxassetid://" .. tostring(panel.assetId)
    image.ImageRectOffset = Vector2.new(panel.offsetX, panel.offsetY)
    image.ImageRectSize = Vector2.new(panel.width, panel.height)
    image.ScaleType = Enum.ScaleType.Stretch
    image.Parent = surface
    paper:SetAttribute("NoticePanelId", panelId)
    paper:SetAttribute("NoticeAssetId", panel.assetId)
end

function WorldSignBuilder.dressNoticeBoard(
    board: BasePart,
    title: string,
    accent: Color3,
    panelIds: { string }
)
    WorldSignBuilder.dressBoard(board, title, accent, "notice")
    local details = board:FindFirstChild("PhysicalSignDetails")
    assert(details ~= nil, "notice board frame missing")

    local titlePlate = part(
        details,
        "NoticeBoardHeader",
        Vector3.new(math.min(board.Size.X * 0.92, 10.6), 1.45, 0.3),
        board.CFrame
            * CFrame.new(0, board.Size.Y * 0.5 + 0.92, -(board.Size.Z * 0.5 + 0.3))
            * CFrame.Angles(0, 0, math.rad(-1.5)),
        WET_BARK,
        Enum.Material.WoodPlanks
    )
    addSurfaceText(titlePlate, title, accent, true)
    -- Both notice boards are also mesh-replacement fallbacks, and the authored
    -- Creator Store board carries no notices of its own -- it is bare wood. So
    -- the header and the pinned art below have to outlive the replacement, or
    -- the board a player walks up to says nothing at all.
    titlePlate:SetAttribute("KeepVisibleOnReplacement", true)

    -- The header owns the wording; the board face holds actual pinned art.
    local boardSurface = board:FindFirstChild("PhysicalSignText")
    if boardSurface ~= nil then
        boardSurface:Destroy()
    end

    local columns = math.min(3, #panelIds)
    local rows = math.ceil(#panelIds / columns)
    local paperWidth = math.min(2.55, (board.Size.X - 1.2) / columns - 0.3)
    local paperHeight = paperWidth / 1.5
    local usableHeight = board.Size.Y - 0.9
    local rowSpacing = math.min(paperHeight + 0.35, usableHeight / rows)
    for index, panelId in panelIds do
        local row = math.floor((index - 1) / columns)
        local column = (index - 1) % columns
        local columnsInRow = math.min(columns, #panelIds - row * columns)
        local x = (column - (columnsInRow - 1) * 0.5) * (paperWidth + 0.35)
        local y = (rows - 1) * rowSpacing * 0.5 - row * rowSpacing - 0.12
        local rotation = math.rad(((index * 7) % 9) - 4)
        local paper = part(
            details,
            if board.Name == "TownBoard" then "TownNotice_" .. panelId else "ArchiveNotice",
            Vector3.new(paperWidth, paperHeight, 0.1),
            board.CFrame
                * CFrame.new(x, y, -(board.Size.Z * 0.5 + 0.22))
                * CFrame.Angles(0, 0, rotation),
            PARCHMENT,
            Enum.Material.Fabric
        )
        paper.CastShadow = false
        paper:SetAttribute("KeepVisibleOnReplacement", true)
        addNoticeArtwork(paper, panelId)

        local pin = part(
            details,
            "NoticeIronPin",
            Vector3.new(0.16, 0.16, 0.13),
            paper.CFrame * CFrame.new(0, paperHeight * 0.38, -0.12),
            IRON,
            Enum.Material.Metal
        )
        pin.Shape = Enum.PartType.Ball
        pin:SetAttribute("KeepVisibleOnReplacement", true)
        if index % 2 == 0 then
            local seal = part(
                details,
                "NoticeWaxSeal",
                Vector3.new(0.32, 0.32, 0.1),
                paper.CFrame * CFrame.new(paperWidth * 0.34, -paperHeight * 0.34, -0.12),
                WAX,
                Enum.Material.SmoothPlastic
            )
            seal.Shape = Enum.PartType.Ball
            seal:SetAttribute("KeepVisibleOnReplacement", true)
        end
    end
    board:SetAttribute("NoticeCount", #panelIds)
    board:SetAttribute("PhysicalNoticeBoard", true)
end

return table.freeze(WorldSignBuilder)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="172">
      <Properties>
        <string name="Name">LastLightTests</string>
      </Properties>
      <Item class="Script" referent="173">
        <Properties>
          <string name="Name">FoundationIntegration</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local CollectionService = game:GetService("CollectionService")

local root = ReplicatedStorage:WaitForChild("LastLight", 8)
assert(root ~= nil, "shared root unavailable in Studio integration test")

local serverRoot = ServerScriptService:WaitForChild("LastLightServer", 8)
assert(serverRoot ~= nil, "server root unavailable in Studio integration test")

local Config = require(root.Config)
local MusicCatalog = require(root.MusicCatalog)
local MemoryFragments = require(root.MemoryFragments)
local BramblewakeExpedition = require(root.Content.Definitions.BramblewakeExpedition)
local BramblewakeEnemies = require(root.BramblewakeEnemies)
local CombatState = require(root.CombatState)
local CraftingCatalog = require(root.CraftingCatalog)
local ToolCatalog = require(root.ToolCatalog)
local EnemyAttackFlow = require(root.EnemyAttackFlow)
local EnemyCombatRules = require(root.EnemyCombatRules)
local EngineerBrace = require(root.EngineerBrace)
local ExpeditionEventFlow = require(root.ExpeditionEventFlow)
local ExpeditionGenerator = require(root.ExpeditionGenerator)
local OldGrowthEncounter = require(root.OldGrowthEncounter)
local WardenStagEncounter = require(root.WardenStagEncounter)
local BramblewakeBlackout = require(root.BramblewakeBlackout)
local ProfessionCatalog = require(root.ProfessionCatalog)
local ProfessionAbilityVisuals = require(root.ProfessionAbilityVisuals)
local ProfessionRescue = require(root.ProfessionRescue)
local ProfessionState = require(root.ProfessionState)
local ReviveFlow = require(root.ReviveFlow)
local RuntimeIds = require(root.RuntimeIds)
local SurvivalState = require(root.SurvivalState)
local StatusEffectState = require(root.StatusEffectState)
local TownNightIncident = require(root.TownNightIncident)
local TownGuardLastStand = require(root.TownGuardLastStand)
local SaveSchema = require(root.SaveSchema)
local ProfileBackup = require(root.ProfileBackup)
local TownCondition = require(root.TownCondition)
local Registry = require(root.Content.Registry)
local Regions = require(root.Content.Definitions.Regions)
local ServiceRegistry = require(serverRoot.ServiceRegistry)
local OldGrowthBuilder = require(serverRoot.World.OldGrowthBuilder)
local WardenStagBuilder = require(serverRoot.World.WardenStagBuilder)
local TerrainBuilder = require(serverRoot.World.TerrainBuilder)

local content = Registry.new(Regions)
assert(Config.SaveSchemaVersion == 25, "unexpected save schema version")
assert(Config.BuildVersion == "0.53.0", "unexpected build version")
assert(content:count() == 7, "all launch region definitions must load")
assert(content:has("region_bramblewake"), "starter region is missing")
assert(#MusicCatalog.regionIds() == 8, "every playable world needs an adaptive score")
assert(#MusicCatalog.tracks() == 25, "adaptive score must include 24 regional tracks and Blackout")
assert(
    MusicCatalog.resolve("region_bramblewake", "night", false).intensity
        > MusicCatalog.resolve("region_bramblewake", "day", false).intensity,
    "Bramblewake night music must be scarier than its day music"
)
assert(
    #ProfessionAbilityVisuals.list() == #ProfessionCatalog.list(),
    "profession ability visual catalog is incomplete"
)
assert(#ProfessionCatalog.list() == 7, "the roster is the full seven professions")
local studioBrace = EngineerBrace.deploy(EngineerBrace.default(), 10, 12, 14, 42)
local studioBraceAfterHit, studioBraceHit = EngineerBrace.absorb(studioBrace, 9, 11)
assert(
    studioBraceHit.absorbed == 9 and studioBraceAfterHit.capacity == 5,
    "Engineer Rootline Brace contract is missing"
)
local _, studioLastStand = TownGuardLastStand.attempt(TownGuardLastStand.default(), {
    phase = "night",
    nightNumber = 2,
    lanternHealth = 60,
    eligiblePlayers = 3,
    downedPlayers = 3,
})
assert(
    studioLastStand.accepted
        and studioLastStand.lanternCost == 12
        and studioLastStand.recoveryHealth == 50,
    "Town Guard Last Stand contract is missing"
)
-- The two properties a restore fails silently without: it has to out-rank the
-- live save or ProfilePersistence refuses the write, and it must not carry the
-- session lock that rode along inside the profile when the copy was taken.
local studioBackupRing = ProfileBackup.capture(nil, {
    revision = 4,
    schemaVersion = Config.SaveSchemaVersion,
    sessionLock = { jobId = "job", heartbeat = 1 },
}, 100, "interval", Config.ProfileBackupRetained)
local studioRestored = ProfileBackup.restoredProfile(ProfileBackup.newest(studioBackupRing), 9, 500)
assert(
    studioRestored.revision == 10 and studioRestored.sessionLock == nil,
    "profile backup restore contract is missing"
)
-- Damage belongs to a building, and repairing one must not touch another. The
-- single-integrity model this replaced could not express that: every repair
-- moved one shared number, so fixing the inn could un-damage the archive.
local studioRoster = { "building_archive", "building_inn" }
local studioDamaged = TownCondition.afterNight(TownCondition.default(), 10, 1, studioRoster)
local studioRepaired = TownCondition.repair(studioDamaged, "building_inn")
assert(
    TownCondition.integrityFor(studioRepaired, "building_inn") == 85
        and TownCondition.integrityFor(studioRepaired, "building_archive")
            == TownCondition.integrityFor(studioDamaged, "building_archive"),
    "per-building town repair contract is missing"
)

local calls = 0
local service = {
    Name = "StudioIntegrationService",
    Init = function()
        calls += 1
    end,
    Start = function()
        calls += 1
    end,
}

local services = ServiceRegistry.new({ integration = true })
services:register(service)
services:initialize()
services:start()

assert(calls == 2, "service lifecycle did not initialize and start")
assert(services:state() == "started", "service registry did not reach started state")

local survival = SurvivalState.create(100)
local downed = SurvivalState.damage(survival, 100, 101)
assert(downed.status == "downed", "survival contract did not enter downed state")
assert(downed.bleedoutAt == 131, "survival contract uses the wrong bleedout window")
local reviveChannel = ReviveFlow.create(10, 20, downed.revision, 102, 2.5)
local reviveDecision = ReviveFlow.evaluate(reviveChannel, 104.5, {
    reachable = true,
    reviverCanAct = true,
    reviverPresent = true,
    reviverRevision = downed.revision,
    targetDowned = true,
    targetPresent = true,
})
assert(reviveDecision.status == "complete", "revive contract did not complete")
local revived = SurvivalState.revive(downed, 104.5)
assert(revived.health == 35 and revived.status == "active", "revive health contract failed")
assert(RuntimeIds.Actions.Revive == "revive", "revive action ID changed")
assert(RuntimeIds.Actions.Dodge == "dodge", "dodge action ID changed")
assert(
    RuntimeIds.Actions.ProfessionAbility == "profession_ability",
    "profession ability action ID changed"
)
assert(
    RuntimeIds.Actions.SelectProfession == "select_profession",
    "profession selection action ID changed"
)
assert(RuntimeIds.Actions.RepairTown == "repair_town", "town repair action ID changed")
assert(
    RuntimeIds.Actions.ResolveTownIncident == "resolve_town_incident",
    "town incident action ID changed"
)
assert(
    RuntimeIds.Actions.RecoverExpeditionCache == "recover_expedition_cache",
    "recovery-cache action ID changed"
)
assert(
    RuntimeIds.Actions.SelectProfessionSpecialization == "select_profession_specialization",
    "profession specialization action ID changed"
)
assert(
    #RuntimeIds.ProfessionSpecializationInteractionIds == #ProfessionCatalog.list() * 3,
    "profession specialization interaction catalog is incomplete"
)
assert(
    TownNightIncident.forTheme("EMBERFALL").id == "incident_emberfall_cinders",
    "town incident catalog is missing"
)
assert(
    TownNightIncident.forTheme("EMBERFALL", 5).id == "incident_emberfall_flues",
    "alternate town incident catalog is missing"
)
local medicRescue = ProfessionRescue.resolve("profession_medic", 1, 2.5, 35, 3)
assert(medicRescue.duration < 2.5 and medicRescue.health == 45, "Medic rescue tuning is missing")
assert(RuntimeIds.Actions.OldGrowthFire == "old_growth_fire", "Old Growth action ID changed")
assert(RuntimeIds.Actions.WardenStagChoice == "warden_stag_choice", "Warden Stag action ID changed")
assert(
    RuntimeIds.Actions.BramblewakeBlackout == "bramblewake_blackout",
    "Blackout action ID changed"
)

local combat = CombatState.create(200)
local sprinting = CombatState.setSprint(combat, true, 200, true)
local drained = CombatState.advance(sprinting, 201, true)
-- One second of sprint at SprintDrainPerSecond = 7, then a 35-cost dodge.
-- These moved when sprint was retuned from an unusable five-second bar; they
-- are derived from Config rather than copied from whatever the run printed.
assert(drained.stamina == 93 and drained.sprinting, "server sprint stamina contract failed")
local dodging = CombatState.dodge(drained, 201, true)
assert(dodging.stamina == 58, "server dodge cost contract failed")
assert(CombatState.avoidsDamage(dodging, 201.2), "dodge protection window is missing")
local attack = EnemyAttackFlow.create(10, 201, Config.RootlingAttackWindupSeconds)
local attackDecision = EnemyAttackFlow.evaluate(attack, attack.endsAt, {
    clearPath = true,
    inImpactArea = true,
    targetCanAct = true,
    targetPresent = true,
})
assert(attackDecision.status == "resolve", "Rootling telegraph contract did not resolve")
local enemyOrder = BramblewakeEnemies.order()
assert(#enemyOrder == 6, "Bramblewake runtime roster must contain six enemies")
assert(enemyOrder[1] == "enemy_rootling", "Bramblewake runtime roster changed order")
assert(enemyOrder[6] == "enemy_bark_ram", "Bark Ram is missing from the runtime roster")
assert(
    EnemyCombatRules.contains("lane", 0, 4, nil, 6, 12),
    "lane attack geometry did not include its readable center"
)
local briarback = BramblewakeEnemies.require("enemy_briarback")
local shieldDamage, shieldResult = EnemyCombatRules.strikeDamage(briarback, 0.8)
assert(shieldDamage == 8 and shieldResult == "shielded", "Briarback shield contract failed")
local drowsy = StatusEffectState.applyDrowsy(StatusEffectState.create(), 300, 3, 0.65)
assert(
    StatusEffectState.snapshot(drowsy, 301).movementMultiplier == 0.65,
    "Pollen Wisp drowsy contract failed"
)
local rooted = StatusEffectState.applyRooted(StatusEffectState.create(), 300, 1.6, 0.35)
assert(
    StatusEffectState.snapshot(rooted, 301).movementMultiplier == 0.35,
    "Old Growth rooted contract failed"
)

local oldGrowth = OldGrowthEncounter.create("studio_run", "studio_manifest", true)
oldGrowth = OldGrowthEncounter.activate(oldGrowth, 10)
for _ = 1, 4 do
    oldGrowth = OldGrowthEncounter.strike(oldGrowth, 10, 34)
end
assert(
    oldGrowth.status == "shielded" and oldGrowth.health == 240,
    "Old Growth first shield contract failed"
)
oldGrowth = OldGrowthEncounter.takeFire(oldGrowth, 10, 400)
oldGrowth = OldGrowthEncounter.burnHeart(oldGrowth, 10, 401)
assert(oldGrowth.status == "vulnerable", "Old Growth fire break did not expose the heart")
for _ = 1, 4 do
    oldGrowth = OldGrowthEncounter.strike(oldGrowth, 10, 34)
end
assert(
    oldGrowth.status == "shielded" and oldGrowth.health == 120,
    "Old Growth second shield contract failed"
)
oldGrowth = OldGrowthEncounter.takeFire(oldGrowth, 10, 410)
oldGrowth = OldGrowthEncounter.burnHeart(oldGrowth, 10, 411)
for _ = 1, 4 do
    oldGrowth = OldGrowthEncounter.strike(oldGrowth, 10, 34)
end
local oldGrowthWinner = OldGrowthEncounter.snapshot(oldGrowth, 10, 412)
local oldGrowthLateArrival = OldGrowthEncounter.snapshot(oldGrowth, 20, 412)
assert(oldGrowth.status == "complete", "Old Growth completion contract failed")
assert(oldGrowthWinner.rewardEligible, "Old Growth participant lost reward eligibility")
assert(not oldGrowthLateArrival.rewardEligible, "late arrival received false reward eligibility")
assert(
    OldGrowthEncounter.rewardTransactionId(oldGrowth, 10)
        == "elite_old_growth:studio_run:studio_manifest:10",
    "Old Growth reward transaction is not stable"
)
local oldGrowthModel = OldGrowthBuilder.build(Vector3.new(0, 0, 0), Vector3.new(0, 0, -10), 360)
assert(oldGrowthModel.PrimaryPart ~= nil, "Old Growth model has no primary part")
assert(
    oldGrowthModel:GetAttribute("EliteId") == "elite_old_growth",
    "Old Growth model is missing its stable ID"
)
oldGrowthModel:Destroy()

local wardenStag = WardenStagEncounter.create("studio_run", "studio_manifest", true)
wardenStag = WardenStagEncounter.unlock(wardenStag)
wardenStag = WardenStagEncounter.activate(wardenStag, 10)
for _, nodeId in { "root_node_north", "root_node_east" } do
    wardenStag = WardenStagEncounter.cleanseRoot(wardenStag, 10, nodeId)
end
assert(wardenStag.status == "vulnerable", "Warden Stag roots did not expose phase one")
for _ = 1, 4 do
    wardenStag = WardenStagEncounter.strike(wardenStag, 10, 40)
end
for _, nodeId in { "root_node_north", "root_node_east", "root_node_south" } do
    wardenStag = WardenStagEncounter.cleanseRoot(wardenStag, 10, nodeId)
end
for _ = 1, 4 do
    wardenStag = WardenStagEncounter.strike(wardenStag, 10, 40)
end
for _, nodeId in
    {
        "root_node_north",
        "root_node_east",
        "root_node_south",
        "root_node_west",
    }
do
    wardenStag = WardenStagEncounter.cleanseRoot(wardenStag, 10, nodeId)
end
for _ = 1, 4 do
    wardenStag = WardenStagEncounter.strike(wardenStag, 10, 40)
end
assert(wardenStag.status == "complete", "Warden Stag completion contract failed")
assert(wardenStag.outcome == "preserved", "clean Warden Stag route did not preserve the forest")
assert(
    WardenStagEncounter.rewardTransactionId(wardenStag, 10)
        == "boss_warden_stag:studio_run:studio_manifest:10",
    "Warden Stag reward transaction is not stable"
)
local wardenModel = WardenStagBuilder.build(Vector3.new(0, 0, 0), Vector3.new(0, 0, -10), 480)
assert(wardenModel.PrimaryPart ~= nil, "Warden Stag model has no primary part")
assert(
    wardenModel:GetAttribute("BossId") == "boss_warden_stag",
    "Warden Stag model is missing its stable ID"
)
wardenModel:Destroy()

local blackout = BramblewakeBlackout.create("studio_run", "studio_manifest", true, 540)
blackout = BramblewakeBlackout.start(blackout, 10, 500)
for _, nodeId in
    {
        "blackout_root_farm",
        "blackout_root_mill",
        "blackout_root_cathedral",
    }
do
    blackout = BramblewakeBlackout.takeFire(blackout, 10, 501)
    blackout = BramblewakeBlackout.deliverFire(blackout, 10, nodeId, 502)
end
assert(blackout.status == "old_growth", "Blackout relay did not unlock Old Growth")
blackout = BramblewakeBlackout.completeOldGrowth(blackout)
assert(blackout.status == "warden", "Blackout did not advance to the Warden")
blackout = BramblewakeBlackout.completeWarden(blackout, "preserved")
blackout = BramblewakeBlackout.vote(blackout, 10, "shared_agroforest", { 10 })
assert(blackout.status == "complete", "Blackout chapter vote did not resolve")
assert(
    BramblewakeBlackout.chapterTransactionId(blackout, 10)
        == "chapter_1:studio_run:studio_manifest:10",
    "Blackout chapter transaction is not stable"
)
local profile = SaveSchema.default(500)
local resolvedProfile, chapterResult = SaveSchema.withChapterOneResolution(
    profile,
    BramblewakeBlackout.chapterTransactionId(blackout, 10),
    blackout.decision,
    blackout.wardenOutcome,
    600
)
assert(chapterResult.applied, "chapter one result did not persist")
assert(
    resolvedProfile.story.chapterOne.decision == "shared_agroforest",
    "chapter one decision changed during persistence"
)

local profession =
    ProfessionState.create(ProfessionCatalog.Ids.Warden, workspace:GetServerTimeNow())
