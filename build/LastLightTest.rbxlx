        attackName = "SNAPVINE BITE",
        instruction = "BACK OUT OF THE ROOT RING",
        shape = "circle",
        radius = 9,
        width = nil,
        length = nil,
        windup = 1.15,
        stationary = true,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
