        <Item class="ModuleScript" referent="162">
          <Properties>
            <string name="Name">MeshMaterialPlan</string>
            <string name="Source"><![CDATA[--!strict

-- Roblox's GLB importer preserves the mesh groups used by the authored kit,
-- but model thumbnails and runtime loads otherwise fall back to gray
-- SmoothPlastic. Keep the material decision data-only so it can be validated
-- outside Studio; MeshTemplateLoader owns the actual Enum.Material mapping.

local MeshMaterialPlan = {}

export type Style = {
    material: string,
    color: { number },
}

local STYLES: { [string]: Style } = {
    bark_dark = { material = "Wood", color = { 36, 26, 24 } },
    bark_mid = { material = "Wood", color = { 62, 39, 30 } },
    bark_cut = { material = "WoodPlanks", color = { 121, 83, 52 } },
    pine_dark = { material = "LeafyGrass", color = { 18, 42, 32 } },
    pine_mid = { material = "LeafyGrass", color = { 42, 77, 51 } },
    leaf_dark = { material = "LeafyGrass", color = { 31, 68, 41 } },
    leaf_mid = { material = "LeafyGrass", color = { 58, 91, 54 } },
    moss = { material = "Grass", color = { 72, 104, 55 } },
    stone_dark = { material = "Slate", color = { 43, 52, 60 } },
    stone = { material = "Slate", color = { 75, 83, 89 } },
    fungus = { material = "Ground", color = { 135, 60, 29 } },
    foxfire = { material = "Neon", color = { 94, 206, 176 } },
    lantern_amber = { material = "Neon", color = { 255, 181, 76 } },
    iron = { material = "Metal", color = { 42, 46, 52 } },
    meadow = { material = "Grass", color = { 131, 93, 24 } },
}

-- Longest-first prevents `stone` and `bark` families from swallowing their
-- more specific dark/cut variants.
local ORDER = table.freeze({
    "lantern_amber",
    "stone_dark",
    "bark_dark",
    "bark_mid",
    "bark_cut",
    "pine_dark",
    "pine_mid",
    "leaf_dark",
    "leaf_mid",
    "foxfire",
    "fungus",
    "meadow",
    "stone",
    "moss",
    "iron",
})

function MeshMaterialPlan.groupForPart(partName: string): string?
    local normalized = string.lower(partName)
    -- The stable asset ID may itself contain a cue name (for example,
    -- `mesh_foxfire_windmill_tower_a`). Imported part names put the authored
    -- material group after `__`; match that segment so the asset prefix cannot
    -- turn ordinary iron or moss into Neon.
    local materialSegment = string.match(normalized, ".*__(.+)$") or normalized
    for _, group in ORDER do
        if string.find(materialSegment, group, 1, true) ~= nil then
            return group
        end
    end
    return nil
end

function MeshMaterialPlan.styleForPart(partName: string): Style?
    local group = MeshMaterialPlan.groupForPart(partName)
    if group == nil then
        return nil
    end
    return STYLES[group]
end

function MeshMaterialPlan.groups(): { string }
    return table.clone(ORDER)
end

return table.freeze(MeshMaterialPlan)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="163">
          <Properties>
            <string name="Name">MeshTemplateLoader</string>
            <string name="Source"><![CDATA[--!strict

local AssetService = game:GetService("AssetService")
local InsertService = game:GetService("InsertService")

local MeshAssetRegistry = require(script.Parent.MeshAssetRegistry)
local MeshMaterialPlan = require(script.Parent.MeshMaterialPlan)

local MeshTemplateLoader = {}
MeshTemplateLoader.__index = MeshTemplateLoader

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type MeshTemplateLoader = typeof(setmetatable(
    {} :: {
        _logger: Logger,
        _templates: { [string]: Model },
        _templateScale: { [string]: number },
        _failed: { [string]: boolean },
        _permanentFailure: { [string]: boolean },
    },
    MeshTemplateLoader
))

type RestyleRule = { match: { number }, color: { number }?, material: string? }

local function matchesRestyleColor(color: Color3, match: { number }): boolean
    return math.abs(color.R * 255 - match[1]) <= 4
        and math.abs(color.G * 255 - match[2]) <= 4
        and math.abs(color.B * 255 - match[3]) <= 4
end

local function sanitize(
    model: Model,
    stripDecals: boolean,
    restyleParts: { RestyleRule }?
): (number, number)
    local meshParts = 0
    local baseParts = 0
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("BasePart") then
            baseParts += 1
            descendant.Anchored = true
            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false
            descendant.CastShadow = true
            descendant.Massless = true
            if restyleParts ~= nil then
                for _, rule in restyleParts do
                    if matchesRestyleColor(descendant.Color, rule.match) then
                        if rule.color ~= nil and descendant:IsA("UnionOperation") then
                            descendant.UsePartColor = true
                        end
                        if rule.color ~= nil then
                            descendant.Color =
                                Color3.fromRGB(rule.color[1], rule.color[2], rule.color[3])
                        end
                        if rule.material ~= nil then
                            descendant.Material = (Enum.Material :: any)[rule.material]
                        end
                        break
                    end
                end
            end
            if descendant:IsA("MeshPart") then
                meshParts += 1
            end
        elseif
            descendant:IsA("LuaSourceContainer")
            or descendant:IsA("ProximityPrompt")
            or descendant:IsA("ClickDetector")
            or descendant:IsA("DragDetector")
            or descendant:IsA("LayerCollector")
            or descendant:IsA("GuiObject")
            or descendant:IsA("Camera")
            or descendant:IsA("ValueBase")
            or descendant:IsA("Constraint")
            or descendant:IsA("JointInstance")
            or descendant:IsA("Humanoid")
            or descendant:IsA("AnimationController")
            or descendant:IsA("Sound")
            or descendant:IsA("PostEffect")
            or descendant:IsA("BodyMover")
            or (stripDecals and (descendant:IsA("Decal") or descendant:IsA("Texture")))
        then
            descendant:Destroy()
        end
    end
    return meshParts, baseParts
end

local MAX_LOAD_ATTEMPTS = 3

local function longestDimension(size: Vector3): number
    return math.max(size.X, size.Y, size.Z)
end

local ROBLOX_MATERIALS = table.freeze({
    Grass = Enum.Material.Grass,
    Ground = Enum.Material.Ground,
    LeafyGrass = Enum.Material.LeafyGrass,
    Metal = Enum.Material.Metal,
    Neon = Enum.Material.Neon,
    Slate = Enum.Material.Slate,
    Wood = Enum.Material.Wood,
    WoodPlanks = Enum.Material.WoodPlanks,
})

local function applyBuiltInMaterials(
    model: Model,
    customPbr: boolean,
    preserveSourceMaterials: boolean
): (number, number)
    if customPbr or preserveSourceMaterials then
        return 0, 0
    end

    local styled = 0
    local unstyled = 0
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("MeshPart") then
            local style = MeshMaterialPlan.styleForPart(descendant.Name)
            if style == nil then
                unstyled += 1
            else
                local material = ROBLOX_MATERIALS[style.material]
                local color = style.color
                assert(material ~= nil, "unknown built-in mesh material " .. style.material)
                descendant.Material = material
                descendant.MaterialVariant = ""
                descendant.Color = Color3.fromRGB(color[1], color[2], color[3])
                for _, child in descendant:GetChildren() do
                    if child:IsA("SurfaceAppearance") then
                        child:Destroy()
                    end
                end
                styled += 1
            end
        end
    end
    return styled, unstyled
end

local function applyProfileScale(model: Model, profileScale: Vector3)
    if profileScale == Vector3.one then
        return
    end

    local pivot = model:GetPivot()
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("BasePart") then
            local relative = pivot:ToObjectSpace(descendant.CFrame)
            descendant.Size *= profileScale
            descendant.CFrame = pivot
                * CFrame.new(relative.Position * profileScale)
                * relative.Rotation
        end
    end
end

function MeshTemplateLoader.new(logger: Logger): MeshTemplateLoader
    return setmetatable({
        _logger = logger,
        _templates = {},
        _templateScale = {},
        _failed = {},
        _permanentFailure = {},
    }, MeshTemplateLoader)
end

function MeshTemplateLoader._load(self: MeshTemplateLoader, stableId: string): Model?
    local cached = self._templates[stableId]
    if cached ~= nil then
        return cached
    end
    if self._failed[stableId] then
        return nil
    end

    local entry = MeshAssetRegistry.get(stableId)
    if entry == nil then
        self._failed[stableId] = true
        self._permanentFailure[stableId] = true
        self._logger:info("mesh_asset_unknown", { assetId = stableId })
        return nil
    end
    if entry.placementBand == "retired_visual_failure" then
        self._failed[stableId] = true
        self._permanentFailure[stableId] = true
        self._logger:info("mesh_asset_retired", { assetId = stableId })
        return nil
    end

    --[[
        Retry a failed fetch before condemning the asset for the session.

        One blip used to cost the whole run. A failure here sets
        self._failed[stableId], which is checked before every later placement
        of the same asset -- so a single transient error does not lose one
        prop, it silently drops every instance of that asset in the world and
        leaves procedural fallbacks in their place. Observed repeatedly under
        Wine: the same IDs that fail one boot load cleanly the next, reporting
        "User is not authorized to access Asset" for an asset the account
        plainly can access. That is throttling or CDN flakiness, not a
        permission fact.

        Three attempts with a widening pause. Bounded on purpose: a genuinely
        unavailable asset still gets condemned quickly rather than being
        retried once per placement, and the cost is paid once per asset at
        template load, not per instance.
    ]]
    local ok, loaded
    local attempts = 0
    repeat
        attempts += 1
        if entry.creatorStore then
            ok, loaded = pcall(AssetService.LoadAssetAsync, AssetService, entry.assetId)
        else
            ok, loaded = pcall(InsertService.LoadAsset, InsertService, entry.assetId)
        end
        local usable = ok and typeof(loaded) == "Instance" and loaded:IsA("Model")
        if usable then
            break
        end
        if ok and typeof(loaded) == "Instance" then
            loaded:Destroy()
        end
        self._logger:info("mesh_asset_load_retry", {
            assetId = stableId,
            robloxAssetId = entry.assetId,
            attempt = attempts,
            error = if ok then "LoadAsset returned a non-Model" else tostring(loaded),
        })
        if attempts < MAX_LOAD_ATTEMPTS then
            task.wait(attempts * 0.75)
        end
    until attempts >= MAX_LOAD_ATTEMPTS
    if not ok or typeof(loaded) ~= "Instance" or not loaded:IsA("Model") then
        if ok and typeof(loaded) == "Instance" then
            loaded:Destroy()
        end
        self._failed[stableId] = true
        self._logger:info("mesh_asset_load_failed", {
            assetId = stableId,
            robloxAssetId = entry.assetId,
            attempts = attempts,
            error = if ok then "LoadAsset returned a non-Model" else tostring(loaded),
        })
        return nil
    end

    loaded.Name = "Template_" .. stableId
    local meshPartCount, basePartCount =
        sanitize(loaded, entry.stripDecals == true, entry.restyleParts)
    local styledParts, unstyledParts =
        applyBuiltInMaterials(loaded, entry.pbr, entry.preserveSourceMaterials)
    -- Cancel the source model's stored rotation BEFORE measuring anything. A
    -- model saved off-axis inflates its own axis-aligned bounding box -- the
    -- bed reads 13.85 x 15.97 as stored but is really 8.04 x 14.28 -- so
    -- normalizing against the inflated box quietly shrinks the asset while
    -- targetLongestDimension still looks honoured. Correcting here rather than
    -- at each call site also makes placement yaw mean what it says everywhere
    -- the asset is used, instead of every caller carrying the same offset.
    local sourceYaw = entry.sourceYawDegrees
    if sourceYaw ~= nil and sourceYaw ~= 0 then
        -- Post-multiply so the yaw is cancelled about the model's own pivot.
        -- Pre-multiplying rotates about the world origin instead, which also
        -- drags the model's position -- harmless while the pivot rotation is
        -- identity, but wrong the moment a source model ships with a
        -- PrimaryPart carrying its own rotation, which Creator Store models do.
        loaded:PivotTo(loaded:GetPivot() * CFrame.Angles(0, -math.rad(sourceYaw), 0))
    end
    local _, nativeSize = loaded:GetBoundingBox()
    local nativeLongest = longestDimension(nativeSize)
    local normalizationScale = MeshAssetRegistry.scaleFor(stableId, nativeLongest)
    if basePartCount == 0 or normalizationScale == nil then
        loaded:Destroy()
        self._failed[stableId] = true
        self._logger:info("mesh_asset_invalid", {
            assetId = stableId,
            meshParts = meshPartCount,
            baseParts = basePartCount,
            nativeLongestDimension = nativeLongest,
        })
        return nil
    end

    local desiredScale = loaded:GetScale() * normalizationScale
    loaded:ScaleTo(desiredScale)
    local boundsCFrame, boundsSize = loaded:GetBoundingBox()
    loaded.WorldPivot = CFrame.new(boundsCFrame.Position - Vector3.new(0, boundsSize.Y * 0.5, 0))
    loaded:PivotTo(CFrame.new())
    loaded:SetAttribute("SourceMaterialsPreserved", entry.preserveSourceMaterials)
    loaded.Parent = nil

    self._templates[stableId] = loaded
    self._templateScale[stableId] = desiredScale
    self._logger:info("mesh_asset_ready", {
        assetId = stableId,
        robloxAssetId = entry.assetId,
        meshParts = meshPartCount,
        baseParts = basePartCount,
        styledParts = styledParts,
        unstyledParts = unstyledParts,
        preserveSourceMaterials = entry.preserveSourceMaterials,
        nativeLongestDimension = nativeLongest,
        targetLongestDimension = entry.targetLongestDimension,
    })
    return loaded
end

function MeshTemplateLoader.place(
    self: MeshTemplateLoader,
    stableId: string,
    parent: Instance,
    at: CFrame,
    placementScale: number,
    profileScale: Vector3?
): Model?
    local template = self:_load(stableId)
    local templateScale = self._templateScale[stableId]
    if template == nil or templateScale == nil or placementScale <= 0 then
        return nil
    end

    local clone = template:Clone()
    clone.Name = "Authored_" .. stableId
    clone:ScaleTo(templateScale * placementScale)
    local resolvedProfileScale = profileScale or Vector3.one
    applyProfileScale(clone, resolvedProfileScale)
    clone:PivotTo(at)
    clone:SetAttribute("MeshAssetId", stableId)
    clone:SetAttribute("PlacementScale", placementScale)
    clone:SetAttribute("ProfileScale", resolvedProfileScale)
    clone.Parent = parent
    return clone
end

--[[
    Give condemned assets another chance.

    A load failure marks an asset failed for the whole session, which is the
    right call per placement -- but boot loads sixty assets in a burst, and
    the platform sometimes answers a burst with throttling errors dressed as
    permission errors (see the retry comment in _load). One bad boot minute
    left all eleven town-ring buildings as dark fallback shells for the whole
    server lifetime. This clears only the transient failures, so a later
    recovery pass can try again; unknown and retired assets stay condemned.

    Returns the asset ids that were forgiven.
]]
function MeshTemplateLoader.forgetTransientFailures(self: MeshTemplateLoader): { string }
    local forgiven = {}
    for stableId in self._failed do
        if not self._permanentFailure[stableId] then
            table.insert(forgiven, stableId)
        end
    end
    for _, stableId in forgiven do
        self._failed[stableId] = nil
    end
    return forgiven
end

return table.freeze(MeshTemplateLoader)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="164">
          <Properties>
            <string name="Name">MireglassBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Mireglass Fen's geometry.

    The Delve reads as underground because every module carries a roof.
    The Fen reads as drowned because every module carries water, and the
    water is the thing you cannot trust: it is glassy enough to mirror
    the sky, so a player looking at the ground is often looking at a
    reflection of what is above it. That is the region's whole idea, and
    it is built rather than described -- reed mats that float, boardwalks
    that stop, stilts that have walked in the mud, and mirror flats that
    reflect a path which is not there.

    Its palette is the opposite of the Delve's: no ember, no iron, no
    lamp. Pale glass, wet green, bog brown, and witchlight, which is the
    only light in the Fen that anything made on purpose.
]]

local MireglassBuilder = {}

local WATER = Color3.fromRGB(46, 66, 68)
local DEEP_WATER = Color3.fromRGB(28, 44, 48)
local REED = Color3.fromRGB(96, 118, 72)
local DRY_REED = Color3.fromRGB(140, 132, 84)
local BOG = Color3.fromRGB(58, 52, 40)
local PLANK = Color3.fromRGB(104, 88, 66)
local DARK_PLANK = Color3.fromRGB(68, 56, 42)
local MIREGLASS = Color3.fromRGB(186, 206, 210)
local WITCHLIGHT = Color3.fromRGB(146, 214, 226)
local BOG_IRON = Color3.fromRGB(96, 74, 58)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function glow(
    parent: Instance,
    name: string,
    position: Vector3,
    size: number,
    color: Color3,
    brightness: number
): Part
    local orb = part(
        parent,
        name,
        Vector3.new(size, size, size),
        CFrame.new(position),
        color,
        Enum.Material.Neon,
        false
    )
    orb.Shape = Enum.PartType.Ball
    orb.CanQuery = false
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = size * 7
    light.Brightness = brightness
    light.Shadows = false
    light.Parent = orb
    return light.Parent :: Part
end

--[[
    The sheet of water a module stands in. Reflectance is the point: this
    is what makes the Fen's ground a claim rather than a fact.
]]
local function fenWater(parent: Instance, center: Vector3, size: number, mirrored: boolean)
    local water = part(
        parent,
        "FenWater",
        Vector3.new(size, 0.8, size),
        CFrame.new(center + Vector3.new(0, 0.4, 0)),
        if mirrored then WATER else DEEP_WATER,
        Enum.Material.Glass,
        false
    )
    water.Transparency = if mirrored then 0.25 else 0.4
    water.Reflectance = if mirrored then 0.75 else 0.3
    water.CanQuery = false
end

local function reedStand(parent: Instance, center: Vector3, count: number, seed: number)
    for index = 0, count - 1 do
        local drift = (seed + index * 29) % 13 - 6
        local at = center + Vector3.new(drift * 0.9, 0, ((index % 5) - 2) * 1.4)
        part(
            parent,
            "Reed",
            Vector3.new(0.22, 5.5 + (index % 4), 0.22),
            CFrame.new(at + Vector3.new(0, 2.8, 0))
                * CFrame.Angles(math.rad(drift * 1.6), 0, math.rad(drift * 2.2)),
            if index % 3 == 0 then DRY_REED else REED,
            Enum.Material.Grass,
            false
        )
    end
end

-- A plank walk: the Fen's only honest ground, and it always runs out.
local function boardwalk(parent: Instance, center: Vector3, length: number, stopShort: boolean)
    local run = if stopShort then length * 0.6 else length
    part(
        parent,
        "Boardwalk",
        Vector3.new(6, 0.5, run),
        CFrame.new(center + Vector3.new(0, 1.4, -(length - run) * 0.5)),
        PLANK,
        Enum.Material.Wood
    )
    local posts = math.max(2, math.floor(run / 6))
    for index = 0, posts do
        for side = -1, 1, 2 do
            part(
                parent,
                "WalkPost",
                Vector3.new(0.6, 3, 0.6),
                CFrame.new(
                    center
                        + Vector3.new(
                            side * 2.4,
                            0,
                            -(length - run) * 0.5 - run * 0.5 + index * (run / posts)
                        )
                ),
                DARK_PLANK,
                Enum.Material.Wood
            )
        end
    end
end

-- A house on stilts, leaning the way the mud took it.
local function stiltHouse(parent: Instance, center: Vector3, lean: number)
    local body = part(
        parent,
        "StiltHouse",
        Vector3.new(11, 8, 9),
        CFrame.new(center + Vector3.new(0, 7.5, 0)) * CFrame.Angles(0, 0, math.rad(lean)),
        PLANK,
        Enum.Material.Wood
    )
    part(
        parent,
        "StiltRoof",
        Vector3.new(13, 1.2, 11),
        body.CFrame * CFrame.new(0, 4.4, 0),
        DARK_PLANK,
        Enum.Material.Wood,
        false
    )
    for side = -1, 1, 2 do
        for run = -1, 1, 2 do
            part(
                parent,
                "Stilt",
                Vector3.new(0.9, 8, 0.9),
                CFrame.new(center + Vector3.new(side * 4, 3.6, run * 3.4))
                    * CFrame.Angles(0, 0, math.rad(lean * 0.6)),
                DARK_PLANK,
                Enum.Material.Wood
            )
        end
    end
end

-- Mireglass itself: sheets of the stuff standing where the bog cooled.
local function glassSheet(parent: Instance, center: Vector3, height: number, tilt: number)
    local sheet = part(
        parent,
        "MireglassSheet",
        Vector3.new(6, height, 0.6),
        CFrame.new(center + Vector3.new(0, height * 0.5, 0)) * CFrame.Angles(0, tilt, math.rad(4)),
        MIREGLASS,
        Enum.Material.Glass
    )
    sheet.Transparency = 0.35
    sheet.Reflectance = 0.6
end

local function witchLantern(parent: Instance, position: Vector3)
    part(
        parent,
        "LanternPole",
        Vector3.new(0.4, 6, 0.4),
        CFrame.new(position + Vector3.new(0, 3, 0)),
        DARK_PLANK,
        Enum.Material.Wood
    )
    glow(parent, "Witchlight", position + Vector3.new(0, 6.2, 0), 1.2, WITCHLIGHT, 1.8)
end

local function puntBoat(parent: Instance, position: Vector3, facing: number, upturned: boolean)
    local hull = part(
        parent,
        "PuntHull",
        Vector3.new(3.6, 1.4, 11),
        CFrame.new(position + Vector3.new(0, 1.2, 0))
            * CFrame.Angles(if upturned then math.rad(180) else 0, facing, 0),
        PLANK,
        Enum.Material.Wood
    )
    part(
        parent,
        "PuntPole",
        Vector3.new(0.3, 0.3, 12),
        hull.CFrame * CFrame.new(1.6, 1.2, 0) * CFrame.Angles(math.rad(72), 0, 0),
        DARK_PLANK,
        Enum.Material.Wood,
        false
    )
end

-- A reed mat: floating ground that may or may not hold.
local function reedMat(parent: Instance, center: Vector3, size: number)
    local mat = part(
        parent,
        "ReedMat",
        Vector3.new(size, 0.5, size * 0.8),
        CFrame.new(center + Vector3.new(0, 0.9, 0)),
        REED,
        Enum.Material.Grass
    )
    mat.Transparency = 0.05
    for index = -1, 1 do
        part(
            parent,
            "MatFringe",
            Vector3.new(size * 0.9, 0.3, 1.2),
            CFrame.new(center + Vector3.new(index * 1.2, 0.7, index * size * 0.35)),
            DRY_REED,
            Enum.Material.Grass,
            false
        )
    end
end

local function bogIronPit(parent: Instance, center: Vector3)
    local pit = part(
        parent,
        "BogPit",
        Vector3.new(9, 1.2, 9),
        CFrame.new(center + Vector3.new(0, 0.6, 0)),
        BOG,
        Enum.Material.Ground
    )
    pit.Transparency = 0.05
    for index = 0, 3 do
        local angle = index * math.pi * 0.5
        part(
            parent,
            "BogIronLump",
            Vector3.new(1.8, 1.4, 1.8),
            CFrame.new(center + Vector3.new(math.cos(angle) * 2.6, 1.3, math.sin(angle) * 2.6)),
            BOG_IRON,
            Enum.Material.Metal,
            false
        )
    end
end

--[[
    The Fen's floor: wet ground with standing water over most of it, and
    a bank of bog at the edges so the module has a shape.
]]
local function fenGround(parent: Instance, center: Vector3)
    local ground = part(
        parent,
        "FenGround",
        Vector3.new(56, 1, 56),
        CFrame.new(center + Vector3.new(0, 0.2, 0)),
        BOG,
        Enum.Material.Ground,
        false
    )
    ground.CanQuery = false
    for side = -1, 1, 2 do
        part(
            parent,
            "FenBank",
            Vector3.new(6, 2.4, 46),
            CFrame.new(center + Vector3.new(side * 25, 1.2, 0))
                * CFrame.Angles(0, 0, math.rad(side * 3)),
            BOG,
            Enum.Material.Ground
        )
    end
end

--[[
    Assemble one module's visual. Same contract as the Delve's builder:
    an unknown key returns false, and the region cannot open until every
    key its catalog declares has a case here.
]]
function MireglassBuilder.buildModuleVisual(
    parent: Instance,
    visual: string,
    center: Vector3
): boolean
    if visual == "ferry_landing" then
        fenGround(parent, center)
        fenWater(parent, center + Vector3.new(0, 0, -10), 34, true)
        boardwalk(parent, center + Vector3.new(0, 0, 6), 26, false)
        puntBoat(parent, center + Vector3.new(-7, 0, -10), math.rad(12), false)
        witchLantern(parent, center + Vector3.new(6, 0, 2))
        return true
    elseif visual == "dry_causeway" then
        fenGround(parent, center)
        -- The way out is the one raised road the water never took.
        part(
            parent,
            "Causeway",
            Vector3.new(12, 3, 50),
            CFrame.new(center + Vector3.new(0, 1.6, 0)),
            BOG,
            Enum.Material.Ground
        )
        fenWater(parent, center + Vector3.new(-18, 0, 0), 18, true)
        fenWater(parent, center + Vector3.new(18, 0, 0), 18, true)
        witchLantern(parent, center + Vector3.new(0, 3, -14))
        return true
    elseif visual == "reed_harvest" then
        fenGround(parent, center)
        fenWater(parent, center, 40, false)
        for index = -1, 1 do
            reedStand(parent, center + Vector3.new(index * 9, 0, index * 5), 14, 11 + index)
        end
        boardwalk(parent, center + Vector3.new(0, 0, 12), 20, false)
        return true
    elseif visual == "bog_iron_pits" then
        fenGround(parent, center)
        bogIronPit(parent, center + Vector3.new(-8, 0, -4))
        bogIronPit(parent, center + Vector3.new(7, 0, 6))
        fenWater(parent, center + Vector3.new(0, 0, 14), 22, false)
        reedStand(parent, center + Vector3.new(12, 0, -10), 8, 5)
        return true
    elseif visual == "pollen_hollow" then
        fenGround(parent, center)
        fenWater(parent, center, 30, false)
        for index = 0, 5 do
            local angle = index * math.pi / 3
            glow(
                parent,
                "WitchlightPollen",
                center + Vector3.new(math.cos(angle) * 8, 3 + (index % 3), math.sin(angle) * 8),
                1.4,
                WITCHLIGHT,
                1.2
            )
        end
        reedStand(parent, center + Vector3.new(0, 0, -12), 12, 23)
        return true
    elseif visual == "eel_weirs" then
        fenGround(parent, center)
        fenWater(parent, center, 44, false)
        for index = -1, 1 do
            part(
                parent,
                "WeirGate",
                Vector3.new(14, 4, 0.8),
                CFrame.new(center + Vector3.new(0, 2, index * 12)),
                DARK_PLANK,
                Enum.Material.Wood
            )
        end
        boardwalk(parent, center + Vector3.new(9, 0, 0), 34, false)
        return true
    elseif visual == "herb_shallows" then
        fenGround(parent, center)
        fenWater(parent, center, 38, true)
        for index = 0, 7 do
            local angle = index * math.pi * 0.25
            part(
                parent,
                "BlackwaterHerb",
                Vector3.new(1.6, 0.4, 1.6),
                CFrame.new(center + Vector3.new(math.cos(angle) * 9, 1, math.sin(angle) * 9)),
                Color3.fromRGB(44, 62, 44),
                Enum.Material.Grass,
                false
            )
        end
        reedMat(parent, center + Vector3.new(0, 0, 10), 9)
        return true
    elseif visual == "glass_flats" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        for index = -2, 2 do
            glassSheet(
                parent,
                center + Vector3.new(index * 7, 0, index % 2 * 6 - 3),
                7 + index,
                math.rad(index * 22)
            )
        end
        return true
    elseif visual == "drowned_orchard" then
        fenGround(parent, center)
        fenWater(parent, center, 42, true)
        for index = -1, 1 do
            for run = -1, 1 do
                part(
                    parent,
                    "DrownedTree",
                    Vector3.new(1.4, 12, 1.4),
                    CFrame.new(center + Vector3.new(index * 9, 5.5, run * 9))
                        * CFrame.Angles(math.rad(index * 4), 0, math.rad(run * 5)),
                    DARK_PLANK,
                    Enum.Material.Wood
                )
            end
        end
        return true
    elseif visual == "reed_mat_crossing" then
        fenGround(parent, center)
        fenWater(parent, center, 46, false)
        for index = -2, 2 do
            reedMat(parent, center + Vector3.new(index * 8, 0, index % 2 * 5), 8)
        end
        return true
    elseif visual == "stepping_stones" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        for index = -3, 3 do
            part(
                parent,
                "SteppingStone",
                Vector3.new(3.4, 1.6, 3.4),
                CFrame.new(center + Vector3.new(index * 5.5, 1.1, (index % 2) * 4 - 2))
                    * CFrame.Angles(0, math.rad(index * 14), 0),
                Color3.fromRGB(76, 78, 74),
                Enum.Material.Slate
            )
        end
        return true
    elseif visual == "mirror_ford" then
        fenGround(parent, center)
        fenWater(parent, center, 50, true)
        -- The ford's trick: a line of glass that shows a crossing which
        -- is one step to the left of the real one.
        for index = -2, 2 do
            glassSheet(parent, center + Vector3.new(index * 6, 0, 4), 6, math.rad(90))
        end
        for index = -2, 2 do
            part(
                parent,
                "FordStone",
                Vector3.new(3, 1.4, 3),
                CFrame.new(center + Vector3.new(index * 6 - 3, 1, -4)),
                Color3.fromRGB(76, 78, 74),
                Enum.Material.Slate
            )
        end
        return true
    elseif visual == "sunken_boardwalk" then
        fenGround(parent, center)
        fenWater(parent, center, 44, false)
        boardwalk(parent, center, 44, false)
        boardwalk(parent, center + Vector3.new(11, -1.2, 4), 30, true)
        return true
    elseif visual == "leaning_house_row" then
        fenGround(parent, center)
        fenWater(parent, center, 44, true)
        stiltHouse(parent, center + Vector3.new(-11, 0, -6), 7)
        stiltHouse(parent, center + Vector3.new(2, 0, 4), -5)
        stiltHouse(parent, center + Vector3.new(13, 0, -8), 11)
        boardwalk(parent, center + Vector3.new(0, 0, 12), 34, false)
        return true
    elseif visual == "fog_bank" then
        fenGround(parent, center)
        fenWater(parent, center, 46, false)
        for index = -1, 1 do
            local fog = part(
                parent,
                "FogBank",
                Vector3.new(30, 9, 14),
                CFrame.new(center + Vector3.new(index * 6, 5, index * 9)),
                Color3.fromRGB(196, 206, 202),
                Enum.Material.Neon,
                false
            )
            fog.Transparency = 0.88
            fog.CanQuery = false
        end
        reedStand(parent, center + Vector3.new(-12, 0, 8), 10, 31)
        return true
    elseif visual == "lurker_shallows" then
        fenGround(parent, center)
        fenWater(parent, center, 46, false)
        reedStand(parent, center + Vector3.new(-8, 0, -6), 16, 3)
        reedStand(parent, center + Vector3.new(9, 0, 7), 16, 19)
        reedMat(parent, center + Vector3.new(0, 0, 0), 10)
        return true
    elseif visual == "mirror_court" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        -- Three mirrors around a floor, which is the Many-Face's fight.
        for index = 0, 2 do
            local angle = index * math.pi * (2 / 3)
            glassSheet(
                parent,
                center + Vector3.new(math.cos(angle) * 12, 0, math.sin(angle) * 12),
                9,
                angle + math.pi * 0.5
            )
            witchLantern(parent, center + Vector3.new(math.cos(angle) * 8, 0, math.sin(angle) * 8))
        end
        return true
    elseif visual == "leech_pools" then
        fenGround(parent, center)
        for index = -1, 1 do
            fenWater(parent, center + Vector3.new(index * 12, 0, index % 2 * 8 - 4), 14, false)
        end
        reedStand(parent, center + Vector3.new(0, 0, 12), 10, 43)
        return true
    elseif visual == "heron_reach" then
        fenGround(parent, center)
        fenWater(parent, center, 48, true)
        -- Open water and long sightlines: the heron's exact line needs
        -- somewhere to be drawn.
        boardwalk(parent, center + Vector3.new(-14, 0, 0), 40, false)
        reedStand(parent, center + Vector3.new(14, 0, -8), 8, 7)
        return true
    elseif visual == "bell_marsh" then
        fenGround(parent, center)
        fenWater(parent, center, 46, false)
        -- Four reflected pools around a bell post: the Drowned Caller's
        -- doors, standing where the fight will need them.
        for index = 0, 3 do
            local angle = index * math.pi * 0.5
            fenWater(
                parent,
                center + Vector3.new(math.cos(angle) * 13, 0, math.sin(angle) * 13),
                10,
                true
            )
            witchLantern(parent, center + Vector3.new(math.cos(angle) * 9, 0, math.sin(angle) * 9))
        end
        part(
            parent,
            "BellPost",
            Vector3.new(0.8, 10, 0.8),
            CFrame.new(center + Vector3.new(0, 5, 0)),
            DARK_PLANK,
            Enum.Material.Wood
        )
        return true
    elseif visual == "low_dyke" then
        fenGround(parent, center)
        part(
            parent,
            "Dyke",
            Vector3.new(10, 2.6, 48),
            CFrame.new(center + Vector3.new(0, 1.5, 0)),
            BOG,
            Enum.Material.Ground
        )
        fenWater(parent, center + Vector3.new(-16, 0, 0), 16, false)
        fenWater(parent, center + Vector3.new(16, 0, 0), 16, true)
        return true
    elseif visual == "punt_channel" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        puntBoat(parent, center + Vector3.new(-4, 0, 2), 0, false)
        puntBoat(parent, center + Vector3.new(8, 0, -6), math.rad(24), true)
        boardwalk(parent, center + Vector3.new(-13, 0, 0), 34, false)
        return true
    elseif visual == "willow_gate" then
        fenGround(parent, center)
        fenWater(parent, center + Vector3.new(0, 0, 8), 26, true)
        for side = -1, 1, 2 do
            part(
                parent,
                "WillowTrunk",
                Vector3.new(2.6, 14, 2.6),
                CFrame.new(center + Vector3.new(side * 7, 7, -6))
                    * CFrame.Angles(0, 0, math.rad(side * -8)),
                DARK_PLANK,
                Enum.Material.Wood
            )
            for index = 0, 4 do
                part(
                    parent,
                    "WillowFrond",
                    Vector3.new(0.3, 7, 0.3),
                    CFrame.new(center + Vector3.new(side * (5 + index), 9, -6 + index)),
                    REED,
                    Enum.Material.Grass,
                    false
                )
            end
        end
        return true
    elseif visual == "stilt_junction" then
        fenGround(parent, center)
        fenWater(parent, center, 44, true)
        boardwalk(parent, center, 40, false)
        boardwalk(parent, center + Vector3.new(0, 0, 0), 22, false)
        stiltHouse(parent, center + Vector3.new(-12, 0, 8), 4)
        witchLantern(parent, center + Vector3.new(6, 1.4, 0))
        return true
    elseif visual == "ferryman_shack" then
        fenGround(parent, center)
        fenWater(parent, center + Vector3.new(0, 0, -10), 28, true)
        stiltHouse(parent, center + Vector3.new(0, 0, 4), 3)
        boardwalk(parent, center + Vector3.new(0, 0, -8), 22, false)
        puntBoat(parent, center + Vector3.new(-8, 0, -12), math.rad(-14), false)
        witchLantern(parent, center + Vector3.new(7, 0, -4))
        return true
    elseif visual == "wake_platform" then
        fenGround(parent, center)
        fenWater(parent, center, 40, true)
        part(
            parent,
            "WakePlatform",
            Vector3.new(16, 1, 16),
            CFrame.new(center + Vector3.new(0, 1.6, 0)),
            PLANK,
            Enum.Material.Wood
        )
        for index = 0, 5 do
            local angle = index * math.pi / 3
            witchLantern(
                parent,
                center + Vector3.new(math.cos(angle) * 6.5, 1.6, math.sin(angle) * 6.5)
            )
        end
        return true
    elseif visual == "sunken_chapel" then
        fenGround(parent, center)
        fenWater(parent, center, 44, true)
        -- A chapel the water took to the windows.
        part(
            parent,
            "ChapelWall",
            Vector3.new(16, 9, 0.9),
            CFrame.new(center + Vector3.new(0, 4, -7)),
            Color3.fromRGB(88, 88, 82),
            Enum.Material.Slate
        )
        for side = -1, 1, 2 do
            part(
                parent,
                "ChapelSide",
                Vector3.new(0.9, 9, 14),
                CFrame.new(center + Vector3.new(side * 8, 4, 0)),
                Color3.fromRGB(88, 88, 82),
                Enum.Material.Slate
            )
            glassSheet(parent, center + Vector3.new(side * 7.4, 3.5, -2), 4, math.rad(90))
        end
        witchLantern(parent, center + Vector3.new(0, 1, 4))
        return true
    elseif visual == "reflection_locks" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        -- Three mirrors and three stones: the puzzle is telling which is
        -- which, so both have to be legible from the same standing spot.
        for index = -1, 1 do
            glassSheet(parent, center + Vector3.new(index * 9, 0, -6), 8, math.rad(90))
            part(
                parent,
                "LockStone",
                Vector3.new(3, 2, 3),
                CFrame.new(center + Vector3.new(index * 9, 1.4, 6)),
                Color3.fromRGB(76, 78, 74),
                Enum.Material.Slate
            )
        end
        return true
    elseif visual == "tide_gates" then
        fenGround(parent, center)
        fenWater(parent, center + Vector3.new(0, 0, 12), 26, false)
        fenWater(parent, center + Vector3.new(0, 0, -12), 26, true)
        for side = -1, 1, 2 do
            part(
                parent,
                "TideGate",
                Vector3.new(11, 8, 1.2),
                CFrame.new(center + Vector3.new(side * 7, 4, 0)),
                DARK_PLANK,
                Enum.Material.Wood
            )
            local wheel = part(
                parent,
                "TideWheel",
                Vector3.new(0.8, 3.2, 3.2),
                CFrame.new(center + Vector3.new(side * 7, 9, 0)),
                BOG_IRON,
                Enum.Material.Metal,
                false
            )
            wheel.Shape = Enum.PartType.Cylinder
        end
        return true
    elseif visual == "witch_approach" then
        fenGround(parent, center)
        fenWater(parent, center, 50, true)
        -- Her ring of lights, hanging at head height, with the boardwalk
        -- running into it and stopping.
        for index = 0, 7 do
            local angle = index * math.pi * 0.25
            witchLantern(
                parent,
                center + Vector3.new(math.cos(angle) * 15, 2.5, math.sin(angle) * 15)
            )
        end
        boardwalk(parent, center + Vector3.new(0, 0, 14), 30, true)
        glassSheet(parent, center + Vector3.new(0, 0, -12), 11, 0)
        return true
    end
    return false
end

MireglassBuilder.Primitives = table.freeze({
    fenWater = fenWater,
    reedStand = reedStand,
    boardwalk = boardwalk,
    stiltHouse = stiltHouse,
    glassSheet = glassSheet,
    witchLantern = witchLantern,
    puntBoat = puntBoat,
    reedMat = reedMat,
    bogIronPit = bogIronPit,
    fenGround = fenGround,
})

return table.freeze(MireglassBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="165">
          <Properties>
            <string name="Name">OldGrowthBuilder</string>
            <string name="Source"><![CDATA[--!strict

local OldGrowthBuilder = {}

local function part(
    parent: Model,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?
): Part
    local item = Instance.new("Part")
    item.Name = name
    item.Size = size
    item.CFrame = cframe
    item.Color = color
    item.Material = material
    item.Shape = shape or Enum.PartType.Block
    item.Anchored = true
    item.CanCollide = false
    item.CanTouch = false
    item.CastShadow = true
    item.TopSurface = Enum.SurfaceType.Smooth
    item.BottomSurface = Enum.SurfaceType.Smooth
    item.Parent = parent
    return item
end

function OldGrowthBuilder.build(origin: Vector3, target: Vector3, maxHealth: number): Model
    local model = Instance.new("Model")
    model.Name = "OldGrowthElite"
    model:SetAttribute("EliteId", "elite_old_growth")
    model:SetAttribute("EliteDisplayName", "Old Growth")
    model:SetAttribute("EliteHealth", maxHealth)
    model:SetAttribute("EliteMaxHealth", maxHealth)
    model:SetAttribute("EliteShielded", false)

    local core = part(
        model,
        "AncientTrunk",
        Vector3.new(10, 18, 10),
        CFrame.new(origin + Vector3.new(0, 9, 0)),
        Color3.fromRGB(57, 39, 31),
        Enum.Material.Wood,
        Enum.PartType.Ball
    )
    model.PrimaryPart = core

    part(
        model,
        "BarkCrown",
        Vector3.new(13, 7, 9),
        CFrame.new(origin + Vector3.new(0, 19, 0)),
        Color3.fromRGB(45, 72, 48),
        Enum.Material.Grass,
        Enum.PartType.Ball
    )
    for index = 1, 5 do
        local angle = (index / 5) * math.pi * 2
        part(
            model,
            "CanopyMass",
            Vector3.new(8, 6, 8),
            CFrame.new(
                origin + Vector3.new(math.cos(angle) * 7, 20 + (index % 2) * 3, math.sin(angle) * 7)
            ),
            if index % 2 == 0 then Color3.fromRGB(58, 91, 55) else Color3.fromRGB(38, 68, 48),
            Enum.Material.Grass,
            Enum.PartType.Ball
        )
    end

    for side = -1, 1, 2 do
        part(
            model,
            "CathedralArm",
            Vector3.new(3, 15, 3),
            CFrame.new(origin + Vector3.new(side * 7, 11, 0))
                * CFrame.Angles(0, 0, math.rad(side * 35)),
            Color3.fromRGB(70, 48, 34),
            Enum.Material.Wood,
            nil
        )
        part(
            model,
            "RootFoot",
            Vector3.new(3.2, 3.2, 13),
            CFrame.new(origin + Vector3.new(side * 4.5, 1.4, 3))
                * CFrame.Angles(0, math.rad(side * 18), 0),
            Color3.fromRGB(68, 45, 32),
            Enum.Material.Wood,
            nil
        )
        part(
            model,
            "OldEye",
            Vector3.new(0.9, 0.9, 0.45),
            CFrame.new(origin + Vector3.new(side * 1.7, 11.5, -5)),
            Color3.fromRGB(112, 214, 174),
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
    end

    local heart = part(
        model,
        "AmberHeart",
        Vector3.new(3.8, 5.4, 1.5),
        CFrame.new(origin + Vector3.new(0, 7.5, -5.15)),
        Color3.fromRGB(255, 187, 76),
        Enum.Material.Neon,
        Enum.PartType.Ball
    )
    heart:SetAttribute("WeakPoint", true)
    -- The heart is the strike target and sits in the authored mesh's hollow
    -- chest by design. Without this flag the enemy-visual pass blanks it and
    -- clears its CanQuery when the mesh loads, which makes the encounter
    -- uncompletable: the line-of-sight ray can never hit a query-off part.
    heart:SetAttribute("KeepVisibleOnReplacement", true)

    local highlight = Instance.new("Highlight")
    highlight.Name = "EliteOutline"
    highlight.FillColor = Color3.fromRGB(55, 83, 57)
    highlight.FillTransparency = 0.82
    highlight.OutlineColor = Color3.fromRGB(255, 187, 76)
    highlight.OutlineTransparency = 0.12
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = model

    local flatTarget = Vector3.new(target.X, core.Position.Y, target.Z)
    if (flatTarget - core.Position).Magnitude > 0.01 then
        model:PivotTo(CFrame.lookAt(core.Position, flatTarget))
    end
    return model
end

function OldGrowthBuilder.setState(model: Model, health: number, shielded: boolean, marked: boolean)
    model:SetAttribute("EliteHealth", math.max(0, health))
    model:SetAttribute("EliteShielded", shielded)
    model:SetAttribute("LastLightMarked", marked)
    local heart = model:FindFirstChild("AmberHeart")
    if heart ~= nil and heart:IsA("BasePart") then
        heart.Color = if shielded
            then Color3.fromRGB(92, 118, 91)
            elseif marked then Color3.fromRGB(255, 222, 112)
            else Color3.fromRGB(255, 187, 76)
        heart.Material = if shielded then Enum.Material.SmoothPlastic else Enum.Material.Neon
        heart.Transparency = if shielded then 0.34 else 0
    end
    local highlight = model:FindFirstChild("EliteOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        highlight.OutlineColor = if shielded
            then Color3.fromRGB(112, 155, 119)
            elseif marked then Color3.fromRGB(255, 222, 112)
            else Color3.fromRGB(255, 187, 76)
        highlight.FillTransparency = if marked then 0.62 else 0.82
    end
    if model:GetAttribute("EnemyVisualReady") == true then
        local authored = model:FindFirstChild("AuthoredEnemyVisual")
        for _, descendant in model:GetDescendants() do
            if
                descendant:IsA("BasePart")
                and (authored == nil or not descendant:IsDescendantOf(authored))
            then
                descendant.Transparency = 1
                descendant.CastShadow = false
            end
        end
    end
end

return table.freeze(OldGrowthBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="166">
          <Properties>
            <string name="Name">RegionBuilders</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Which builder draws which region, and what a region still owes before
    it can be walked.

    Bramblewake's builder does everything: module visuals, points of
    interest, event sockets, resource nodes, the elite arena, the boss
    annex, the Blackout layer, mesh dressing, wayfinding. The Delve's and
    the Fen's builders currently do one of those things -- module visuals
    -- and pretending otherwise is how a region ships as an empty grid
    with a name.

    So this registry records both halves: the builder, and the honest
    list of what that region has yet to grow. `readiness` is the answer
    to "could a party walk this today", and nothing but a builder gaining
    the missing pieces should ever change it.
]]

local BramblewakeBuilder = require(script.Parent.BramblewakeBuilder)
local IronrootBuilder = require(script.Parent.IronrootBuilder)
local MireglassBuilder = require(script.Parent.MireglassBuilder)
local CinderfallBuilder = require(script.Parent.CinderfallBuilder)
local FrostmereBuilder = require(script.Parent.FrostmereBuilder)
local TempestBuilder = require(script.Parent.TempestBuilder)

local RegionBuilders = {}

export type Readiness = {
    regionId: string,
    walkable: boolean,
    -- What the region still owes, in the order it will be built.
    missing: { string },
}

local ENTRIES: { [string]: any } = {
    region_bramblewake = {
        builder = BramblewakeBuilder,
        walkable = true,
        missing = {},
    },
    region_ironroot = {
        builder = IronrootBuilder,
        walkable = false,
        -- Mesh dressing is an art pass: authored assets, not wiring.
        -- Everything a party needs to walk the region is built.
        missing = {
            "authored mesh dressing",
        },
    },
    region_tempest = {
        builder = TempestBuilder,
        walkable = false,
        missing = {
            "authored mesh dressing",
        },
    },
    region_cinderfall = {
        builder = CinderfallBuilder,
        walkable = false,
        -- Mesh dressing is an art pass: authored assets, not wiring.
        -- Everything a party needs to walk the region is built.
        missing = {
            "authored mesh dressing",
        },
    },
    region_frostmere = {
        builder = FrostmereBuilder,
        walkable = false,
        -- Mesh dressing is an art pass: authored assets, not wiring.
        -- Everything a party needs to walk the region is built.
        missing = {
            "authored mesh dressing",
        },
    },
    region_mireglass = {
        builder = MireglassBuilder,
        walkable = false,
        -- Mesh dressing is an art pass: authored assets, not wiring.
        -- Everything a party needs to walk the region is built.
        missing = {
            "authored mesh dressing",
        },
    },
}

function RegionBuilders.get(regionId: any): any
    return if type(regionId) == "string" then (ENTRIES[regionId] or {}).builder else nil
end

function RegionBuilders.readiness(regionId: any): Readiness
    local entry = if type(regionId) == "string" then ENTRIES[regionId] else nil
    if entry == nil then
        return { regionId = tostring(regionId), walkable = false, missing = { "unknown region" } }
    end
    return {
        regionId = regionId :: string,
        walkable = entry.walkable == true,
        missing = table.clone(entry.missing),
    }
end

function RegionBuilders.ids(): { string }
    local ids: { string } = {}
    for regionId in ENTRIES do
        table.insert(ids, regionId)
    end
    table.sort(ids)
    return ids
end

--[[
    Draw one region's modules from a manifest.

    This is the shared half of expedition assembly: a model per placement,
    the attributes the world and its tests read, the streaming cell, and
    the region's own visual for the module. It is deliberately not the
    whole of Bramblewake's builder -- that one also plants POIs, events,
    nodes and arenas, and each of those is its own wave for a new region.

    Returns the module models it made, so a caller can keep building on
    top of them, and the count of visuals the region's builder actually
    knew how to draw.
]]
function RegionBuilders.buildModules(
    parent: Instance,
    manifest: any,
    generator: any,
    catalog: any,
    origin: Vector3
): (number, number)
    local builder = RegionBuilders.get(manifest.regionId)
    assert(builder ~= nil, "no builder for region " .. tostring(manifest.regionId))
    assert(
        type(builder.buildModuleVisual) == "function",
        tostring(manifest.regionId) .. " has no module visual builder"
    )

    local drawn = 0
    for _, placement in manifest.modules do
        local definition = generator.moduleDefinition(placement.moduleId)
        local center = origin
            + Vector3.new(placement.cellX * catalog.CellSize, 0, placement.cellZ * catalog.CellSize)
        local module = Instance.new("Model")
        module.Name = string.format("Module_%02d", placement.index)
        module:SetAttribute("ContentId", placement.moduleId)
        module:SetAttribute("DisplayName", definition.displayName)
        module:SetAttribute("SequenceIndex", placement.index)
        module:SetAttribute("CellX", placement.cellX)
        module:SetAttribute("CellZ", placement.cellZ)
        module.Parent = parent
        if builder.buildModuleVisual(module, definition.visual, center) then
            drawn += 1
        end
    end
    return #manifest.modules, drawn
end

--[[
    Resource nodes for a region that has none yet.

    Bramblewake grows its own inside its builder, tangled with mesh
    dressing and ambient light tags. A new region needs the same contract
    -- an anchor part, an interaction id, the material it pays, the words
    the prompt says -- without inheriting the forest's dressing, so this
    plants them from the region's own material list and hands the
    descriptors back for the caller to register as prompts.

    Two per module from the second module on, which is the cadence
    Bramblewake settled on: the arrival module stays clean so a party's
    first look at a region is the region and not a shopping list.
]]
function RegionBuilders.buildResourceNodes(
    modules: { Instance },
    manifest: any,
    catalog: any,
    origin: Vector3,
    materials: { { id: string, label: string, color: Color3 } },
    prefix: string
): { any }
    local descriptors = {}
    for index, placement in manifest.modules do
        if index >= 2 and modules[index] ~= nil then
            local center = origin
                + Vector3.new(
                    placement.cellX * catalog.CellSize,
                    0,
                    placement.cellZ * catalog.CellSize
                )
            for slot = 1, 2 do
                local material = materials[((index + slot) % #materials) + 1]
                local side = if slot == 1 then -1 else 1
                local at = center + Vector3.new(side * (15 + (index % 3) * 2), 0, (slot - 1.5) * 18)
                local anchor = Instance.new("Part")
                anchor.Name = material.label .. "Node"
                anchor.Size = Vector3.new(5, 7, 5)
                anchor.CFrame = CFrame.new(at + Vector3.new(0, 3.5, 0))
                anchor.Anchored = true
                anchor.CanCollide = false
                anchor.CanTouch = false
                anchor.Transparency = 1
                anchor.Parent = modules[index]

                -- Small and quiet, for the reason Bramblewake learned the
                -- hard way: a resource cue should be findable when looked
                -- for, never the loudest thing on the screen.
                local cue = Instance.new("Part")
                cue.Name = "ResourceGlow"
                cue.Shape = Enum.PartType.Ball
                cue.Size = Vector3.new(0.7, 0.7, 0.7)
                cue.CFrame = CFrame.new(at + Vector3.new(0, 3.2, 0))
                cue.Color = material.color
                cue.Material = Enum.Material.Neon
                cue.Anchored = true
                cue.CanCollide = false
                cue.CanQuery = false
                cue.CastShadow = false
                cue.Transparency = 0.8
                cue.Parent = modules[index]

                table.insert(descriptors, {
                    target = anchor,
                    interactionId = string.format("node_%s_%d_%d", prefix, index, slot),
                    materialId = material.id,
                    objectText = material.label,
                })
            end
        end
    end
    return descriptors
end

--[[
    The materials each region pays out of its own ground, in the order
    its nodes cycle them. Kept beside the builders because it is a fact
    about the region's world, not about its economy: what a node is made
    of is what the player sees before they harvest it.
]]
RegionBuilders.NodeMaterials = table.freeze({
    region_ironroot = table.freeze({
        table.freeze({
            id = "material_ironroot_ore",
            label = "Ironroot Ore",
            color = Color3.fromRGB(196, 142, 58),
        }),
        table.freeze({
            id = "material_coalglass",
            label = "Coalglass",
            color = Color3.fromRGB(255, 168, 66),
        }),
        table.freeze({
            id = "material_glow_fungus",
            label = "Glow Fungus",
            color = Color3.fromRGB(150, 226, 176),
        }),
    }),
    region_cinderfall = table.freeze({
        table.freeze({
            id = "material_cindersteel",
            label = "Cindersteel",
            color = Color3.fromRGB(112, 104, 96),
        }),
        table.freeze({
            id = "material_memory_glass",
            label = "Memory Glass",
            color = Color3.fromRGB(206, 168, 214),
        }),
        table.freeze({
            id = "material_ash_silk",
            label = "Ash Silk",
            color = Color3.fromRGB(214, 190, 158),
        }),
        table.freeze({
            id = "material_crown_coal",
            label = "Crown Coal",
            color = Color3.fromRGB(52, 48, 46),
        }),
    }),
    region_frostmere = table.freeze({
        table.freeze({
            id = "material_frostmere_ice",
            label = "Frostmere Ice",
            color = Color3.fromRGB(168, 202, 216),
        }),
        table.freeze({
            id = "material_ember_moss",
            label = "Ember Moss",
            color = Color3.fromRGB(238, 128, 54),
        }),
        table.freeze({
            id = "material_frostmere_wool",
            label = "Frostmere Wool",
            color = Color3.fromRGB(214, 206, 188),
        }),
        table.freeze({
            id = "material_aurora_salt",
            label = "Aurora Salt",
            color = Color3.fromRGB(126, 236, 198),
        }),
    }),
    region_tempest = table.freeze({
        table.freeze({
            id = "material_storm_glass",
            label = "Storm Glass",
            color = Color3.fromRGB(238, 178, 96),
        }),
        table.freeze({
            id = "material_salt_kelp",
            label = "Salt Kelp",
            color = Color3.fromRGB(66, 88, 62),
        }),
        table.freeze({
            id = "material_ships_iron",
            label = "Ship's Iron",
            color = Color3.fromRGB(92, 96, 100),
        }),
    }),
    region_mireglass = table.freeze({
        table.freeze({
            id = "material_mirror_reed",
            label = "Mirror Reed",
            color = Color3.fromRGB(186, 206, 210),
        }),
        table.freeze({
            id = "material_bog_iron",
            label = "Bog Iron",
            color = Color3.fromRGB(146, 118, 92),
        }),
        table.freeze({
            id = "material_witchlight_pollen",
            label = "Witchlight Pollen",
            color = Color3.fromRGB(146, 214, 226),
        }),
    }),
})

local CollectionService = game:GetService("CollectionService")

--[[
    Points of interest and event sockets for a region that has neither.

    Both are anchors with words on them: a POI says what a place is, an
    event socket says what is about to be asked of you and how far along
    it is. Bramblewake dresses them heavily -- cairns, icons, billboards
    tuned over several waves. A new region gets the anchor, the
    attributes, and the tag, which is everything the runtime and the
    tests read; its own dressing is an art pass, not a wiring one, and
    saying so is better than faking it.
]]
local function labelled(parent: Instance, text: string, color: Color3)
    local gui = Instance.new("BillboardGui")
    gui.Name = "Label"
    gui.Size = UDim2.fromOffset(220, 40)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
    gui.AlwaysOnTop = false
    gui.MaxDistance = 140
    gui.Parent = parent
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.Text = string.upper(text)
    label.TextColor3 = color
    label.TextScaled = true
    label.TextStrokeTransparency = 0.4
    label.Parent = gui
end

function RegionBuilders.buildPointsOfInterest(
    modules: { Instance },
    manifest: any,
    generator: any,
    catalog: any,
    origin: Vector3,
    color: Color3
): number
    local placed = 0
    for index, placement in manifest.modules do
        if placement.poiId ~= nil and modules[index] ~= nil then
            local definition = generator.pointOfInterestDefinition(placement.poiId)
            local center = origin
                + Vector3.new(
                    placement.cellX * catalog.CellSize,
                    0,
                    placement.cellZ * catalog.CellSize
                )
            local anchor = Instance.new("Part")
            anchor.Name = "PointOfInterest"
            anchor.Size = Vector3.new(8, 1, 8)
            anchor.CFrame = CFrame.new(center + Vector3.new(-21, 0.5, 18))
            anchor.Anchored = true
            anchor.CanCollide = false
            anchor.CanTouch = false
            anchor.Transparency = 1
            anchor.CastShadow = false
            anchor:SetAttribute("ContentId", definition.id)
            anchor:SetAttribute("DisplayName", definition.displayName)
            anchor:SetAttribute("Detail", definition.detail)
            anchor.Parent = modules[index]
            labelled(anchor, definition.displayName, color)
            placed += 1
        end
    end
    return placed
end

function RegionBuilders.buildEventSockets(
    modules: { Instance },
    manifest: any,
    generator: any,
    catalog: any,
    origin: Vector3,
    runtimeIds: any,
    color: Color3
): { any }
    local sockets = {}
    for index, placement in manifest.modules do
        if placement.eventId ~= nil and modules[index] ~= nil then
            local definition = generator.eventDefinition(placement.eventId)
            local center = origin
                + Vector3.new(
                    placement.cellX * catalog.CellSize,
                    0,
                    placement.cellZ * catalog.CellSize
                )
            local anchor = Instance.new("Part")
            anchor.Name = "EventSocket"
            anchor.Size = Vector3.new(7, 1, 7)
            anchor.CFrame = CFrame.new(center + Vector3.new(22, 0.5, -19))
            anchor.Anchored = true
            anchor.CanCollide = false
            anchor.CanTouch = false
            anchor.Transparency = 1
            anchor.CastShadow = false
            anchor:SetAttribute("ContentId", definition.id)
            anchor:SetAttribute("DisplayName", definition.displayName)
            anchor:SetAttribute("Dormant", true)
            anchor:SetAttribute("Status", "dormant")
            anchor:SetAttribute("Progress", 0)
            anchor:SetAttribute("ProgressTotal", #definition.steps)
            anchor.Parent = modules[index]
            CollectionService:AddTag(anchor, runtimeIds.ExpeditionEventTag)
            labelled(anchor, definition.displayName, color)

            --[[
                One anchor per step, at the offsets the event's own
                definition names. The steps are the event: "turn the three
                latches" is three places a player has to stand, and an
                event whose steps have nowhere to happen is a prompt that
                never appears.
            ]]
            local steps = {}
            for _, step in definition.steps do
                local offset = step.offset or { x = 0, y = 1, z = 0 }
                local stepAnchor = Instance.new("Part")
                stepAnchor.Name = "EventStep"
                stepAnchor.Size = Vector3.new(3, 4, 3)
                stepAnchor.CFrame = CFrame.new(
                    anchor.Position
                        + Vector3.new(
                            tonumber(offset.x) or 0,
                            tonumber(offset.y) or 1,
                            tonumber(offset.z) or 0
                        )
                )
                stepAnchor.Anchored = true
                stepAnchor.CanCollide = false
                stepAnchor.CanTouch = false
                stepAnchor.Transparency = 1
                stepAnchor:SetAttribute("StepId", step.id)
                stepAnchor.Parent = anchor
                table.insert(steps, {
                    target = stepAnchor,
                    stepId = step.id,
                    actionText = step.actionText,
                    objectText = step.objectText,
                })
            end

            table.insert(sockets, {
                target = anchor,
                eventId = definition.id,
                steps = steps,
            })
        end
    end
    return sockets
end

--[[
    An arena for an elite or a boss.

    Every encounter this project has shipped needs the same four things
    from the world: a floor a fight can happen on, a place the creature
    stands, a set of anchors for whatever the fight asks the player to
    interact with (root nodes, levers, mirrors, pools, vent wheels), and
    an edge so the arena reads as a room rather than a clearing.

    The encounter modules already name their own interaction ids --
    ForemanEcho.LeverIds, IronWidow.AnchorIds, BellowsMaw.LineIds and so
    on -- so the arena takes that list rather than inventing its own. If
    an encounter grows a fifth lever, its arena grows a fifth anchor with
    no change here, which is the only way these two stay in agreement.
]]
function RegionBuilders.buildArena(
    parent: Instance,
    center: Vector3,
    options: {
        name: string,
        radius: number,
        floorColor: Color3,
        edgeColor: Color3,
        anchorIds: { string },
        anchorColor: Color3,
    }
): { [string]: BasePart }
    local arena = Instance.new("Model")
    arena.Name = options.name
    arena.Parent = parent

    local floor = Instance.new("Part")
    floor.Name = "ArenaFloor"
    floor.Shape = Enum.PartType.Cylinder
    -- A cylinder's axis is its Size.X, so the disc lies flat only when
    -- the thickness is on X and the rotation stands it up.
    floor.Size = Vector3.new(1.2, options.radius * 2, options.radius * 2)
    floor.CFrame = CFrame.new(center + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90))
    floor.Color = options.floorColor
    floor.Material = Enum.Material.Slate
    floor.Anchored = true
    floor.CanCollide = false
    floor.CanQuery = false
    floor.Parent = arena

    local edges = 12
    for index = 0, edges - 1 do
        local angle = index * (math.pi * 2 / edges)
        local post = Instance.new("Part")
        post.Name = "ArenaEdge"
        post.Size = Vector3.new(2.2, 5.5, 2.2)
        post.CFrame = CFrame.new(
            center
                + Vector3.new(
                    math.cos(angle) * options.radius,
                    2.7,
                    math.sin(angle) * options.radius
                )
        ) * CFrame.Angles(0, angle, math.rad((index % 3) - 1))
        post.Color = options.edgeColor
        post.Material = Enum.Material.Rock
        post.Anchored = true
        post.Parent = arena
    end

    --[[
        One anchor per interaction the encounter names, evenly spaced
        inside the ring so no two are ever in the same place and every one
        is reachable from the middle.
    ]]
    local anchors: { [string]: BasePart } = {}
    local count = #options.anchorIds
    for index, anchorId in options.anchorIds do
        local angle = (index - 1) * (math.pi * 2 / math.max(1, count))
        local anchor = Instance.new("Part")
        anchor.Name = "ArenaAnchor"
        anchor.Size = Vector3.new(3.4, 5, 3.4)
        anchor.CFrame = CFrame.new(
            center
                + Vector3.new(
                    math.cos(angle) * (options.radius * 0.62),
                    2.5,
                    math.sin(angle) * (options.radius * 0.62)
                )
        )
        anchor.Color = options.anchorColor
        anchor.Material = Enum.Material.Neon
        anchor.Anchored = true
        anchor.CanCollide = false
        anchor.Transparency = 0.35
        anchor:SetAttribute("AnchorId", anchorId)
        anchor.Parent = arena
        anchors[anchorId] = anchor
    end
    return anchors
end

--[[
    The arena each new encounter needs, named next to the encounter that
    needs it so the two are read together. Radii come from the fights:
    the Widow's web has to be walked between cuts, so hers is widest; the
    Echo's three levers want a room rather than a field.
]]
RegionBuilders.Arenas = table.freeze({
    elite_foreman_echo = table.freeze({
        name = "ForemanEchoArena",
        regionId = "region_ironroot",
        radius = 26,
    }),
    elite_iron_widow = table.freeze({
        name = "IronWidowArena",
        regionId = "region_ironroot",
        radius = 34,
    }),
    boss_bellows_maw = table.freeze({
        name = "BellowsMawChamber",
        regionId = "region_ironroot",
        radius = 38,
    }),
    elite_lighthouse_eater = table.freeze({
        name = "LighthouseEaterPoint",
        regionId = "region_tempest",
        radius = 30,
    }),
    elite_admiral_wreck = table.freeze({
        name = "AdmiralWreckBerth",
        regionId = "region_tempest",
        radius = 33,
    }),
    boss_tidebound_titan = table.freeze({
        name = "TideboundTitanChannel",
        regionId = "region_tempest",
        radius = 40,
    }),
    elite_lead_actor = table.freeze({
        name = "LeadActorStage",
        regionId = "region_cinderfall",
        radius = 28,
    }),
    elite_glass_bailiff = table.freeze({
        name = "GlassBailiffCourt",
        regionId = "region_cinderfall",
        radius = 32,
    }),
    boss_ash_regent = table.freeze({
        name = "AshRegentBox",
        regionId = "region_cinderfall",
        radius = 38,
    }),
    elite_abbey_silence = table.freeze({
        name = "AbbeySilenceCloister",
        regionId = "region_frostmere",
        radius = 27,
    }),
    elite_aurora_hart = table.freeze({
        name = "AuroraHartClearing",
        regionId = "region_frostmere",
        radius = 31,
    }),
    boss_white_howler = table.freeze({
        name = "WhiteHowlerBowl",
        regionId = "region_frostmere",
        radius = 37,
    }),
    elite_many_face = table.freeze({
        name = "ManyFaceCourt",
        regionId = "region_mireglass",
