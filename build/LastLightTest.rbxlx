        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Registry</string>
            <string name="Source"><![CDATA[--!strict

local Registry = {}
Registry.__index = Registry

export type Definition = {
    id: string,
    kind: string,
    version: number,
    enabled: boolean,
    displayNameKey: string,
    analyticsKey: string,
    assetBundle: string,
    featureFlag: string?,
    tags: { string },
    dependencies: { string },
}

export type Issue = {
    id: string?,
    field: string,
    message: string,
}

export type Registry = typeof(setmetatable(
    {} :: {
        _byId: { [string]: Definition },
        _ids: { string },
    },
    Registry
))

local allowedFields: { [string]: boolean } = {
    id = true,
    kind = true,
    version = true,
    enabled = true,
    displayNameKey = true,
    analyticsKey = true,
    assetBundle = true,
    featureFlag = true,
    tags = true,
    dependencies = true,
}

local function addIssue(issues: { Issue }, id: string?, field: string, message: string)
    table.insert(issues, {
        id = id,
        field = field,
        message = message,
    })
end

local function validateStringArray(issues: { Issue }, id: string?, field: string, value: any)
    if type(value) ~= "table" then
        addIssue(issues, id, field, "must be an array")
        return
    end

    local seen: { [string]: boolean } = {}
    for index, item in value do
        if type(index) ~= "number" or type(item) ~= "string" or item == "" then
            addIssue(issues, id, field, "must contain only non-empty strings")
            return
        end

        if seen[item] then
            addIssue(issues, id, field, string.format("contains duplicate value %q", item))
            return
        end
        seen[item] = true
    end
end

local function validateDefinition(issues: { Issue }, definition: any)
    if type(definition) ~= "table" then
        addIssue(issues, nil, "definition", "must be a table")
        return
    end

    local id = if type(definition.id) == "string" then definition.id else nil
    for field in definition do
        if not allowedFields[field] then
            addIssue(issues, id, field, "is not allowed by content schema version 1")
        end
    end

    for _, field in { "id", "kind", "displayNameKey", "analyticsKey", "assetBundle" } do
        if type(definition[field]) ~= "string" or definition[field] == "" then
            addIssue(issues, id, field, "must be a non-empty string")
        end
    end

    if type(definition.id) == "string" and type(definition.kind) == "string" then
        local expectedPrefix = definition.kind .. "_"
        if string.sub(definition.id, 1, #expectedPrefix) ~= expectedPrefix then
            addIssue(issues, id, "id", string.format("must use the %s prefix", expectedPrefix))
        end
        if
            string.match(definition.id, "^[a-z][a-z0-9_]*$") == nil
            or string.find(definition.id, "__", 1, true) ~= nil
            or string.sub(definition.id, -1) == "_"
        then
            addIssue(issues, id, "id", "must be lowercase snake case")
        end
    end

    if
        type(definition.version) ~= "number"
        or definition.version < 1
        or definition.version % 1 ~= 0
    then
        addIssue(issues, id, "version", "must be a positive integer")
    end

    if type(definition.enabled) ~= "boolean" then
        addIssue(issues, id, "enabled", "must be a boolean")
    end

    if
        definition.featureFlag ~= nil
        and (type(definition.featureFlag) ~= "string" or definition.featureFlag == "")
    then
        addIssue(issues, id, "featureFlag", "must be nil or a non-empty string")
    end

    validateStringArray(issues, id, "tags", definition.tags)
    validateStringArray(issues, id, "dependencies", definition.dependencies)
end

function Registry.validate(definitions: { any }): (boolean, { Issue })
    local issues: { Issue } = {}
    local ids: { [string]: boolean } = {}

    for _, definition in definitions do
        validateDefinition(issues, definition)
        if type(definition) == "table" and type(definition.id) == "string" then
            if ids[definition.id] then
                addIssue(issues, definition.id, "id", "is duplicated")
            end
            ids[definition.id] = true
        end
    end

    for _, definition in definitions do
        if type(definition) == "table" and type(definition.dependencies) == "table" then
            for _, dependency in definition.dependencies do
                if type(dependency) == "string" and not ids[dependency] then
                    addIssue(
                        issues,
                        definition.id,
                        "dependencies",
                        "references missing " .. dependency
                    )
                end
            end
        end
    end

    return #issues == 0, issues
end

function Registry.new(definitions: { Definition }): Registry
    local valid, issues = Registry.validate(definitions)
    if not valid then
        local first = issues[1]
        error(
            string.format(
                "invalid content registry at %s.%s: %s",
                first.id or "<unknown>",
                first.field,
                first.message
            )
        )
    end

    local byId: { [string]: Definition } = {}
    local ids: { string } = {}
    for _, definition in definitions do
        local immutable = table.clone(definition)
        immutable.tags = table.freeze(table.clone(definition.tags))
        immutable.dependencies = table.freeze(table.clone(definition.dependencies))
        byId[definition.id] = table.freeze(immutable)
        table.insert(ids, definition.id)
    end
    table.sort(ids)

    return setmetatable({
        _byId = byId,
        _ids = ids,
    }, Registry)
end

function Registry.get(self: Registry, id: string): Definition?
    return self._byId[id]
end

function Registry.has(self: Registry, id: string): boolean
    return self._byId[id] ~= nil
end

function Registry.count(self: Registry): number
    return #self._ids
end

function Registry.ids(self: Registry): { string }
    return table.clone(self._ids)
end

function Registry.byKind(self: Registry, kind: string): { Definition }
    local matches: { Definition } = {}
    for _, id in self._ids do
        local definition = self._byId[id]
        if definition.kind == kind then
            table.insert(matches, definition)
        end
    end

    return matches
end

return table.freeze(Registry)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">CosmeticCatalog</string>
          <string name="Source"><![CDATA[--!strict

--[[
    What a cosmetic is, and the hard rule about what it is not.

    **A cosmetic is presentation and nothing else.** No cosmetic appears in a
    stat, a gate, a capacity, a recipe, a drop table, a spawn rule or a reward.
    That is the same shape `TownDecorations` already has -- "identity only, no
    slot changes a stat" -- and it is what makes the *absence* of ownership
    branches in gameplay possible rather than merely required. There is nothing
    here for a gameplay branch to read, so the branch cannot be written by
    accident. `CosmeticNeutrality.spec` enforces it by walking every entry and
    refusing a number that is not a colour, a size, an offset, a rotation or an
    effect intensity.

    **A plan is a list of shapes, not a case in a renderer.** This is the
    #299 lesson applied before it can bite: the equip panel shipped as a
    hardcoded list of eight items and left ninety craftable items unwearable
    with every spec green, because a catalog entry and a thing a player can
    reach are different facts. A store is the same shape with more expensive
    consequences. So a cosmetic describes itself the way `GearVisualPlan` does
    -- parts with a target, a shape, a size, a colour and a material -- and a
    generic builder draws it. There is no per-cosmetic case to be missing,
    which means there is no per-cosmetic case that can be forgotten.

    **The Roblox product IDs are not here.** They do not exist until somebody
    creates the products in the Creator Dashboard and copies the numbers back;
    `Config.CommerceProductIds` is the table they land in and it is empty on
    purpose. A product in this catalog with no dashboard ID is a product that
    cannot be bought, which is the correct state for all of them right now.

    Five entries, one per slot, is the spine rather than the shop. The initial
    direct catalog is its own wave; what this file has to prove today is that
    the shape works end to end -- entry, plan, product, grant -- and that every
    part of that chain is reachable from the next.
]]

export type PartPlan = {
    name: string,
    target: string,
    shape: string,
    size: { number },
    offset: { number },
    rotation: { number },
    color: { number },
    material: string,
}

export type Cosmetic = {
    id: string,
    slot: string,
    --[[
        Which line this belongs to.

        A line is one look carried across all five slots, and it is the unit a
        player actually wants: nobody buys a lantern shell, they buy the look
        the lantern shell finishes. Naming the grouping in the data rather than
        in the display names is what lets a spec demand that a line is
        *complete* -- a set product that grants four of five slots is a set with
        a hole in it, and the hole is invisible until somebody wears it.
    ]]
    line: string,
    displayName: string,
    detail: string,
    derived: boolean,
    parts: { PartPlan },
}

export type Product = {
    id: string,
    line: string,
    displayName: string,
    detail: string,
    -- Permanent, always, and stated on the card. A cosmetic that expires is a
    -- cosmetic a player has to be told about twice and reminded about once,
    -- and neither conversation belongs in this game.
    permanence: string,
    grants: { string },
}

local CosmeticCatalog = {}

--[[
    The slots a cosmetic can occupy, and the one rule about them: a slot is a
    place on a character or in the world where a *look* is chosen. None of them
    is an equipment slot -- `Equipment` owns those, they carry stats, and the
    two lists must never overlap or a cosmetic would be wearing a stat.
]]
local SLOTS = table.freeze({
    "outfit",
    "weapon_skin",
    "tool_skin",
    "lantern_shell",
    "banner",
})

--[[
    The four lines, each named for a place the story has been.

    A line is the unit a player wants and the unit a set product sells, and
    every one of them carries all five slots -- which the census asserts, so a
    line with a hole in it fails on the day it is written rather than on the day
    somebody buys the set and finds a slot empty.

    They are named for regions rather than invented brands because this game
    already has six places with their own light, their own material and their
    own weather, and a look that says "I have been to Cinderfall" is worth more
    than a look that says "I bought the orange one".
]]
local LINES = table.freeze({
    table.freeze({
        id = "line_greenward",
        displayName = "THE GREENWARD",
        detail = "Bramblewake amber, oiled canvas, and the first keepers' green.",
    }),
    table.freeze({
        id = "line_ironroot",
        displayName = "THE IRONROOT",
        detail = "Pit leather, riveted iron, and a lamp built to survive a fall.",
    }),
    table.freeze({
        id = "line_mireglass",
        displayName = "THE MIREGLASS",
        detail = "Bog oak, reed binding, and glass the colour of standing water.",
    }),
    table.freeze({
        id = "line_cinderfall",
        displayName = "THE CINDERFALL",
        detail = "Scorched plate, bronze at the joins, and an ember that never went out.",
    }),
})

--[[
    Emotes are not here, and the omission is the honest one.

    The wave plan lists emote packs among the first products, and an emote is a
    motion rather than a shape -- there is no geometry to describe, and the
    only thing this file could offer for one is a glow, which
    VISUAL_QUALITY_STANDARD names directly as not being construction. An emote
    slot arrives with the animation pipeline that makes an emote possible, not
    before it. Shipping a lit sphere and calling it a salute would be the
    catalog claiming something it does not have.
]]

local function part(
    name: string,
    target: string,
    shape: string,
    size: { number },
    offset: { number },
    rotation: { number },
    color: { number },
    material: string
): PartPlan
    return table.freeze({
        name = name,
        target = target,
        shape = shape,
        size = table.freeze(size),
        offset = table.freeze(offset),
        rotation = table.freeze(rotation),
        color = table.freeze(color),
        material = material,
    })
end

--[[
    The spine's five. Each is a labelled floor in the #292 sense: real geometry
    a player can actually see, marked `derived` so nothing here claims to be an
    art pass. Replacing a derived plan with an authored one is an art pass and
    it is the owner's.
]]
