        attackId = "hollow_crow_swoop",
        attackName = "CROW SWOOP",
        instruction = "STEP OUT OF THE FLIGHT PATH",
        shape = "lane",
        radius = nil,
        width = 5,
        length = 16,
        windup = 0.8,
        stationary = false,
        targetMode = "player",
        frontShield = false,
