local BLACKOUT = track(
    "music_blackout_pulse",
    126401983585086,
    "Dark Assessment Underscore Pulse Only",
    "Pierce Loeb",
    136,
    0.28,
    1
)

local function phaseKey(phase: string): string
    local normalized = string.lower(phase)
    if normalized == "night" then
        return "night"
    elseif normalized == "dusk" then
        return "dusk"
    end
    return "day"
end

function MusicCatalog.resolve(regionId: string, phase: string, blackoutActive: boolean): Track
    if blackoutActive then
        return BLACKOUT
    end
    local score = REGIONS[regionId] or REGIONS.region_emberhollow
    local key = phaseKey(phase)
    return if key == "night" then score.night elseif key == "dusk" then score.dusk else score.day
end

function MusicCatalog.isBlackoutActive(snapshot: any): boolean
    local blackout = if type(snapshot) == "table" then snapshot.blackout else nil
    if type(blackout) ~= "table" then
        return false
    end
    local status = tostring(blackout.status or "dormant")
    return status == "relay"
        or status == "old_growth"
        or status == "warden"
        or status == "resolution"
end

function MusicCatalog.resolveSnapshot(snapshot: any): Track
    local safeSnapshot = if type(snapshot) == "table" then snapshot else {}
    local regionId = if type(safeSnapshot.regionId) == "string"
        then safeSnapshot.regionId
        elseif safeSnapshot.expeditionActive == true then "region_bramblewake"
        else "region_emberhollow"
    return MusicCatalog.resolve(
        regionId,
        tostring(safeSnapshot.phase or "day"),
        MusicCatalog.isBlackoutActive(safeSnapshot)
    )
end

function MusicCatalog.regionIds(): { string }
    local ids = {}
    for regionId in REGIONS do
        table.insert(ids, regionId)
    end
    table.sort(ids)
    return ids
end

function MusicCatalog.tracks(): { Track }
    local result = { BLACKOUT }
    for _, regionId in MusicCatalog.regionIds() do
        local score = REGIONS[regionId]
        table.insert(result, score.day)
        table.insert(result, score.dusk)
        table.insert(result, score.night)
    end
    return result
end

return table.freeze(MusicCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">NamelessNightEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Nameless Night -- the finale, in five scenes rather than phases.

    Every boss so far has been a fight with a verb in the middle. This one
    is five different things in a row, because a finale that is a longer
    version of the Warden Stag is not a finale, it is a boss with more
    health. So: hold a street you cannot hold all of, follow something
    down at the price of your own light, choose which of two people comes
    out, look at what the lantern road actually is, and then decide what
    to do about it.

    Nothing here is a menu until the last scene, and by then the game has
    already taken three decisions off the player in the only way that
    works -- by making them make those decisions with their hands while
    something else was going on. The post they left empty, the light they
    spent, and the person they carried out are all recorded, and the
    epilogue reads them alongside the ending.

    Idempotency is load-bearing here in a way it is not anywhere else. A
    player who disconnects at the bottom of the Hollow must not be able to
    resolve the finale twice, and a party must not be able to resolve
    scenes for each other twice. So every scene carries its own
    transaction id, and so does the ending.
]]

local NamelessNightEncounter = {}

export type Status = "disabled" | "locked" | "dormant" | "playing" | "complete"

export type State = {
    abandonedPost: string?,
    chosenEnding: string?,
    completedScenes: { [string]: boolean },
    followed: { [string]: boolean },
    held: { [string]: boolean },
    leftBehind: string?,
    light: number,
    manifestHash: string,
    participants: { [string]: boolean },
    rescued: string?,
    revision: number,
    runId: string,
    scene: number,
    status: Status,
    trapped: { string },
    witnessed: { [string]: boolean },
}

local SCENE_COUNT = 5
local POST_IDS = table.freeze({ "post_gate", "post_road", "post_hearth" })
-- Two of three, because a party that could hold all three would not be
-- making a decision.
local POSTS_REQUIRED = 2
local MARK_IDS = table.freeze({ "mark_kerb", "mark_stair", "mark_sill", "mark_floor" })
local MARKS_REQUIRED = 3
local STARTING_LIGHT = 5
local MOMENT_IDS = table.freeze({
    "moment_the_flame",
    "moment_the_record",
    "moment_the_hands",
    "moment_the_year",
})
local ENDING_IDS = table.freeze({ "ending_kept", "ending_ended", "ending_shared" })

local THE_STREET = table.freeze({
    attackId = "nameless_night_street",
    attackName = "IT IS IN THE STREET",
    damage = 28,
    instruction = "IT COMES THROUGH THE POST NOBODY IS AT",
    radius = 16,
    shape = "circle",
    windup = 1.6,
})

local THE_WITHDRAWAL = table.freeze({
    attackId = "nameless_night_withdraw",
    attackName = "IT WITHDRAWS",
    damage = 22,
    instruction = "IT IS NOT RUNNING — DO NOT RUN EITHER",
    length = 32,
    shape = "lane",
    width = 9,
    windup = 1.35,
})

local THE_ARITHMETIC = table.freeze({
    attackId = "nameless_night_arithmetic",
    attackName = "THE ARITHMETIC",
    damage = 32,
    instruction = "IT IS WAITING FOR YOU TO DECIDE",
    radius = 18,
    shape = "circle",
    windup = 2.2,
})

NamelessNightEncounter.Id = "boss_nameless_night"
NamelessNightEncounter.SceneCount = SCENE_COUNT
NamelessNightEncounter.PostIds = POST_IDS
NamelessNightEncounter.PostsRequired = POSTS_REQUIRED
NamelessNightEncounter.MarkIds = MARK_IDS
NamelessNightEncounter.MarksRequired = MARKS_REQUIRED
NamelessNightEncounter.StartingLight = STARTING_LIGHT
NamelessNightEncounter.MomentIds = MOMENT_IDS
NamelessNightEncounter.EndingIds = ENDING_IDS
NamelessNightEncounter.Reward = table.freeze({
    amount = 8,
    materialId = "material_memory_glass",
})
NamelessNightEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.8,
    witnessAttackCooldownSeconds = 0,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.completedScenes = table.clone(state.completedScenes)
    nextState.followed = table.clone(state.followed)
    nextState.held = table.clone(state.held)
    nextState.participants = table.clone(state.participants)
    nextState.trapped = table.clone(state.trapped)
    nextState.witnessed = table.clone(state.witnessed)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

local function contains(list: { string }, value: any): boolean
    for _, entry in list do
        if entry == value then
            return true
        end
    end
    return false
end

local function countTrue(set: { [string]: boolean }): number
    local total = 0
    for _, value in set do
        if value then
            total += 1
        end
    end
    return total
end

function NamelessNightEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Nameless Night run ID is required")
    assert(manifestHash ~= "", "Nameless Night manifest hash is required")
    return {
        abandonedPost = nil,
        chosenEnding = nil,
        completedScenes = {},
        followed = {},
        held = {},
        leftBehind = nil,
        light = STARTING_LIGHT,
        manifestHash = manifestHash,
        participants = {},
        rescued = nil,
        revision = 0,
        runId = runId,
        scene = 1,
        status = if enabled then "locked" else "disabled",
        trapped = {},
        witnessed = {},
    }
end

function NamelessNightEncounter.unlock(state: State): (State, any)
    if state.status ~= "locked" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "dormant"
    nextState.revision += 1
    return nextState, { accepted = true, reason = "unlocked" }
end

--[[
    The two people in the third scene are not written into this module.
    The service names whoever is actually in town when the finale opens,
    which is what makes the choice cost anything -- the game asks about
    people a specific save has spent chapters getting to know.
]]
function NamelessNightEncounter.activate(
    state: State,
    userId: number,
    trapped: { string }
): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    if #trapped ~= 2 or trapped[1] == trapped[2] then
        return state, { accepted = false, reason = "invalid_trapped" }
    end
    local nextState = cloneState(state)
    nextState.status = "playing"
    nextState.trapped = { trapped[1], trapped[2] }
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function NamelessNightEncounter.join(state: State, userId: number): State
    if state.status ~= "playing" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

local function advance(state: State, sceneId: string): State
    state.completedScenes[sceneId] = true
    state.scene += 1
    return state
end

-- Scene one. Two posts of three, and whichever is left is how it gets in.
function NamelessNightEncounter.holdPost(state: State, userId: number, postId: any): (State, any)
    if state.status ~= "playing" or state.scene ~= 1 then
        return state, { accepted = false, reason = "wrong_scene" }
    end
    if not contains(POST_IDS, postId) then
        return state, { accepted = false, reason = "unknown_post" }
    end
    if state.held[postId] then
        return state, { accepted = false, reason = "already_held" }
    end
    local nextState = cloneState(state)
    nextState.held[postId] = true
    nextState.participants[participantKey(userId)] = true
    local held = countTrue(nextState.held)
    if held >= POSTS_REQUIRED then
        for _, id in POST_IDS do
            if not nextState.held[id] then
                nextState.abandonedPost = id
                break
            end
        end
        nextState = advance(nextState, "scene_defend")
    end
    nextState.revision += 1
    return nextState,
        {
            abandoned = nextState.abandonedPost,
            accepted = true,
            held = held,
            reason = if nextState.scene > 1 then "street_held" else "post_held",
            required = POSTS_REQUIRED,
        }
end

--[[
    Scene two. It withdraws at the speed you are willing to spend light
    following it, so every mark costs one and a wrong mark costs two. A
    party that guesses its way down arrives with nothing left, which is
    the scene the third one is built on.
]]
function NamelessNightEncounter.follow(state: State, userId: number, markId: any): (State, any)
    if state.status ~= "playing" or state.scene ~= 2 then
        return state, { accepted = false, reason = "wrong_scene" }
    end
    if not contains(MARK_IDS, markId) then
        return state, { accepted = false, reason = "unknown_mark" }
    end
    local followed = countTrue(state.followed)
    local expected = MARK_IDS[followed + 1]
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    if markId ~= expected then
        nextState.light = math.max(0, state.light - 2)
        nextState.revision += 1
        return nextState, { accepted = false, light = nextState.light, reason = "lost_the_trail" }
    end
    nextState.followed[markId] = true
    nextState.light = math.max(0, state.light - 1)
    local total = followed + 1
    if total >= MARKS_REQUIRED then
        nextState = advance(nextState, "scene_pursue")
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            followed = total,
            light = nextState.light,
            reason = if nextState.scene > 2 then "run_to_ground" else "mark_followed",
            required = MARKS_REQUIRED,
        }
end

--[[
    Scene three. Light enough for one. Taking neither is allowed and is
    its own answer -- the game does not refuse a player who will not
    choose, it records that they did not.
]]
function NamelessNightEncounter.rescue(state: State, userId: number, residentId: any): (State, any)
    if state.status ~= "playing" or state.scene ~= 3 then
        return state, { accepted = false, reason = "wrong_scene" }
    end
    if not contains(state.trapped, residentId) then
        return state, { accepted = false, reason = "not_trapped" }
    end
    local nextState = cloneState(state)
    nextState.rescued = residentId
    nextState.leftBehind = if state.trapped[1] == residentId
        then state.trapped[2]
        else state.trapped[1]
    nextState.participants[participantKey(userId)] = true
    nextState = advance(nextState, "scene_rescue")
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            left = nextState.leftBehind,
            reason = "carried_out",
            rescued = residentId,
        }
end

function NamelessNightEncounter.passBy(state: State, userId: number): (State, any)
    if state.status ~= "playing" or state.scene ~= 3 then
        return state, { accepted = false, reason = "wrong_scene" }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState = advance(nextState, "scene_rescue")
    nextState.revision += 1
    return nextState, { accepted = true, reason = "passed_by", rescued = nil }
end

-- Scene four. Nothing attacks; the only thing that can be got wrong here
-- is leaving before you have seen it.
function NamelessNightEncounter.witness(state: State, userId: number, momentId: any): (State, any)
    if state.status ~= "playing" or state.scene ~= 4 then
        return state, { accepted = false, reason = "wrong_scene" }
    end
    if not contains(MOMENT_IDS, momentId) then
        return state, { accepted = false, reason = "unknown_moment" }
    end
    if state.witnessed[momentId] then
        return state, { accepted = false, reason = "already_seen" }
    end
    local nextState = cloneState(state)
    nextState.witnessed[momentId] = true
    nextState.participants[participantKey(userId)] = true
    local seen = countTrue(nextState.witnessed)
    if seen >= #MOMENT_IDS then
        nextState = advance(nextState, "scene_witness")
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = if nextState.scene > 4 then "seen_it_all" else "witnessed",
            required = #MOMENT_IDS,
            seen = seen,
        }
end

-- Scene five. The only menu in the game, and it comes after everything
-- that could have been decided without one already has been.
function NamelessNightEncounter.choose(state: State, userId: number, endingId: any): (State, any)
    if state.status ~= "playing" or state.scene ~= 5 then
        return state, { accepted = false, reason = "wrong_scene" }
    end
    if not contains(ENDING_IDS, endingId) then
        return state, { accepted = false, reason = "unknown_ending" }
    end
    if state.chosenEnding ~= nil then
        return state, { accepted = false, reason = "already_chosen" }
    end
    local nextState = cloneState(state)
    nextState.chosenEnding = endingId
    nextState.participants[participantKey(userId)] = true
    nextState = advance(nextState, "scene_choose")
    nextState.status = "complete"
    nextState.revision += 1
    return nextState, { accepted = true, completed = true, ending = endingId, reason = "chosen" }
end

function NamelessNightEncounter.attack(scene: number): any?
    if scene == 1 then
        return THE_STREET
    elseif scene == 2 then
        return THE_WITHDRAWAL
    elseif scene == 3 then
        return THE_ARITHMETIC
    end
    -- Scenes four and five have no attack at all. That is the point of
    -- them, and a caller that expects one everywhere would put one here.
    return nil
end

function NamelessNightEncounter.snapshot(state: State, userId: number): any
    local instruction = if state.status == "complete"
        then "IT IS DECIDED"
        elseif state.status == "locked" then "THE HOLLOW IS NOT OPEN TO YOU YET"
        elseif state.status == "disabled" then "THE HOLLOW DOES NOT ANSWER"
        elseif state.status == "dormant" then "THE ROAD KEEPS GOING"
        elseif state.scene == 1 then string.format(
            "HOLD TWO POSTS — %d OF %d",
            countTrue(state.held),
            POSTS_REQUIRED
        )
        elseif state.scene == 2 then string.format(
            "FOLLOW IT DOWN — %d MARKS, %d LIGHT LEFT",
            countTrue(state.followed),
            state.light
        )
        elseif state.scene == 3 then "THERE IS LIGHT FOR ONE OF THEM"
        elseif state.scene == 4 then string.format(
            "LOOK AT ALL OF IT — %d OF %d",
            countTrue(state.witnessed),
            #MOMENT_IDS
        )
        else "DECIDE WHAT HAPPENS TO THE LIGHT"
    return {
        abandonedPost = state.abandonedPost,
        active = state.status == "playing",
        complete = state.status == "complete",
        displayName = "THE NAMELESS NIGHT",
        enabled = state.status ~= "disabled",
        ending = state.chosenEnding,
        instruction = instruction,
        leftBehind = state.leftBehind,
        light = state.light,
        rescued = state.rescued,
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        scene = math.min(state.scene, SCENE_COUNT),
        sceneCount = SCENE_COUNT,
        status = state.status,
        trapped = table.clone(state.trapped),
    }
end

--[[
    One transaction id per scene, and a separate one for the ending. A
    disconnect at the bottom of the Hollow must not let anything be
    resolved twice, and the ledger is what enforces that -- not this
    module remembering, which a rejoin would wipe.
]]
function NamelessNightEncounter.sceneTransactionId(state: State, sceneId: string): string
    return string.format(
        "%s:%s:%s:%s",
        NamelessNightEncounter.Id,
        state.runId,
        state.manifestHash,
        sceneId
    )
end

function NamelessNightEncounter.endingTransactionId(state: State): string
    return string.format(
        "%s:ending:%s:%s",
        NamelessNightEncounter.Id,
        state.runId,
        state.manifestHash
    )
end

function NamelessNightEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        NamelessNightEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(NamelessNightEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">NightSchedule</string>
          <string name="Source"><![CDATA[--!strict

local NightSchedule = {}

export type Beat = {
    at: number,
    kind: "spawn" | "warning" | "breach",
    enemyId: string?,
}

local BEATS: { Beat } = {
    { at = 0, kind = "warning", enemyId = nil },
    { at = 4, kind = "spawn", enemyId = "enemy_rootling" },
    { at = 22, kind = "spawn", enemyId = "enemy_briarback" },
    { at = 40, kind = "spawn", enemyId = "enemy_zombie" },
    { at = 56, kind = "breach", enemyId = nil },
    { at = 58, kind = "spawn", enemyId = "enemy_hollow_crow" },
    { at = 76, kind = "spawn", enemyId = "enemy_snapvine" },
    { at = 94, kind = "spawn", enemyId = "enemy_bark_ram" },
}

function NightSchedule.beats(duration: number): { Beat }
    local result: { Beat } = {}
    for _, beat in BEATS do
        if beat.at < duration then
            table.insert(result, table.clone(beat))
        end
    end
    return result
end

function NightSchedule.pending(duration: number, elapsed: number): { Beat }
    local result: { Beat } = {}
    for _, beat in NightSchedule.beats(duration) do
        if beat.at >= elapsed then
            table.insert(result, beat)
        end
    end
    return result
end

return table.freeze(NightSchedule)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">OldGrowthEncounter</string>
          <string name="Source"><![CDATA[--!strict

local OldGrowthEncounter = {}

export type Status = "disabled" | "dormant" | "vulnerable" | "shielded" | "complete"

export type State = {
    carriers: { [string]: number },
    health: number,
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    shieldIndex: number,
    status: Status,
}

local MAX_HEALTH = 360
local FIRE_CARRY_SECONDS = 15
local SHIELD_THRESHOLDS = table.freeze({ 240, 120 })

local ROOT_LANE = table.freeze({
    attackId = "old_growth_root_lane",
    attackName = "CATHEDRAL ROOTS",
    damage = 20,
    instruction = "CLEAR THE ROOT LANE",
    length = 32,
    rootedDuration = 1.6,
    rootedMultiplier = 0.35,
    shape = "lane",
    width = 9,
    windup = 1.35,
})

local CANOPY_FALL = table.freeze({
    attackId = "old_growth_canopy_fall",
    attackName = "CANOPY FALL",
    damage = 28,
    instruction = "LEAVE THE FALL RING",
    radius = 10,
    shape = "circle",
    windup = 1.55,
})

OldGrowthEncounter.Id = "elite_old_growth"
OldGrowthEncounter.MaxHealth = MAX_HEALTH
OldGrowthEncounter.FireCarrySeconds = FIRE_CARRY_SECONDS
OldGrowthEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_amber_sap",
})
OldGrowthEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3,
    markedAttackCooldownMultiplier = 1.35,
    markedStrikeDamage = 40,
    shieldedAttackCooldownSeconds = 4.2,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.carriers = table.clone(state.carriers)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

function OldGrowthEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Old Growth run ID is required")
    assert(manifestHash ~= "", "Old Growth manifest hash is required")
    return {
        carriers = {},
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        shieldIndex = 0,
        status = if enabled then "dormant" else "disabled",
    }
end

function OldGrowthEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.status = "vulnerable"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            activated = true,
            reason = "activated",
        }
end

function OldGrowthEncounter.join(state: State, userId: number): State
    if state.status ~= "vulnerable" and state.status ~= "shielded" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function OldGrowthEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Old Growth strike amount is invalid")
    if state.status ~= "vulnerable" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local nextHealth = math.max(0, state.health - amount)
    local threshold = SHIELD_THRESHOLDS[state.shieldIndex + 1]
    local shieldStarted = threshold ~= nil and nextHealth <= threshold
    if shieldStarted then
        nextState.health = threshold
        nextState.shieldIndex += 1
        nextState.status = "shielded"
    else
        nextState.health = nextHealth
        if nextHealth <= 0 then
            nextState.status = "complete"
            nextState.carriers = {}
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            reason = if nextState.status == "complete"
                then "completed"
                elseif shieldStarted then "shield_started"
                else "damaged",
            shieldStarted = shieldStarted,
        }
end

function OldGrowthEncounter.takeFire(state: State, userId: number, now: number): (State, any)
    if state.status ~= "shielded" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local key = participantKey(userId)
    for carrierKey, expiresAt in state.carriers do
        if carrierKey ~= key and now < expiresAt then
            return state,
                {
                    accepted = false,
                    reason = "fire_claimed",
                }
        end
    end
    local nextState = cloneState(state)
    nextState.carriers[key] = now + FIRE_CARRY_SECONDS
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            expiresAt = nextState.carriers[key],
            reason = "fire_taken",
        }
end

function OldGrowthEncounter.burnHeart(state: State, userId: number, now: number): (State, any)
    if state.status ~= "shielded" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local key = participantKey(userId)
    local expiresAt = state.carriers[key]
    if expiresAt == nil or now >= expiresAt then
        return state,
            {
                accepted = false,
                reason = "fire_required",
            }
    end
    local nextState = cloneState(state)
    nextState.carriers = {}
    nextState.participants[key] = true
    nextState.status = "vulnerable"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = "shield_burned",
            shieldIndex = nextState.shieldIndex,
        }
end

function OldGrowthEncounter.expire(state: State, now: number): State
    local expired = false
    local nextState = cloneState(state)
    for key, expiresAt in nextState.carriers do
        if now >= expiresAt then
            nextState.carriers[key] = nil
            expired = true
        end
    end
    if expired then
        nextState.revision += 1
        return nextState
    end
    return state
end

function OldGrowthEncounter.attack(attackIndex: number, shieldIndex: number): any
    if shieldIndex >= 1 and attackIndex % 2 == 0 then
        return CANOPY_FALL
    end
    return ROOT_LANE
end

function OldGrowthEncounter.snapshot(state: State, userId: number, now: number): any
    local expiresAt = state.carriers[tostring(userId)] or 0
    local carryingFire = now < expiresAt
    local instruction = if state.status == "shielded"
        then if carryingFire then "CARRY FIRE TO THE ROOT HEART" else "TAKE LANTERN FIRE"
        elseif state.status == "vulnerable" then "STRIKE THE AMBER HEART"
        elseif state.status == "complete" then "OLD GROWTH CLEANSED"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE OLD GROWTH ARENA"
    return {
        active = state.status == "vulnerable" or state.status == "shielded",
        carryingFire = carryingFire,
        complete = state.status == "complete",
        displayName = "OLD GROWTH",
        enabled = state.status ~= "disabled",
        fireExpiresAt = if carryingFire then expiresAt else 0,
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, state.shieldIndex + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        shielded = state.status == "shielded",
        shieldIndex = state.shieldIndex,
        status = state.status,
    }
end

function OldGrowthEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        OldGrowthEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(OldGrowthEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="74">
        <Properties>
          <string name="Name">PartySession</string>
          <string name="Source"><![CDATA[--!strict

--[[
    A party is a named thing, and until now it was not one.

    What the game has had since the lodge shipped is a platform: whoever is
    standing on it when the countdown reaches zero boards, in whatever order
    `Players:GetPlayers()` happened to return them, up to the size somebody
    tapped. That is a party in the sense that several people left at once. It
    is not a party in any sense that survives anything -- not a bystander who
    wandered onto the dais and took the fourth seat, and certainly not a
    disconnect, because a run server is reserved and a player who drops out of
    one has no way to name the world their friends are still in.

    So this module gives a departure an identity and a roster, and then gives
    each member a ticket back to it.

    Pure logic: no players, no TeleportService, no clock of its own. The
    service layer owns who is physically present and what a user ID belongs
    to; every rule about who may join, who boards first, and whether a
    returning player may be sent back lives here so it can be tested without a
    live game -- which matters more than usual, because reserved-server
    teleports cannot be exercised in Studio at all.

    The rules:

      * **Membership is by invitation and acceptance, both.** An invite alone
        does not put anyone in a party. This is the difference between a party
        and the set of people standing near you, and it is also what makes a
        block meaningful later: there is a moment where somebody says yes.
      * **A party boards ahead of bystanders.** Capacity is spent on members
        first, in roster order, and only then on whoever else is standing
        there. A party of three that chose four seats can still pick up a
        stranger; a party of four never loses a seat to one.
      * **A leader who leaves hands over.** Dissolving a party because one
        person stepped away punishes everyone else for it. The longest-
        standing remaining member takes it, and only the last member out
        dissolves anything.
      * **The ticket the server holds and the fact the client sees are
        different objects.** The ticket carries a reserved-server access code,
        which is the whole key to a private world; the client is told only
        that a rejoin is available and how big the party was. `publicTicket`
        exists so that split is a function rather than a habit.
      * **A stale ticket returns you to the lodge rather than into an empty
        world.** Reserved servers outlive their parties; a code that still
        resolves an hour after everybody left teleports a player alone into a
        world with no one in it, which is a worse answer than the lobby.
]]

local PartySession = {}

export type Member = {
    userId: number,
    joinedAt: number,
}

export type Invite = {
    toUserId: number,
    fromUserId: number,
    expiresAt: number,
}

export type State = {
    partyId: string,
    leaderUserId: number,
    members: { Member },
    invites: { Invite },
    departedAt: number,
}

export type Ticket = {
    partyId: string,
    accessCode: string,
    partySize: number,
    issuedAt: number,
    expiresAt: number,
}

-- An invite that nobody answers should stop being an offer. Long enough to
-- notice a toast and reach the button, short enough that a party formed
-- twenty minutes ago is not still holding a seat open for somebody who walked
-- away.
local INVITE_SECONDS = 45

--[[
    How long a rejoin ticket is worth trying.

    A run is not short, and a player who drops on a phone may take several
    minutes to get back, so this is generous. It is not unbounded because the
    failure mode at the far end is the bad one: a reserved server that has
    emptied out still accepts a teleport, and arriving alone in the world your
    party left an hour ago reads as the game breaking rather than as a rejoin.
]]
local REJOIN_SECONDS = 5400

local MAX_ACCESS_CODE_LENGTH = 128
local MAX_PARTY_ID_LENGTH = 64

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeAtLeast(value: any, minimum: number): boolean
    return finite(value) and value >= minimum and value == math.floor(value)
end

local function isUserId(value: any): boolean
    return wholeAtLeast(value, 1)
end

function PartySession.inviteSeconds(): number
    return INVITE_SECONDS
end

function PartySession.rejoinSeconds(): number
    return REJOIN_SECONDS
end

--[[
    Start a party with one member, its leader.

    The ID is derived rather than random so the module stays pure and its
    tests stay readable. A leader can hold only one party at a time, so the
    only way to collide is for the same person to form two parties inside the
    same second, which the service layer refuses on its own by looking them up
    before creating.
]]
function PartySession.create(leaderUserId: any, now: any): (State?, any)
    if not isUserId(leaderUserId) then
        return nil, { accepted = false, reason = "invalid_leader" }
    end
    if not finite(now) or now < 0 then
        return nil, { accepted = false, reason = "invalid_time" }
    end
    return {
        partyId = string.format("party_%d_%d", leaderUserId, math.floor(now)),
        leaderUserId = leaderUserId,
        members = { { userId = leaderUserId, joinedAt = now } },
        invites = {},
        departedAt = 0,
    }, { accepted = true }
end

--[[
    The party a departure forms out of whoever actually boarded.

    This is the one path into a roster that does not go through an invitation,
    and it is not a back door: standing on the dais while the countdown runs
    out is the older and more physical form of the same consent, and it is the
    one the game shipped with. What the invitation system decides is who
    boards *first* and who gets asked at all -- not who is allowed to travel.

    It matters that the travelling party is the boarding list rather than the
    party formed at the lodge, because those can differ: a party of three that
    chose four seats picks up a stranger, and the stranger is in that world
    with them. A rejoin ticket has to name the world's population, not the
    friendship group's, or the stranger has no way home.
]]
function PartySession.createForDeparture(userIds: any, now: any): (State?, any)
    if type(userIds) ~= "table" then
        return nil, { accepted = false, reason = "invalid_roster" }
    end
    if not finite(now) or now < 0 then
        return nil, { accepted = false, reason = "invalid_time" }
    end

    local members: { Member } = {}
    local seen: { [number]: boolean } = {}
    for _, userId in userIds do
        if isUserId(userId) and not seen[userId] then
            seen[userId] = true
            table.insert(members, { userId = userId, joinedAt = now })
        end
    end
    if #members == 0 then
        return nil, { accepted = false, reason = "empty_roster" }
    end

    return {
        partyId = string.format("party_%d_%d", members[1].userId, math.floor(now)),
        leaderUserId = members[1].userId,
        members = members,
        invites = {},
        departedAt = 0,
    }, { accepted = true, size = #members }
end

--[[
    Bound whatever a caller hands in.

    Party state never leaves the server and is never persisted, so this is not
    guarding against a forged save -- it is guarding against a service passing
    a table it built itself and got slightly wrong, which is the failure this
    codebase has actually had. A state that cannot be read is empty, and an
    empty party admits nobody.
]]
function PartySession.normalize(value: any): State?
    if type(value) ~= "table" then
        return nil
    end
    --[[
        Bounded to the same length a ticket can carry. Without that agreement
        a party could hold an ID it is able to issue tickets for and unable to
        read them back, which is a way home that works right up until the
        player uses it.
    ]]
    if
        type(value.partyId) ~= "string"
        or #value.partyId == 0
        or #value.partyId > MAX_PARTY_ID_LENGTH
    then
        return nil
    end
    if not isUserId(value.leaderUserId) then
        return nil
    end
    if type(value.members) ~= "table" then
        return nil
    end

    local members: { Member } = {}
    local seen: { [number]: boolean } = {}
    for _, member in value.members do
        if
            type(member) == "table"
            and isUserId(member.userId)
            and finite(member.joinedAt)
            and not seen[member.userId]
        then
            seen[member.userId] = true
            table.insert(members, { userId = member.userId, joinedAt = member.joinedAt })
        end
    end
    if not seen[value.leaderUserId] then
        return nil
    end

    local invites: { Invite } = {}
    if type(value.invites) == "table" then
        local invited: { [number]: boolean } = {}
        for _, invite in value.invites do
            if
                type(invite) == "table"
                and isUserId(invite.toUserId)
                and isUserId(invite.fromUserId)
                and finite(invite.expiresAt)
                and not invited[invite.toUserId]
                and not seen[invite.toUserId]
            then
                invited[invite.toUserId] = true
                table.insert(invites, {
                    toUserId = invite.toUserId,
                    fromUserId = invite.fromUserId,
                    expiresAt = invite.expiresAt,
                })
            end
        end
    end

    return {
        partyId = value.partyId,
        leaderUserId = value.leaderUserId,
        members = members,
        invites = invites,
        departedAt = if finite(value.departedAt) and value.departedAt > 0
            then value.departedAt
            else 0,
    }
end

function PartySession.isMember(state: any, userId: any): boolean
    local current = PartySession.normalize(state)
    if current == nil or not isUserId(userId) then
        return false
    end
    for _, member in current.members do
        if member.userId == userId then
            return true
        end
    end
    return false
end

function PartySession.size(state: any): number
    local current = PartySession.normalize(state)
    return if current == nil then 0 else #current.members
end

-- Roster order, leader first. This is the order capacity is spent in, so it
-- is deliberately not the order people happened to accept in: whoever formed
-- the party is the one person guaranteed a seat on it.
function PartySession.memberIds(state: any): { number }
    local current = PartySession.normalize(state)
    if current == nil then
        return {}
    end
    local ids = { current.leaderUserId }
    for _, member in current.members do
        if member.userId ~= current.leaderUserId then
            table.insert(ids, member.userId)
        end
    end
    return ids
end

function PartySession.pendingInvite(state: any, userId: any, now: any): Invite?
    local current = PartySession.normalize(state)
    if current == nil or not isUserId(userId) or not finite(now) then
        return nil
    end
    for _, invite in current.invites do
        if invite.toUserId == userId and invite.expiresAt > now then
            return invite
        end
    end
    return nil
end

local function withoutInvite(invites: { Invite }, userId: number, now: number): { Invite }
    local kept: { Invite } = {}
    for _, invite in invites do
        -- Expired invites are swept here rather than by a timer. Nothing else
        -- needs a tick, and an offer that has run out is indistinguishable
        -- from one that was never made.
        if invite.toUserId ~= userId and invite.expiresAt > now then
            table.insert(kept, invite)
        end
    end
    return kept
end

--[[
    Offer a seat to somebody.

    Any member may invite, not only the leader: a party at a departure
    platform is a group of people standing together, and making three of them
    route every introduction through a fourth is ceremony the situation does
    not have. What only the leader can do is nothing, which is the point --
    leadership here decides boarding order and nothing else.

    A full party refuses rather than queueing. Invites deliberately do not
    reserve seats, so two people accepting the last one is resolved at accept
    time by whoever gets there first, and the loser is told the party is full
    rather than being silently dropped.
]]
function PartySession.invite(
    state: any,
    fromUserId: any,
    toUserId: any,
    now: any,
    maxSize: any
): (State?, any)
    local current = PartySession.normalize(state)
    if current == nil then
        return nil, { accepted = false, reason = "no_party" }
    end
    if not finite(now) or now < 0 then
        return current, { accepted = false, reason = "invalid_time" }
    end
    if not wholeAtLeast(maxSize, 1) then
        return current, { accepted = false, reason = "invalid_capacity" }
    end
    if not isUserId(toUserId) then
        return current, { accepted = false, reason = "invalid_target" }
    end
    if not PartySession.isMember(current, fromUserId) then
        return current, { accepted = false, reason = "not_a_member" }
    end
    if current.departedAt > 0 then
        return current, { accepted = false, reason = "already_departed" }
    end
    if PartySession.isMember(current, toUserId) then
        return current, { accepted = false, reason = "already_a_member" }
    end
    if #current.members >= maxSize then
        return current, { accepted = false, reason = "party_full" }
    end

    local invites = withoutInvite(current.invites, toUserId, now)
    table.insert(invites, {
        toUserId = toUserId,
        fromUserId = fromUserId,
        expiresAt = now + INVITE_SECONDS,
    })
    return {
        partyId = current.partyId,
        leaderUserId = current.leaderUserId,
        members = current.members,
        invites = invites,
        departedAt = current.departedAt,
    }, { accepted = true, expiresAt = now + INVITE_SECONDS }
end

function PartySession.accept(state: any, userId: any, now: any, maxSize: any): (State?, any)
    local current = PartySession.normalize(state)
    if current == nil then
        return nil, { accepted = false, reason = "no_party" }
    end
    if not finite(now) or now < 0 then
        return current, { accepted = false, reason = "invalid_time" }
    end
    if not wholeAtLeast(maxSize, 1) then
        return current, { accepted = false, reason = "invalid_capacity" }
    end
    if PartySession.pendingInvite(current, userId, now) == nil then
        return current, { accepted = false, reason = "no_invite" }
    end
    if current.departedAt > 0 then
        return current, { accepted = false, reason = "already_departed" }
    end
    if #current.members >= maxSize then
        return current, { accepted = false, reason = "party_full" }
    end

    local members = table.clone(current.members)
    table.insert(members, { userId = userId, joinedAt = now })
    return {
        partyId = current.partyId,
        leaderUserId = current.leaderUserId,
        members = members,
        invites = withoutInvite(current.invites, userId, now),
        departedAt = current.departedAt,
    }, { accepted = true, size = #members }
end

function PartySession.decline(state: any, userId: any, now: any): (State?, any)
    local current = PartySession.normalize(state)
    if current == nil then
        return nil, { accepted = false, reason = "no_party" }
    end
    if not finite(now) or not isUserId(userId) then
        return current, { accepted = false, reason = "invalid_time" }
    end
    if PartySession.pendingInvite(current, userId, now) == nil then
        return current, { accepted = false, reason = "no_invite" }
    end
    return {
        partyId = current.partyId,
        leaderUserId = current.leaderUserId,
        members = current.members,
        invites = withoutInvite(current.invites, userId, now),
        departedAt = current.departedAt,
    }, { accepted = true }
end

--[[
    Leave, including as the leader.

    Handover goes to the longest-standing remaining member rather than to
    whoever is alphabetically first or last to arrive, because the party's own
    history is the only ordering that means anything: the person who has been
    in it longest is the one most likely to know what it was formed to do.

    The last member out dissolves the party, and `dissolved` says so, so the
    service can drop it rather than keeping an empty roster that would gladly
    accept an invite.
]]
function PartySession.leave(state: any, userId: any, now: any): (State?, any)
    local current = PartySession.normalize(state)
    if current == nil then
        return nil, { accepted = false, reason = "no_party" }
    end
    if not finite(now) then
        return current, { accepted = false, reason = "invalid_time" }
    end
    if not PartySession.isMember(current, userId) then
        return current, { accepted = false, reason = "not_a_member" }
    end

    local members: { Member } = {}
    for _, member in current.members do
        if member.userId ~= userId then
            table.insert(members, member)
        end
    end
    if #members == 0 then
        return nil, { accepted = true, dissolved = true }
    end

    local leaderUserId = current.leaderUserId
    local handedTo: number? = nil
    if leaderUserId == userId then
        local longest = members[1]
        for _, member in members do
            if member.joinedAt < longest.joinedAt then
                longest = member
            end
        end
        leaderUserId = longest.userId
        handedTo = leaderUserId
    end

    return {
        partyId = current.partyId,
        leaderUserId = leaderUserId,
        members = members,
        invites = withoutInvite(current.invites, if isUserId(userId) then userId else 0, now),
        departedAt = current.departedAt,
    }, { accepted = true, dissolved = false, handedTo = handedTo }
end

--[[
    Seal a party at the moment it leaves.

    A departed party stops taking invitations for the obvious reason -- there
    is no longer any way to reach it from the lodge -- but the roster stays
    intact, because that is what the rejoin tickets are checked against.
]]
function PartySession.depart(state: any, now: any): (State?, any)
    local current = PartySession.normalize(state)
    if current == nil then
        return nil, { accepted = false, reason = "no_party" }
    end
    if not finite(now) or now < 0 then
        return current, { accepted = false, reason = "invalid_time" }
    end
    if current.departedAt > 0 then
        return current, { accepted = false, reason = "already_departed" }
    end
    return {
        partyId = current.partyId,
        leaderUserId = current.leaderUserId,
        members = current.members,
        invites = {},
        departedAt = now,
    }, { accepted = true }
end

--[[
    Who boards, in what order, out of everyone standing on the platform.

    `candidates` is the service's own reading of the dais, in whatever order
    it found them; `capacity` is what the chosen party size allows. Members go
    first in roster order, then everyone else in the order given. Nobody who
    is not standing there is ever returned, whatever the roster says: the
    platform is still the authority on presence, and this only re-orders what
    it reports.
]]
function PartySession.boardingOrder(state: any, candidates: any, capacity: any): { number }
    local ordered: { number } = {}
    if type(candidates) ~= "table" or not wholeAtLeast(capacity, 0) then
        return ordered
    end

    local present: { [number]: boolean } = {}
    for _, userId in candidates do
        if isUserId(userId) then
            present[userId] = true
        end
    end

    local taken: { [number]: boolean } = {}
    for _, userId in PartySession.memberIds(state) do
        if present[userId] and not taken[userId] and #ordered < capacity then
            taken[userId] = true
            table.insert(ordered, userId)
        end
    end
    for _, userId in candidates do
        if isUserId(userId) and not taken[userId] and #ordered < capacity then
            taken[userId] = true
            table.insert(ordered, userId)
        end
    end
    return ordered
end

--[[
    The ticket a member carries home.

    `accessCode` is a reserved-server access code: the entire key to a private
    world. It is written to the profile, which is server-owned storage, and it
    must never reach a client -- see `publicTicket`, which is the shape that
    may. Issuing one for a non-member is refused rather than clamped, because
    a ticket handed to the wrong person is a door into somebody else's run.
]]
function PartySession.issueTicket(
    state: any,
    userId: any,
    accessCode: any,
    now: any
): (Ticket?, any)
    local current = PartySession.normalize(state)
    if current == nil then
        return nil, { accepted = false, reason = "no_party" }
    end
    if not PartySession.isMember(current, userId) then
        return nil, { accepted = false, reason = "not_a_member" }
    end
    if type(accessCode) ~= "string" or #accessCode == 0 or #accessCode > MAX_ACCESS_CODE_LENGTH then
        return nil, { accepted = false, reason = "invalid_access_code" }
    end
    if not finite(now) or now < 0 then
        return nil, { accepted = false, reason = "invalid_time" }
    end
    return {
        partyId = current.partyId,
        accessCode = accessCode,
        partySize = #current.members,
        issuedAt = now,
        expiresAt = now + REJOIN_SECONDS,
    }, { accepted = true }
end

--[[
    Bound a ticket read back off a save.

    This one IS guarding against a forged profile, unlike `normalize` above:
    the ticket persists, so it comes back through the same door every other
    saved field does. Anything malformed is no ticket at all, which lands the
    player in the lodge -- the same safe direction `RunHandoff` takes with an
    unreadable teleport payload, and for the same reason.
]]
function PartySession.normalizeTicket(value: any): Ticket?
    if type(value) ~= "table" then
        return nil
    end
    if
        type(value.partyId) ~= "string"
        or #value.partyId == 0
        or #value.partyId > MAX_PARTY_ID_LENGTH
    then
        return nil
    end
    if
        type(value.accessCode) ~= "string"
        or #value.accessCode == 0
        or #value.accessCode > MAX_ACCESS_CODE_LENGTH
    then
        return nil
    end
    if not finite(value.issuedAt) or value.issuedAt < 0 then
        return nil
    end
    if not finite(value.expiresAt) or value.expiresAt <= value.issuedAt then
        return nil
    end
    return {
        partyId = value.partyId,
        accessCode = value.accessCode,
        partySize = if wholeAtLeast(value.partySize, 1) then value.partySize else 1,
        issuedAt = value.issuedAt,
        expiresAt = value.expiresAt,
    }
end

--[[
    Whether a returning player may be sent back, and where.

    `currentPartyId` is the party this server already belongs to, if any: a
    run server adopts its identity from the teleport payload, so a member
    landing back in the world their ticket names has arrived rather than
    needing to be sent, and forwarding them again would be a loop.
]]
function PartySession.readTicket(ticket: any, now: any, currentPartyId: any): any
    local bounded = PartySession.normalizeTicket(ticket)
    if bounded == nil then
        return { rejoin = false, reason = "no_ticket" }
    end
    if not finite(now) then
        return { rejoin = false, reason = "invalid_time" }
    end
    if bounded.expiresAt <= now then
        return { rejoin = false, reason = "expired" }
    end
    if type(currentPartyId) == "string" and currentPartyId == bounded.partyId then
        return { rejoin = false, reason = "already_here" }
    end
    return {
        rejoin = true,
        partyId = bounded.partyId,
        accessCode = bounded.accessCode,
        partySize = bounded.partySize,
    }
end

--[[
    The half of a ticket a client may be told.

    Everything here is presentation: that a rejoin is on offer, how many
    people were in the party, how long the offer lasts. The access code is
    absent by construction rather than by remembering to omit it, which is the
    only version of that rule that survives somebody adding a field later.

    SAFETY-CHANNEL: rejoin_ticket -- a reserved-server access code is a door
    into a private world, and this is the wall between it and any client. Not a
    block-suppressed channel: it never reaches a player other than the one it
    was issued to at all.
]]
function PartySession.publicTicket(ticket: any, now: any, currentPartyId: any): any?
    local read = PartySession.readTicket(ticket, now, currentPartyId)
    if not read.rejoin then
        return nil
    end
    local bounded = PartySession.normalizeTicket(ticket) :: Ticket
    return {
        available = true,
        partySize = read.partySize,
        secondsRemaining = math.max(0, math.floor(bounded.expiresAt - now)),
    }
end

return table.freeze(PartySession)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">PerformanceBudget</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The performance budgets from docs/TECHNICAL_ARCHITECTURE.md, as data.

    Milestone 3's exit gate asks that "target device meets frame, memory, join,
    and network budgets for a 30-minute run." That sentence is only checkable
    if the budgets are numbers and the run produces samples, so both live here:
    the thresholds the architecture doc already fixed, and the arithmetic that
    turns a pile of samples into a verdict.

    Three things this module deliberately does:

      * It judges a tail, not an average. A 30-minute run that averages 50 FPS
        while stuttering through every night is a run that failed, and a mean
        hides exactly that. Each metric names the percentile that decides it --
        the low tail when higher is better, the high tail when lower is worse.
      * A metric with no samples is never "ok". An unmeasured budget reports
        `incomplete`, because the failure this gate exists to catch is claiming
        a pass for something nobody looked at.
      * It is pure. No Roblox services, no players, no clock. Whatever samples
        it, from the server or from a client, hands it numbers.

    The numbers are the architecture doc's, not new ones. Where that doc gave a
    qualitative hard threshold rather than a figure, the reading taken here is
    marked so it can be argued with instead of being quietly invented.
]]

local Config = require("./Config")

local PerformanceBudget = {}

export type Direction = "higher_is_better" | "lower_is_better"
export type Verdict = "ok" | "watch" | "breach" | "incomplete"

export type Definition = {
    id: string,
    label: string,
    unit: string,
    direction: Direction,
    target: number,
    hard: number,
    -- The percentile that decides this metric's verdict: the tail where the
    -- bad samples live.
    percentile: number,
    source: string,
}

export type Summary = {
    id: string,
    count: number,
    discarded: number,
    min: number,
    max: number,
    mean: number,
    p50: number,
    value: number,
    verdict: Verdict,
}

export type Report = {
    verdict: Verdict,
    metrics: { Summary },
    missing: { string },
}

local ORDER: { string } = {
    "join_seconds",
    "client_fps",
    "frame_spike_ms",
    "server_heartbeat_hz",
    "client_memory_headroom",
    "remote_actions_per_second",
}

local DEFINITIONS: { [string]: Definition } = {
    join_seconds = {
        id = "join_seconds",
        label = "Interactive join, warm network",
        unit = "s",
        direction = "lower_is_better",
        target = 5,
        hard = 8,
        percentile = 95,
        source = "TECHNICAL_ARCHITECTURE.md performance budgets",
    },
    client_fps = {
        id = "client_fps",
        label = "Client frame rate, normal play",
        unit = "FPS",
        direction = "higher_is_better",
        target = 45,
        hard = 30,
        -- "Sustained < 30 FPS" is the doc's failure case. The 5th percentile
        -- is the reading of "sustained": a fifth of a second in twenty spent
        -- below the line is a stutter, a twentieth of the whole run below it
        -- is the run being slow.
        percentile = 5,
        source = "TECHNICAL_ARCHITECTURE.md performance budgets",
    },
    frame_spike_ms = {
        id = "frame_spike_ms",
        label = "Client frame time spikes",
        unit = "ms",
        direction = "lower_is_better",
        target = 50,
        hard = 100,
        percentile = 95,
        source = "TECHNICAL_ARCHITECTURE.md performance budgets",
    },
    server_heartbeat_hz = {
        id = "server_heartbeat_hz",
        label = "Server heartbeat",
        unit = "Hz",
        direction = "higher_is_better",
        target = 30,
        hard = 20,
        percentile = 5,
        source = "TECHNICAL_ARCHITECTURE.md performance budgets",
    },
    client_memory_headroom = {
        id = "client_memory_headroom",
        label = "Client memory headroom",
        unit = "ratio",
        direction = "higher_is_better",
        target = 0.2,
        -- The doc's hard threshold here is "OOM/reload risk", which is a
        -- consequence rather than a number. Half the target is the reading
        -- taken: below a tenth of the device's memory free, a Roblox client
        -- is one asset load from being killed. Argue with this figure before
        -- the slice closes -- it is the one budget here nobody measured yet.
        hard = 0.1,
        percentile = 5,
        source = "TECHNICAL_ARCHITECTURE.md, numeric reading of OOM risk",
    },
    remote_actions_per_second = {
        id = "remote_actions_per_second",
        label = "Remote traffic, actions per client",
        unit = "/s",
        direction = "lower_is_better",
        -- The action limiter already owns this budget, so the budget is the
        -- limiter's own configuration rather than a second opinion: sustained
        -- traffic at the rate, never above the burst ceiling.
        target = Config.ActionRatePerSecond,
        hard = Config.ActionRatePerSecond * 2,
        percentile = 95,
        source = "Config.ActionRatePerSecond",
    },
}

local SEVERITY: { [string]: number } = {
    ok = 0,
    watch = 1,
    incomplete = 2,
    breach = 3,
}

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function PerformanceBudget.order(): { string }
    return table.clone(ORDER)
end

function PerformanceBudget.definition(metricId: string): Definition
    local definition = DEFINITIONS[metricId]
    assert(definition ~= nil, string.format("unknown performance metric %q", tostring(metricId)))
    return definition
end

function PerformanceBudget.isValidMetric(value: any): boolean
    return type(value) == "string" and DEFINITIONS[value] ~= nil
end

-- Where a single sample falls against its budget. Used for live warnings while
-- a run is in progress; the verdict that closes the gate comes from summarize.
function PerformanceBudget.classify(metricId: string, value: number): Verdict
    local definition = PerformanceBudget.definition(metricId)
    if not finite(value) then
        return "incomplete"
    end
    if definition.direction == "higher_is_better" then
        if value >= definition.target then
            return "ok"
        elseif value >= definition.hard then
            return "watch"
        end
        return "breach"
    end
    if value <= definition.target then
        return "ok"
    elseif value <= definition.hard then
        return "watch"
    end
    return "breach"
end

function PerformanceBudget.percentile(sorted: { number }, percentile: number): number
    local count = #sorted
    assert(count > 0, "percentile needs at least one sample")
    if count == 1 then
        return sorted[1]
    end
    local rank = (percentile / 100) * (count - 1) + 1
    local low = math.floor(rank)
    local high = math.ceil(rank)
    if low == high then
        return sorted[low]
    end
    return sorted[low] + (sorted[high] - sorted[low]) * (rank - low)
end

function PerformanceBudget.summarize(metricId: string, samples: { number }): Summary?
    local definition = PerformanceBudget.definition(metricId)

    -- A NaN would sort unpredictably and an infinity would swallow the tail,
    -- so garbage is counted and dropped rather than allowed to decide a gate.
    local clean = {}
    local discarded = 0
    for _, sample in samples do
        if finite(sample) then
            table.insert(clean, sample)
        else
            discarded += 1
        end
    end
    if #clean == 0 then
        return nil
    end
    table.sort(clean)

    local total = 0
    for _, sample in clean do
        total += sample
    end
    local value = PerformanceBudget.percentile(clean, definition.percentile)

    return {
        id = metricId,
        count = #clean,
        discarded = discarded,
        min = clean[1],
        max = clean[#clean],
        mean = total / #clean,
        p50 = PerformanceBudget.percentile(clean, 50),
        value = value,
        verdict = PerformanceBudget.classify(metricId, value),
    }
end

--[[
    Roll every metric into one verdict.

    A metric with no samples lands in `missing` and forces the report to
    `incomplete`, which outranks `watch` deliberately: a budget nobody measured
    is a worse position to close a milestone from than one measured and found
    merely close to the line.
]]
function PerformanceBudget.report(samplesByMetric: { [string]: { number } }): Report
    local metrics: { Summary } = {}
    local missing: { string } = {}
    local worst = "ok"

    for _, metricId in ORDER do
        local samples = samplesByMetric[metricId]
        local summary = if samples == nil
            then nil
            else PerformanceBudget.summarize(metricId, samples)
        if summary == nil then
            table.insert(missing, metricId)
        else
            table.insert(metrics, summary)
            if SEVERITY[summary.verdict] > SEVERITY[worst] then
                worst = summary.verdict
            end
        end
    end

    if #missing > 0 and SEVERITY.incomplete > SEVERITY[worst] then
        worst = "incomplete"
    end

    return {
        verdict = worst :: Verdict,
        metrics = metrics,
        missing = missing,
    }
end

-- One line per metric, in the order the architecture doc lists them, for the
-- admin readout at the end of a run.
function PerformanceBudget.format(report: Report): { string }
    local lines = {}
    for _, summary in report.metrics do
        local definition = PerformanceBudget.definition(summary.id)
        table.insert(
            lines,
            string.format(
                "%s %s: p%d %.1f%s (target %.1f, hard %.1f, n=%d)",
                string.upper(summary.verdict),
                definition.label,
                definition.percentile,
                summary.value,
                definition.unit,
                definition.target,
                definition.hard,
                summary.count
            )
        )
    end
    for _, metricId in report.missing do
        table.insert(
            lines,
            string.format("INCOMPLETE %s: no samples", PerformanceBudget.definition(metricId).label)
        )
    end
    return lines
end

--[[
    Validate a client's self-reported frame and memory sample.

    Client-reported numbers are diagnostic and never authoritative: nothing
    here grants a player anything, so a lying client only corrupts its own row
    in the report. That is still worth refusing rather than clamping -- a
    rejected sample is visible in the discard count, while a clamped one turns
    into a plausible-looking data point that quietly moves a percentile.

    Returns nil for anything malformed or outside the range a real device can
    physically produce.
]]
function PerformanceBudget.sanitizeClientReport(payload: any): any
    if type(payload) ~= "table" or payload.schemaVersion ~= 1 then
        return nil
    end

    local fps = payload.fps
    local spikeMs = payload.spikeMs
    local memoryMb = payload.memoryMb
    if not finite(fps) or not finite(spikeMs) or not finite(memoryMb) then
        return nil
    end

    -- No device renders a thousand frames a second, stalls for a minute and
    -- keeps running, or addresses 32 GB from a Roblox client.
    if fps <= 0 or fps > 1000 then
        return nil
    end
    if spikeMs < 0 or spikeMs > 60000 then
        return nil
    end
    if memoryMb <= 0 or memoryMb > 32768 then
        return nil
    end

    -- Named rather than counted. A count was enough while the payload had four
    -- fields and a fifth was by definition smuggled; adding the platform label
    -- would have made room for one extra field of a client's choosing, which is
    -- the one-extra-field rule failing in the direction it was written against.
    for key in payload do
        if
            key ~= "schemaVersion"
            and key ~= "fps"
            and key ~= "spikeMs"
            and key ~= "memoryMb"
            and key ~= "platform"
        then
            return nil
        end
    end

    return {
        fps = fps,
        spikeMs = spikeMs,
        memoryMb = memoryMb,
    }
end

-- Memory headroom as a fraction of the baseline device's ceiling. Clamped to
-- zero rather than going negative: a client over the ceiling is at zero
-- headroom, and how far over tells the gate nothing it does not already know.
function PerformanceBudget.memoryHeadroom(memoryMb: number, ceilingMb: number): number
    assert(finite(ceilingMb) and ceilingMb > 0, "memory ceiling must be positive")
    if not finite(memoryMb) or memoryMb < 0 then
        return 0 / 0
    end
    return math.max(0, 1 - memoryMb / ceilingMb)
end

return table.freeze(PerformanceBudget)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">PrivateServerControls</string>
          <string name="Source"><![CDATA[--!strict

--[[
    What the owner of a private server may do to it, and what it costs.

    Milestone 11's deliverable list names "private-server controls", and
    MONETIZATION_LIVEOPS_ANALYTICS describes them as phase pause in non-reward
    practice, seed selection among already-discovered seeds, and cinematic
    tools -- with one sentence attached that decides this entire module:
    **reward-bearing modifiers remain server-defined.**

    There are two ways to keep that promise. The usual way is to sort the
    controls into the ones that touch rewards and the ones that do not, and
    trust the sorting. That sorting is a judgement call made once, by whoever
    adds the fifth control, about a system they are not thinking about; this
    project has a written history of exactly that shape going wrong quietly.

    So this module does not sort. **Every control forces practice, and practice
    is a one-way latch on the whole server.** The argument is short enough to
    hold in one line: a control that changes nothing about the world does not
    need a private server to house it, and a control that changes the world
    changes the run. Hiding your own HUD is not a private-server privilege --
    it is a HUD feature, and it belongs on the HUD. What is left, once that is
    taken out, is a list where every entry is reward-bearing, and the honest
    answer to a reward-bearing modifier is that this run no longer pays.

    That makes the exit-gate line ("no private-server setting changes a
    reward") true structurally rather than by inspection: there is no reward
    left for a setting to change. `apply` sets `practice` on every accepted
    change with no per-control branch, so a control added tomorrow is latched
    by the same line as the four here, and the spec drives the whole catalog
    through it rather than holding a case per entry.

    The latch never lifts. A practice server that could go back to paying
    would let somebody hold the clock, arrange a night, release it and bank --
    which is the modifier the promise is about, arrived at in two presses. It
    lifts when the server restarts, which is a real act with a real cost.

    Nothing here is a purchase. Authority is a property of the *server* --
    Roblox's own `PrivateServerOwnerId` -- and not an entitlement of the
    player, which is what keeps it outside the monetization guard's reach: no
    gameplay branch reads what anybody owns. If this ever becomes a paid pass,
    the entitlement resolves outside gameplay into plain profile data like
    every other one, and this file still asks the same question.
]]

local PrivateServerControls = {}

export type Control = {
    id: string,
    label: string,
    -- The state key a toggle latches, or nil for a control that happens once
    -- and remembers nothing.
    field: string?,
    kind: string,
    -- Why this one is a practice control, said per entry rather than in one
    -- paragraph, because the four reasons are genuinely different and the
    -- fifth author needs to be able to tell whether theirs is one of them.
    why: string,
}

export type State = {
    practice: boolean,
    hold: boolean,
    still: boolean,
    seedIndex: number,
}

export type Server = {
    privateServerId: string,
    privateServerOwnerId: number,
}

export type Seed = {
    regionId: string,
    seed: number,
}

export type Result = {
    ok: boolean,
    state: State,
    -- What the server should do once, now, beyond storing the state. A
    -- momentary control has no state to store, so an effect is the only trace
    -- it leaves.
    effect: string?,
    reason: string,
}

local CONTROLS: { Control } = {
    {
        id = "hold_clock",
        label = "HOLD THE CLOCK",
        field = "hold",
        kind = "toggle",
        why = "A clock you can stop is a night you can wait out.",
    },
    {
        id = "call_phase",
        label = "CALL THE NEXT PHASE",
        field = nil,
        kind = "moment",
        why = "Skipping to night is choosing which night you fight.",
    },
    {
        id = "still_dark",
        label = "STILL THE DARK",
        field = "still",
        kind = "toggle",
        why = "Creatures that hold still are creatures that are not fighting back.",
    },
    {
        id = "choose_seed",
        label = "CHOOSE A SEED",
        field = "seed",
        kind = "seed",
        why = "A seed you choose is a drop table you chose.",
    },
}

local CONTROL_BY_ID: { [string]: Control } = {}
for _, control in CONTROLS do
    assert(CONTROL_BY_ID[control.id] == nil, "duplicate private server control: " .. control.id)
    CONTROL_BY_ID[control.id] = control
end

table.freeze(CONTROLS)
table.freeze(CONTROL_BY_ID)

function PrivateServerControls.controls(): { Control }
    return CONTROLS
end

function PrivateServerControls.byId(controlId: any): Control?
    if type(controlId) ~= "string" then
        return nil
    end
    return CONTROL_BY_ID[controlId]
end

function PrivateServerControls.default(): State
    return {
        practice = false,
        hold = false,
        still = false,
        -- 0 is the server's own roll, which is what every ordinary server
        -- runs. A chosen seed is 1..#seeds into the player's own history.
        seedIndex = 0,
    }
end

function PrivateServerControls.normalize(value: any): State
    local state = PrivateServerControls.default()
    if type(value) ~= "table" then
        return state
    end
    state.practice = value.practice == true
    state.hold = value.hold == true
    state.still = value.still == true
    local index = tonumber(value.seedIndex)
    if type(index) == "number" and index == index and index >= 0 then
        state.seedIndex = math.floor(index)
    end
    return state
end

--[[
    Who may work these controls.

    Three refusals rather than one, because they mean different things to the
    person pressing and only one of them is about them.

    A **reserved** server is the interesting case. `PartyService` launches every
    expedition into one, and Roblox reports a reserved server with a non-empty
    `PrivateServerId` and an owner of zero -- so the naive test ("is this a
    private server") is true of every run this game has ever launched. Treating
    a party's run world as a private town would put a clock-holding, dark-
    stilling control rail inside the reward-bearing half of the game, which is
    precisely the thing the promise forbids. Nobody bought a reserved server, so
    nobody sets it.
]]
function PrivateServerControls.authority(server: any, actorUserId: any): (boolean, string)
    if type(server) ~= "table" then
        return false, "not_private_server"
    end
    local id = server.privateServerId
    if type(id) ~= "string" or id == "" then
        return false, "not_private_server"
    end
    local ownerId = tonumber(server.privateServerOwnerId) or 0
    if ownerId <= 0 then
        return false, "reserved_server"
    end
    if tonumber(actorUserId) ~= ownerId then
        return false, "not_server_owner"
    end
    return true, "owner"
end

local REFUSALS: { [string]: string } = {
    not_private_server = "THESE CONTROLS ONLY ANSWER IN A PRIVATE SERVER",
    reserved_server = "AN EXPEDITION WORLD HAS NO OWNER TO SET THEM",
    not_server_owner = "ONLY THIS SERVER'S OWNER WORKS THE RAIL",
    unknown_control = "NOTHING IS WRITTEN ON THAT BOARD",
    no_seeds_discovered = "YOU HAVE NOT WALKED A SEED WORTH KEEPING YET",
}

function PrivateServerControls.refusal(reason: any): string
    return REFUSALS[reason] or "THE RAIL DID NOT ANSWER"
end

--[[
    Press a board.

    `seeds` is the presser's own discovered-seed history, newest first, and it
    is the only thing seed selection may reach: a seed the player has already
    walked unlocks no region, reveals no layout they have not seen, and cannot
    name a place the generator would otherwise have refused them. Selection
    cycles rather than naming an index, so the payload carries nothing and the
    board cannot be asked for the fortieth seed of a history that holds four.
]]
function PrivateServerControls.apply(state: any, controlId: any, seeds: any): Result
    local current = PrivateServerControls.normalize(state)
    local control = PrivateServerControls.byId(controlId)
    if control == nil then
        return { ok = false, state = current, effect = nil, reason = "unknown_control" }
    end

    local next_: State = {
        practice = current.practice,
        hold = current.hold,
        still = current.still,
        seedIndex = current.seedIndex,
    }
    local effect: string? = nil

    if control.kind == "toggle" then
        -- Named rather than written as a parenthesised cast on its own line:
        -- a statement that begins with `(` is the one shape Luau's parser has
        -- to guess at, and a guess that happens to be right today is not a
        -- thing to leave in a file somebody will edit.
        local field = control.field :: string
        local mutable = next_ :: any
        mutable[field] = not (current :: any)[field]
    elseif control.kind == "moment" then
        effect = control.id
    elseif control.kind == "seed" then
        local history = if type(seeds) == "table" then seeds else {}
        if #history == 0 then
            return { ok = false, state = current, effect = nil, reason = "no_seeds_discovered" }
        end
        local index = current.seedIndex + 1
        if index > #history then
            index = 0
        end
        next_.seedIndex = index
    end

    --[[
        The one line the whole module is about, and it has no branch in it on
        purpose. Every accepted press latches practice; nothing anywhere clears
        it. A per-control exemption would be one `if` away from existing, and
        the author of the fifth control is exactly the person who would write
        it, in the commit where it looked harmless.
    ]]
    next_.practice = true
    return { ok = true, state = next_, effect = effect, reason = "applied" }
end

function PrivateServerControls.rewardsAllowed(state: any): boolean
    return not PrivateServerControls.normalize(state).practice
end

-- The seed this state has chosen out of a history, or nil for the server's own
-- roll. An index past the end of a shortened history reads as nil rather than
-- as the last entry: a history that lost its tail should stop choosing, not
-- silently choose something else.
function PrivateServerControls.chosenSeed(state: any, seeds: any): Seed?
    local current = PrivateServerControls.normalize(state)
    if current.seedIndex <= 0 or type(seeds) ~= "table" then
        return nil
    end
    local entry = seeds[current.seedIndex]
    if type(entry) ~= "table" then
        return nil
    end
    local seed = tonumber(entry.seed)
    if type(entry.regionId) ~= "string" or seed == nil then
        return nil
    end
    return { regionId = entry.regionId, seed = seed }
end

-- What a board reads once its control has been worked, so the rail says the
-- state of the world rather than only the name of the lever.
function PrivateServerControls.readout(state: any, controlId: any, seeds: any): string
    local control = PrivateServerControls.byId(controlId)
    if control == nil then
        return ""
    end
    local current = PrivateServerControls.normalize(state)
    if control.kind == "toggle" then
        return if (current :: any)[control.field :: string] then "ON" else "OFF"
    elseif control.kind == "seed" then
        local chosen = PrivateServerControls.chosenSeed(current, seeds)
        if chosen == nil then
            return "THIS SERVER'S OWN"
        end
        -- The catalog's id with its namespace taken off. Read live, the raw
        -- form came back as THE WOOD IS REGION_BRAMBLEWAKE · 32693, which is
        -- a database key shouted at a player standing in front of a plank.
        local name = string.gsub(chosen.regionId, "^region_", "")
        return string.format("%s · %d", string.upper(name), chosen.seed)
    end
    return "READY"
end

return table.freeze(PrivateServerControls)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">ProfessionAbilityVisuals</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionAbilityVisuals = {}

export type Definition = {
    professionId: string,
    motif: string,
    color: { number },
    accent: { number },
    pulseLifetime: number,
    minimumRadius: number,
}

local DEFINITIONS: { [string]: Definition } = {
    profession_scout = table.freeze({
        professionId = "profession_scout",
        motif = "foxfire_compass",
        color = table.freeze({ 94, 206, 176 }),
        accent = table.freeze({ 218, 247, 205 }),
        pulseLifetime = 1.35,
        minimumRadius = 9,
    }),
    profession_warden = table.freeze({
        professionId = "profession_warden",
        motif = "root_ward",
        color = table.freeze({ 112, 151, 119 }),
        accent = table.freeze({ 244, 230, 197 }),
        pulseLifetime = 1.1,
        minimumRadius = 8,
    }),
    profession_engineer = table.freeze({
        professionId = "profession_engineer",
        motif = "rootline_gear",
        color = table.freeze({ 191, 137, 73 }),
        accent = table.freeze({ 255, 206, 112 }),
        pulseLifetime = 1.25,
        minimumRadius = 10,
    }),
    profession_medic = table.freeze({
        professionId = "profession_medic",
        motif = "brightcap_bloom",
        color = table.freeze({ 176, 108, 112 }),
        accent = table.freeze({ 214, 238, 190 }),
        pulseLifetime = 1.4,
        minimumRadius = 10,
    }),
    profession_alchemist = table.freeze({
        professionId = "profession_alchemist",
        motif = "tonic_bloom",
        color = table.freeze({ 154, 187, 92 }),
        accent = table.freeze({ 226, 247, 180 }),
        pulseLifetime = 1.3,
        minimumRadius = 10,
    }),
    profession_beastkeeper = table.freeze({
        professionId = "profession_beastkeeper",
        motif = "hound_dash",
        color = table.freeze({ 196, 120, 60 }),
        accent = table.freeze({ 246, 214, 165 }),
        pulseLifetime = 1.2,
        minimumRadius = 9,
    }),
    profession_runebinder = table.freeze({
        professionId = "profession_runebinder",
        motif = "still_rune",
        color = table.freeze({ 132, 150, 224 }),
        accent = table.freeze({ 214, 226, 255 }),
        pulseLifetime = 1.5,
        minimumRadius = 9,
    }),
}

function ProfessionAbilityVisuals.get(professionId: any): Definition?
    return if type(professionId) == "string" then DEFINITIONS[professionId] else nil
end

function ProfessionAbilityVisuals.list(): { Definition }
    local result = {}
    for _, definition in DEFINITIONS do
        table.insert(result, definition)
    end
    table.sort(result, function(a, b)
        return a.professionId < b.professionId
    end)
    return result
end

return table.freeze(ProfessionAbilityVisuals)
]]></string>
        </Properties>
