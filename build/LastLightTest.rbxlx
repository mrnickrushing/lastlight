Consumables.Order = ORDER
--[[
    Six effect kinds, and every one of them answers something this game
    already does to a player. Stamina and a shield and a party heal were
    the first three. The other three exist because the spark thieves take
    the lantern, the drowsy strikers take your footing, and gear wears out
    a long way from the only bench that could fix it -- three threats the
    game had been making with no answer a player could carry.
]]
Consumables.EffectKinds = table.freeze({
    "restore_stamina",
    "shield",
    "heal_party",
    "restore_lantern",
    "cure_status",
    "repair_gear",
})

function Consumables.get(itemId: any): Consumable?
    return if type(itemId) == "string" then DEFINITIONS[itemId] else nil
end

function Consumables.isKnown(itemId: any): boolean
    return Consumables.get(itemId) ~= nil
end

function Consumables.list(): { Consumable }
    local result: { Consumable } = {}
    for _, itemId in ORDER do
        table.insert(result, DEFINITIONS[itemId])
    end
    return result
end

return table.freeze(Consumables)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Content</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">ContentId</string>
            <string name="Source"><![CDATA[--!strict

local ContentId = {}

local MIN_LENGTH = 3
local MAX_LENGTH = 64

function ContentId.kind(value: string): string?
    return string.match(value, "^([a-z][a-z0-9]*)_")
end

function ContentId.validate(value: any, expectedKind: string?): (boolean, string?)
    if type(value) ~= "string" then
        return false, "content ID must be a string"
    end

    if #value < MIN_LENGTH or #value > MAX_LENGTH then
        return false,
            string.format("content ID length must be %d-%d characters", MIN_LENGTH, MAX_LENGTH)
    end

    if
        string.match(value, "^[a-z][a-z0-9_]*$") == nil
        or not string.find(value, "_", 1, true)
        or string.find(value, "__", 1, true) ~= nil
        or string.sub(value, -1) == "_"
    then
        return false, "content ID must be lowercase snake case with a type prefix"
    end

    local kind = ContentId.kind(value)
    if expectedKind ~= nil and kind ~= expectedKind then
        return false, string.format("content ID must use the %s_ prefix", expectedKind)
    end

    return true, nil
end

return table.freeze(ContentId)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="25">
          <Properties>
            <string name="Name">Definitions</string>
          </Properties>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">BramblewakeExpedition</string>
              <string name="Source"><![CDATA[--!strict

local function frozenDefinition(definition: any): any
    local copy = table.clone(definition)
    if copy.enabled == nil then
        copy.enabled = true
    end
    if string.sub(copy.id, 1, 7) == "module_" and copy.defaultTraversal == nil then
        copy.defaultTraversal = true
    end
    if copy.tags ~= nil then
        copy.tags = table.freeze(table.clone(copy.tags))
    end
    for _, key in { "startConditions", "incompatibleEvents" } do
        if copy[key] ~= nil then
            copy[key] = table.freeze(table.clone(copy[key]))
        end
    end
    if copy.reward ~= nil then
        copy.reward = table.freeze(table.clone(copy.reward))
    end
    if copy.soloVariant ~= nil then
        copy.soloVariant = table.freeze(table.clone(copy.soloVariant))
    end
    if copy.storyOffset ~= nil then
        copy.storyOffset = table.freeze(table.clone(copy.storyOffset))
    end
    if copy.groupVariant ~= nil then
        copy.groupVariant = table.freeze(table.clone(copy.groupVariant))
    end
    if copy.steps ~= nil then
        local steps: { any } = {}
        for _, step in copy.steps do
            local stepCopy: any = table.clone(step :: any)
            if stepCopy.offset ~= nil then
                stepCopy.offset = table.freeze(table.clone(stepCopy.offset))
            end
            table.insert(steps, table.freeze(stepCopy))
        end
        copy.steps = table.freeze(steps)
    end
    return table.freeze(copy)
end

