<roblox version="4">
  <Item class="AssetService" referent="0">
    <Properties>
      <string name="Name">AssetService</string>
      <bool name="AllowInsertFreeAssets">true</bool>
    </Properties>
  </Item>
  <Item class="ReplicatedFirst" referent="1">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
    <Item class="LocalScript" referent="2">
      <Properties>
        <string name="Name">LoadingController</string>
        <string name="Source"><![CDATA[--!strict

--[[
    Last Light title and loading screen.

    Runs from ReplicatedFirst, before the world exists, so it owns nothing but
    its own ScreenGui and builds every element from primitives -- no asset can
    fail to load here and leave a player staring at a blank screen.

    Two rules shape the whole file:

      * The PLAY button must always become reachable. Every wait below is
        bounded, and when a stage times out the screen says so and lets the
        player in anyway. A player must never be trapped behind this screen.
      * Progress is reported, not invented. The bar advances on real
        milestones (runtime replicated, client content loaded, world ready)
        and only creeps within the stage it has actually reached, so it stays
        honest while still never appearing frozen.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

ReplicatedFirst:RemoveDefaultLoadingScreen()

-- Same palette the world is built from, so the title screen and the first
-- thing the player sees when it lifts belong to one game.
local NIGHT_HIGH = Color3.fromRGB(24, 33, 46)
local NIGHT_LOW = Color3.fromRGB(7, 10, 16)
local HORIZON = Color3.fromRGB(46, 62, 68)
local TREE_FAR = Color3.fromRGB(21, 31, 38)
local TREE_MID = Color3.fromRGB(13, 20, 26)
local TREE_NEAR = Color3.fromRGB(7, 11, 15)
local GROUND = Color3.fromRGB(9, 13, 16)
local AMBER = Color3.fromRGB(255, 181, 76)
local AMBER_PALE = Color3.fromRGB(255, 221, 154)
local AMBER_DEEP = Color3.fromRGB(198, 118, 40)
local FOXFIRE = Color3.fromRGB(94, 206, 176)
local CREAM = Color3.fromRGB(244, 230, 197)
local MUTED = Color3.fromRGB(139, 158, 150)
local IRON = Color3.fromRGB(38, 42, 46)

local STAGE_CONNECT = "REACHING EMBERHOLLOW"
local STAGE_CONTENT = "GATHERING THE DARK"
local STAGE_WORLD = "RAISING THE FIRST LANTERN"
local STAGE_READY = "THE LANTERN IS LIT"
local STAGE_SLOW = "THE FOREST IS SLOW TONIGHT"

-- Bounded because a stall must degrade into a playable game, never a lock.
local RUNTIME_TIMEOUT = 10
local TOTAL_TIMEOUT = 22

local reducedMotion = (GuiService :: any).ReducedMotionEnabled == true

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui", 10)
if playerGui == nil then
    return
end

local gui = Instance.new("ScreenGui")
gui.Name = "LastLightLoading"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 1000
gui.Parent = playerGui

local function newFrame(parent: Instance, name: string, zIndex: number): Frame
    local instance = Instance.new("Frame")
    instance.Name = name
    instance.BackgroundColor3 = NIGHT_LOW
    instance.BorderSizePixel = 0
    instance.ZIndex = zIndex
    instance.Parent = parent
    return instance
end

local function round(instance: GuiObject, radius: number)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = instance
end

local function newText(
    parent: Instance,
    name: string,
    font: Enum.Font,
    color: Color3,
    zIndex: number
): TextLabel
    local label = Instance.new("TextLabel")
    label.Name = name
    label.BackgroundTransparency = 1
    label.Font = font
    label.TextColor3 = color
    label.ZIndex = zIndex
    label.Parent = parent
    return label
end

local backdrop = newFrame(gui, "Backdrop", 1)
backdrop.Size = UDim2.fromScale(1, 1)
--[[
    The title screen swallows input until it is dismissed. Without this a
    tap anywhere on it fell through to the world behind it -- a full
    tutorial was once played to the survive stage entirely through this
    screen without anybody pressing PLAY, every objective triggered by
    taps the player believed were landing on a menu.
]]
backdrop.Active = true
local skyGradient = Instance.new("UIGradient")
skyGradient.Rotation = 90
skyGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, NIGHT_HIGH),
    ColorSequenceKeypoint.new(0.62, NIGHT_LOW),
    ColorSequenceKeypoint.new(1, NIGHT_LOW),
})
skyGradient.Parent = backdrop

-- A low warm bloom on the horizon: the town the player is about to reach.
local horizonGlow = newFrame(backdrop, "HorizonGlow", 2)
horizonGlow.AnchorPoint = Vector2.new(0.5, 1)
horizonGlow.Position = UDim2.fromScale(0.5, 0.72)
horizonGlow.Size = UDim2.new(1.4, 0, 0, 260)
horizonGlow.BackgroundColor3 = HORIZON
horizonGlow.BackgroundTransparency = 0.55
local horizonGradient = Instance.new("UIGradient")
horizonGradient.Rotation = 90
horizonGradient.Transparency = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 1),
    NumberSequenceKeypoint.new(1, 0.25),
})
horizonGradient.Parent = horizonGlow

--[[
    A conifer built from three stacked diamonds. Roblox UI has no triangle, but
    a square rotated 45 degrees is one, and three of them overlapping in
    decreasing size give the layered pine silhouette the world's treeline uses.
    Their lower halves are covered by the ground band, so they read as trees
    standing on the horizon rather than as floating shapes.
]]
local function conifer(
    parent: Instance,
    positionX: number,
    baseY: number,
    width: number,
    color: Color3,
    zIndex: number
)
    local tiers = 3
    for tier = 1, tiers do
        local scale = 1 - (tier - 1) * 0.24
        local side = width * scale
        local diamond = newFrame(parent, "Conifer", zIndex)
        diamond.AnchorPoint = Vector2.new(0.5, 0.5)
        diamond.Position = UDim2.new(positionX, 0, baseY, -(tier - 1) * width * 0.46)
        diamond.Size = UDim2.fromOffset(side, side)
        diamond.BackgroundColor3 = color
        diamond.Rotation = 45
    end
    local trunk = newFrame(parent, "ConiferTrunk", zIndex)
    trunk.AnchorPoint = Vector2.new(0.5, 0)
    trunk.Position = UDim2.fromScale(positionX, baseY)
    trunk.Size = UDim2.fromOffset(math.max(3, width * 0.1), width * 0.5)
    trunk.BackgroundColor3 = color
end

-- Three depth layers. Far trees are smaller, lighter and lower-contrast; near
-- trees are large and nearly black, which is what sells the distance.
local farLine = newFrame(backdrop, "TreelineFar", 3)
farLine.BackgroundTransparency = 1
farLine.Size = UDim2.fromScale(1, 1)
for index = 0, 15 do
    local seedX = -0.02 + index * 0.069
    local jitter = ((index * 37) % 11) / 11
    conifer(farLine, seedX, 0.7, 54 + jitter * 26, TREE_FAR, 3)
end

local midLine = newFrame(backdrop, "TreelineMid", 4)
midLine.BackgroundTransparency = 1
midLine.Size = UDim2.fromScale(1, 1)
for index = 0, 11 do
    local seedX = -0.04 + index * 0.095
    local jitter = ((index * 53) % 13) / 13
    conifer(midLine, seedX, 0.79, 84 + jitter * 40, TREE_MID, 4)
end

local nearLine = newFrame(backdrop, "TreelineNear", 5)
nearLine.BackgroundTransparency = 1
nearLine.Size = UDim2.fromScale(1, 1)
for index = 0, 7 do
    local seedX = -0.06 + index * 0.16
    local jitter = ((index * 29) % 7) / 7
    conifer(nearLine, seedX, 0.93, 128 + jitter * 62, TREE_NEAR, 5)
end

local ground = newFrame(backdrop, "Ground", 6)
ground.AnchorPoint = Vector2.new(0.5, 0)
ground.Position = UDim2.fromScale(0.5, 0.86)
ground.Size = UDim2.fromScale(1, 0.2)
ground.BackgroundColor3 = GROUND

-- Drifting foxfire and embers. Motion is the only thing telling the player the
-- screen is alive during a long load, so it keeps running even when progress
-- does not -- unless the player has asked for reduced motion.
type Mote = {
    frame: Frame,
    x: number,
    y: number,
    rise: number,
    drift: number,
    phase: number,
}

local motes: { Mote } = {}
if not reducedMotion then
    for index = 1, 26 do
        local ember = index % 3 == 0
        local size = if ember then 3 else 2 + (index % 3)
        local dot = newFrame(backdrop, "Mote", 7)
        dot.AnchorPoint = Vector2.new(0.5, 0.5)
        dot.Size = UDim2.fromOffset(size, size)
        dot.BackgroundColor3 = if ember then AMBER else FOXFIRE
        dot.BackgroundTransparency = 0.3 + (index % 5) * 0.1
        round(dot, size)
        table.insert(motes, {
            frame = dot,
            x = ((index * 73) % 100) / 100,
            y = ((index * 41) % 100) / 100,
            rise = 0.012 + ((index * 17) % 10) / 800,
            drift = 0.006 + ((index * 23) % 8) / 1200,
            phase = ((index * 31) % 100) / 100 * math.pi * 2,
        })
    end
end

-- The First Lantern: the game's own icon, and the object the whole opening
-- sequence is about. Built in layers -- halo, cage, glass, flame -- so it reads
-- as a made object rather than a glowing circle.
local lantern = newFrame(backdrop, "FirstLantern", 8)
lantern.BackgroundTransparency = 1
lantern.AnchorPoint = Vector2.new(0.5, 0.5)
lantern.Position = UDim2.fromScale(0.5, 0.3)
lantern.Size = UDim2.fromOffset(260, 260)

local halo = newFrame(lantern, "Halo", 8)
halo.AnchorPoint = Vector2.new(0.5, 0.5)
halo.Position = UDim2.fromScale(0.5, 0.5)
halo.Size = UDim2.fromOffset(230, 230)
halo.BackgroundColor3 = AMBER
halo.BackgroundTransparency = 0.9
round(halo, 999)

local haloInner = newFrame(lantern, "HaloInner", 9)
haloInner.AnchorPoint = Vector2.new(0.5, 0.5)
haloInner.Position = UDim2.fromScale(0.5, 0.5)
haloInner.Size = UDim2.fromOffset(140, 140)
haloInner.BackgroundColor3 = AMBER
haloInner.BackgroundTransparency = 0.82
round(haloInner, 999)

local hook = newFrame(lantern, "LanternHook", 10)
hook.AnchorPoint = Vector2.new(0.5, 0.5)
hook.Position = UDim2.new(0.5, 0, 0.5, -74)
hook.Size = UDim2.fromOffset(22, 22)
hook.BackgroundTransparency = 1
round(hook, 999)
local hookStroke = Instance.new("UIStroke")
hookStroke.Color = IRON
hookStroke.Thickness = 4
hookStroke.Parent = hook

local cap = newFrame(lantern, "LanternCap", 11)
cap.AnchorPoint = Vector2.new(0.5, 0.5)
cap.Position = UDim2.new(0.5, 0, 0.5, -54)
cap.Size = UDim2.fromOffset(78, 16)
cap.BackgroundColor3 = IRON
round(cap, 4)

local glass = newFrame(lantern, "LanternGlass", 10)
glass.AnchorPoint = Vector2.new(0.5, 0.5)
glass.Position = UDim2.fromScale(0.5, 0.5)
glass.Size = UDim2.fromOffset(58, 84)
glass.BackgroundColor3 = AMBER_PALE
glass.BackgroundTransparency = 0.45
round(glass, 6)
local glassGradient = Instance.new("UIGradient")
glassGradient.Rotation = 90
glassGradient.Transparency = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0.55),
    NumberSequenceKeypoint.new(1, 0),
})
glassGradient.Parent = glass

for postSide = -1, 1, 2 do
    local post = newFrame(lantern, "LanternPost", 12)
    post.AnchorPoint = Vector2.new(0.5, 0.5)
    post.Position = UDim2.new(0.5, postSide * 29, 0.5, 0)
    post.Size = UDim2.fromOffset(7, 92)
    post.BackgroundColor3 = IRON
    round(post, 2)
end

local flame = newFrame(lantern, "LanternFlame", 13)
flame.AnchorPoint = Vector2.new(0.5, 1)
flame.Position = UDim2.new(0.5, 0, 0.5, 26)
flame.Size = UDim2.fromOffset(18, 34)
flame.BackgroundColor3 = AMBER_PALE
round(flame, 999)

local base = newFrame(lantern, "LanternBase", 12)
base.AnchorPoint = Vector2.new(0.5, 0.5)
base.Position = UDim2.new(0.5, 0, 0.5, 50)
base.Size = UDim2.fromOffset(86, 14)
base.BackgroundColor3 = IRON
round(base, 4)

local title = newText(backdrop, "Title", Enum.Font.GothamBlack, CREAM, 14)
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.fromScale(0.5, 0.52)
title.Size = UDim2.new(0.9, 0, 0, 72)
title.Text = "LAST LIGHT"
title.TextScaled = true
local titleSize = Instance.new("UITextSizeConstraint")
titleSize.MinTextSize = 30
titleSize.MaxTextSize = 66
titleSize.Parent = title
local titleGradient = Instance.new("UIGradient")
titleGradient.Rotation = 90
titleGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, CREAM),
    ColorSequenceKeypoint.new(1, AMBER),
})
titleGradient.Parent = title

local rule = newFrame(backdrop, "TitleRule", 14)
rule.AnchorPoint = Vector2.new(0.5, 0.5)
rule.Position = UDim2.fromScale(0.5, 0.585)
rule.Size = UDim2.new(0.42, 0, 0, 1)
rule.BackgroundColor3 = AMBER
rule.BackgroundTransparency = 0.35
local ruleGradient = Instance.new("UIGradient")
ruleGradient.Transparency = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 1),
    NumberSequenceKeypoint.new(0.5, 0),
    NumberSequenceKeypoint.new(1, 1),
})
ruleGradient.Parent = rule

local tagline = newText(backdrop, "Tagline", Enum.Font.GothamMedium, MUTED, 14)
tagline.AnchorPoint = Vector2.new(0.5, 0.5)
tagline.Position = UDim2.fromScale(0.5, 0.632)
tagline.Size = UDim2.new(0.86, 0, 0, 22)
tagline.Text = "BUILD BY DAY · SURVIVE BY NIGHT · BRING EVERYONE HOME"
tagline.TextScaled = true
local taglineSize = Instance.new("UITextSizeConstraint")
taglineSize.MinTextSize = 9
taglineSize.MaxTextSize = 15
taglineSize.Parent = tagline

-- Progress and PLAY share one slot: the bar fills, then hands the space over to
-- the button. Nothing jumps around and the eye stays in one place.
local progressPanel = newFrame(backdrop, "ProgressPanel", 15)
progressPanel.BackgroundTransparency = 1
progressPanel.AnchorPoint = Vector2.new(0.5, 0.5)
progressPanel.Position = UDim2.fromScale(0.5, 0.77)
progressPanel.Size = UDim2.new(0.62, 0, 0, 64)
local panelWidth = Instance.new("UISizeConstraint")
panelWidth.MaxSize = Vector2.new(460, math.huge)
panelWidth.MinSize = Vector2.new(220, 0)
panelWidth.Parent = progressPanel

local stageLabel = newText(progressPanel, "Stage", Enum.Font.GothamBold, MUTED, 16)
stageLabel.AnchorPoint = Vector2.new(0, 1)
stageLabel.Position = UDim2.fromOffset(0, 22)
stageLabel.Size = UDim2.new(0.74, 0, 0, 16)
stageLabel.Text = STAGE_CONNECT
stageLabel.TextXAlignment = Enum.TextXAlignment.Left
stageLabel.TextSize = 12

local percentLabel = newText(progressPanel, "Percent", Enum.Font.GothamBold, AMBER, 16)
percentLabel.AnchorPoint = Vector2.new(1, 1)
percentLabel.Position = UDim2.new(1, 0, 0, 22)
percentLabel.Size = UDim2.new(0.24, 0, 0, 16)
percentLabel.Text = "0%"
percentLabel.TextXAlignment = Enum.TextXAlignment.Right
percentLabel.TextSize = 12

local track = newFrame(progressPanel, "Track", 16)
track.AnchorPoint = Vector2.new(0.5, 0)
track.Position = UDim2.new(0.5, 0, 0, 30)
track.Size = UDim2.new(1, 0, 0, 8)
track.BackgroundColor3 = Color3.fromRGB(23, 30, 34)
round(track, 4)
local trackStroke = Instance.new("UIStroke")
trackStroke.Color = Color3.fromRGB(46, 58, 62)
trackStroke.Thickness = 1
trackStroke.Transparency = 0.35
trackStroke.Parent = track

local fill = newFrame(track, "Fill", 17)
fill.Size = UDim2.fromScale(0, 1)
fill.BackgroundColor3 = AMBER
round(fill, 4)
local fillGradient = Instance.new("UIGradient")
fillGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, AMBER_DEEP),
    ColorSequenceKeypoint.new(1, AMBER_PALE),
})
fillGradient.Parent = fill

local fillHead = newFrame(track, "FillHead", 18)
fillHead.AnchorPoint = Vector2.new(0.5, 0.5)
fillHead.Position = UDim2.fromScale(0, 0.5)
fillHead.Size = UDim2.fromOffset(3, 14)
fillHead.BackgroundColor3 = AMBER_PALE
fillHead.BackgroundTransparency = 1
round(fillHead, 2)

local playButton = Instance.new("TextButton")
playButton.Name = "Play"
playButton.AnchorPoint = Vector2.new(0.5, 0.5)
playButton.Position = UDim2.fromScale(0.5, 0.5)
playButton.Size = UDim2.fromScale(0, 0)
playButton.BackgroundColor3 = AMBER
playButton.AutoButtonColor = false
playButton.Font = Enum.Font.GothamBlack
playButton.Text = "PLAY"
playButton.TextColor3 = Color3.fromRGB(24, 18, 8)
playButton.TextSize = 22
playButton.Visible = false
playButton.Selectable = true
playButton.ZIndex = 20
playButton.Parent = progressPanel
round(playButton, 10)
local playGradient = Instance.new("UIGradient")
playGradient.Rotation = 90
playGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, AMBER_PALE),
    ColorSequenceKeypoint.new(1, AMBER_DEEP),
})
playGradient.Parent = playButton
local playStroke = Instance.new("UIStroke")
playStroke.Color = AMBER_PALE
playStroke.Thickness = 2
playStroke.Transparency = 0.4
playStroke.Parent = playButton

local playHint = newText(backdrop, "PlayHint", Enum.Font.Gotham, MUTED, 15)
playHint.AnchorPoint = Vector2.new(0.5, 0.5)
playHint.Position = UDim2.fromScale(0.5, 0.855)
playHint.Size = UDim2.new(0.8, 0, 0, 16)
playHint.Text = ""
playHint.TextSize = 12

local hint = newText(backdrop, "Hint", Enum.Font.Gotham, Color3.fromRGB(97, 114, 107), 15)
hint.AnchorPoint = Vector2.new(0.5, 1)
hint.Position = UDim2.new(0.5, 0, 1, -26)
hint.Size = UDim2.new(0.84, 0, 0, 34)
hint.Text = "Only the nearby clearing loads first. The wider forest streams in as you travel."
hint.TextWrapped = true
hint.TextSize = 12

-- Progress model: `reached` is what completed milestones guarantee, `ceiling`
-- is the milestone being worked toward. The bar creeps toward the ceiling but
-- can never cross it until that milestone actually lands.
local MILESTONES = { 0.34, 0.62, 0.92, 1 }
local milestoneIndex = 1
local reached = 0
local ceiling = MILESTONES[1]
local displayed = 0
local target = 0
local readyToPlay = false
local finished = false
local elapsed = 0

local function advance()
    if milestoneIndex > #MILESTONES then
        return
    end
    reached = MILESTONES[milestoneIndex]
    milestoneIndex += 1
    ceiling = MILESTONES[math.min(milestoneIndex, #MILESTONES)]
    target = math.max(target, reached)
end

local connections: { RBXScriptConnection } = {}

local function teardown()
    for _, connection in connections do
        connection:Disconnect()
    end
    table.clear(connections)
end

local function enablePlay(message: string)
    if readyToPlay then
        return
    end
    readyToPlay = true
    stageLabel.Text = message
    playHint.Text = if UserInputService.TouchEnabled
        then "TAP PLAY TO ENTER"
        else "PRESS ENTER OR CLICK PLAY"

    local hide = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(track, hide, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(trackStroke, hide, { Transparency = 1 }):Play()
    TweenService:Create(fill, hide, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(fillHead, hide, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(percentLabel, hide, { TextTransparency = 1 }):Play()

    playButton.Visible = true
    local grow = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local growTween = TweenService:Create(playButton, grow, { Size = UDim2.fromScale(1, 0.78) })
    -- Wait for the button to have a size before handing it controller focus.
    -- Selecting it while it is still scaled to zero logs "Setting
    -- GuiService.SelectedObject to invalid GuiObject" and the focus does not
    -- take, which would leave a gamepad player unable to reach PLAY.
    growTween.Completed:Connect(function()
        if playButton.Parent ~= nil and playButton.Visible then
            pcall(function()
                GuiService.SelectedObject = playButton
            end)
        end
    end)
    growTween:Play()
end

local function dismiss()
    if finished then
        return
    end
    finished = true
    teardown()
    pcall(function()
        if GuiService.SelectedObject == playButton then
            GuiService.SelectedObject = nil
        end
    end)

    local fade = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    for _, descendant in gui:GetDescendants() do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
            TweenService:Create(descendant, fade, {
                TextTransparency = 1,
                BackgroundTransparency = 1,
            }):Play()
        elseif descendant:IsA("Frame") then
            TweenService:Create(descendant, fade, { BackgroundTransparency = 1 }):Play()
        elseif descendant:IsA("UIStroke") then
            TweenService:Create(descendant, fade, { Transparency = 1 }):Play()
        end
    end
    task.delay(0.55, function()
        gui:Destroy()
    end)
end

table.insert(connections, playButton.Activated:Connect(dismiss))
table.insert(
    connections,
    playButton.MouseEnter:Connect(function()
        if readyToPlay then
            playStroke.Transparency = 0
        end
    end)
)
table.insert(
    connections,
    playButton.MouseLeave:Connect(function()
        playStroke.Transparency = 0.4
    end)
)
table.insert(
    connections,
    UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
        if processed or not readyToPlay then
            return
        end
        if
            input.KeyCode == Enum.KeyCode.Return
            or input.KeyCode == Enum.KeyCode.Space
            or input.KeyCode == Enum.KeyCode.ButtonA
        then
            dismiss()
        end
    end)
)

table.insert(
    connections,
    RunService.RenderStepped:Connect(function(deltaTime: number)
        elapsed += deltaTime

        -- Creep toward, but never across, the milestone actually being awaited.
        if not readyToPlay then
            target = math.max(reached, math.min(ceiling - 0.03, target + deltaTime * 0.05))
        end
        displayed += (target - displayed) * math.min(1, deltaTime * 4)
        fill.Size = UDim2.fromScale(math.clamp(displayed, 0, 1), 1)
        fillHead.Position = UDim2.fromScale(math.clamp(displayed, 0, 1), 0.5)
        fillHead.BackgroundTransparency = if displayed > 0.01 and not readyToPlay then 0.25 else 1
        percentLabel.Text = string.format("%d%%", math.floor(math.clamp(displayed, 0, 1) * 100))

        if reducedMotion then
            return
        end

        local breath = math.sin(elapsed * 1.6) * 0.5 + 0.5
        local flicker = math.sin(elapsed * 9.1) * 0.5 + 0.5
        halo.BackgroundTransparency = 0.9 - breath * 0.06
        halo.Size = UDim2.fromOffset(226 + breath * 14, 226 + breath * 14)
        haloInner.BackgroundTransparency = 0.84 - breath * 0.08
        flame.Size = UDim2.fromOffset(17 + flicker * 3, 31 + flicker * 6)
        glass.BackgroundTransparency = 0.47 - breath * 0.06

        for _, mote in motes do
            mote.y -= mote.rise * deltaTime
            if mote.y < -0.05 then
                mote.y = 1.05
            end
            local sway = math.sin(elapsed * 0.6 + mote.phase) * mote.drift
            mote.frame.Position = UDim2.fromScale(mote.x + sway, mote.y)
        end
    end)
)

-- Stage 1: the runtime folder replicating means the server is answering.
local runtime: Instance? = nil
local startedAt = os.clock()
while runtime == nil and os.clock() - startedAt < RUNTIME_TIMEOUT do
    runtime = ReplicatedStorage:FindFirstChild("LastLightRuntime")
    if runtime == nil then
        task.wait(0.1)
    end
end
if runtime ~= nil then
    advance()
end

-- Stage 2: the client's own content finished streaming in.
stageLabel.Text = STAGE_CONTENT
while not game:IsLoaded() and os.clock() - startedAt < TOTAL_TIMEOUT do
    task.wait(0.1)
end
if game:IsLoaded() then
    advance()
end

-- Stage 3: the server says the arrival clearing is built and safe to stand in.
stageLabel.Text = STAGE_WORLD
if runtime ~= nil then
    while runtime:GetAttribute("WorldReady") ~= true and os.clock() - startedAt < TOTAL_TIMEOUT do
        task.wait(0.1)
    end
    if runtime:GetAttribute("WorldReady") == true then
        advance()
    end
end

-- However the stages went, the player gets in. A timed-out load says so rather
-- than pretending, but it still hands over a working PLAY button.
local worldReady = runtime ~= nil and runtime:GetAttribute("WorldReady") == true
reached = 1
ceiling = 1
target = 1
advance()
task.wait(0.35)
enablePlay(if worldReady then STAGE_READY else STAGE_SLOW)
if not worldReady then
    hint.Text = "The forest is still settling. You can enter now; it will finish around you."
end
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="3">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">LastLight</string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">AbbeySilenceEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Abbey Silence -- Frostmere Vale's first elite.

    It takes sound. Inside its reach a telegraph makes no noise at all,
    which in a game where half of danger is heard is most of a player's
    warning gone -- and the catalog is careful about the other half:
    "suppresses sound cues, preserves visual cues". The fight is fair
    because everything it does can still be seen. It is hard because
    seeing is now the only way.

    So the verb is restoring sound, and the valley's own bells are how.
    Three of them hang in the cloister; ringing one clears the silence
    around it for a while, and the Silence smothers them again on its own
    schedule. A party that rings all three has a room it can hear in and a
    short time to use it.

    Same contract as every elite: profession-independent, solo-passable,
    one reward per participant per run, disable-able, server-called.
]]

local AbbeySilenceEncounter = {}

export type Status = "disabled" | "dormant" | "silent" | "ringing" | "complete"

export type State = {
    bells: { [string]: number },
    health: number,
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    status: Status,
}

local MAX_HEALTH = 330
local BELL_IDS = table.freeze({
    "bell_cloister",
    "bell_refectory",
    "bell_stair",
})
-- How long a rung bell holds sound open around it.
local BELL_SECONDS = 10
-- What a blow is worth while the room is still silent.
local SILENT_FRACTION = 0.35

local SMOTHERED_STEP = table.freeze({
    attackId = "abbey_silence_step",
    attackName = "SMOTHERED STEP",
    damage = 22,
    instruction = "WATCH THE SNOW — YOU WILL NOT HEAR THIS",
    radius = 11,
    shape = "circle",
    windup = 1.5,
})

local HELD_BREATH = table.freeze({
    attackId = "abbey_silence_breath",
    attackName = "HELD BREATH",
    damage = 26,
    instruction = "CLEAR THE AISLE",
    length = 28,
    shape = "lane",
    width = 7,
    windup = 1.3,
})

AbbeySilenceEncounter.Id = "elite_abbey_silence"
AbbeySilenceEncounter.MaxHealth = MAX_HEALTH
AbbeySilenceEncounter.BellIds = BELL_IDS
AbbeySilenceEncounter.BellSeconds = BELL_SECONDS
AbbeySilenceEncounter.SilentFraction = SILENT_FRACTION
AbbeySilenceEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_aurora_salt",
})
AbbeySilenceEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.4,
    ringingAttackCooldownSeconds = 4.2,
    silentAttackCooldownSeconds = 3,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.bells = table.clone(state.bells)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

function AbbeySilenceEncounter.ringingCount(state: State, now: number): number
    local ringing = 0
    for _, id in BELL_IDS do
        if (state.bells[id] or 0) > now then
            ringing += 1
        end
    end
    return ringing
end

function AbbeySilenceEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Abbey Silence run ID is required")
    assert(manifestHash ~= "", "Abbey Silence manifest hash is required")
    return {
        bells = {},
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        status = if enabled then "dormant" else "disabled",
    }
end

function AbbeySilenceEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "silent"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function AbbeySilenceEncounter.join(state: State, userId: number): State
    if state.status ~= "silent" and state.status ~= "ringing" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function AbbeySilenceEncounter.ringBell(
    state: State,
    userId: number,
    bellId: any,
    now: number
): (State, any)
    if state.status ~= "silent" and state.status ~= "ringing" then
        return state, { accepted = false, reason = state.status }
    end
    local valid = false
    for _, id in BELL_IDS do
        if id == bellId then
            valid = true
            break
        end
    end
    if not valid then
        return state, { accepted = false, reason = "unknown_bell" }
    end
    if (state.bells[bellId] or 0) > now then
        return state, { accepted = false, reason = "already_ringing" }
    end
    local nextState = cloneState(state)
    nextState.bells[bellId] = now + BELL_SECONDS
    nextState.participants[participantKey(userId)] = true
    nextState.status = "ringing"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = "bell_rung",
            ringing = AbbeySilenceEncounter.ringingCount(nextState, now),
            silentUntil = nextState.bells[bellId],
        }
end

function AbbeySilenceEncounter.expire(state: State, now: number): State
    if state.status ~= "ringing" then
        return state
    end
    if AbbeySilenceEncounter.ringingCount(state, now) > 0 then
        return state
    end
    local nextState = cloneState(state)
    nextState.status = "silent"
    nextState.revision += 1
    return nextState
end

--[[
    A blow lands either way; the silence decides how much of it is worth
    anything. This is the Many-Face's guard shape on purpose -- both
    fights are about acting inside a window you opened -- but the window
    here is opened by making noise rather than by reading a tell, and it
    can be widened by ringing more than one bell.
]]
function AbbeySilenceEncounter.strike(
    state: State,
    userId: number,
    amount: number,
    now: number
): (State, any)
    assert(amount > 0 and amount <= 100, "Abbey Silence strike amount is invalid")
    if state.status ~= "silent" and state.status ~= "ringing" then
        return state, { accepted = false, reason = state.status }
    end
    local ringing = AbbeySilenceEncounter.ringingCount(state, now)
    local applied = if ringing > 0
        then math.min(100, amount + (ringing - 1) * 6)
        else math.max(1, math.floor(amount * SILENT_FRACTION))
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - applied)
    if nextState.health <= 0 then
        nextState.status = "complete"
        nextState.bells = {}
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = applied,
            health = nextState.health,
            heard = ringing > 0,
            reason = if nextState.status == "complete"
                then "completed"
                elseif ringing > 0 then "damaged"
                else "smothered",
        }
end

function AbbeySilenceEncounter.attack(attackIndex: number, ringingCount: number): any
    -- With bells going it commits to a line it cannot take back; in
    -- silence it prefers the step nobody hears.
    if ringingCount > 0 and attackIndex % 2 == 0 then
        return HELD_BREATH
    end
    return SMOTHERED_STEP
end

function AbbeySilenceEncounter.snapshot(state: State, userId: number, now: number): any
    local ringing = AbbeySilenceEncounter.ringingCount(state, now)
    local instruction = if state.status == "silent"
        then string.format("RING THE CLOISTER BELLS — %d OF %d SOUNDING", ringing, #BELL_IDS)
        elseif state.status == "ringing" then "THE ROOM HAS SOUND — STRIKE WHILE IT LASTS"
        elseif state.status == "complete" then "THE ABBEY CAN BE HEARD AGAIN"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE CLOISTER"
    return {
        active = state.status == "silent" or state.status == "ringing",
        bellTotal = #BELL_IDS,
        bellsRinging = ringing,
        complete = state.status == "complete",
        displayName = "ABBEY SILENCE",
        enabled = state.status ~= "disabled",
        health = state.health,
        heard = ringing > 0,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, math.floor((MAX_HEALTH - state.health) / (MAX_HEALTH / 3)) + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        status = state.status,
    }
end

function AbbeySilenceEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        AbbeySilenceEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(AbbeySilenceEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">ActionPayloadContract</string>
          <string name="Source"><![CDATA[--!strict

-- The wire contract for the ActionRequest remote, in one place so the exploit
-- suite tests what the server actually runs rather than a copy of it.
--
-- Two gates, applied in order and deliberately kept separate:
--
--   1. isValidTransport — NetworkService drops anything that is not a flat
--      table of short scalars before a payload reaches any service at all.
--   2. isValidForKind — the action dispatcher then allows only the fields the
--      requested kind declares, so a field that means something to one action
--      cannot ride along on another.
--
-- Neither gate knows what an action does. They only decide whether a payload
-- is shaped like something the server is willing to look at.

local ActionPayloadContract = {
    MaxFields = 6,
    MaxKindLength = 32,
    MaxStringLength = 128,
}

function ActionPayloadContract.isValidTransport(payload: any): boolean
    if type(payload) ~= "table" or payload.schemaVersion ~= 1 then
        return false
    end

    local kind = payload.kind
    if type(kind) ~= "string" or #kind == 0 or #kind > ActionPayloadContract.MaxKindLength then
        return false
    end

    local fieldCount = 0
    for key, value in payload do
        fieldCount += 1
        if fieldCount > ActionPayloadContract.MaxFields or type(key) ~= "string" then
            return false
        end
        local valueType = type(value)
        if valueType == "string" then
            if #value > ActionPayloadContract.MaxStringLength then
                return false
            end
        elseif valueType == "number" then
            -- NaN and the infinities compare strangely everywhere downstream,
            -- so they never get past the door.
            if value ~= value or value == math.huge or value == -math.huge then
                return false
            end
        elseif valueType ~= "boolean" then
            -- Nested tables, functions, and Instances included: a payload is
            -- flat scalars or it is nothing.
            return false
        end
    end
    return true
end

-- The one extra field a kind may carry beyond schemaVersion and kind. A kind
-- absent from this list carries no payload of its own.
function ActionPayloadContract.extraField(runtimeIds: any, kind: string): string?
    local actions = runtimeIds.Actions
    if kind == actions.Interact then
        return "interactionId"
    elseif kind == actions.SelectProfession then
        return "professionId"
    elseif kind == actions.UseGear or kind == actions.EquipGear or kind == actions.RepairGear then
        return "itemId"
    elseif kind == actions.Sprint or kind == actions.CompactHud then
        return "enabled"
    elseif kind == actions.LobbyDepart then
        return "partySize"
    elseif kind == actions.SaveLoadout or kind == actions.ApplyLoadout then
        return "slot"
    elseif kind == actions.CompanionCommand then
        return "mode"
    elseif kind == actions.PartyReply then
        -- Yes or no to the one invitation a player can be holding. A player
        -- holds at most one at a time, so the reply does not have to name
        -- which -- which is what keeps this to a single field.
        return "accept"
    elseif kind == actions.QuickChat then
        -- A phrase id and nothing else. There is no position in a quick chat
        -- payload because the server reads the sender's own, which is what
        -- makes a ping unforgeable rather than merely validated.
        return "phraseId"
    elseif kind == actions.StoreDetail or kind == actions.StorePurchase then
        -- Which product is being looked at, or bought. The Roblox product id
        -- is never in a payload: the server maps this game's id to the
        -- dashboard number, so a forged payload cannot prompt a purchase for
        -- something this catalog does not sell.
        return "productId"
    elseif kind == actions.EquipCosmetic then
        -- The cosmetic, and never its slot. The slot is the catalog's answer
        -- about that id, and a payload with no slot in it cannot name the
        -- wrong one.
        return "cosmeticId"
    end
    return nil
end

function ActionPayloadContract.allowedFields(runtimeIds: any, kind: string): { [string]: boolean }
    local allowed = {
        schemaVersion = true,
        kind = true,
    }
    local extra = ActionPayloadContract.extraField(runtimeIds, kind)
    if extra ~= nil then
        allowed[extra] = true
    end
    --[[
        The departure press carries TWO fields: the party size and the
        chosen contract. The single-extra-field shape above silently
        dropped every real press from the moment contracts shipped --
        isValidForKind saw contractId, an unknown key, and rejected the
        whole payload before any handler could run. No toast, no log,
        no countdown: the platform just did nothing, exactly as the owner
        reported twice. Direct remote tests that omitted contractId passed,
        which is how it hid from every synthetic check.
    ]]
    if kind == runtimeIds.Actions.LobbyDepart then
        allowed.contractId = true
    end
    return allowed
end

function ActionPayloadContract.isValidForKind(runtimeIds: any, payload: any): boolean
    if type(payload) ~= "table" or payload.schemaVersion ~= 1 then
        return false
    end

    local kind = payload.kind
    if type(kind) ~= "string" or #kind == 0 or #kind > ActionPayloadContract.MaxKindLength then
        return false
    end

    local allowed = ActionPayloadContract.allowedFields(runtimeIds, kind)
    for key in payload do
        if type(key) ~= "string" or allowed[key] ~= true then
            return false
        end
    end
    return true
end

-- Rate limiter cost. The two actions that drive combat cost double, so a macro
-- cannot sustain twice the intended swing rate by spamming the remote.
function ActionPayloadContract.cost(runtimeIds: any, kind: string): number
    local actions = runtimeIds.Actions
    if kind == actions.UseTool or kind == actions.ProfessionAbility then
        return 2
    end
    return 1
end

return table.freeze(ActionPayloadContract)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ActionProgress</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Timed world actions: gathering, building, and anything else that should
    take a beat and show it.

    Pure logic. The service layer owns characters, animation, and the clock;
    everything about whether an action may start, how far along it is, and
    whether it may complete lives here so it can be tested and so a client can
    never award itself the result early.

    The rules:

      * One action at a time per player. A second request while one is running
        is refused rather than queued, so spamming an object cannot stack
        rewards.
      * Completion is time-based and checked server-side. A client asking to
        complete early is refused; the action finishes when the clock says so.
      * Moving away, taking damage, or dying cancels. A cancelled action grants
        nothing -- it is not a partial payout.
      * Completion is consumed. The state is cleared the moment it pays out, so
        a duplicated remote or a retried tick cannot grant twice.
]]

local ActionProgress = {}

export type State = {
    actionId: string,
    interactionId: string,
    startedAt: number,
    endsAt: number,
    swings: number,
}

export type Snapshot = {
    active: boolean,
    actionId: string,
    label: string,
    alpha: number,
    swings: number,
}

-- Deliberately short. This is feedback that an action happened, not a tax on
-- the player's time; the visual standard asks for physical confirmation, not
-- for waiting.
local DURATIONS = table.freeze({
    gather = 1.4,
    build = 1.8,
})

local LABELS = table.freeze({
    gather = "GATHERING",
    build = "BUILDING",
})

local SWINGS = table.freeze({
    gather = 2,
    build = 3,
})

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function ActionProgress.durationFor(actionId: any): number?
    return if type(actionId) == "string" then DURATIONS[actionId] else nil
end

function ActionProgress.labelFor(actionId: any): string
    return (if type(actionId) == "string" then LABELS[actionId] else nil) or "WORKING"
end

function ActionProgress.swingsFor(actionId: any): number
    return (if type(actionId) == "string" then SWINGS[actionId] else nil) or 1
end

function ActionProgress.idle(): State?
    return nil
end

--[[
    Begin a timed action.

    Returns the running state and a result. An action id with no configured
    duration is refused rather than silently treated as instant, so adding a
    new timed action cannot accidentally ship without a duration.
]]
function ActionProgress.begin(
    state: State?,
    actionId: any,
    interactionId: any,
    now: any,
    durationMultiplier: number?
): (State?, any)
    if not finite(now) or now < 0 then
        return state, { accepted = false, reason = "invalid_time" }
    end
    if type(interactionId) ~= "string" or #interactionId == 0 or #interactionId > 64 then
        return state, { accepted = false, reason = "invalid_interaction" }
    end
    local duration = ActionProgress.durationFor(actionId)
    if duration ~= nil and type(durationMultiplier) == "number" then
        -- The hammer's identity: work swings faster. Bounded so no tool can
        -- make a timed action instant or absurdly slow.
        duration *= math.clamp(durationMultiplier, 0.5, 1.5)
    end
    if duration == nil then
        return state, { accepted = false, reason = "untimed_action" }
    end
    if state ~= nil and now < state.endsAt then
        return state, { accepted = false, reason = "already_working" }
    end

    return {
        actionId = actionId :: string,
        interactionId = interactionId,
        startedAt = now,
        endsAt = now + duration,
        swings = ActionProgress.swingsFor(actionId),
    }, {
        accepted = true,
        duration = duration,
        swings = ActionProgress.swingsFor(actionId),
        label = ActionProgress.labelFor(actionId),
    }
end

--[[
    Advance the action.

    `complete` is true exactly once, on the first tick at or after the end
    time, and the state is consumed so it can never pay out twice.
]]
function ActionProgress.tick(state: State?, now: any): (State?, any)
    if state == nil then
        return nil, { complete = false, reason = "idle" }
    end
    if not finite(now) then
        return state, { complete = false, reason = "invalid_time" }
    end
    if now < state.endsAt then
        return state, { complete = false, reason = "working" }
    end
    return nil,
        {
            complete = true,
            actionId = state.actionId,
            interactionId = state.interactionId,
        }
end

function ActionProgress.cancel(_state: State?): State?
    return nil
end

function ActionProgress.snapshot(state: State?, now: any): Snapshot
    if state == nil or not finite(now) then
        return { active = false, actionId = "", label = "", alpha = 0, swings = 0 }
    end
    local span = state.endsAt - state.startedAt
    local alpha = if span <= 0 then 1 else (now - state.startedAt) / span
    return {
        active = now < state.endsAt,
        actionId = state.actionId,
        label = ActionProgress.labelFor(state.actionId),
        alpha = math.clamp(alpha, 0, 1),
        swings = state.swings,
    }
end

return table.freeze(ActionProgress)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">AdminInspectionReport</string>
          <string name="Source"><![CDATA[--!strict

--[[
    What an admin sees when they inspect a player's save.

    Milestone 4 asks for "admin save inspection ... with audit logs." This is
    the inspection half: pure formatting over whatever ProfileService reads
    back, so what an admin is shown is exact rather than approximate, and so
    the report can be tested without a DataStore.

    It never returns anything that could be written back as a profile -- only
    descriptive counts and states. That is deliberate: repair is not built
    yet. Every other admin command in this game applies its effect through
    the same service method the game calls on itself, which is what keeps an
    admin from putting a save in a state the game could not otherwise reach.
    A repair tool for an offline profile has no live service to route
    through, and shipping one before deciding what "safe" means there is how
    a debugging tool becomes a duplication vector. This module exists so
    inspection can ship now without that decision being rushed to unlock it.
]]

local SaveSchema = require("./SaveSchema")

local AdminInspectionReport = {}

export type LockState = {
    held: boolean,
    holder: string?,
    stale: boolean?,
}

export type Report = {
    found: boolean,
    schemaVersion: number?,
    nightNumber: number?,
    tutorialStage: string?,
    tutorialComplete: boolean?,
    chapterOneStatus: string?,
    chapterOneDecision: string?,
    professionId: string?,
    professionsWithMastery: number?,
    equippedCount: number?,
    gearStacks: number?,
    lock: LockState,
}

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

--[[
    Describes a lock without acting on it.

    ProfilePersistence.acquireLock exists to decide whether a server may
    *claim* a profile, which is not what inspection wants: reading a save
    must never contend with the server actually holding it, or with a player
    who reconnects while an admin is looking. This only reports what is
    already written down.
]]
local function describeLock(lock: any, now: any, staleAfter: any): LockState
    if type(lock) ~= "table" or type(lock.jobId) ~= "string" or lock.jobId == "" then
        return { held = false, holder = nil, stale = nil }
    end
    local heartbeat = lock.heartbeat
    local canJudgeAge = finite(heartbeat) and finite(now) and finite(staleAfter)
    return {
        held = true,
        holder = lock.jobId,
        stale = if canJudgeAge then (now - heartbeat) > staleAfter else nil,
    }
end

--[[
    `stored` is exactly what GetAsync would return for this player: nil for a
    key that was never written, or whatever value is on record. Never a live
    Profile, so a locked or currently-playing save is inspected the same way
    an offline one is.
]]
function AdminInspectionReport.build(stored: any, now: number, staleAfter: number): Report
    assert(finite(now), "inspection time must be finite")
    assert(finite(staleAfter) and staleAfter > 0, "stale threshold must be positive")

    local lock =
        describeLock(if type(stored) == "table" then stored.sessionLock else nil, now, staleAfter)

    if stored == nil then
        return {
            found = false,
            lock = lock,
        } :: Report
    end

    local profile = SaveSchema.normalize(stored, now)
    local chapterOne = SaveSchema.chapterOne(profile)

    -- profile.profession.mastery, not SaveSchema.masterySnapshot: the
    -- snapshot is a display view that fills in every catalog profession at
    -- level 1 for a UI that always shows all of them, so counting its
    -- entries always returns the full profession count regardless of
    -- progress. The stored table itself only has an entry for a profession
    -- the player has actually put experience into.
    local professionsWithMastery = 0
    for _ in profile.profession.mastery do
        professionsWithMastery += 1
    end

    local equippedCount = 0
    for _ in SaveSchema.equippedSnapshot(profile) do
        equippedCount += 1
    end

    local gearStacks = 0
    for _ in SaveSchema.gearSnapshot(profile) do
        gearStacks += 1
    end

    return {
        found = true,
        schemaVersion = profile.schemaVersion,
        nightNumber = SaveSchema.nightNumber(profile),
        tutorialStage = profile.tutorial.stage,
        tutorialComplete = profile.tutorial.complete,
        chapterOneStatus = chapterOne.status,
        chapterOneDecision = chapterOne.decision,
        professionId = profile.profession.selectedId,
        professionsWithMastery = professionsWithMastery,
        equippedCount = equippedCount,
        gearStacks = gearStacks,
        lock = lock,
    } :: Report
end

return table.freeze(AdminInspectionReport)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">AdminRoster</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Who may run admin commands, and what a command is allowed to say.

    Pure logic: no players, no services, no chat. It answers two questions --
    is this user an admin, and is this text a command they may run with these
    arguments -- so both can be tested and neither can be decided by a client.

    The rules:

      * Membership is by Roblox user ID, never by name. Display names and
        usernames can change; the numeric ID a player joins with cannot be
        chosen by them.
      * Every argument is bounded here. A command cannot set night nine
        thousand or grant a million heartwood, because the range lives with
        the parser rather than with whoever wired the handler.
      * An unknown command, a bad argument, or a non-admin all produce the
        same outcome: refused. Nothing partially applies.
      * These commands exist to make testing possible, not to hand out power.
        Everything they do, the game already does on its own schedule.

    SAFETY-CHANNEL: admin_command -- the one channel where a player's typed
    text reaches the game at all. Bounded by a two-name roster of user IDs, by
    a parser that refuses anything it does not recognise, and by a feature flag
    that is a complete off switch including the roster. It carries commands,
    never messages: nothing typed here is shown to another player.
]]

local AdminRoster = {}

export type Command = {
    name: string,
    value: number?,
    text: string?,
    extra: number?,
}

-- Nick (owner) and zacksigma472.
local ADMIN_USER_IDS = table.freeze({
    [1213625298] = true,
    [8772161919] = true,
})

local PHASES = table.freeze({ day = true, dusk = true, night = true })

-- Where /go can send an admin. Both directions exist so a tester can reach
-- the expedition without playing to the reveal, and get back out without
-- having to reach the Wayhome gate.
local DESTINATIONS = table.freeze({
    town = true,
    bramblewake = true,
})

-- Every numeric command carries its own bounds so a handler cannot be handed
-- a value the game was never designed to hold.
local NUMERIC_LIMITS: { [string]: { low: number, high: number } } = {
    night = { low = 1, high = 60 },
    give = { low = 0, high = 99 },
}

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function AdminRoster.isAdmin(userId: any): boolean
    return finite(userId) and ADMIN_USER_IDS[userId] == true
end

function AdminRoster.adminUserIds(): { number }
    local ids = {}
    for userId in ADMIN_USER_IDS do
        table.insert(ids, userId)
    end
    table.sort(ids)
    return ids
end

function AdminRoster.commandNames(): { string }
    return {
        "night",
        "give",
        "heal",
        "phase",
        "where",
        "go",
        "perf",
        "inspect",
        "unlock",
        "backups",
        "restore",
        "restoreat",
        "export",
    }
end

--[[
    Parse a chat line into a command.

    Returns nil for anything that is not an admin command, including ordinary
    chat that happens to start with a slash, so the caller can ignore it
    silently rather than answering every message a player types.
]]
function AdminRoster.parse(message: any): Command?
    if type(message) ~= "string" then
        return nil
    end
    local body = string.match(message, "^%s*/(%S+)%s*(.*)$")
    local rest = string.match(message, "^%s*/%S+%s*(.*)$")
    if body == nil then
        return nil
    end
    local name = string.lower(body)
    local known = false
    for _, candidate in AdminRoster.commandNames() do
        if candidate == name then
            known = true
            break
        end
    end
    if not known then
        return nil
    end
    local argument, second = nil, nil
    if type(rest) == "string" then
        argument, second = string.match(rest, "^%s*(%S*)%s*(%S*)")
    end
    return {
        name = name,
        value = if argument ~= nil then tonumber(argument) else nil,
        text = if argument ~= nil and #argument > 0 then string.lower(argument) else nil,
        -- Second token, numeric only. Exists for /restoreat's copy index and
        -- deliberately nothing else -- one extra slot, not a general parser.
        extra = if second ~= nil and #second > 0 then tonumber(second) else nil,
    }
end

--[[
    Decide whether this user may run this line, and with what argument.

    `enabled` is the feature flag. A disabled admin system refuses everyone,
    including the roster, so turning the flag off is a complete off switch
    rather than a suggestion.
]]
function AdminRoster.authorize(userId: any, message: any, enabled: boolean): any
    local command = AdminRoster.parse(message)
    if command == nil then
        return { allowed = false, reason = "not_a_command" }
    end
    if not enabled then
        return { allowed = false, reason = "admin_disabled" }
    end
    if not AdminRoster.isAdmin(userId) then
        return { allowed = false, reason = "not_an_admin" }
    end

    local limits = NUMERIC_LIMITS[command.name]
    if limits ~= nil then
        local value = command.value
        if
            not finite(value)
            or value ~= math.floor(value :: number)
            or (value :: number) < limits.low
            or (value :: number) > limits.high
        then
            return {
                allowed = false,
                reason = "out_of_range",
                command = command.name,
                low = limits.low,
                high = limits.high,
            }
        end
        return { allowed = true, command = command.name, value = value }
    end

    if command.name == "go" then
        if command.text == nil or DESTINATIONS[command.text] ~= true then
            return { allowed = false, reason = "unknown_destination", command = command.name }
        end
        return { allowed = true, command = command.name, text = command.text }
    end

    if command.name == "phase" then
        if command.text == nil or PHASES[command.text] ~= true then
            return { allowed = false, reason = "unknown_phase", command = command.name }
        end
        return { allowed = true, command = command.name, text = command.text }
    end

    if command.name == "inspect" then
        -- The target is a username or a raw user ID, so it is carried as text
        -- rather than validated against a fixed set the way go/phase are.
        -- Whether it resolves to a real player is ProfileService's problem,
        -- not the roster's -- this only rejects what could never be one.
        if command.text == nil or #command.text == 0 or #command.text > 32 then
            return { allowed = false, reason = "invalid_inspection_target", command = command.name }
        end
        return { allowed = true, command = command.name, text = command.text }
    end

    if command.name == "unlock" then
        -- Same target shape as inspect. Whether the lock it names is safe to
        -- clear is decided at the point of the write, not here.
        if command.text == nil or #command.text == 0 or #command.text > 32 then
            return { allowed = false, reason = "invalid_unlock_target", command = command.name }
        end
        return { allowed = true, command = command.name, text = command.text }
    end

    if command.name == "restoreat" then
        -- The deeper-history restore the /restore comment promised: it names
        -- its copy explicitly (1 = oldest kept), so the everyday command
        -- stays impossible to point at an arbitrary past by accident.
        if command.text == nil or #command.text == 0 or #command.text > 32 then
            return { allowed = false, reason = "invalid_backup_target", command = command.name }
        end
        local index = command.extra
        if index == nil or index ~= math.floor(index) or index < 1 or index > 8 then
            return { allowed = false, reason = "invalid_backup_index", command = command.name }
        end
        return { allowed = true, command = command.name, text = command.text, value = index }
    end

    if command.name == "export" then
        if command.text == nil or #command.text == 0 or #command.text > 32 then
            return { allowed = false, reason = "invalid_backup_target", command = command.name }
        end
        return { allowed = true, command = command.name, text = command.text }
    end

    if command.name == "backups" or command.name == "restore" then
        -- Same target shape again. Note what is deliberately absent: no way to
        -- name *which* backup. /restore takes the newest and nothing else, so
        -- the roster cannot be handed an index that selects an arbitrary point
        -- in a player's history. Restoring further back is a real need and can
        -- have its own command later; it is not one to reach by loosening this
        -- parser.
        if command.text == nil or #command.text == 0 or #command.text > 32 then
            return {
                allowed = false,
                reason = "invalid_backup_target",
                command = command.name,
            }
        end
        return { allowed = true, command = command.name, text = command.text }
    end

    return { allowed = true, command = command.name }
end

return table.freeze(AdminRoster)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">AdmiralWreckEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Admiral Wreck -- the Reach's second elite.

    It commands moving ship-debris cover: a ring of hulls that drifts
    around it and takes every blow meant for the thing behind them. The
    catalog's phrase is the fight. You cannot out-damage cover that moves;
    you have to make it stop moving, and the way to do that is to foul the
    tow lines that drag it.

    Four lines, four cuts, and the wreck ring slows with each one -- but
    the lines are re-rigged over time by whatever crew it still has, so a
    party that cuts one and wanders finds it back. That is the difference
    between this and the Iron Widow: her anchors stay cut, and his do not.
    Hers is a fight you win by tempo, his by not letting go.

    Same contract as every elite: profession-independent, solo-passable,
    one reward per participant per run, disable-able, server-called.
]]

local AdmiralWreckEncounter = {}

export type Status = "disabled" | "dormant" | "covered" | "exposed" | "complete"

export type State = {
    health: number,
    lines: { [string]: boolean },
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    status: Status,
}

local MAX_HEALTH = 340
local LINE_IDS = table.freeze({
    "tow_bow",
    "tow_quarter",
    "tow_stern",
    "tow_spring",
})
-- What a blow is worth against a ring that is still turning.
local COVERED_FRACTION = 0.3

local DEBRIS_SWEEP = table.freeze({
    attackId = "admiral_wreck_sweep",
    attackName = "DEBRIS SWEEP",
    damage = 26,
    instruction = "THE RING IS COMING AROUND — MOVE INSIDE IT",
    radius = 14,
    shape = "circle",
    windup = 1.5,
})

local BROADSIDE = table.freeze({
    attackId = "admiral_wreck_broadside",
    attackName = "BROADSIDE",
    damage = 32,
    instruction = "CLEAR THE BROADSIDE LINE",
    length = 34,
    shape = "lane",
    width = 9,
    windup = 1.3,
})

AdmiralWreckEncounter.Id = "elite_admiral_wreck"
AdmiralWreckEncounter.MaxHealth = MAX_HEALTH
AdmiralWreckEncounter.LineIds = LINE_IDS
AdmiralWreckEncounter.CoveredFraction = COVERED_FRACTION
AdmiralWreckEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_ships_iron",
})
AdmiralWreckEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.4,
    exposedAttackCooldownSeconds = 4.6,
    -- How long a cut line stays cut before its crew re-rigs it.
    lineRerigSeconds = 18,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.lines = table.clone(state.lines)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

local function isLine(lineId: any): boolean
    for _, id in LINE_IDS do
        if id == lineId then
            return true
        end
    end
    return false
end

function AdmiralWreckEncounter.cutCount(state: State): number
    local cut = 0
    for _, id in LINE_IDS do
        if state.lines[id] then
            cut += 1
        end
    end
    return cut
end

function AdmiralWreckEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Admiral Wreck run ID is required")
    assert(manifestHash ~= "", "Admiral Wreck manifest hash is required")
    return {
        health = MAX_HEALTH,
        lines = {},
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        status = if enabled then "dormant" else "disabled",
    }
end

function AdmiralWreckEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "covered"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function AdmiralWreckEncounter.join(state: State, userId: number): State
    if state.status ~= "covered" and state.status ~= "exposed" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    Cut a tow line. Every cut slows the ring; all four stop it, and a
    stopped ring is no cover at all. Cuts do not last -- see rerigLine --
    so this is a fight about holding a state rather than reaching one.
]]
function AdmiralWreckEncounter.cutLine(state: State, userId: number, lineId: any): (State, any)
    if state.status ~= "covered" and state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end
    if not isLine(lineId) then
        return state, { accepted = false, reason = "unknown_line" }
    end
    if state.lines[lineId] then
        return state, { accepted = false, reason = "already_cut" }
    end
    local nextState = cloneState(state)
    nextState.lines[lineId] = true
    nextState.participants[participantKey(userId)] = true
    local cut = AdmiralWreckEncounter.cutCount(nextState)
    local stopped = cut >= #LINE_IDS
    if stopped then
        nextState.status = "exposed"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            cut = cut,
            reason = if stopped then "ring_stopped" else "line_cut",
            remaining = #LINE_IDS - cut,
            stopped = stopped,
        }
end

-- Its crew re-rigs a line. The ring turns again, and whatever the party
-- had bought with that cut is gone.
function AdmiralWreckEncounter.rerigLine(state: State, lineId: any): (State, any)
    if state.status ~= "covered" and state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end
    if not isLine(lineId) or not state.lines[lineId] then
        return state, { accepted = false, reason = "not_cut" }
    end
    local nextState = cloneState(state)
    nextState.lines[lineId] = nil
    nextState.status = "covered"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = "line_rerigged",
            cut = AdmiralWreckEncounter.cutCount(nextState),
        }
end

--[[
    A blow always lands; the ring decides how much of it survives. With
    the ring stopped a strike is full, and with it turning it is a third,
    floored at one so a party that never cuts a line still converges --
    very slowly, which is the point.
]]
function AdmiralWreckEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Admiral Wreck strike amount is invalid")
    if state.status ~= "covered" and state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end
    local exposed = state.status == "exposed"
    local applied = if exposed then amount else math.max(1, math.floor(amount * COVERED_FRACTION))
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - applied)
    if nextState.health <= 0 then
        nextState.status = "complete"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            covered = not exposed,
            damage = applied,
            health = nextState.health,
            reason = if nextState.status == "complete"
                then "completed"
                elseif exposed then "damaged"
                else "covered",
        }
end

function AdmiralWreckEncounter.attack(attackIndex: number, cutCount: number): any
    -- A ring that is still turning sweeps; a stopped one fires along it.
    if cutCount >= #LINE_IDS or attackIndex % 2 == 0 then
        return BROADSIDE
    end
    return DEBRIS_SWEEP
end

function AdmiralWreckEncounter.snapshot(state: State, userId: number): any
    local cut = AdmiralWreckEncounter.cutCount(state)
    local instruction = if state.status == "covered"
        then string.format("CUT THE TOW LINES — %d OF %d", cut, #LINE_IDS)
        elseif state.status == "exposed" then "THE RING IS STOPPED — STRIKE HIM"
        elseif state.status == "complete" then "THE WRECKS DRIFT APART"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE WRECK YARD"
    return {
        active = state.status == "covered" or state.status == "exposed",
        complete = state.status == "complete",
        covered = state.status == "covered",
        displayName = "ADMIRAL WRECK",
        enabled = state.status ~= "disabled",
        exposed = state.status == "exposed",
        health = state.health,
        instruction = instruction,
        lineTotal = #LINE_IDS,
        linesCut = cut,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, math.floor(cut / 2) + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        status = state.status,
    }
end

function AdmiralWreckEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        AdmiralWreckEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(AdmiralWreckEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">AmbientMotion</string>
          <string name="Source"><![CDATA[--!strict

local AmbientMotion = {}

local TAU = math.pi * 2

local PHASE_LIGHT_LEVEL = table.freeze({
    day = 0.7,
    dusk = 0.88,
    night = 1,
    reveal = 0.82,
})

export type ResidentPose = {
    height: number,
    yaw: number,
}

function AmbientMotion.rotorAngle(elapsed: number, speed: number, phaseOffset: number): number
    return (elapsed * math.max(0, speed) + phaseOffset) % TAU
end

function AmbientMotion.lightLevel(elapsed: number, phaseOffset: number, phase: string): number
    local phaseLevel = PHASE_LIGHT_LEVEL[string.lower(phase)] or PHASE_LIGHT_LEVEL.day
    local quickFlicker = math.sin(elapsed * 4.7 + phaseOffset) * 0.055
    local slowBreath = math.sin(elapsed * 1.3 + phaseOffset * 0.61) * 0.035
    return math.clamp(phaseLevel + quickFlicker + slowBreath, 0.58, 1.08)
end

function AmbientMotion.residentPose(
    elapsed: number,
    speed: number,
    phaseOffset: number
): ResidentPose
    local wave = elapsed * math.max(0.1, speed) + phaseOffset
    return {
        height = math.sin(wave * 1.9) * 0.035,
        yaw = math.sin(wave * 0.43) * math.rad(2.4),
    }
end

return table.freeze(AmbientMotion)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">AshRegentEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Ash Regent -- chapter VI's boss, in the box it never left.

    Four phases, and the catalog's non-profession solution read literally:
    expose authentic memories, break false statues.

    The Regent is not standing in the court. It is standing in everything
    in the court, distributed across the casts the fire made, and it
    cannot be touched until enough of them are gone. Each phase seats five
    statues around it. Some are casts -- shapes the ash took, repeating,
    empty. Some are authentic: a person the fire caught, kept exactly, and
    the only real record of anyone who was here.

    A party can inspect a statue and learn which it is, or skip the
    inspection and swing. Breaking a false statue takes one of the
    Regent's anchors away. Breaking an authentic one takes two, because
    the Regent is rooted far deeper in something true than in something
    it made up -- which is the fight's whole argument and the chapter's
    decision at the same time. The fast way through the Crown is to
    destroy the only memory of the people who died in it.

    So there is no menu at the end. What the court remembers afterwards
    is a count of what a party smashed to get there.
]]

local AshRegentEncounter = {}

export type Status = "disabled" | "locked" | "dormant" | "anchored" | "exposed" | "complete"

export type State = {
    broken: { [string]: boolean },
    erased: number,
    health: number,
    manifestHash: string,
    participants: { [string]: boolean },
    phase: number,
    revealed: { [string]: boolean },
    revision: number,
    runId: string,
    status: Status,
}

local MAX_HEALTH = 720
local PHASE_THRESHOLDS = table.freeze({ 540, 360, 180, 0 })
local STATUE_IDS = table.freeze({
    "statue_first",
    "statue_second",
    "statue_third",
    "statue_fourth",
    "statue_fifth",
})
-- How much of the Regent each kind of statue is holding up.
local FALSE_ANCHORS = 1
local AUTHENTIC_ANCHORS = 2
-- Anchors that have to come away before the Regent can be touched.
local ANCHORS_REQUIRED = 3

local ASH_FALL = table.freeze({
    attackId = "ash_regent_fall",
    attackName = "ASH FALL",
    damage = 30,
    instruction = "GET UNDER SOMETHING",
    radius = 17,
    shape = "circle",
    windup = 1.6,
})

local RECITATION = table.freeze({
    attackId = "ash_regent_recital",
    attackName = "RECITATION",
    damage = 26,
    instruction = "IT IS SAYING A NAME — CLEAR THE LINE",
    length = 34,
    shape = "lane",
    width = 8,
    windup = 1.4,
})

local CORONATION = table.freeze({
    attackId = "ash_regent_coronation",
    attackName = "CORONATION",
    damage = 36,
    instruction = "THE CEREMONY IS FINISHING — BREAK IT",
    radius = 21,
    shape = "circle",
    windup = 1.9,
})

AshRegentEncounter.Id = "boss_ash_regent"
AshRegentEncounter.MaxHealth = MAX_HEALTH
AshRegentEncounter.StatueIds = STATUE_IDS
AshRegentEncounter.AnchorsRequired = ANCHORS_REQUIRED
AshRegentEncounter.Reward = table.freeze({
    amount = 5,
    materialId = "material_cindersteel",
})
AshRegentEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.5,
    exposedAttackCooldownSeconds = 4.3,
    strikeDamage = 45,
})

--[[
    Which statues in a phase are authentic. Derived rather than stored, so
    a client cannot be handed the answer and a spec can walk every phase
    without reaching inside the fight. Two per phase, and never the same
    two twice, so a party cannot learn a position and stop looking.
]]
function AshRegentEncounter.isAuthentic(phase: number, statueId: any): boolean
    for index, id in STATUE_IDS do
        if id == statueId then
            local shifted = (index + phase) % #STATUE_IDS
            return shifted == 0 or shifted == 1
        end
    end
    return false
end

function AshRegentEncounter.authenticIds(phase: number): { string }
    local ids: { string } = {}
    for _, id in STATUE_IDS do
        if AshRegentEncounter.isAuthentic(phase, id) then
            table.insert(ids, id)
        end
    end
    return ids
end

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.broken = table.clone(state.broken)
    nextState.participants = table.clone(state.participants)
    nextState.revealed = table.clone(state.revealed)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

local function isStatue(statueId: any): boolean
    for _, id in STATUE_IDS do
        if id == statueId then
            return true
        end
    end
    return false
end

function AshRegentEncounter.anchorsRemoved(state: State): number
    local total = 0
    for statueId, wasBroken in state.broken do
        if wasBroken then
            total += if AshRegentEncounter.isAuthentic(state.phase, statueId)
                then AUTHENTIC_ANCHORS
                else FALSE_ANCHORS
        end
    end
    return total
end

function AshRegentEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Ash Regent run ID is required")
    assert(manifestHash ~= "", "Ash Regent manifest hash is required")
    return {
        broken = {},
        erased = 0,
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        participants = {},
        phase = 1,
        revealed = {},
        revision = 0,
        runId = runId,
        status = if enabled then "locked" else "disabled",
    }
end

function AshRegentEncounter.unlock(state: State): (State, any)
    if state.status ~= "locked" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "dormant"
    nextState.revision += 1
    return nextState, { accepted = true, reason = "unlocked" }
end

function AshRegentEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "anchored"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function AshRegentEncounter.join(state: State, userId: number): State
    if state.status == "disabled" or state.status == "locked" or state.status == "complete" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    Look at a statue closely enough to know what it is. Free, repeatable,
    and the only thing in the fight that costs nothing but time -- which
    is exactly what the Crown is trying to take.
]]
function AshRegentEncounter.inspect(state: State, userId: number, statueId: any): (State, any)
    if state.status ~= "anchored" then
        return state, { accepted = false, reason = state.status }
    end
    if not isStatue(statueId) then
        return state, { accepted = false, reason = "unknown_statue" }
    end
    if state.broken[statueId] then
        return state, { accepted = false, reason = "already_broken" }
    end
    local nextState = cloneState(state)
    nextState.revealed[statueId] = true
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    local authentic = AshRegentEncounter.isAuthentic(state.phase, statueId)
    return nextState,
        {
            accepted = true,
            authentic = authentic,
            reason = if authentic then "authentic" else "false_cast",
        }
end

function AshRegentEncounter.breakStatue(state: State, userId: number, statueId: any): (State, any)
    if state.status ~= "anchored" then
        return state, { accepted = false, reason = state.status }
    end
    if not isStatue(statueId) then
        return state, { accepted = false, reason = "unknown_statue" }
    end
    if state.broken[statueId] then
        return state, { accepted = false, reason = "already_broken" }
    end
    local authentic = AshRegentEncounter.isAuthentic(state.phase, statueId)
    local nextState = cloneState(state)
    nextState.broken[statueId] = true
    nextState.participants[participantKey(userId)] = true
    if authentic then
        nextState.erased += 1
    end
    local anchors = AshRegentEncounter.anchorsRemoved(nextState)
    if anchors >= ANCHORS_REQUIRED then
        nextState.status = "exposed"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            anchors = anchors,
            authentic = authentic,
            reason = if nextState.status == "exposed"
                then "regent_exposed"
                elseif authentic then "memory_erased"
                else "cast_broken",
            required = ANCHORS_REQUIRED,
        }
end

function AshRegentEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Ash Regent strike amount is invalid")
    if state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - amount)
    local threshold = PHASE_THRESHOLDS[state.phase]
    if nextState.health <= threshold then
        if state.phase >= #PHASE_THRESHOLDS then
            nextState.health = 0
            nextState.status = "complete"
        else
            nextState.phase = state.phase + 1
            nextState.status = "anchored"
            nextState.broken = {}
            nextState.revealed = {}
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = amount,
            health = nextState.health,
            outcome = AshRegentEncounter.outcome(nextState),
            phase = nextState.phase,
            reason = if nextState.status == "complete"
                then "completed"
                elseif nextState.phase > state.phase then "phase_cleared"
                else "damaged",
        }
end

--[[
    What the court remembers. Not a menu and not a stored decision -- a
    count of the authentic statues a party chose to break, available only
    once the fight is over so nothing can read it early and change how it
    plays.
]]
function AshRegentEncounter.outcome(state: State): string?
    if state.status ~= "complete" then
        return nil
    end
    if state.erased == 0 then
        return "remembered"
    elseif state.erased >= 3 then
        return "erased"
    end
    return "recast"
end

function AshRegentEncounter.attack(attackIndex: number, phase: number, status: Status?): any
    if status == "exposed" then
        return CORONATION
    end
    if phase >= 3 and attackIndex % 2 == 0 then
        return ASH_FALL
    end
    return RECITATION
end

function AshRegentEncounter.snapshot(state: State, userId: number): any
    local outcome = AshRegentEncounter.outcome(state)
    local instruction = if state.status == "anchored"
        then string.format(
            "TAKE ITS ANCHORS — %d OF %d",
            AshRegentEncounter.anchorsRemoved(state),
            ANCHORS_REQUIRED
        )
        elseif state.status == "exposed" then "THE REGENT IS STANDING ALONE — STRIKE"
        elseif state.status == "complete" then if outcome == "remembered"
            then "THE REGENT IS DOWN · EVERY TRUE FACE STILL STANDS"
            elseif outcome == "erased" then "THE REGENT IS DOWN · NOBODY IS LEFT TO REMEMBER"
            else "THE REGENT IS DOWN · SOME OF THEM ARE STILL HERE"
        elseif state.status == "locked" then "THE CROWN IS NOT OPEN TO YOU YET"
        elseif state.status == "disabled" then "THE REGENT DOES NOT ANSWER"
        else "SOMETHING IN THE BOX IS SITTING VERY STILL"
    return {
        active = state.status == "anchored" or state.status == "exposed",
        anchors = AshRegentEncounter.anchorsRemoved(state),
        anchorsRequired = ANCHORS_REQUIRED,
        complete = state.status == "complete",
        displayName = "ASH REGENT",
        enabled = state.status ~= "disabled",
        erased = state.erased,
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        outcome = outcome,
        phase = state.phase,
        revealed = table.clone(state.revealed),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        status = state.status,
        statueTotal = #STATUE_IDS,
    }
end

function AshRegentEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        AshRegentEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(AshRegentEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">AuroraHartEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Aurora Hart -- Frostmere Vale's second elite.

    Its antlers carry light, and light in this valley is warmth. What the
    Hart does with it is the whole fight: it splits. Every few beats it
    takes an ember from the hottest hearth in the clearing and sets it
    down in a cold one, until four hearths are burning weakly and nothing
    in the clearing is warm enough to matter.

    So the party's verb is the opposite of its verb. Carrying an ember
    from one hearth to another puts warmth back together, and a hearth
    that is genuinely banked -- not merely lit -- is the only place a
    strike on the Hart lands for its full weight. The Abbey Silence is a
    fight about opening a window in time; this is a fight about refusing
    to let a resource be divided, which is the argument the whole region
    is making.

    A solo player can win it: the Hart splits on a clock rather than per
    player, and one runner can outpace it. A party wins it faster and
    with fewer cold minutes, which is the correct shape for a co-op game
    that must not require co-op.
]]

local AuroraHartEncounter = {}

export type Status = "disabled" | "dormant" | "split" | "banked" | "complete"

export type State = {
    health: number,
    hearths: { [string]: number },
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    splits: number,
    status: Status,
}

local MAX_HEALTH = 360
local HEARTH_IDS = table.freeze({
    "hearth_north",
    "hearth_east",
    "hearth_south",
    "hearth_west",
})
-- What counts as banked: enough embers in one place to be worth standing in.
local BANKED_LEVEL = 3
local STARTING_LEVEL = 3
-- What a blow is worth with the clearing's warmth scattered.
local SPLIT_FRACTION = 0.4

local LIGHT_ANTLER = table.freeze({
    attackId = "aurora_hart_antler",
    attackName = "LIGHT ANTLER",
    damage = 24,
    instruction = "THE ANTLERS ARE WHERE THE HEAT WENT",
    length = 26,
    shape = "lane",
    width = 8,
    windup = 1.4,
})

local COLD_BOUND = table.freeze({
    attackId = "aurora_hart_bound",
    attackName = "COLD BOUND",
    damage = 20,
    instruction = "IT LANDS WHERE THE FIRE IS NOT",
    radius = 12,
    shape = "circle",
    windup = 1.15,
})

AuroraHartEncounter.Id = "elite_aurora_hart"
AuroraHartEncounter.MaxHealth = MAX_HEALTH
AuroraHartEncounter.HearthIds = HEARTH_IDS
AuroraHartEncounter.BankedLevel = BANKED_LEVEL
AuroraHartEncounter.SplitFraction = SPLIT_FRACTION
AuroraHartEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_ember_moss",
})
AuroraHartEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.2,
    splitIntervalSeconds = 7,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.hearths = table.clone(state.hearths)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

local function isHearth(hearthId: any): boolean
    for _, id in HEARTH_IDS do
        if id == hearthId then
            return true
        end
    end
    return false
end

function AuroraHartEncounter.bankedHearth(state: State): string?
    for _, id in HEARTH_IDS do
        if (state.hearths[id] or 0) >= BANKED_LEVEL then
            return id
        end
    end
    return nil
end

function AuroraHartEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Aurora Hart run ID is required")
    assert(manifestHash ~= "", "Aurora Hart manifest hash is required")
    local hearths: { [string]: number } = {}
    for index, id in HEARTH_IDS do
        hearths[id] = if index == 1 then STARTING_LEVEL else 0
    end
    return {
        health = MAX_HEALTH,
        hearths = hearths,
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        splits = 0,
        status = if enabled then "dormant" else "disabled",
    }
end

local function restatus(state: State): State
    state.status = if AuroraHartEncounter.bankedHearth(state) ~= nil then "banked" else "split"
    return state
end

function AuroraHartEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return restatus(nextState), { accepted = true, activated = true, reason = "activated" }
end

function AuroraHartEncounter.join(state: State, userId: number): State
    if state.status ~= "split" and state.status ~= "banked" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    The Hart's own verb, on the service's clock rather than on a player's
    input: take one ember off the hottest hearth and set it in the
    coldest. It never destroys warmth, which is what makes the fight
    winnable -- everything it takes is still somewhere in the clearing.
]]
function AuroraHartEncounter.split(state: State): State
    if state.status ~= "split" and state.status ~= "banked" then
        return state
    end
    local hottest, coldest = HEARTH_IDS[1], HEARTH_IDS[1]
    for _, id in HEARTH_IDS do
        local level = state.hearths[id] or 0
        if level > (state.hearths[hottest] or 0) then
            hottest = id
        end
        if level < (state.hearths[coldest] or 0) then
            coldest = id
        end
    end
    if hottest == coldest or (state.hearths[hottest] or 0) <= 0 then
        return state
    end
    local nextState = cloneState(state)
    nextState.hearths[hottest] = (nextState.hearths[hottest] or 0) - 1
    nextState.hearths[coldest] = (nextState.hearths[coldest] or 0) + 1
    nextState.splits += 1
    nextState.revision += 1
    return restatus(nextState)
end

function AuroraHartEncounter.carryEmber(
    state: State,
    userId: number,
    fromHearthId: any,
    toHearthId: any
): (State, any)
    if state.status ~= "split" and state.status ~= "banked" then
        return state, { accepted = false, reason = state.status }
    end
    if not isHearth(fromHearthId) or not isHearth(toHearthId) then
        return state, { accepted = false, reason = "unknown_hearth" }
    end
    if fromHearthId == toHearthId then
        return state, { accepted = false, reason = "same_hearth" }
    end
    if (state.hearths[fromHearthId] or 0) <= 0 then
        return state, { accepted = false, reason = "hearth_cold" }
    end
    local nextState = cloneState(state)
    nextState.hearths[fromHearthId] -= 1
    nextState.hearths[toHearthId] = (nextState.hearths[toHearthId] or 0) + 1
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    restatus(nextState)
    return nextState,
        {
            accepted = true,
            banked = nextState.status == "banked",
            level = nextState.hearths[toHearthId],
            reason = if nextState.status == "banked" then "hearth_banked" else "ember_carried",
        }
end

function AuroraHartEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Aurora Hart strike amount is invalid")
    if state.status ~= "split" and state.status ~= "banked" then
        return state, { accepted = false, reason = state.status }
    end
    local banked = AuroraHartEncounter.bankedHearth(state) ~= nil
    local applied = if banked then amount else math.max(1, math.floor(amount * SPLIT_FRACTION))
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - applied)
    if nextState.health <= 0 then
        nextState.status = "complete"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            banked = banked,
            completed = nextState.status == "complete",
            damage = applied,
            health = nextState.health,
            reason = if nextState.status == "complete"
                then "completed"
                elseif banked then "damaged"
                else "scattered",
        }
end

function AuroraHartEncounter.attack(attackIndex: number, banked: boolean): any
    -- Banked, it goes for the fire in a line; scattered, it bounds
    -- through the cold ground it just made.
    if banked and attackIndex % 2 == 1 then
        return LIGHT_ANTLER
    end
    return COLD_BOUND
end

function AuroraHartEncounter.snapshot(state: State, userId: number): any
    local banked = AuroraHartEncounter.bankedHearth(state)
    local hottest = 0
    for _, id in HEARTH_IDS do
        hottest = math.max(hottest, state.hearths[id] or 0)
    end
    local instruction = if state.status == "split"
        then string.format(
            "CARRY THE EMBERS TOGETHER — %d OF %d IN ONE HEARTH",
            hottest,
            BANKED_LEVEL
        )
        elseif state.status == "banked" then "THE HEARTH IS BANKED — STRIKE FROM THE WARMTH"
        elseif state.status == "complete" then "THE HART IS DOWN · THE CLEARING KEEPS ITS FIRE"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE CLEARING"
    return {
        active = state.status == "split" or state.status == "banked",
        bankedHearth = banked,
        bankedLevel = BANKED_LEVEL,
        complete = state.status == "complete",
        displayName = "AURORA HART",
        enabled = state.status ~= "disabled",
        health = state.health,
        hottestLevel = hottest,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, math.floor((MAX_HEALTH - state.health) / (MAX_HEALTH / 3)) + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        splits = state.splits,
        status = state.status,
    }
end

function AuroraHartEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        AuroraHartEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(AuroraHartEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">BellowsMawEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Bellows Maw -- chapter II's boss, at the bottom of the Ironroot
    Delve, where the great pump engine and something older have grown into
    each other.

    Three phases, and the content catalog's own non-profession solution
    read literally: reroute carts, vent pressure, strike core.

    - **Reroute.** The Maw feeds on the ore trains. Each phase opens with
      its feed lines running; throwing a junction switch sends that line
      somewhere else. Enough lines rerouted and the feed starves.
    - **Vent.** Starved, it over-pressurizes. Two vent wheels bleed it off
      -- and this is the chapter's decision: venting into the upper drifts
      is fast and cheap, venting into the flooded stope is slower but the
      Delve keeps its air. The choice is recorded, permanent, and shows in
      the outcome the way the Warden's antlers do.
    - **Strike.** Vented, the core is exposed until the next phase.

    Phase gates ratchet: 2 lines, then 3, then 4, so the fight asks more
    of you each time without asking anything new. Nothing here needs a
    profession, and every step can be walked by one player -- switches and
    wheels stay where they are put.
]]

local BellowsMawEncounter = {}

export type Status =
    "disabled"
    | "locked"
    | "dormant"
    | "feeding"
    | "pressured"
    | "exposed"
    | "complete"

export type State = {
    health: number,
    manifestHash: string,
    outcome: string?,
    participants: { [string]: boolean },
    phase: number,
    reroutedLines: { [string]: boolean },
    revision: number,
    runId: string,
    status: Status,
    ventedInto: { [string]: boolean },
    vents: { [string]: boolean },
}

local MAX_HEALTH = 460
local PHASE_THRESHOLDS = table.freeze({ 300, 150, 0 })
local LINES_REQUIRED = table.freeze({ 2, 3, 4 })
local LINE_IDS = table.freeze({
    line_head = true,
    line_spur = true,
    line_deep = true,
    line_return = true,
})
local VENT_IDS = table.freeze({
    vent_drift = true,
    vent_stope = true,
})
-- Which vent a crew chooses is the chapter's decision. Drifts are quick
-- and the Delve breathes worse for it; the stope is slow and clean.
local VENT_OUTCOMES = table.freeze({
    vent_drift = "fouled",
    vent_stope = "cleared",
})

local FEED_SURGE = table.freeze({
    attackId = "bellows_maw_feed_surge",
    attackName = "FEED SURGE",
    damage = 26,
    instruction = "CLEAR THE FEED LINE",
    length = 34,
    shape = "lane",
    width = 8,
    windup = 1.25,
})

local PRESSURE_BURST = table.freeze({
    attackId = "bellows_maw_pressure_burst",
    attackName = "PRESSURE BURST",
    damage = 30,
    instruction = "GET BEHIND COVER — IT IS VENTING WILD",
    radius = 14,
    shape = "circle",
    windup = 1.6,
})

local CINDER_FALL = table.freeze({
    attackId = "bellows_maw_cinder_fall",
    attackName = "CINDER FALL",
    damage = 22,
    instruction = "LEAVE THE FALLING EMBERS",
    radius = 10,
    shape = "circle",
    windup = 1.35,
})

BellowsMawEncounter.Id = "boss_bellows_maw"
BellowsMawEncounter.MaxHealth = MAX_HEALTH
BellowsMawEncounter.LineIds = LINE_IDS
BellowsMawEncounter.VentIds = VENT_IDS
BellowsMawEncounter.Reward = table.freeze({
    amount = 5,
    materialId = "material_coalglass",
})
BellowsMawEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.4,
    feedingAttackCooldownSeconds = 4.2,
    markedAttackCooldownMultiplier = 1.35,
    markedStrikeDamage = 46,
    pressuredAttackCooldownSeconds = 2.8,
    strikeDamage = 40,
})

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "boss participant user ID is invalid")
    return tostring(userId)
end

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.participants = table.clone(state.participants)
    nextState.reroutedLines = table.clone(state.reroutedLines)
    nextState.ventedInto = table.clone(state.ventedInto)
    nextState.vents = table.clone(state.vents)
    return nextState
end

local function countKeys(values: { [string]: boolean }): number
    local count = 0
    for _, value in values do
        if value then
            count += 1
        end
    end
    return count
end

local function isActive(status: Status): boolean
    return status == "feeding" or status == "pressured" or status == "exposed"
end

local function linesRequired(phase: number): number
    return LINES_REQUIRED[phase] or LINES_REQUIRED[#LINES_REQUIRED]
end

function BellowsMawEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Bellows Maw run ID is required")
    assert(manifestHash ~= "", "Bellows Maw manifest hash is required")
    return {
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        outcome = nil,
        participants = {},
        phase = 1,
        reroutedLines = {},
        revision = 0,
        runId = runId,
        status = if enabled then "locked" else "disabled",
        ventedInto = {},
        vents = {},
    }
end

-- The Maw's chamber opens when the Delve's own elites have been dealt
-- with; until then the fight is not reachable, exactly as the Warden's
-- Seal waits on the Old Growth.
function BellowsMawEncounter.unlock(state: State): (State, any)
    if state.status ~= "locked" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "dormant"
    nextState.revision += 1
    return nextState, { accepted = true, reason = "unlocked" }
end

function BellowsMawEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "feeding"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function BellowsMawEncounter.join(state: State, userId: number): State
    if not isActive(state.status) then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    Throw one junction switch. Rerouted lines stay rerouted for the phase,
    and starving the feed moves the Maw into over-pressure.
]]
function BellowsMawEncounter.rerouteLine(state: State, userId: number, lineId: any): (State, any)
    if state.status ~= "feeding" then
        return state, { accepted = false, reason = state.status }
    end
    if type(lineId) ~= "string" or LINE_IDS[lineId] ~= true then
        return state, { accepted = false, reason = "unknown_line" }
    end
    if state.reroutedLines[lineId] then
        return state, { accepted = false, reason = "already_rerouted" }
    end
    local nextState = cloneState(state)
    nextState.reroutedLines[lineId] = true
    nextState.participants[participantKey(userId)] = true
    local rerouted = countKeys(nextState.reroutedLines)
    local required = linesRequired(state.phase)
    local starved = rerouted >= required
    if starved then
        nextState.status = "pressured"
        nextState.vents = {}
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = if starved then "feed_starved" else "line_rerouted",
            remaining = math.max(0, required - rerouted),
            rerouted = rerouted,
            starved = starved,
        }
end

--[[
    Turn a vent wheel. Both wheels bleed the pressure, and which one a
    crew reaches for is remembered: the drifts are quick and the air pays,
    the flooded stope is slow and the Delve keeps its air. A single wheel
    is enough to vent -- the second is a choice, not a chore.
]]
function BellowsMawEncounter.ventPressure(state: State, userId: number, ventId: any): (State, any)
    if state.status ~= "pressured" then
        return state, { accepted = false, reason = state.status }
    end
    if type(ventId) ~= "string" or VENT_IDS[ventId] ~= true then
        return state, { accepted = false, reason = "unknown_vent" }
    end
    if state.vents[ventId] then
        return state, { accepted = false, reason = "already_vented" }
    end
    local nextState = cloneState(state)
    nextState.vents[ventId] = true
    nextState.ventedInto[ventId] = true
    nextState.participants[participantKey(userId)] = true
    nextState.status = "exposed"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = "pressure_vented",
            vent = ventId,
            ventOutcome = VENT_OUTCOMES[ventId],
        }
end

function BellowsMawEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Bellows Maw strike amount is invalid")
    if state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local threshold = PHASE_THRESHOLDS[state.phase]
    nextState.health = math.max(threshold, state.health - amount)
    local phaseFinished = nextState.health <= threshold
    if phaseFinished then
        if state.phase >= #PHASE_THRESHOLDS then
            nextState.health = 0
            nextState.status = "complete"
            --[[
                The outcome the Delve remembers: a crew that only ever
                took the quick vent leaves the drifts fouled, one that
                only ever took the stope leaves the air clear, and a crew
                that used both is somewhere in between. The chapter's own
                consequence, decided by play rather than a menu.
            ]]
            local drift = nextState.ventedInto.vent_drift == true
            local stope = nextState.ventedInto.vent_stope == true
            nextState.outcome = if drift and stope
                then "mixed"
                elseif drift then "fouled"
                else "cleared"
        else
            nextState.phase += 1
            nextState.reroutedLines = {}
            nextState.vents = {}
            nextState.status = "feeding"
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            outcome = nextState.outcome,
            phase = nextState.phase,
            phaseFinished = phaseFinished,
            reason = if nextState.status == "complete"
                then "completed"
                elseif phaseFinished then "next_phase"
                else "damaged",
        }
end

function BellowsMawEncounter.attack(attackIndex: number, phase: number, status: Status?): any
    -- Over-pressure is its own danger: while it is waiting to be vented
    -- the Maw throws bursts regardless of phase.
    if status == "pressured" then
        return PRESSURE_BURST
    end
    if phase >= 3 then
        return if attackIndex % 2 == 0 then CINDER_FALL else FEED_SURGE
    elseif phase == 2 and attackIndex % 2 == 0 then
        return CINDER_FALL
    end
    return FEED_SURGE
end

function BellowsMawEncounter.snapshot(state: State, userId: number): any
    local rerouted = countKeys(state.reroutedLines)
    local required = linesRequired(state.phase)
    local instruction = if state.status == "feeding"
        then string.format("REROUTE THE FEED LINES %d/%d", rerouted, required)
        elseif
            state.status == "pressured"
        then "VENT THE PRESSURE · DRIFTS ARE QUICK, THE STOPE IS CLEAN"
        elseif state.status == "exposed" then "THE CORE IS OPEN — STRIKE IT"
        elseif state.status == "complete" then if state.outcome == "cleared"
            then "THE MAW IS STILL · THE DELVE BREATHES CLEAN"
            elseif state.outcome == "fouled" then "THE MAW IS STILL · THE DRIFTS ARE FOULED"
            else "THE MAW IS STILL · THE DELVE IS CHANGED"
        elseif state.status == "dormant" then "ENTER THE BELLOWS CHAMBER"
        elseif state.status == "locked" then "CLEAR THE DELVE'S ELITES TO OPEN THE CHAMBER"
        elseif state.status == "disabled" then "BELLOWS MAW TEMPORARILY DORMANT"
        else "BELLOWS MAW"
    return {
        active = isActive(state.status),
        choiceAvailable = state.status == "pressured",
        complete = state.status == "complete",
        displayName = "BELLOWS MAW",
        enabled = state.status ~= "disabled",
        exposed = state.status == "exposed",
        health = state.health,
        instruction = instruction,
        linesRequired = required,
        linesRerouted = rerouted,
        maxHealth = MAX_HEALTH,
        outcome = state.outcome,
        phase = state.phase,
        pressured = state.status == "pressured",
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        status = state.status,
    }
end

function BellowsMawEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        BellowsMawEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(BellowsMawEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">BramblewakeBlackout</string>
          <string name="Source"><![CDATA[--!strict

local BramblewakeBlackout = {}

export type Status =
    "disabled"
    | "dormant"
    | "relay"
    | "old_growth"
    | "warden"
    | "resolution"
    | "complete"

export type State = {
    carriers: { [string]: number },
    decision: string?,
    deliveredNodes: { [string]: boolean },
    duration: number,
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    startedAt: number?,
    status: Status,
    targetEndsAt: number?,
    votes: { [string]: string },
    wardenOutcome: string?,
}

local RELAY_NODE_IDS = table.freeze({
    blackout_root_farm = true,
    blackout_root_mill = true,
    blackout_root_cathedral = true,
})
local RELAY_NODE_ORDER = table.freeze({
    "blackout_root_farm",
    "blackout_root_mill",
    "blackout_root_cathedral",
})
local RELAY_NODE_LABELS = table.freeze({
    blackout_root_farm = "FARM ROOT",
    blackout_root_mill = "MILL ROOT",
    blackout_root_cathedral = "CATHEDRAL ROOT",
})
local DECISION_IDS = table.freeze({
    restore_farmland = true,
    wild_regrowth = true,
    shared_agroforest = true,
})
local WARDEN_OUTCOMES = table.freeze({
    preserved = true,
    scarred = true,
    harmed = true,
})
local STAGE_INDEX = table.freeze({
    relay = 1,
    old_growth = 2,
    warden = 3,
    resolution = 4,
    complete = 4,
})
local STAGE_LABEL = table.freeze({
    relay = "ROOTFIRE RELAY",
    old_growth = "OLD GROWTH",
    warden = "WARDEN'S SEAL",
    resolution = "GREENWARD CHOICE",
    complete = "CHAPTER RESOLVED",
})

BramblewakeBlackout.Id = "blackout_bramblewake"
BramblewakeBlackout.RelayNodeIds = RELAY_NODE_IDS
BramblewakeBlackout.DecisionIds = DECISION_IDS
BramblewakeBlackout.FireCarrySeconds = 18
BramblewakeBlackout.StageCount = 4

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "Blackout participant ID is invalid")
    return tostring(userId)
end

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.carriers = table.clone(state.carriers)
    nextState.deliveredNodes = table.clone(state.deliveredNodes)
    nextState.participants = table.clone(state.participants)
    nextState.votes = table.clone(state.votes)
    return nextState
end

local function countTrue(values: { [string]: boolean }): number
    local count = 0
    for _, value in values do
        if value then
            count += 1
        end
    end
    return count
end

local function nextRelayNodeId(deliveredNodes: { [string]: boolean }): string?
    for _, nodeId in RELAY_NODE_ORDER do
        if deliveredNodes[nodeId] ~= true then
            return nodeId
        end
    end
    return nil
end

local function active(status: Status): boolean
    return status == "relay"
        or status == "old_growth"
        or status == "warden"
        or status == "resolution"
end

function BramblewakeBlackout.create(
    runId: string,
    manifestHash: string,
    enabled: boolean,
    duration: number
): State
    assert(runId ~= "", "Blackout run ID is required")
    assert(manifestHash ~= "", "Blackout manifest hash is required")
    assert(duration >= 60 and duration <= 30 * 60, "Blackout duration is invalid")
    return {
        carriers = {},
        decision = nil,
        deliveredNodes = {},
        duration = duration,
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        startedAt = nil,
        status = if enabled then "dormant" else "disabled",
        targetEndsAt = nil,
        votes = {},
        wardenOutcome = nil,
    }
end

function BramblewakeBlackout.start(state: State, userId: number, now: number): (State, any)
    if state.status ~= "dormant" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.startedAt = now
    nextState.status = "relay"
    nextState.targetEndsAt = now + nextState.duration
    nextState.revision += 1
    return nextState, {
        accepted = true,
        reason = "started",
    }
end

function BramblewakeBlackout.join(state: State, userId: number): State
    if not active(state.status) then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function BramblewakeBlackout.takeFire(state: State, userId: number, now: number): (State, any)
    if state.status ~= "relay" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local key = participantKey(userId)
    local nextState = cloneState(state)
    nextState.carriers[key] = now + BramblewakeBlackout.FireCarrySeconds
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            expiresAt = nextState.carriers[key],
            reason = "fire_taken",
        }
end

function BramblewakeBlackout.deliverFire(
    state: State,
    userId: number,
    nodeId: string,
    now: number
): (State, any)
    if state.status ~= "relay" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    if RELAY_NODE_IDS[nodeId] ~= true then
        return state,
            {
                accepted = false,
                reason = "invalid_relay_node",
            }
    end
    if state.deliveredNodes[nodeId] then
        return state,
            {
                accepted = false,
                reason = "already_delivered",
            }
    end
    local key = participantKey(userId)
    local expiresAt = state.carriers[key]
    if expiresAt == nil or now > expiresAt then
        return state,
            {
                accepted = false,
                reason = if expiresAt == nil then "fire_required" else "fire_expired",
            }
    end

    local nextState = cloneState(state)
    nextState.carriers[key] = nil
    nextState.deliveredNodes[nodeId] = true
    nextState.participants[key] = true
    local delivered = countTrue(nextState.deliveredNodes)
    if delivered >= 3 then
        nextState.status = "old_growth"
        table.clear(nextState.carriers)
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            delivered = delivered,
            reason = if nextState.status == "old_growth"
                then "relay_complete"
                else "fire_delivered",
            relayComplete = nextState.status == "old_growth",
            required = 3,
        }
end

function BramblewakeBlackout.completeOldGrowth(state: State): (State, any)
    if state.status ~= "old_growth" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.status = "warden"
    nextState.revision += 1
    return nextState, {
        accepted = true,
        reason = "old_growth_complete",
    }
end

function BramblewakeBlackout.completeWarden(state: State, outcome: string): (State, any)
    if state.status ~= "warden" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    if WARDEN_OUTCOMES[outcome] ~= true then
        return state,
            {
                accepted = false,
                reason = "invalid_warden_outcome",
            }
    end
    local nextState = cloneState(state)
    nextState.status = "resolution"
    nextState.wardenOutcome = outcome
    nextState.revision += 1
    return nextState, {
        accepted = true,
        reason = "warden_complete",
    }
end

local function resolveVote(votes: { [string]: string }, eligibleUserIds: { number }): string?
    local counts = {
        restore_farmland = 0,
        wild_regrowth = 0,
        shared_agroforest = 0,
    }
    local eligible = 0
    for _, userId in eligibleUserIds do
        local vote = votes[participantKey(userId)]
        if vote == nil then
            return nil
        end
        counts[vote] += 1
        eligible += 1
    end
    if eligible == 0 then
        return nil
    end
    local highest =
        math.max(counts.restore_farmland, counts.wild_regrowth, counts.shared_agroforest)
    local winner: string? = nil
    local winners = 0
    for _, decision in { "restore_farmland", "wild_regrowth", "shared_agroforest" } do
        if counts[decision] == highest then
            winner = decision
            winners += 1
        end
    end
    return if winners == 1 then winner else "shared_agroforest"
end

function BramblewakeBlackout.vote(
    state: State,
    userId: number,
    decision: string,
    eligibleUserIds: { number }
): (State, any)
    if state.status ~= "resolution" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    if DECISION_IDS[decision] ~= true then
        return state,
            {
                accepted = false,
                reason = "invalid_decision",
            }
    end
    local key = participantKey(userId)
    if state.participants[key] ~= true then
        return state,
            {
                accepted = false,
                reason = "not_participant",
            }
    end
    local eligible = false
    for _, eligibleUserId in eligibleUserIds do
        if eligibleUserId == userId then
            eligible = true
            break
        end
    end
    if not eligible then
        return state, {
            accepted = false,
            reason = "not_eligible",
        }
    end

    local nextState = cloneState(state)
    nextState.votes[key] = decision
    local resolved = resolveVote(nextState.votes, eligibleUserIds)
    if resolved ~= nil then
        nextState.decision = resolved
        nextState.status = "complete"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            decision = resolved,
            reason = if resolved == nil then "vote_recorded" else "resolved",
            resolved = resolved ~= nil,
        }
end

function BramblewakeBlackout.reconcileVote(state: State, eligibleUserIds: { number }): (State, any)
    if state.status ~= "resolution" then
        return state,
            {
                accepted = false,
                reason = state.status,
                resolved = false,
            }
    end
    local resolved = resolveVote(state.votes, eligibleUserIds)
    if resolved == nil then
        return state,
            {
                accepted = true,
                reason = "vote_pending",
                resolved = false,
            }
    end
    local nextState = cloneState(state)
    nextState.decision = resolved
    nextState.status = "complete"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            decision = resolved,
            reason = "resolved",
            resolved = true,
        }
end

function BramblewakeBlackout.snapshot(state: State, userId: number, now: number): any
    local key = tostring(userId)
    local startedAt = state.startedAt
    local targetEndsAt = state.targetEndsAt
    local elapsed = if startedAt == nil then 0 else math.max(0, now - startedAt)
    local remaining = if targetEndsAt == nil
        then state.duration
        else math.max(0, targetEndsAt - now)
    local fireExpiresAt = state.carriers[key]
    local carryingFire = fireExpiresAt ~= nil and now <= fireExpiresAt
    local delivered = countTrue(state.deliveredNodes)
    local nextNodeId = nextRelayNodeId(state.deliveredNodes)
    local instruction = if state.status == "relay"
        then if carryingFire
            then "DELIVER ROOTFIRE TO THE MARKED NEXT ROOT"
            else "TAKE ROOTFIRE FROM THE BLACKOUT LANTERN"
        elseif state.status == "old_growth" then "CLEANSE OLD GROWTH"
        elseif state.status == "warden" then "ANSWER THE WARDEN'S SEAL"
        elseif state.status == "resolution" then "CHOOSE THE GREENWARD'S FUTURE"
        elseif state.status == "complete" then "CHAPTER I RESOLVED"
        elseif state.status == "dormant" then "ENTER BRAMBLEWAKE TO BEGIN THE BLACKOUT"
        else "BRAMBLEWAKE BLACKOUT DISABLED"
    return {
        active = active(state.status),
        carryingFire = carryingFire,
        chapterComplete = state.status == "complete",
        decision = state.decision,
        deliveredNodes = delivered,
        -- The count above and this map answer different questions -- "how
        -- many are lit" for the HUD's N/3 rail, and "which ones" for the
        -- objective-marker resolver. TutorialService used to iterate the
        -- count and threw on every publish for the whole relay stage.
        deliveredNodeMap = table.clone(state.deliveredNodes),
        duration = state.duration,
        elapsed = elapsed,
        enabled = state.status ~= "disabled",
        fireExpiresAt = if carryingFire then fireExpiresAt else nil,
        instruction = instruction,
        nextNodeId = nextNodeId,
        nextNodeLabel = if nextNodeId == nil then nil else RELAY_NODE_LABELS[nextNodeId],
        overtime = targetEndsAt ~= nil and now > targetEndsAt,
        participant = state.participants[key] == true,
        relayRequired = 3,
        remaining = remaining,
        revision = state.revision,
        stage = STAGE_INDEX[state.status] or 0,
        stageCount = BramblewakeBlackout.StageCount,
        stageLabel = STAGE_LABEL[state.status] or "BLACKOUT",
        status = state.status,
        targetEndsAt = targetEndsAt,
        vote = state.votes[key],
        wardenOutcome = state.wardenOutcome,
    }
end

function BramblewakeBlackout.chapterTransactionId(state: State, userId: number): string
    return string.format("chapter_1:%s:%s:%d", state.runId, state.manifestHash, userId)
end

return table.freeze(BramblewakeBlackout)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">BramblewakeEnemies</string>
          <string name="Source"><![CDATA[--!strict

local BramblewakeEnemies = {}

export type AttackShape = "circle" | "lane"
export type TargetMode = "lantern" | "player"
export type StatusEffect = "drowsy" | "spark_theft"

export type EnemyDefinition = {
    id: string,
    displayName: string,
    modelKey: string,
    health: number,
    speed: number,
    attackRange: number,
    attackCooldown: number,
    playerDamage: number,
    lanternDamage: number,
    strikeRange: number,
    strikeDamage: number,
    attackId: string,
    attackName: string,
    instruction: string,
    shape: AttackShape,
    radius: number?,
    width: number?,
    length: number?,
    windup: number,
    stationary: boolean,
    targetMode: TargetMode,
    frontShield: boolean,
    frontalStrikeDamage: number?,
    flankStrikeDamage: number?,
    statusEffect: StatusEffect?,
    statusDuration: number?,
    statusMultiplier: number?,
    statusLanternDamage: number?,
}

local function freezeDefinition(definition: EnemyDefinition): EnemyDefinition
    return table.freeze(definition)
end

local DEFINITIONS: { [string]: EnemyDefinition } = {
    enemy_rootling = freezeDefinition({
        id = "enemy_rootling",
        displayName = "Rootling",
        modelKey = "rootling",
        health = 100,
        speed = 7,
        attackRange = 9,
        attackCooldown = 2,
        playerDamage = 24,
        lanternDamage = 6,
        strikeRange = 9,
        strikeDamage = 34,
        attackId = "rootling_swipe",
        attackName = "ROOTLING SWIPE",
        instruction = "DODGE OUT OF THE RING",
        shape = "circle",
        radius = 7,
        width = nil,
        length = nil,
        windup = 0.9,
        stationary = false,
        targetMode = "lantern",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    enemy_briarback = freezeDefinition({
        id = "enemy_briarback",
        displayName = "Briarback",
        modelKey = "briarback",
        health = 120,
        speed = 5.6,
        attackRange = 10,
        attackCooldown = 2.2,
        playerDamage = 22,
        lanternDamage = 7,
        strikeRange = 10,
        strikeDamage = 34,
        attackId = "briarback_sweep",
        attackName = "BRIARBACK SWEEP",
        instruction = "CLEAR THE LANE · FLANK IT",
        shape = "lane",
        radius = nil,
        width = 8,
        length = 12,
        windup = 1.05,
