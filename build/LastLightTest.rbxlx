          <string name="Name">OldGrowthEncounter</string>
          <string name="Source"><![CDATA[--!strict

local OldGrowthEncounter = {}

export type Status = "disabled" | "dormant" | "vulnerable" | "shielded" | "complete"

export type State = {
    carriers: { [string]: number },
    health: number,
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    shieldIndex: number,
    status: Status,
}

local MAX_HEALTH = 360
local FIRE_CARRY_SECONDS = 15
local SHIELD_THRESHOLDS = table.freeze({ 240, 120 })

local ROOT_LANE = table.freeze({
    attackId = "old_growth_root_lane",
    attackName = "CATHEDRAL ROOTS",
    damage = 20,
    instruction = "CLEAR THE ROOT LANE",
    length = 32,
    rootedDuration = 1.6,
    rootedMultiplier = 0.35,
    shape = "lane",
    width = 9,
    windup = 1.35,
})

local CANOPY_FALL = table.freeze({
    attackId = "old_growth_canopy_fall",
    attackName = "CANOPY FALL",
    damage = 28,
    instruction = "LEAVE THE FALL RING",
    radius = 10,
    shape = "circle",
    windup = 1.55,
})

OldGrowthEncounter.Id = "elite_old_growth"
OldGrowthEncounter.MaxHealth = MAX_HEALTH
OldGrowthEncounter.FireCarrySeconds = FIRE_CARRY_SECONDS
OldGrowthEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_amber_sap",
})
OldGrowthEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3,
    markedAttackCooldownMultiplier = 1.35,
    markedStrikeDamage = 40,
    shieldedAttackCooldownSeconds = 4.2,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.carriers = table.clone(state.carriers)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

function OldGrowthEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Old Growth run ID is required")
    assert(manifestHash ~= "", "Old Growth manifest hash is required")
    return {
        carriers = {},
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        shieldIndex = 0,
        status = if enabled then "dormant" else "disabled",
    }
end

function OldGrowthEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.status = "vulnerable"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            activated = true,
            reason = "activated",
        }
end

function OldGrowthEncounter.join(state: State, userId: number): State
    if state.status ~= "vulnerable" and state.status ~= "shielded" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function OldGrowthEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Old Growth strike amount is invalid")
    if state.status ~= "vulnerable" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local nextHealth = math.max(0, state.health - amount)
    local threshold = SHIELD_THRESHOLDS[state.shieldIndex + 1]
    local shieldStarted = threshold ~= nil and nextHealth <= threshold
    if shieldStarted then
        nextState.health = threshold
        nextState.shieldIndex += 1
        nextState.status = "shielded"
    else
        nextState.health = nextHealth
        if nextHealth <= 0 then
            nextState.status = "complete"
            nextState.carriers = {}
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            reason = if nextState.status == "complete"
                then "completed"
                elseif shieldStarted then "shield_started"
                else "damaged",
            shieldStarted = shieldStarted,
        }
end

function OldGrowthEncounter.takeFire(state: State, userId: number, now: number): (State, any)
    if state.status ~= "shielded" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local key = participantKey(userId)
    for carrierKey, expiresAt in state.carriers do
        if carrierKey ~= key and now < expiresAt then
            return state,
                {
                    accepted = false,
                    reason = "fire_claimed",
                }
        end
    end
    local nextState = cloneState(state)
    nextState.carriers[key] = now + FIRE_CARRY_SECONDS
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            expiresAt = nextState.carriers[key],
            reason = "fire_taken",
        }
end

function OldGrowthEncounter.burnHeart(state: State, userId: number, now: number): (State, any)
    if state.status ~= "shielded" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local key = participantKey(userId)
    local expiresAt = state.carriers[key]
    if expiresAt == nil or now >= expiresAt then
        return state,
            {
                accepted = false,
                reason = "fire_required",
            }
    end
    local nextState = cloneState(state)
    nextState.carriers = {}
    nextState.participants[key] = true
    nextState.status = "vulnerable"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = "shield_burned",
            shieldIndex = nextState.shieldIndex,
        }
end

function OldGrowthEncounter.expire(state: State, now: number): State
    local expired = false
    local nextState = cloneState(state)
    for key, expiresAt in nextState.carriers do
        if now >= expiresAt then
            nextState.carriers[key] = nil
            expired = true
        end
    end
    if expired then
        nextState.revision += 1
        return nextState
    end
    return state
end

function OldGrowthEncounter.attack(attackIndex: number, shieldIndex: number): any
    if shieldIndex >= 1 and attackIndex % 2 == 0 then
        return CANOPY_FALL
    end
    return ROOT_LANE
end

function OldGrowthEncounter.snapshot(state: State, userId: number, now: number): any
    local expiresAt = state.carriers[tostring(userId)] or 0
    local carryingFire = now < expiresAt
    local instruction = if state.status == "shielded"
        then if carryingFire then "CARRY FIRE TO THE ROOT HEART" else "TAKE LANTERN FIRE"
        elseif state.status == "vulnerable" then "STRIKE THE AMBER HEART"
        elseif state.status == "complete" then "OLD GROWTH CLEANSED"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE OLD GROWTH ARENA"
    return {
        active = state.status == "vulnerable" or state.status == "shielded",
        carryingFire = carryingFire,
        complete = state.status == "complete",
        displayName = "OLD GROWTH",
        enabled = state.status ~= "disabled",
        fireExpiresAt = if carryingFire then expiresAt else 0,
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, state.shieldIndex + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        shielded = state.status == "shielded",
        shieldIndex = state.shieldIndex,
        status = state.status,
    }
end

function OldGrowthEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        OldGrowthEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(OldGrowthEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">ProfessionAbilityVisuals</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionAbilityVisuals = {}

export type Definition = {
    professionId: string,
    motif: string,
    color: { number },
    accent: { number },
    pulseLifetime: number,
    minimumRadius: number,
}

local DEFINITIONS: { [string]: Definition } = {
    profession_scout = table.freeze({
        professionId = "profession_scout",
        motif = "foxfire_compass",
        color = table.freeze({ 94, 206, 176 }),
        accent = table.freeze({ 218, 247, 205 }),
        pulseLifetime = 1.35,
        minimumRadius = 9,
    }),
    profession_warden = table.freeze({
        professionId = "profession_warden",
        motif = "root_ward",
        color = table.freeze({ 112, 151, 119 }),
        accent = table.freeze({ 244, 230, 197 }),
        pulseLifetime = 1.1,
        minimumRadius = 8,
    }),
    profession_engineer = table.freeze({
        professionId = "profession_engineer",
        motif = "rootline_gear",
        color = table.freeze({ 191, 137, 73 }),
        accent = table.freeze({ 255, 206, 112 }),
        pulseLifetime = 1.25,
        minimumRadius = 10,
    }),
    profession_medic = table.freeze({
        professionId = "profession_medic",
        motif = "brightcap_bloom",
        color = table.freeze({ 176, 108, 112 }),
        accent = table.freeze({ 214, 238, 190 }),
        pulseLifetime = 1.4,
        minimumRadius = 10,
    }),
}

function ProfessionAbilityVisuals.get(professionId: any): Definition?
    return if type(professionId) == "string" then DEFINITIONS[professionId] else nil
end

function ProfessionAbilityVisuals.list(): { Definition }
    local result = {}
    for _, definition in DEFINITIONS do
        table.insert(result, definition)
    end
    table.sort(result, function(a, b)
        return a.professionId < b.professionId
    end)
    return result
end

return table.freeze(ProfessionAbilityVisuals)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ProfessionCatalog</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = {}

export type Definition = {
    id: string,
    displayName: string,
    shortName: string,
    role: string,
    abilityId: string,
    abilityName: string,
    abilityDescription: string,
    cooldownSeconds: number,
    activeSeconds: number,
    effectAmount: number,
    effectRadius: number,
}

local ORDER = table.freeze({
    "profession_scout",
    "profession_warden",
    "profession_engineer",
    "profession_medic",
})

local DEFINITIONS: { [string]: Definition } = {
    profession_scout = table.freeze({
        id = "profession_scout",
        displayName = "SCOUT",
        shortName = "SCOUT",
        role = "TRACK · REVEAL · SLOW",
        abilityId = "ability_foxfire_mark",
        abilityName = "FOXFIRE MARK",
        abilityDescription = "Mark and slow the nearest Rootling for the whole team.",
        cooldownSeconds = 16,
        activeSeconds = 8,
        effectAmount = 35,
        effectRadius = 55,
    }),
    profession_warden = table.freeze({
        id = "profession_warden",
        displayName = "WARDEN",
        shortName = "WARDEN",
        role = "GUARD · HOLD · PROTECT",
        abilityId = "ability_lantern_guard",
        abilityName = "LANTERN GUARD",
        abilityDescription = "Reduce incoming Rootling damage for a short window.",
        cooldownSeconds = 20,
        activeSeconds = 6,
        effectAmount = 60,
        effectRadius = 0,
    }),
    profession_engineer = table.freeze({
        id = "profession_engineer",
        displayName = "ENGINEER",
        shortName = "ENGINEER",
        role = "REPAIR · BUILD · CONTROL",
        abilityId = "ability_emergency_patch",
        abilityName = "EMERGENCY PATCH",
        abilityDescription = "Restore the First Lantern while defending it nearby.",
        cooldownSeconds = 18,
        activeSeconds = 0,
        effectAmount = 18,
        effectRadius = 30,
    }),
    profession_medic = table.freeze({
        id = "profession_medic",
        displayName = "MEDIC",
        shortName = "MEDIC",
        role = "HEAL · RESCUE · SUSTAIN",
        abilityId = "ability_guiding_pulse",
        abilityName = "GUIDING PULSE",
        abilityDescription = "Heal yourself and active allies in a nearby pulse.",
        cooldownSeconds = 24,
        activeSeconds = 0,
        effectAmount = 22,
        effectRadius = 28,
    }),
}

function ProfessionCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function ProfessionCatalog.get(id: string): Definition?
    return DEFINITIONS[id]
end

function ProfessionCatalog.list(): { Definition }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

ProfessionCatalog.Ids = table.freeze({
    Scout = "profession_scout",
    Warden = "profession_warden",
    Engineer = "profession_engineer",
    Medic = "profession_medic",
})

return table.freeze(ProfessionCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">ProfessionMastery</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = require("./ProfessionCatalog")

local ProfessionMastery = {}

export type Entry = {
    xp: number,
    level: number,
    specializationId: string?,
}

export type State = { [string]: Entry }

export type Specialization = {
    id: string,
    name: string,
    description: string,
    effectAmountBonus: number?,
    effectRadiusBonus: number?,
    activeSecondsBonus: number?,
    cooldownReduction: number?,
    rescueDurationMultiplier: number?,
    rescueHealthBonus: number?,
    rescueWardBonus: number?,
}

local MAX_LEVEL = 10
local XP_PER_LEVEL = 100
local MAX_XP = MAX_LEVEL * XP_PER_LEVEL

local RANKS = table.freeze({
    table.freeze({ level = 1, name = "INITIATE" }),
    table.freeze({ level = 2, name = "KEEPER" }),
    table.freeze({ level = 4, name = "ADEPT" }),
    table.freeze({ level = 6, name = "VETERAN" }),
    table.freeze({ level = 8, name = "LUMINARY" }),
    table.freeze({ level = 10, name = "MASTER" }),
})

local function specialization(definition: any): Specialization
    return table.freeze({
        id = assert(definition.id, "specialization ID is required"),
        name = assert(definition.name, "specialization name is required"),
        description = assert(definition.description, "specialization description is required"),
        effectAmountBonus = tonumber(definition.effectAmountBonus) or 0,
        effectRadiusBonus = tonumber(definition.effectRadiusBonus) or 0,
        activeSecondsBonus = tonumber(definition.activeSecondsBonus) or 0,
        cooldownReduction = tonumber(definition.cooldownReduction) or 0,
        rescueDurationMultiplier = tonumber(definition.rescueDurationMultiplier) or 1,
        rescueHealthBonus = tonumber(definition.rescueHealthBonus) or 0,
        rescueWardBonus = tonumber(definition.rescueWardBonus) or 0,
    })
end

local SPECIALIZATIONS: { [string]: { Specialization } } = table.freeze({
    profession_scout = table.freeze({
        specialization({
            id = "specialization_pathfinder",
            name = "PATHFINDER",
            description = "Foxfire Mark reaches 8 studs farther.",
            effectRadiusBonus = 8,
        }),
        specialization({
            id = "specialization_foxfire_trapper",
            name = "FOXFIRE TRAPPER",
            description = "Foxfire Mark lasts 3 seconds longer.",
            activeSecondsBonus = 3,
        }),
        specialization({
            id = "specialization_trailseer",
            name = "TRAILSEER",
            description = "Foxfire Mark recharges 4 seconds faster.",
            cooldownReduction = 4,
        }),
    }),
    profession_warden = table.freeze({
        specialization({
            id = "specialization_bulwark",
            name = "BULWARK",
            description = "Lantern Guard reduces 10% more incoming damage.",
            effectAmountBonus = 10,
        }),
        specialization({
            id = "specialization_greenkeeper",
            name = "GREENKEEPER",
            description = "Lantern Guard lasts 3 seconds longer.",
            activeSecondsBonus = 3,
        }),
        specialization({
            id = "specialization_oathbound",
            name = "OATHBOUND",
            description = "Warden rescues grant 1.5 more ward seconds.",
            rescueWardBonus = 1.5,
        }),
    }),
    profession_engineer = table.freeze({
        specialization({
            id = "specialization_lamplighter",
            name = "LAMPLIGHTER",
            description = "Emergency Patch restores 10 more lantern health.",
            effectAmountBonus = 10,
        }),
        specialization({
            id = "specialization_rootwright",
            name = "ROOTWRIGHT",
            description = "Emergency Patch reaches 10 studs farther.",
            effectRadiusBonus = 10,
        }),
        specialization({
            id = "specialization_salvager",
            name = "SALVAGER",
            description = "Emergency Patch recharges 5 seconds faster.",
            cooldownReduction = 5,
        }),
    }),
    profession_medic = table.freeze({
        specialization({
            id = "specialization_dawnmender",
            name = "DAWNMENDER",
            description = "Guiding Pulse restores 10 more health.",
            effectAmountBonus = 10,
        }),
        specialization({
            id = "specialization_wayhome_tender",
            name = "WAYHOME TENDER",
            description = "Medic rescues are faster and restore 8 more health.",
            rescueDurationMultiplier = 0.82,
            rescueHealthBonus = 8,
        }),
        specialization({
            id = "specialization_brightcap_herbalist",
            name = "BRIGHTCAP HERBALIST",
            description = "Guiding Pulse reaches 10 studs farther.",
            effectRadiusBonus = 10,
        }),
    }),
})

local SPECIALIZATION_PROFESSIONS: { [string]: string } = {}
for professionId, definitions in SPECIALIZATIONS do
    for _, definition in definitions do
        assert(
            SPECIALIZATION_PROFESSIONS[definition.id] == nil,
            "duplicate specialization ID: " .. definition.id
        )
        SPECIALIZATION_PROFESSIONS[definition.id] = professionId
    end
end

local function specializationBonus(definition: any, field: string): number
    if definition == nil then
        return 0
    end
    return tonumber(definition[field]) or 0
end

local function levelForXp(xp: number): number
    return math.clamp(math.floor(xp / XP_PER_LEVEL) + 1, 1, MAX_LEVEL)
end

local function rankName(level: number): string
    local name = RANKS[1].name
    for _, rank in RANKS do
        if level >= rank.level then
            name = rank.name
        end
    end
    return name
end

function ProfessionMastery.default(): State
    return {}
end

function ProfessionMastery.normalize(value: any): State
    local result: State = {}
    if type(value) ~= "table" then
        return result
    end
    for _, definition in ProfessionCatalog.list() do
        local raw = value[definition.id]
        if type(raw) == "table" then
            local xp = if type(raw.xp) == "number"
                then math.clamp(math.floor(raw.xp), 0, MAX_XP)
                else 0
            local level = levelForXp(xp)
            local specializationId = if level >= MAX_LEVEL
                    and type(raw.specializationId) == "string"
                    and SPECIALIZATION_PROFESSIONS[raw.specializationId] == definition.id
                then raw.specializationId
                else nil
            result[definition.id] = {
                xp = xp,
                level = level,
                specializationId = specializationId,
            }
        end
    end
    return result
end

function ProfessionMastery.award(state: State, professionId: any, amount: number): (State, any)
    if not ProfessionCatalog.isValid(professionId) or type(amount) ~= "number" or amount <= 0 then
        return state, { applied = false, reason = "invalid_mastery_award" }
    end
    local nextState = ProfessionMastery.normalize(state)
    local current = nextState[professionId]
        or {
            xp = 0,
            level = 1,
            specializationId = nil,
        }
    local nextXp = math.min(MAX_XP, current.xp + math.floor(amount))
    local nextLevel = levelForXp(nextXp)
    nextState[professionId] = {
        xp = nextXp,
        level = nextLevel,
        specializationId = current.specializationId,
    }
    return nextState,
        {
            applied = true,
            professionId = professionId,
            xp = nextXp,
            level = nextLevel,
            rankName = rankName(nextLevel),
            leveledUp = nextLevel > current.level,
            specializationUnlocked = current.level < MAX_LEVEL and nextLevel == MAX_LEVEL,
        }
end

function ProfessionMastery.selectSpecialization(
    state: State,
    professionId: any,
    specializationId: any
): (State, any)
    if not ProfessionCatalog.isValid(professionId) then
        return state, { applied = false, reason = "unknown_profession" }
    end
    if
        type(specializationId) ~= "string"
        or SPECIALIZATION_PROFESSIONS[specializationId] ~= professionId
    then
        return state, { applied = false, reason = "invalid_specialization" }
    end
    local normalized = ProfessionMastery.normalize(state)
    local current = normalized[professionId] or { xp = 0, level = 1, specializationId = nil }
    if current.level < MAX_LEVEL then
        return state, { applied = false, reason = "specialization_locked" }
    end
    if current.specializationId == specializationId then
        return state,
            {
                applied = false,
                duplicate = true,
                professionId = professionId,
                reason = "already_selected",
                specializationId = specializationId,
            }
    end
    local nextState = table.clone(normalized)
    nextState[professionId] = {
        xp = current.xp,
        level = current.level,
        specializationId = specializationId,
    }
    return nextState,
        {
            applied = true,
            professionId = professionId,
            specializationId = specializationId,
        }
end

function ProfessionMastery.specializationProfession(specializationId: any): string?
    return if type(specializationId) == "string"
        then SPECIALIZATION_PROFESSIONS[specializationId]
        else nil
end

function ProfessionMastery.specializationDefinition(specializationId: any): any
    local professionId = ProfessionMastery.specializationProfession(specializationId)
    if professionId == nil then
        return nil
    end
    for _, definition in SPECIALIZATIONS[professionId] do
        if definition.id == specializationId then
            return definition
        end
    end
    return nil
end

function ProfessionMastery.specializationIds(): { string }
    local result = {}
    for _, profession in ProfessionCatalog.list() do
        for _, definition in SPECIALIZATIONS[profession.id] do
            table.insert(result, definition.id)
        end
    end
    return result
end

function ProfessionMastery.tuning(state: State, professionId: any): any
    local normalized = ProfessionMastery.normalize(state)
    local entry = if ProfessionCatalog.isValid(professionId)
        then normalized[professionId] or { xp = 0, level = 1, specializationId = nil }
        else { xp = 0, level = 1, specializationId = nil }
    local rewardSteps = math.floor(entry.level / 2)
    local selectedSpecialization =
        ProfessionMastery.specializationDefinition(entry.specializationId)
    return {
        level = entry.level,
        rankName = rankName(entry.level),
        effectAmountBonus = rewardSteps * 2
            + specializationBonus(selectedSpecialization, "effectAmountBonus"),
        effectRadiusBonus = rewardSteps * 1.5
            + specializationBonus(selectedSpecialization, "effectRadiusBonus"),
        activeSecondsBonus = rewardSteps * 0.35
            + specializationBonus(selectedSpecialization, "activeSecondsBonus"),
        cooldownReduction = rewardSteps * 0.4
            + specializationBonus(selectedSpecialization, "cooldownReduction"),
        rescueDurationMultiplier = if selectedSpecialization == nil
            then 1
            else selectedSpecialization.rescueDurationMultiplier or 1,
        rescueHealthBonus = if selectedSpecialization == nil
            then 0
            else selectedSpecialization.rescueHealthBonus or 0,
        rescueWardBonus = if selectedSpecialization == nil
            then 0
            else selectedSpecialization.rescueWardBonus or 0,
        specialization = selectedSpecialization,
        specializationId = entry.specializationId,
        specializationUnlocked = entry.level >= MAX_LEVEL,
        specializationUnlockLevel = MAX_LEVEL,
        specializations = if ProfessionCatalog.isValid(professionId)
            then SPECIALIZATIONS[professionId]
            else {},
    }
end

function ProfessionMastery.snapshot(state: State): { [string]: any }
    local normalized = ProfessionMastery.normalize(state)
    local result = {}
    for _, definition in ProfessionCatalog.list() do
        local entry = normalized[definition.id] or { xp = 0, level = 1, specializationId = nil }
        local tuning = ProfessionMastery.tuning(normalized, definition.id)
        result[definition.id] = {
            xp = entry.xp,
            level = entry.level,
            rankName = tuning.rankName,
            currentLevelXp = (entry.level - 1) * XP_PER_LEVEL,
            nextLevelXp = if entry.level >= MAX_LEVEL then MAX_XP else entry.level * XP_PER_LEVEL,
            effectAmountBonus = tuning.effectAmountBonus,
            effectRadiusBonus = tuning.effectRadiusBonus,
            activeSecondsBonus = tuning.activeSecondsBonus,
            cooldownReduction = tuning.cooldownReduction,
            specialization = tuning.specialization,
            specializationId = tuning.specializationId,
            specializationUnlocked = tuning.specializationUnlocked,
            specializationUnlockLevel = tuning.specializationUnlockLevel,
            specializations = tuning.specializations,
        }
    end
    return result
end

ProfessionMastery.MaxLevel = MAX_LEVEL
ProfessionMastery.MaxXp = MAX_XP
ProfessionMastery.Ranks = RANKS
ProfessionMastery.Specializations = SPECIALIZATIONS
ProfessionMastery.XpPerLevel = XP_PER_LEVEL

return table.freeze(ProfessionMastery)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">ProfessionRescue</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionRescue = {}

local MAX_LEVEL = 10

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function safeLevel(value: any): number
    return if finite(value) then math.clamp(math.floor(value), 1, MAX_LEVEL) else 1
end

function ProfessionRescue.resolve(
    professionId: any,
    level: any,
    baseDuration: number,
    baseHealth: number,
    baseWardSeconds: number,
    specializationTuning: any?
): any
    assert(finite(baseDuration) and baseDuration > 0, "base revive duration is invalid")
    assert(finite(baseHealth) and baseHealth > 0, "base revive health is invalid")
    assert(finite(baseWardSeconds) and baseWardSeconds >= 0, "base revive ward is invalid")

    local normalizedLevel = safeLevel(level)
    local masterySteps = math.floor(normalizedLevel / 2)
    local duration = baseDuration
    local health = baseHealth
    local wardSeconds = baseWardSeconds
    local rescueTitle = "FIELD RESCUE"
    local specialized = false

    if professionId == "profession_medic" then
        duration = baseDuration * (0.72 - masterySteps * 0.015)
        health = baseHealth + 10 + masterySteps * 2
        wardSeconds = baseWardSeconds + 0.75 + masterySteps * 0.15
        rescueTitle = "MEDIC RESCUE"
        specialized = true
    elseif professionId == "profession_warden" then
        wardSeconds = baseWardSeconds + 0.5 + masterySteps * 0.1
        rescueTitle = "WARDEN ESCORT"
        specialized = true
    end

    if type(specializationTuning) == "table" then
        local durationMultiplier = if finite(specializationTuning.rescueDurationMultiplier)
            then math.clamp(specializationTuning.rescueDurationMultiplier, 0.7, 1)
            else 1
        local healthBonus = if finite(specializationTuning.rescueHealthBonus)
            then math.clamp(math.floor(specializationTuning.rescueHealthBonus), 0, 12)
            else 0
        local wardBonus = if finite(specializationTuning.rescueWardBonus)
            then math.clamp(specializationTuning.rescueWardBonus, 0, 2)
            else 0
        duration *= durationMultiplier
        health += healthBonus
        wardSeconds += wardBonus
    end

    return table.freeze({
        duration = math.clamp(duration, 1.25, baseDuration),
        health = math.clamp(math.floor(health), baseHealth, 65),
        level = normalizedLevel,
        professionId = if type(professionId) == "string" then professionId else nil,
        rescueTitle = rescueTitle,
        specialized = specialized,
        wardSeconds = math.clamp(wardSeconds, baseWardSeconds, 6),
    })
end

return table.freeze(ProfessionRescue)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">ProfessionState</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = require("./ProfessionCatalog")

local ProfessionState = {}

export type State = {
    selectedId: string?,
    cooldownReadyAt: number,
    activeUntil: number,
    revision: number,
}

local function validNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function ProfessionState.create(selectedId: string?, now: number): State
    assert(validNumber(now), "profession state time is invalid")
    return {
        selectedId = if ProfessionCatalog.isValid(selectedId) then selectedId else nil,
        cooldownReadyAt = now,
        activeUntil = now,
        revision = 0,
    }
end

function ProfessionState.select(
    state: State,
    professionId: string,
    now: number,
    canSwitch: boolean
): (State, any)
    if not ProfessionCatalog.isValid(professionId) then
        return state,
            {
                accepted = false,
                changed = false,
                reason = "unknown_profession",
            }
    end
    if not canSwitch then
        return state,
            {
                accepted = false,
                changed = false,
                reason = "switch_unavailable",
            }
    end
    if state.selectedId == professionId then
        return state,
            {
                accepted = true,
                changed = false,
                reason = "already_selected",
            }
    end

    local nextState: State = table.clone(state)
    nextState.selectedId = professionId
    nextState.cooldownReadyAt = math.max(state.cooldownReadyAt, now)
    nextState.activeUntil = now
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            changed = true,
            reason = "selected",
        }
end

function ProfessionState.canUse(state: State, now: number, canAct: boolean): any
    if not canAct then
        return {
            accepted = false,
            reason = "player_cannot_act",
        }
    end
    local professionId = state.selectedId
    if professionId == nil then
        return {
            accepted = false,
            reason = "profession_required",
        }
    end
    local definition = ProfessionCatalog.get(professionId)
    if definition == nil then
        return {
            accepted = false,
            reason = "unknown_profession",
        }
    end
    if now < state.cooldownReadyAt then
        return {
            accepted = false,
            reason = "cooldown",
            remaining = state.cooldownReadyAt - now,
        }
    end
    return {
        accepted = true,
        definition = definition,
    }
end

function ProfessionState.commitAbility(
    state: State,
    now: number,
    cooldownSeconds: number?,
    activeSeconds: number?
): (State, any)
    local professionId = state.selectedId
    local definition = if professionId == nil then nil else ProfessionCatalog.get(professionId)
    assert(definition ~= nil, "cannot commit a profession ability without a valid profession")

    local nextState: State = table.clone(state)
    local resolvedCooldown = if cooldownSeconds ~= nil
            and validNumber(cooldownSeconds)
            and cooldownSeconds >= 1
        then cooldownSeconds
        else definition.cooldownSeconds
    local resolvedActive = if activeSeconds ~= nil
            and validNumber(activeSeconds)
            and activeSeconds >= 0
        then activeSeconds
        else definition.activeSeconds
    nextState.cooldownReadyAt = now + resolvedCooldown
    nextState.activeUntil = now + resolvedActive
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            abilityId = definition.abilityId,
            activeUntil = nextState.activeUntil,
            cooldownReadyAt = nextState.cooldownReadyAt,
        }
end

function ProfessionState.mitigatesDamage(state: State, now: number): boolean
    return state.selectedId == ProfessionCatalog.Ids.Warden and now < state.activeUntil
end

function ProfessionState.snapshot(state: State, now: number): any
    local definition = if state.selectedId == nil
        then nil
        else ProfessionCatalog.get(state.selectedId)
    return {
        selectedId = state.selectedId,
        displayName = if definition == nil then nil else definition.displayName,
        abilityId = if definition == nil then nil else definition.abilityId,
        abilityName = if definition == nil then nil else definition.abilityName,
        abilityDescription = if definition == nil then nil else definition.abilityDescription,
        cooldownReadyAt = state.cooldownReadyAt,
        cooldownSeconds = if definition == nil then 0 else definition.cooldownSeconds,
        activeUntil = state.activeUntil,
        ready = definition ~= nil and now >= state.cooldownReadyAt,
        revision = state.revision,
    }
end

return table.freeze(ProfessionState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">QuestCatalog</string>
          <string name="Source"><![CDATA[--!strict

local QuestCatalog = {}

export type Objective = {
    kind: string,
    threshold: number,
}

export type Reward = {
    materialId: string,
    amount: number,
}

export type Quest = {
    id: string,
    displayName: string,
    objective: Objective,
    reward: Reward,
}

local ORDER = table.freeze({
    "quest_survive_three_nights",
    "quest_first_craft",
    "quest_bramblewake_veteran",
})

local DEFINITIONS: { [string]: Quest } = {
    quest_survive_three_nights = table.freeze({
        id = "quest_survive_three_nights",
        displayName = "THREE NIGHTS SURVIVED",
        objective = table.freeze({ kind = "survive_nights", threshold = 3 }),
        reward = table.freeze({ materialId = "material_heartwood", amount = 5 }),
    }),
    quest_first_craft = table.freeze({
        id = "quest_first_craft",
        displayName = "FIRST CRAFT",
        objective = table.freeze({ kind = "craft_items", threshold = 1 }),
        reward = table.freeze({ materialId = "material_amber_sap", amount = 3 }),
    }),
    quest_bramblewake_veteran = table.freeze({
        id = "quest_bramblewake_veteran",
        displayName = "BRAMBLEWAKE VETERAN",
        objective = table.freeze({ kind = "bramblewake_settlements", threshold = 3 }),
        reward = table.freeze({ materialId = "material_brightcap", amount = 3 }),
    }),
}

function QuestCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function QuestCatalog.get(id: string): Quest?
    return DEFINITIONS[id]
end

function QuestCatalog.list(): { Quest }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

return table.freeze(QuestCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[--!strict

local QuestCatalog = require("./QuestCatalog")

local Quests = {}

export type Signals = {
    nightsSurvived: number,
    craftedItems: number,
    bramblewakeSettlements: number,
}

local function currentValue(kind: string, signals: Signals): number
    if kind == "survive_nights" then
        return signals.nightsSurvived
    elseif kind == "craft_items" then
        return signals.craftedItems
    elseif kind == "bramblewake_settlements" then
        return signals.bramblewakeSettlements
    end
    return 0
end

function Quests.default(): { [string]: boolean }
    return {}
end

function Quests.normalizeClaimed(value: any): { [string]: boolean }
    local claimed: { [string]: boolean } = {}
    if type(value) ~= "table" then
        return claimed
    end
    for questId, isClaimed in value do
        if QuestCatalog.isValid(questId) and isClaimed == true then
            claimed[questId] = true
        end
    end
    return claimed
end

-- Progress is always read live from `signals`, never stored, so a quest
-- that briefly regresses (e.g. crafting an item and then using it up)
-- doesn't lose credit once already claimed — only the claimed set persists.
function Quests.progress(questId: string, signals: Signals): (number, number, boolean)
    if not QuestCatalog.isValid(questId) then
        return 0, 0, false
    end
    local quest = QuestCatalog.get(questId) :: QuestCatalog.Quest
    local current = currentValue(quest.objective.kind, signals)
    local threshold = quest.objective.threshold
    return current, threshold, current >= threshold
end

function Quests.snapshot(claimed: { [string]: boolean }, signals: Signals): { any }
    local result = {}
    for _, quest in QuestCatalog.list() do
        local current, threshold, complete = Quests.progress(quest.id, signals)
        table.insert(result, {
            claimed = claimed[quest.id] == true,
            complete = complete,
            displayName = quest.displayName,
            id = quest.id,
            progress = current,
            threshold = threshold,
        })
    end
    return result
end

-- Silently claims every not-yet-claimed quest whose objective is currently
-- met, granting each one's material reward. Called opportunistically after
-- any action that could move a signal (a night completing, a craft
-- succeeding, an expedition settling) rather than through an accept step.
-- Resident quest-givers surface this progress and its story context, so a quest that's already
-- satisfiable claims itself the moment it's checked.
function Quests.checkAndClaim(
    claimed: { [string]: boolean },
    materials: { [string]: number },
    signals: Signals
): ({ [string]: boolean }, { [string]: number }, { any })
    local claimedResults = {}
    local nextClaimed = claimed
    local nextMaterials = materials

    for _, quest in QuestCatalog.list() do
        if claimed[quest.id] ~= true then
            local _current, _threshold, complete = Quests.progress(quest.id, signals)
            if complete then
                if nextClaimed == claimed then
                    nextClaimed = table.clone(claimed)
                end
                if nextMaterials == materials then
                    nextMaterials = table.clone(materials)
                end
                nextClaimed[quest.id] = true
                nextMaterials[quest.reward.materialId] = (
                    nextMaterials[quest.reward.materialId] or 0
                ) + quest.reward.amount
                table.insert(claimedResults, {
                    displayName = quest.displayName,
                    questId = quest.id,
                    reward = table.clone(quest.reward),
                })
            end
        end
    end

    return nextClaimed, nextMaterials, claimedResults
end

return table.freeze(Quests)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--!strict

local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Limiter = typeof(setmetatable(
    {} :: {
        _rate: number,
        _burst: number,
        _buckets: { [string]: { tokens: number, updatedAt: number } },
    },
    RateLimiter
))

function RateLimiter.new(ratePerSecond: number, burst: number): Limiter
    assert(ratePerSecond > 0, "rate must be positive")
    assert(burst >= 1, "burst must be at least one")
    return setmetatable({
        _rate = ratePerSecond,
        _burst = burst,
        _buckets = {},
    }, RateLimiter)
end

function RateLimiter.allow(self: Limiter, key: string, now: number, cost: number?): boolean
    local requested = cost or 1
    if requested <= 0 then
        return true
    end

    local bucket = self._buckets[key]
    if bucket == nil then
        bucket = { tokens = self._burst, updatedAt = now }
        self._buckets[key] = bucket
    end

    local elapsed = math.max(0, now - bucket.updatedAt)
    bucket.tokens = math.min(self._burst, bucket.tokens + elapsed * self._rate)
    bucket.updatedAt = now

    if bucket.tokens < requested then
        return false
    end

    bucket.tokens -= requested
    return true
end

function RateLimiter.clear(self: Limiter, key: string)
    self._buckets[key] = nil
end

return table.freeze(RateLimiter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">ResidentDialogue</string>
          <string name="Source"><![CDATA[--!strict

local ResidentDialogue = {}

export type Response = {
    message: string,
    questId: string,
    state: string,
}

local RESIDENT_QUESTS = table.freeze({
    npc_tomas_reed = "quest_first_craft",
    npc_pip_wren = "quest_survive_three_nights",
    npc_ena_moss = "quest_bramblewake_veteran",
})

local RESIDENT_NAMES = table.freeze({
    npc_tomas_reed = "TOMAS",
    npc_pip_wren = "PIP",
    npc_ena_moss = "ENA",
})

local function questById(quests: any, questId: string): any
    if type(quests) ~= "table" then
        return nil
    end
    for _, quest in quests do
        if type(quest) == "table" and quest.id == questId then
            return quest
        end
    end
    return nil
end

local function completedStory(residentId: string, consequence: any): string
    local decision = if type(consequence) == "table" then consequence.decision else nil
    local wardenOutcome = if type(consequence) == "table" then consequence.wardenOutcome else nil
    if residentId == "npc_tomas_reed" then
        if decision == "restore_farmland" then
            return "THE RENEWED FIELDS NEED TOOLS AS MUCH AS SEED. KEEP THE BENCH BUSY."
        elseif decision == "wild_regrowth" then
            return "THE WILD GROVE GIVES LESS ON COMMAND, BUT MORE TO THOSE WHO LISTEN."
        elseif decision == "shared_agroforest" then
            return "FOREST AND FIELD ARE SHARING ONE TABLE NOW. THAT IS WORTH BUILDING FOR."
        end
        return "ONE GOOD TOOL CAN TURN A BAD NIGHT. KEEP MAKING WHAT THE TOWN NEEDS."
    elseif residentId == "npc_pip_wren" then
        if wardenOutcome == "preserved" then
            return "THE WARDEN LEFT OLD TRACKS OPEN. I HAVE MARKED THE SAFEST ONES."
        elseif wardenOutcome == "scarred" then
            return "THE SCARRED TRAILS SHIFT AFTER RAIN. FOLLOW THE FRESH AMBER MARKS."
        elseif wardenOutcome == "harmed" then
            return "THE FOREST IS WATCHING THE ROAD NOW. TRAVEL WITH LIGHT AND COMPANY."
        end
        return "THREE DAWNS PROVE A ROAD CAN HOLD. THE NEXT ONE STILL NEEDS A SCOUT."
    elseif decision == "restore_farmland" then
        return "I SAVED BRAMBLEWAKE SEED FOR THESE FURROWS. THE FIRST SHOOTS ARE YOURS TOO."
    elseif decision == "wild_regrowth" then
        return "THE GROVE IS CHOOSING ITS OWN SHAPE. WATCH WHERE THE BRIGHTCAPS RETURN."
    elseif decision == "shared_agroforest" then
        return "ROOT, CROP, AND LANTERN ARE GROWING TOGETHER. KEEP BRINGING PEOPLE HOME."
    end
    return "EVERY SAFE RETURN TEACHES THE GREENWARD HOW TO GROW AROUND US."
end

function ResidentDialogue.respond(residentId: any, quests: any, consequence: any): Response?
    if type(residentId) ~= "string" then
        return nil
    end
    local questId = RESIDENT_QUESTS[residentId]
    local residentName = RESIDENT_NAMES[residentId]
    if questId == nil or residentName == nil then
        return nil
    end

    local quest = questById(quests, questId)
    if quest == nil then
        return {
            message = residentName .. ": CHECK BACK WHEN THE GREENWARD RECORDS ARE READY.",
            questId = questId,
            state = "loading",
        }
    end
    if quest.claimed == true then
        return {
            message = residentName .. ": " .. completedStory(residentId, consequence),
            questId = questId,
            state = "story",
        }
    end

    local current = math.max(0, math.floor(tonumber(quest.progress) or 0))
    local threshold = math.max(1, math.floor(tonumber(quest.threshold) or 1))
    local guidance = if residentId == "npc_tomas_reed"
        then "CRAFT ONE USEFUL ITEM AT THE WORKBENCH"
        elseif residentId == "npc_pip_wren" then "HELP THE LANTERN ROAD SURVIVE THREE NIGHTS"
        else "RETURN SAFELY FROM BRAMBLEWAKE THREE TIMES"
    return {
        message = string.format(
            "%s: %s — %d/%d. I WILL MARK IT WHEN IT IS DONE.",
            residentName,
            guidance,
            math.min(current, threshold),
            threshold
        ),
        questId = questId,
        state = if current >= threshold then "ready" else "active",
    }
end

return table.freeze(ResidentDialogue)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">ReviveFlow</string>
          <string name="Source"><![CDATA[--!strict

local ReviveFlow = {}

export type Channel = {
    endsAt: number,
    reviverRevision: number,
    reviverUserId: number,
    startedAt: number,
    targetUserId: number,
}
export type Conditions = {
    reachable: boolean,
    reviverCanAct: boolean,
    reviverPresent: boolean,
    reviverRevision: number,
    targetDowned: boolean,
    targetPresent: boolean,
}
export type DecisionStatus = "cancel" | "complete" | "pending"
export type Decision = {
    elapsed: number?,
    reason: string?,
    remaining: number?,
    status: DecisionStatus,
}

local function finiteNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeNonNegative(value: any): boolean
    return finiteNumber(value) and value >= 0 and value == math.floor(value)
end

function ReviveFlow.create(
    targetUserId: number,
    reviverUserId: number,
    reviverRevision: number,
    now: number,
    duration: number
): Channel
    assert(wholeNonNegative(targetUserId), "target user ID is invalid")
    assert(wholeNonNegative(reviverUserId), "reviver user ID is invalid")
    assert(targetUserId ~= reviverUserId, "players cannot revive themselves")
    assert(wholeNonNegative(reviverRevision), "reviver revision is invalid")
    assert(finiteNumber(now), "revive start time is invalid")
    assert(finiteNumber(duration) and duration > 0, "revive duration is invalid")

    return table.freeze({
        endsAt = now + duration,
        reviverRevision = reviverRevision,
        reviverUserId = reviverUserId,
        startedAt = now,
        targetUserId = targetUserId,
    })
end

function ReviveFlow.evaluate(channel: Channel, now: number, conditions: Conditions): Decision
    assert(finiteNumber(now), "revive evaluation time is invalid")
    if conditions.targetPresent ~= true then
        return {
            reason = "target_left",
            status = "cancel",
        }
    end
    if conditions.reviverPresent ~= true then
        return {
            reason = "reviver_left",
            status = "cancel",
        }
    end
    if conditions.targetDowned ~= true then
        return {
            reason = "target_not_downed",
            status = "cancel",
        }
    end
    if conditions.reviverCanAct ~= true then
        return {
            reason = "reviver_cannot_act",
            status = "cancel",
        }
    end
    if conditions.reviverRevision ~= channel.reviverRevision then
        return {
            reason = "reviver_state_changed",
            status = "cancel",
        }
    end
    if conditions.reachable ~= true then
        return {
            reason = "revive_out_of_range",
            status = "cancel",
        }
    end
    if now >= channel.endsAt then
        return {
            elapsed = math.max(0, now - channel.startedAt),
            status = "complete",
        }
    end
    return {
        remaining = math.max(0, channel.endsAt - now),
        status = "pending",
    }
end

return table.freeze(ReviveFlow)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">RuntimeIds</string>
          <string name="Source"><![CDATA[--!strict

local ExpeditionEventFlow = require("./ExpeditionEventFlow")
local ProfessionMastery = require("./ProfessionMastery")

local professionSpecializationInteractionIds = {}
local professionSpecializationInteractionIdBySpecialization = {}
for _, specializationId in ProfessionMastery.specializationIds() do
    local interactionId = "mastery_" .. specializationId
    assert(
        professionSpecializationInteractionIdBySpecialization[specializationId] == nil,
        "duplicate profession specialization runtime ID: " .. specializationId
    )
    table.insert(professionSpecializationInteractionIds, interactionId)
    professionSpecializationInteractionIdBySpecialization[specializationId] = interactionId
end

local RuntimeIds = {
    FolderName = "LastLightRuntime",
    WorldName = "LastLightWorld",
    InteractionTag = "LastLightInteractable",
    AmbientMoteTag = "LastLightAmbientMote",
    AmbientMotionTag = "LastLightAmbientMotion",
    AmbientLightTag = "LastLightAmbientLight",
    AmbientSwayTag = "LastLightAmbientSway",
    ExpeditionModuleTag = "LastLightExpeditionModule",
    ExpeditionPointOfInterestTag = "LastLightExpeditionPOI",
    ExpeditionEventTag = "LastLightExpeditionEvent",
    ExpeditionEventStepTag = "LastLightExpeditionEventStep",
    ExpeditionExtractionTag = "LastLightExpeditionExtraction",
    ExpeditionEliteTag = "LastLightExpeditionElite",
    ExpeditionBossTag = "LastLightExpeditionBoss",
    ExpeditionBlackoutTag = "LastLightExpeditionBlackout",
    PlayerDownedTag = "LastLightPlayerDowned",
    eventInteractionId = ExpeditionEventFlow.interactionId,
    Remotes = table.freeze({
        ActionRequest = "ActionRequest",
        StateChanged = "StateChanged",
        GetState = "GetState",
    }),
    Actions = table.freeze({
        Rescue = "rescue",
        Gather = "gather",
        ChooseTool = "choose_tool",
        Build = "build",
        Prepare = "prepare",
        Reveal = "reveal",
        Interact = "interact",
        UseTool = "use_tool",
        Sprint = "sprint",
        Dodge = "dodge",
        ProfessionAbility = "profession_ability",
        SelectProfession = "select_profession",
        CompactHud = "compact_hud",
        ExpeditionEvent = "expedition_event",
        OldGrowthFire = "old_growth_fire",
        WardenStagChoice = "warden_stag_choice",
        BramblewakeBlackout = "bramblewake_blackout",
        Extract = "extract",
        Revive = "revive",
        CraftItem = "craft_item",
        UseGear = "use_gear",
        EquipGear = "equip_gear",
        OpenFieldBook = "open_field_book",
        TalkResident = "talk_resident",
        RepairTown = "repair_town",
        ResolveTownIncident = "resolve_town_incident",
        RecoverExpeditionCache = "recover_expedition_cache",
        SelectProfessionSpecialization = "select_profession_specialization",
    }),
    InteractionIds = table.freeze({
        Mara = "mara_rescue",
        Heartwood = "heartwood_gather",
        ToolAxe = "tool_axe",
        ToolHammer = "tool_hammer",
        ToolTorch = "tool_torch",
        Barricade = "barricade_build",
        Lantern = "first_lantern_prepare",
        Beacon = "bramblewake_reveal",
        Wayhome = "bramblewake_wayhome",
        OldGrowthFireSource = "old_growth_fire_source",
        OldGrowthHeart = "old_growth_root_heart",
        WardenStagRootNorth = "warden_stag_root_node_north",
        WardenStagRootEast = "warden_stag_root_node_east",
        WardenStagRootSouth = "warden_stag_root_node_south",
        WardenStagRootWest = "warden_stag_root_node_west",
        WardenStagAntlerLeft = "warden_stag_antler_left",
        WardenStagAntlerRight = "warden_stag_antler_right",
        BlackoutFireSource = "blackout_fire_source",
        BlackoutRootFarm = "blackout_root_farm",
        BlackoutRootMill = "blackout_root_mill",
        BlackoutRootCathedral = "blackout_root_cathedral",
        BlackoutDecisionFarmland = "blackout_decision_farmland",
        BlackoutDecisionWild = "blackout_decision_wild",
        BlackoutDecisionShared = "blackout_decision_shared",
        CraftMeadowSatchel = "craft_meadow_satchel_bench",
        CraftAmberCharm = "craft_amber_charm_bench",
        CraftIronrootHood = "craft_ironroot_hood_bench",
        CraftBrambleBoots = "craft_bramble_boots_bench",
        QuestBoard = "quest_board",
    }),
    ResidentInteractionIds = table.freeze({
        npc_tomas_reed = "resident_tomas_reed",
        npc_pip_wren = "resident_pip_wren",
        npc_ena_moss = "resident_ena_moss",
    }),
    TownRepairInteractionIds = table.freeze({
        "town_repair_archive",
        "town_repair_workshop",
        "town_repair_inn",
    }),
    ProfessionSpecializationInteractionIds = table.freeze(professionSpecializationInteractionIds),
    ProfessionSpecializationInteractionIdBySpecialization = table.freeze(
        professionSpecializationInteractionIdBySpecialization
    ),
}

return table.freeze(RuntimeIds)
]]></string>
        </Properties>
