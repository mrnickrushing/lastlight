    quest_harbour_ledger = table.freeze({
        id = "quest_harbour_ledger",
        residentId = "npc_alder_kine",
        displayName = "THE STORES IN BLACK",
        objective = table.freeze({ kind = "materials_banked", threshold = 200 }),
