  <Item class="StarterPlayer" referent="175">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="176">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
