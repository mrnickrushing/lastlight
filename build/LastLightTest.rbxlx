      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">BramblewakeEnemies</string>
          <string name="Source"><![CDATA[--!strict

local BramblewakeEnemies = {}

export type AttackShape = "circle" | "lane"
export type TargetMode = "lantern" | "player"
export type StatusEffect = "drowsy" | "spark_theft"

export type EnemyDefinition = {
    id: string,
    displayName: string,
    modelKey: string,
    health: number,
    speed: number,
    attackRange: number,
    attackCooldown: number,
    playerDamage: number,
    lanternDamage: number,
    strikeRange: number,
    strikeDamage: number,
    attackId: string,
    attackName: string,
    instruction: string,
    shape: AttackShape,
    radius: number?,
    width: number?,
    length: number?,
    windup: number,
    stationary: boolean,
    targetMode: TargetMode,
    frontShield: boolean,
    frontalStrikeDamage: number?,
    flankStrikeDamage: number?,
    statusEffect: StatusEffect?,
    statusDuration: number?,
    statusMultiplier: number?,
    statusLanternDamage: number?,
}

local function freezeDefinition(definition: EnemyDefinition): EnemyDefinition
    return table.freeze(definition)
end

local DEFINITIONS: { [string]: EnemyDefinition } = {
    enemy_rootling = freezeDefinition({
        id = "enemy_rootling",
        displayName = "Rootling",
        modelKey = "rootling",
        health = 100,
        speed = 7,
        attackRange = 9,
        attackCooldown = 2,
        playerDamage = 24,
        lanternDamage = 6,
        strikeRange = 9,
        strikeDamage = 34,
        attackId = "rootling_swipe",
        attackName = "ROOTLING SWIPE",
        instruction = "DODGE OUT OF THE RING",
        shape = "circle",
        radius = 7,
        width = nil,
        length = nil,
        windup = 0.9,
        stationary = false,
        targetMode = "lantern",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    enemy_briarback = freezeDefinition({
        id = "enemy_briarback",
        displayName = "Briarback",
        modelKey = "briarback",
        health = 120,
        speed = 5.6,
        attackRange = 10,
        attackCooldown = 2.2,
        playerDamage = 22,
        lanternDamage = 7,
        strikeRange = 10,
        strikeDamage = 34,
        attackId = "briarback_sweep",
        attackName = "BRIARBACK SWEEP",
        instruction = "CLEAR THE LANE · FLANK IT",
        shape = "lane",
        radius = nil,
        width = 8,
        length = 12,
        windup = 1.05,
        stationary = false,
        targetMode = "lantern",
        frontShield = true,
        frontalStrikeDamage = 8,
        flankStrikeDamage = 40,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    enemy_pollen_wisp = freezeDefinition({
        id = "enemy_pollen_wisp",
        displayName = "Pollen Wisp",
        modelKey = "pollen_wisp",
        health = 68,
        speed = 6.8,
        attackRange = 12,
        attackCooldown = 2.7,
        playerDamage = 12,
        lanternDamage = 4,
        strikeRange = 11,
        strikeDamage = 34,
        attackId = "pollen_sleep_cloud",
        attackName = "SLEEP CLOUD",
        instruction = "LEAVE THE CLOUD",
        shape = "circle",
        radius = 10,
        width = nil,
        length = nil,
        windup = 1.25,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "drowsy",
        statusDuration = 3,
        statusMultiplier = 0.65,
        statusLanternDamage = nil,
    }),
    enemy_hollow_crow = freezeDefinition({
        id = "enemy_hollow_crow",
        displayName = "Hollow Crow",
        modelKey = "hollow_crow",
        health = 60,
        speed = 9,
        attackRange = 13,
        attackCooldown = 1.9,
        playerDamage = 10,
        lanternDamage = 5,
        strikeRange = 12,
        strikeDamage = 34,
        attackId = "hollow_crow_swoop",
        attackName = "CROW SWOOP",
        instruction = "STEP OUT OF THE FLIGHT PATH",
        shape = "lane",
        radius = nil,
