      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">ProfessionCatalog</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = {}

export type Definition = {
    id: string,
    displayName: string,
    shortName: string,
    role: string,
    abilityId: string,
    abilityName: string,
    abilityDescription: string,
    cooldownSeconds: number,
    activeSeconds: number,
    effectAmount: number,
    effectRadius: number,
}

local ORDER = table.freeze({
    "profession_scout",
    "profession_warden",
    "profession_engineer",
    "profession_medic",
    "profession_alchemist",
    "profession_beastkeeper",
    "profession_runebinder",
})

local DEFINITIONS: { [string]: Definition } = {
    profession_scout = table.freeze({
        id = "profession_scout",
        displayName = "SCOUT",
        shortName = "SCOUT",
        role = "TRACK · REVEAL · SLOW",
        abilityId = "ability_foxfire_mark",
        abilityName = "FOXFIRE MARK",
        abilityDescription = "Mark and slow the nearest Rootling for the whole team.",
        cooldownSeconds = 16,
        activeSeconds = 8,
        effectAmount = 35,
        effectRadius = 55,
    }),
    profession_warden = table.freeze({
        id = "profession_warden",
        displayName = "WARDEN",
        shortName = "WARDEN",
        role = "GUARD · HOLD · PROTECT",
        abilityId = "ability_lantern_guard",
        abilityName = "LANTERN GUARD",
        abilityDescription = "Reduce incoming Rootling damage for a short window.",
        cooldownSeconds = 20,
        activeSeconds = 6,
        effectAmount = 60,
        effectRadius = 0,
    }),
    profession_engineer = table.freeze({
        id = "profession_engineer",
        displayName = "ENGINEER",
        shortName = "ENGINEER",
        role = "REPAIR · BUILD · CONTROL",
        abilityId = "ability_emergency_patch",
        abilityName = "EMERGENCY PATCH",
        abilityDescription = "Restore the First Lantern while defending it nearby.",
        cooldownSeconds = 18,
        activeSeconds = 0,
        effectAmount = 18,
        effectRadius = 30,
    }),
    profession_medic = table.freeze({
        id = "profession_medic",
        displayName = "MEDIC",
        shortName = "MEDIC",
        role = "HEAL · RESCUE · SUSTAIN",
        abilityId = "ability_guiding_pulse",
        abilityName = "GUIDING PULSE",
        abilityDescription = "Heal yourself and active allies in a nearby pulse.",
        cooldownSeconds = 24,
        activeSeconds = 0,
        effectAmount = 22,
        effectRadius = 28,
    }),
    --[[
        The final three of the seven-profession roster. Each maps onto an
        existing combat primitive rather than inventing a parallel system:
        the tonic is the Medic's radius pattern applied to stamina as well
        as health, the hound is enemy target selection with a preference,
        and the rune is the same held-state the mark's slow already uses,
        taken to a full stop. effectAmount doubles as the tonic's stamina
        number (its heal is derived as half), and activeSeconds is the
        hound's and rune's duration, so the mastery bonus fields mean the
        same thing here that they mean for the first four kits.
    ]]
    profession_alchemist = table.freeze({
        id = "profession_alchemist",
        displayName = "ALCHEMIST",
        shortName = "ALCHEMIST",
        role = "BREW · RESTORE · SUSTAIN",
        abilityId = "ability_sporebright_tonic",
        abilityName = "SPOREBRIGHT TONIC",
        abilityDescription = "Share a tonic that restores stamina and mends nearby allies.",
        cooldownSeconds = 22,
        activeSeconds = 0,
        effectAmount = 30,
        effectRadius = 26,
    }),
    profession_beastkeeper = table.freeze({
        id = "profession_beastkeeper",
        displayName = "BEASTKEEPER",
        shortName = "KEEPER",
        role = "BOND · LURE · PROTECT",
        abilityId = "ability_briar_hound",
        abilityName = "BRIAR HOUND",
        abilityDescription = "Send your hound to harry the threat so it hunts you instead.",
        cooldownSeconds = 20,
        activeSeconds = 7,
        effectAmount = 0,
        effectRadius = 50,
    }),
    profession_runebinder = table.freeze({
        id = "profession_runebinder",
        displayName = "RUNEBINDER",
        shortName = "BINDER",
        role = "BIND · STILL · WARD",
        abilityId = "ability_still_rune",
        abilityName = "STILL RUNE",
        abilityDescription = "Bind the threat in light, holding it still for a few breaths.",
        cooldownSeconds = 26,
        activeSeconds = 3.5,
        effectAmount = 0,
        effectRadius = 45,
    }),
}

function ProfessionCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function ProfessionCatalog.get(id: string): Definition?
    return DEFINITIONS[id]
end

function ProfessionCatalog.list(): { Definition }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

ProfessionCatalog.Ids = table.freeze({
    Scout = "profession_scout",
    Warden = "profession_warden",
    Engineer = "profession_engineer",
    Medic = "profession_medic",
    Alchemist = "profession_alchemist",
    Beastkeeper = "profession_beastkeeper",
    Runebinder = "profession_runebinder",
})

return table.freeze(ProfessionCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">ProfessionMastery</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = require("./ProfessionCatalog")

local ProfessionMastery = {}

export type Entry = {
    xp: number,
    level: number,
    specializationId: string?,
}

export type State = { [string]: Entry }

export type Specialization = {
    id: string,
    name: string,
    description: string,
    effectAmountBonus: number?,
    effectRadiusBonus: number?,
    activeSecondsBonus: number?,
    cooldownReduction: number?,
    rescueDurationMultiplier: number?,
    rescueHealthBonus: number?,
    rescueWardBonus: number?,
}

local MAX_LEVEL = 10
local XP_PER_LEVEL = 100
local MAX_XP = MAX_LEVEL * XP_PER_LEVEL

local RANKS = table.freeze({
    table.freeze({ level = 1, name = "INITIATE" }),
    table.freeze({ level = 2, name = "KEEPER" }),
    table.freeze({ level = 4, name = "ADEPT" }),
    table.freeze({ level = 6, name = "VETERAN" }),
    table.freeze({ level = 8, name = "LUMINARY" }),
    table.freeze({ level = 10, name = "MASTER" }),
})

local function specialization(definition: any): Specialization
    return table.freeze({
        id = assert(definition.id, "specialization ID is required"),
        name = assert(definition.name, "specialization name is required"),
        description = assert(definition.description, "specialization description is required"),
        effectAmountBonus = tonumber(definition.effectAmountBonus) or 0,
        effectRadiusBonus = tonumber(definition.effectRadiusBonus) or 0,
        activeSecondsBonus = tonumber(definition.activeSecondsBonus) or 0,
        cooldownReduction = tonumber(definition.cooldownReduction) or 0,
        rescueDurationMultiplier = tonumber(definition.rescueDurationMultiplier) or 1,
        rescueHealthBonus = tonumber(definition.rescueHealthBonus) or 0,
        rescueWardBonus = tonumber(definition.rescueWardBonus) or 0,
    })
end

local SPECIALIZATIONS: { [string]: { Specialization } } = table.freeze({
    profession_scout = table.freeze({
        specialization({
            id = "specialization_pathfinder",
            name = "PATHFINDER",
            description = "Foxfire Mark reaches 8 studs farther.",
            effectRadiusBonus = 8,
        }),
        specialization({
            id = "specialization_foxfire_trapper",
            name = "FOXFIRE TRAPPER",
            description = "Foxfire Mark lasts 3 seconds longer.",
            activeSecondsBonus = 3,
        }),
        specialization({
            id = "specialization_trailseer",
            name = "TRAILSEER",
            description = "Foxfire Mark recharges 4 seconds faster.",
            cooldownReduction = 4,
        }),
    }),
    profession_warden = table.freeze({
        specialization({
            id = "specialization_bulwark",
            name = "BULWARK",
            description = "Lantern Guard reduces 10% more incoming damage.",
            effectAmountBonus = 10,
        }),
        specialization({
            id = "specialization_greenkeeper",
            name = "GREENKEEPER",
            description = "Lantern Guard lasts 3 seconds longer.",
            activeSecondsBonus = 3,
        }),
        specialization({
            id = "specialization_oathbound",
            name = "OATHBOUND",
            description = "Warden rescues grant 1.5 more ward seconds.",
            rescueWardBonus = 1.5,
        }),
    }),
    profession_engineer = table.freeze({
        specialization({
            id = "specialization_lamplighter",
            name = "LAMPLIGHTER",
            description = "Emergency Patch restores 10 more lantern health.",
            effectAmountBonus = 10,
        }),
        specialization({
            id = "specialization_rootwright",
            name = "ROOTWRIGHT",
            description = "Emergency Patch reaches 10 studs farther.",
            effectRadiusBonus = 10,
        }),
        specialization({
            id = "specialization_salvager",
            name = "SALVAGER",
            description = "Emergency Patch recharges 5 seconds faster.",
            cooldownReduction = 5,
        }),
    }),
    profession_medic = table.freeze({
        specialization({
            id = "specialization_dawnmender",
            name = "DAWNMENDER",
            description = "Guiding Pulse restores 10 more health.",
            effectAmountBonus = 10,
        }),
        specialization({
            id = "specialization_wayhome_tender",
            name = "WAYHOME TENDER",
            description = "Medic rescues are faster and restore 8 more health.",
            rescueDurationMultiplier = 0.82,
            rescueHealthBonus = 8,
        }),
        specialization({
            id = "specialization_brightcap_herbalist",
            name = "BRIGHTCAP HERBALIST",
            description = "Guiding Pulse reaches 10 studs farther.",
            effectRadiusBonus = 10,
        }),
    }),
    profession_alchemist = table.freeze({
        specialization({
            id = "specialization_brewer",
            name = "BREWER",
            description = "Sporebright Tonic restores 8 more stamina and mends deeper.",
            effectAmountBonus = 8,
        }),
        specialization({
            id = "specialization_catalyst",
            name = "CATALYST",
            description = "Sporebright Tonic recharges 4 seconds faster.",
            cooldownReduction = 4,
        }),
        specialization({
            id = "specialization_forager",
            name = "FORAGER",
            description = "Sporebright Tonic reaches 8 studs farther.",
            effectRadiusBonus = 8,
        }),
    }),
    profession_beastkeeper = table.freeze({
        specialization({
            id = "specialization_handler",
            name = "HANDLER",
            description = "Briar Hound harries the threat 2.5 seconds longer.",
            activeSecondsBonus = 2.5,
        }),
        specialization({
            id = "specialization_bondkeeper",
            name = "BONDKEEPER",
            description = "Briar Hound can be sent 10 studs farther.",
            effectRadiusBonus = 10,
        }),
        specialization({
            id = "specialization_wildspeaker",
            name = "WILDSPEAKER",
            description = "Briar Hound recharges 4 seconds faster.",
            cooldownReduction = 4,
        }),
    }),
    profession_runebinder = table.freeze({
        specialization({
            id = "specialization_scribe",
            name = "SCRIBE",
            description = "Still Rune holds the threat 1.25 seconds longer.",
            activeSecondsBonus = 1.25,
        }),
        specialization({
            id = "specialization_channeler",
            name = "CHANNELER",
            description = "Still Rune can be cast 10 studs farther.",
            effectRadiusBonus = 10,
        }),
        specialization({
            id = "specialization_veilwalker",
            name = "VEILWALKER",
            description = "Still Rune recharges 5 seconds faster.",
            cooldownReduction = 5,
        }),
    }),
})

local SPECIALIZATION_PROFESSIONS: { [string]: string } = {}
for professionId, definitions in SPECIALIZATIONS do
    for _, definition in definitions do
        assert(
            SPECIALIZATION_PROFESSIONS[definition.id] == nil,
            "duplicate specialization ID: " .. definition.id
        )
        SPECIALIZATION_PROFESSIONS[definition.id] = professionId
    end
end

local function specializationBonus(definition: any, field: string): number
    if definition == nil then
        return 0
    end
    return tonumber(definition[field]) or 0
end

local function levelForXp(xp: number): number
    return math.clamp(math.floor(xp / XP_PER_LEVEL) + 1, 1, MAX_LEVEL)
end

local function rankName(level: number): string
    local name = RANKS[1].name
    for _, rank in RANKS do
        if level >= rank.level then
            name = rank.name
        end
    end
    return name
end

function ProfessionMastery.default(): State
    return {}
end

function ProfessionMastery.normalize(value: any): State
    local result: State = {}
    if type(value) ~= "table" then
        return result
    end
    for _, definition in ProfessionCatalog.list() do
        local raw = value[definition.id]
        if type(raw) == "table" then
            local xp = if type(raw.xp) == "number"
                then math.clamp(math.floor(raw.xp), 0, MAX_XP)
                else 0
            local level = levelForXp(xp)
            local specializationId = if level >= MAX_LEVEL
                    and type(raw.specializationId) == "string"
                    and SPECIALIZATION_PROFESSIONS[raw.specializationId] == definition.id
                then raw.specializationId
                else nil
            result[definition.id] = {
                xp = xp,
                level = level,
                specializationId = specializationId,
            }
        end
    end
    return result
end

function ProfessionMastery.award(state: State, professionId: any, amount: number): (State, any)
    if not ProfessionCatalog.isValid(professionId) or type(amount) ~= "number" or amount <= 0 then
        return state, { applied = false, reason = "invalid_mastery_award" }
    end
    local nextState = ProfessionMastery.normalize(state)
    local current = nextState[professionId]
        or {
            xp = 0,
            level = 1,
            specializationId = nil,
        }
    local nextXp = math.min(MAX_XP, current.xp + math.floor(amount))
    local nextLevel = levelForXp(nextXp)
    nextState[professionId] = {
        xp = nextXp,
        level = nextLevel,
        specializationId = current.specializationId,
    }
    return nextState,
        {
            applied = true,
            professionId = professionId,
            xp = nextXp,
            level = nextLevel,
            rankName = rankName(nextLevel),
            leveledUp = nextLevel > current.level,
            specializationUnlocked = current.level < MAX_LEVEL and nextLevel == MAX_LEVEL,
        }
end

function ProfessionMastery.selectSpecialization(
    state: State,
    professionId: any,
    specializationId: any
): (State, any)
    if not ProfessionCatalog.isValid(professionId) then
        return state, { applied = false, reason = "unknown_profession" }
    end
    if
        type(specializationId) ~= "string"
        or SPECIALIZATION_PROFESSIONS[specializationId] ~= professionId
    then
        return state, { applied = false, reason = "invalid_specialization" }
    end
    local normalized = ProfessionMastery.normalize(state)
    local current = normalized[professionId] or { xp = 0, level = 1, specializationId = nil }
    if current.level < MAX_LEVEL then
        return state, { applied = false, reason = "specialization_locked" }
    end
    if current.specializationId == specializationId then
        return state,
            {
                applied = false,
                duplicate = true,
                professionId = professionId,
                reason = "already_selected",
                specializationId = specializationId,
            }
    end
    local nextState = table.clone(normalized)
    nextState[professionId] = {
        xp = current.xp,
        level = current.level,
        specializationId = specializationId,
    }
    return nextState,
        {
            applied = true,
            professionId = professionId,
            specializationId = specializationId,
        }
end

function ProfessionMastery.specializationProfession(specializationId: any): string?
    return if type(specializationId) == "string"
        then SPECIALIZATION_PROFESSIONS[specializationId]
        else nil
end

function ProfessionMastery.specializationDefinition(specializationId: any): any
    local professionId = ProfessionMastery.specializationProfession(specializationId)
    if professionId == nil then
        return nil
    end
    for _, definition in SPECIALIZATIONS[professionId] do
        if definition.id == specializationId then
            return definition
        end
    end
    return nil
end

function ProfessionMastery.specializationIds(): { string }
    local result = {}
    for _, profession in ProfessionCatalog.list() do
        for _, definition in SPECIALIZATIONS[profession.id] do
            table.insert(result, definition.id)
        end
    end
    return result
end

function ProfessionMastery.tuning(state: State, professionId: any): any
    local normalized = ProfessionMastery.normalize(state)
    local entry = if ProfessionCatalog.isValid(professionId)
        then normalized[professionId] or { xp = 0, level = 1, specializationId = nil }
        else { xp = 0, level = 1, specializationId = nil }
    local rewardSteps = math.floor(entry.level / 2)
    local selectedSpecialization =
        ProfessionMastery.specializationDefinition(entry.specializationId)
    return {
        level = entry.level,
        rankName = rankName(entry.level),
        effectAmountBonus = rewardSteps * 2
            + specializationBonus(selectedSpecialization, "effectAmountBonus"),
        effectRadiusBonus = rewardSteps * 1.5
            + specializationBonus(selectedSpecialization, "effectRadiusBonus"),
        activeSecondsBonus = rewardSteps * 0.35
            + specializationBonus(selectedSpecialization, "activeSecondsBonus"),
        cooldownReduction = rewardSteps * 0.4
            + specializationBonus(selectedSpecialization, "cooldownReduction"),
        rescueDurationMultiplier = if selectedSpecialization == nil
            then 1
            else selectedSpecialization.rescueDurationMultiplier or 1,
        rescueHealthBonus = if selectedSpecialization == nil
            then 0
            else selectedSpecialization.rescueHealthBonus or 0,
        rescueWardBonus = if selectedSpecialization == nil
            then 0
            else selectedSpecialization.rescueWardBonus or 0,
        specialization = selectedSpecialization,
        specializationId = entry.specializationId,
        specializationUnlocked = entry.level >= MAX_LEVEL,
        specializationUnlockLevel = MAX_LEVEL,
        specializations = if ProfessionCatalog.isValid(professionId)
            then SPECIALIZATIONS[professionId]
            else {},
    }
end

function ProfessionMastery.snapshot(state: State): { [string]: any }
    local normalized = ProfessionMastery.normalize(state)
    local result = {}
    for _, definition in ProfessionCatalog.list() do
        local entry = normalized[definition.id] or { xp = 0, level = 1, specializationId = nil }
        local tuning = ProfessionMastery.tuning(normalized, definition.id)
        result[definition.id] = {
            xp = entry.xp,
            level = entry.level,
            rankName = tuning.rankName,
            currentLevelXp = (entry.level - 1) * XP_PER_LEVEL,
            nextLevelXp = if entry.level >= MAX_LEVEL then MAX_XP else entry.level * XP_PER_LEVEL,
            effectAmountBonus = tuning.effectAmountBonus,
            effectRadiusBonus = tuning.effectRadiusBonus,
            activeSecondsBonus = tuning.activeSecondsBonus,
            cooldownReduction = tuning.cooldownReduction,
            specialization = tuning.specialization,
            specializationId = tuning.specializationId,
            specializationUnlocked = tuning.specializationUnlocked,
            specializationUnlockLevel = tuning.specializationUnlockLevel,
            specializations = tuning.specializations,
        }
    end
    return result
end

ProfessionMastery.MaxLevel = MAX_LEVEL
ProfessionMastery.MaxXp = MAX_XP
ProfessionMastery.Ranks = RANKS
ProfessionMastery.Specializations = SPECIALIZATIONS
ProfessionMastery.XpPerLevel = XP_PER_LEVEL

return table.freeze(ProfessionMastery)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">ProfessionRescue</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionRescue = {}

local MAX_LEVEL = 10

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function safeLevel(value: any): number
    return if finite(value) then math.clamp(math.floor(value), 1, MAX_LEVEL) else 1
end

function ProfessionRescue.resolve(
    professionId: any,
    level: any,
    baseDuration: number,
    baseHealth: number,
    baseWardSeconds: number,
    specializationTuning: any?
): any
    assert(finite(baseDuration) and baseDuration > 0, "base revive duration is invalid")
    assert(finite(baseHealth) and baseHealth > 0, "base revive health is invalid")
    assert(finite(baseWardSeconds) and baseWardSeconds >= 0, "base revive ward is invalid")

    local normalizedLevel = safeLevel(level)
    local masterySteps = math.floor(normalizedLevel / 2)
    local duration = baseDuration
    local health = baseHealth
    local wardSeconds = baseWardSeconds
    local rescueTitle = "FIELD RESCUE"
    local specialized = false

    if professionId == "profession_medic" then
        duration = baseDuration * (0.72 - masterySteps * 0.015)
        health = baseHealth + 10 + masterySteps * 2
        wardSeconds = baseWardSeconds + 0.75 + masterySteps * 0.15
        rescueTitle = "MEDIC RESCUE"
        specialized = true
    elseif professionId == "profession_warden" then
        wardSeconds = baseWardSeconds + 0.5 + masterySteps * 0.1
        rescueTitle = "WARDEN ESCORT"
        specialized = true
    end

    if type(specializationTuning) == "table" then
        local durationMultiplier = if finite(specializationTuning.rescueDurationMultiplier)
            then math.clamp(specializationTuning.rescueDurationMultiplier, 0.7, 1)
            else 1
        local healthBonus = if finite(specializationTuning.rescueHealthBonus)
            then math.clamp(math.floor(specializationTuning.rescueHealthBonus), 0, 12)
            else 0
        local wardBonus = if finite(specializationTuning.rescueWardBonus)
            then math.clamp(specializationTuning.rescueWardBonus, 0, 2)
            else 0
        duration *= durationMultiplier
        health += healthBonus
        wardSeconds += wardBonus
    end

    return table.freeze({
        duration = math.clamp(duration, 1.25, baseDuration),
        health = math.clamp(math.floor(health), baseHealth, 65),
        level = normalizedLevel,
        professionId = if type(professionId) == "string" then professionId else nil,
        rescueTitle = rescueTitle,
        specialized = specialized,
        wardSeconds = math.clamp(wardSeconds, baseWardSeconds, 6),
    })
end

return table.freeze(ProfessionRescue)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="81">
        <Properties>
          <string name="Name">ProfessionState</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = require("./ProfessionCatalog")

local ProfessionState = {}

export type State = {
    selectedId: string?,
    cooldownReadyAt: number,
    activeUntil: number,
    revision: number,
}

local function validNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function ProfessionState.create(selectedId: string?, now: number): State
    assert(validNumber(now), "profession state time is invalid")
    return {
        selectedId = if ProfessionCatalog.isValid(selectedId) then selectedId else nil,
        cooldownReadyAt = now,
        activeUntil = now,
        revision = 0,
    }
end

function ProfessionState.select(
    state: State,
    professionId: string,
    now: number,
    canSwitch: boolean
): (State, any)
    if not ProfessionCatalog.isValid(professionId) then
        return state,
            {
                accepted = false,
                changed = false,
                reason = "unknown_profession",
            }
    end
    if not canSwitch then
        return state,
            {
                accepted = false,
                changed = false,
                reason = "switch_unavailable",
            }
    end
    if state.selectedId == professionId then
        return state,
            {
                accepted = true,
                changed = false,
                reason = "already_selected",
            }
    end

    local nextState: State = table.clone(state)
    nextState.selectedId = professionId
    nextState.cooldownReadyAt = math.max(state.cooldownReadyAt, now)
    nextState.activeUntil = now
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            changed = true,
            reason = "selected",
        }
end

function ProfessionState.canUse(state: State, now: number, canAct: boolean): any
    if not canAct then
        return {
            accepted = false,
            reason = "player_cannot_act",
        }
    end
    local professionId = state.selectedId
    if professionId == nil then
        return {
            accepted = false,
            reason = "profession_required",
        }
    end
    local definition = ProfessionCatalog.get(professionId)
    if definition == nil then
        return {
            accepted = false,
            reason = "unknown_profession",
        }
    end
    if now < state.cooldownReadyAt then
        return {
            accepted = false,
            reason = "cooldown",
            remaining = state.cooldownReadyAt - now,
        }
    end
    return {
        accepted = true,
        definition = definition,
    }
end

function ProfessionState.commitAbility(
    state: State,
    now: number,
    cooldownSeconds: number?,
    activeSeconds: number?
): (State, any)
    local professionId = state.selectedId
    local definition = if professionId == nil then nil else ProfessionCatalog.get(professionId)
    assert(definition ~= nil, "cannot commit a profession ability without a valid profession")

    local nextState: State = table.clone(state)
    local resolvedCooldown = if cooldownSeconds ~= nil
            and validNumber(cooldownSeconds)
            and cooldownSeconds >= 1
        then cooldownSeconds
        else definition.cooldownSeconds
    local resolvedActive = if activeSeconds ~= nil
            and validNumber(activeSeconds)
            and activeSeconds >= 0
        then activeSeconds
        else definition.activeSeconds
    nextState.cooldownReadyAt = now + resolvedCooldown
    nextState.activeUntil = now + resolvedActive
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            abilityId = definition.abilityId,
            activeUntil = nextState.activeUntil,
            cooldownReadyAt = nextState.cooldownReadyAt,
        }
end

function ProfessionState.mitigatesDamage(state: State, now: number): boolean
    return state.selectedId == ProfessionCatalog.Ids.Warden and now < state.activeUntil
end

function ProfessionState.snapshot(state: State, now: number): any
    local definition = if state.selectedId == nil
        then nil
        else ProfessionCatalog.get(state.selectedId)
    return {
        selectedId = state.selectedId,
        displayName = if definition == nil then nil else definition.displayName,
        abilityId = if definition == nil then nil else definition.abilityId,
        abilityName = if definition == nil then nil else definition.abilityName,
        abilityDescription = if definition == nil then nil else definition.abilityDescription,
        cooldownReadyAt = state.cooldownReadyAt,
        cooldownSeconds = if definition == nil then 0 else definition.cooldownSeconds,
        activeUntil = state.activeUntil,
        ready = definition ~= nil and now >= state.cooldownReadyAt,
        revision = state.revision,
    }
end

return table.freeze(ProfessionState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="82">
        <Properties>
          <string name="Name">ProfileBackup</string>
          <string name="Source"><![CDATA[--!strict

--[[
    When a save is copied aside, which copies are kept, and what a restore
    writes back.

    Milestone 4's persistence deliverable asks for "versioned profile, locking,
    autosave, shutdown, migrations, backups". Everything but the last of those
    already exists in ProfileService and ProfilePersistence. This module is the
    last one, and it is deliberately the same shape as ProfilePersistence: pure
    decisions about state, no DataStore, so the properties that matter can be
    tested rather than argued about.

    TECHNICAL_ARCHITECTURE names the requirement that drove the design: "Backups
    and export tooling are required before migrations that alter inventory or
    commerce." A migration in this codebase is not a numbered pipeline -- it is
    SaveSchema.normalize folding an older profile into the current default --
    which means a migration that drops a field drops it silently and leaves
    nothing behind to compare against. So the moment a stored profile arrives
    carrying a schema version other than the current one is the moment worth
    photographing, and `shouldCapture` treats it as unconditional.

    Two properties are load-bearing, and both are easy to get wrong in a way
    that is invisible until someone actually needs a restore:

      * **A restored profile must out-rank the profile it replaces.**
        ProfilePersistence.resolveWrite retains the stored copy whenever its
        revision is higher, which is exactly right for two servers racing and
        exactly wrong for a restore -- a restore is a deliberate move backwards
        in content and must still be a move forwards in revision, or it writes
        nothing and reports success.
      * **A snapshot never carries a session lock.** Locks ride along inside the
        saved profile so a crashed server leaves a heartbeat that stops. Copy one
        into a backup and a restore months later resurrects a lock held by a job
        that no longer exists, and the player is read-only until someone runs
        /unlock. Snapshots are stripped on the way in, not on the way out, so
        even a backup written by an older build cannot carry one through.
]]

local ProfileBackup = {}

export type Snapshot = {
    revision: number,
    capturedAt: number,
    schemaVersion: number,
    reason: string,
    profile: any,
}

export type Ring = {
    version: number,
    snapshots: { Snapshot },
}

export type CaptureDecision = {
    capture: boolean,
    reason: string,
}

-- Why a snapshot was taken. Kept as a closed set so an operator reading an
-- audit line sees one of a handful of known words rather than free text.
local CAPTURE_REASONS: { [string]: boolean } = table.freeze({
    schema_change = true,
    first_backup = true,
    interval = true,
    pre_restore = true,
})

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeAtLeast(value: any, low: number): boolean
    return finite(value) and value == math.floor(value) and value >= low
end

function ProfileBackup.default(): Ring
    return { version = 1, snapshots = {} }
end

function ProfileBackup.captureReasons(): { string }
    local reasons: { string } = {}
    for reason in CAPTURE_REASONS do
        table.insert(reasons, reason)
    end
    table.sort(reasons)
    return reasons
end

--[[
    Read whatever the backup key held into a ring this build understands.

    Forgiving in the same way SaveSchema.normalize is forgiving, and for the
    same reason: a backup that cannot be parsed must degrade to "no backups"
    rather than to an error, because the caller is usually a load path that has
    a player waiting on it. A malformed entry is dropped individually so one bad
    snapshot cannot cost a player the good ones sitting next to it.
]]
function ProfileBackup.normalize(value: any): Ring
    local ring = ProfileBackup.default()
    if type(value) ~= "table" or type(value.snapshots) ~= "table" then
        return ring
    end

    for _, candidate in value.snapshots do
        if
            type(candidate) == "table"
            and type(candidate.profile) == "table"
            and wholeAtLeast(candidate.revision, 0)
            and finite(candidate.capturedAt)
            and wholeAtLeast(candidate.schemaVersion, 1)
            and type(candidate.reason) == "string"
            and CAPTURE_REASONS[candidate.reason] == true
        then
            local profile = table.clone(candidate.profile)
            -- Defence in depth: strip on the way out as well as on the way in,
            -- so a snapshot written by a build that predates this rule cannot
            -- carry a dead lock into a restore.
            profile.sessionLock = nil
            table.insert(ring.snapshots, {
                revision = math.floor(candidate.revision),
                capturedAt = candidate.capturedAt,
                schemaVersion = math.floor(candidate.schemaVersion),
                reason = candidate.reason,
                profile = profile,
            })
        end
    end

    return ring
end

--[[
    Whether this save is worth copying aside right now.

    A backup on every autosave would double the write traffic of the busiest
    path in the game to photograph a profile that has usually not meaningfully
    changed, so ordinary captures are rate limited. A schema change is not
    ordinary and ignores the limit: it is the one moment where the old shape
    stops being recoverable from the new one.
]]
function ProfileBackup.shouldCapture(
    ring: any,
    storedSchemaVersion: any,
    currentSchemaVersion: number,
    now: number,
    interval: number
): CaptureDecision
    assert(
        wholeAtLeast(currentSchemaVersion, 1),
        "current schema version must be a positive whole number"
    )
    assert(finite(now), "capture time must be finite")
    assert(finite(interval) and interval > 0, "capture interval must be positive")

    -- An unreadable or absent stored schema version is treated as a change: it
    -- means the profile did not come from this build, which is precisely when a
    -- copy is worth having.
    if not wholeAtLeast(storedSchemaVersion, 1) or storedSchemaVersion ~= currentSchemaVersion then
        return { capture = true, reason = "schema_change" }
    end

    local normalized = ProfileBackup.normalize(ring)
    local newest = ProfileBackup.newest(normalized)
    if newest == nil then
        return { capture = true, reason = "first_backup" }
    end
    if now - newest.capturedAt >= interval then
        return { capture = true, reason = "interval" }
    end
    return { capture = false, reason = "recent_backup_exists" }
end

--[[
    Append a snapshot, dropping the oldest beyond `limit`.

    Returns a new ring; the input is never mutated, so a failed DataStore write
    cannot leave the caller holding a ring that claims a snapshot it never
    stored. The bound exists because a DataStore value has a hard size ceiling
    and a profile is not small -- an unbounded history would eventually fail
    every write to this key, silently taking backups down at the exact moment
    the save is growing fastest.
]]
function ProfileBackup.capture(
    ring: any,
    profile: any,
    now: number,
    reason: string,
    limit: number
): Ring
    assert(type(profile) == "table", "a snapshot needs a profile")
    assert(finite(now), "capture time must be finite")
    assert(CAPTURE_REASONS[reason] == true, "unknown capture reason: " .. tostring(reason))
    assert(wholeAtLeast(limit, 1), "retained backup count must be at least one")

    local normalized = ProfileBackup.normalize(ring)

    local copied = table.clone(profile)
    -- The lock belongs to the session that wrote the save, never to the copy.
    copied.sessionLock = nil

    local snapshot: Snapshot = {
        revision = if wholeAtLeast(profile.revision, 0) then math.floor(profile.revision) else 0,
        capturedAt = now,
        schemaVersion = if wholeAtLeast(profile.schemaVersion, 1)
            then math.floor(profile.schemaVersion)
            else 1,
        reason = reason,
        profile = copied,
    }

    local snapshots = table.clone(normalized.snapshots)
    table.insert(snapshots, snapshot)
    while #snapshots > limit do
        table.remove(snapshots, 1)
    end

    return { version = normalized.version, snapshots = snapshots }
end

-- The most recently captured snapshot, or nil when there are none.
function ProfileBackup.newest(ring: any): Snapshot?
    local normalized = if type(ring) == "table"
            and type(ring.snapshots) == "table"
            and ring.version ~= nil
        then ring :: Ring
        else ProfileBackup.normalize(ring)
    local count = #normalized.snapshots
    if count == 0 then
        return nil
    end
    return normalized.snapshots[count]
end

--[[
    A specific copy, 1 = the oldest kept. Bounded and explicit: an operator
    restoring history names the copy they read in /backups, and an index off
    either end is nil rather than a clamp -- silently restoring a different
    copy than the one asked for is the one unforgivable behaviour here.
]]
function ProfileBackup.snapshotAt(ring: any, index: number): Snapshot?
    local normalized = if type(ring) == "table"
            and type(ring.snapshots) == "table"
            and ring.version ~= nil
        then ring :: Ring
        else ProfileBackup.normalize(ring)
    if type(index) ~= "number" or index ~= math.floor(index) then
        return nil
    end
    return normalized.snapshots[index]
end

--[[
    The profile a restore should write.

    `storedRevision` is the revision currently sitting in the live profile key,
    not the one in the snapshot. The returned profile takes a revision above
    both, because a restore has to survive ProfilePersistence.resolveWrite --
    which, left to itself, would see an old revision arriving over a newer one
    and correctly refuse it. Getting this wrong produces the worst possible
    failure mode: a restore that logs success and changes nothing.
]]
function ProfileBackup.restoredProfile(snapshot: any, storedRevision: any, now: number): any
    assert(
        type(snapshot) == "table" and type(snapshot.profile) == "table",
        "a restore needs a snapshot"
    )
    assert(finite(now), "restore time must be finite")

    local restored = table.clone(snapshot.profile)
    restored.sessionLock = nil
    restored.updatedAt = now

    local snapshotRevision = if wholeAtLeast(snapshot.revision, 0) then snapshot.revision else 0
    local liveRevision = if wholeAtLeast(storedRevision, 0) then storedRevision else 0
    restored.revision = math.max(snapshotRevision, liveRevision) + 1

    return restored
end

--[[
    What an operator sees before deciding to restore.

    Deliberately counts and timestamps rather than profile contents: an admin
    choosing whether to roll a save back needs to know how far back it goes and
    what shape it was in, and the full contents are what /inspect is for.
]]
function ProfileBackup.summary(ring: any): any
    local normalized = ProfileBackup.normalize(ring)
    local entries = {}
    for _, snapshot in normalized.snapshots do
        table.insert(entries, {
            revision = snapshot.revision,
            capturedAt = snapshot.capturedAt,
            schemaVersion = snapshot.schemaVersion,
            reason = snapshot.reason,
        })
    end
    local newest = ProfileBackup.newest(normalized)
    return {
        count = #entries,
        entries = entries,
        newestRevision = if newest ~= nil then newest.revision else nil,
        newestCapturedAt = if newest ~= nil then newest.capturedAt else nil,
    }
end

return table.freeze(ProfileBackup)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="83">
        <Properties>
          <string name="Name">ProfilePersistence</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The decisions ProfileService makes about a save, separated from the calls
    it makes to reach one.

    Milestone 4's exit gate asks that forced crashes, lock contention, write
    failure, stale revision, and shutdown all pass. Every one of those is a
    decision about state -- should this load be trusted, may this server claim
    this profile, whose copy wins -- and none of them needs a DataStore to
    answer. They live here so the gate can be tested rather than argued about,
    and so the one place that decides whether a save may be overwritten is a
    place you can read in one sitting.

    The property everything else protects: **a save is never overwritten by a
    profile that failed to load.** A DataStore read that errors or times out
    produces a playable session with a default profile and no write permission,
    because the alternative -- treating "I could not read your save" as "you
    have no save" -- deletes a player's game during a Roblox outage. That is
    the single worst thing this system could do, and it is why loadOutcome
    returns writable = false on every unhappy path.
]]

local ProfilePersistence = {}

export type Lock = {
    jobId: string,
    heartbeat: number,
}

export type LoadOutcome = {
    source: string,
    writable: boolean,
    useStored: boolean,
}

export type LockDecision = {
    acquired: boolean,
    reason: string,
}

export type WriteDecision = {
    action: string,
    reason: string,
}

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

--[[
    What a load attempt produced.

    `finished` is whether the request came back at all before the deadline, and
    `ok` whether it came back without erroring. Only the path where both hold
    and the store answered may write.
]]
function ProfilePersistence.loadOutcome(finished: boolean, ok: boolean, stored: any): LoadOutcome
    if not finished then
        -- The request never returned. Somebody else's copy may still be live;
        -- writing over it from here would be guessing.
        return { source = "read_only", writable = false, useStored = false }
    end
    if not ok then
        return { source = "read_only", writable = false, useStored = false }
    end
    if stored == nil then
        return { source = "new", writable = true, useStored = false }
    end
    return { source = "datastore", writable = true, useStored = true }
end

--[[
    Whether this server may claim a profile.

    A lock is a job ID and a heartbeat. The heartbeat is what makes a crash
    survivable: a server that dies never releases its lock, so the only way the
    player ever plays again is for a later session to reclaim a lock that has
    stopped beating. `staleAfter` therefore has to exceed the heartbeat interval
    by enough that a slow save is not mistaken for a dead server.

    Two shapes of bad data are treated as unlocked rather than as locked, on the
    principle that corrupt bookkeeping must never cost a player their save
    permanently: a lock that is not a well-formed record, and a lock whose
    heartbeat is far enough in the future that it cannot be a real clock.
]]
function ProfilePersistence.acquireLock(
    existing: any,
    jobId: string,
    now: number,
    staleAfter: number
): LockDecision
    assert(type(jobId) == "string" and jobId ~= "", "a lock needs a job ID")
    assert(finite(now), "lock time must be finite")
    assert(finite(staleAfter) and staleAfter > 0, "stale threshold must be positive")

    if existing == nil then
        return { acquired = true, reason = "unlocked" }
    end
    if
        type(existing) ~= "table"
        or type(existing.jobId) ~= "string"
        or existing.jobId == ""
        or not finite(existing.heartbeat)
    then
        return { acquired = true, reason = "malformed_lock" }
    end
    if existing.jobId == jobId then
        return { acquired = true, reason = "already_held" }
    end

    local age = now - existing.heartbeat
    if age >= staleAfter then
        return { acquired = true, reason = "reclaimed_stale" }
    end
    if age < -staleAfter then
        -- A heartbeat from the future by more than the whole stale window is a
        -- broken clock, not a live server holding the profile.
        return { acquired = true, reason = "reclaimed_future" }
    end
    return { acquired = false, reason = "held_by_another_server" }
end

function ProfilePersistence.lock(jobId: string, now: number): Lock
    return { jobId = jobId, heartbeat = now }
end

--[[
    Whose copy of a profile wins.

    Two servers can hold the same profile briefly -- a reclaimed lock, a
    teleport, a rejoin before the old session flushed. Revision is the tie
    break, and the rule is that the higher revision is never overwritten by a
    lower one. Losing here is not a failure: it means the copy in memory is
    behind, and the caller adopts the stored one instead of pushing stale
    progress over fresh progress.
]]
function ProfilePersistence.resolveWrite(stored: any, pending: any): WriteDecision
    assert(type(pending) == "table" and finite(pending.revision), "a write needs a revision")

    if stored == nil then
        return { action = "write", reason = "no_stored_profile" }
    end
    if type(stored) ~= "table" or not finite(stored.revision) then
        -- Unreadable stored data is replaced rather than deferred to: deferring
        -- would strand the player on a profile nothing can parse.
        return { action = "write", reason = "stored_profile_unreadable" }
    end
    if stored.revision > pending.revision then
        return { action = "retain_stored", reason = "stored_revision_is_newer" }
    end
    return { action = "write", reason = "pending_revision_is_current" }
end

-- Whether a heartbeat is due. Kept here so the interval that refreshes a lock
-- and the threshold that reclaims one stay visibly related.
function ProfilePersistence.shouldRefreshLock(
    lastHeartbeat: any,
    now: number,
    interval: number
): boolean
    if not finite(lastHeartbeat) then
        return true
    end
    return now - lastHeartbeat >= interval
end

return table.freeze(ProfilePersistence)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="84">
        <Properties>
          <string name="Name">QuestCatalog</string>
          <string name="Source"><![CDATA[--!strict

local QuestCatalog = {}

export type Objective = {
    kind: string,
    threshold: number,
    --[[
        Keyed objectives. A kind that counts everything needs neither of
        these; a kind that counts one profession's mastery or one region's
        memories names which, and `Quests.currentValue` reads the key off
        the objective rather than off a second table somewhere.
    ]]
    professionId: string?,
    regionId: string?,
}

export type Reward = {
    materialId: string,
    amount: number,
}

export type Quest = {
    --[[
        Arc support. `requires` is the quest before this one in the same
        person's arc: until that is claimed this one does not progress, is
        not offered, and cannot claim itself. `residentId` is who is
        asking, so the dialogue can find someone's current stage without
        the roster holding a second list that would drift from this one.
    ]]
    requires: string?,
    residentId: string?,
    id: string,
    displayName: string,
    objective: Objective,
    reward: Reward,
}

--[[
    Chapter I's three come first and keep their exact ids, thresholds and
    rewards. The eight that follow belong to the residents Milestone 7
    brings back from the Delve and the Fen -- each one asks for something
    that resident would actually care about, and every objective is
    computed from facts the profile already records.
]]
local ORDER = table.freeze({
    "quest_survive_three_nights",
    "quest_first_craft",
    "quest_bramblewake_veteran",
    -- Chapter one's three ask more than once. They are present from the
    -- first dawn and stay for the whole game, so they are the residents
    -- with the runway for an arc; everyone else arrives with less of it.
    "quest_tomas_second_bench",
    "quest_tomas_full_house",
    "quest_pip_further_roads",
    "quest_pip_every_night",
    "quest_ena_first_growth",
    "quest_ena_the_archive",

    -- Ironroot Delve residents
    "quest_delve_smith",
    "quest_rail_keeper",
    "quest_lamp_trimmer",
    "quest_deep_cook",
    -- Mireglass Fen residents
    "quest_ferry_ledger",
    "quest_reed_weaver",
    "quest_glass_reader",
    "quest_fen_healer",
    -- Tempest Reach residents
    "quest_signal_watch",
    "quest_ropewalk_hands",
    "quest_harbour_ledger",
    "quest_salvage_runs",
    -- Frostmere Vale residents
    "quest_bell_keeping",
    "quest_vale_nursing",
    "quest_cold_stores",
    "quest_almshouse_doors",
    --[[
        Two families that belong to nobody: the mastery trials, which ask
        a player to go deep in one profession rather than wide across
        seven, and the region mysteries, which ask for a place's memories
        specifically rather than for memories in general. Neither is a
        resident's, so neither carries a residentId -- they are the
        town's own standing questions.
    ]]
    "quest_mastery_scout",
    "quest_mastery_warden",
    "quest_mastery_engineer",
    "quest_mastery_medic",
    "quest_mastery_alchemist",
    "quest_mastery_beastkeeper",
    "quest_mastery_runebinder",
    "quest_mystery_bramblewake",
    "quest_mystery_ironroot",
    "quest_mystery_mireglass",
    "quest_mystery_tempest",
    "quest_mystery_frostmere",
    "quest_mystery_cinderfall",
    -- Cinderfall Crown residents
    "quest_glass_hands",
    "quest_kept_record",
    "quest_named_stones",
    "quest_long_timber",
    -- After the Hollow
    "quest_keepers_return",
    "quest_deep_water",
    "quest_full_house",
    "quest_last_ward",
})

local DEFINITIONS: { [string]: Quest } = {
    quest_survive_three_nights = table.freeze({
        id = "quest_survive_three_nights",
        residentId = "npc_pip_wren",
        displayName = "THREE NIGHTS SURVIVED",
        objective = table.freeze({ kind = "survive_nights", threshold = 3 }),
        reward = table.freeze({ materialId = "material_heartwood", amount = 5 }),
    }),
    quest_first_craft = table.freeze({
        id = "quest_first_craft",
        residentId = "npc_tomas_reed",
        displayName = "FIRST CRAFT",
        objective = table.freeze({ kind = "craft_items", threshold = 1 }),
        reward = table.freeze({ materialId = "material_amber_sap", amount = 3 }),
    }),
    quest_bramblewake_veteran = table.freeze({
        id = "quest_bramblewake_veteran",
        residentId = "npc_ena_moss",
        displayName = "BRAMBLEWAKE VETERAN",
        objective = table.freeze({ kind = "bramblewake_settlements", threshold = 3 }),
        reward = table.freeze({ materialId = "material_brightcap", amount = 3 }),
    }),

    -- Hesper kept her tools when she lost everything else, and measures
    -- people by whether they keep theirs.
    quest_delve_smith = table.freeze({
        id = "quest_delve_smith",
        residentId = "npc_hesper_vane",
        displayName = "A SMITH'S MEASURE",
        objective = table.freeze({ kind = "gear_traits", threshold = 3 }),
        reward = table.freeze({ materialId = "material_heartwood", amount = 6 }),
    }),
    -- Odell hauled for a mine that stopped paying; a full store is the
    -- only thing that makes him sit down.
    quest_rail_keeper = table.freeze({
        id = "quest_rail_keeper",
        residentId = "npc_odell_crane",
        displayName = "THE STORES ARE FULL",
        objective = table.freeze({ kind = "materials_banked", threshold = 60 }),
        reward = table.freeze({ materialId = "material_spring_clay", amount = 4 }),
    }),
    -- Junie counts nights the way other people count money.
    quest_lamp_trimmer = table.freeze({
        id = "quest_lamp_trimmer",
        residentId = "npc_junie_falk",
        displayName = "SEVEN LIT NIGHTS",
        objective = table.freeze({ kind = "survive_nights", threshold = 7 }),
        reward = table.freeze({ materialId = "material_amber_sap", amount = 5 }),
    }),
    -- Bartram fed a hundred people on nothing and still thinks the pantry
    -- is short; he is satisfied by a town that builds its own kitchen.
    quest_deep_cook = table.freeze({
        id = "quest_deep_cook",
