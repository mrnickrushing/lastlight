    quest_mystery_ironroot = table.freeze({
        id = "quest_mystery_ironroot",
        displayName = "WHAT THE DELVE BURIED",
        objective = table.freeze({
            kind = "fragments_in_region",
            regionId = "region_ironroot",
            threshold = 2,
