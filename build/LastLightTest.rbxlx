        damageReduction = 0.03,
        staminaRegenMultiplier = 1.0,
        kind = "bow",
        strikeRange = 30,
        strikeDamageMultiplier = 0.75,
    }),
    gear_kiln_maul = table.freeze({
        slot = "weapon",
        displayName = "KILN MAUL",
