    -- Cass makes rope, and rope is made by making a great deal of it.
    quest_ropewalk_hands = table.freeze({
        id = "quest_ropewalk_hands",
        residentId = "npc_cass_pell",
        displayName = "TWENTY GOOD LENGTHS",
