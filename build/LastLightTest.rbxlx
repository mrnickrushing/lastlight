        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">BramblewakeBuilder</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")

local BramblewakeBuilder = {}

local GRASS = Color3.fromRGB(40, 74, 48)
local DEEP_GRASS = Color3.fromRGB(18, 45, 34)
local PATH = Color3.fromRGB(79, 64, 44)
local BARK = Color3.fromRGB(58, 38, 29)
local DARK_BARK = Color3.fromRGB(32, 25, 23)
local STONE = Color3.fromRGB(58, 67, 63)
local AMBER = Color3.fromRGB(255, 178, 71)
local FOXFIRE = Color3.fromRGB(94, 206, 176)
local MEADOW = Color3.fromRGB(151, 123, 59)
local CREAM = Color3.fromRGB(244, 230, 197)
local MOSS = Color3.fromRGB(52, 83, 49)
local WET_EARTH = Color3.fromRGB(61, 50, 36)
local FOG_GLASS = Color3.fromRGB(119, 149, 143)

local ORIGIN = Vector3.new(1600, 0, -230)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function orb(
    parent: Instance,
    name: string,
    position: Vector3,
    size: number,
    color: Color3,
    material: Enum.Material
): Part
    local instance = part(
        parent,
        name,
        Vector3.new(size, size, size),
        CFrame.new(position),
        color,
        material,
        false
    )
    instance.Shape = Enum.PartType.Ball
    return instance
end

local function light(target: BasePart, color: Color3, brightness: number, range: number)
    local pointLight = Instance.new("PointLight")
    pointLight.Color = color
    pointLight.Brightness = brightness
    pointLight.Range = range
    pointLight.Shadows = true
    pointLight.Parent = target
end

local function surfaceGrain(target: BasePart, color: Color3, transparency: number)
    local decal = Instance.new("Decal")
    decal.Name = "MaterialVariation"
    decal.Color3 = color
    decal.Transparency = transparency
    decal.Face = Enum.NormalId.Top
    decal.Parent = target
end

local function groundPatch(
    parent: Instance,
    center: Vector3,
    size: Vector3,
    color: Color3,
    material: Enum.Material
)
    local patch = part(
        parent,
        "BramblewakeGroundPatch",
        size,
        CFrame.new(center + Vector3.new(0, 0.18, 0)) * CFrame.Angles(0, center.X * 0.011, 0),
        color,
        material,
        false
    )
    patch.Transparency = 0.07
    patch.CanQuery = false
    return patch
end

local function fernCluster(
    parent: Instance,
    center: Vector3,
    scale: number,
    ambientSwayTag: string?
)
    for blade = 1, 6 do
        local angle = (blade / 6) * math.pi * 2
        local frond = part(
            parent,
            "BrambleFern",
            Vector3.new(0.32 * scale, 0.18 * scale, 2.9 * scale),
            CFrame.new(
                center
                    + Vector3.new(
                        math.cos(angle) * 0.65 * scale,
                        0.55 * scale,
                        math.sin(angle) * 0.65 * scale
                    )
            ) * CFrame.Angles(math.rad(23), angle, math.rad(math.sin(angle) * 8)),
            if blade % 2 == 0 then MOSS else Color3.fromRGB(35, 69, 43),
            Enum.Material.Grass,
            false
        )
        frond.CanQuery = false
        if ambientSwayTag ~= nil and (blade == 2 or blade == 5) then
            CollectionService:AddTag(frond, ambientSwayTag)
        end
    end
end

local function rootTangle(parent: Instance, center: Vector3, scale: number, seed: number)
    local random = Random.new(seed)
    for root = 1, 4 do
        local angle = random:NextNumber(0, math.pi * 2)
        local length = random:NextNumber(7, 13) * scale
        local tangle = part(
            parent,
            "ExposedWetRoot",
            Vector3.new(0.7 * scale, length, 0.7 * scale),
            CFrame.new(
                center
                    + Vector3.new(
                        math.cos(angle) * 2.2 * scale,
                        0.65 * scale,
                        math.sin(angle) * 2.2 * scale
                    )
            )
                * CFrame.Angles(math.rad(84), angle, math.rad(random:NextNumber(-10, 10))),
            if root % 2 == 0 then DARK_BARK else BARK,
            Enum.Material.Wood,
            false
        )
        tangle.Shape = Enum.PartType.Cylinder
        tangle.CanQuery = false
    end
end

local function lowMist(parent: Instance, center: Vector3, size: Vector3, transparency: number)
    local mist = part(
        parent,
        "BlueGroundMist",
        size,
        CFrame.new(center + Vector3.new(0, 1.2, 0)),
        FOG_GLASS,
        Enum.Material.Glass,
        false
    )
    mist.Transparency = transparency
    mist.CastShadow = false
    mist.CanQuery = false
end

local function fireflyCluster(
    parent: Instance,
    center: Vector3,
    color: Color3,
    count: number,
    spread: number,
    seed: number,
    ambientMoteTag: string?
)
    local random = Random.new(seed)
    for _ = 1, count do
        local mote = orb(
            parent,
            "BrambleMote",
            center
                + Vector3.new(
                    random:NextNumber(-spread, spread),
                    random:NextNumber(1.8, 8),
                    random:NextNumber(-spread, spread)
                ),
            random:NextNumber(0.14, 0.32),
            color,
            Enum.Material.Neon
        )
        mote.Transparency = random:NextNumber(0.05, 0.3)
        mote.CanQuery = false
        if ambientMoteTag ~= nil then
            CollectionService:AddTag(mote, ambientMoteTag)
        end
    end
end

local function billboard(target: BasePart, text: string, color: Color3)
    local gui = Instance.new("BillboardGui")
    gui.Name = "LandmarkLabel"
    gui.Adornee = target
    gui.AlwaysOnTop = false
    gui.LightInfluence = 0.35
    gui.MaxDistance = 55
    gui.Size = UDim2.fromOffset(190, 40)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 3.8, 0)
    gui.Parent = target

    local label = Instance.new("TextLabel")
    label.BackgroundColor3 = Color3.fromRGB(14, 24, 21)
    label.BackgroundTransparency = 0.2
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = text
    label.TextColor3 = color
    label.TextScaled = false
    label.TextSize = 12
    label.TextWrapped = true
    label.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
end

local function _objectIcon(target: BasePart, kind: string, color: Color3)
    local gui = Instance.new("BillboardGui")
    gui.Name = "ObjectIcon"
    gui.Adornee = target
    gui.AlwaysOnTop = true
    gui.LightInfluence = 0
    gui.Size = UDim2.fromOffset(42, 42)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 5.8, 0)
    gui.MaxDistance = 72
    gui.Parent = target

    local glyph = Instance.new("TextLabel")
    glyph.Name = "IconGlyph"
    glyph.BackgroundColor3 = Color3.fromRGB(10, 21, 19)
    glyph.BackgroundTransparency = 0.05
    glyph.BorderSizePixel = 0
    glyph.Size = UDim2.fromScale(1, 1)
    glyph.Font = Enum.Font.GothamBold
    glyph.Text = if kind == "rootfire"
        then "✦"
        elseif kind == "livingroot" or kind == "root" then "✤"
        elseif kind == "wayhome" then "⌂"
        elseif kind == "event" or kind == "step" then "!"
        elseif kind == "antler" then "♢"
        else "✦"
    glyph.TextColor3 = color
    glyph.TextScaled = true
    glyph.ZIndex = 10
    glyph.Parent = gui
    local glyphCorner = Instance.new("UICorner")
    glyphCorner.CornerRadius = UDim.new(0, 10)
    glyphCorner.Parent = glyph

    local viewport = Instance.new("ViewportFrame")
    viewport.Size = UDim2.fromScale(1, 1)
    viewport.BackgroundColor3 = Color3.fromRGB(15, 27, 24)
    viewport.BackgroundTransparency = 0.08
    viewport.BorderSizePixel = 0
    viewport.Ambient = Color3.fromRGB(210, 224, 212)
    viewport.LightColor = Color3.fromRGB(255, 214, 146)
    viewport.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = viewport
    local worldModel = Instance.new("WorldModel")
    worldModel.Parent = viewport
    local camera = Instance.new("Camera")
    camera.CFrame = CFrame.new(0, 0.2, 6)
    camera.FieldOfView = 28
    camera.Parent = viewport
    viewport.CurrentCamera = camera

    local icon = Instance.new("Part")
    icon.Name = kind .. "Icon"
    icon.Anchored = true
    icon.CanCollide = false
    icon.CanQuery = false
    icon.Size = if kind == "rootfire"
        then Vector3.new(1.4, 1.8, 1.4)
        else Vector3.new(1.8, 1.8, 1.8)
    icon.Position = Vector3.new(0, 0, 0)
    icon.Color = color
    icon.Material = Enum.Material.Neon
    icon.Shape = if kind == "rootfire" then Enum.PartType.Ball else Enum.PartType.Cylinder
    icon.Parent = worldModel
end

-- Interactable identity is authored by the physical world prop itself. Keep
-- this compatibility hook for older callers without adding floating UI cards.
local function objectIcon(_target: BasePart, _kind: string, _color: Color3) end

local function destinationRing(parent: Instance, center: Vector3, color: Color3, radius: number)
    for index = 1, 8 do
        local angle = (index / 8) * math.pi * 2
        local marker = orb(
            parent,
            "DestinationMarker",
            center + Vector3.new(math.cos(angle) * radius, 0.35, math.sin(angle) * radius),
            0.28,
            color,
            Enum.Material.Neon
        )
        marker.CanQuery = false
    end
end

local function tree(parent: Instance, position: Vector3, scale: number)
    local trunk = part(
        parent,
        "BrambleTrunk",
        Vector3.new(2.4 * scale, 14 * scale, 2.4 * scale),
        CFrame.new(position + Vector3.new(0, 7 * scale, 0)),
        BARK,
        Enum.Material.Wood
    )
    for side = -1, 1, 2 do
        local branch = part(
            parent,
            "BrambleBranch",
            Vector3.new(0.65 * scale, 5 * scale, 0.65 * scale),
            CFrame.new(position + Vector3.new(side * 2.3 * scale, 7 * scale, 0))
                * CFrame.Angles(0, 0, math.rad(side * 48)),
            BARK,
            Enum.Material.Wood,
            false
        )
        branch.CanQuery = false
    end
    for layer = 1, 2 do
        local crownPosition = position + Vector3.new(0, (11 + layer * 4.2) * scale, 0)
        local crownSize =
            Vector3.new((11 - layer * 1.5) * scale, (7 - layer) * scale, (11 - layer * 1.5) * scale)
        for half = 1, 2 do
            local crown = part(
                parent,
                "BrambleCrown",
                crownSize,
                CFrame.new(crownPosition)
                    * CFrame.Angles(0, if half == 1 then 0.15 else math.pi + 0.15, 0),
                if layer == 1 then DEEP_GRASS else GRASS,
                Enum.Material.Grass,
                false
            )
            crown.Shape = Enum.PartType.Wedge
            crown.CanQuery = false
        end
    end
    trunk.CanQuery = false
end

local function rootArch(parent: Instance, center: Vector3, scale: number)
    for side = -1, 1, 2 do
        part(
            parent,
            "LivingRoot",
            Vector3.new(2.4 * scale, 18 * scale, 2.4 * scale),
            CFrame.new(center + Vector3.new(side * 10 * scale, 8 * scale, side * 10 * scale))
                * CFrame.Angles(0, 0, math.rad(-side * 18)),
            BARK,
            Enum.Material.Wood
        )
    end
    part(
        parent,
        "RootCrown",
        Vector3.new(29 * scale, 2.8 * scale, 3 * scale),
        CFrame.new(center + Vector3.new(0, 17 * scale, 0)) * CFrame.Angles(0, math.rad(45), 0),
        DARK_BARK,
        Enum.Material.Wood
    )
end

local function lantern(parent: Instance, position: Vector3, scale: number, ambientLightTag: string?)
    part(
        parent,
        "FoxfirePost",
        Vector3.new(0.8 * scale, 6 * scale, 0.8 * scale),
        CFrame.new(position + Vector3.new(0, 3 * scale, 0)),
        BARK,
        Enum.Material.Wood
    )
    local glow = orb(
        parent,
        "FoxfireGlow",
        position + Vector3.new(0, 6.4 * scale, 0),
        2.1 * scale,
        FOXFIRE,
        Enum.Material.Neon
    )
    light(glow, FOXFIRE, 1.8, 18 * scale)
    if ambientLightTag ~= nil then
        CollectionService:AddTag(glow, ambientLightTag)
    end
end

local function pathArm(parent: Instance, center: Vector3, neighbor: Vector3)
    local delta = neighbor - center
    local target = center + delta.Unit * 38
    local midpoint = (center + target) / 2 + Vector3.new(0, 0.28, 0)
    local roadFrame = CFrame.lookAt(midpoint, target)
    local road = part(
        parent,
        "CriticalPath",
        Vector3.new(16, 0.5, (target - center).Magnitude + 4),
        roadFrame,
        PATH,
        Enum.Material.Ground
    )
    road.Reflectance = 0.02
    local wear = part(
        parent,
        "EvacuationTrailWear",
        Vector3.new(5.2, 0.16, (target - center).Magnitude + 3.5),
        roadFrame * CFrame.new(0, 0.31, 0),
        Color3.fromRGB(95, 72, 48),
        Enum.Material.Mud,
        false
    )
    wear.CanQuery = false
    wear.CastShadow = false
    for side = -1, 1, 2 do
        local edge = part(
            parent,
            "EvacuationTrailEdge",
            Vector3.new(0.72, 0.32, (target - center).Magnitude + 3.2),
            roadFrame * CFrame.new(side * 7.15, 0.34, 0),
            if side < 0 then DARK_BARK else Color3.fromRGB(82, 91, 58),
            Enum.Material.Ground,
            false
        )
        edge.CanQuery = false
    end
end

local function evacuationRoadMarker(
    parent: Instance,
    center: Vector3,
    neighbor: Vector3,
    sequenceIndex: number
)
    local direction = (neighbor - center).Unit
    local side = Vector3.new(-direction.Z, 0, direction.X)
    local base = center + direction * 13 + side * 9
    local lean = if sequenceIndex % 4 == 1 then math.rad(-4) else math.rad(4)
    part(
        parent,
        "EvacuationRoadMarker",
        Vector3.new(0.72, 6.2, 0.72),
        CFrame.new(base + Vector3.new(0, 3.1, 0)) * CFrame.Angles(0, 0, lean),
        DARK_BARK,
        Enum.Material.Wood,
        false
    )
    local board = part(
        parent,
        "EvacuationRoadSign",
        Vector3.new(6.4, 2.1, 0.48),
        CFrame.lookAt(base + Vector3.new(0, 5.4, 0), neighbor),
        Color3.fromRGB(88, 59, 38),
        Enum.Material.WoodPlanks,
        false
    )
    board.CanQuery = false
    billboard(board, "EVACUATION ROAD", CREAM)
end

local function window(parent: Instance, position: Vector3, rotation: number)
    local frame = part(
        parent,
        "FarmWindowFrame",
        Vector3.new(3.8, 2.6, 0.35),
        CFrame.new(position) * CFrame.Angles(0, rotation, 0),
        DARK_BARK,
        Enum.Material.WoodPlanks,
        false
    )
    local pane = part(
        parent,
        "FarmWindowGlow",
        Vector3.new(2.8, 1.7, 0.15),
        CFrame.new(position + Vector3.new(0, 0, -0.22)) * CFrame.Angles(0, rotation, 0),
        Color3.fromRGB(255, 196, 103),
        Enum.Material.Glass,
        false
    )
    pane.Transparency = 0.18
    local cross = part(
        parent,
        "FarmWindowCross",
        Vector3.new(0.18, 2.1, 0.2),
        CFrame.new(position + Vector3.new(0, 0, -0.32)) * CFrame.Angles(0, rotation, 0),
        CREAM,
        Enum.Material.Wood,
        false
    )
    cross.CanQuery = false
    frame.CanQuery = false
end

local function fence(parent: Instance, start: Vector3, count: number, spacing: number)
    for index = 0, count - 1 do
        local position = start + Vector3.new(index * spacing, 0, 0)
        part(
            parent,
            "FieldFencePost",
            Vector3.new(0.6, 2.8, 0.6),
            CFrame.new(position + Vector3.new(0, 1.4, 0)),
            BARK,
            Enum.Material.Wood
        )
        if index < count - 1 then
            part(
                parent,
                "FieldFenceRail",
                Vector3.new(spacing + 0.2, 0.35, 0.35),
                CFrame.new(position + Vector3.new(spacing / 2, 1.1, 0)),
                DARK_BARK,
                Enum.Material.WoodPlanks,
                false
            )
            part(
                parent,
                "FieldFenceRail",
                Vector3.new(spacing + 0.2, 0.35, 0.35),
                CFrame.new(position + Vector3.new(spacing / 2, 2.0, 0)),
                DARK_BARK,
                Enum.Material.WoodPlanks,
                false
            )
        end
    end
end

local function moduleDressing(parent: Instance, center: Vector3, seed: number, runtimeIds: any)
    local random = Random.new(seed)
    groundPatch(
        parent,
        center,
        Vector3.new(42, 0.28, 42),
        Color3.fromRGB(35, 61, 42),
        Enum.Material.LeafyGrass
    )
    groundPatch(
        parent,
        center + Vector3.new(0, 0.02, 0),
        Vector3.new(25, 0.22, 25),
        WET_EARTH,
        Enum.Material.Mud
    )
    lowMist(parent, center, Vector3.new(56, 1.4, 56), 0.84)
    for index = 1, 13 do
        local angle = random:NextNumber(0, math.pi * 2)
        local radius = random:NextNumber(12, 31)
        local position = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        local stone = orb(
            parent,
            "TrailStone",
            position + Vector3.new(0, 0.55, 0),
            random:NextNumber(1.2, 2.6),
            if index % 2 == 0 then STONE else Color3.fromRGB(75, 85, 72),
            Enum.Material.Slate
        )
        stone.CFrame *= CFrame.Angles(0.15, angle, 0.1)
        stone.CanQuery = false
        if index % 3 == 0 then
            rootTangle(
                parent,
                position + Vector3.new(1, 0, -1),
                random:NextNumber(0.65, 1.1),
                seed + index
            )
        end
    end
    for index = 1, 10 do
        local angle = random:NextNumber(0, math.pi * 2)
        local radius = random:NextNumber(7, 28)
        local position = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        if index % 2 == 0 then
            fernCluster(parent, position, random:NextNumber(0.7, 1.25), runtimeIds.AmbientSwayTag)
        else
            local tuft = orb(
                parent,
                "MossLight",
                position + Vector3.new(0, 0.6, 0),
                0.42,
                if index % 3 == 0 then FOXFIRE else AMBER,
                Enum.Material.Neon
            )
            tuft.Transparency = 0.2
            tuft.CanQuery = false
            CollectionService:AddTag(tuft, runtimeIds.AmbientLightTag)
        end
    end
    fireflyCluster(
        parent,
        center + Vector3.new(0, 0, 5),
        FOXFIRE,
        5,
        24,
        seed + 1301,
        runtimeIds.AmbientMoteTag
    )
end

local function buildFarm(parent: Instance, center: Vector3): Model
    local shell = Instance.new("Model")
    shell.Name = "ProceduralCrookedFarmhouseShell"
    shell.Parent = parent
    local housePosition = center + Vector3.new(21, 5.5, 20)
    part(
        shell,
        "Farmhouse",
        Vector3.new(16, 11, 12),
        CFrame.new(housePosition),
        Color3.fromRGB(92, 66, 46),
        Enum.Material.WoodPlanks
    )
    local roof = part(
        shell,
        "RainDarkRoof",
        Vector3.new(20, 2, 8.5),
        CFrame.new(housePosition + Vector3.new(0, 7.2, -4.2)) * CFrame.Angles(0, 0, math.rad(-24)),
        DARK_BARK,
        Enum.Material.Slate
    )
    roof.CanQuery = false
    local roof2 = part(
        shell,
        "RainDarkRoof",
        Vector3.new(20, 2, 8.5),
        CFrame.new(housePosition + Vector3.new(0, 7.2, 4.2)) * CFrame.Angles(0, 0, math.rad(24)),
        DARK_BARK,
        Enum.Material.Slate
    )
    roof2.CanQuery = false
    part(
        parent,
        "FarmDoor",
        Vector3.new(3.2, 5.4, 0.35),
        CFrame.new(housePosition + Vector3.new(0, -2.8, -6.2)),
        DARK_BARK,
        Enum.Material.WoodPlanks,
        false
    )
    window(parent, housePosition + Vector3.new(-5, 1.3, -6.25), 0)
    window(parent, housePosition + Vector3.new(5, 1.3, -6.25), 0)
    part(
        shell,
        "FarmChimney",
        Vector3.new(2.2, 5, 2.2),
        CFrame.new(housePosition + Vector3.new(4.5, 9, 1.5)),
        STONE,
        Enum.Material.Brick,
        false
    )
    fence(parent, center + Vector3.new(-31, 0, 24), 6, 4.8)
    for index = 1, 3 do
        local bale = part(
            parent,
            "HayBale",
            Vector3.new(3.4, 2.2, 2.2),
            CFrame.new(center + Vector3.new(-28 + index * 3.8, 1.1, 17)),
            MEADOW,
            Enum.Material.Fabric,
            false
        )
        bale.Shape = Enum.PartType.Cylinder
        bale.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    end
    for row = -1, 1 do
        part(
            parent,
            "OldFieldRow",
            Vector3.new(3, 0.8, 28),
            CFrame.new(center + Vector3.new(-18 + row * 6, 0.2, 9)),
            MEADOW,
            Enum.Material.Ground,
            false
        )
    end
    return shell
end

local function buildWindmill(parent: Instance, center: Vector3, ambientMotionTag: string): Model
    local shell = Instance.new("Model")
    shell.Name = "ProceduralFoxfireMillTowerShell"
    shell.Parent = parent
    local tower = part(
        shell,
        "WindmillTower",
        Vector3.new(9, 30, 9),
        CFrame.new(center + Vector3.new(22, 15, 20)),
        Color3.fromRGB(105, 84, 61),
        Enum.Material.WoodPlanks
    )
    local hub = orb(
        parent,
        "WindmillHub",
        tower.Position + Vector3.new(0, 8, -5),
        3,
        STONE,
        Enum.Material.Metal
    )
    local cap = part(
        shell,
        "WindmillCap",
        Vector3.new(11, 3, 11),
        CFrame.new(tower.Position + Vector3.new(0, 16, 0)),
        DARK_BARK,
        Enum.Material.Slate,
        false
    )
    cap.Shape = Enum.PartType.Cylinder
    cap.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    for side = -1, 1, 2 do
        part(
            shell,
            "WindmillBrace",
            Vector3.new(1.1, 28, 1.1),
            CFrame.new(tower.Position + Vector3.new(side * 3.3, 0, -4.6))
                * CFrame.Angles(0, 0, math.rad(side * 9)),
            DARK_BARK,
            Enum.Material.Wood,
            false
        )
    end
    local rotor = Instance.new("Model")
    rotor.Name = "WindmillRotor"
    rotor:SetAttribute("MotionKind", "rotor")
    rotor:SetAttribute("MotionSpeed", 0.3)
    rotor.Parent = parent
    local rotorPivot = part(
        rotor,
        "WindmillRotorPivot",
        Vector3.new(0.2, 0.2, 0.2),
        CFrame.new(hub.Position),
        STONE,
        Enum.Material.SmoothPlastic,
        false
    )
    rotorPivot.Transparency = 1
    rotorPivot.CanQuery = false
    rotorPivot.CastShadow = false
    rotor.PrimaryPart = rotorPivot
    for angle = 0, 3 do
        part(
            rotor,
            "WindmillSail",
            Vector3.new(2, 19, 0.8),
            CFrame.new(hub.Position) * CFrame.Angles(0, 0, angle * math.pi / 2),
            CREAM,
            Enum.Material.Fabric,
            false
        )
        part(
            rotor,
            "WindmillSailArm",
            Vector3.new(0.7, 16, 1.2),
            CFrame.new(hub.Position) * CFrame.Angles(0, 0, angle * math.pi / 2 + math.pi / 4),
            BARK,
            Enum.Material.Wood,
            false
        )
    end
    CollectionService:AddTag(rotor, ambientMotionTag)
    return shell
end

local function buildStoryLandmark(
    parent: Instance,
    center: Vector3,
    kind: string,
    title: string,
    offset: any
): number
    assert(
        type(offset) == "table" and type(offset.x) == "number" and type(offset.z) == "number",
        "Bramblewake story landmark is missing its authored offset"
    )
    local origin = center + Vector3.new(offset.x, 0, offset.z)
    local count = 0
    local function storyPart(
        name: string,
        size: Vector3,
        cframe: CFrame,
        color: Color3,
        material: Enum.Material
    ): Part
        local artifact = part(parent, name, size, cframe, color, material, false)
        artifact.CanQuery = false
        artifact:SetAttribute("StoryLandmark", kind)
        count += 1
        return artifact
    end

    local anchor: BasePart
    if kind == "last_harvest" then
        anchor = storyPart(
            "LastHarvestTable",
            Vector3.new(8.5, 0.55, 4.2),
            CFrame.new(origin + Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, 0.18, 0),
            Color3.fromRGB(96, 68, 43),
            Enum.Material.WoodPlanks
        )
        for x = -1, 1, 2 do
            for z = -1, 1, 2 do
                storyPart(
                    "HarvestTableLeg",
                    Vector3.new(0.45, 2.5, 0.45),
                    CFrame.new(origin + Vector3.new(x * 3.2, 1.25, z * 1.25)),
                    DARK_BARK,
                    Enum.Material.Wood
                )
            end
        end
        for basketIndex = -1, 1 do
            local basket = storyPart(
                "AbandonedHarvestBasket",
                Vector3.new(1.8, 1.3, 1.8),
                CFrame.new(origin + Vector3.new(basketIndex * 2.5, 3.45, 0)),
                if basketIndex == 0 then MEADOW else Color3.fromRGB(145, 91, 53),
                Enum.Material.WoodPlanks
            )
            basket.Shape = Enum.PartType.Ball
        end
        storyPart(
            "HarvestSickleHandle",
            Vector3.new(0.35, 3.6, 0.35),
            CFrame.new(origin + Vector3.new(4.7, 0.9, 1.5)) * CFrame.Angles(0, 0, math.rad(68)),
            BARK,
            Enum.Material.Wood
        )
        storyPart(
            "HarvestSickleBlade",
            Vector3.new(1.8, 0.3, 0.55),
            CFrame.new(origin + Vector3.new(5.8, 1.9, 1.5)) * CFrame.Angles(0, 0, math.rad(28)),
            Color3.fromRGB(127, 139, 140),
            Enum.Material.Metal
        )
    elseif kind == "evacuation_cart" then
        anchor = storyPart(
            "EvacuationHandcart",
            Vector3.new(8.5, 2.8, 5.2),
            CFrame.new(origin + Vector3.new(0, 1.65, 0)) * CFrame.Angles(0.08, 0.35, 0.12),
            Color3.fromRGB(103, 70, 43),
            Enum.Material.WoodPlanks
        )
        storyPart(
            "EvacuationCartTongue",
            Vector3.new(0.7, 0.7, 7.5),
            anchor.CFrame * CFrame.new(0, -0.35, -5.8) * CFrame.Angles(math.rad(-8), 0, 0),
            BARK,
            Enum.Material.Wood
        )
        for side = -1, 1, 2 do
            local wheel = storyPart(
                "EvacuationCartWheel",
                Vector3.new(0.65, 4.4, 4.4),
                anchor.CFrame * CFrame.new(side * 4.55, -0.6, 0),
                DARK_BARK,
                Enum.Material.Wood
            )
            wheel.Shape = Enum.PartType.Cylinder
        end
        for crateIndex = -1, 1 do
            storyPart(
                "EvacuationCrate",
                Vector3.new(2.2, 1.8 + math.abs(crateIndex) * 0.35, 2.2),
                anchor.CFrame * CFrame.new(crateIndex * 2.4, 2.2, 0),
                if crateIndex == 0 then Color3.fromRGB(108, 124, 74) else Color3.fromRGB(91, 62, 40),
                Enum.Material.WoodPlanks
            )
        end
        for trackIndex = 1, 4 do
            local track = storyPart(
                "DepartureTrack",
                Vector3.new(1.2, 0.12, 2.4),
                CFrame.new(origin + Vector3.new(-5 + trackIndex * 2.1, 0.31, -5 - trackIndex * 2.7))
                    * CFrame.Angles(0, 0.25, 0),
                WET_EARTH,
                Enum.Material.Mud
            )
            track.Transparency = 0.12
        end
    elseif kind == "last_repair" then
        anchor = storyPart(
            "FallenWindmillSpar",
            Vector3.new(1, 17, 1),
            CFrame.new(origin + Vector3.new(0, 1.2, 0))
                * CFrame.Angles(math.rad(88), math.rad(16), 0),
            BARK,
            Enum.Material.Wood
        )
        for sailIndex = -1, 1, 2 do
            local sail = storyPart(
                "TornWindmillSail",
                Vector3.new(4.2, 0.28, 6.8),
                CFrame.new(origin + Vector3.new(sailIndex * 3.2, 0.48, sailIndex * 2.1))
                    * CFrame.Angles(0, math.rad(16 + sailIndex * 8), math.rad(sailIndex * 4)),
                CREAM,
                Enum.Material.Fabric
            )
            sail.Transparency = 0.12
        end
        storyPart(
            "RepairToolChest",
            Vector3.new(4.5, 2.1, 2.8),
            CFrame.new(origin + Vector3.new(6, 1.05, 4)),
            Color3.fromRGB(90, 61, 41),
            Enum.Material.WoodPlanks
        )
        for toolIndex = -1, 1 do
            storyPart(
                "AbandonedRepairTool",
                Vector3.new(0.35, 3.2, 0.35),
                CFrame.new(origin + Vector3.new(5.3 + toolIndex * 1.1, 2.75, 4))
                    * CFrame.Angles(0, 0, math.rad(68 + toolIndex * 9)),
                if toolIndex == 0 then Color3.fromRGB(131, 144, 146) else BARK,
                if toolIndex == 0 then Enum.Material.Metal else Enum.Material.Wood
            )
        end
    elseif kind == "lost_crossing" then
        anchor = storyPart(
            "LostCrossingSatchel",
            Vector3.new(3.1, 2.2, 1.3),
            CFrame.new(origin + Vector3.new(3.5, 1.2, 1.8)) * CFrame.Angles(0.12, -0.4, 0.2),
            Color3.fromRGB(118, 78, 49),
            Enum.Material.Fabric
        )
        for plankIndex = -1, 1 do
            storyPart(
                "SnappedCrossingPlank",
                Vector3.new(2.8, 0.45, 7),
                CFrame.new(origin + Vector3.new(plankIndex * 3.4, 0.55, -1 + plankIndex * 1.4))
                    * CFrame.Angles(
                        math.rad(plankIndex * 5),
                        math.rad(plankIndex * 12),
                        math.rad(plankIndex * 4)
                    ),
                Color3.fromRGB(94, 65, 43),
                Enum.Material.WoodPlanks
            )
        end
        for railIndex = -1, 1, 2 do
            storyPart(
                "BrokenCrossingRail",
                Vector3.new(0.55, 6.5, 0.55),
                CFrame.new(origin + Vector3.new(railIndex * 5.2, 1.25, -1))
                    * CFrame.Angles(math.rad(74), 0, math.rad(railIndex * 12)),
                DARK_BARK,
                Enum.Material.Wood
            )
        end
        local lostLantern = storyPart(
            "ColdTrailLantern",
            Vector3.new(1.6, 2.1, 1.6),
            CFrame.new(origin + Vector3.new(-4.7, 1.15, 4.2)),
            Color3.fromRGB(91, 118, 113),
            Enum.Material.Glass
        )
        lostLantern.Shape = Enum.PartType.Ball
        lostLantern.Transparency = 0.28
    else
        error("Unknown Bramblewake story landmark kind: " .. kind)
    end
    billboard(anchor, title, CREAM)
    parent:SetAttribute("StoryLandmark", kind)
    parent:SetAttribute("StoryLandmarkTitle", title)
    parent:SetAttribute("StoryLandmarkPartCount", count)
    return count
end

local function buildModuleVisual(
    parent: Instance,
    visual: string,
    center: Vector3,
    runtimeIds: any
): any?
    if visual == "lantern_gate" then
        rootArch(parent, center, 1)
        lantern(parent, center + Vector3.new(-14, 0, 13), 1, runtimeIds.AmbientLightTag)
        lantern(parent, center + Vector3.new(14, 0, 13), 1, runtimeIds.AmbientLightTag)
    elseif visual == "root_arch" then
        rootArch(parent, center + Vector3.new(0, 0, -7), 0.9)
        for offset = -1, 1, 2 do
            orb(
                parent,
                "Brightcap",
                center + Vector3.new(offset * 15, 1.1, 12),
                2.2,
                FOXFIRE,
                Enum.Material.Neon
            )
        end
    elseif visual == "orchard" then
        for x = -1, 1 do
            for z = -1, 1 do
                tree(parent, center + Vector3.new(x * 17, 0, z * 17), 0.68)
            end
        end
    elseif visual == "foxglove" then
        for index = 1, 8 do
            local side = if index % 2 == 0 then 1 else -1
            local glow = orb(
                parent,
                "Foxglove",
                center + Vector3.new(side * (12 + index), 1.2, -26 + index * 6),
                1.4,
                if index % 3 == 0 then AMBER else FOXFIRE,
                Enum.Material.Neon
            )
            glow.CanQuery = false
        end
    elseif visual == "farm" then
        local shell = buildFarm(parent, center)
        return {
            assetId = "mesh_crooked_farmhouse_a",
            fallbackKind = "placeholder",
            position = center + Vector3.new(21, 0, 20),
            scale = 1,
            yaw = 0,
            seed = 2101,
            swayTag = nil,
            parent = parent,
            fallbackInstance = shell,
        }
    elseif visual == "briar_ring" then
        for index = 1, 8 do
            local angle = (index / 8) * math.pi * 2 + math.pi / 8
            part(
                parent,
                "BriarSpine",
                Vector3.new(1.4, 10, 1.4),
                CFrame.new(center + Vector3.new(math.cos(angle) * 25, 4, math.sin(angle) * 25))
                    * CFrame.Angles(math.rad(18), 0, -angle),
                DARK_BARK,
                Enum.Material.Wood
            )
        end
    elseif visual == "sapfall" then
        for index = -2, 2 do
            local stone = orb(
                parent,
                "SapglassStone",
                center + Vector3.new(index * 8, 2, 17 + math.abs(index) * 2),
                4.5,
                STONE,
                Enum.Material.Slate
            )
            local sap = orb(
                parent,
                "AmberSap",
                stone.Position + Vector3.new(0, 3.2, 0),
                1.8,
                AMBER,
                Enum.Material.Neon
            )
            if index == 0 then
                light(sap, AMBER, 1.7, 18)
            end
        end
    elseif visual == "windmill" then
        local shell = buildWindmill(parent, center, runtimeIds.AmbientMotionTag)
        return {
            assetId = "mesh_foxfire_windmill_tower_a",
            fallbackKind = "placeholder",
            position = center + Vector3.new(22, 0, 20),
            scale = 1,
            yaw = 0,
            seed = 2201,
            swayTag = nil,
            parent = parent,
            fallbackInstance = shell,
        }
    elseif visual == "bridge" then
        for index = -4, 4 do
            part(
                parent,
                "RootBridgePlank",
                Vector3.new(7, 0.8, 4.5),
                CFrame.new(center + Vector3.new(19, 1 + math.abs(index) * 0.2, index * 4.4)),
                Color3.fromRGB(121, 83, 52),
                Enum.Material.WoodPlanks
            )
        end
    elseif visual == "moth_meadow" then
        part(
            parent,
            "MeadowGold",
            Vector3.new(46, 0.7, 46),
            CFrame.new(center + Vector3.new(0, 0.1, 0)),
            MEADOW,
            Enum.Material.Grass
        )
        for index = 1, 10 do
            local angle = index * 2.4
            local moth = orb(
                parent,
                "LanternMoth",
                center
                    + Vector3.new(
                        math.cos(angle) * (8 + index),
                        3 + (index % 4),
                        math.sin(angle) * (8 + index)
                    ),
                0.65,
                FOXFIRE,
                Enum.Material.Neon
            )
            CollectionService:AddTag(moth, runtimeIds.AmbientMoteTag)
        end
    elseif visual == "old_growth" then
        part(
            parent,
            "OldGrowthTrunk",
            Vector3.new(15, 48, 15),
            CFrame.new(center + Vector3.new(22, 23, 22)),
            DARK_BARK,
            Enum.Material.Wood
        )
        for index = 1, 5 do
            local angle = (index / 5) * math.pi * 2
            part(
                parent,
                "CathedralRoot",
                Vector3.new(4, 30, 5),
                CFrame.new(
                    center + Vector3.new(22 + math.cos(angle) * 10, 10, 22 + math.sin(angle) * 10)
                ) * CFrame.Angles(math.rad(24), 0, -angle),
                BARK,
                Enum.Material.Wood
            )
        end
    elseif visual == "wayhome_gate" then
        rootArch(parent, center, 1.15)
        local beacon =
            orb(parent, "WayhomeLight", center + Vector3.new(0, 8, 0), 6, AMBER, Enum.Material.Neon)
        light(beacon, AMBER, 3, 36)
        billboard(beacon, "WAYHOME GATE", CREAM)
        objectIcon(beacon, "wayhome", AMBER)
    end
end

local function buildPointOfInterest(
    parent: Instance,
    center: Vector3,
    definition: any,
    runtimeIds: any
)
    local landmark = Instance.new("Model")
    landmark.Name = "PhysicalPOI_" .. definition.id
    landmark:SetAttribute("ContentId", definition.id)
    landmark:SetAttribute("DisplayName", definition.displayName)
    landmark:SetAttribute("VisualKind", definition.visual)
    landmark.Parent = parent
    local origin = center + Vector3.new(-21, 0, -18)
    local anchor = part(
        landmark,
        "PointOfInterest",
        Vector3.new(4, 1, 4),
        CFrame.new(origin + Vector3.new(0, 0.5, 0)),
        STONE,
        Enum.Material.Slate,
        false
    )
    anchor.Transparency = 1
    anchor.CastShadow = false
    anchor:SetAttribute("ContentId", definition.id)
    anchor:SetAttribute("DisplayName", definition.displayName)
    CollectionService:AddTag(anchor, runtimeIds.ExpeditionPointOfInterestTag)

    local physicalParts = 0
    local function detail(
        name: string,
        size: Vector3,
        at: CFrame,
        color: Color3,
        material: Enum.Material,
        shape: Enum.PartType?
    ): Part
        physicalParts += 1
        local created = part(landmark, name, size, at, color, material, false)
        if shape ~= nil then
            created.Shape = shape
        end
        return created
    end

    if definition.visual == "ruined_homestead" then
        detail(
            "ReedsteadFoundation",
            Vector3.new(13, 0.65, 10),
            CFrame.new(origin + Vector3.new(0, 0.32, 0)),
            Color3.fromRGB(76, 78, 72),
            Enum.Material.Cobblestone,
            nil
        )
        for side = -1, 1, 2 do
            detail(
                "ReedsteadBrokenPost",
                Vector3.new(0.85, if side < 0 then 7.5 else 5.6, 0.85),
                CFrame.new(origin + Vector3.new(side * 5.3, if side < 0 then 4 else 3, 3.8))
                    * CFrame.Angles(0, 0, math.rad(side * 7)),
                DARK_BARK,
                Enum.Material.Wood,
                nil
            )
            detail(
                "ReedsteadWallFragment",
                Vector3.new(4.8, 4.1 + side * 0.4, 0.55),
                CFrame.new(origin + Vector3.new(side * 2.8, 2.35, 4.6))
                    * CFrame.Angles(0, 0, math.rad(side * 4)),
                BARK,
                Enum.Material.WoodPlanks,
                nil
            )
        end
        detail(
            "ReedsteadCollapsedRafter",
            Vector3.new(12.5, 0.75, 1),
            CFrame.new(origin + Vector3.new(0, 3.2, -0.4))
                * CFrame.Angles(math.rad(12), math.rad(-18), math.rad(9)),
            WET_EARTH,
            Enum.Material.Wood,
            nil
        )
        detail(
            "ReedsteadColdHearth",
            Vector3.new(3.5, 2.6, 2.4),
            CFrame.new(origin + Vector3.new(3.8, 1.3, 2.8)),
            STONE,
            Enum.Material.Cobblestone,
            nil
        )
        for crateIndex = -1, 1 do
            detail(
                "ReedsteadSupplyCrate",
                Vector3.new(2.2, 1.8 + math.abs(crateIndex) * 0.3, 2.2),
                CFrame.new(origin + Vector3.new(crateIndex * 2.6, 1, -3.2))
                    * CFrame.Angles(0, math.rad(crateIndex * 9), 0),
                if crateIndex == 0 then Color3.fromRGB(108, 124, 74) else Color3.fromRGB(91, 62, 40),
                Enum.Material.WoodPlanks,
                nil
            )
        end
    elseif definition.visual == "moth_well" then
        for stoneIndex = 1, 10 do
            local angle = stoneIndex * math.pi * 2 / 10
            detail(
                "MothwellRimStone",
                Vector3.new(2.2, 1.25, 1.55),
                CFrame.new(origin + Vector3.new(math.cos(angle) * 4.2, 0.65, math.sin(angle) * 4.2))
                    * CFrame.Angles(0, -angle, math.rad((stoneIndex % 3 - 1) * 4)),
                if stoneIndex % 2 == 0 then STONE else Color3.fromRGB(65, 74, 72),
                Enum.Material.Slate,
                nil
            )
        end
        for side = -1, 1, 2 do
            detail(
                "MothwellPost",
                Vector3.new(0.65, 7.2, 0.65),
                CFrame.new(origin + Vector3.new(side * 4.9, 3.6, 0))
                    * CFrame.Angles(0, 0, math.rad(side * 4)),
                DARK_BARK,
                Enum.Material.Wood,
                nil
            )
        end
        detail(
            "MothwellCrossbeam",
            Vector3.new(10.8, 0.7, 0.7),
            CFrame.new(origin + Vector3.new(0, 6.8, 0)),
            BARK,
            Enum.Material.Wood,
            nil
        )
        detail(
            "MothwellBucket",
            Vector3.new(2, 2.2, 2),
            CFrame.new(origin + Vector3.new(0, 2.1, 0)),
            Color3.fromRGB(93, 70, 50),
            Enum.Material.WoodPlanks,
            Enum.PartType.Cylinder
        )
        for mothIndex = 1, 5 do
            local angle = mothIndex * 2.2
            local moth = detail(
                "MothwellLanternMoth",
                Vector3.new(0.55, 0.35, 0.18),
                CFrame.new(
                    origin
                        + Vector3.new(
                            math.cos(angle) * (3.2 + mothIndex * 0.3),
                            3.2 + mothIndex * 0.55,
                            math.sin(angle) * (3.2 + mothIndex * 0.3)
                        )
                ),
                FOXFIRE,
                Enum.Material.Glass,
                nil
            )
            moth.Transparency = 0.12
            CollectionService:AddTag(moth, runtimeIds.AmbientMoteTag)
        end
    elseif definition.visual == "sap_grove" then
        for trunkIndex = -1, 1 do
            local x = trunkIndex * 4.6
            detail(
                "SapglassTrunk",
                Vector3.new(2.6, 8 + math.abs(trunkIndex) * 2.2, 2.6),
                CFrame.new(origin + Vector3.new(x, 4.3 + math.abs(trunkIndex), 1.5))
                    * CFrame.Angles(0, 0, math.rad(trunkIndex * 7)),
                DARK_BARK,
                Enum.Material.Wood,
                nil
            )
            local sap = detail(
                "SapglassVein",
                Vector3.new(0.7, 4.8, 0.32),
                CFrame.new(origin + Vector3.new(x, 4.2, 0.1)),
                AMBER,
                Enum.Material.Glass,
                nil
            )
            sap.Transparency = 0.12
        end
        detail(
            "SapglassCollector",
            Vector3.new(9.5, 1.4, 3.2),
            CFrame.new(origin + Vector3.new(0, 0.7, -3.8)),
            Color3.fromRGB(87, 64, 45),
            Enum.Material.WoodPlanks,
            nil
        )
        for vialIndex = -2, 2 do
            local vial = detail(
                "SapglassVial",
                Vector3.new(0.85, 1.45, 0.85),
                CFrame.new(origin + Vector3.new(vialIndex * 1.55, 1.95, -3.8)),
                AMBER,
                Enum.Material.Glass,
                Enum.PartType.Cylinder
            )
            vial.Transparency = 0.16
        end
    else
        for side = -1, 1, 2 do
            detail(
                "RootChapelPillar",
                Vector3.new(1.2, 9.5, 1.2),
                CFrame.new(origin + Vector3.new(side * 4.2, 4.6, 2.6))
                    * CFrame.Angles(0, 0, math.rad(-side * 11)),
                DARK_BARK,
                Enum.Material.Wood,
                nil
            )
            detail(
                "RootChapelCrown",
                Vector3.new(1.0, 7.2, 1.0),
                CFrame.new(origin + Vector3.new(side * 2.1, 8.2, 2.6))
                    * CFrame.Angles(0, 0, math.rad(side * 58)),
                BARK,
                Enum.Material.Wood,
                nil
            )
            detail(
                "RootChapelBench",
                Vector3.new(5.8, 0.65, 1.45),
                CFrame.new(origin + Vector3.new(side * 3.4, 1.05, -2.5)),
                Color3.fromRGB(92, 65, 44),
                Enum.Material.WoodPlanks,
                nil
            )
        end
        detail(
            "RootChapelAltar",
            Vector3.new(5.2, 2.6, 3.2),
            CFrame.new(origin + Vector3.new(0, 1.3, 2.9)),
            Color3.fromRGB(72, 78, 74),
            Enum.Material.Slate,
            nil
        )
        for candleIndex = -1, 1 do
            local candle = detail(
                "RootChapelMemoryCandle",
                Vector3.new(0.65, 1.25, 0.65),
                CFrame.new(origin + Vector3.new(candleIndex * 1.4, 3.15, 2.7)),
                if candleIndex == 0 then AMBER else FOXFIRE,
                Enum.Material.Glass,
                Enum.PartType.Cylinder
            )
            candle.Transparency = 0.1
        end
    end

    local memory = orb(
        landmark,
        "POIMemoryLantern",
        origin + Vector3.new(0, 4.6, -0.8),
        1.35,
        FOXFIRE,
        Enum.Material.Glass
    )
    physicalParts += 1
    memory.Transparency = 0.1
    light(memory, FOXFIRE, 0.85, 13)
    billboard(memory, string.upper(definition.displayName), FOXFIRE)
    objectIcon(memory, "memory", FOXFIRE)
    landmark:SetAttribute("PhysicalPartCount", physicalParts)
end

local function buildEventSocket(
    parent: Instance,
    center: Vector3,
    definition: any,
    runtimeIds: any
): any
    local anchor = part(
        parent,
        "EventSocket",
        Vector3.new(7, 1, 7),
        CFrame.new(center + Vector3.new(22, 0.5, -19)),
        Color3.fromRGB(99, 72, 48),
        Enum.Material.WoodPlanks
    )
    anchor:SetAttribute("ContentId", definition.id)
    anchor:SetAttribute("DisplayName", definition.displayName)
    anchor:SetAttribute("Dormant", true)
    anchor:SetAttribute("Status", "dormant")
    anchor:SetAttribute("Progress", 0)
    anchor:SetAttribute("ProgressTotal", #definition.steps)
    anchor.Transparency = 1
    anchor.CanCollide = false
    anchor.CastShadow = false
    CollectionService:AddTag(anchor, runtimeIds.ExpeditionEventTag)
    billboard(anchor, string.upper(definition.displayName), AMBER)
    objectIcon(anchor, "event", AMBER)
    destinationRing(parent, anchor.Position, AMBER, 5.5)

    local scene = Instance.new("Model")
    scene.Name = "EventScene_" .. definition.id
    scene:SetAttribute("VisualKind", definition.visual)
    scene.Parent = parent

    if definition.visual == "wagon" then
        part(
            scene,
            "LostWagon",
            Vector3.new(10, 5, 7),
            CFrame.new(anchor.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0.35, 0.14),
            Color3.fromRGB(104, 69, 42),
            Enum.Material.WoodPlanks
        )
        for wheelSide = -1, 1, 2 do
            local wheel = part(
                scene,
                "LostWagonWheel",
                Vector3.new(0.7, 5.3, 5.3),
                CFrame.new(anchor.Position + Vector3.new(wheelSide * 5.15, 2.6, 0))
                    * CFrame.Angles(0, math.rad(90), 0.14),
                Color3.fromRGB(64, 47, 36),
                Enum.Material.Wood
            )
            wheel.Shape = Enum.PartType.Cylinder
            for spokeIndex = 1, 4 do
                part(
                    scene,
                    "LostWagonSpoke",
                    Vector3.new(0.28, 4.6, 0.28),
                    wheel.CFrame * CFrame.Angles(math.rad(spokeIndex * 45), 0, 0),
                    Color3.fromRGB(91, 65, 44),
                    Enum.Material.Wood,
                    false
                )
            end
        end
        for shaftSide = -1, 1, 2 do
            part(
                scene,
                "LostWagonShaft",
                Vector3.new(0.52, 0.52, 10),
                CFrame.new(anchor.Position + Vector3.new(shaftSide * 2.5, 1.8, -7.2))
                    * CFrame.Angles(math.rad(5), 0, 0),
                Color3.fromRGB(78, 54, 38),
                Enum.Material.Wood,
                false
            )
        end
        for cargoIndex = -1, 1 do
            part(
                scene,
                "LostWagonCargo",
                Vector3.new(2.7, 2.2, 2.5),
                CFrame.new(anchor.Position + Vector3.new(cargoIndex * 2.5, 5.5, 0.2)),
                if cargoIndex == 0 then Color3.fromRGB(83, 102, 75) else Color3.fromRGB(94, 68, 45),
                if cargoIndex == 0 then Enum.Material.Fabric else Enum.Material.WoodPlanks,
                false
            )
        end
    elseif definition.visual == "hedge" then
        part(
            scene,
            "MovingHedge",
            Vector3.new(18, 9, 5),
            CFrame.new(anchor.Position + Vector3.new(0, 4.5, 0)),
            DEEP_GRASS,
            Enum.Material.Grass
        )
        for branchIndex = -3, 3 do
            part(
                scene,
                "MovingHedgeBranch",
                Vector3.new(0.55, 8.5 + math.abs(branchIndex % 2), 0.55),
                CFrame.new(anchor.Position + Vector3.new(branchIndex * 2.7, 4.2, 0.4))
                    * CFrame.Angles(0, 0, math.rad(branchIndex * 7)),
                DARK_BARK,
                Enum.Material.Wood,
                false
            )
            local leaf = orb(
                scene,
                "MovingHedgeCrown",
                anchor.Position + Vector3.new(branchIndex * 2.7, 6 + math.abs(branchIndex % 2), 0),
                2.3 + (math.abs(branchIndex) % 2) * 0.5,
                if branchIndex % 2 == 0 then DEEP_GRASS else MOSS,
                Enum.Material.Grass
            )
            leaf.CanQuery = false
        end
    elseif definition.visual == "root_bridge" then
        rootArch(scene, anchor.Position, 0.52)
    elseif definition.visual == "pollen_storm" then
        for moteIndex = 1, 7 do
            local angle = (moteIndex / 7) * math.pi * 2
            local mote = orb(
                scene,
                "PollenStormMote",
                anchor.Position
                    + Vector3.new(math.cos(angle) * 7, 3 + moteIndex % 3, math.sin(angle) * 5),
                0.7,
                Color3.fromRGB(224, 190, 93),
                Enum.Material.SmoothPlastic
            )
            mote.Transparency = 0.28
            mote.CanQuery = false
        end
    elseif definition.visual == "hungry_homestead" then
        part(
            scene,
            "HomesteadPorch",
            Vector3.new(16, 0.7, 9),
            CFrame.new(anchor.Position + Vector3.new(0, 0.35, 1)),
            Color3.fromRGB(104, 72, 45),
            Enum.Material.WoodPlanks
        )
        for side = -1, 1, 2 do
            part(
                scene,
                "HomesteadPost",
                Vector3.new(0.7, 7, 0.7),
                CFrame.new(anchor.Position + Vector3.new(side * 7, 3.5, -3)),
                DARK_BARK,
                Enum.Material.Wood
            )
        end
        part(
            scene,
            "HomesteadRoof",
            Vector3.new(18, 0.7, 11),
            CFrame.new(anchor.Position + Vector3.new(0, 7.2, 1)) * CFrame.Angles(0, 0, math.rad(3)),
            Color3.fromRGB(55, 61, 50),
            Enum.Material.Slate
        )
        part(
            scene,
            "HomesteadBackWall",
            Vector3.new(15.5, 6.8, 0.7),
            CFrame.new(anchor.Position + Vector3.new(0, 3.4, 5)),
            Color3.fromRGB(77, 55, 40),
            Enum.Material.WoodPlanks
        )
        for side = -1, 1, 2 do
            part(
                scene,
                "HomesteadSideWall",
                Vector3.new(0.7, 6.8, 8.5),
                CFrame.new(anchor.Position + Vector3.new(side * 7.5, 3.4, 1)),
                Color3.fromRGB(77, 55, 40),
                Enum.Material.WoodPlanks
            )
            part(
                scene,
                "HomesteadSupplyCrate",
                Vector3.new(2.8, 2.4, 2.7),
                CFrame.new(anchor.Position + Vector3.new(side * 4.9, 1.55, 3.1)),
                Color3.fromRGB(96, 67, 43),
                Enum.Material.WoodPlanks,
                false
            )
        end
        part(
            scene,
            "HomesteadTable",
            Vector3.new(5.8, 0.55, 2.8),
            CFrame.new(anchor.Position + Vector3.new(0, 2.7, 3)),
            Color3.fromRGB(91, 63, 43),
            Enum.Material.WoodPlanks
        )
    elseif definition.visual == "stag_tracks" then
        for side = -1, 1, 2 do
            part(
                scene,
                "WardenTrackAntler",
                Vector3.new(0.6, 6.5, 0.6),
                CFrame.new(anchor.Position + Vector3.new(side * 2.2, 4.2, 4))
                    * CFrame.Angles(0, 0, math.rad(-side * 24)),
                Color3.fromRGB(112, 109, 87),
                Enum.Material.Wood,
                false
            )
        end
        for trackIndex = 1, 5 do
            local track = part(
                scene,
                "WardenTrackPrint",
                Vector3.new(1.1, 0.18, 1.8),
                CFrame.new(
                    anchor.Position
                        + Vector3.new((trackIndex % 2) * 1.8 - 0.9, 0.12, -7 + trackIndex * 2.2)
                )
                    * CFrame.Angles(0, math.rad(-12 + trackIndex * 4), 0),
                Color3.fromRGB(53, 48, 40),
                Enum.Material.Mud,
                false
            )
            track.Shape = Enum.PartType.Ball
        end
    elseif definition.visual == "wildfire_choice" then
        for side = -1, 1, 2 do
            local flame = orb(
                scene,
                "WildfireFront",
                anchor.Position + Vector3.new(side * 8, 2.2, 4),
                2.6,
                Color3.fromRGB(232, 105, 57),
                Enum.Material.Neon
            )
            flame.Transparency = 0.12
            flame.CanQuery = false
            part(
                scene,
                "CharredSapling",
                Vector3.new(0.7, 6, 0.7),
                CFrame.new(anchor.Position + Vector3.new(side * 8, 2.8, 6))
                    * CFrame.Angles(0, 0, math.rad(side * 12)),
                Color3.fromRGB(43, 37, 34),
                Enum.Material.Wood,
                false
            )
        end
    end

    local interactions = {}
    for index, step in definition.steps do
        local offset = step.offset
        local position = anchor.Position + Vector3.new(offset.x, offset.y, offset.z)
        local target: Part
        if definition.visual == "foxlight" then
            target = orb(scene, "Foxlight_" .. step.id, position, 2.2, FOXFIRE, Enum.Material.Neon)
            target.Transparency = 0.16
            light(target, FOXFIRE, 1.1, 14)
            part(
                scene,
                "FoxlightStem_" .. step.id,
                Vector3.new(0.35, 2.2, 0.35),
                CFrame.new(position - Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, 0, math.rad(12)),
                DARK_BARK,
                Enum.Material.Wood,
                false
            )
        elseif definition.visual == "root_bridge" then
            target = orb(scene, "RootKnot_" .. step.id, position, 2.7, AMBER, Enum.Material.Wood)
            target.Shape = Enum.PartType.Cylinder
            target.CFrame *= CFrame.Angles(0, 0, math.rad(90))
            target.Size = Vector3.new(1.5, 2.7, 1.5)
            for rootIndex = -1, 1 do
                part(
                    scene,
                    "RootBridgeBranch_" .. step.id,
                    Vector3.new(0.45, 2.8, 0.45),
                    CFrame.new(position + Vector3.new(rootIndex * 0.8, 0.4, 0.8))
                        * CFrame.Angles(math.rad(34), 0, math.rad(rootIndex * 18)),
                    BARK,
                    Enum.Material.Wood,
                    false
                )
            end
        elseif definition.visual == "wagon" then
            target = part(
                scene,
                "WagonBrace_" .. step.id,
                Vector3.new(2.8, 1.4, 2.8),
                CFrame.new(position) * CFrame.Angles(0, index * 0.55, math.rad(8)),
                AMBER,
                Enum.Material.WoodPlanks,
                false
            )
        elseif definition.visual == "pollen_storm" then
            target = part(
                scene,
                "PollenScreen_" .. step.id,
                Vector3.new(4.2, 5.2, 0.45),
                CFrame.new(position) * CFrame.Angles(0, index * 0.18 - 0.36, 0),
                Color3.fromRGB(171, 148, 86),
                Enum.Material.Fabric,
                false
            )
            for postSide = -1, 1, 2 do
                part(
                    scene,
                    "PollenScreenPost_" .. step.id,
                    Vector3.new(0.35, 5.8, 0.35),
                    target.CFrame * CFrame.new(postSide * 2.2, 0, 0),
                    DARK_BARK,
                    Enum.Material.Wood,
                    false
                )
            end
        elseif definition.visual == "hungry_homestead" then
            target = part(
                scene,
                "HomesteadStore_" .. step.id,
                if step.id == "fill_water"
                    then Vector3.new(2.7, 3.4, 2.7)
                    else Vector3.new(3.6, 2.5, 3.2),
                CFrame.new(position) * CFrame.Angles(0, index * 0.42, 0),
                if step.id == "fill_water"
                    then Color3.fromRGB(76, 104, 105)
                    else Color3.fromRGB(116, 81, 48),
                if step.id == "fill_water" then Enum.Material.Metal else Enum.Material.WoodPlanks,
                false
            )
            if step.id == "fill_water" then
                target.Shape = Enum.PartType.Cylinder
            end
        elseif definition.visual == "stag_tracks" then
            target = part(
                scene,
                "WardenSign_" .. step.id,
                if step.id == "study_scrape"
                    then Vector3.new(1.1, 4.2, 1.1)
                    else Vector3.new(3.8, 0.45, 2.8),
                CFrame.new(position)
                    * CFrame.Angles(0, index * 0.3, if step.id == "study_scrape" then 0 else 0.08),
                Color3.fromRGB(102, 91, 69),
                if step.id == "study_scrape" then Enum.Material.Wood else Enum.Material.Ground,
                false
            )
            if step.id ~= "study_scrape" then
                target.Shape = Enum.PartType.Ball
            end
        elseif definition.visual == "wildfire_choice" then
            target = part(
                scene,
                "WetFirebreak_" .. step.id,
                Vector3.new(4.8, 1.2, 3.4),
                CFrame.new(position) * CFrame.Angles(0, index * 0.28, 0),
                Color3.fromRGB(96, 79, 59),
                Enum.Material.Mud,
                false
            )
            target.Shape = Enum.PartType.Ball
        else
            target = part(
                scene,
                "HedgeLatch_" .. step.id,
                Vector3.new(1.4, 3.2, 1.4),
                CFrame.new(position) * CFrame.Angles(0, 0, math.rad(index * 8 - 16)),
                AMBER,
                Enum.Material.WoodPlanks,
                false
            )
        end
        target.CastShadow = false
        objectIcon(target, "step", AMBER)
        target:SetAttribute("EventId", definition.id)
        target:SetAttribute("EventStepId", step.id)
        target:SetAttribute("EventStepState", "available")
        CollectionService:AddTag(target, runtimeIds.ExpeditionEventStepTag)
        table.insert(interactions, {
            actionText = step.actionText,
            eventId = definition.id,
            interactionId = runtimeIds.eventInteractionId(definition.id, step.id),
            objectText = step.objectText,
            stepId = step.id,
            target = target,
        })
    end

    local physicalParts = 0
    for _, descendant in scene:GetDescendants() do
        if descendant:IsA("BasePart") then
            physicalParts += 1
        end
    end
    scene:SetAttribute("PhysicalPartCount", physicalParts)

    return {
        interactions = interactions,
        socket = anchor,
    }
end

local function buildBackdrop(parent: Instance, centers: { Vector3 })
    local folder = Instance.new("Folder")
    folder.Name = "RegionalBackdrop"
    folder.Parent = parent

    local average = Vector3.zero
    for _, center in centers do
        average += center
    end
    average /= #centers

    lowMist(folder, average + Vector3.new(0, 0, 0), Vector3.new(680, 2.2, 680), 0.88)
    for ring = 1, 2 do
        for index = 1, 18 do
            local angle = (index / 18) * math.pi * 2 + ring * 0.09
            local radius = 230 + ring * 70 + (index % 4) * 18
            local height = 52 + (index % 5) * 16 + ring * 8
            local spire = part(
                folder,
                "DistantRootSpire",
                Vector3.new(10 + ring * 4, height, 10 + ring * 4),
                CFrame.new(
                    average
                        + Vector3.new(
                            math.cos(angle) * radius,
                            height / 2 - 3,
                            math.sin(angle) * radius
                        )
                ) * CFrame.Angles(math.rad(8 + ring * 2), 0, -angle),
                if ring == 1 then Color3.fromRGB(32, 45, 39) else Color3.fromRGB(24, 35, 34),
                Enum.Material.Wood
            )
            spire.Transparency = if ring == 1 then 0.08 else 0.18
            if index % 6 == 0 then
                local glow = orb(
                    folder,
                    "DistantSapGlow",
                    spire.Position + Vector3.new(0, height * 0.28, 0),
                    1.3,
                    FOXFIRE,
                    Enum.Material.Neon
                )
                glow.Transparency = 0.38
                glow.CanQuery = false
            end
        end
    end
end

local function isOccupied(center: Vector3, centers: { Vector3 }): boolean
    for _, existing in centers do
        if (existing - center).Magnitude < 1 then
            return true
        end
    end
    return false
end

local function annexCenter(
    oldGrowthCenter: Vector3,
    centers: { Vector3 },
    cellSize: number
): Vector3
    for _, direction in
        {
            Vector3.new(1, 0, 0),
            Vector3.new(0, 0, 1),
            Vector3.new(-1, 0, 0),
            Vector3.new(0, 0, -1),
        }
    do
        local candidate = oldGrowthCenter + direction * cellSize
        if not isOccupied(candidate, centers) then
            return candidate
        end
    end
    error("Old Growth has no free neighbor for the Warden's Seal")
end

local function buildWardenSeal(
    parent: Instance,
    oldGrowthCenter: Vector3,
    centers: { Vector3 },
    cellSize: number,
    runtimeIds: any
): any
    local center = annexCenter(oldGrowthCenter, centers, cellSize)
    local arena = Instance.new("Model")
    arena.Name = "WardenSealAnnex"
    arena:SetAttribute("BossId", "boss_warden_stag")
    arena:SetAttribute("ContentId", "arena_bw_warden_seal")
    arena.Parent = parent
    pcall(function()
        arena.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    end)

    pathArm(arena, oldGrowthCenter, center)
    pathArm(arena, center, oldGrowthCenter)
    part(
        arena,
        "WardenSealGround",
        Vector3.new(66, 5, 66),
        CFrame.new(center + Vector3.new(0, -2.5, 0)),
        Color3.fromRGB(38, 68, 48),
        Enum.Material.Grass
    )
    part(
        arena,
        "MemorySeal",
        Vector3.new(38, 1.1, 38),
        CFrame.new(center + Vector3.new(0, 0.15, 0)),
        STONE,
        Enum.Material.Slate
    )

    local seal = orb(
        arena,
        "WardenMemorySeal",
        center + Vector3.new(0, 1.5, 0),
        7,
        Color3.fromRGB(87, 119, 101),
        Enum.Material.SmoothPlastic
    )
    seal.Shape = Enum.PartType.Cylinder
    seal.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    seal.Size = Vector3.new(1.2, 7, 7)
    seal.Transparency = 0.52
    billboard(seal, "WARDEN'S SEAL · CLEANSE OLD GROWTH", CREAM)
    objectIcon(seal, "seal", FOXFIRE)

    local nodeDefinitions = {
        {
            direction = Vector3.new(0, 0, -1),
            interactionId = runtimeIds.InteractionIds.WardenStagRootNorth,
            nodeId = "root_node_north",
            suffix = "North",
        },
        {
            direction = Vector3.new(1, 0, 0),
            interactionId = runtimeIds.InteractionIds.WardenStagRootEast,
            nodeId = "root_node_east",
            suffix = "East",
        },
        {
            direction = Vector3.new(0, 0, 1),
            interactionId = runtimeIds.InteractionIds.WardenStagRootSouth,
            nodeId = "root_node_south",
            suffix = "South",
        },
        {
            direction = Vector3.new(-1, 0, 0),
            interactionId = runtimeIds.InteractionIds.WardenStagRootWest,
            nodeId = "root_node_west",
            suffix = "West",
        },
    }
    local nodes = {}
    local interactions = {}
    for _, definition in nodeDefinitions do
        local node = orb(
            arena,
            "LivingRootNode" .. definition.suffix,
            center + definition.direction * 22 + Vector3.new(0, 3, 0),
            5,
            Color3.fromRGB(80, 116, 83),
            Enum.Material.SmoothPlastic
        )
        node.Shape = Enum.PartType.Cylinder
        node.CFrame *= CFrame.Angles(0, 0, math.rad(90))
        node.Size = Vector3.new(2.6, 4.8, 2.6)
        node.Transparency = 0.34
        node:SetAttribute("BossId", "boss_warden_stag")
        node:SetAttribute("BossInteraction", "cleanse_root")
        node:SetAttribute("BossNodeId", definition.nodeId)
        CollectionService:AddTag(node, runtimeIds.ExpeditionBossTag)
        billboard(node, string.upper(string.gsub(definition.nodeId, "_", " ")), CREAM)
        objectIcon(node, "root", FOXFIRE)
        nodes[definition.nodeId] = node
        table.insert(interactions, {
            actionText = "CLEANSE ROOT",
            holdDuration = 0.6,
            interactionId = definition.interactionId,
            objectText = "Living Root Node",
            target = node,
        })
    end

    local antlers = {}
    for _, definition in
        {
            {
                antlerId = "antler_left",
                interactionId = runtimeIds.InteractionIds.WardenStagAntlerLeft,
                side = -1,
            },
            {
                antlerId = "antler_right",
                interactionId = runtimeIds.InteractionIds.WardenStagAntlerRight,
                side = 1,
            },
        }
    do
        local target = part(
            arena,
            if definition.side < 0 then "MemoryAntlerLeft" else "MemoryAntlerRight",
            Vector3.new(2.2, 9, 2.2),
            CFrame.new(center + Vector3.new(definition.side * 12, 4.5, 8))
                * CFrame.Angles(0, 0, math.rad(definition.side * 24)),
            Color3.fromRGB(194, 199, 173),
            Enum.Material.SmoothPlastic,
            false
        )
        target.Transparency = 0.2
        target:SetAttribute("BossId", "boss_warden_stag")
        target:SetAttribute("BossInteraction", "break_antler")
        target:SetAttribute("BossAntlerId", definition.antlerId)
        CollectionService:AddTag(target, runtimeIds.ExpeditionBossTag)
        billboard(target, "BREAK ANTLER · CHANGES FOREST", Color3.fromRGB(255, 166, 106))
        objectIcon(target, "antler", Color3.fromRGB(255, 166, 106))
        antlers[definition.antlerId] = target
        table.insert(interactions, {
            actionText = "BREAK ANTLER",
            holdDuration = 1.1,
            interactionId = definition.interactionId,
            objectText = "Harmful Shortcut",
            target = target,
        })
    end

    for index = 1, 10 do
        local angle = (index / 10) * math.pi * 2
        if math.abs(math.sin(angle)) > 0.32 then
            part(
                arena,
                "SealRootPillar",
                Vector3.new(3, 18 + (index % 3) * 4, 3),
                CFrame.new(
                    center
                        + Vector3.new(
                            math.cos(angle) * 31,
                            8 + (index % 3) * 2,
                            math.sin(angle) * 31
                        )
                ) * CFrame.Angles(math.rad(9), 0, -angle),
                if index % 2 == 0 then BARK else DARK_BARK,
                Enum.Material.Wood
            )
        end
    end
    for side = -1, 1, 2 do
        tree(arena, center + Vector3.new(side * 27, 0, -27), 1.25)
    end

    return {
        antlers = antlers,
        center = center,
        interactions = interactions,
        model = arena,
        nodes = nodes,
        seal = seal,
    }
end

local function buildBlackoutLayer(
    parent: Instance,
    centers: { Vector3 },
    bossCenter: Vector3,
    runtimeIds: any
): any
    local layer = Instance.new("Model")
    layer.Name = "BramblewakeBlackoutLayer"
    layer:SetAttribute("BlackoutId", "blackout_bramblewake")
    layer:SetAttribute("ContentId", "blackout_bw_rootfire_relay")
    layer.Parent = parent
    pcall(function()
        layer.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    end)

    local sourceCenter = assert(centers[1], "Blackout fire source center is missing")
    local fireSource = orb(
        layer,
        "BlackoutLanternFire",
        sourceCenter + Vector3.new(13, 4, 13),
        5,
        Color3.fromRGB(94, 83, 64),
        Enum.Material.SmoothPlastic
    )
    fireSource.Shape = Enum.PartType.Cylinder
    fireSource.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    fireSource.Size = Vector3.new(2.2, 4.8, 2.2)
    fireSource.Color = DARK_BARK
    fireSource.Material = Enum.Material.Wood
    local sourceFlame = orb(
        layer,
        "BlackoutLanternFlame",
        fireSource.Position + Vector3.new(0, 2.7, 0),
        2.1,
        AMBER,
        Enum.Material.Neon
    )
    light(sourceFlame, AMBER, 1.8, 16)
    fireSource:SetAttribute("BlackoutInteraction", "take_fire")
    CollectionService:AddTag(fireSource, runtimeIds.ExpeditionBlackoutTag)
    billboard(fireSource, "BLACKOUT FIRE · CARRY TO LIVING ROOTS", CREAM)
    objectIcon(fireSource, "rootfire", AMBER)

    local interactions = {
        {
            actionText = "TAKE ROOTFIRE",
            holdDuration = 0.45,
            interactionId = runtimeIds.InteractionIds.BlackoutFireSource,
            objectText = "Blackout Lantern",
            target = fireSource,
        },
    }
    local relayNodes = {}
    for _, definition in
        {
            {
                center = assert(centers[3], "Blackout farm relay center is missing"),
                interactionId = runtimeIds.InteractionIds.BlackoutRootFarm,
                label = "FARM ROOT",
                nodeId = "blackout_root_farm",
            },
            {
                center = assert(centers[7], "Blackout mill relay center is missing"),
                interactionId = runtimeIds.InteractionIds.BlackoutRootMill,
                label = "MILL ROOT",
                nodeId = "blackout_root_mill",
            },
            {
                center = assert(centers[10], "Blackout cathedral relay center is missing"),
                interactionId = runtimeIds.InteractionIds.BlackoutRootCathedral,
                label = "CATHEDRAL ROOT",
                nodeId = "blackout_root_cathedral",
            },
        }
    do
        local node = orb(
            layer,
            "BlackoutRelay_" .. definition.label,
            definition.center + Vector3.new(-14, 3.5, -12),
            6,
            Color3.fromRGB(70, 91, 72),
            Enum.Material.SmoothPlastic
        )
        node.Shape = Enum.PartType.Cylinder
        node.CFrame *= CFrame.Angles(0, 0, math.rad(90))
        node.Size = Vector3.new(2.4, 5.8, 2.4)
        node.Color = DARK_BARK
        node.Material = Enum.Material.Wood
        local relayCore = orb(
            layer,
            "BlackoutRelayCore_" .. definition.label,
            node.Position + Vector3.new(0, 3.2, 0),
            1.8,
            FOXFIRE,
            Enum.Material.Neon
        )
        light(relayCore, FOXFIRE, 1.1, 12)
        node:SetAttribute("BlackoutInteraction", "deliver_fire")
        node:SetAttribute("BlackoutNodeId", definition.nodeId)
        CollectionService:AddTag(node, runtimeIds.ExpeditionBlackoutTag)
        billboard(node, definition.label .. " · NEEDS CARRIED FIRE", CREAM)
        objectIcon(node, "livingroot", FOXFIRE)
        relayNodes[definition.nodeId] = node
        table.insert(interactions, {
            actionText = "DELIVER ROOTFIRE",
            holdDuration = 0.7,
            interactionId = definition.interactionId,
            objectText = definition.label,
            target = node,
        })

        for rootIndex = -1, 1 do
            local rootedWall = part(
                layer,
                "RootedWall",
                Vector3.new(3.5, 14 + (rootIndex + 1) * 2, 3.5),
                CFrame.new(node.Position + Vector3.new(rootIndex * 5.5, 5 + (rootIndex + 1), 4.5))
                    * CFrame.Angles(math.rad(rootIndex * 8), 0, math.rad(rootIndex * 10)),
                DARK_BARK,
                Enum.Material.Wood,
                true
            )
            rootedWall:SetAttribute("BlackoutNodeId", definition.nodeId)
        end
    end

    local decisions = {}
    for _, definition in
        {
            {
                color = MEADOW,
                decisionId = "restore_farmland",
                interactionId = runtimeIds.InteractionIds.BlackoutDecisionFarmland,
                label = "RESTORE FARMLAND",
                offset = Vector3.new(-16, 2.5, 16),
            },
            {
                color = Color3.fromRGB(71, 139, 84),
                decisionId = "wild_regrowth",
                interactionId = runtimeIds.InteractionIds.BlackoutDecisionWild,
                label = "ALLOW WILD REGROWTH",
                offset = Vector3.new(0, 2.5, 20),
            },
            {
                color = FOXFIRE,
                decisionId = "shared_agroforest",
                interactionId = runtimeIds.InteractionIds.BlackoutDecisionShared,
                label = "CREATE SHARED AGROFOREST",
                offset = Vector3.new(16, 2.5, 16),
            },
        }
    do
        local seedling = orb(
            layer,
            "GreenwardChoice_" .. definition.decisionId,
            bossCenter + definition.offset,
            5,
            definition.color,
            Enum.Material.SmoothPlastic
        )
        seedling.Transparency = 0.58
        seedling:SetAttribute("BlackoutInteraction", "chapter_decision")
        seedling:SetAttribute("BlackoutDecisionId", definition.decisionId)
        CollectionService:AddTag(seedling, runtimeIds.ExpeditionBlackoutTag)
        billboard(seedling, definition.label, CREAM)
        decisions[definition.decisionId] = seedling
        table.insert(interactions, {
            actionText = "VOTE " .. definition.label,
            holdDuration = 1.1,
            interactionId = definition.interactionId,
            objectText = "Permanent Greenward Choice",
            target = seedling,
        })
    end

    return {
        decisions = decisions,
        fireSource = fireSource,
        interactions = interactions,
        model = layer,
        relayNodes = relayNodes,
    }
end

function BramblewakeBuilder.build(
    parent: Instance,
    manifest: any,
    generator: any,
    catalog: any,
    runtimeIds: any
): any
    local existing = parent:FindFirstChild("BramblewakeExpedition")
    if existing ~= nil then
        existing:Destroy()
    end

    local expedition = Instance.new("Model")
    expedition.Name = "BramblewakeExpedition"
    expedition:SetAttribute("RegionId", manifest.regionId)
    expedition:SetAttribute("ManifestHash", manifest.hash)
    expedition:SetAttribute("Seed", manifest.seed)
    expedition:SetAttribute("Source", manifest.source)
    expedition:SetAttribute("Ready", false)
    expedition.Parent = parent

    local centers: { Vector3 } = {}
    local eventInteractions = {}
    local eventSockets: { [string]: BasePart } = {}
    local storyLandmarkCount = 0
    local storyLandmarkPartCount = 0
    local eliteArena = nil
    local oldGrowthCenter: Vector3? = nil
    local extractionTarget: BasePart? = nil
    local meshPlacements = {}
    for _, placement in manifest.modules do
        centers[placement.index] = ORIGIN
            + Vector3.new(placement.cellX * catalog.CellSize, 0, placement.cellZ * catalog.CellSize)
    end

    for _, placement in manifest.modules do
        local definition = generator.moduleDefinition(placement.moduleId)
        local center = centers[placement.index]
        local module = Instance.new("Model")
        module.Name = string.format("Module_%02d", placement.index)
        module:SetAttribute("ContentId", placement.moduleId)
        module:SetAttribute("DisplayName", definition.displayName)
        module:SetAttribute("SequenceIndex", placement.index)
        module:SetAttribute("CellX", placement.cellX)
        module:SetAttribute("CellZ", placement.cellZ)
        module.Parent = expedition
        pcall(function()
            module.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
        end)
        CollectionService:AddTag(module, runtimeIds.ExpeditionModuleTag)

        local cell = part(
            module,
            "StreamingCellCollision",
            Vector3.new(catalog.CellSize, 5, catalog.CellSize),
            CFrame.new(center + Vector3.new(0, -2.5, 0)),
            if placement.index % 2 == 0 then GRASS else Color3.fromRGB(43, 72, 49),
            Enum.Material.LeafyGrass
        )
        surfaceGrain(cell, Color3.fromRGB(23, 38, 31), 0.82)
        local clearing = part(
            module,
            "PathClearing",
            Vector3.new(26, 0.55, 26),
            CFrame.new(center + Vector3.new(0, 0.25, 0)),
            WET_EARTH,
            Enum.Material.Mud
        )
        clearing.Reflectance = 0.03
        if placement.index > 1 then
            pathArm(module, center, centers[placement.index - 1])
        end
        if placement.index < #manifest.modules then
            pathArm(module, center, centers[placement.index + 1])
            if placement.index % 2 == 1 then
                evacuationRoadMarker(module, center, centers[placement.index + 1], placement.index)
            end
        end

        moduleDressing(module, center, manifest.seed + placement.index * 97, runtimeIds)

        for cornerIndex = 1, 4 do
            local x = if cornerIndex == 1 or cornerIndex == 4 then -27 else 27
            local z = if cornerIndex <= 2 then -27 else 27
            tree(module, center + Vector3.new(x, 0, z), 0.62 + (cornerIndex % 2) * 0.08)
        end
        local meshPlacement = buildModuleVisual(module, definition.visual, center, runtimeIds)
        if meshPlacement ~= nil then
            table.insert(meshPlacements, meshPlacement)
        end
        if
            type(definition.storyLandmark) == "string"
            and type(definition.storyTitle) == "string"
        then
            local landmarkParts = buildStoryLandmark(
                module,
                center,
                definition.storyLandmark,
                definition.storyTitle,
                definition.storyOffset
            )
            assert(
                landmarkParts == definition.storyPartCount,
                "Bramblewake story landmark exceeded its authored part count"
            )
            storyLandmarkCount += 1
            storyLandmarkPartCount += landmarkParts
        end
        if definition.eliteId == "elite_old_growth" then
            oldGrowthCenter = center
            local fireSource = orb(
                module,
                "OldGrowthFireSource",
                center + Vector3.new(-20, 3.4, -12),
                4.2,
                AMBER,
                Enum.Material.SmoothPlastic
            )
            fireSource.Transparency = 0.48
            fireSource:SetAttribute("EliteId", definition.eliteId)
            fireSource:SetAttribute("EliteInteraction", "fire_source")
            billboard(fireSource, "LANTERN FIRE", CREAM)
            objectIcon(fireSource, "rootfire", AMBER)

            local rootHeart = orb(
                module,
                "OldGrowthRootHeart",
                center + Vector3.new(20, 4.2, 12),
                5.2,
                FOXFIRE,
                Enum.Material.SmoothPlastic
            )
            rootHeart.Transparency = 0.56
            rootHeart:SetAttribute("EliteId", definition.eliteId)
            rootHeart:SetAttribute("EliteInteraction", "root_heart")
            billboard(rootHeart, "ROOT HEART", CREAM)
            objectIcon(rootHeart, "root", FOXFIRE)
            CollectionService:AddTag(fireSource, runtimeIds.ExpeditionEliteTag)
            CollectionService:AddTag(rootHeart, runtimeIds.ExpeditionEliteTag)
            eliteArena = {
                center = center,
                fireSource = fireSource,
                rootHeart = rootHeart,
            }
        end
        if definition.role == "extraction" then
            local target = module:FindFirstChild("WayhomeLight")
            assert(
                target ~= nil and target:IsA("BasePart"),
                "Wayhome Gate is missing its extraction target"
            )
            target:SetAttribute("ContentId", placement.moduleId)
            target:SetAttribute("ExtractionId", "extraction_bw_wayhome")
            CollectionService:AddTag(target, runtimeIds.ExpeditionExtractionTag)
            extractionTarget = target
            destinationRing(module, target.Position, AMBER, 7)
        end

        if placement.poiId ~= nil then
            buildPointOfInterest(
                module,
                center,
                generator.pointOfInterestDefinition(placement.poiId),
                runtimeIds
            )
        elseif placement.eventId ~= nil then
            local eventResult = buildEventSocket(
                module,
                center,
                generator.eventDefinition(placement.eventId),
                runtimeIds
            )
            eventSockets[placement.eventId] = eventResult.socket
            for _, interaction in eventResult.interactions do
                table.insert(eventInteractions, interaction)
            end
        end

        if placement.index == 1 then
            local marker = orb(
                module,
                "BramblewakeArrival",
                center + Vector3.new(0, 5, 0),
                4,
                FOXFIRE,
                Enum.Material.Neon
            )
            marker.Transparency = 0.25
            billboard(marker, "BRAMBLEWAKE WOODS", CREAM)
        end
    end

    local bossArena = buildWardenSeal(
        expedition,
        assert(oldGrowthCenter, "Old Growth center is missing"),
        centers,
        catalog.CellSize,
        runtimeIds
    )
    local blackout = buildBlackoutLayer(expedition, centers, bossArena.center, runtimeIds)
    buildBackdrop(expedition, centers)

    local generatedParts = 0
    for _, descendant in expedition:GetDescendants() do
        if descendant:IsA("BasePart") then
            generatedParts += 1
        end
    end
    expedition:SetAttribute("GeneratedPartCount", generatedParts)
    expedition:SetAttribute("ModuleCount", #manifest.modules)
    expedition:SetAttribute("PointOfInterestCount", catalog.PointOfInterestCount)
    expedition:SetAttribute("EventCount", catalog.EventCount)
    expedition:SetAttribute("EventInteractionCount", #eventInteractions)
    expedition:SetAttribute("StoryLandmarkCount", storyLandmarkCount)
    expedition:SetAttribute("StoryLandmarkPartCount", storyLandmarkPartCount)
    expedition:SetAttribute("ExtractionReady", extractionTarget ~= nil)
    expedition:SetAttribute("BossArenaReady", bossArena ~= nil)
    expedition:SetAttribute("BlackoutLayerReady", blackout ~= nil)
    expedition:SetAttribute("Ready", true)

    local moduleCenters = {}
    for index, center in centers do
        table.insert(moduleCenters, {
            index = index,
            moduleId = manifest.modules[index].moduleId,
            position = center,
        })
    end
    return {
        model = expedition,
        entryCFrame = CFrame.new(centers[1] + Vector3.new(0, 5, 0)),
        extractionTarget = assert(extractionTarget, "Bramblewake extraction target is missing"),
        eventInteractions = eventInteractions,
        eventSockets = eventSockets,
        eliteArena = assert(eliteArena, "Old Growth elite arena is missing"),
        bossArena = bossArena,
        blackout = blackout,
        meshPlacements = meshPlacements,
        moduleCenters = moduleCenters,
        partCount = generatedParts,
    }
end

return table.freeze(BramblewakeBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">BramblewakeEnemyBuilder</string>
            <string name="Source"><![CDATA[--!strict

local BramblewakeEnemyBuilder = {}

local function part(
    parent: Model,
    name: string,
    size: Vector3,
    offset: Vector3,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?,
    rotation: CFrame?
): Part
    local item = Instance.new("Part")
    item.Name = name
    item.Size = size
    item.CFrame = CFrame.new(offset) * (rotation or CFrame.identity)
    item.Color = color
    item.Material = material
    item.Anchored = true
    item.CanCollide = false
    item.CanQuery = true
    item.CanTouch = false
    item.CastShadow = true
    item.TopSurface = Enum.SurfaceType.Smooth
    item.BottomSurface = Enum.SurfaceType.Smooth
    item.Shape = shape or Enum.PartType.Block
    item.Parent = parent
    return item
end

local function addEye(parent: Model, offset: Vector3, color: Color3)
    part(
        parent,
        "ReadableEye",
        Vector3.new(0.58, 0.58, 0.34),
        offset,
        color,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
end

local function rootling(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "RootCore",
        Vector3.new(4.5, 5.4, 3.4),
        origin,
        Color3.fromRGB(48, 38, 31),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "MossCrown",
        Vector3.new(5.4, 2.1, 2.6),
        origin + Vector3.new(0, 3.2, 0),
        Color3.fromRGB(51, 78, 54),
        Enum.Material.Grass,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        part(
            model,
            "RootArm",
            Vector3.new(1.1, 5.5, 1.1),
            origin + Vector3.new(side * 2.5, 0.2, 0),
            Color3.fromRGB(65, 48, 37),
            Enum.Material.Wood,
            nil,
            CFrame.Angles(0, 0, math.rad(side * 28))
        )
        addEye(model, origin + Vector3.new(side * 0.72, 0.8, -1.62), Color3.fromRGB(255, 143, 91))
    end
    return core
end

local function briarback(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BriarbackCore",
        Vector3.new(6.8, 4.2, 7.2),
        origin + Vector3.new(0, 0.4, 0),
        Color3.fromRGB(64, 47, 36),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "FrontShield",
        Vector3.new(7.8, 5.4, 1.1),
        origin + Vector3.new(0, 0.7, -3.4),
        Color3.fromRGB(47, 68, 50),
        Enum.Material.Slate,
        nil,
        CFrame.Angles(math.rad(-8), 0, 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "ShieldTusk",
            Vector3.new(3.3, 0.9, 0.9),
            origin + Vector3.new(side * 2.8, 0.5, -4.5),
            Color3.fromRGB(208, 188, 138),
            Enum.Material.Wood,
            Enum.PartType.Cylinder,
            CFrame.Angles(0, math.rad(90), math.rad(side * 8))
        )
        part(
            model,
            "BriarLeg",
            Vector3.new(1.4, 3.5, 1.4),
            origin + Vector3.new(side * 2.2, -2, 1.6),
            Color3.fromRGB(55, 42, 34),
            Enum.Material.Wood,
            nil,
            CFrame.Angles(0, 0, math.rad(side * 8))
        )
        addEye(model, origin + Vector3.new(side * 1.05, 1.2, -4.02), Color3.fromRGB(255, 196, 99))
    end
    for x = -1, 1, 2 do
        part(
            model,
            "BackThorn",
            Vector3.new(0.8, 3.4, 0.8),
            origin + Vector3.new(x * 1.7, 3, 0.6),
            Color3.fromRGB(97, 72, 43),
            Enum.Material.Wood,
            nil,
            CFrame.Angles(0, 0, math.rad(x * 25))
        )
    end
    return core
end

local function pollenWisp(model: Model, origin: Vector3): Part
    local hoverOrigin = origin + Vector3.new(0, 4.5, 0)
    local core = part(
        model,
        "PollenHeart",
        Vector3.new(3.2, 3.2, 3.2),
        hoverOrigin,
        Color3.fromRGB(255, 211, 91),
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    for index = 1, 6 do
        local angle = (index - 1) * math.pi / 3
        local offset = Vector3.new(math.cos(angle) * 2.7, math.sin(angle) * 2.7, 0.3)
        part(
            model,
            "PollenPetal",
            Vector3.new(2.4, 1.1, 0.7),
            hoverOrigin + offset,
            Color3.fromRGB(231, 181, 83),
            Enum.Material.SmoothPlastic,
            Enum.PartType.Ball,
            CFrame.Angles(0, 0, angle)
        )
    end
    part(
        model,
        "DrowsyTrail",
        Vector3.new(1.5, 4.5, 1.5),
        hoverOrigin + Vector3.new(0, -3.1, 0),
        Color3.fromRGB(120, 163, 105),
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    ).Transparency =
        0.35
    addEye(model, hoverOrigin + Vector3.new(0, 0.3, -1.58), Color3.fromRGB(37, 45, 39))
    return core
end

local function hollowCrow(model: Model, origin: Vector3): Part
    local hoverOrigin = origin + Vector3.new(0, 5, 0)
    local core = part(
        model,
        "HollowCrowCore",
        Vector3.new(3.6, 3.8, 4.5),
        hoverOrigin,
        Color3.fromRGB(31, 35, 42),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        CFrame.Angles(math.rad(-12), 0, 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "CrowWing",
            Vector3.new(7.8, 0.65, 3.4),
            hoverOrigin + Vector3.new(side * 4.2, 0.25, 0.5),
            Color3.fromRGB(42, 47, 55),
            Enum.Material.Slate,
            nil,
            CFrame.Angles(0, math.rad(side * 10), math.rad(side * 12))
        )
        addEye(
            model,
            hoverOrigin + Vector3.new(side * 0.72, 0.65, -2.12),
            Color3.fromRGB(126, 211, 194)
        )
    end
    part(
        model,
        "CrowBeak",
        Vector3.new(1.5, 1.1, 3.3),
        hoverOrigin + Vector3.new(0, 0.1, -3.35),
        Color3.fromRGB(183, 154, 83),
        Enum.Material.Wood,
        nil,
        CFrame.Angles(math.rad(-12), 0, 0)
    )
    part(
        model,
        "StolenSpark",
        Vector3.new(1.1, 1.1, 1.1),
        hoverOrigin + Vector3.new(0, -2.2, 0.2),
        Color3.fromRGB(255, 203, 97),
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    return core
end

local function snapvine(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "SnapvineRoot",
        Vector3.new(4.6, 2.2, 4.6),
        origin,
        Color3.fromRGB(59, 46, 35),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "VineStem",
        Vector3.new(6.5, 1.8, 1.8),
        origin + Vector3.new(0, 3.6, 0),
        Color3.fromRGB(57, 91, 53),
        Enum.Material.Grass,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, 0, math.rad(90))
    )
    for side = -1, 1, 2 do
        part(
            model,
            "SnapJaw",
            Vector3.new(5.5, 1.5, 4.2),
            origin + Vector3.new(0, 6.2 + side * 0.9, -0.9),
            if side < 0 then Color3.fromRGB(73, 111, 62) else Color3.fromRGB(91, 126, 65),
            Enum.Material.Grass,
            nil,
            CFrame.Angles(math.rad(side * 15), 0, 0)
        )
        addEye(model, origin + Vector3.new(side * 1.2, 6.4, -3), Color3.fromRGB(255, 116, 82))
        for index = 1, 2 do
            part(
                model,
                "JawThorn",
                Vector3.new(0.55, 1.5, 0.55),
                origin + Vector3.new(side * index * 1.25, 6.1, -3.15),
                Color3.fromRGB(221, 205, 151),
                Enum.Material.Wood,
                nil,
                CFrame.Angles(math.rad(70), 0, math.rad(side * 15))
            )
        end
    end
    return core
end

local function barkRam(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BarkRamCore",
        Vector3.new(7.5, 5.8, 8.4),
        origin + Vector3.new(0, 0.5, 0),
        Color3.fromRGB(65, 49, 38),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "RamBrow",
        Vector3.new(6.2, 3.6, 3),
        origin + Vector3.new(0, 1.5, -4.1),
        Color3.fromRGB(54, 70, 50),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        part(
            model,
            "RamHorn",
            Vector3.new(6.2, 1.5, 1.5),
            origin + Vector3.new(side * 3.2, 2.2, -5.1),
            Color3.fromRGB(219, 195, 139),
            Enum.Material.Wood,
            Enum.PartType.Cylinder,
            CFrame.Angles(0, math.rad(90), math.rad(side * 13))
        )
        for front = -1, 1, 2 do
            part(
                model,
                "RamLeg",
                Vector3.new(1.7, 4.2, 1.7),
                origin + Vector3.new(side * 2.45, -2.6, front * 2.35),
                Color3.fromRGB(57, 43, 34),
                Enum.Material.Wood,
                nil,
                CFrame.Angles(0, 0, math.rad(side * 4))
            )
        end
        addEye(model, origin + Vector3.new(side * 1.15, 1.8, -5.38), Color3.fromRGB(255, 152, 91))
    end
    part(
        model,
        "MossBack",
        Vector3.new(6.5, 1.5, 6),
        origin + Vector3.new(0, 3.5, 0.6),
        Color3.fromRGB(62, 91, 55),
        Enum.Material.Grass,
        Enum.PartType.Ball,
        nil
    )
    return core
end

function BramblewakeEnemyBuilder.build(definition: any, origin: Vector3, target: Vector3): Model
    local model = Instance.new("Model")
    model.Name = definition.displayName:gsub("%s+", "")
    model:SetAttribute("EnemyId", definition.id)
    model:SetAttribute("EnemyDisplayName", definition.displayName)
    model:SetAttribute("EnemyHealth", definition.health)
    model:SetAttribute("EnemyMaxHealth", definition.health)

    local core: Part
    if definition.modelKey == "briarback" then
        core = briarback(model, origin)
    elseif definition.modelKey == "pollen_wisp" then
        core = pollenWisp(model, origin)
    elseif definition.modelKey == "hollow_crow" then
        core = hollowCrow(model, origin)
    elseif definition.modelKey == "snapvine" then
        core = snapvine(model, origin)
    elseif definition.modelKey == "bark_ram" then
        core = barkRam(model, origin)
    else
        core = rootling(model, origin)
    end
    model.PrimaryPart = core

    local highlight = Instance.new("Highlight")
    highlight.Name = "ThreatOutline"
    highlight.FillColor = Color3.fromRGB(80, 29, 29)
    highlight.FillTransparency = 0.76
    highlight.OutlineColor = Color3.fromRGB(255, 143, 91)
    highlight.OutlineTransparency = 0.16
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = model

    local flatTarget = Vector3.new(target.X, core.Position.Y, target.Z)
    if (flatTarget - core.Position).Magnitude > 0.01 then
        model:PivotTo(CFrame.lookAt(core.Position, flatTarget))
    end
    return model
end

return table.freeze(BramblewakeEnemyBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">FoliageBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Organic tree, rock, and undergrowth silhouettes for the Bramblewake valley.

    WHY THIS EXISTS

    The valley's trees were a box trunk plus six axis-aligned wedge slabs, and
    its rocks were single spheres. Both read as exactly what they are. The art
    direction asks for "strong silhouettes ... over raw part count", and the
    fastest way to break a box silhouette is not more parts -- it is rotation,
    taper, and asymmetry on the parts already being spent.

    So every generator here spends a similar part budget to the shapes it
    replaces and buys silhouette with it instead of volume:

      * trunks taper and lean, in segments, rather than being one prism;
      * canopies are rotated, offset, non-uniformly scaled masses, so no two
        read as the same object and none present a flat face to the camera;
      * rocks are clustered, part-buried, unevenly scaled boulders;
      * species differ in shape language, not just colour, so the treeline has
        variety at silhouette distance where colour has already washed out.

    Everything is seeded. Two servers, and a Studio build against a live one,
    generate an identical forest.

    PROCEDURAL FALLBACKS

    Measured authored MeshParts now replace selected core/near placements. The
    functions in this module remain important: distant bands use them for a
    cheap silhouette budget, and every authored placement falls back here if a
    private asset is unavailable. Joining never waits on optional art.
]]

local CollectionService = game:GetService("CollectionService")

local FoliageBuilder = {}

export type Tone = {
    bark: Color3,
    barkWet: Color3,
    needle: Color3,
    needleDeep: Color3,
    leaf: Color3,
    leafPale: Color3,
    moss: Color3,
    stone: Color3,
    stoneWarm: Color3,
}

local function newPart(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide
    instance.CanTouch = canCollide
    if not canCollide then
        instance.CanQuery = false
    end
    -- Shadows follow collision, which here is the same line as "structure vs.
    -- decoration": trunks, logs, and the lead boulder cast, while canopy
    -- masses, ferns, moss, and splinters do not. The forest is ~4,200 parts and
    -- the overwhelming majority are decoration, so casting from all of them
    -- would spend the whole shadow budget on foliage that only ever produces
    -- noise -- exactly the "disable shadows on minor parts according to art
    -- budget" rule in the technical architecture. The trunks still ground every
    -- tree, which is the shadow that actually reads.
    instance.CastShadow = canCollide
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

--[[
    Creates a cylinder of `length` and `diameter` whose long axis runs along
    `orientation`'s *up* direction.

    This exists because a Roblox cylinder's circular faces point along its
    LOCAL X axis, so `Size.X` is the length and `Size.Y`/`Size.Z` are the
    diameters -- the opposite of the intuitive (diameter, height, diameter)
    ordering every other upright part uses. Getting this wrong does not error
    or look obviously broken in code; it silently produces a disc that is one
    diameter long and several studs wide in the wrong direction, which is
    exactly what shipped in the first version of this file and in the
    generator it replaced.

    Callers pass a CFrame oriented the way they want the cylinder to *point*
    (its up axis becomes the cylinder's length), and this applies the axis
    swap. One place to be wrong instead of five.
]]
local function cylinderPart(
    parent: Instance,
    name: string,
    length: number,
    diameter: number,
    orientation: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean
): Part
    local instance = newPart(
        parent,
        name,
        Vector3.new(length, diameter, diameter),
        orientation * CFrame.Angles(0, 0, math.rad(90)),
        color,
        material,
        canCollide
    )
    instance.Shape = Enum.PartType.Cylinder
    return instance
end

--[[
    Creates a cylinder spanning two points.

    Defining a cylinder by its endpoints removes the axis reasoning entirely,
    which matters most for the near-horizontal pieces: deriving "which roll and
    yaw make the length point that way" by hand is what produced the disc-shaped
    trunks in the first place, and it also silently decouples a piece from the
    positions computed around it. With endpoints, the geometry and the things
    placed against it read from the same two vectors.

    CFrame.lookAt's LookVector is the span direction, and rotating 90 degrees
    about Y brings the cylinder's local X onto it.
]]
local function cylinderBetween(
    parent: Instance,
    name: string,
    fromPoint: Vector3,
    toPoint: Vector3,
    diameter: number,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean
): Part?
    local span = toPoint - fromPoint
    local length = span.Magnitude
    if length < 0.05 then
        -- CFrame.lookAt is undefined for coincident points, and a zero-length
        -- cylinder is not worth an instance.
        return nil
    end

    local instance = newPart(
        parent,
        name,
        Vector3.new(length, diameter, diameter),
        CFrame.lookAt(fromPoint + span * 0.5, toPoint) * CFrame.Angles(0, math.rad(90), 0),
        color,
        material,
        canCollide
    )
    instance.Shape = Enum.PartType.Cylinder
    return instance
end

--[[
    A leaning, tapering trunk built from stacked segments.

    Each segment is narrower and slightly more offset than the one below, which
    is what separates a tree from a pole. The lean is derived from position so a
    stand of trees leans coherently, as though the same weather shaped it,
    rather than each one tilting at random.
]]
local function trunk(
    parent: Instance,
    base: Vector3,
    height: number,
    radius: number,
    lean: number,
    tone: Tone
): Vector3
    local segments = 4
    local top = base
    local drift = Vector3.new(math.cos(lean), 0, math.sin(lean))

    for index = 1, segments do
        local fraction = (index - 1) / segments
        local nextFraction = index / segments
        local segmentHeight = height / segments
        local segmentRadius = radius * (1 - fraction * 0.52)
        local offset = drift * (height * 0.05 * nextFraction * nextFraction)
        local center = base + Vector3.new(0, height * fraction + segmentHeight / 2, 0) + offset

        -- Upright, with a small tilt that grows toward the crown so the trunk
        -- curves rather than hinging.
        cylinderPart(
            parent,
            "TreeTrunk",
            segmentHeight * 1.04,
            segmentRadius * 2,
            CFrame.new(center)
                * CFrame.Angles(0, lean, 0)
                * CFrame.Angles(0, 0, math.sin(lean) * 0.06 * nextFraction),
            if index == 1 then tone.barkWet else tone.bark,
            Enum.Material.Wood,
            index <= 2
        )

        top = center + Vector3.new(0, segmentHeight / 2, 0) + offset
    end

    -- Root flare: a wider, part-buried base stops the trunk from looking like
    -- it was pushed into the ground.
    local flare = newPart(
        parent,
        "TreeRootFlare",
        Vector3.new(radius * 3.1, radius * 2.1, radius * 3.1),
        CFrame.new(base + Vector3.new(0, radius * 0.35, 0)),
        tone.barkWet,
        Enum.Material.Wood,
        false
    )
    flare.Shape = Enum.PartType.Ball

    return top
end

--[[
    A conifer: stacked, rotated, non-uniform canopy masses.

    The old version used two axis-aligned wedges per layer, so every tree
    presented the same flat triangle to the camera. Rotating each layer off the
    axis and varying its scale means the silhouette changes as the player moves
    around it, which is the property that reads as "a tree" at distance.
]]
function FoliageBuilder.conifer(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number,
    swayTag: string?
)
    local random = Random.new(seed)
    local height = 26 * scale
    local lean = position.X * 0.004 + random:NextNumber(-0.14, 0.14)
    local top = trunk(parent, position, height, 1.5 * scale, lean, tone)

    local layers = 5
    for index = 1, layers do
        local fraction = (index - 1) / layers
        local layerY = height * (0.32 + fraction * 0.72)
        local spread = (10.5 - index * 1.35) * scale * random:NextNumber(0.88, 1.12)
        local thickness = (5.4 - index * 0.55) * scale

        -- Three masses per layer at uneven angles: no flat face, no repeat.
        for wedgeIndex = 1, 3 do
            local angle = (wedgeIndex / 3) * math.pi * 2
                + fraction * 1.9
                + random:NextNumber(-0.25, 0.25)
            local reach = spread * random:NextNumber(0.42, 0.6)
            local center = position
                + Vector3.new(
                    math.cos(angle) * reach + math.cos(lean) * layerY * 0.05,
                    layerY,
                    math.sin(angle) * reach + math.sin(lean) * layerY * 0.05
                )

            local needle = newPart(
                parent,
                "ConiferCanopy",
                Vector3.new(
                    spread * random:NextNumber(0.72, 0.95),
                    thickness * random:NextNumber(0.85, 1.15),
                    spread * random:NextNumber(0.72, 0.95)
                ),
                CFrame.new(center)
                    * CFrame.Angles(
                        random:NextNumber(-0.22, 0.22),
                        angle,
                        random:NextNumber(-0.22, 0.22)
                    ),
                if index >= layers - 1 then tone.needle else tone.needleDeep,
                Enum.Material.Grass,
                false
            )
            needle.Shape = Enum.PartType.Ball

            if swayTag ~= nil and index >= layers - 1 and wedgeIndex == 1 then
                CollectionService:AddTag(needle, swayTag)
            end
        end
    end

    -- A crown tip so the tree resolves to a point instead of a dome.
    local tip = newPart(
        parent,
        "ConiferCrown",
        Vector3.new(2.6 * scale, 6.5 * scale, 2.6 * scale),
        CFrame.new(top + Vector3.new(0, height * 0.16, 0)),
        tone.needle,
        Enum.Material.Grass,
        false
    )
    tip.Shape = Enum.PartType.Ball
    if swayTag ~= nil then
        CollectionService:AddTag(tip, swayTag)
    end
end

--[[
    A broadleaf: a shorter, heavier canopy on a forking trunk.

    Present so the treeline is not one repeated species. Difference is in shape
    language -- wide clustered crown, visible limbs -- not just a colour swap,
    because colour is the first thing distance and night lighting remove.
]]
function FoliageBuilder.broadleaf(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number,
    swayTag: string?
)
    local random = Random.new(seed)
    local height = 19 * scale
    local lean = random:NextNumber(-0.2, 0.2)
    local top = trunk(parent, position, height, 1.8 * scale, lean, tone)

    -- Limbs, so the canopy has something to sit on.
    for limbIndex = 1, 3 do
        local angle = (limbIndex / 3) * math.pi * 2 + random:NextNumber(-0.4, 0.4)
        -- Angled outward and up from the trunk top. The 52-degree roll leans
        -- the limb away from vertical; cylinderPart handles the axis swap.
        cylinderPart(
            parent,
            "BroadleafLimb",
            8 * scale,
            1.05 * scale,
            CFrame.new(
                top
                    + Vector3.new(
                        math.cos(angle) * 2.6 * scale,
                        2.2 * scale,
                        math.sin(angle) * 2.6 * scale
                    )
            ) * CFrame.Angles(0, angle, math.rad(52)),
            tone.bark,
            Enum.Material.Wood,
            false
        )
    end

    for cluster = 1, 6 do
        local angle = (cluster / 6) * math.pi * 2 + random:NextNumber(-0.3, 0.3)
        local reach = random:NextNumber(3.4, 6.6) * scale
        local blobSize = random:NextNumber(7.5, 11.5) * scale
        local center = top
            + Vector3.new(
                math.cos(angle) * reach,
                random:NextNumber(3.2, 6.4) * scale,
                math.sin(angle) * reach
            )

        local leaves = newPart(
            parent,
            "BroadleafCanopy",
            Vector3.new(blobSize, blobSize * random:NextNumber(0.62, 0.82), blobSize),
            CFrame.new(center)
                * CFrame.Angles(random:NextNumber(-0.3, 0.3), angle, random:NextNumber(-0.3, 0.3)),
            if cluster % 3 == 0 then tone.leafPale else tone.leaf,
            Enum.Material.LeafyGrass,
            false
        )
        leaves.Shape = Enum.PartType.Ball

        if swayTag ~= nil and cluster % 3 == 1 then
            CollectionService:AddTag(leaves, swayTag)
        end
    end
end

--[[
    A dead snag: bare, broken, leaning.

    Cheap silhouette variety and the shape language the art direction assigns to
    the Long Night -- "broken repetition, inverted familiar shapes". A treeline
    of nothing but healthy trees has no story in it.
]]
function FoliageBuilder.snag(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number
)
    local random = Random.new(seed)
    local height = random:NextNumber(13, 21) * scale
    local lean = random:NextNumber(-0.34, 0.34)
    local top = trunk(parent, position, height, 1.25 * scale, lean, tone)

    for _ = 1, random:NextInteger(2, 4) do
        local angle = random:NextNumber(0, math.pi * 2)
        local length = random:NextNumber(3.5, 7) * scale
        cylinderPart(
            parent,
            "SnagBranch",
            length,
            0.55 * scale,
            CFrame.new(
                top
                    + Vector3.new(
                        math.cos(angle) * length * 0.32,
                        -random:NextNumber(0.5, 4) * scale,
                        math.sin(angle) * length * 0.32
                    )
            ) * CFrame.Angles(0, angle, math.rad(random:NextNumber(38, 74))),
            tone.barkWet,
            Enum.Material.Wood,
            false
        )
    end
end

--[[
    A boulder cluster: several unevenly scaled, part-buried, rotated masses.

    One sphere reads as a ball. Three overlapping spheres of different sizes,
    each sunk into the ground at a different depth, read as rock -- the buried
    contact is what sells it, because a rock resting exactly on a surface looks
    dropped.
]]
function FoliageBuilder.boulders(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number
)
    local random = Random.new(seed)
    local count = random:NextInteger(2, 4)

    for index = 1, count do
        local offset = Vector3.new(
            random:NextNumber(-3.4, 3.4) * scale,
            0,
            random:NextNumber(-3.4, 3.4) * scale
        )
        local size = random:NextNumber(2.6, 6.4) * scale
        -- Sink each boulder a different amount so the cluster has contact with
        -- the ground instead of sitting on it.
        local sink = random:NextNumber(0.22, 0.48)

        local stone = newPart(
            parent,
            "Boulder",
            Vector3.new(
                size * random:NextNumber(1, 1.5),
                size * random:NextNumber(0.62, 0.95),
                size
            ),
            CFrame.new(position + offset + Vector3.new(0, size * (0.5 - sink), 0))
                * CFrame.Angles(
                    random:NextNumber(-0.3, 0.3),
                    random:NextNumber(0, math.pi * 2),
                    random:NextNumber(-0.3, 0.3)
                ),
            if index == 1 then tone.stone else tone.stoneWarm,
            Enum.Material.Rock,
            index == 1
        )
        stone.Shape = Enum.PartType.Ball

        if index == count and random:NextNumber() < 0.6 then
            local cap = newPart(
                parent,
                "BoulderMoss",
                Vector3.new(size * 0.92, size * 0.34, size * 0.86),
                CFrame.new(position + offset + Vector3.new(0, size * (0.72 - sink), 0))
                    * CFrame.Angles(0, random:NextNumber(0, math.pi), 0),
                tone.moss,
                Enum.Material.Grass,
                false
            )
            cap.Shape = Enum.PartType.Ball
        end
    end
end

--[[
    A fallen log with a torn end and a couple of shelf fungi.

    Horizontal mass among vertical trunks; the treeline needs both or it reads
    as a fence.
]]
function FoliageBuilder.deadfall(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number
)
    local random = Random.new(seed)
    local angle = random:NextNumber(0, math.pi * 2)
    local length = random:NextNumber(12, 20) * scale
    local radius = random:NextNumber(1.1, 1.8) * scale

    -- Both ends are computed once and reused, so the log, its splinters, and
    -- its fungi cannot drift apart.
    local heading = Vector3.new(math.cos(angle), 0, math.sin(angle))
    local center = position + Vector3.new(0, radius * 0.78, 0)
    local tailEnd = center - heading * (length * 0.5)
    local headEnd = center + heading * (length * 0.5)

    cylinderBetween(
        parent,
        "FallenLog",
        tailEnd,
        headEnd,
        radius * 2,
        tone.barkWet,
        Enum.Material.Wood,
        true
    )

    -- Splintered end, so the log looks broken rather than sawn. Each shard
    -- fans out from the real end point.
    for splinter = 1, 3 do
        local fan = (splinter - 2) * 0.5
        local outward = Vector3.new(math.cos(angle + fan), 0, math.sin(angle + fan))
        local shardLength = radius * random:NextNumber(1.4, 2.6)
        cylinderBetween(
            parent,
            "LogSplinter",
            headEnd,
            headEnd
                + outward * shardLength
                + Vector3.new(0, random:NextNumber(-0.4, 0.9) * radius, 0),
            radius * 0.42,
            tone.bark,
            Enum.Material.Wood,
            false
        )
    end

    for shelf = 1, random:NextInteger(1, 3) do
        -- Positioned along the same axis the log was built from, so a shelf
        -- always lands on the log rather than beside it.
        local along = random:NextNumber(0.18, 0.82)
        local seat = tailEnd:Lerp(headEnd, along) + Vector3.new(0, radius * 0.72, 0)
        local fungus = newPart(
            parent,
            "ShelfFungus",
            Vector3.new(radius * 1.9, radius * 0.3, radius * 1.35),
            CFrame.new(seat) * CFrame.Angles(0, angle + shelf, math.rad(random:NextNumber(-14, 14))),
            tone.leafPale,
            Enum.Material.Fabric,
            false
        )
        fungus.Shape = Enum.PartType.Ball
    end
end

--[[
    Low undergrowth: ferns splayed from a common root.

    Kept cheap and non-colliding. Placed only where the route is not, so it
    never blocks navigation or the mobile camera.
]]
function FoliageBuilder.undergrowth(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number,
    swayTag: string?
)
    local random = Random.new(seed)
    local fronds = random:NextInteger(5, 8)

    for index = 1, fronds do
        local angle = (index / fronds) * math.pi * 2 + random:NextNumber(-0.2, 0.2)
        local length = random:NextNumber(2.4, 4.2) * scale
        local frond = newPart(
            parent,
            "FernFrond",
            Vector3.new(0.42 * scale, 0.16 * scale, length),
            CFrame.new(
                position
                    + Vector3.new(
                        math.cos(angle) * length * 0.34,
                        random:NextNumber(0.4, 0.9) * scale,
                        math.sin(angle) * length * 0.34
                    )
            ) * CFrame.Angles(math.rad(random:NextNumber(16, 34)), angle, 0),
            if index % 2 == 0 then tone.moss else tone.leaf,
            Enum.Material.Grass,
            false
        )

        if swayTag ~= nil and index == 1 then
            CollectionService:AddTag(frond, swayTag)
        end
    end
end

-- A recognizable route landmark used only if the authored PBR root arch is
-- unavailable. Its opening remains clear and every piece is non-colliding.
function FoliageBuilder.rootArch(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    yaw: number
)
    local right = Vector3.new(math.cos(yaw), 0, math.sin(yaw))
    local forward = Vector3.new(-math.sin(yaw), 0, math.cos(yaw))
    local halfWidth = 9.4 * scale
    local height = 13.2 * scale

    for side = -1, 1, 2 do
        local base = position + right * (halfWidth * side)
        local points = {
            base,
            base
                + right * (-side * 1.2 * scale)
                + forward * (side * 0.2 * scale)
                + Vector3.new(0, height * 0.3, 0),
            base
                + right * (-side * 3.6 * scale)
                + forward * (-side * 0.1 * scale)
                + Vector3.new(0, height * 0.67, 0),
            position + right * (side * 2.2 * scale) + Vector3.new(0, height * 0.94, 0),
            position + Vector3.new(0, height, 0),
        }
        for index = 1, #points - 1 do
            cylinderBetween(
                parent,
                "RootArch",
                points[index],
                points[index + 1],
                (2.2 - index * 0.26) * scale,
                if index == 1 then tone.barkWet else tone.bark,
                Enum.Material.Wood,
                false
            )
        end

        for rootIndex = 1, 3 do
            local spread = (rootIndex - 2) * 0.55
            cylinderBetween(
                parent,
                "RootArchFlare",
                base + Vector3.new(0, 0.45 * scale, 0),
                base
                    + right * (side * (2.1 + rootIndex * 0.45) * scale)
                    + forward * (spread * 3.1 * scale)
                    + Vector3.new(0, 0.08 * scale, 0),
                0.56 * scale,
                tone.barkWet,
                Enum.Material.Wood,
                false
            )
        end
    end

    for mossIndex = 1, 5 do
        local offset = (mossIndex - 3) * 1.15 * scale
        local moss = newPart(
            parent,
            "RootArchMoss",
            Vector3.new(2.8, 0.7, 1.8) * scale,
            CFrame.new(position + right * offset + Vector3.new(0, height + 0.2 * scale, 0))
                * CFrame.Angles(0, yaw + mossIndex * 0.41, 0),
            tone.moss,
            Enum.Material.Grass,
            false
        )
        moss.Shape = Enum.PartType.Ball
    end
end

return table.freeze(FoliageBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">MeshAssetRegistry</string>
            <string name="Source"><![CDATA[--!strict

-- Roblox model assets created from the measured GLBs in assets/meshes.
-- Stable IDs are source-facing; numeric IDs may only change through the
-- manifest/upload pipeline and a matching review of this registry.

local MeshAssetRegistry = {}

export type Entry = {
    id: string,
    assetId: number,
    targetLongestDimension: number,
    maxTriangles: number,
    maxMaterialSlots: number,
    placementBand: string,
    pbr: boolean,
}

local ENTRIES: { Entry } = {
    {
        id = "mesh_conifer_hero_a",
        assetId = 97306204840235,
        targetLongestDimension = 27,
        maxTriangles = 7500,
        maxMaterialSlots = 4,
        placementBand = "core_near",
        pbr = false,
    },
    {
        id = "mesh_conifer_hero_b",
        assetId = 88242699154685,
        targetLongestDimension = 24,
        maxTriangles = 7500,
        maxMaterialSlots = 4,
        placementBand = "core_near",
        pbr = false,
    },
    {
        id = "mesh_broadleaf_hero_a",
        assetId = 101220678345453,
        targetLongestDimension = 23,
        maxTriangles = 9000,
        maxMaterialSlots = 5,
        placementBand = "core_near_town_edge",
        pbr = false,
    },
    {
        id = "mesh_boulder_cluster_a",
        assetId = 89472159459936,
        targetLongestDimension = 10,
        maxTriangles = 3500,
        maxMaterialSlots = 3,
        placementBand = "core_near",
        pbr = false,
    },
    {
        id = "mesh_deadfall_a",
        assetId = 81668325055416,
        targetLongestDimension = 17,
        maxTriangles = 6500,
        maxMaterialSlots = 5,
        placementBand = "core_near",
        pbr = false,
    },
    {
        id = "mesh_root_arch_a",
        assetId = 133332812215237,
        targetLongestDimension = 25,
        maxTriangles = 10000,
        maxMaterialSlots = 1,
        placementBand = "curated_core",
        pbr = true,
    },
    {
        id = "mesh_fern_cluster_a",
        assetId = 133339285156460,
        targetLongestDimension = 5,
        maxTriangles = 1800,
        maxMaterialSlots = 2,
        placementBand = "core",
        pbr = false,
    },
    {
        id = "mesh_hollow_lantern_shrine_a",
        assetId = 82771177912612,
        targetLongestDimension = 28,
        maxTriangles = 8000,
        maxMaterialSlots = 7,
        placementBand = "curated_core",
        pbr = false,
    },
    {
        id = "mesh_wayfarer_cabin_a",
        assetId = 108978160303399,
        targetLongestDimension = 20,
        maxTriangles = 5000,
        maxMaterialSlots = 6,
        placementBand = "retired_visual_failure",
        pbr = false,
    },
    {
        id = "mesh_lantern_post_a",
        assetId = 129285000481750,
        targetLongestDimension = 9,
        maxTriangles = 2200,
        maxMaterialSlots = 4,
        placementBand = "curated_core",
        pbr = false,
    },
    {
        id = "mesh_crooked_farmhouse_a",
        assetId = 117710597512522,
        targetLongestDimension = 24,
        maxTriangles = 5000,
        maxMaterialSlots = 6,
        placementBand = "curated_expedition",
        pbr = false,
    },
    {
        id = "mesh_foxfire_windmill_tower_a",
        assetId = 116166738568510,
        targetLongestDimension = 36,
        maxTriangles = 3200,
        maxMaterialSlots = 6,
        placementBand = "curated_expedition",
        pbr = false,
    },
}

local BY_ID: { [string]: Entry } = {}
for _, entry in ENTRIES do
    assert(BY_ID[entry.id] == nil, "duplicate mesh asset stable ID: " .. entry.id)
    BY_ID[entry.id] = table.freeze(entry)
end

function MeshAssetRegistry.get(stableId: string): Entry?
    return BY_ID[stableId]
end

function MeshAssetRegistry.all(): { Entry }
    return table.clone(ENTRIES)
end

function MeshAssetRegistry.scaleFor(stableId: string, importedLongestDimension: number): number?
    local entry = BY_ID[stableId]
    if entry == nil or importedLongestDimension <= 0 then
        return nil
    end
    return entry.targetLongestDimension / importedLongestDimension
end

return table.freeze(MeshAssetRegistry)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">MeshTemplateLoader</string>
            <string name="Source"><![CDATA[--!strict

local InsertService = game:GetService("InsertService")

local MeshAssetRegistry = require(script.Parent.MeshAssetRegistry)

local MeshTemplateLoader = {}
MeshTemplateLoader.__index = MeshTemplateLoader

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type MeshTemplateLoader = typeof(setmetatable(
    {} :: {
        _logger: Logger,
        _templates: { [string]: Model },
        _templateScale: { [string]: number },
        _failed: { [string]: boolean },
    },
    MeshTemplateLoader
))

local function sanitize(model: Model): number
    local meshParts = 0
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false
            descendant.CastShadow = true
            descendant.Massless = true
            if descendant:IsA("MeshPart") then
                meshParts += 1
            end
        elseif
            descendant:IsA("LuaSourceContainer")
            or descendant:IsA("ProximityPrompt")
            or descendant:IsA("ClickDetector")
            or descendant:IsA("DragDetector")
            or descendant:IsA("Constraint")
            or descendant:IsA("JointInstance")
            or descendant:IsA("Humanoid")
            or descendant:IsA("AnimationController")
        then
            descendant:Destroy()
        end
    end
    return meshParts
end

local function longestDimension(size: Vector3): number
    return math.max(size.X, size.Y, size.Z)
end

function MeshTemplateLoader.new(logger: Logger): MeshTemplateLoader
    return setmetatable({
        _logger = logger,
        _templates = {},
        _templateScale = {},
        _failed = {},
    }, MeshTemplateLoader)
end

function MeshTemplateLoader._load(self: MeshTemplateLoader, stableId: string): Model?
    local cached = self._templates[stableId]
    if cached ~= nil then
        return cached
    end
    if self._failed[stableId] then
        return nil
    end

    local entry = MeshAssetRegistry.get(stableId)
    if entry == nil then
        self._failed[stableId] = true
        self._logger:info("mesh_asset_unknown", { assetId = stableId })
        return nil
    end

    local ok, loaded = pcall(InsertService.LoadAsset, InsertService, entry.assetId)
    if not ok or not loaded:IsA("Model") then
        if ok then
            loaded:Destroy()
        end
        self._failed[stableId] = true
        self._logger:info("mesh_asset_load_failed", {
            assetId = stableId,
            robloxAssetId = entry.assetId,
            error = if ok then "LoadAsset returned a non-Model" else tostring(loaded),
        })
        return nil
    end

    loaded.Name = "Template_" .. stableId
    local meshPartCount = sanitize(loaded)
    local _, nativeSize = loaded:GetBoundingBox()
    local nativeLongest = longestDimension(nativeSize)
    local normalizationScale = MeshAssetRegistry.scaleFor(stableId, nativeLongest)
    if meshPartCount == 0 or normalizationScale == nil then
        loaded:Destroy()
        self._failed[stableId] = true
        self._logger:info("mesh_asset_invalid", {
            assetId = stableId,
            meshParts = meshPartCount,
            nativeLongestDimension = nativeLongest,
        })
        return nil
    end

    local desiredScale = loaded:GetScale() * normalizationScale
    loaded:ScaleTo(desiredScale)
    local boundsCFrame, boundsSize = loaded:GetBoundingBox()
    loaded.WorldPivot = CFrame.new(boundsCFrame.Position - Vector3.new(0, boundsSize.Y * 0.5, 0))
    loaded:PivotTo(CFrame.new())
    loaded.Parent = nil

    self._templates[stableId] = loaded
    self._templateScale[stableId] = desiredScale
    self._logger:info("mesh_asset_ready", {
        assetId = stableId,
        robloxAssetId = entry.assetId,
        meshParts = meshPartCount,
        nativeLongestDimension = nativeLongest,
        targetLongestDimension = entry.targetLongestDimension,
    })
    return loaded
end

function MeshTemplateLoader.place(
    self: MeshTemplateLoader,
    stableId: string,
    parent: Instance,
    at: CFrame,
    placementScale: number
): Model?
    local template = self:_load(stableId)
    local templateScale = self._templateScale[stableId]
    if template == nil or templateScale == nil or placementScale <= 0 then
        return nil
    end

    local clone = template:Clone()
    clone.Name = "Authored_" .. stableId
    clone:ScaleTo(templateScale * placementScale)
    clone:PivotTo(at)
    clone:SetAttribute("MeshAssetId", stableId)
    clone:SetAttribute("PlacementScale", placementScale)
    clone.Parent = parent
    return clone
end

return table.freeze(MeshTemplateLoader)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">OldGrowthBuilder</string>
            <string name="Source"><![CDATA[--!strict

local OldGrowthBuilder = {}

local function part(
    parent: Model,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?
): Part
    local item = Instance.new("Part")
    item.Name = name
    item.Size = size
    item.CFrame = cframe
    item.Color = color
    item.Material = material
    item.Shape = shape or Enum.PartType.Block
    item.Anchored = true
    item.CanCollide = false
    item.CanTouch = false
    item.CastShadow = true
    item.TopSurface = Enum.SurfaceType.Smooth
    item.BottomSurface = Enum.SurfaceType.Smooth
    item.Parent = parent
    return item
end

function OldGrowthBuilder.build(origin: Vector3, target: Vector3, maxHealth: number): Model
    local model = Instance.new("Model")
    model.Name = "OldGrowthElite"
    model:SetAttribute("EliteId", "elite_old_growth")
    model:SetAttribute("EliteDisplayName", "Old Growth")
    model:SetAttribute("EliteHealth", maxHealth)
    model:SetAttribute("EliteMaxHealth", maxHealth)
    model:SetAttribute("EliteShielded", false)

    local core = part(
        model,
        "AncientTrunk",
        Vector3.new(10, 18, 10),
        CFrame.new(origin + Vector3.new(0, 9, 0)),
        Color3.fromRGB(57, 39, 31),
        Enum.Material.Wood,
        Enum.PartType.Ball
    )
    model.PrimaryPart = core

    part(
        model,
        "BarkCrown",
        Vector3.new(13, 7, 9),
        CFrame.new(origin + Vector3.new(0, 19, 0)),
        Color3.fromRGB(45, 72, 48),
        Enum.Material.Grass,
        Enum.PartType.Ball
    )
    for index = 1, 5 do
        local angle = (index / 5) * math.pi * 2
        part(
            model,
            "CanopyMass",
            Vector3.new(8, 6, 8),
            CFrame.new(
                origin + Vector3.new(math.cos(angle) * 7, 20 + (index % 2) * 3, math.sin(angle) * 7)
            ),
            if index % 2 == 0 then Color3.fromRGB(58, 91, 55) else Color3.fromRGB(38, 68, 48),
            Enum.Material.Grass,
            Enum.PartType.Ball
        )
    end

    for side = -1, 1, 2 do
        part(
            model,
            "CathedralArm",
            Vector3.new(3, 15, 3),
            CFrame.new(origin + Vector3.new(side * 7, 11, 0))
                * CFrame.Angles(0, 0, math.rad(side * 35)),
            Color3.fromRGB(70, 48, 34),
            Enum.Material.Wood,
            nil
        )
        part(
            model,
            "RootFoot",
            Vector3.new(3.2, 3.2, 13),
            CFrame.new(origin + Vector3.new(side * 4.5, 1.4, 3))
                * CFrame.Angles(0, math.rad(side * 18), 0),
            Color3.fromRGB(68, 45, 32),
            Enum.Material.Wood,
            nil
        )
        part(
            model,
            "OldEye",
            Vector3.new(0.9, 0.9, 0.45),
            CFrame.new(origin + Vector3.new(side * 1.7, 11.5, -5)),
            Color3.fromRGB(112, 214, 174),
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
    end

    local heart = part(
        model,
        "AmberHeart",
        Vector3.new(3.8, 5.4, 1.5),
        CFrame.new(origin + Vector3.new(0, 7.5, -5.15)),
        Color3.fromRGB(255, 187, 76),
        Enum.Material.Neon,
        Enum.PartType.Ball
    )
    heart:SetAttribute("WeakPoint", true)

    local highlight = Instance.new("Highlight")
    highlight.Name = "EliteOutline"
    highlight.FillColor = Color3.fromRGB(55, 83, 57)
    highlight.FillTransparency = 0.82
    highlight.OutlineColor = Color3.fromRGB(255, 187, 76)
    highlight.OutlineTransparency = 0.12
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = model

    local flatTarget = Vector3.new(target.X, core.Position.Y, target.Z)
    if (flatTarget - core.Position).Magnitude > 0.01 then
        model:PivotTo(CFrame.lookAt(core.Position, flatTarget))
    end
    return model
end

function OldGrowthBuilder.setState(model: Model, health: number, shielded: boolean, marked: boolean)
    model:SetAttribute("EliteHealth", math.max(0, health))
    model:SetAttribute("EliteShielded", shielded)
    model:SetAttribute("LastLightMarked", marked)
    local heart = model:FindFirstChild("AmberHeart")
    if heart ~= nil and heart:IsA("BasePart") then
        heart.Color = if shielded
            then Color3.fromRGB(92, 118, 91)
            elseif marked then Color3.fromRGB(255, 222, 112)
            else Color3.fromRGB(255, 187, 76)
        heart.Material = if shielded then Enum.Material.SmoothPlastic else Enum.Material.Neon
        heart.Transparency = if shielded then 0.34 else 0
    end
    local highlight = model:FindFirstChild("EliteOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        highlight.OutlineColor = if shielded
            then Color3.fromRGB(112, 155, 119)
            elseif marked then Color3.fromRGB(255, 222, 112)
            else Color3.fromRGB(255, 187, 76)
        highlight.FillTransparency = if marked then 0.62 else 0.82
    end
end

return table.freeze(OldGrowthBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">TerrainBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Sculpted Bramblewake terrain for the arrival valley.

    WHY THIS EXISTS

    The arrival world used to stand on a single 320 x 6 x 340 Part called
    "Ground". A flat rectangle has no horizon, no silhouette, and no sense of
    distance, so a valley that the design documents describe as a fracturing
    wilderness read as a small yard with props on it. No amount of prop detail
    fixes that: the eye reads ground shape and depth layers before it reads
    individual objects.

    Real Terrain fixes four things a Part floor cannot:

      * an actual horizon line, so the world stops ending in mid-air;
      * elevation the camera can look along, which is what produces depth;
      * material blending at the ground plane instead of one flat colour;
      * blended terrain materials instead of one repeated ground texture.

    WHAT IS DELIBERATELY *NOT* SCULPTED

    Every gameplay coordinate in WorldService is a hardcoded Vector3 authored
    against a flat plane at y = 0 -- spawns, interaction prompts, the lantern
    ring, the night defense route, incident sites, enemy spawn points. Sculpting
    under those would drop props into hillsides and leave prompts floating.

    So the playable bowl is filled flat, with its surface exactly at y = 0, and
    all relief happens *outside* it. The valley floor the player walks stays
    byte-for-byte the geometry the systems were authored against; the world
    around it gains hills, ridges, and a far skyline. That split is the whole
    reason this can land without re-authoring 5,000 lines of positions.

    COST

    Terrain is voxel data, not instances, so this adds zero parts to the
    streaming budget. Fills are bulk operations on 4-stud voxels; the whole
    valley is a few hundred FillBlock/FillBall calls rather than a per-voxel
    loop. Generation is deterministic from a fixed seed so two servers build an
    identical valley and a Studio build matches a live one.
]]

local Workspace = game:GetService("Workspace")

local TerrainBuilder = {}

-- The flat region every authored gameplay coordinate lives inside. Relief is
-- only generated outside this rectangle. Widened past the actual play area so
-- the transition to hills never crowds the walkable route.
local BOWL_MIN_X = -190
local BOWL_MAX_X = 190
local BOWL_MIN_Z = -260
local BOWL_MAX_Z = 90

-- Ground surface height. Must stay 0: it is the plane every authored Vector3
-- in WorldService was placed against.
local GROUND_Y = 0

-- How deep the solid ground slab runs. Enough that a Blackout crater or a
-- future dug-out cannot punch through into empty space.
local BEDROCK_DEPTH = 90

-- Outer extent of generated terrain. StreamingTargetRadius is 1024, so terrain
-- past roughly 1200 studs is only ever seen as a horizon silhouette; beyond
-- this the sky takes over.
local WORLD_EXTENT = 1450

local VOXEL = 4

local DEFAULT_SEED = 20260801

-- The Bramblewake expedition is built around x = 1600 (BramblewakeBuilder's
-- ORIGIN) as its own streamed area. No generated terrain may reach past this
-- line, or hills and peaks grow through the expedition modules. The hill grid
-- already stops at WORLD_EXTENT = 1450; this bounds the peak ring too, whose
-- radius would otherwise carry it further out than its centre suggests.
local BRAMBLEWAKE_KEEP_OUT_X = 1400

export type Palette = {
    valley: Enum.Material,
    meadow: Enum.Material,
    slope: Enum.Material,
    ridge: Enum.Material,
    peak: Enum.Material,
    shore: Enum.Material,
}

local DEFAULT_PALETTE: Palette = {
    valley = Enum.Material.Grass,
    meadow = Enum.Material.LeafyGrass,
    slope = Enum.Material.Ground,
    ridge = Enum.Material.Rock,
    peak = Enum.Material.Slate,
    shore = Enum.Material.Sand,
}

-- Rounds a span up to a whole number of voxels. Terrain snaps fills to its own
-- 4-stud grid, and unrounded sizes leave single-voxel seams between adjacent
-- fills that read as cracks in the ground from a low camera.
local function toVoxelSpan(value: number): number
    return math.max(VOXEL, math.ceil(value / VOXEL) * VOXEL)
end

local function isInsideBowl(x: number, z: number, margin: number): boolean
    return x > BOWL_MIN_X - margin
        and x < BOWL_MAX_X + margin
        and z > BOWL_MIN_Z - margin
        and z < BOWL_MAX_Z + margin
end

--[[
    Two-octave value noise in [-1, 1], seeded so every server sculpts the same
    valley.

    math.noise is Perlin and already deterministic for a given input, so the
    seed only has to offset the sample position. Two octaves is enough for a
    natural ridgeline; more detail is invisible once terrain smoothing and
    grass decoration land on top of it.
]]
local function terrainNoise(seed: number, x: number, z: number, scale: number): number
    local base = math.noise(x / scale + seed, z / scale + seed, seed * 0.37)
    local detail = math.noise(x / (scale * 0.42) - seed, z / (scale * 0.42) + seed, seed * 0.11)
    return math.clamp(base + detail * 0.38, -1, 1)
end

--[[
    Fills the flat valley floor that all authored gameplay geometry sits on.

    Filled as one block rather than per-column so the walkable surface is
    guaranteed level -- noise anywhere in here would tilt props and prompts.
]]
local function fillValleyFloor(terrain: Terrain, palette: Palette)
    local width = toVoxelSpan(BOWL_MAX_X - BOWL_MIN_X)
    local depth = toVoxelSpan(BOWL_MAX_Z - BOWL_MIN_Z)
    local centerX = (BOWL_MIN_X + BOWL_MAX_X) / 2
    local centerZ = (BOWL_MIN_Z + BOWL_MAX_Z) / 2

    terrain:FillBlock(
        CFrame.new(centerX, GROUND_Y - BEDROCK_DEPTH / 2, centerZ),
        Vector3.new(width, BEDROCK_DEPTH, depth),
        palette.valley
    )
end

--[[
    Rolling ground outside the bowl, rising with distance so the valley reads as
    sheltered and the skyline closes the world off.

    Columns are sampled on a coarse grid and filled as blocks. A finer grid
    would cost proportionally more fills for detail that terrain smoothing and
    the tree line hide anyway.

    `minRadius`/`maxRadius` select an annulus by distance from the bowl centre,
    which is what lets the near ground be generated before a player can join
    and the horizon be generated after. Splitting by radius rather than by grid
    index guarantees the two passes tile exactly: no cell is filled twice, and
    no cell between them is missed.

    `onProgress` is called once per grid row so a deferred caller can yield.
    Yielding inside the row loop instead of per cell keeps the number of
    scheduler round-trips proportional to the grid edge, not its area.
]]
--[[
    The height of the ground surface at a world position.

    This is the single source of truth for the terrain's shape. Both the fill
    loop and anything placed *on* the terrain must read it, or they disagree:
    foliage was originally planted at a hardcoded y = 0 while the ground
    outside the bowl rose by up to ~90 studs, which buried the mid and far
    tree bands -- the exact depth layers this module exists to create.

    Inside the bowl this is always GROUND_Y, which is the flat-floor guarantee
    every authored gameplay coordinate depends on.
]]
local function surfaceHeightAt(x: number, z: number, seed: number): number
    if isInsideBowl(x, z, 0) then
        return GROUND_Y
    end

    local bowlCenterX = (BOWL_MIN_X + BOWL_MAX_X) / 2
    local bowlCenterZ = (BOWL_MIN_Z + BOWL_MAX_Z) / 2
    local dx = x - bowlCenterX
    local dz = z - bowlCenterZ
    local distance = math.sqrt(dx * dx + dz * dz)

    -- Ramp relief in with distance from the valley so the ground leaves the
    -- flat bowl gradually instead of at a wall.
    local ramp = math.clamp((distance - 230) / 620, 0, 1)
    local rise = terrainNoise(seed, x, z, 320) * 58 + 34
    return GROUND_Y + math.max(0, rise * ramp * ramp)
end

--[[
    Surface height for callers outside this module, using the same seed the
    world was built with. Foliage placement uses this so trunks sit on the
    ground rather than inside it.
]]
function TerrainBuilder.surfaceHeight(x: number, z: number, seed: number?): number
    return surfaceHeightAt(x, z, seed or DEFAULT_SEED)
end

local function fillHillAnnulus(
    terrain: Terrain,
    seed: number,
    palette: Palette,
    minRadius: number,
    maxRadius: number,
    onProgress: (() -> ())?
)
    local step = 24
    local bowlCenterX = (BOWL_MIN_X + BOWL_MAX_X) / 2
    local bowlCenterZ = (BOWL_MIN_Z + BOWL_MAX_Z) / 2

    for x = -WORLD_EXTENT, WORLD_EXTENT, step do
        if onProgress ~= nil then
            onProgress()
        end
        for z = -WORLD_EXTENT, WORLD_EXTENT, step do
            if not isInsideBowl(x, z, 0) then
                local dx = x - bowlCenterX
                local dz = z - bowlCenterZ
                local distance = math.sqrt(dx * dx + dz * dz)

                if distance < minRadius or distance >= maxRadius then
                    continue
                end

                -- Stop the grid short of the Bramblewake expedition. Bounding
                -- only the peak ring was not enough: ExpeditionGenerator's
                -- ROUTES[2] walks to cellX = -2, putting a module centre at
                -- x = 1456 whose 72-stud cell reaches x = 1420, while this
                -- grid fills all the way to WORLD_EXTENT = 1450. That 30-stud
                -- overlap would grow hills through the first modules.
                if x >= BRAMBLEWAKE_KEEP_OUT_X then
                    continue
                end

                -- Same function foliage placement reads, so a tree can never
                -- disagree with the ground it stands on.
                local height = surfaceHeightAt(x, z, seed) - GROUND_Y

                -- Every cell outside the bowl is filled, including the ones
                -- with no relief at all. Skipping flat cells left a void ring
                -- between the bowl's rectangular edge and where the distance
                -- ramp starts producing height -- a cell just past x = 190 is
                -- outside the bowl but still under the 230-stud ramp, so it
                -- got no terrain and no floor. Players walking off the bowl
                -- edge fell through it into fall recovery, and removing the
                -- old DistantCliff ring took away the fence that had been
                -- accidentally hiding the gap.
                local material = palette.slope
                if height > 96 then
                    material = palette.peak
                elseif height > 46 then
                    material = palette.ridge
                elseif height < 1 then
                    -- Flat skirt immediately outside the bowl reads as the
                    -- same meadow, not as a different biome starting at a
                    -- straight line.
                    material = palette.valley
                end

                local columnHeight = toVoxelSpan(height + BEDROCK_DEPTH)
                terrain:FillBlock(
                    CFrame.new(x, GROUND_Y + height - columnHeight / 2, z),
                    Vector3.new(toVoxelSpan(step), columnHeight, toVoxelSpan(step)),
                    material
                )
            end
        end
    end
end

--[[
    Distant peaks that close the horizon.

    Placed as overlapping balls rather than blocks: a ball reads as a rounded
    massif once smoothed, and at this distance silhouette is the only property
    that survives. This is the "distant silhouette" depth layer the art
    direction asks every background to have.
]]
local function fillHorizonPeaks(terrain: Terrain, seed: number, palette: Palette)
    local random = Random.new(seed)
    local peakCount = 26

    for index = 1, peakCount do
        local angle = (index / peakCount) * math.pi * 2 + random:NextNumber(-0.06, 0.06)
        local distance = random:NextNumber(1020, 1330)
        local x = math.cos(angle) * distance
        local z = math.sin(angle) * distance - 70
        local radius = random:NextNumber(110, 210)
        local height = random:NextNumber(150, 320)

        -- The Bramblewake expedition is authored as a separate streamed area
        -- around x = 1600. A peak at distance 1330 with radius 210 reaches
        -- x = 1540, close enough to push a mountain through the first
        -- expedition modules. Skipping peaks that reach into it keeps the two
        -- areas from fighting over the same space.
        if x + radius > BRAMBLEWAKE_KEEP_OUT_X then
            continue
        end

        -- Two stacked balls give a shoulder and a cap, which reads as a
        -- mountain rather than a dome.
        terrain:FillBall(Vector3.new(x, GROUND_Y + height * 0.15, z), radius, palette.ridge)
        terrain:FillBall(Vector3.new(x, GROUND_Y + height * 0.55, z), radius * 0.62, palette.peak)
    end
end

--[[
    A stream running past the east edge of the valley into a pond.

    Water is the cheapest large-scale visual interest terrain offers: it moves,
    it reflects the sky and the lanterns, and it gives the flat bowl a readable
    boundary on one side. Kept outside the bowl so it can never flood a spawn
    or an interaction, and carved before it is filled so the banks read as cut
    earth rather than a puddle sitting on grass.
]]
local function fillStream(terrain: Terrain, palette: Palette)
    local points = {
        Vector3.new(232, GROUND_Y, 60),
        Vector3.new(252, GROUND_Y, -20),
        Vector3.new(268, GROUND_Y, -104),
        Vector3.new(296, GROUND_Y, -186),
        Vector3.new(342, GROUND_Y, -252),
    }

    local channelDepth = 16
    local waterDepth = 8
    local waterSurfaceY = GROUND_Y - 2

    for index = 1, #points - 1 do
        local from = points[index]
        local to = points[index + 1]
        local delta = to - from
        local center = from + delta * 0.5
        local width = toVoxelSpan(28 + math.sin(index * 1.7) * 4)
        local length = toVoxelSpan(delta.Magnitude + width)
        local horizontalTarget = Vector3.new(to.X, GROUND_Y, to.Z)
        local orientation =
            CFrame.lookAt(Vector3.new(center.X, GROUND_Y, center.Z), horizontalTarget)

        -- Repaint two flat bank strips before carving. Their top face remains
        -- exactly at ground level; unlike a sphere, they cannot create dunes.
        for side = -1, 1, 2 do
            terrain:FillBlock(
                orientation * CFrame.new(side * (width * 0.5 + 5), -4, 0),
                Vector3.new(10, 8, length),
                palette.shore
            )
        end

        -- Both channel and water are blocks aligned along the stream segment.
        -- The water top is a single flat plane below the banks. Overlapping
        -- segment ends hide the joints without the above-ground domes produced
        -- by FillBall water.
        terrain:FillBlock(
            orientation * CFrame.new(0, -2, 0),
            Vector3.new(width + 8, channelDepth, length),
            Enum.Material.Air
        )
        terrain:FillBlock(
            orientation * CFrame.new(0, waterSurfaceY - waterDepth * 0.5, 0),
            Vector3.new(width, waterDepth, length),
            Enum.Material.Water
        )
    end

    -- A flat octagonal pond assembled from voxel-aligned rows. Every row shares
    -- the same water height, so the lake reads as a surface instead of a bubble.
    local pondCenter = Vector3.new(362, GROUND_Y, -286)
    local pondWidths = { 64, 96, 112, 120, 112, 96, 64 }
    terrain:FillBlock(
        CFrame.new(pondCenter + Vector3.new(0, -4, 0)),
        Vector3.new(136, 8, 128),
        palette.shore
    )
    for rowIndex, rowWidth in pondWidths do
        local zOffset = (rowIndex - 4) * 16
        terrain:FillBlock(
            CFrame.new(pondCenter + Vector3.new(0, -2, zOffset)),
            Vector3.new(rowWidth + 12, channelDepth, 20),
            Enum.Material.Air
        )
        terrain:FillBlock(
            CFrame.new(pondCenter + Vector3.new(0, waterSurfaceY - waterDepth * 0.5, zOffset)),
            Vector3.new(rowWidth, waterDepth, 20),
            Enum.Material.Water
        )
    end
end

-- How deep a surface material patch reaches. Only needs to cover the topmost
-- voxel layer that is actually visible; deeper is wasted writes.
local SURFACE_PATCH_DEPTH = 8

--[[
    Meadow and worn-earth colour variation across the valley floor.

    Every patch is a block whose TOP FACE sits exactly at GROUND_Y and whose
    body runs downward, and it is only ever yaw-rotated. Both properties are
    load-bearing:

      * The bowl is already solid from GROUND_Y down to bedrock, so a fill
        entirely at or below GROUND_Y replaces the material of existing voxels
        without changing occupancy. The walkable surface stays exactly flat.
      * Yaw keeps the top face horizontal at a fixed height. Pitch or roll
        would tip a corner up through the surface.

    The first version used FillBall centred at GROUND_Y - 0.55 * radius, which
    put the top of every ball 0.45 * radius ABOVE the ground -- up to a 19.8
    stud solid mound, in the middle of the area this module promises is flat,
    potentially burying the spawn and authored props. FillBall adds terrain; it
    does not merely repaint it. A ball cannot repaint a flat surface at all:
    any ball whose top is at or below the surface only touches it at a single
    tangent point, so a block is the right primitive here, not a rounder one.
]]
local function paintValleyVariation(terrain: Terrain, seed: number, palette: Palette)
    local random = Random.new(seed + 991)

    for _ = 1, 46 do
        local x = random:NextNumber(BOWL_MIN_X + 20, BOWL_MAX_X - 20)
        local z = random:NextNumber(BOWL_MIN_Z + 20, BOWL_MAX_Z - 20)
        local width = toVoxelSpan(random:NextNumber(26, 78))
        local depth = toVoxelSpan(random:NextNumber(26, 78))
        local material = if random:NextNumber() < 0.62 then palette.meadow else palette.slope

        terrain:FillBlock(
            CFrame.new(x, GROUND_Y - SURFACE_PATCH_DEPTH / 2, z)
                * CFrame.Angles(0, random:NextNumber(0, math.pi), 0),
            Vector3.new(width, SURFACE_PATCH_DEPTH, depth),
            material
        )
    end
end

--[[
    Where the join-blocking core pass stops and the deferred pass begins.

    Everything a player can reach, fall off, or see close up in their first
    moments is inside this radius; past it the ground is scenery. Comfortably
    beyond the 620-stud tree line so the transition is never the first thing
    in view.
]]
local CORE_RADIUS = 760

local function applyWaterStyle(terrain: Terrain)
    terrain.WaterColor = Color3.fromRGB(44, 92, 104)
    terrain.WaterReflectance = 0.28
    terrain.WaterTransparency = 0.62
    terrain.WaterWaveSize = 0.08
    terrain.WaterWaveSpeed = 8
end

--[[
    Sculpts everything a joining player needs: the flat valley floor, the
    ground immediately around it, the stream, and surface variation.

    This runs before the spawn exists and before the world is marked ready, so
    it is deliberately the smaller half of the work. Config.BootstrapTimeoutSeconds
    is 8, and AGENTS.md is explicit that joining must never block on the whole
    world loading -- the first version generated the entire 121 x 121 hill grid
    and the horizon here, which is optional scenery no one can reach.

    Safe to call more than once: every fill is deterministic for a given seed,
    so re-running writes identical voxels.
]]
function TerrainBuilder.buildCore(seed: number?, palette: Palette?)
    local terrain = Workspace.Terrain
    local resolvedSeed = seed or DEFAULT_SEED
    local resolvedPalette = palette or DEFAULT_PALETTE

    fillValleyFloor(terrain, resolvedPalette)
    fillHillAnnulus(terrain, resolvedSeed, resolvedPalette, 0, CORE_RADIUS, nil)
    fillStream(terrain, resolvedPalette)
    paintValleyVariation(terrain, resolvedSeed, resolvedPalette)
    applyWaterStyle(terrain)
end

--[[
    Sculpts the horizon: the far hills and the peak ring.

    Meant to be called after the world is marked ready. `onProgress` fires once
    per grid row so the caller can yield between rows and keep the server
    responsive while this fills in behind the tree line.

    Everything here is past CORE_RADIUS, so it can only ever add scenery a
    player is looking at from a distance -- never ground they are standing on.
]]
function TerrainBuilder.buildDistant(seed: number?, palette: Palette?, onProgress: (() -> ())?)
    local terrain = Workspace.Terrain
    local resolvedSeed = seed or DEFAULT_SEED
    local resolvedPalette = palette or DEFAULT_PALETTE

    fillHillAnnulus(terrain, resolvedSeed, resolvedPalette, CORE_RADIUS, math.huge, onProgress)
    fillHorizonPeaks(terrain, resolvedSeed, resolvedPalette)
end

-- Exposed so world code and tests can reason about the flat region without
-- duplicating the numbers.
function TerrainBuilder.bowlBounds(): (number, number, number, number)
    return BOWL_MIN_X, BOWL_MAX_X, BOWL_MIN_Z, BOWL_MAX_Z
end

function TerrainBuilder.isInsidePlayableBowl(x: number, z: number): boolean
    return isInsideBowl(x, z, 0)
end

function TerrainBuilder.groundHeight(): number
    return GROUND_Y
end

return table.freeze(TerrainBuilder)
]]></string>
          </Properties>
