        blackout = string.sub(blackoutId, 1, 48),
        duration = duration,
        hash = manifestHash,
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "BramblewakeBlackoutStarted", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = blackoutId,
            })
        end)
    end
end

function AnalyticsService.blackoutStage(
    self: AnalyticsService,
    player: Player,
    blackoutId: string,
    stage: string,
    reason: string,
    revision: number
)
    self._logger:info("blackout_stage", {
        blackout = string.sub(blackoutId, 1, 48),
        player = player.UserId,
        reason = string.sub(reason, 1, 48),
        revision = revision,
        stage = string.sub(stage, 1, 32),
    })
end

function AnalyticsService.blackoutResult(
    self: AnalyticsService,
    player: Player,
    blackoutId: string,
    manifestHash: string,
    decision: string?,
    wardenOutcome: string?,
    startedAt: number?,
    completedAt: number
)
    local duration = if startedAt == nil then 0 else math.max(0, completedAt - startedAt)
    self._logger:info("blackout_result", {
        blackout = string.sub(blackoutId, 1, 48),
        decision = string.sub(decision or "unknown", 1, 32),
        duration = math.floor(duration + 0.5),
        hash = manifestHash,
        outcome = string.sub(wardenOutcome or "unknown", 1, 32),
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(
                player,
                "BramblewakeBlackoutCompleted",
                math.max(1, math.floor(duration + 0.5)),
                {
                    [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = decision or "unknown",
                    [Enum.AnalyticsCustomFieldKeys.CustomField02.Name] = wardenOutcome or "unknown",
                }
            )
        end)
    end
end

function AnalyticsService.chapterCompleted(
    self: AnalyticsService,
    player: Player,
    chapter: number,
    decision: string,
    wardenOutcome: string,
    transactionId: string
)
    self._logger:info("chapter_completed", {
        chapter = chapter,
        decision = string.sub(decision, 1, 32),
        outcome = string.sub(wardenOutcome, 1, 32),
        player = player.UserId,
        transaction = string.sub(transactionId, 1, 160),
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "ChapterCompleted", chapter, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = decision,
                [Enum.AnalyticsCustomFieldKeys.CustomField02.Name] = wardenOutcome,
            })
        end)
    end
end

function AnalyticsService.clear(self: AnalyticsService, player: Player)
    self._startedAt[player] = nil
    self._expeditionStarted[player] = nil
end

return table.freeze(AnalyticsService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">BramblewakeBlackoutService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local BramblewakeBlackoutService = {}
BramblewakeBlackoutService.__index = BramblewakeBlackoutService
BramblewakeBlackoutService.Name = "BramblewakeBlackoutService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type BramblewakeBlackoutService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _worldService: any,
        _expeditionService: any,
        _profileService: any,
        _survivalService: any,
        _oldGrowthService: any,
        _wardenStagService: any,
        _flow: any,
        _analyticsService: any,
        _featureFlags: any,
        _state: any,
        _arena: any,
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
        _lastPublishedSecond: number,
        _persistedUsers: { [number]: boolean },
    },
    BramblewakeBlackoutService
))

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

function BramblewakeBlackoutService.new(
    logger: Logger,
    config: any,
    worldService: any,
    expeditionService: any,
    profileService: any,
    survivalService: any,
    oldGrowthService: any,
    wardenStagService: any,
    flow: any,
    analyticsService: any,
    featureFlags: any
): BramblewakeBlackoutService
    return setmetatable({
        Name = BramblewakeBlackoutService.Name,
        _logger = logger,
        _config = config,
        _worldService = worldService,
        _expeditionService = expeditionService,
        _profileService = profileService,
        _survivalService = survivalService,
        _oldGrowthService = oldGrowthService,
        _wardenStagService = wardenStagService,
        _flow = flow,
        _analyticsService = analyticsService,
        _featureFlags = featureFlags,
        _state = nil,
        _arena = nil,
        _onChanged = nil,
        _heartbeat = nil,
        _lastPublishedSecond = -1,
        _persistedUsers = {},
    }, BramblewakeBlackoutService)
end

function BramblewakeBlackoutService.Init(self: BramblewakeBlackoutService, _context: any)
    local manifest = assert(self._expeditionService:manifest(), "expedition manifest unavailable")
    self._arena = assert(self._worldService:blackoutArena(), "Blackout arena unavailable")
    self._state = self._flow.create(
        self._expeditionService:runId(),
        manifest.hash,
        self._featureFlags:isEnabled("bramblewake_blackout_enabled"),
        self._config.BlackoutNightSeconds
    )
    self._worldService:setBlackoutPresentation(self._state)
end

function BramblewakeBlackoutService.Start(self: BramblewakeBlackoutService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.1 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
    self._logger:info("bramblewake_blackout_ready", {
        duration = self._config.BlackoutNightSeconds,
        enabled = self._state.status ~= "disabled",
        interval = self._config.BlackoutInterval,
        manifest = self._state.manifestHash,
    })
end

function BramblewakeBlackoutService.setChangedHandler(
    self: BramblewakeBlackoutService,
    callback: (string?) -> ()
)
    self._onChanged = callback
end

function BramblewakeBlackoutService._notify(self: BramblewakeBlackoutService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function BramblewakeBlackoutService._syncCarrierVisuals(
    self: BramblewakeBlackoutService,
    now: number
)
    for _, player in Players:GetPlayers() do
        local snapshot = self._flow.snapshot(self._state, player.UserId, now)
        player:SetAttribute("LastLightCarryingBlackoutFire", snapshot.carryingFire)
        player:SetAttribute("LastLightBlackoutFireExpiresAt", snapshot.fireExpiresAt)
        local root = rootPart(player)
        if root ~= nil then
            local light = root:FindFirstChild("BlackoutCarryLight")
            if snapshot.carryingFire and light == nil then
                local pointLight = Instance.new("PointLight")
                pointLight.Name = "BlackoutCarryLight"
                pointLight.Color = Color3.fromRGB(255, 146, 78)
                pointLight.Brightness = 2.4
                pointLight.Range = 20
                pointLight.Shadows = false
                pointLight.Parent = root
            elseif not snapshot.carryingFire and light ~= nil then
                light:Destroy()
            end
        end
    end
end

function BramblewakeBlackoutService._activeParticipantIds(
    self: BramblewakeBlackoutService
): { number }
    local result = {}
    for _, player in Players:GetPlayers() do
        if
            player:GetAttribute("LastLightInExpedition") == true
            and self._state.participants[tostring(player.UserId)] == true
        then
            table.insert(result, player.UserId)
        end
    end
    table.sort(result)
    return result
end

function BramblewakeBlackoutService._persistResolution(self: BramblewakeBlackoutService)
    if
        self._state.status ~= "complete"
        or self._state.decision == nil
        or self._state.wardenOutcome == nil
    then
        return
    end
    for _, player in Players:GetPlayers() do
        if
            self._state.participants[tostring(player.UserId)] == true
            and self._persistedUsers[player.UserId] ~= true
        then
            local transactionId = self._flow.chapterTransactionId(self._state, player.UserId)
            local result = self._profileService:completeChapterOne(
                player,
                transactionId,
                self._state.decision,
                self._state.wardenOutcome
            )
            if result.accepted and result.applied then
                self._analyticsService:chapterCompleted(
                    player,
                    1,
                    self._state.decision,
                    self._state.wardenOutcome,
                    transactionId
                )
                if result.durable then
                    self._persistedUsers[player.UserId] = true
                end
            elseif
                (result.accepted and result.durable)
                or (not result.accepted and result.reason == "chapter_already_resolved")
            then
                self._persistedUsers[player.UserId] = true
            elseif not result.accepted and result.reason ~= "profile_loading" then
                self._logger:warn("chapter_one_resolution_rejected", {
                    player = player.UserId,
                    reason = result.reason,
                    transaction = transactionId,
                })
            end
        end
    end
end

function BramblewakeBlackoutService._transition(
    self: BramblewakeBlackoutService,
    nextState: any,
    player: Player?,
    stageReason: string,
    toast: string
)
    self._state = nextState
    self._worldService:setBlackoutPresentation(self._state)
    if player ~= nil then
        self._analyticsService:blackoutStage(
            player,
            self._flow.Id,
            self._state.status,
            stageReason,
            self._state.revision
        )
    end
    self:_notify(toast)
end

function BramblewakeBlackoutService._representativePlayer(self: BramblewakeBlackoutService): Player?
    for _, player in Players:GetPlayers() do
        if self._state.participants[tostring(player.UserId)] == true then
            return player
        end
    end
    return nil
end

function BramblewakeBlackoutService._step(self: BramblewakeBlackoutService, now: number)
    if self._state.status == "old_growth" and self._oldGrowthService:isComplete() then
        local nextState, result = self._flow.completeOldGrowth(self._state)
        if result.accepted then
            self:_transition(
                nextState,
                self:_representativePlayer(),
                "old_growth_complete",
                "OLD GROWTH RELEASES THE WARDEN'S SEAL"
            )
        end
    elseif self._state.status == "warden" and self._wardenStagService:isComplete() then
        local outcome = self._wardenStagService:outcome()
        if outcome ~= nil then
            local nextState, result = self._flow.completeWarden(self._state, outcome)
            if result.accepted then
                self:_transition(
                    nextState,
                    self:_representativePlayer(),
                    "warden_complete",
                    "THE GREENWARD AWAITS YOUR VOTE"
                )
            end
        end
    elseif self._state.status == "resolution" then
        local eligibleUserIds = self:_activeParticipantIds()
        local nextState, result = self._flow.reconcileVote(self._state, eligibleUserIds)
        if result.resolved then
            self._state = nextState
            self._worldService:setBlackoutPresentation(self._state)
            self._worldService:setBlackoutLighting(false)
            self:_persistResolution()
            local player = Players:GetPlayerByUserId(eligibleUserIds[1])
            if player ~= nil then
                self._analyticsService:blackoutResult(
                    player,
                    self._flow.Id,
                    self._state.manifestHash,
                    self._state.decision,
                    self._state.wardenOutcome,
                    self._state.startedAt,
                    now
                )
            end
            self:_notify(
                "CHAPTER I RESOLVED — " .. string.upper(self._state.decision:gsub("_", " "))
            )
        end
    elseif self._state.status == "complete" then
        self:_persistResolution()
    end

    self:_syncCarrierVisuals(now)
    if self._state.status ~= "dormant" and self._state.status ~= "disabled" then
        local second = math.floor(now)
        if second ~= self._lastPublishedSecond then
            self._lastPublishedSecond = second
            self:_notify(nil)
        end
    end
end

function BramblewakeBlackoutService.participantEntered(
    self: BramblewakeBlackoutService,
    player: Player
): any
    local story = self._profileService:chapterOneSnapshot(player)
    if self._state.status == "disabled" then
        return {
            accepted = false,
            message = "BLACKOUT PREVIEW DISABLED — BRAMBLEWAKE REMAINS OPEN",
            reason = "disabled",
        }
    end
    if not self._oldGrowthService:enabled() or not self._wardenStagService:enabled() then
        return {
            accepted = false,
            message = "BLACKOUT ENCOUNTERS ARE TEMPORARILY UNAVAILABLE",
            reason = "dependency_disabled",
        }
    end
    if self._state.status == "dormant" then
        if story ~= nil and story.status == "complete" then
            return {
                accepted = true,
                message = "CHAPTER I ALREADY RESOLVED — EXPEDITION OPEN",
                reason = "chapter_complete",
            }
        end
        local nextState, result =
            self._flow.start(self._state, player.UserId, workspace:GetServerTimeNow())
        if result.accepted then
            self._state = nextState
            self._worldService:setBlackoutLighting(true)
            self._worldService:setBlackoutPresentation(self._state)
            self._analyticsService:blackoutStarted(
                player,
                self._flow.Id,
                self._state.manifestHash,
                self._state.duration
            )
            self:_notify("BLACKOUT — CARRY ROOTFIRE BETWEEN LIVING ROOTS")
            return {
                accepted = true,
                message = "BLACKOUT — ROOTFIRE RELAY ACTIVE",
                reason = "started",
            }
        end
    elseif
        self._state.status == "relay"
        or self._state.status == "old_growth"
        or self._state.status == "warden"
        or self._state.status == "resolution"
    then
        self._state = self._flow.join(self._state, player.UserId)
        self._worldService:setBlackoutPresentation(self._state)
        self:_notify(nil)
        return {
            accepted = true,
            message = "JOINED THE ACTIVE BRAMBLEWAKE BLACKOUT",
            reason = "joined",
        }
    elseif self._state.status == "complete" then
        return {
            accepted = true,
            message = "BLACKOUT COMPLETE — CHAPTER RESULT RECORDED",
            reason = "complete",
        }
    end
    return {
        accepted = false,
        message = "BLACKOUT COULD NOT START",
        reason = self._state.status,
    }
end

function BramblewakeBlackoutService.interact(
    self: BramblewakeBlackoutService,
    player: Player,
    prompt: ProximityPrompt
): any
    if
        player:GetAttribute("LastLightInExpedition") ~= true
        or not self._survivalService:canAct(player)
    then
        return {
            accepted = false,
            message = "ENTER BRAMBLEWAKE WHILE ACTIVE",
            reason = "player_unavailable",
        }
    end
    local target = prompt.Parent
    local interaction = if target == nil then nil else target:GetAttribute("BlackoutInteraction")
    local nextState, result
    local now = workspace:GetServerTimeNow()
    if interaction == "take_fire" then
        nextState, result = self._flow.takeFire(self._state, player.UserId, now)
    elseif interaction == "deliver_fire" then
        local nodeId = tostring(target:GetAttribute("BlackoutNodeId"))
        if self._state.deliveredNodes[nodeId] == true then
            nextState, result = self._flow.takeFire(self._state, player.UserId, now)
        else
            nextState, result = self._flow.deliverFire(self._state, player.UserId, nodeId, now)
        end
    elseif interaction == "chapter_decision" then
        nextState, result = self._flow.vote(
            self._state,
            player.UserId,
            tostring(target:GetAttribute("BlackoutDecisionId")),
            self:_activeParticipantIds()
        )
    else
        return {
            accepted = false,
            message = "INVALID BLACKOUT INTERACTION",
            reason = "invalid_interaction",
        }
    end
    if not result.accepted then
        result.message = if result.reason == "fire_required"
                or result.reason == "fire_expired"
            then "TAKE FRESH ROOTFIRE FROM THE BLACKOUT LANTERN"
            elseif result.reason == "already_delivered" then "THAT LIVING ROOT ALREADY HOLDS FIRE"
            elseif
                self._state.status == "resolution"
            then "ONLY ACTIVE BLACKOUT PARTICIPANTS CAN VOTE"
            else "THAT BLACKOUT STEP IS NOT ACTIVE"
        return result
    end

    self._state = nextState
    self._worldService:setBlackoutPresentation(self._state)
    self:_syncCarrierVisuals(now)
    if result.reason == "fire_taken" then
        result.message = string.format(
            "ROOTFIRE TAKEN — DELIVER WITHIN %d SECONDS",
            self._flow.FireCarrySeconds
        )
    elseif result.reason == "fire_delivered" then
        result.message =
            string.format("LIVING ROOT LIT — %d / %d", result.delivered, result.required)
    elseif result.reason == "relay_complete" then
        result.message = "ROOTFIRE RELAY COMPLETE — OLD GROWTH AWAKENS"
        self._analyticsService:blackoutStage(
            player,
            self._flow.Id,
            self._state.status,
            "relay_complete",
            self._state.revision
        )
    elseif result.reason == "vote_recorded" then
        result.message = "GREENWARD VOTE RECORDED — WAITING FOR ACTIVE TRAVELERS"
    elseif result.reason == "resolved" then
        result.message = "CHAPTER I RESOLVED — "
            .. string.upper(self._state.decision:gsub("_", " "))
        self._worldService:setBlackoutLighting(false)
        self:_persistResolution()
        self._analyticsService:blackoutResult(
            player,
            self._flow.Id,
            self._state.manifestHash,
            self._state.decision,
            self._state.wardenOutcome,
            self._state.startedAt,
            now
        )
    else
        result.message = "BLACKOUT UPDATED"
    end
    self:_notify(result.message)
    return result
end

function BramblewakeBlackoutService.allowsOldGrowth(self: BramblewakeBlackoutService): boolean
    return self._state.status == "old_growth"
end

function BramblewakeBlackoutService.allowsWarden(self: BramblewakeBlackoutService): boolean
    return self._state.status == "warden"
        or self._state.status == "resolution"
        or self._state.status == "complete"
end

function BramblewakeBlackoutService.snapshot(self: BramblewakeBlackoutService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return nil
    end
    local snapshot = self._flow.snapshot(self._state, player.UserId, workspace:GetServerTimeNow())
    snapshot.story = self._profileService:chapterOneSnapshot(player)
    return snapshot
end

return table.freeze(BramblewakeBlackoutService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">CommerceService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    The only module in this game that touches a purchase or ownership API.

    `scripts/validate_monetization.py` allows exactly one, by name, and its
    docstring says why the list is meant to stay short and to be read: a branch
    on "does this player own X" is how a cosmetic quietly becomes a
    requirement. So the shape of this file is the whole architecture:

      * **It answers one question and writes down the answer.** What a player
        owns is resolved here, once, and lands in `profile.commerce` as plain
        data. Nothing downstream asks the platform anything, and nothing
        downstream asks *this* anything either -- gameplay branches on what is
        equipped, which is a profile field like every other.
      * **The refusal to wear something unowned lives here**, not where
        cosmetics are drawn. The drawing code takes an id and draws it. That
        keeps the ownership question in one file and out of the HUD, the gear
        visuals, and everything else.
      * **Every decision it makes is somewhere else.** `Entitlements.route` is
        pure and holds the branch a receipt takes; this is the shell that gives
        it a profile, a mailbox and a durable write. `ProcessReceipt` cannot be
        exercised in Studio -- the round trip needs a real purchase on a real
        account -- so anything that decides has to be decidable without it.

    **A receipt is acknowledged only after a durable write**, and that is the
    rule everything else here bends around. Roblox retries until it is told the
    grant is durable, so telling it early loses a purchase and telling it late
    costs nothing but a retry. Two things count as durable: the buyer's profile
    saved, or -- when this server does not hold that profile -- the mailbox
    saved. A mailbox entry is a promise the next load will keep, and it is
    stored outside the profile precisely because its reason for existing is the
    moments when the profile is not ours to write.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CommerceService = {}
CommerceService.__index = CommerceService
CommerceService.Name = "CommerceService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type CommerceService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _catalog: any,
        _entitlements: any,
        _storeCard: any,
        _profileService: any,
        _featureFlags: any,
        _analyticsService: any,
        _persistent: boolean,
        _mailboxStore: any,
        --[[
            Mailboxes for servers with no DataStore -- Studio, and any
            environment running without persistence. In memory, which is the
            same honest limitation the profile store has there: nothing
            survives the session, and nothing pretends to.
        ]]
        _localMailboxes: { [number]: { any } },
        _productInfo: { [string]: any },
        --[[
            When a product info lookup last failed, so a delisted or erroring
            product is not re-asked on every snapshot build. `storeSnapshot`
            runs on every push for every player and `GetProductInfo` is a
            throttled web call: retrying it there turns one broken product into
            a rate limit for all of them.
        ]]
        _productInfoFailedAt: { [string]: number },
        --[[
            Purchases already counted as lost, so one stuck receipt is one
            event rather than one per redelivery. The platform retries an
            unconsumed receipt for the life of the purchase, and a
            zero-tolerance gate that reads a count would grow without a second
            player being affected. Bounded in practice by how many purchases
            can go wrong on one server, which is the number the gate is asking
            about anyway.
        ]]
        _reportedLoss: { [string]: boolean },
        _onGranted: ((Player, { string }) -> ())?,
    },
    CommerceService
))

local MAILBOX_STORE = "LastLightCommerceMailbox_v1"
local PRODUCT_INFO_RETRY_SECONDS = 60

function CommerceService.new(
    logger: Logger,
    config: any,
    cosmeticCatalog: any,
    entitlements: any,
    storeCard: any,
    profileService: any,
    featureFlags: any,
    analyticsService: any
): CommerceService
    return setmetatable({
        Name = CommerceService.Name,
        _logger = logger,
        _config = config,
        _catalog = cosmeticCatalog,
        _entitlements = entitlements,
        _storeCard = storeCard,
        _profileService = profileService,
        _featureFlags = featureFlags,
        _analyticsService = analyticsService,
        _persistent = false,
        _mailboxStore = nil,
        _localMailboxes = {},
        _productInfo = {},
        _productInfoFailedAt = {},
        _reportedLoss = {},
        _onGranted = nil,
    }, CommerceService)
end

function CommerceService.Init(self: CommerceService, context: any)
    local environmentConfig = context.config.Environments[context.environment]
    self._persistent = environmentConfig ~= nil and environmentConfig.UsePersistentData == true
    if self._persistent then
        local DataStoreService = game:GetService("DataStoreService")
        local ok, store = pcall(function()
            return DataStoreService:GetDataStore(MAILBOX_STORE)
        end)
        if ok then
            self._mailboxStore = store
        else
            self._logger:warn("commerce_mailbox_unavailable", { reason = tostring(store) })
        end
    end
end

function CommerceService.setGrantHandler(self: CommerceService, handler: (Player, { string }) -> ())
    self._onGranted = handler
end

local function mailboxKey(userId: number): string
    return string.format("mailbox_%d", userId)
end

function CommerceService._readMailbox(self: CommerceService, userId: number): { any }
    if not self._persistent or self._mailboxStore == nil then
        return self._entitlements.normalizeMailbox(self._localMailboxes[userId])
    end
    local ok, value = pcall(function()
        return self._mailboxStore:GetAsync(mailboxKey(userId))
    end)
    if not ok then
        self._logger:warn("commerce_mailbox_read_failed", { user = userId })
        return self._entitlements.emptyMailbox()
    end
    return self._entitlements.normalizeMailbox(value)
end

--[[
    Write a mailbox and say whether it landed.

    The boolean is load-bearing: it is the difference between telling the
    platform the purchase is safe and telling it to call again. A failed write
    must never read as success.
]]
function CommerceService._writeMailbox(
    self: CommerceService,
    userId: number,
    mailbox: { any }
): boolean
    if not self._persistent or self._mailboxStore == nil then
        self._localMailboxes[userId] = mailbox
        return true
    end
    local ok, err = pcall(function()
        self._mailboxStore:SetAsync(mailboxKey(userId), mailbox)
    end)
    if not ok then
        self._logger:warn(
            "commerce_mailbox_write_failed",
            { reason = tostring(err), user = userId }
        )
    end
    return ok
end

--[[
    The buyer's commerce state, if this server holds their profile and may
    write it. Nil is a real answer and means "not ours": they are in another
    server, or mid-load, or their profile is read-only because a lock could not
    be taken. Writing anyway is how two servers overwrite one save.
]]
function CommerceService._writableState(self: CommerceService, userId: number): (Player?, any)
    local player = Players:GetPlayerByUserId(userId)
    if player == nil then
        return nil, nil
    end
    if not self._profileService:isLoaded(player) or not self._profileService:isWritable(player) then
        return player, nil
    end
    return player, self._profileService:commerce(player)
end

--[[
    Apply one receipt. The single grant authority in the game.
]]
function CommerceService.applyReceipt(self: CommerceService, receipt: any): boolean
    local userId = tonumber(receipt.userId) or 0
    local player, state = self:_writableState(userId)
    local mailbox = self:_readMailbox(userId)
    -- Measured from when the platform handed the receipt over, not from now.
    -- The gate asks how long a purchase took to become durable, and the wait
    -- in a mailbox while the buyer was in another server is the part of that
    -- wait a player would actually recognise.
    local elapsed = math.max(0, os.time() - (tonumber(receipt.at) or os.time()))

    --[[
        A receipt for something this build cannot resolve.

        Never consumed, correctly -- a later build may know the product, and
        telling the platform a purchase is settled when nothing was granted is
        the one mistake that cannot be undone. But an unconsumed receipt is
        also a player who has paid and holds nothing, retried forever, and
        that is the zero-tolerance case rather than the healthy retry that
        `receipt_result` counts.
    ]]
    -- GATE-METRIC: purchase_loss
    local purchaseKey = tostring(receipt.purchaseId)
    if
        (type(receipt.productId) ~= "string" or #self._catalog.grantsOf(receipt.productId) == 0)
        and not self._reportedLoss[purchaseKey]
    then
        self._reportedLoss[purchaseKey] = true
        self._analyticsService:purchaseLoss(
            userId,
            tostring(receipt.productId),
            "unresolvable_product"
        )
    end
    local nextState, nextMailbox, verdict = self._entitlements.route(
        state,
        mailbox,
        receipt,
        function(productId: string): { string }
            return self._catalog.grantsOf(productId)
        end
    )

    if verdict == "granted" and player ~= nil and nextState ~= nil then
        self._profileService:setCommerce(player, nextState)
        -- The write, then the answer. Reversing these is the one ordering
        -- mistake that costs a player a purchase they paid for.
        if not self._profileService:save(player) then
            self._logger:warn("commerce_grant_write_failed", { user = userId })
            -- The entitlement was decided and could not be made durable. The
            -- platform will call again, but until one of those calls lands
            -- this is a completed receipt with no grant behind it.
            -- Counted once per purchase for the same reason as above: the
            -- retry is the system working, and a gate that counts retries
            -- reads one stuck receipt as a growing incident.
            if not self._reportedLoss[purchaseKey] then
                self._reportedLoss[purchaseKey] = true
                self._analyticsService:purchaseLoss(
                    userId,
                    tostring(receipt.productId),
                    "grant_write_failed"
                )
            end
            return false
        end
        local granted = self._catalog.grantsOf(receipt.productId)
        self._logger:info("commerce_receipt_granted", {
            product = tostring(receipt.productId),
            purchase = tostring(receipt.purchaseId),
            user = userId,
        })
        -- GATE-METRIC: receipt_result
        -- COMMERCE-EVENT: receipt_result
        self._analyticsService:receiptResult(
            userId,
            tostring(receipt.productId),
            "granted",
            elapsed,
            player
        )
        local handler = self._onGranted
        if handler ~= nil then
            handler(player, granted)
        end
        return true
    end

    if verdict == "held" then
        if not self:_writeMailbox(userId, nextMailbox) then
            return false
        end
        self._logger:info("commerce_receipt_held", {
            product = tostring(receipt.productId),
            purchase = tostring(receipt.purchaseId),
            user = userId,
        })
        -- A held receipt is durable -- the mailbox saved, which is what this
        -- branch just proved -- so it settles the commerce gate exactly as a
        -- grant does. Leaving it out would make "100% of completed receipts
        -- reach a durable grant" unreadable for every purchase made while its
        -- buyer was in another server, which is the case the mailbox exists
        -- for and therefore the case the gate most needs to see.
        self._analyticsService:receiptResult(
            userId,
            tostring(receipt.productId),
            "held",
            elapsed,
            player
        )
        return true
    end

    self._logger:warn("commerce_receipt_retry", {
        product = tostring(receipt.productId),
        purchase = tostring(receipt.purchaseId),
        user = userId,
    })
    self._analyticsService:receiptResult(
        userId,
        tostring(receipt.productId),
        "retry",
        elapsed,
        player
    )
    return false
end

--[[
    Drain whatever was banked while this player was elsewhere.

    Run at profile load. A receipt this build still cannot resolve stays in the
    mailbox rather than being dropped, because the product may exist in the
    next build and a purchase quietly discarded is a support ticket nobody can
    answer.
]]
function CommerceService.drainFor(self: CommerceService, player: Player)
    local mailbox = self:_readMailbox(player.UserId)
    if #mailbox == 0 then
        return
    end
    if not self._profileService:isWritable(player) then
        return
    end
    local state, remaining, granted = self._entitlements.drain(
        self._profileService:commerce(player),
        mailbox,
        function(productId: string): { string }
            return self._catalog.grantsOf(productId)
        end
    )
    if #granted == 0 then
        return
    end
    self._profileService:setCommerce(player, state)
    if not self._profileService:save(player) then
        -- The mailbox is left exactly as it was. Clearing it before the
        -- profile is safe is the one way a drained purchase disappears.
        self._logger:warn("commerce_drain_write_failed", { user = player.UserId })
        return
    end
    self:_writeMailbox(player.UserId, remaining)
    self._logger:info("commerce_mailbox_drained", {
        granted = #granted,
        remaining = #remaining,
        user = player.UserId,
    })
    local handler = self._onGranted
    if handler ~= nil then
        handler(player, granted)
    end
end

--[[
    Wear one. The single place ownership is asked about outside a receipt, and
    therefore the reason no gameplay module ever has to.
]]
function CommerceService.equip(
    self: CommerceService,
    player: Player,
    slot: any,
    cosmeticId: any
): any
    if not self._profileService:isLoaded(player) then
        return { applied = false, reason = "profile_loading" }
    end
    local state, result = self._entitlements.equip(
        self._profileService:commerce(player),
        slot,
        cosmeticId,
        function(id: string): string?
            local cosmetic = self._catalog.get(id)
            return if cosmetic == nil then nil else cosmetic.slot
        end
    )
    if result.applied then
        self._profileService:setCommerce(player, state)
        if cosmeticId ~= nil then
            -- COMMERCE-EVENT: cosmetic_equipped
            self._analyticsService:cosmeticEquipped(player, tostring(cosmeticId), tostring(slot))
        end
    end
    return result
end

--[[
    Wear one, named only by the cosmetic.

    The slot comes from the catalog rather than from the caller, which is the
    only version of it worth trusting: a client that could name a slot could
    name the wrong one, and #331's review found exactly that hole on the layer
    below. Pressing something already worn takes it off, so removal needs no
    second field and no second action -- the toggle is what keeps the payload
    at one id.
]]
function CommerceService.equipById(self: CommerceService, player: Player, cosmeticId: any): any
    if not self._profileService:isLoaded(player) then
        return { applied = false, reason = "profile_loading" }
    end
    local cosmetic = self._catalog.get(cosmeticId)
    if cosmetic == nil then
        return { applied = false, reason = "unknown_cosmetic" }
    end
    local state = self._profileService:commerce(player)
    if self._entitlements.equippedIn(state, cosmetic.slot) == cosmetic.id then
        return self:equip(player, cosmetic.slot, nil)
    end
    return self:equip(player, cosmetic.slot, cosmetic.id)
end

--[[
    One card looked at. Nothing is decided here and nothing is returned,
    because a detail view changes nothing -- it is a fact the monetization
    taxonomy asks for by name, and an event with no emitter is a dashboard
    reading nothing.
]]
function CommerceService.viewDetail(self: CommerceService, player: Player, productId: any): boolean
    local product = self._catalog.product(productId)
    if product == nil then
        return false
    end
    -- COMMERCE-EVENT: product_detail_view
    self._analyticsService:productDetailView(player, product.id)
    return true
end

--[[
    The shelf and the wardrobe, built for one player.

    Two lists rather than one, and the reason is the failure this project has
    now paid for four times. A sale card needs a price and a product; a thing
    already owned needs neither. If owned cosmetics were shown only through
    their sale cards, a product delisted in the dashboard -- or a
    `GetProductInfo` call that simply failed -- would make a paid-for coat
    unwearable, which is an entitlement that exists and a cosmetic that cannot
    be worn.

    Every card is built by the shared builder, which refuses to make one
    without a price, a permanence, an owned state and real geometry. A product
    with no dashboard id yields no card at all rather than a card with a blank
    where the price goes.
]]
function CommerceService.storeSnapshot(self: CommerceService, player: Player): any
    if not self._profileService:isLoaded(player) then
        return nil
    end
    local state = self._profileService:commerce(player)
    local cards = {}
    local unpriced = 0
    for _, product in self._catalog.products() do
        local granted = product.grants
        local preview = {}
        local owned = #granted > 0
        local equipped = #granted > 0
        for _, cosmeticId in granted do
            local cosmetic = self._catalog.get(cosmeticId)
            if cosmetic == nil then
                owned = false
                equipped = false
            else
                for _, plan in cosmetic.parts do
                    table.insert(preview, plan)
                end
                if not self._entitlements.owns(state, cosmetic.id) then
                    owned = false
                end
                if self._entitlements.equippedIn(state, cosmetic.slot) ~= cosmetic.id then
                    equipped = false
                end
            end
        end
        local info = self:productInfo(product.id)
        local card, reason = self._storeCard.build(product, {
            priceInRobux = if info == nil then nil else info.priceInRobux,
            owned = owned,
            equipped = equipped,
            preview = preview,
        })
        if card ~= nil then
            table.insert(cards, card)
        elseif reason == "no_price" then
            unpriced += 1
        else
            -- Anything but a missing price is a catalog fault rather than a
            -- dashboard one, and it is worth a line: the card is gone and no
            -- spec would notice a product quietly disappearing from a shelf.
            self._logger:warn("commerce_card_refused", { product = product.id, reason = reason })
        end
    end

    local wardrobe = {}
    for _, cosmetic in self._catalog.list() do
        if self._entitlements.owns(state, cosmetic.id) then
            local row = self._storeCard.wardrobeRow(
                cosmetic,
                self._entitlements.equippedIn(state, cosmetic.slot) == cosmetic.id
            )
            if row ~= nil then
                table.insert(wardrobe, row)
            end
        end
    end

    return {
        enabled = self._featureFlags:isEnabled("cosmetic_store_enabled"),
        cards = cards,
        wardrobe = wardrobe,
        unpricedProducts = unpriced,
        assurance = self._storeCard.assurance(),
    }
end

--[[
    Somebody opened the store. Counted where it happened rather than where it
    was drawn: a client-side count of store views is a count a client decides.
]]
function CommerceService.recordStoreView(self: CommerceService, player: Player, cardCount: number)
    -- COMMERCE-EVENT: store_view
    self._analyticsService:storeView(player, cardCount)
end

--[[
    What a client may be told: what is worn, and what is owned.

    Owned reaches the client because the store card has to show it -- a card
    that cannot say "you already have this" sells a player the same thing
    twice. It is a list of ids and nothing else; no price, no receipt, no
    entitlement machinery.
]]
function CommerceService.snapshot(self: CommerceService, player: Player): any
    if not self._profileService:isLoaded(player) then
        return nil
    end
    local state = self._profileService:commerce(player)
    local owned: { string } = {}
    for _, cosmetic in self._catalog.list() do
        if self._entitlements.owns(state, cosmetic.id) then
            table.insert(owned, cosmetic.id)
        end
    end
    table.sort(owned)
    return {
        enabled = self._featureFlags:isEnabled("cosmetic_store_enabled"),
        owned = owned,
        equipped = state.equipped,
    }
end

--[[
    The Robux price, read from the platform rather than from a constant.

    A price in the source is a price that is wrong the first time the owner
    changes it in the dashboard, and a card showing the wrong number is worse
    than a card showing none. Cached per product for the life of the server:
    prices do not change mid-session, and `GetProductInfo` is a web call.
]]
function CommerceService.productInfo(self: CommerceService, productId: any): any
    if type(productId) ~= "string" then
        return nil
    end
    local cached = self._productInfo[productId]
    if cached ~= nil then
        return cached
    end
    local robloxId = self._config.CommerceProductIds[productId]
    if type(robloxId) ~= "number" then
        return nil
    end
    -- A failure is remembered for a minute. Long enough that a bad product
    -- costs one call rather than one per push; short enough that a dashboard
    -- fix takes effect without a server restart.
    local failedAt = self._productInfoFailedAt[productId]
    if failedAt ~= nil and os.time() - failedAt < PRODUCT_INFO_RETRY_SECONDS then
        return nil
    end
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(robloxId, Enum.InfoType.Product)
    end)
    if not ok or type(info) ~= "table" then
        self._productInfoFailedAt[productId] = os.time()
        self._logger:warn("commerce_product_info_failed", { product = productId })
        return nil
    end
    self._productInfoFailedAt[productId] = nil
    local resolved = {
        priceInRobux = tonumber(info.PriceInRobux) or 0,
        name = tostring(info.Name or ""),
    }
    self._productInfo[productId] = resolved
    return resolved
end

function CommerceService.promptPurchase(self: CommerceService, player: Player, productId: any): any
    if not self._featureFlags:isEnabled("cosmetic_store_enabled") then
        return { accepted = false, reason = "store_closed" }
    end
    local product = self._catalog.product(productId)
    if product == nil then
        return { accepted = false, reason = "unknown_product" }
    end
    local robloxId = self._config.CommerceProductIds[product.id]
    if type(robloxId) ~= "number" then
        --[[
            The dashboard half does not exist yet. Refused with a reason rather
            than prompting into nothing, which on a client looks like the button
            being broken -- and counted, which is the part a live pass found
            missing.

            Returning here without emitting meant a player pressing BUY on a
            product nobody had configured produced no telemetry at all. That is
            the exact shape this wave's spec exists to catch one level up: a
            dashboard reading nothing, indistinguishable from a store nobody
            opened, in the one case where somebody did press the button.
        ]]
        -- COMMERCE-EVENT: purchase_prompt
        self._analyticsService:purchasePrompt(player, product.id, false)
        return { accepted = false, reason = "product_not_configured" }
    end
    local ok = pcall(function()
        MarketplaceService:PromptProductPurchase(player, robloxId)
    end)
    self._analyticsService:purchasePrompt(player, product.id, ok)
    return { accepted = ok, reason = if ok then "prompted" else "prompt_failed" }
end

function CommerceService.Start(self: CommerceService)
    --[[
        The platform's own entry point, and the only one. Wrapped so an error
        anywhere inside becomes NotProcessedYet rather than an unhandled throw
        -- a throw is read by the platform as "no answer", which is the same as
        a retry, but it loses the log line that says why.
    ]]
    MarketplaceService.ProcessReceipt = function(receiptInfo: any): Enum.ProductPurchaseDecision
        local ok, granted = pcall(function(): boolean
            return self:applyReceipt({
                purchaseId = tostring(receiptInfo.PurchaseId),
                productId = self:_productIdFor(receiptInfo.ProductId),
                userId = receiptInfo.PlayerId,
                at = os.time(),
            })
        end)
        if not ok then
            self._logger:warn("commerce_receipt_error", { reason = tostring(granted) })
            return Enum.ProductPurchaseDecision.NotProcessedYet
        end
        return if granted
            then Enum.ProductPurchaseDecision.PurchaseGranted
            else Enum.ProductPurchaseDecision.NotProcessedYet
    end

    --[[
        What the platform's own prompt came back as.

        "Canceled prompts produce no receipt and no grant" is a gate about
        something not happening, and the only way to check that a cancel
        produced nothing is to know a cancel happened. Without this the metric
        is the absence of an event, which reads exactly the same as the store
        being shut.
    ]]
    -- GATE-METRIC: purchase_platform_result
    -- COMMERCE-EVENT: purchase_platform_result
    MarketplaceService.PromptProductPurchaseFinished:Connect(
        function(userId: number, robloxProductId: number, purchased: boolean)
            self._analyticsService:purchasePlatformResult(
                userId,
                self:_productIdFor(robloxProductId),
                purchased
            )
        end
    )

    self._profileService:onLoaded(function(player: Player, _profile: any)
        task.spawn(function()
            self:drainFor(player)
        end)
    end)

    self:_watchStudioStore()

    self._logger:info("commerce_started", {
        configured = self:_configuredCount(),
        products = #self._catalog.products(),
        storeEnabled = self._featureFlags:isEnabled("cosmetic_store_enabled"),
    })
end

--[[
    The Studio half of a surface whose real half needs a Creator Dashboard.

    Everything about the store that a camera can judge -- the panel on a
    portrait canvas, a card's price line, the owned state, the wardrobe, the
    preview of a cosmetic's own geometry -- is invisible until a product has a
    price, and a product has no price until somebody creates it in the
    dashboard and pastes the number into `Config.CommerceProductIds`. That is
    the owner's, and it is not going to happen before this ships.

    The failure that leaves behind is written down elsewhere in this codebase
    in as many words: a live pass went to look at two rewritten HUD surfaces,
    found both correctly empty, and ended knowing nothing. `LastLightSkipTutorial`
    and `LastLightStockProfile` exist because of that pass. These two are the
    same tool pointed at the store.

    **Neither one grants anything the real path would not.** A price is a
    number to draw, not a product id -- `promptPurchase` still refuses with
    `product_not_configured`, because a dashboard product genuinely does not
    exist. And a grant goes through `applyReceipt`, the single grant authority,
    with a synthetic receipt: the platform's own `ProcessReceipt` cannot be
    driven in Studio, and feeding the real handler a receipt is the closest
    honest thing to it. Studio only, on both, and logged loudly every time.
]]
function CommerceService._watchStudioStore(self: CommerceService)
    if not RunService:IsStudio() then
        return
    end

    local function applyPrice()
        local price = tonumber(game:GetAttribute("LastLightStudioStore"))
        if price == nil or price <= 0 then
            return
        end
        self._featureFlags:setOverride("cosmetic_store_enabled", true)
        for _, product in self._catalog.products() do
            self._productInfo[product.id] =
                { priceInRobux = math.floor(price), name = product.displayName }
        end
        self._logger:warn("studio_store_priced", {
            price = math.floor(price),
            products = #self._catalog.products(),
        })
    end

    local function applyGrant()
        local productId = game:GetAttribute("LastLightStudioGrant")
        if type(productId) ~= "string" or #productId == 0 then
            return
        end
        for _, player in Players:GetPlayers() do
            self:applyReceipt({
                purchaseId = string.format("studio_%s_%d", productId, player.UserId),
                productId = productId,
                userId = player.UserId,
                at = os.time(),
            })
        end
        self._logger:warn("studio_store_granted", { product = productId })
    end

    --[[
        Isolated, because these run inside Start. A Studio helper that throws
        would take the rest of commerce startup with it, and the whole point of
        these two is that they are scaffolding: they may not be able to break
        the thing they exist to look at.
    ]]
    for name, apply in { LastLightStudioStore = applyPrice, LastLightStudioGrant = applyGrant } do
        local ok, err = pcall(apply)
        if not ok then
            self._logger:warn("studio_store_hook_failed", { hook = name, reason = tostring(err) })
        end
        game:GetAttributeChangedSignal(name):Connect(function()
            local applied, failure = pcall(apply)
            if not applied then
                self._logger:warn(
                    "studio_store_hook_failed",
                    { hook = name, reason = tostring(failure) }
                )
            end
        end)
    end
end

-- The dashboard number back to this game's own product id. A receipt names
-- Roblox's id; everything here names ours.
function CommerceService._productIdFor(self: CommerceService, robloxProductId: any): string
    for productId, configured in self._config.CommerceProductIds do
        if configured == robloxProductId then
            return productId
        end
    end
    return ""
end

function CommerceService._configuredCount(self: CommerceService): number
    local count = 0
    for _ in self._config.CommerceProductIds do
        count += 1
    end
    return count
end

return table.freeze(CommerceService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="130">
          <Properties>
            <string name="Name">CompanionService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Companions -- the M6 deliverable's first resident: the Beastkeeper's
    bonded briar hound, a persistent creature that walks beside its keeper
    rather than existing only for seven seconds of ability.

    v1 charter, deliberately bounded: the hound exists in town while its
    keeper wears the Beastkeeper profession, follows at the flank (or stays
    where told via the FOLLOW/STAY command), and has no combat role of its
    own -- the Briar Hound ability IS its combat moment, and the fiction is
    now whole: the creature you send at the night was at your side all day.
    It does not enter Bramblewake yet; expedition pathing is a live-tested
    wave, not a blind one.

    Movement is the same anchored PivotTo stepping every night creature
    uses -- no Humanoid, no physics, no pathfinding debt -- with the pure
    math in CompanionMotion where the specs can reach it.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CompanionService = {}
CompanionService.__index = CompanionService
CompanionService.Name = "CompanionService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type Companion = {
    model: Model,
    position: Vector3,
    mode: string, -- "follow" | "stay"
    bobPhase: number,
}

export type CompanionService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _companionMotion: any,
        _companions: { [Player]: Companion },
        _heartbeat: RBXScriptConnection?,
    },
    CompanionService
))

local HOUND_RUSSET = Color3.fromRGB(146, 94, 52)
local HOUND_DARK = Color3.fromRGB(96, 62, 36)
local HOUND_EYE = Color3.fromRGB(94, 206, 176)

function CompanionService.new(logger: Logger, companionMotion: any): CompanionService
    return setmetatable({
        Name = CompanionService.Name,
        _logger = logger,
        _companionMotion = companionMotion,
        _companions = {},
        _heartbeat = nil,
    }, CompanionService)
end

function CompanionService.Init(_self: CompanionService, _context: any) end

local function buildHound(): Model
    local model = Instance.new("Model")
    model.Name = "BriarHound"

    local function part(name: string, size: Vector3, offset: CFrame, color: Color3): Part
        local piece = Instance.new("Part")
        piece.Name = name
        piece.Size = size
        piece.CFrame = offset
        piece.Color = color
        piece.Material = Enum.Material.Wood
        piece.Anchored = true
        piece.CanCollide = false
        piece.CanTouch = false
        piece.CanQuery = false
        piece.CastShadow = true
        piece.Parent = model
        return piece
    end

    -- A hound readable at gameplay distance: long low body, forward head
    -- with bright eyes, four legs, an up-curled tail. Bramble growing along
    -- the spine keeps it this forest's creature rather than a generic dog.
    local body = part("Body", Vector3.new(1.4, 1.2, 3), CFrame.new(0, 1.35, 0), HOUND_RUSSET)
    part("Head", Vector3.new(1.05, 0.95, 1.15), CFrame.new(0, 1.95, -1.85), HOUND_RUSSET)
    part("Snout", Vector3.new(0.6, 0.45, 0.6), CFrame.new(0, 1.75, -2.6), HOUND_DARK)
    for side = -1, 1, 2 do
        part(
            "Ear",
            Vector3.new(0.22, 0.55, 0.34),
            CFrame.new(side * 0.36, 2.55, -1.8) * CFrame.Angles(0, 0, side * 0.18),
            HOUND_DARK
        )
        local eye = part(
            "Eye",
            Vector3.new(0.16, 0.16, 0.1),
            CFrame.new(side * 0.26, 2.05, -2.42),
            HOUND_EYE
        )
        eye.Material = Enum.Material.Neon
        for legZ = -1, 1, 2 do
            part(
                "Leg",
                Vector3.new(0.38, 1.05, 0.38),
                CFrame.new(side * 0.5, 0.55, legZ * 1.1),
                HOUND_DARK
            )
        end
    end
    part(
        "Tail",
        Vector3.new(0.3, 1.1, 0.3),
        CFrame.new(0, 2.1, 1.6) * CFrame.Angles(math.rad(-32), 0, 0),
        HOUND_RUSSET
    )
    for index = -1, 1 do
        part(
            "SpineBramble",
            Vector3.new(0.28, 0.5, 0.28),
            CFrame.new(index * 0.15, 2.1, index * 0.85) * CFrame.Angles(0, 0, index * 0.3),
            Color3.fromRGB(74, 96, 46)
        )
    end
    model.PrimaryPart = body
    return model
end

function CompanionService._dismiss(self: CompanionService, player: Player)
    local companion = self._companions[player]
    if companion == nil then
        return
    end
    if companion.model.Parent ~= nil then
        companion.model:Destroy()
    end
    self._companions[player] = nil
end

local function keeperRoot(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function eligible(player: Player): boolean
    return player:GetAttribute("LastLightProfessionId") == "profession_beastkeeper"
        and player:GetAttribute("LastLightInExpedition") ~= true
        and player:GetAttribute("LastLightDowned") ~= true
end

function CompanionService._summon(self: CompanionService, player: Player)
    local root = keeperRoot(player)
    if root == nil then
        return
    end
    local model = buildHound()
    local side, back = self._companionMotion.followOffset()
    local start = (root.CFrame * CFrame.new(side, 0, back)).Position
    start = Vector3.new(start.X, root.Position.Y - 1.5, start.Z)
    model:PivotTo(CFrame.new(start))
    model.Parent = workspace
    self._companions[player] = {
        model = model,
        position = start,
        mode = "follow",
        bobPhase = 0,
    }
    self._logger:info("companion_summoned", { player = player.UserId })
end

function CompanionService.command(self: CompanionService, player: Player, mode: any): any
    local companion = self._companions[player]
    if companion == nil then
        return { accepted = false, message = "YOUR HOUND IS NOT WITH YOU" }
    end
    if mode ~= "follow" and mode ~= "stay" then
        return { accepted = false, message = "THE HOUND TILTS ITS HEAD" }
    end
    companion.mode = mode
    self._logger:info("companion_commanded", { player = player.UserId, mode = mode })
    return {
        accepted = true,
        message = if mode == "stay" then "THE HOUND SETTLES AND WAITS" else "THE HOUND FALLS IN",
    }
end

--[[
    What the HUD needs to know: whether this player has a hound at all, and
    what it was last told. The client renders the order button from this
    rather than guessing from the profession, so a keeper whose hound has
    not been summoned yet sees no button.
]]
function CompanionService.snapshot(self: CompanionService, player: Player): any
    local companion = self._companions[player]
    if companion == nil then
        return { present = false, mode = "follow" }
    end
    return { present = true, mode = companion.mode }
end

function CompanionService._step(self: CompanionService, deltaTime: number)
    for _, player in Players:GetPlayers() do
        local companion = self._companions[player]
        if eligible(player) then
            if companion == nil then
                self:_summon(player)
                companion = self._companions[player]
            end
        elseif companion ~= nil then
            self:_dismiss(player)
            companion = nil
        end
        local root = keeperRoot(player)
        if companion ~= nil and root ~= nil and companion.model.Parent ~= nil then
            local moving = false
            if companion.mode == "follow" then
                local side, back = self._companionMotion.followOffset()
                local target = (root.CFrame * CFrame.new(side, 0, back)).Position
                local nx, nz
                nx, nz, moving = self._companionMotion.step(
                    companion.position.X,
                    companion.position.Z,
                    target.X,
                    target.Z,
                    deltaTime
                )
                companion.position = Vector3.new(nx, companion.position.Y, nz)
            end
            companion.bobPhase += deltaTime * (if moving then 9 else 2.2)
            local bob = math.sin(companion.bobPhase) * (if moving then 0.16 else 0.05)
            local faceTarget = if companion.mode == "follow"
                then Vector3.new(root.Position.X, companion.position.Y, root.Position.Z)
                else companion.position + companion.model:GetPivot().LookVector
            if (faceTarget - companion.position).Magnitude <= 0.05 then
                faceTarget = companion.position + Vector3.new(0, 0, -1)
            end
            companion.model:PivotTo(
                CFrame.lookAt(companion.position + Vector3.new(0, bob, 0), faceTarget)
            )
        end
    end
end

function CompanionService.Start(self: CompanionService)
    Players.PlayerRemoving:Connect(function(player: Player)
        self:_dismiss(player)
    end)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.05 then
            return
        end
        local elapsed = accumulator
        accumulator = 0
        self:_step(elapsed)
    end)
end

return table.freeze(CompanionService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">DefenseService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Defense plots -- the M6 deliverable that turns "place defenses" from a
    dusk-phase promise in the GDD into something a player can actually do.

    Three snare plots stand in town, one per approach lane, always visible
    so dusk preparation is legible. Arming one is a tap on the plot's stake
    (a ClickDetector -- the same server-authoritative touch pattern strikes
    use, so no new client payload exists to get past ActionPayloadContract)
    and costs materials, spent atomically through the profile. An armed
    plot holds two bites; when a night enemy walks into the trigger ring,
    the snare takes a charge and holds the enemy with the same snaredUntil
    timer the Foxfire Sling uses -- which also means the "exposed" x1.2
    strike reaction from the status system applies. The systems already
    knew each other; the trap just introduces them at a place of the
    player's choosing.

    Resident defenders, v1: on solo nights only (the GDD's "solo players
    receive stronger resident support"), a Watch resident stands at the
    Meadow Gate plot and chips the active enemy when it passes -- softening,
    never finishing, so every defeat still belongs to the player.
]]

local RunService = game:GetService("RunService")

local TerrainBuilder = require(script.Parent.Parent.World.TerrainBuilder)

local DefenseService = {}
DefenseService.__index = DefenseService
DefenseService.Name = "DefenseService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type Plot = {
    laneId: string,
    displayName: string,
    position: Vector3,
    model: Model,
    ember: Part,
    charges: number,
    quietUntil: number,
}

export type DefenseService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _defenseLanes: any,
        _worldService: any,
        _enemyService: any,
        _profileService: any,
        _plots: { [string]: Plot },
        _toastHandler: ((Player?, string) -> ())?,
        _nightActive: boolean,
        _watchDefender: Model?,
        _watchPosition: Vector3?,
        _nextChipAt: number,
        _heartbeat: RBXScriptConnection?,
    },
    DefenseService
))

local EMBER_ARMED = Color3.fromRGB(255, 170, 66)
local EMBER_COLD = Color3.fromRGB(64, 52, 40)
local STONE = Color3.fromRGB(112, 108, 100)
local STAKE_WOOD = Color3.fromRGB(94, 66, 40)
local WATCH_COAT = Color3.fromRGB(52, 74, 92)

local WATCH_CHIP_DAMAGE = 3
local WATCH_CHIP_EVERY = 7
local WATCH_CHIP_RANGE = 26

function DefenseService.new(
    logger: Logger,
    defenseLanes: any,
    worldService: any,
    enemyService: any,
    profileService: any
): DefenseService
    return setmetatable({
        Name = DefenseService.Name,
        _logger = logger,
        _defenseLanes = defenseLanes,
        _worldService = worldService,
        _enemyService = enemyService,
        _profileService = profileService,
        _plots = {},
        _toastHandler = nil,
        _nightActive = false,
        _watchDefender = nil,
        _watchPosition = nil,
        _nextChipAt = 0,
        _heartbeat = nil,
    }, DefenseService)
end

function DefenseService.Init(_self: DefenseService, _context: any) end

function DefenseService.setToastHandler(self: DefenseService, handler: (Player?, string) -> ())
    self._toastHandler = handler
end

function DefenseService._toast(self: DefenseService, player: Player?, message: string)
    local handler = self._toastHandler
    if handler ~= nil then
        handler(player, message)
    end
end

local function makePart(
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    parent: Model
): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = cframe
    part.Color = color
    part.Material = material
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.Parent = parent
    return part
end

--[[
    A snare plot readable at a glance: a low ring of stones around a
    leaning stake, with an ember lamp that is cold until armed. The stake
    carries the ArmClick detector; on touch, tapping the stake IS the
    arming gesture, same as tapping a night creature is the strike.
]]
function DefenseService._buildPlot(self: DefenseService, lane: any, position: Vector3): Plot
    local model = Instance.new("Model")
    model.Name = "DefensePlot_" .. lane.id

    for index = 0, 5 do
        local angle = index * math.pi / 3
        local offset = Vector3.new(math.cos(angle) * 4.4, 0.35, math.sin(angle) * 4.4)
        makePart(
            "RingStone",
            Vector3.new(1.4, 0.8, 1.1),
            CFrame.new(position + offset) * CFrame.Angles(0, angle, 0),
            STONE,
            Enum.Material.Slate,
            model
        )
    end
    local stake = makePart(
        "Stake",
        Vector3.new(0.7, 4.6, 0.7),
        CFrame.new(position + Vector3.new(0, 2.3, 0)) * CFrame.Angles(0, 0, math.rad(6)),
        STAKE_WOOD,
        Enum.Material.Wood,
        model
    )
    stake.CanQuery = true
    local ember = makePart(
        "Ember",
        Vector3.new(0.9, 0.9, 0.9),
        CFrame.new(position + Vector3.new(0, 4.9, 0)),
        EMBER_COLD,
        Enum.Material.Neon,
        model
    )
    model.PrimaryPart = stake

    local click = Instance.new("ClickDetector")
    click.Name = "ArmClick"
    click.MaxActivationDistance = 42
    click.CursorIcon = ""
    click.Parent = stake
    click.MouseClick:Connect(function(clicker: Player)
        self:_armAttempt(clicker, lane.id)
    end)

    model.Parent = workspace
    return {
        laneId = lane.id,
        displayName = lane.displayName,
        position = position,
        model = model,
        ember = ember,
        charges = 0,
        quietUntil = 0,
    }
end

function DefenseService._buildPlots(self: DefenseService)
    local lantern = self._worldService:lanternPosition()
    local spawn = self._worldService:enemySpawnPosition()
    for _, lane in self._defenseLanes.list() do
        local px, pz = self._defenseLanes.plotPoint(lane, spawn.X, spawn.Z, lantern.X, lantern.Z)
        local position = Vector3.new(px, TerrainBuilder.surfaceHeight(px, pz), pz)
        self._plots[lane.id] = self:_buildPlot(lane, position)
    end
    self._logger:info("defense_plots_built", { lanes = #self._defenseLanes.list() })
end

local function costLine(cost: { [string]: number }): string
    local parts = {}
    for materialId, amount in cost do
        local label = string.upper((string.gsub(materialId, "^material_", "")))
        table.insert(parts, string.format("%d %s", amount, (string.gsub(label, "_", " "))))
    end
    table.sort(parts)
    return table.concat(parts, " AND ")
end

function DefenseService._armAttempt(self: DefenseService, player: Player, laneId: string)
    local plot = self._plots[laneId]
    if plot == nil then
        return
    end
    if player:GetAttribute("LastLightInExpedition") == true then
        return
    end
    if player:GetAttribute("LastLightDowned") == true then
        return
    end
    if plot.charges > 0 then
        self:_toast(player, "THE " .. plot.displayName .. " SNARE IS ALREADY SET")
        return
    end
    local trap = self._defenseLanes.Trap
    local result = self._profileService:spendMaterials(player, trap.armCost)
    if result.applied ~= true then
        self:_toast(player, "SETTING THE SNARE TAKES " .. costLine(trap.armCost))
        return
    end
    plot.charges = trap.charges
    plot.ember.Color = EMBER_ARMED
    self._logger:info("defense_trap_armed", {
        lane = laneId,
        player = player.UserId,
    })
    self:_toast(
        player,
        string.format("THE %s SNARE IS SET — %d BITES IN IT", plot.displayName, trap.charges)
    )
end

function DefenseService.plotSnapshot(self: DefenseService): { [string]: number }
    local charges = {}
    for laneId, plot in self._plots do
        charges[laneId] = plot.charges
    end
    return charges
end

local function buildWatchDefender(position: Vector3): Model
    local model = Instance.new("Model")
    model.Name = "WatchDefender"
    local body = makePart(
        "Body",
        Vector3.new(1.6, 2.4, 1),
        CFrame.new(position + Vector3.new(0, 2.2, 0)),
        WATCH_COAT,
        Enum.Material.Fabric,
        model
    )
    makePart(
        "Head",
        Vector3.new(0.9, 0.9, 0.9),
        CFrame.new(position + Vector3.new(0, 3.85, 0)),
        Color3.fromRGB(214, 178, 148),
        Enum.Material.SmoothPlastic,
        model
    )
    makePart(
        "Pike",
        Vector3.new(0.25, 6.4, 0.25),
        CFrame.new(position + Vector3.new(1.1, 3.2, 0)) * CFrame.Angles(0, 0, math.rad(-8)),
        STAKE_WOOD,
        Enum.Material.Wood,
        model
    )
    local lamp = makePart(
        "Lamp",
        Vector3.new(0.5, 0.5, 0.5),
        CFrame.new(position + Vector3.new(1.55, 5.9, 0)),
        EMBER_ARMED,
        Enum.Material.Neon,
        model
    )
    lamp.CanQuery = false
    model.PrimaryPart = body
    return model
end

function DefenseService.onNightStarted(self: DefenseService, partySize: number)
    self._nightActive = true
    self._nextChipAt = 0
    if partySize ~= 1 then
        return
    end
    local plot = self._plots["lane_meadow_gate"]
    if plot == nil then
        return
    end
    local position = plot.position + Vector3.new(3.4, 0, 3.4)
    self._watchDefender = buildWatchDefender(position)
    self._watchPosition = position
    if self._watchDefender ~= nil then
        self._watchDefender.Parent = workspace
    end
    self._logger:info("defense_watch_posted", { lane = plot.laneId })
    self:_toast(nil, "THE WATCH STANDS WITH YOU AT THE MEADOW GATE")
end

function DefenseService.onNightEnded(self: DefenseService)
    self._nightActive = false
    if self._watchDefender ~= nil then
        self._watchDefender:Destroy()
        self._watchDefender = nil
        self._watchPosition = nil
    end
end

function DefenseService._step(self: DefenseService, now: number)
    --[[
        A lit snare bites whatever walks its ring, on any night.

        This used to gate on the service's own night flag, which only
        TownNightService raises -- so through the tutorial's first night
        the three plots stood there armed, with creatures walking straight
        through their rings, and nothing could ever happen. Watched it
        happen in Studio: the ember stayed lit, both charges intact, while
        a rootling, a briarback and a hollow zombie walked the Meadow Gate.

        The enemy service's own answer is the better source of truth: it
        returns a position only while a night is running and something is
        actually on the field, which is exactly the condition a trap cares
        about. The night flag stays for the Watch defender below, which
        genuinely is a town-night affair (it needs the party census).
    ]]
    local ex, ez = self._enemyService:activeFlatPosition()
    if ex == nil or ez == nil then
        return
    end
    for _, plot in self._plots do
        if
            plot.charges > 0
            and now >= plot.quietUntil
            and self._defenseLanes.trapTriggers(ex, ez, plot.position.X, plot.position.Z)
        then
            local trap = self._defenseLanes.Trap
            local held = self._enemyService:applyTrapSnare(trap.snareSeconds)
            if held ~= nil then
                plot.charges -= 1
                -- One bite per victim: stay quiet until this snare has
                -- fully released before the ring can trigger again.
                plot.quietUntil = now + trap.snareSeconds + 2
                if plot.charges <= 0 then
                    plot.ember.Color = EMBER_COLD
                end
                self._logger:info("defense_trap_bit", {
                    charges = plot.charges,
                    enemy = held,
                    lane = plot.laneId,
                })
                self:_toast(
                    nil,
                    string.format("THE SNARE BITES — %s IS HELD", string.upper(held))
                )
            end
        end
    end
    local watchPosition = self._watchPosition
    if watchPosition ~= nil and now >= self._nextChipAt then
        local dx = ex - watchPosition.X
        local dz = ez - watchPosition.Z
        if dx * dx + dz * dz <= WATCH_CHIP_RANGE ^ 2 then
            if self._enemyService:residentChip(WATCH_CHIP_DAMAGE) then
                self._nextChipAt = now + WATCH_CHIP_EVERY
            end
        end
    end
end

function DefenseService.Start(self: DefenseService)
    -- The plots need the lantern, which the world raises during its own
    -- startup; wait for it rather than racing it.
    task.spawn(function()
        for _ = 1, 120 do
            local ready = pcall(function()
                return self._worldService:lanternPosition()
            end)
            if ready then
                self:_buildPlots()
                break
            end
            task.wait(0.5)
        end
    end)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.25 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
end

return table.freeze(DefenseService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">EnemyService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local TerrainBuilder = require(script.Parent.Parent.World.TerrainBuilder)

-- The lantern starts every night here and can never be pushed past it.
local LANTERN_CEILING = 100

local EnemyService = {}
EnemyService.__index = EnemyService
EnemyService.Name = "EnemyService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type AttackVisual = {
    label: TextLabel,
    marker: Part,
}

type Attack = {
    areaCFrame: CFrame,
    facingPosition: Vector3,
    flow: any,
    target: Player,
    visual: AttackVisual,
}

type Enemy = {
    attack: Attack?,
    basePosition: Vector3,
    definition: any,
    facingPosition: Vector3,
    health: number,
    lastAttackAt: number,
    luredUntil: number,
    markedUntil: number,
    model: Model,
    snaredUntil: number,
    spawnedAt: number,
    stilledUntil: number,
}

export type EnemyService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _worldService: any,
        _survivalService: any,
        _combatService: any,
        _enemyAttackFlow: any,
        _enemyCatalog: any,
        _enemyCombatRules: any,
        _enemyMotion: any,
        _engineerBrace: any,
        _enemyBuilder: any,
        _analyticsService: any,
        _defenseLanes: any,
        _professionService: any,
        _eliteService: any,
        _bossService: any,
        _active: Enemy?,
        _queue: { { enemyId: string, laneId: string? } },
        _nextSpawnAt: number,
        _nightActive: boolean,
        _lurePlayer: Player?,
        _lureUntil: number,
        _strikeHandler: ((Player) -> ())?,
        _lanternHealth: number,
        _lanternFloor: number,
        _expeditionDamageMultiplier: number,
        _breachMultiplier: number,
        _nightModifiers: any,
        _engineerBraceState: any,
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
        _still: boolean,
        _stillSince: number,
    },
    EnemyService
))

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

function EnemyService.new(
    logger: Logger,
    config: any,
    worldService: any,
    survivalService: any,
    combatService: any,
    enemyAttackFlow: any,
    enemyCatalog: any,
    enemyCombatRules: any,
    enemyMotion: any,
    engineerBrace: any,
    enemyBuilder: any,
    analyticsService: any
): EnemyService
    return setmetatable({
        Name = EnemyService.Name,
        _logger = logger,
        _config = config,
        _worldService = worldService,
        _survivalService = survivalService,
        _combatService = combatService,
        _enemyAttackFlow = enemyAttackFlow,
        _enemyCatalog = enemyCatalog,
        _enemyCombatRules = enemyCombatRules,
        _enemyMotion = enemyMotion,
        _engineerBrace = engineerBrace,
        _enemyBuilder = enemyBuilder,
        _analyticsService = analyticsService,
        _defenseLanes = nil,
        _professionService = nil,
        _eliteService = nil,
        _bossService = nil,
        _active = nil,
        _queue = {},
        _nextSpawnAt = 0,
        _nightActive = false,
        _lurePlayer = nil,
        _lureUntil = 0,
        _strikeHandler = nil,
        _lanternHealth = 100,
        _lanternFloor = 18,
        _expeditionDamageMultiplier = 1,
        _breachMultiplier = 1,
        _nightModifiers = {
            healthMultiplier = 1,
            speedMultiplier = 1,
            playerDamageMultiplier = 1,
            lanternDamageMultiplier = 1,
        },
        _engineerBraceState = engineerBrace.default(),
        _onChanged = nil,
        _heartbeat = nil,
        _still = false,
        _stillSince = 0,
    }, EnemyService)
end

function EnemyService.Init(_self: EnemyService, _context: any) end

function EnemyService.Start(self: EnemyService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.05 then
            return
        end
        --[[
            Stillness is the whole simulation stopping, not the walk cycle.

            A creature that stopped moving and went on winding up an attack
            would be a cinematic tool that kills you for using it, and one that
            stopped attacking while the spawn timers ran would fill the town
            with statues that all wake at once. `_step` is the only thing that
            advances any of it, so not calling it is the honest version.
        ]]
        if self._still then
            accumulator = 0
            return
        end
        local elapsed = accumulator
        accumulator = 0
        self:_step(elapsed)
    end)
end

--[[
    Only a practice server reaches this: PrivateServerService is the sole caller
    and it has already latched profile writes off before it gets here.

    Releasing has to move every deadline forward by the held duration, and the
    review caught that not doing so makes the comment above `_step` a lie. Not
    calling `_step` freezes the poses and the walking; it does not freeze the
    wall clock those deadlines are measured against. Held for thirty seconds,
    an attack cooldown and the spawn timer are both long satisfied by the time
    the world moves again, so the creature swings on the first frame and the
    queue drains at once -- the statues all waking together. Worse, a telegraph
    that was in flight has an `endsAt` in the past and resolves with no windup
    left, which is a cinematic tool that hits you for using it.
]]
function EnemyService.setStillness(self: EnemyService, still: boolean)
    local next_ = still == true
    if next_ == self._still then
        return
    end
    self._still = next_
    local now = workspace:GetServerTimeNow()
    if next_ then
        self._stillSince = now
        return
    end

    local heldFor = math.max(0, now - self._stillSince)
    self._stillSince = 0
    self._nextSpawnAt += heldFor
    local enemy = self._active
    if enemy ~= nil then
        -- `spawnedAt` rides along too: it is the pose clock's origin, so
        -- leaving it behind would snap the animation forward by the whole hold
        -- on the frame the world resumes.
        enemy.spawnedAt += heldFor
        enemy.lastAttackAt += heldFor
        enemy.luredUntil += heldFor
        enemy.markedUntil += heldFor
        enemy.snaredUntil += heldFor
        enemy.stilledUntil += heldFor
        local attack = enemy.attack
        if attack ~= nil and type(attack.flow) == "table" then
            attack.flow.startedAt += heldFor
            attack.flow.endsAt += heldFor
        end
    end
    self._lureUntil += heldFor
end

--[[
    How many creatures this server still believes are in the world: the one
    being fought plus everything queued behind it. A soak reads this at
    dawn, when the honest answer is zero -- a night ends by clearing its
    queue, so anything counted here at dawn outlived the night it belonged
    to.
]]
function EnemyService.trackedCount(self: EnemyService): number
    return (if self._active ~= nil then 1 else 0) + #self._queue
end

function EnemyService.isStill(self: EnemyService): boolean
    return self._still
end

function EnemyService.setChangedHandler(self: EnemyService, callback: (string?) -> ())
    self._onChanged = callback
end

function EnemyService.setDefenseLanes(self: EnemyService, defenseLanes: any)
    self._defenseLanes = defenseLanes
end

function EnemyService.setProfessionService(self: EnemyService, professionService: any)
    self._professionService = professionService
end

function EnemyService.setEliteService(self: EnemyService, eliteService: any)
    self._eliteService = eliteService
end

function EnemyService.setBossService(self: EnemyService, bossService: any)
    self._bossService = bossService
end

function EnemyService._activeEncounterService(self: EnemyService): any
    if self._bossService ~= nil and self._bossService:combatActive() then
        return self._bossService
    end
    if self._eliteService ~= nil and self._eliteService:combatActive() then
        return self._eliteService
    end
    return nil
end

function EnemyService._notify(self: EnemyService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function EnemyService._poseEnemy(
    self: EnemyService,
    enemy: Enemy,
    now: number,
    motionState: string,
    attackProgress: number?
)
    if enemy.model.Parent == nil then
        return
    end
    local pose = self._enemyMotion.pose(
        math.max(0, now - enemy.spawnedAt),
        enemy.definition.modelKey,
        motionState,
        attackProgress
    )
    local position = enemy.basePosition + Vector3.new(0, pose.height, 0)
    local flatFacing = Vector3.new(enemy.facingPosition.X, position.Y, enemy.facingPosition.Z)
    if (flatFacing - position).Magnitude <= 0.01 then
        flatFacing = position + Vector3.new(0, 0, -1)
    end
    enemy.model:PivotTo(
        CFrame.lookAt(position, flatFacing) * CFrame.Angles(pose.pitch, 0, pose.roll)
    )
end

function EnemyService._showSpawnPulse(_self: EnemyService, position: Vector3, color: Color3)
    local pulse = Instance.new("Part")
    pulse.Name = "BramblewakeSpawnPulse"
    pulse.Anchored = true
    pulse.CanCollide = false
    pulse.CanQuery = false
    pulse.CanTouch = false
    pulse.CastShadow = false
    pulse.Shape = Enum.PartType.Cylinder
    pulse.Material = Enum.Material.Neon
    pulse.Color = color
    pulse.Transparency = 0.18
    pulse.Size = Vector3.new(0.16, 4, 4)
    pulse.CFrame = CFrame.new(position + Vector3.new(0, 0.12, 0))
        * CFrame.Angles(0, 0, math.rad(90))
    pulse.Parent = workspace

    local tween = TweenService:Create(
        pulse,
        TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = Vector3.new(0.16, 18, 18),
            Transparency = 1,
        }
    )
    tween:Play()
    task.delay(0.95, function()
        if pulse.Parent ~= nil then
            pulse:Destroy()
        end
    end)
end

function EnemyService._showDamageFeedback(
    self: EnemyService,
    enemy: Enemy,
    damage: number,
    strikeResult: string
)
    local primary = enemy.model.PrimaryPart
    if primary == nil then
        return
    end

    local revision = (tonumber(enemy.model:GetAttribute("HitRevision")) or 0) + 1
    enemy.model:SetAttribute("HitRevision", revision)
    local highlight = enemy.model:FindFirstChild("ThreatOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        highlight.FillColor = Color3.fromRGB(255, 238, 188)
        highlight.FillTransparency = 0.18
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        task.delay(0.13, function()
            if
                enemy.model.Parent ~= nil
                and enemy.model:GetAttribute("HitRevision") == revision
            then
                self:_setMarkedVisual(enemy, workspace:GetServerTimeNow() < enemy.markedUntil)
            end
        end)
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DamageFeedback"
    billboard.Adornee = primary
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 95
    billboard.Size = UDim2.fromOffset(130, 48)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 4.8, 0)
    billboard.Parent = primary

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBlack
    label.Text = if strikeResult == "flanked"
        then string.format("FLANK  -%d", damage)
        elseif strikeResult == "shielded" then string.format("BLOCK  -%d", damage)
        else string.format("-%d", damage)
    label.TextColor3 = if strikeResult == "flanked"
        then Color3.fromRGB(255, 213, 105)
        elseif strikeResult == "shielded" then Color3.fromRGB(169, 201, 188)
        else Color3.fromRGB(255, 238, 205)
    label.TextScaled = true
    label.TextStrokeColor3 = Color3.fromRGB(31, 25, 22)
    label.TextStrokeTransparency = 0.2
    label.Parent = billboard

    TweenService:Create(
        billboard,
        TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { StudsOffsetWorldSpace = Vector3.new(0, 7.2, 0) }
    ):Play()
    TweenService:Create(
        label,
        TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { TextTransparency = 1, TextStrokeTransparency = 1 }
    ):Play()
    task.delay(0.62, function()
        if billboard.Parent ~= nil then
            billboard:Destroy()
        end
    end)
end

function EnemyService._defeatActive(self: EnemyService, enemy: Enemy)
    self:_clearAttack(enemy)
    if self._active == enemy then
        self._active = nil
    end
    enemy.model:SetAttribute("Defeated", true)
    local pivot = enemy.model:GetPivot().Position
    self:_showSpawnPulse(pivot, Color3.fromRGB(255, 194, 105))

    for _, descendant in enemy.model:GetDescendants() do
        if descendant:IsA("BasePart") then
            descendant.CanCollide = false
            descendant.CanQuery = false
            descendant.CanTouch = false
            TweenService
                :Create(
                    descendant,
                    TweenInfo.new(0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                    {
                        Position = descendant.Position + Vector3.new(0, 1.4, 0),
                        Transparency = 1,
                    }
                )
                :Play()
        end
    end
    task.delay(0.55, function()
        if enemy.model.Parent ~= nil then
            enemy.model:Destroy()
        end
    end)
end

function EnemyService._clearAttack(_self: EnemyService, enemy: Enemy)
    local attack = enemy.attack
    if attack == nil then
        return
    end
    if attack.visual.marker.Parent ~= nil then
        attack.visual.marker:Destroy()
    end
    enemy.attack = nil
end

function EnemyService._destroyActive(self: EnemyService)
    local active = self._active
    if active == nil then
        return
    end
    self:_clearAttack(active)
    if active.model.Parent ~= nil then
        active.model:Destroy()
    end
    self._active = nil
end

function EnemyService._clearEngineerBrace(self: EnemyService)
    self._engineerBraceState = self._engineerBrace.default()
    self._worldService:setEngineerBrace(
        self._engineerBrace.snapshot(self._engineerBraceState, workspace:GetServerTimeNow())
    )
end

function EnemyService._absorbLanternPressure(
    self: EnemyService,
    amount: number,
    source: string,
    now: number
): (number, number)
    local nextState, result = self._engineerBrace.absorb(self._engineerBraceState, amount, now)
    self._engineerBraceState = nextState
    local snapshot = self._engineerBrace.snapshot(nextState, now)
    self._worldService:setEngineerBrace(snapshot, result.absorbed or 0)
    if result.applied then
        self._analyticsService:engineerBraceAbsorbed(
            result.ownerUserId or snapshot.ownerUserId,
            source,
            result.absorbed,
            result.remaining,
            snapshot.capacity
        )
    end
    return result.remaining or math.max(0, math.ceil(amount)), result.absorbed or 0
end

function EnemyService.startNight(self: EnemyService, modifiers: any?)
    self:_destroyActive()
    table.clear(self._queue)
    self._lurePlayer = nil
    self._lureUntil = 0
    self._nightActive = true
    self._lanternHealth = 100
    self._worldService:setLanternHealth(self._lanternHealth)
    self:_clearEngineerBrace()
    self._breachMultiplier = 1
    local profile = if type(modifiers) == "table" then modifiers else {}
    self._nightModifiers = {
        healthMultiplier = math.clamp(tonumber(profile.healthMultiplier) or 1, 0.8, 1.3),
        speedMultiplier = math.clamp(tonumber(profile.speedMultiplier) or 1, 0.8, 1.3),
        playerDamageMultiplier = math.clamp(tonumber(profile.playerDamageMultiplier) or 1, 1, 1.2),
        lanternDamageMultiplier = math.clamp(
            tonumber(profile.lanternDamageMultiplier) or 1,
            1,
            1.25
        ),
    }
    self._nextSpawnAt = 0
    self:_notify(nil)
end

--[[
    Ena's dawn boon: the lantern's floor holds a little higher through the
    next night. Reset when that night ends -- a reserve is banked each dawn
    by a healthy seedkeeper, not owned forever.
]]
-- The active contract's risk half. Applies only to players standing in the
-- expedition, so a Deep Growth party never hardens the town night for
-- whoever stayed home.
function EnemyService.setExpeditionDamageMultiplier(self: EnemyService, multiplier: number)
    self._expeditionDamageMultiplier = math.clamp(tonumber(multiplier) or 1, 0.5, 1.5)
end

function EnemyService.grantLanternReserve(self: EnemyService, amount: number)
    self._lanternFloor = 18 + math.clamp(amount, 0, 12)
end

function EnemyService.stopNight(self: EnemyService)
    self._lanternFloor = 18
    self._nightActive = false
    self:_destroyActive()
    table.clear(self._queue)
    self._lanternHealth = 100
    self._worldService:setLanternHealth(self._lanternHealth)
    self:_clearEngineerBrace()
    self._breachMultiplier = 1
    self._nightModifiers = {
        healthMultiplier = 1,
        speedMultiplier = 1,
        playerDamageMultiplier = 1,
        lanternDamageMultiplier = 1,
    }
    self._nextSpawnAt = 0
    self:_notify(nil)
end

function EnemyService._spawnPosition(self: EnemyService, definition: any, laneId: string?): Vector3
    local origin = self._worldService:enemySpawnPosition()
    --[[
        Approach lanes: the authored spawn rotated about the lantern. The
        Meadow Gate's yaw is zero, so the default lane reproduces the
        pre-lane spawn point exactly; the flanks re-sample terrain height
        at their rotated ground.
    ]]
    local lane = if self._defenseLanes ~= nil then self._defenseLanes.get(laneId) else nil
    if lane ~= nil and lane.yaw ~= 0 then
        local center = self._worldService:lanternPosition()
        local rx, rz = self._defenseLanes.rotatedPoint(lane, origin.X, origin.Z, center.X, center.Z)
        local authoredRise = origin.Y - TerrainBuilder.surfaceHeight(origin.X, origin.Z)
        origin = Vector3.new(rx, TerrainBuilder.surfaceHeight(rx, rz) + authoredRise, rz)
    end
    if definition.stationary ~= true then
        return origin
    end
    local lantern = self._worldService:lanternPosition()
    local flatDelta = Vector3.new(lantern.X - origin.X, 0, lantern.Z - origin.Z)
    if flatDelta.Magnitude <= 1 then
        return origin
    end
    return origin + flatDelta.Unit * math.min(34, flatDelta.Magnitude * 0.45)
end

function EnemyService._spawnNow(self: EnemyService, enemyId: string, laneId: string?): boolean
    if not self._nightActive or self._active ~= nil then
        return false
    end
    local definition = self._enemyCatalog.get(enemyId)
    if definition == nil then
        self._logger:info("enemy_spawn_rejected", { enemy = enemyId, reason = "unknown_enemy" })
        return false
    end

    local origin = self:_spawnPosition(definition, laneId)
    self:_showSpawnPulse(
        origin,
        if definition.statusEffect == "spark_theft"
            then Color3.fromRGB(103, 191, 175)
            else Color3.fromRGB(255, 119, 79)
    )
    local model = self._enemyBuilder.build(
        definition,
        origin,
        if definition.targetMode == "player"
            then origin + Vector3.new(0, 0, -10)
            else self._worldService:lanternPosition()
    )
    model.Parent = workspace
    task.spawn(function()
        if model.Parent ~= nil then
            self._worldService:placeEnemyVisual(model, definition.modelKey)
        end
    end)
    self:bindStrikeClicks(model)
    local spawnedAt = workspace:GetServerTimeNow()
    local basePosition = model:GetPivot().Position
    local themedHealth =
        math.max(1, math.ceil(definition.health * self._nightModifiers.healthMultiplier))
    model:SetAttribute("EnemyHealth", themedHealth)
    model:SetAttribute("EnemyMaxHealth", themedHealth)
    model:SetAttribute("NightHealthMultiplier", self._nightModifiers.healthMultiplier)
    model:SetAttribute("NightSpeedMultiplier", self._nightModifiers.speedMultiplier)
    self._active = {
        attack = nil,
        basePosition = basePosition,
        definition = definition,
        facingPosition = if definition.targetMode == "player"
            then basePosition + Vector3.new(0, 0, -10)
            else self._worldService:lanternPosition(),
        health = themedHealth,
        lastAttackAt = spawnedAt,
        luredUntil = 0,
        markedUntil = 0,
        model = model,
        snaredUntil = 0,
        spawnedAt = spawnedAt,
        stilledUntil = 0,
    }
    self._logger:info("bramblewake_enemy_spawned", {
        enemy = definition.id,
        lane = laneId,
        queued = #self._queue,
    })
    self:_notify(string.upper(definition.displayName) .. " ENTERS THE TRAIL")
    return true
end

function EnemyService.spawn(self: EnemyService, enemyId: string?, laneId: string?): boolean
    if not self._nightActive then
        return false
    end
    local resolvedId = enemyId or "enemy_rootling"
    if self._enemyCatalog.get(resolvedId) == nil then
        self._logger:info("enemy_spawn_rejected", {
            enemy = resolvedId,
            reason = "unknown_enemy",
        })
        return false
    end
    if self._active ~= nil or workspace:GetServerTimeNow() < self._nextSpawnAt then
        table.insert(self._queue, { enemyId = resolvedId, laneId = laneId })
        self._logger:info("bramblewake_enemy_queued", {
            enemy = resolvedId,
            lane = laneId,
            position = #self._queue,
        })
        return true
    end
    return self:_spawnNow(resolvedId, laneId)
end

function EnemyService._spawnNext(self: EnemyService, now: number)
    if
        not self._nightActive
        or self._active ~= nil
        or #self._queue == 0
        or now < self._nextSpawnAt
    then
        return
    end
    local entry = table.remove(self._queue, 1)
    if entry ~= nil then
        self:_spawnNow(entry.enemyId, entry.laneId)
    end
end

-- The active enemy's flat ground position, for the defense plots' trigger
-- checks. Nil when nothing walks the lanes.
function EnemyService.activeFlatPosition(self: EnemyService): (number?, number?)
    local enemy = self._active
    if enemy == nil or not self._nightActive then
        return nil, nil
    end
    return enemy.basePosition.X, enemy.basePosition.Z
end

--[[
    A snare plot bites the active enemy: the same snaredUntil timer the
    sling's stone uses (0.75x speed, the x1.2 exposed reaction), held a
    little longer than any on-hit source can manage. Returns the enemy's
    display name for the toast, or nil if nothing was there to bite.
]]
function EnemyService.applyTrapSnare(self: EnemyService, seconds: number): string?
    local enemy = self._active
    if enemy == nil or not self._nightActive then
        return nil
    end
    enemy.snaredUntil = workspace:GetServerTimeNow() + math.clamp(seconds, 0.5, 6)
    return enemy.definition.displayName
end

--[[
    The Watch's chip damage: a resident defender softens the active enemy
    but never finishes it -- health floors at 1, so every defeat still
    belongs to a player and the defeat-attribution paths stay untouched.
]]
function EnemyService.residentChip(self: EnemyService, damage: number): boolean
    local enemy = self._active
    if enemy == nil or not self._nightActive then
        return false
    end
    local chip = math.min(math.max(1, math.floor(damage)), enemy.health - 1)
    if chip <= 0 then
        return false
    end
    enemy.health -= chip
    enemy.model:SetAttribute("EnemyHealth", math.max(0, enemy.health))
    return true
end

function EnemyService._attackGroundPosition(
    _self: EnemyService,
    enemy: Enemy,
    root: BasePart
): Vector3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { enemy.model, root.Parent :: Model }
    local result =
        workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, -14, 0), params)
    return if result == nil
        then root.Position - Vector3.new(0, 2.8, 0)
        else result.Position + Vector3.new(0, 0.12, 0)
end

function EnemyService._attackArea(self: EnemyService, enemy: Enemy, root: BasePart): CFrame
    local definition = enemy.definition
    local ground = self:_attackGroundPosition(enemy, root)
    if definition.shape == "circle" or enemy.model.PrimaryPart == nil then
        return CFrame.new(ground)
    end

    local origin = enemy.model.PrimaryPart.Position
    local flatDirection = Vector3.new(root.Position.X - origin.X, 0, root.Position.Z - origin.Z)
    if flatDirection.Magnitude < 0.01 then
        flatDirection = Vector3.new(
            enemy.model.PrimaryPart.CFrame.LookVector.X,
            0,
            enemy.model.PrimaryPart.CFrame.LookVector.Z
        )
    end
    flatDirection = flatDirection.Unit
    local length = definition.length or 0
    local center = Vector3.new(origin.X, ground.Y, origin.Z) + flatDirection * length * 0.5
    return CFrame.lookAt(center, center + flatDirection)
end

function EnemyService._createAttackVisual(
    _self: EnemyService,
    definition: any,
    areaCFrame: CFrame
): AttackVisual
    local marker = Instance.new("Part")
    marker.Name = definition.modelKey .. "AttackWarning"
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.CastShadow = false
    marker.Color = if definition.statusEffect == "drowsy"
        then Color3.fromRGB(218, 184, 86)
        elseif definition.statusEffect == "spark_theft" then Color3.fromRGB(103, 191, 175)
        else Color3.fromRGB(255, 119, 79)
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.52
    if definition.shape == "lane" then
        marker.Size = Vector3.new(definition.width or 0, 0.18, definition.length or 0)
        marker.CFrame = areaCFrame
    else
        local diameter = (definition.radius or 0) * 2
        marker.Shape = Enum.PartType.Cylinder
        marker.Size = Vector3.new(0.18, diameter, diameter)
        marker.CFrame = areaCFrame * CFrame.Angles(0, 0, math.rad(90))
    end
    marker.Parent = workspace

    local billboard = Instance.new("BillboardGui")
    --[[
        A small marker over the telegraph, not a caption across the screen.

        This card was 250 x 66 with TextScaled, so on a phone the attack name
        and its instruction were rendered enormous, overlapping themselves and
        the identical text already shown in the HUD threat banner. The banner
        is where a player reads what to do; this only has to say where the
        attack is landing, so it names the attack and leaves the instruction
        to the HUD.
    ]]
    billboard.Name = "AttackLabel"
    billboard.Adornee = marker
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 80
    billboard.Size = UDim2.fromOffset(132, 26)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 4.2, 0)
    billboard.Parent = marker

    local label = Instance.new("TextLabel")
    label.Name = "Warning"
    label.BackgroundColor3 = Color3.fromRGB(39, 25, 22)
    label.BackgroundTransparency = 0.08
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = definition.attackName
    label.TextColor3 = Color3.fromRGB(255, 236, 205)
    label.TextScaled = false
    label.TextSize = 13
    label.TextStrokeTransparency = 0.72
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local stroke = Instance.new("UIStroke")
    stroke.Color = marker.Color
    stroke.Thickness = 2
    stroke.Transparency = 0.08
    stroke.Parent = label

    return {
        label = label,
        marker = marker,
    }
end

function EnemyService._startAttack(self: EnemyService, enemy: Enemy, target: Player, now: number)
    local root = rootPart(target)
    if root == nil then
        return
    end
    local areaCFrame = self:_attackArea(enemy, root)
    enemy.facingPosition = root.Position
    enemy.attack = {
        areaCFrame = areaCFrame,
        facingPosition = root.Position,
        flow = self._enemyAttackFlow.create(target.UserId, now, enemy.definition.windup),
        target = target,
        visual = self:_createAttackVisual(enemy.definition, areaCFrame),
    }
    enemy.lastAttackAt = now
    self._logger:info("enemy_attack_telegraphed", {
        attack = enemy.definition.attackId,
        enemy = enemy.definition.id,
        player = target.UserId,
        shape = enemy.definition.shape,
        windup = enemy.definition.windup,
    })
    self:_notify(nil)
end

function EnemyService._clearPath(_self: EnemyService, enemy: Enemy, target: Player): boolean
    local character = target.Character
    local root = rootPart(target)
    local origin = enemy.model.PrimaryPart
    if root == nil or origin == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { enemy.model }
    local result = workspace:Raycast(origin.Position, root.Position - origin.Position, params)
    return result == nil or result.Instance:IsDescendantOf(character)
end

function EnemyService._insideAttack(
    self: EnemyService,
    enemy: Enemy,
    attack: Attack,
    root: BasePart
): boolean
    local localPosition = attack.areaCFrame:PointToObjectSpace(root.Position)
    return self._enemyCombatRules.contains(
        enemy.definition.shape,
        localPosition.X,
        localPosition.Z,
        enemy.definition.radius,
        enemy.definition.width,
        enemy.definition.length
    )
end

function EnemyService._stepAttack(self: EnemyService, enemy: Enemy, now: number)
    local attack = enemy.attack
    if attack == nil then
        return
    end
    local root = rootPart(attack.target)
    -- The warning marker and damage area lock when windup begins. Keep the
    -- creature's readable anticipation on that same lane even if the target
    -- moves; retargeting only the model would lie about where damage resolves
    -- and would also rotate Briarback's frontal-shield test mid-attack.
    enemy.facingPosition = attack.facingPosition
    local attackDuration = math.max(0.01, attack.flow.endsAt - attack.flow.startedAt)
    self:_poseEnemy(
        enemy,
        now,
        "attacking",
        math.clamp((now - attack.flow.startedAt) / attackDuration, 0, 1)
    )
    local resolving = now >= attack.flow.endsAt
    local decision = self._enemyAttackFlow.evaluate(attack.flow, now, {
        clearPath = not resolving or self:_clearPath(enemy, attack.target),
        inImpactArea = not resolving or (root ~= nil and self:_insideAttack(enemy, attack, root)),
        targetCanAct = self._survivalService:canAct(attack.target),
        targetPresent = attack.target.Parent ~= nil and root ~= nil,
    })
    if decision.status == "pending" then
        -- Name + countdown only. The instruction line duplicated the HUD
        -- threat banner every tick of the windup (see the comment on
        -- _createAttackVisual above) -- this marker only says where the
        -- attack is landing.
        attack.visual.label.Text = string.format(
            "%s · %.1fs",
            enemy.definition.attackName,
            math.max(0, decision.remaining or 0)
        )
        return
    end

    local target = attack.target
    local enemyId = enemy.definition.id
    self:_clearAttack(enemy)
    if decision.status == "cancel" then
        self._analyticsService:enemyAttackResult(target, decision.reason or "cancelled", enemyId)
        self:_notify(nil)
        return
    end
    if decision.status == "miss" then
        self._analyticsService:enemyAttackResult(target, decision.reason or "missed", enemyId)
        self:_notify(nil)
        return
    end
    if self._combatService:avoidsDamage(target, now) then
        self._analyticsService:enemyAttackResult(target, "dodged", enemyId)
        self:_notify(nil)
        return
    end

    local damage = math.max(
        1,
        math.ceil(
            enemy.definition.playerDamage
                * self._nightModifiers.playerDamageMultiplier
                * (
                    if target:GetAttribute("LastLightInExpedition") == true
                        then self._expeditionDamageMultiplier
                        else 1
                )
        )
    )
    local guarded = false
    if self._professionService ~= nil then
        damage, guarded = self._professionService:mitigateIncomingDamage(target, damage, now)
    end
    damage = self._combatService:mitigateShieldedDamage(target, damage, now)
    local result = self._survivalService:damage(target, damage, enemyId)
    local lanternPressure = 0
    local lanternAbsorbed = 0
    if result.applied and enemy.definition.statusEffect == "drowsy" then
        self._combatService:applyDrowsy(
            target,
            enemy.definition.statusDuration or 0,
            enemy.definition.statusMultiplier or 1
        )
    elseif result.applied and enemy.definition.statusEffect == "spark_theft" then
        -- Ambient spark theft scales with how many hands can answer it. At
        -- full rate a lone player watched the light fall 100 -> its floor in
        -- under a minute while physically unable to be everywhere; a full
        -- party keeps the authored pressure. Incident failures and direct
        -- lantern impacts stay unscaled -- those are outcomes, not weather.
        local defenders = #Players:GetPlayers()
        local partyScale = if defenders <= 1 then 0.55 elseif defenders == 2 then 0.8 else 1
        lanternPressure, lanternAbsorbed = self:_absorbLanternPressure(
            math.ceil(
                (enemy.definition.statusLanternDamage or 0)
                    * self._nightModifiers.lanternDamageMultiplier
                    * partyScale
            ),
            enemyId .. "_spark_theft",
            now
        )
        local previousLanternHealth = self._lanternHealth
        self._lanternHealth = math.max(self._lanternFloor, self._lanternHealth - lanternPressure)
        self._worldService:setLanternHealth(self._lanternHealth)
        -- Every other path that moves _lanternHealth (incident failure via
        -- applyLanternPressure, a direct lantern impact, a Last Stand spend)
        -- logs what happened. This is the one exception: a hollow crow's
        -- spark theft is the single most frequent source of lantern pressure
        -- in a night (it fires on every unblocked hit) and used to mutate
        -- the health pool completely silently, so a server log had no way to
        -- explain a lantern that crashed to its floor mid-night with no
        -- incident and no lantern-impact entries to account for it.
        self._logger:info("lantern_pressure_applied", {
            damage = previousLanternHealth - self._lanternHealth,
            health = self._lanternHealth,
            absorbed = lanternAbsorbed,
            source = string.sub(enemyId .. "_spark_theft", 1, 48),
        })
    end
    self._analyticsService:enemyAttackResult(
        target,
        if result.applied then (if guarded then "guarded_hit" else "hit") else "blocked",
        enemyId
    )
    if result.downed then
        self:_notify("ALLY DOWN — " .. enemy.definition.attackName)
    elseif guarded and result.applied then
        self:_notify("LANTERN GUARD ABSORBS " .. enemy.definition.attackName)
    elseif result.applied and enemy.definition.statusEffect == "spark_theft" then
        if lanternPressure <= 0 and lanternAbsorbed > 0 then
            self:_notify("ROOTLINE BRACE CAUGHT THE STOLEN SPARK")
        elseif lanternAbsorbed > 0 then
            self:_notify("ROOTLINE BRACE SOFTENED THE HOLLOW CROW'S SPARK THEFT")
        else
            self:_notify("HOLLOW CROW STOLE AN EXPOSED LANTERN SPARK")
        end
    else
        self:_notify(nil)
    end
end

function EnemyService._setMarkedVisual(_self: EnemyService, enemy: Enemy, marked: boolean)
    enemy.model:SetAttribute("LastLightMarked", marked)
    local highlight = enemy.model:FindFirstChild("ThreatOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        highlight.FillColor = if marked
            then Color3.fromRGB(41, 91, 74)
            else Color3.fromRGB(80, 29, 29)
        highlight.FillTransparency = if marked then 0.52 else 0.76
        highlight.OutlineColor = if marked
            then Color3.fromRGB(255, 210, 96)
            else Color3.fromRGB(255, 143, 91)
    end
end

function EnemyService._closestPlayer(self: EnemyService, enemy: Enemy): (Player?, number)
    local closestPlayer = nil
    local closestDistance = math.huge
    local primary = enemy.model.PrimaryPart
    if primary == nil then
        return nil, closestDistance
    end
    --[[
        A Beastkeeper's hound overrides proximity: while the lure holds, the
        threat hunts the keeper rather than whoever stands closest — that is
        the whole point of the ability, peeling an enemy off an ally. The
        keeper must still be a legal target (able to act, in the town fight,
        not off in the expedition) and within a sanity range, so a keeper who
        goes down or leaves hands the enemy back to normal selection instead
        of freezing it on an untouchable target.
    ]]
    local lurePlayer = self._lurePlayer
    if lurePlayer ~= nil and workspace:GetServerTimeNow() < self._lureUntil then
        local lureRoot = rootPart(lurePlayer)
        if
            lureRoot ~= nil
            and self._survivalService:canAct(lurePlayer)
            and lurePlayer:GetAttribute("LastLightTutorialSurvivalReady") == true
            and lurePlayer:GetAttribute("LastLightInExpedition") ~= true
        then
            local lureDistance = (lureRoot.Position - primary.Position).Magnitude
            if lureDistance <= 120 then
                return lurePlayer, lureDistance
            end
        end
    end
    for _, player in Players:GetPlayers() do
        local root = rootPart(player)
        if
            root ~= nil
            and self._survivalService:canAct(player)
            and player:GetAttribute("LastLightTutorialSurvivalReady") == true
            and player:GetAttribute("LastLightInExpedition") ~= true
        then
            local distance = (root.Position - primary.Position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closestPlayer = player
            end
        end
    end
    return closestPlayer, closestDistance
end

function EnemyService._lanternImpact(self: EnemyService, enemy: Enemy, now: number)
    if now - enemy.lastAttackAt < enemy.definition.attackCooldown then
        return
    end
    enemy.lastAttackAt = now
    local pressure, absorbed = self:_absorbLanternPressure(
        math.max(
            0,
            math.ceil(enemy.definition.lanternDamage * self._nightModifiers.lanternDamageMultiplier)
        ),
        enemy.definition.id .. "_lantern_impact",
        now
    )
    self._lanternHealth = math.max(0, self._lanternHealth - pressure)
    if pressure <= 0 and absorbed > 0 then
        self:_notify("ROOTLINE BRACE HOLDS THE FIRST LANTERN")
        return
    end
    if self._lanternHealth <= 0 then
        self._lanternHealth = 18
        local collapsedId = enemy.definition.id
        self:_destroyActive()
        self._nextSpawnAt = now + 2
        self._logger:info("lantern_emergency_restore", { enemy = collapsedId })
        self:_notify("THE LIGHT FLICKERS — MARA RESTORES A SPARK")
    elseif absorbed > 0 then
        self:_notify("ROOTLINE BRACE ABSORBS PART OF THE IMPACT")
    else
        self:_notify(nil)
    end
    self._worldService:setLanternHealth(self._lanternHealth)
end

function EnemyService._step(self: EnemyService, deltaTime: number)
    if not self._nightActive then
        return
    end
    local now = workspace:GetServerTimeNow()
    local enemy = self._active
    if enemy == nil then
        self:_spawnNext(now)
        return
    end
    if enemy.model.Parent == nil then
        self:_clearAttack(enemy)
        self._active = nil
        self._nextSpawnAt = now + 1
        self:_notify(nil)
        return
    end

    if enemy.markedUntil > 0 and now >= enemy.markedUntil then
        enemy.markedUntil = 0
        self:_setMarkedVisual(enemy, false)
        self:_notify(nil)
    end
    if enemy.stilledUntil > 0 and now >= enemy.stilledUntil then
        enemy.stilledUntil = 0
        self:_setStilledVisual(enemy, false)
        -- The hold may have overlapped a Scout's mark; give the outline back
        -- to whichever state is still live rather than always the plain one.
        self:_setMarkedVisual(enemy, now < enemy.markedUntil)
        self:_notify(nil)
    end
    if enemy.attack ~= nil then
        self:_stepAttack(enemy, now)
        return
    end
    -- A stilled enemy takes no action at all: no attack starts, no movement,
    -- no lantern impact. Casting the rune cancels any telegraph in flight, so
    -- reaching here with the hold active means the enemy simply stands. It
    -- can still be struck -- the hold is the Runebinder's window, not mercy.
    if now < enemy.stilledUntil then
        self:_poseEnemy(enemy, now, "idle", nil)
        return
    end

    local closestPlayer, closestDistance = self:_closestPlayer(enemy)
    if
        closestPlayer ~= nil
        and closestDistance <= enemy.definition.attackRange
        and now - enemy.lastAttackAt >= enemy.definition.attackCooldown
    then
        self:_startAttack(enemy, closestPlayer, now)
        return
    end
    if enemy.definition.stationary then
        self:_poseEnemy(enemy, now, "idle", nil)
        return
    end

    local destination = self._worldService:lanternPosition()
    if enemy.definition.targetMode == "player" and closestPlayer ~= nil then
        local targetRoot = rootPart(closestPlayer)
        if targetRoot ~= nil then
            destination = targetRoot.Position
        end
    end
    local flatTarget = Vector3.new(destination.X, enemy.basePosition.Y, destination.Z)
    local delta = flatTarget - enemy.basePosition
    local stoppingDistance = if enemy.definition.targetMode == "player"
        then enemy.definition.attackRange * 0.72
        else 10
    if delta.Magnitude > stoppingDistance then
        local speed = enemy.definition.speed
            * self._nightModifiers.speedMultiplier
            * self._breachMultiplier
        if now < enemy.markedUntil then
            speed *= 0.65
        elseif now < enemy.snaredUntil then
            -- The sling's stone: between the mark's hard slow and the
            -- hound's soft one, so the three sources read as different
            -- strengths when a party stacks them.
            speed *= 0.75
        elseif now < enemy.luredUntil then
            -- The hound harries rather than hobbles: a gentler slow than the
            -- Scout's mark, so the two kits stay distinct when stacked.
            speed *= 0.8
        end
        local distance = math.min(delta.Magnitude - stoppingDistance, speed * deltaTime)
        if distance > 0 then
            enemy.basePosition += delta.Unit * distance
            enemy.facingPosition = flatTarget
            self:_poseEnemy(enemy, now, "moving", nil)
        end
        return
    end

    enemy.facingPosition = flatTarget
    self:_poseEnemy(enemy, now, "idle", nil)

    if enemy.definition.targetMode == "lantern" then
        self:_lanternImpact(enemy, now)
    end
end

function EnemyService._enemyInRange(
    self: EnemyService,
    player: Player,
    range: number
): (Enemy?, string?)
    if not self._nightActive then
        return nil, "NO NIGHT THREAT IS ACTIVE IN DAYLIGHT"
    end
    if not self._survivalService:canAct(player) then
        return nil, "YOU CANNOT TRACK WHILE DOWNED"
    end
    local enemy = self._active
    local root = rootPart(player)
    if enemy == nil or root == nil or enemy.model.PrimaryPart == nil then
        return nil, "NO THREAT CAN BE MARKED"
    end
    if (root.Position - enemy.model.PrimaryPart.Position).Magnitude > range then
        return nil, "MOVE CLOSER TO MARK THE THREAT"
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character :: Model }
    local result =
        workspace:Raycast(root.Position, enemy.model.PrimaryPart.Position - root.Position, params)
    if result ~= nil and not result.Instance:IsDescendantOf(enemy.model) then
        return nil, "THE THREAT IS HIDDEN BEHIND COVER"
    end
    return enemy, nil
end

function EnemyService.canMarkNearest(
    self: EnemyService,
    player: Player,
    range: number
): (boolean, string)
    -- Checked before (not instead of) the town-night branch below: a normal
    -- town night and an active Old Growth/Warden Stag encounter can now run
    -- concurrently (the town cycle repeats independently of Bramblewake), so
    -- _nightActive can no longer be used to infer "no encounter is active."
    local encounterService = self:_activeEncounterService()
    if encounterService ~= nil then
        return encounterService:canMarkNearest(player, range)
    end
    local enemy, reason = self:_enemyInRange(player, range)
    if enemy == nil then
        return false, reason or "NO THREAT CAN BE MARKED"
    end
    return true, "FOXFIRE MARK READY"
end

function EnemyService.markNearest(
    self: EnemyService,
    player: Player,
    range: number,
    duration: number
): (boolean, string)
    local encounterService = self:_activeEncounterService()
    if encounterService ~= nil then
        return encounterService:markNearest(player, range, duration)
    end
    local enemy, reason = self:_enemyInRange(player, range)
    if enemy == nil then
        return false, reason or "NO THREAT CAN BE MARKED"
    end
    enemy.markedUntil = workspace:GetServerTimeNow() + duration
    self:_setMarkedVisual(enemy, true)
    local message = "FOXFIRE MARK — "
        .. string.upper(enemy.definition.displayName)
        .. " REVEALED AND SLOWED"
    self:_notify(message)
    return true, message
end

--[[
    The Beastkeeper's hound. Sending it needs the same things marking does --
    an active night threat, in range, not behind cover -- so it shares
    _enemyInRange. While the lure holds, target selection prefers the keeper
    (see _closestPlayer) and the enemy moves slightly slower.

    Deliberately not delegated to an elite/boss encounter service the way
    markNearest is: a hound can turn a night creature, not an Old Growth
    elite or the Warden Stag. During those encounters this reads as the
    ordinary no-target refusal rather than pretending a lure it cannot do.
]]
function EnemyService.canLureThreat(
    self: EnemyService,
    player: Player,
    range: number
): (boolean, string)
    local enemy, reason = self:_enemyInRange(player, range)
    if enemy == nil then
        return false, reason or "NO THREAT CAN BE LURED"
    end
    return true, "BRIAR HOUND READY"
end

function EnemyService.lureThreat(
    self: EnemyService,
    player: Player,
    range: number,
    duration: number
): (boolean, string)
    local enemy, reason = self:_enemyInRange(player, range)
    if enemy == nil then
        return false, reason or "NO THREAT CAN BE LURED"
    end
    local now = workspace:GetServerTimeNow()
    self._lurePlayer = player
    self._lureUntil = now + duration
    enemy.luredUntil = now + duration
    local message = "BRIAR HOUND — "
        .. string.upper(enemy.definition.displayName)
        .. " TURNS TO HUNT YOU"
    self:_notify(message)
    return true, message
end

function EnemyService._setStilledVisual(_self: EnemyService, enemy: Enemy, stilled: boolean)
    enemy.model:SetAttribute("LastLightStilled", stilled)
    local highlight = enemy.model:FindFirstChild("ThreatOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        if stilled then
            highlight.FillColor = Color3.fromRGB(132, 150, 224)
            highlight.FillTransparency = 0.42
            highlight.OutlineColor = Color3.fromRGB(214, 226, 255)
        else
            highlight.FillColor = Color3.fromRGB(80, 29, 29)
            highlight.FillTransparency = 0.76
            highlight.OutlineColor = Color3.fromRGB(255, 143, 91)
        end
    end
end

--[[
    The Runebinder's hold. Same target contract as the mark and the hound;
    the cast also cancels a telegraph in flight, because "held still" that
    lets the wound-up swing land anyway would read as the ability failing.
]]
function EnemyService.canStillThreat(
    self: EnemyService,
    player: Player,
    range: number
): (boolean, string)
    local enemy, reason = self:_enemyInRange(player, range)
    if enemy == nil then
        return false, reason or "NO THREAT CAN BE BOUND"
    end
    return true, "STILL RUNE READY"
end

function EnemyService.stillThreat(
    self: EnemyService,
    player: Player,
    range: number,
    duration: number
): (boolean, string)
    local enemy, reason = self:_enemyInRange(player, range)
    if enemy == nil then
        return false, reason or "NO THREAT CAN BE BOUND"
    end
    self:_clearAttack(enemy)
    enemy.stilledUntil = workspace:GetServerTimeNow() + duration
    self:_setStilledVisual(enemy, true)
    local message = "STILL RUNE — "
        .. string.upper(enemy.definition.displayName)
        .. " IS BOUND IN LIGHT"
    self:_notify(message)
    return true, message
end

function EnemyService.canRepairLantern(
    self: EnemyService,
    player: Player,
    range: number
): (boolean, string)
    if not self._nightActive then
        return false, "THE FIRST LANTERN DOES NOT NEED A NIGHT REPAIR"
    end
    if not self._survivalService:canAct(player) then
        return false, "YOU CANNOT REPAIR WHILE DOWNED"
    end
    if self._lanternHealth >= 100 then
        return false, "THE FIRST LANTERN IS ALREADY AT FULL STRENGTH"
    end
    local root = rootPart(player)
    if root == nil or (root.Position - self._worldService:lanternPosition()).Magnitude > range then
        return false, "MOVE CLOSER TO THE FIRST LANTERN"
    end
    return true, "EMERGENCY PATCH READY"
end

function EnemyService.repairLantern(
    self: EnemyService,
    player: Player,
    range: number,
    amount: number
): (boolean, string)
    local allowed, reason = self:canRepairLantern(player, range)
    if not allowed then
        return false, reason
    end
    local previous = self._lanternHealth
    self._lanternHealth = math.min(100, self._lanternHealth + amount)
    self._worldService:setLanternHealth(self._lanternHealth)
    local restored = self._lanternHealth - previous
    local now = workspace:GetServerTimeNow()
    local nextBrace, deployment = self._engineerBrace.deploy(
        self._engineerBraceState,
        now,
        self._config.EngineerBraceSeconds,
        self._config.EngineerBraceCapacity,
        player.UserId
    )
    self._engineerBraceState = nextBrace
    local braceSnapshot = self._engineerBrace.snapshot(nextBrace, now)
    self._worldService:setEngineerBrace(braceSnapshot)
    if deployment.applied then
        self._analyticsService:engineerBraceDeployed(
            player,
            deployment.capacity,
            deployment.duration,
            deployment.revision
        )
    end
    local message = string.format(
        "EMERGENCY PATCH — FIRST LANTERN +%d · ROOTLINE BRACE %d",
        restored,
        braceSnapshot.capacity
    )
    self:_notify(message)
    return true, message
end

function EnemyService.applyLanternPressure(self: EnemyService, amount: number, source: string): any
    if not self._nightActive then
        return { applied = false, reason = "night_inactive" }
    end
    if amount ~= amount or amount <= 0 or amount ~= math.floor(amount) then
        return { applied = false, reason = "invalid_amount" }
    end
    local bounded = math.clamp(amount, 1, 25)
    local now = workspace:GetServerTimeNow()
    local remaining, absorbed = self:_absorbLanternPressure(bounded, source, now)
    local previous = self._lanternHealth
    self._lanternHealth = math.max(self._lanternFloor, self._lanternHealth - remaining)
    local damage = previous - self._lanternHealth
    self._worldService:setLanternHealth(self._lanternHealth)
    self._logger:info("lantern_pressure_applied", {
        damage = damage,
        health = self._lanternHealth,
        absorbed = absorbed,
        source = string.sub(source, 1, 48),
    })
    return {
        absorbed = absorbed,
        applied = damage > 0 or absorbed > 0,
        damage = damage,
        health = self._lanternHealth,
        reason = if damage > 0
            then "applied"
            elseif absorbed > 0 then "brace_absorbed"
            else "minimum_health",
    }
end

function EnemyService.spendLanternStrength(self: EnemyService, amount: number, source: string): any
    if not self._nightActive then
        return {
            applied = false,
            health = self._lanternHealth,
            reason = "night_inactive",
            spent = 0,
        }
    end
    if amount ~= amount or amount <= 0 or amount ~= math.floor(amount) then
        return {
            applied = false,
            health = self._lanternHealth,
            reason = "invalid_amount",
            spent = 0,
        }
    end
    local previous = self._lanternHealth
    self._lanternHealth =
        math.max(self._lanternFloor, self._lanternHealth - math.clamp(amount, 1, 25))
    local spent = previous - self._lanternHealth
    self._worldService:setLanternHealth(self._lanternHealth)
    self._logger:info("lantern_strength_spent", {
        health = self._lanternHealth,
        source = string.sub(source, 1, 48),
        spent = spent,
    })
    return {
        applied = spent > 0,
        health = self._lanternHealth,
        reason = if spent > 0 then "spent" else "minimum_health",
        spent = spent,
    }
end

-- Wire every spawned enemy's ClickDetector to the strike handler. The click
-- only says which creature the player meant; damageNearest still resolves
-- range, night state, and damage on the server exactly as the button did.
function EnemyService.bindStrikeClicks(self: EnemyService, model: Model)
    -- StrikeClick is parented to the model, not the core, so a tap on any
    -- visible descendant part fires it -- not only the (often small, moving)
    -- core.
    local click = model:FindFirstChild("StrikeClick")
    if click == nil or not click:IsA("ClickDetector") then
        return
    end
    click.MouseClick:Connect(function(clicker: Player)
        local handler = self._strikeHandler
        if handler ~= nil then
            handler(clicker)
        end
    end)
end

function EnemyService.setStrikeHandler(self: EnemyService, handler: (Player) -> ())
    self._strikeHandler = handler
end

--[[
    context carries what the striker is holding -- the server-derived tool and
    weapon numbers TutorialService computed from the profile. Nil context means
    bare defaults; a client never supplies any of it.
]]
function EnemyService.damageNearest(
    self: EnemyService,
    player: Player,
    context: any
): (boolean, string)
    local encounterService = self:_activeEncounterService()
    if encounterService ~= nil then
        return encounterService:damageNearest(player)
    end
    if not self._nightActive then
        return false, "The tool is calm in daylight."
    end
    if not self._survivalService:canAct(player) then
        return false, "You cannot strike while downed."
    end

    local enemy = self._active
    local root = rootPart(player)
    if enemy == nil or root == nil or enemy.model.PrimaryPart == nil then
        return false, "No threat is close enough."
    end
    local displayName = enemy.definition.displayName
    local primary = enemy.model.PrimaryPart
    local distance = (root.Position - primary.Position).Magnitude
    local reach = enemy.definition.strikeRange
        + (if context ~= nil then context.rangeBonus or 0 else 0)
    if context ~= nil and context.weaponRange ~= nil then
        reach = math.max(reach, context.weaponRange)
    end
    if distance > reach then
        return false, "Move closer to the " .. displayName .. "."
    end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = { player.Character :: Model }
    local result = workspace:Raycast(root.Position, primary.Position - root.Position, raycastParams)
    if result ~= nil and not result.Instance:IsDescendantOf(enemy.model) then
        return false, "The " .. displayName .. " is behind cover."
    end

    local directionToPlayer = root.Position - primary.Position
    local facingDot = if directionToPlayer.Magnitude > 0.01
        then primary.CFrame.LookVector:Dot(directionToPlayer.Unit)
        else 1
    -- The strike lands: show it. The player-side swing or arrow is world
    -- presentation, so WorldService draws it; it needs the target to aim the
    -- shot, and this is the one place both ends of the strike are known.
    self._worldService:showStrikeFeedback(player, context, primary.Position)
    local reactionNow = workspace:GetServerTimeNow()
    local strikerStatus = self._combatService:snapshot(player)
    local damage, strikeResult, reactionLabel =
        self._enemyCombatRules.strikeDamage(enemy.definition, facingDot, {
            stilled = reactionNow < enemy.stilledUntil,
            snared = reactionNow < enemy.snaredUntil,
            drowsyStriker = strikerStatus ~= nil and strikerStatus.drowsy == true,
        })
    if context ~= nil and type(context.damageMultiplier) == "number" then
        -- Tool identity, bounded: the axe's edge and the bow's reach trade
        -- against each other, and neither can silence an enemy's mechanics.
        damage = math.floor(damage * math.clamp(context.damageMultiplier, 0.5, 1.5) + 0.5)
    end
    enemy.health -= damage
    enemy.model:SetAttribute("EnemyHealth", math.max(0, enemy.health))
    self:_showDamageFeedback(enemy, damage, strikeResult)
    --[[
        Weapon-family riders, bounded and applied only on a landed hit: the
        sling's stone snares the enemy briefly (0.75x speed, weaker than
        the Scout's mark), and the edge returns a sliver of stamina to its
        wielder through the same restore path items use. The numbers arrive
        from Equipment's own definitions -- a client never submits either.
    ]]
    if context ~= nil then
        local snareSeconds = tonumber(context.onHitSnareSeconds)
        if snareSeconds ~= nil and snareSeconds > 0 then
            enemy.snaredUntil = workspace:GetServerTimeNow() + math.clamp(snareSeconds, 0.5, 4)
        end
        local staminaRefund = tonumber(context.onHitStaminaRefund)
        if staminaRefund ~= nil and staminaRefund > 0 and self._combatService ~= nil then
            self._combatService:restoreStamina(player, math.clamp(staminaRefund, 1, 12))
        end
    end
    if enemy.health <= 0 then
        local defeatedId = enemy.definition.id
        self:_defeatActive(enemy)
        self._nextSpawnAt = workspace:GetServerTimeNow() + 1.25
        self._logger:info("bramblewake_enemy_defeated", {
            enemy = defeatedId,
            player = player.UserId,
            strikeResult = strikeResult,
        })
        self:_notify(string.upper(displayName) .. " DRIVEN BACK")
        return true, displayName .. " driven back!"
    end

    local remaining = tostring(math.max(0, math.ceil(enemy.health)))
    if strikeResult == "shielded" then
        self:_notify("SHIELD BLOCKED MOST OF THE HIT — FLANK THE BRIARBACK")
        return true, "The front shield absorbs most of the strike. Flank it."
    elseif strikeResult == "flanked" then
        self:_notify("FLANK HIT — " .. string.upper(displayName) .. " " .. remaining)
        return true, "Clean flank hit."
    end
    if reactionLabel ~= nil then
        self:_notify(reactionLabel .. " — " .. string.upper(displayName) .. " " .. remaining)
        return true, reactionLabel
    end
    self:_notify("HIT — " .. string.upper(displayName) .. " " .. remaining)
    return true, "Your tool strikes the " .. displayName .. "."
end

function EnemyService.threatSnapshot(self: EnemyService, viewer: Player): any
    local enemy = self._active
    local attack = if enemy == nil then nil else enemy.attack
    if enemy == nil or attack == nil or attack.target ~= viewer then
        local encounterService = self:_activeEncounterService()
        return if encounterService == nil then nil else encounterService:threatSnapshot(viewer)
    end
    return {
        attackId = enemy.definition.attackId,
        displayName = enemy.definition.attackName,
        enemyName = string.upper(enemy.definition.displayName),
        enemyId = enemy.definition.id,
        instruction = enemy.definition.instruction,
        resolvesAt = attack.flow.endsAt,
        shape = enemy.definition.shape,
    }
end

function EnemyService.setBreach(self: EnemyService)
    self._breachMultiplier = 1.35
    self:_notify("THE ROOTS SURGE — HOLD THE LIGHT")
end

--[[
    Put strength back into the lantern.

    Everything in this game takes from the lantern -- the spark thieves
    steal it outright, the nights grind it down, the last stand spends it
    -- and until now nothing a player could carry put any back. The
    ceiling is the same 100 the night starts at, so this is a way to
    recover a bad night rather than a way to bank a good one, and it does
    nothing outside a night for the same reason pressure does.
]]
function EnemyService.restoreLanternStrength(
    self: EnemyService,
    amount: number,
    source: string
): any
    if not self._nightActive then
        return { applied = false, health = self._lanternHealth, reason = "night_inactive" }
    end
    if amount ~= amount or amount <= 0 or amount ~= math.floor(amount) then
        return { applied = false, health = self._lanternHealth, reason = "invalid_amount" }
    end
    if self._lanternHealth >= LANTERN_CEILING then
        return { applied = false, health = self._lanternHealth, reason = "lantern_full" }
    end
    local bounded = math.clamp(amount, 1, 40)
    local previous = self._lanternHealth
    self._lanternHealth = math.min(LANTERN_CEILING, self._lanternHealth + bounded)
    local restored = self._lanternHealth - previous
    self._logger:info("lantern_restored", {
        health = self._lanternHealth,
        restored = restored,
        source = source,
    })
    return {
        applied = restored > 0,
        health = self._lanternHealth,
        restored = restored,
        reason = "restored",
    }
end

function EnemyService.lanternFull(self: EnemyService): boolean
    return self._lanternHealth >= LANTERN_CEILING
end

function EnemyService.lanternHealth(self: EnemyService): number
    return self._lanternHealth
end

function EnemyService.activeCount(self: EnemyService): number
    return if self._active == nil then 0 else 1
end

function EnemyService.combatActive(self: EnemyService): boolean
    return (self._nightActive and self._active ~= nil) or self:_activeEncounterService() ~= nil
end

return table.freeze(EnemyService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">ExpeditionService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local ExpeditionService = {}
ExpeditionService.__index = ExpeditionService
ExpeditionService.Name = "ExpeditionService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type ExpeditionService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _generator: any,
        _regionAccess: any,
        _catalog: any,
        _featureFlags: any,
        _eventFlow: any,
        _rewardLedger: any,
        _extractionPayoff: any,
        _profileService: any,
        _analyticsService: any,
        _seed: number,
        _regionId: string,
        _rebuilding: boolean,
        _manifest: any,
        _partCount: number,
        _eventStates: { [string]: any },
        _rewardLedgerState: any,
        _eventsEnabled: boolean,
        _runId: string,
        _pendingExtractionPayoffs: { [Player]: any },
    },
    ExpeditionService
))

function ExpeditionService.new(
    logger: Logger,
    worldService: any,
    generator: any,
    regionAccess: any,
    catalog: any,
    featureFlags: any,
    eventFlow: any,
    rewardLedger: any,
    extractionPayoff: any,
    profileService: any,
    analyticsService: any,
    seed: number,
    contracts: any
): ExpeditionService
    return setmetatable({
        Name = ExpeditionService.Name,
        _logger = logger,
        _contracts = contracts,
        _enemyService = nil,
        _contract = contracts.default(),
        _worldService = worldService,
        _generator = generator,
        _regionAccess = regionAccess,
        _catalog = catalog,
        _featureFlags = featureFlags,
        _eventFlow = eventFlow,
        _rewardLedger = rewardLedger,
        _extractionPayoff = extractionPayoff,
        _profileService = profileService,
        _analyticsService = analyticsService,
        _seed = seed,
        _regionId = "region_bramblewake",
        _rebuilding = false,
        _manifest = nil,
        _partCount = 0,
        _eventStates = {},
        _rewardLedgerState = rewardLedger.create(),
        _eventsEnabled = false,
        _runId = "",
        _pendingExtractionPayoffs = {},
    }, ExpeditionService)
end

function ExpeditionService.Init(self: ExpeditionService, _context: any)
    local jobId = game.JobId
    self._runId = if jobId ~= ""
        then jobId
        else string.format("studio_%d_%d", os.time(), math.floor(os.clock() * 1000))
    self._contract = self._contracts.default()
    local requestedSeed = game:GetAttribute("LastLightExpeditionSeed")
    -- Seed history, the boot half: with a thirty-module pool the same base
    -- seed forever would make every server walk one layout. The UTC day
    -- salts the default so consecutive days field different woods, while an
    -- explicit LastLightExpeditionSeed attribute still pins a build exactly
    -- (Studio tests and repro sessions depend on that).
    local daySalt = (tonumber(os.date("!%j")) or 0) * 131 + (tonumber(os.date("!%Y")) or 0)
    local seed = if type(requestedSeed) == "number" then requestedSeed else self._seed + daySalt
    --[[
        Which region this server walks. RegionAccess resolves the request
        (a Studio attribute for tests; a departure choice once more than
        one region is buildable) against the region registry's enabled
        flags and the story's chapters, and everything that is not an
        open region resolves to Bramblewake. The builder below is still
        Bramblewake's own, so the assert is load-bearing: if a region is
        ever enabled before its builder exists, this fails at boot in
        plain words instead of building a forest where a mine should be.
    ]]
    local requestedRegion = game:GetAttribute("LastLightExpeditionRegion")
    local regionId = self._regionAccess.destinationFor(requestedRegion, nil)
    local catalog = self._generator.catalogFor(regionId)
    assert(
        regionId == "region_bramblewake",
        "region " .. tostring(regionId) .. " is enabled but has no builder wired"
    )
    self._catalog = catalog
    self._regionId = regionId
    self:_buildRegion(seed)
end

--[[
    Roll a seed into a walkable wood and stand it up.

    Split out of Init because a private server's owner can ask for a different
    one at runtime, and the alternative -- a second copy of this sequence in the
    rebuild path -- is how a manifest gets built without its event states, or
    dressed without its fallback metric. `BramblewakeBuilder.build` already
    destroys whatever it finds before it builds, which is what makes calling
    this twice safe rather than merely possible.
]]
function ExpeditionService._buildRegion(self: ExpeditionService, seed: number)
    local regionId = self._regionId
    local manifest = self._generator.generate(seed, false, nil, regionId)
    local valid, issues = self._generator.validate(manifest)
    assert(valid, "expedition manifest is invalid: " .. table.concat(issues, "; "))

    --[[
        A seed that could not produce a walkable manifest, said out loud.

        The generator already handles this correctly -- it hands back the
        known-good walk rather than a broken world -- and that is exactly why
        it needed an emitter: the recovery is silent, so without this the
        fallback rate threshold in RELEASE_GATES.md reads zero whether the
        generator is perfect or broken. Nobody in a live session would notice
        either, because both look like an expedition.
    ]]
    -- GATE-METRIC: generator_fallback
    if manifest.source ~= "generated" then
        self._analyticsService:generatorFallback(regionId, manifest.seed, manifest.source)
    end

    local result = self._worldService:buildBramblewake(manifest, self._generator, self._catalog)
    self._manifest = manifest
    self._partCount = result.partCount
    self._eventsEnabled = self._featureFlags:isEnabled("bramblewake_events_enabled")
    self._worldService:setExpeditionEventsEnabled(self._eventsEnabled)
    self._eventStates = {}
    for _, placement in manifest.modules do
        if placement.eventId ~= nil then
            local definition = self._generator.eventDefinition(placement.eventId)
            local state =
                self._eventFlow.create(definition, self._runId, manifest.hash, self._eventsEnabled)
            self._eventStates[placement.eventId] = state
            self._worldService:setExpeditionEventState(placement.eventId, state)
        end
    end
end

--[[
    Walk a different seed, in a server that has already given up on rewards.

    Refused while anybody is inside, and that refusal is the whole safety
    argument: rebuilding the wood destroys the model the people in it are
    standing on. Refused too when the seed is one this build cannot resolve, so
    a history entry from an older catalog fails here rather than half-way
    through a rebuild.
]]
function ExpeditionService.rebuildWithSeed(self: ExpeditionService, seed: any): (boolean, string)
    local numericSeed = tonumber(seed)
    if numericSeed == nil then
        return false, "invalid_seed"
    end
    if self:occupied() then
        return false, "expedition_occupied"
    end
    --[[
        The flag, and it is the whole safety argument rather than bookkeeping.

        `_buildRegion` yields -- the generator and the world builder both run
        across frames -- so the check above and the finished wood are not the
        same moment. Without this, `enter` can admit somebody in between and
        put them on a model that is about to be destroyed under them, which is
        precisely the failure the refusal exists to prevent, arrived at through
        the door the refusal is guarding.
    ]]
    self._rebuilding = true
    local ok, err = pcall(function()
        self:_buildRegion(numericSeed)
    end)
    self._rebuilding = false
    if not ok then
        self._logger:warn("expedition_rebuild_failed", { reason = tostring(err) })
        return false, "invalid_seed"
    end
    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    self._logger:warn("expedition_rebuilt", {
        hash = manifest.hash,
        seed = manifest.seed,
        source = manifest.source,
    })
    return true, "rebuilt"
end

function ExpeditionService.currentSeed(self: ExpeditionService): (string, number)
    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    return self._regionId, manifest.seed
end

function ExpeditionService.Start(self: ExpeditionService)
    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    self._logger:info("expedition_ready", {
        events = self._catalog.EventCount,
        eventInteractions = self._catalog.EventInteractionCount,
        eventsEnabled = self._eventsEnabled,
        hash = manifest.hash,
        modules = #manifest.modules,
        parts = self._partCount,
        pois = self._catalog.PointOfInterestCount,
        runId = self._runId,
        seed = manifest.seed,
        source = manifest.source,
    })
    local function bindPlayer(player: Player)
        player.CharacterAdded:Connect(function(character: Model)
            task.defer(function()
                local root = character:WaitForChild("HumanoidRootPart", 5)
                if
                    root ~= nil
                    and player.Parent ~= nil
                    and player.Character == character
                    and player:GetAttribute("LastLightInExpedition") ~= true
                then
                    self:_deliverPendingPayoff(player)
                end
            end)
        end)
    end
    Players.PlayerAdded:Connect(bindPlayer)
    for _, player in Players:GetPlayers() do
        bindPlayer(player)
    end
    Players.PlayerRemoving:Connect(function(player: Player)
        self._pendingExtractionPayoffs[player] = nil
        self._worldService:clearRecoveryCache(player)
    end)
end

-- Whether anybody is standing in the wood. Read by the rebuild and by the
-- control that asks for one, so the refusal a player is shown and the refusal
-- the service enforces are the same question rather than two copies of it.
function ExpeditionService.occupied(_self: ExpeditionService): boolean
    for _, player in Players:GetPlayers() do
        if player:GetAttribute("LastLightInExpedition") == true then
            return true
        end
    end
    return false
end

function ExpeditionService.enter(self: ExpeditionService, player: Player): boolean
    if self._rebuilding then
        -- The wood is being torn down and stood up again. Admitting somebody
        -- now would drop them onto a model that is about to be destroyed.
        return false
    end
    local entered = self._worldService:enterBramblewake(player)
    if entered then
        --[[
            A seed is discovered by being walked, not by being rolled.

            Recorded here rather than at departure because a run somebody never
            reached is a layout they have never seen, and "among already
            discovered seeds" is the only bound private-server seed selection
            has. A practice server records nothing, which is correct twice
            over: the profile is read-only there anyway, and a seed handed to
            you by a control is not one you found.
        ]]
        local manifest = self._manifest
        if manifest ~= nil then
            self._profileService:recordDiscoveredSeed(player, self._regionId, manifest.seed)
        end
        local cache = self._profileService:recoveryCache(player)
        if cache ~= nil then
            self._worldService:showRecoveryCache(player, cache)
        end
    end
    return entered
end

function ExpeditionService.failExpedition(self: ExpeditionService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return { accepted = false, message = nil, reason = "player_not_in_expedition" }
    end
    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    local sessionPending = self._rewardLedger.pending(self._rewardLedgerState, player.UserId)
    local result = self._profileService:cacheExpeditionFailure(
        player,
        self._runId,
        manifest.hash,
        sessionPending.rewards
    )
    self._worldService:clearRecoveryCache(player)
    if result.cached and result.cacheId ~= nil then
        self._logger:info("expedition_recovery_cache_created", {
            cache = result.cacheId,
            player = player.UserId,
            retained = result.retained,
        })
        return {
            accepted = result.accepted,
            cacheId = result.cacheId,
            message = "SAFE RETREAT — HALF THE POUCH WAITS IN A LOST SATCHEL",
            reason = result.reason,
        }
    end
    return {
        accepted = result.accepted,
        message = if result.accepted
            then "SAFE RETREAT — SMALL POUCH RETAINED"
            else "SAFE RETREAT — POUCH RETAINED WHILE PROFILE RECOVERS",
        reason = result.reason,
    }
end

function ExpeditionService.recoverCache(
    self: ExpeditionService,
    player: Player,
    prompt: ProximityPrompt
): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return { accepted = false, message = "ENTER BRAMBLEWAKE TO RECOVER THE SATCHEL" }
    end
    if prompt:GetAttribute("OwnerUserId") ~= player.UserId then
        return { accepted = false, message = "THAT LOST SATCHEL BELONGS TO ANOTHER TRAVELER" }
    end
    local cacheId = prompt:GetAttribute("Payload")
    if type(cacheId) ~= "string" then
        return { accepted = false, message = "THAT RECOVERY MARK IS INVALID" }
    end
    local result = self._profileService:recoverExpeditionCache(player, cacheId)
    if not result.accepted then
        return {
            accepted = false,
            message = if result.reason == "save_pending"
                then "SATCHEL RECOVERY WILL RETRY WHEN YOUR PROFILE IS READY"
                else "THAT SATCHEL HAS ALREADY BEEN RECOVERED",
            reason = result.reason,
        }
    end
    self._worldService:clearRecoveryCache(player)
    local amount = 0
    for _, count in result.materials do
        amount += count
    end
    self._logger:info("expedition_recovery_cache_claimed", {
        amount = amount,
        cache = cacheId,
        player = player.UserId,
    })
    return {
        accepted = true,
        message = string.format("LOST SATCHEL RECOVERED — %d MATERIALS BACK IN POUCH", amount),
        reason = "recovered",
    }
end

function ExpeditionService._participantCount(_self: ExpeditionService, state: any): number
    local count = 0
    for _ in state.participants do
        count += 1
    end
    return count
end

function ExpeditionService._refreshExpired(self: ExpeditionService, now: number)
    for eventId, state in self._eventStates do
        local definition = self._generator.eventDefinition(eventId)
        if self._eventFlow.expire(state, definition, now) then
            self._worldService:setExpeditionEventState(eventId, state)
            self._analyticsService:expeditionEventFailed(
                eventId,
                state.manifestHash,
                self:_participantCount(state)
            )
        end
    end
end

function ExpeditionService._grant(
    self: ExpeditionService,
    userId: number,
    transactionId: string,
    manifestHash: string,
    reward: any,
    sourceKind: string,
    sourceId: string
): boolean
    local granted = self._rewardLedger.grant(
        self._rewardLedgerState,
        userId,
        transactionId,
        manifestHash,
        reward
    )
    if not granted then
        return false
    end
    local sourceField = if sourceKind == "event" then "event" else "encounter"
    local grantedFields: { [string]: any } = {
        amount = reward.amount,
        material = reward.materialId,
        transaction = transactionId,
        userId = userId,
    }
    grantedFields[sourceField] = sourceId
    self._logger:info("expedition_" .. sourceKind .. "_reward_granted", grantedFields)
    local player = Players:GetPlayerByUserId(userId)
    if player ~= nil then
        -- The active contract's trade lands here, at the single point every
        -- expedition reward passes through. The transaction id is untouched,
        -- so idempotency and replay behave exactly as before.
        local contracted = table.clone(reward)
        contracted.amount = self._contracts.applyReward(self._contract, reward.amount)
        local profileResult = self._profileService:grantUnbankedExpeditionReward(
            player,
            transactionId,
            manifestHash,
            contracted
        )
        local persistedFields: { [string]: any } = {
            durable = profileResult.durable == true,
            player = userId,
            transaction = transactionId,
        }
        persistedFields[sourceField] = sourceId
        self._logger:info("expedition_" .. sourceKind .. "_reward_persisted", persistedFields)
    end
    return true
end

function ExpeditionService._grantReward(
    self: ExpeditionService,
    userId: number,
    state: any,
    definition: any
): boolean
    local transactionId = state.rewardTransactionId
    if type(transactionId) ~= "string" then
        return false
    end
    return self:_grant(
        userId,
        transactionId,
        state.manifestHash,
        definition.reward,
        "event",
        definition.id
    )
end

--[[
    Grant a harvested resource node.

    Nodes are the reason to walk the route at all, so they go through the same
    idempotent grant path as events and encounters: one transaction per node
    per run, recorded against the run's manifest, so a node cannot be farmed by
    re-clicking it or by a duplicated remote.
]]
function ExpeditionService.grantNodeReward(
    self: ExpeditionService,
    userId: number,
    nodeId: string,
    reward: any
): boolean
    if type(nodeId) ~= "string" or string.sub(nodeId, 1, 5) ~= "node_" then
        self._logger:warn("expedition_node_reward_rejected", {
            node = nodeId,
            reason = "invalid_node_id",
            userId = userId,
        })
        return false
    end
    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    -- The node's own ID is the transaction, so harvesting is exactly-once for
    -- the life of the run regardless of how many times it is asked for.
    return self:_grant(userId, nodeId, manifest.hash, reward, "node", nodeId)
end

function ExpeditionService.grantEncounterReward(
    self: ExpeditionService,
    userId: number,
    encounterId: string,
    transactionId: string,
    reward: any
): boolean
    local validEncounter = string.sub(encounterId, 1, 6) == "elite_"
        or string.sub(encounterId, 1, 5) == "boss_"
    if not validEncounter then
        self._logger:warn("expedition_encounter_reward_rejected", {
            encounter = encounterId,
            reason = "invalid_encounter_id",
            userId = userId,
        })
        return false
    end
    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    return self:_grant(userId, transactionId, manifest.hash, reward, "encounter", encounterId)
end

function ExpeditionService.interact(
    self: ExpeditionService,
    player: Player,
    prompt: ProximityPrompt
): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return {
            accepted = false,
            message = "ENTER BRAMBLEWAKE TO ANSWER THIS EVENT",
            reason = "player_not_in_expedition",
        }
    end

    local eventId = prompt:GetAttribute("EventId")
    local stepId = prompt:GetAttribute("EventStepId")
    if type(eventId) ~= "string" or type(stepId) ~= "string" then
        return {
            accepted = false,
            message = "THAT EVENT MARK IS INVALID",
            reason = "invalid_prompt_contract",
        }
    end
    local state = self._eventStates[eventId]
    local definition = self._generator.eventDefinition(eventId)
    if state == nil or definition == nil then
        return {
            accepted = false,
            message = "THAT EVENT IS NO LONGER AVAILABLE",
            reason = "unknown_event",
        }
    end

    local result =
        self._eventFlow.contribute(state, definition, stepId, tostring(player.UserId), os.clock())
    if result.changed then
        self._worldService:setExpeditionEventState(eventId, state)
    end
    if result.started then
        self._analyticsService:expeditionEventStarted(player, definition, state.manifestHash)
    end
    if result.completed then
        for participantId in state.participants do
            local userId = tonumber(participantId)
            if userId ~= nil then
                self:_grantReward(userId, state, definition)
            end
        end
        self._analyticsService:expeditionEventCompleted(
            player,
            definition,
            state.manifestHash,
            state.rewardTransactionId,
            self:_participantCount(state)
        )
    end

    if result.completed then
        result.message = definition.completionMessage
    elseif result.duplicate then
        result.message = "THAT EVENT MARK IS ALREADY SET"
    elseif result.failed or result.reason == "event_failed" or result.reason == "event_expired" then
        result.message = definition.failureMessage
    elseif result.accepted then
        result.message = string.format(
            "%s — %d/%d",
            string.upper(definition.displayName),
            state.progress,
            state.total
        )
    elseif result.reason == "event_disabled" then
        result.message = "THIS EVENT IS TEMPORARILY DORMANT"
    else
        result.message = "THAT EVENT ACTION WAS REJECTED"
    end

    if not result.accepted then
        self._logger:warn("expedition_event_interaction_rejected", {
            event = eventId,
            player = player.UserId,
            reason = result.reason,
            step = stepId,
        })
    end
    return result
end

function ExpeditionService._combinedPending(self: ExpeditionService, player: Player): any
    local sessionPending = self._rewardLedger.pending(self._rewardLedgerState, player.UserId)
    local profileInventory = self._profileService:inventorySnapshot(player)
    local materials: { [string]: number } = {}
    local rewards = {}
    local seen: { [string]: boolean } = {}
    for _, transactionId in profileInventory.cachedTransactionIds do
        seen[transactionId] = true
    end
    for _, reward in profileInventory.pendingRewards do
        seen[reward.transactionId] = true
        materials[reward.materialId] = (materials[reward.materialId] or 0) + reward.amount
        table.insert(rewards, reward)
    end
    for _, reward in sessionPending.rewards do
        if not seen[reward.transactionId] then
            seen[reward.transactionId] = true
            materials[reward.materialId] = (materials[reward.materialId] or 0) + reward.amount
            table.insert(rewards, reward)
        end
    end
    table.sort(rewards, function(left: any, right: any): boolean
        return left.transactionId < right.transactionId
    end)
    return {
        banked = profileInventory.banked,
        materials = materials,
        recovery = profileInventory.recovery,
        rewards = rewards,
    }
end

--[[
    The departing party names its contract; the server resolves it safely
    (unknown ids become the standard sweep) and everything downstream reads
    the resolved contract, never the requested id.
]]
function ExpeditionService.bindEnemyService(self: ExpeditionService, enemyService: any)
    -- Late-bound: EnemyService is constructed after this service in the
    -- bootstrap, and the contract multiplier is the only thing crossing.
    self._enemyService = enemyService
end

function ExpeditionService.setContract(self: ExpeditionService, contractId: any)
    self._contract = self._contracts.resolve(contractId)
    if self._enemyService ~= nil then
        self._enemyService:setExpeditionDamageMultiplier(self._contract.enemyDamageMultiplier)
    end
    self._logger:info("expedition_contract_set", { contract = self._contract.id })
end

function ExpeditionService.contractSnapshot(self: ExpeditionService): any
    return {
        id = self._contract.id,
        title = self._contract.title,
        detail = self._contract.detail,
        rewardMultiplier = self._contract.rewardMultiplier,
        enemyDamageMultiplier = self._contract.enemyDamageMultiplier,
        weather = self._contract.weather,
    }
end

function ExpeditionService._deliverPendingPayoff(self: ExpeditionService, player: Player): boolean
    local payoff = self._extractionPayoff.claim(self._pendingExtractionPayoffs, player)
    if payoff == nil then
        return false
    end
    self._worldService:showExtractionPayoff(player, payoff.materials, payoff.overflow)
    return true
end

function ExpeditionService._exitWithPayoff(self: ExpeditionService, player: Player): boolean
    self._worldService:clearRecoveryCache(player)
    return self._worldService:exitBramblewake(player, function()
        self:_deliverPendingPayoff(player)
    end)
end

function ExpeditionService.extract(self: ExpeditionService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return {
            accepted = false,
            message = "YOU ARE NOT INSIDE BRAMBLEWAKE",
            reason = "player_not_in_expedition",
        }
    end

    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    local sessionPending = self._rewardLedger.pending(self._rewardLedgerState, player.UserId)
    local combinedPending = self:_combinedPending(player)
    if #combinedPending.rewards == 0 then
        local pendingPayoff = self._pendingExtractionPayoffs[player]
        if not self:_exitWithPayoff(player) then
            return {
                accepted = false,
                message = if pendingPayoff ~= nil
                    then "REWARDS BANKED — WAYHOME TRANSITION WILL RETRY"
                    else "WAYHOME TRANSITION WILL RETRY",
                reason = "transition_unavailable",
            }
        end
        self._analyticsService:expeditionExtracted(player, manifest.hash, nil, 0)
        return {
            accepted = true,
            banked = combinedPending.banked,
            message = if pendingPayoff ~= nil
                then "RETURNING TO EMBERHOLLOW — BANKED DELIVERY READY"
                else "RETURNING TO EMBERHOLLOW — POUCH EMPTY",
            settlementId = if pendingPayoff ~= nil then pendingPayoff.settlementId else nil,
        }
    end

    local settlement = self._profileService:settleExpedition(
        player,
        self._runId,
        manifest.hash,
        sessionPending.rewards
    )
    if not settlement.accepted then
        self._analyticsService:expeditionExtractionFailed(player, manifest.hash, settlement.reason)
        return {
            accepted = false,
            message = if settlement.reason == "profile_read_only"
                then "PROFILE OFFLINE — REWARDS REMAIN UNBANKED"
                elseif
                    settlement.reason == "save_pending"
                then "BANKING RETRY NEEDED — REWARDS REMAIN UNBANKED"
                else "WAYHOME GATE IS WAITING FOR YOUR PROFILE",
            reason = settlement.reason,
        }
    end

    if settlement.settlementId ~= nil then
        self._rewardLedger.settle(
            self._rewardLedgerState,
            player.UserId,
            settlement.settlementId,
            sessionPending.transactionIds
        )
    end
    -- Overflow rides the payoff so whoever announces the banked delivery can
    -- also say the stores were full -- one moment, one message stream.
    self._pendingExtractionPayoffs[player] = {
        materials = settlement.materials or {},
        overflow = settlement.overflow,
        settlementId = settlement.settlementId,
    }
    if not self:_exitWithPayoff(player) then
        return {
            accepted = false,
            message = "REWARDS BANKED — WAYHOME TRANSITION WILL RETRY",
            reason = "transition_unavailable",
        }
    end

    local bankedAmount = 0
    for _, amount in settlement.materials or {} do
        bankedAmount += amount
    end
    self._analyticsService:expeditionExtracted(
        player,
        manifest.hash,
        settlement.settlementId,
        bankedAmount
    )
    return {
        accepted = true,
        banked = settlement.inventory,
        message = if settlement.empty
            then "RETURNING TO EMBERHOLLOW — POUCH EMPTY"
            else string.format("WAYHOME — %d MATERIALS BANKED", bankedAmount),
        settlementId = settlement.settlementId,
    }
end

function ExpeditionService.snapshot(self: ExpeditionService, player: Player): any
    self:_refreshExpired(os.clock())
    local snapshot = self._worldService:expeditionSnapshot(player)
    local inventory = self:_combinedPending(player)
    snapshot.unbankedRewards = inventory.materials
    snapshot.bankedMaterials = inventory.banked
    snapshot.recoveryCache = inventory.recovery
    if not snapshot.active then
        return snapshot
    end

    local moduleDefinition = self._generator.moduleDefinition(snapshot.moduleId)
    local poiDefinition = if snapshot.poiId == nil
        then nil
        else self._generator.pointOfInterestDefinition(snapshot.poiId)
    local eventDefinition = if snapshot.eventId == nil
        then nil
        else self._generator.eventDefinition(snapshot.eventId)
    snapshot.moduleName = moduleDefinition.displayName
    snapshot.pointOfInterestName = if poiDefinition == nil then nil else poiDefinition.displayName
    -- Carried so the point of interest can say something specific to itself.
    -- Without it every landmark on the route shares one generic line, which
    -- is indistinguishable from having no landmark there at all.
    snapshot.pointOfInterestDetail = if poiDefinition == nil then nil else poiDefinition.detail
    snapshot.eventName = if eventDefinition == nil then nil else eventDefinition.displayName
    if eventDefinition ~= nil then
        local state = self._eventStates[snapshot.eventId]
        if state ~= nil then
            snapshot.event = self._eventFlow.snapshot(state, eventDefinition, os.clock())
            snapshot.eventRevision = state.revision
        end
    end
    return snapshot
end

function ExpeditionService.manifest(self: ExpeditionService): any
    return self._manifest
end

function ExpeditionService.runId(self: ExpeditionService): string
    return self._runId
end

return table.freeze(ExpeditionService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">FeatureFlagService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    The switches, and who each one has reached.

    Two questions live here and they are not the same one. "Is this feature
    built and turned on" is global and has been since Milestone 1. "Has this
    feature reached this player" is Milestone 13's staged rollout, and it has
    no global answer at all -- which is why a cohort-scoped flag read without
    a player throws rather than defaulting. `RolloutCohorts` explains why both
    defaults are wrong; the short version is that one of them ships an
    unreleased feature to everybody and the other hides it from the only
    people it was turned on for, and neither says anything on the way past.

    A local override still wins over both, because an override is a developer
    holding the switch by hand in an environment where that is allowed, and it
    is refused outright in production.
]]

local FeatureFlagService = {}
FeatureFlagService.__index = FeatureFlagService
FeatureFlagService.Name = "FeatureFlagService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type FeatureFlagService = typeof(setmetatable(
    {} :: {
        Name: string,
        _defaults: { [string]: boolean },
        _overrides: { [string]: boolean },
        _allowOverrides: boolean,
        _logger: Logger,
        _rollouts: { [string]: any },
        _roster: any,
        _cohorts: any,
    },
    FeatureFlagService
))

function FeatureFlagService.new(
    defaults: { [string]: boolean },
    allowOverrides: boolean,
    logger: Logger,
    rolloutCohorts: any,
    rollouts: { [string]: any },
    roster: any
): FeatureFlagService
    return setmetatable({
        Name = FeatureFlagService.Name,
        _defaults = table.clone(defaults),
        _overrides = {},
        _allowOverrides = allowOverrides,
        _logger = logger,
        _cohorts = rolloutCohorts,
        _rollouts = rollouts,
        _roster = roster,
    }, FeatureFlagService)
end

function FeatureFlagService.Init(self: FeatureFlagService, _context: any)
    self._logger:info("feature_flags_initialized", {
        count = self:count(),
        overridesAllowed = self._allowOverrides,
        scoped = self:scopedCount(),
    })
end

function FeatureFlagService.Start(self: FeatureFlagService)
    self._logger:info("feature_flags_started")
end

function FeatureFlagService.rollout(self: FeatureFlagService, flag: string): any
    local rollout = self._rollouts[flag]
    assert(rollout ~= nil, string.format("feature flag %q has no rollout stage", flag))
    return rollout
end

--[[
    Whether this player has the flag.

    `userId` is optional in the signature and required in fact for every flag
    that is mid-rollout, which is the only shape that lets the twenty-odd
    existing global call sites go on asking globally and still fails the one
    that asks about a flag which has since acquired a cohort.
]]
function FeatureFlagService.isEnabled(
    self: FeatureFlagService,
    flag: string,
    userId: number?
): boolean
    local override = self._overrides[flag]
    if override ~= nil then
        return override
    end

    local value = self._defaults[flag]
    assert(value ~= nil, string.format("unknown feature flag %q", flag))

    local rollout = self:rollout(flag)
    if not self._cohorts.isScoped(rollout.stage) then
        return value
    end

    assert(
        userId ~= nil,
        string.format(
            "feature flag %q is at rollout stage %q and was read without a player",
            flag,
            tostring(rollout.stage)
        )
    )

    local admitted = self._cohorts.admits(flag, rollout, self._roster, userId)
    return admitted
end

--[[
    Why a flag read the way it did for this player.

    A staged rollout generates exactly one support question -- "why can I not
    see it" -- and the answer is a rung name, so it is worth returning rather
    than reconstructing from the table by hand.
]]
function FeatureFlagService.explain(
    self: FeatureFlagService,
    flag: string,
    userId: number?
): (boolean, string)
    local override = self._overrides[flag]
    if override ~= nil then
        return override, "override"
    end

    local value = self._defaults[flag]
    assert(value ~= nil, string.format("unknown feature flag %q", flag))

    local rollout = self:rollout(flag)
    if not self._cohorts.isScoped(rollout.stage) then
        return value, if value then "everyone" else "stage_off"
    end

    if userId == nil then
        return false, "no_subject"
    end

    return self._cohorts.admits(flag, rollout, self._roster, userId)
end

function FeatureFlagService.setOverride(
    self: FeatureFlagService,
    flag: string,
    enabled: boolean
): (boolean, string?)
    if not self._allowOverrides then
        self._logger:warn("feature_flag_override_rejected", { flag = flag })
        return false, "overrides are disabled in this environment"
    end

    if self._defaults[flag] == nil then
        return false, "unknown feature flag"
    end

    self._overrides[flag] = enabled
    self._logger:info("feature_flag_overridden", { flag = flag, enabled = enabled })
    return true, nil
end

function FeatureFlagService.clearOverride(self: FeatureFlagService, flag: string)
    self._overrides[flag] = nil
end

function FeatureFlagService.count(self: FeatureFlagService): number
    local count = 0
    for _ in self._defaults do
        count += 1
    end
    return count
end

-- How many flags are mid-ladder. Logged at boot because a server that is
-- running a rollout and a server that is not are different things to read a
-- session's telemetry against.
function FeatureFlagService.scopedCount(self: FeatureFlagService): number
    local count = 0
    for flag in self._defaults do
        local rollout = self._rollouts[flag]
        if rollout ~= nil and self._cohorts.isScoped(rollout.stage) then
            count += 1
        end
    end
    return count
end

--[[
    Every flag as it stands for one player.

    Takes a user ID for the same reason `isEnabled` does: a snapshot that
    reported a cohort-scoped flag as its global default would be a report
    that is wrong about exactly the flags anybody is watching.
]]
function FeatureFlagService.snapshot(
    self: FeatureFlagService,
    userId: number?
): { [string]: boolean }
    local snapshot: { [string]: boolean } = {}
    for flag in self._defaults do
        snapshot[flag] = self:isEnabled(flag, userId)
    end
    for flag, value in self._overrides do
        snapshot[flag] = value
    end
    return snapshot
end

return table.freeze(FeatureFlagService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">GearVisualService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local GearVisualService = {}
GearVisualService.__index = GearVisualService
GearVisualService.Name = "GearVisualService"

local VISUAL_MODEL_NAME = "LastLightEquipmentVisuals"

local MATERIALS = {
    Fabric = Enum.Material.Fabric,
    Ground = Enum.Material.Ground,
    Wood = Enum.Material.Wood,
}

export type GearVisualService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: any,
        _profileService: any,
        _gearVisualPlan: any,
        _connections: { [Player]: RBXScriptConnection },
    },
    GearVisualService
))

function GearVisualService.new(
    logger: any,
    profileService: any,
    gearVisualPlan: any
): GearVisualService
    return setmetatable({
        Name = GearVisualService.Name,
        _logger = logger,
        _profileService = profileService,
        _gearVisualPlan = gearVisualPlan,
        _connections = {},
    }, GearVisualService)
end

local function targetFor(character: Model, targetName: string): BasePart?
    if targetName == "head" then
        return character:FindFirstChild("Head") :: BasePart?
    end
    if targetName == "RightHand" then
        for _, name in { "RightHand", "Right Arm" } do
            local candidate = character:FindFirstChild(name)
            if candidate ~= nil and candidate:IsA("BasePart") then
                return candidate
            end
        end
        return nil
    end
    --[[
        Torso and left hand exist because the armour lines use body, hands
        and charm slots. R15 and R6 name these differently, so each target
        is a list tried in order -- the same shape the feet have always
        used, for the same reason.
    ]]
    if targetName == "torso" then
        for _, name in { "UpperTorso", "Torso" } do
            local candidate = character:FindFirstChild(name)
            if candidate ~= nil and candidate:IsA("BasePart") then
                return candidate
            end
        end
        return nil
    end
    if targetName == "leftHand" then
        for _, name in { "LeftHand", "Left Arm" } do
            local candidate = character:FindFirstChild(name)
            if candidate ~= nil and candidate:IsA("BasePart") then
                return candidate
            end
        end
        return nil
    end
    local names = if targetName == "leftFoot"
        then { "LeftFoot", "LeftLowerLeg", "Left Leg" }
        else { "RightFoot", "RightLowerLeg", "Right Leg" }
    for _, name in names do
        local candidate = character:FindFirstChild(name)
        if candidate ~= nil and candidate:IsA("BasePart") then
            return candidate
        end
    end
    return nil
end

local function localFrame(plan: any, target: BasePart): CFrame
    local y = plan.offset[2]
    if plan.target ~= "head" and not string.find(target.Name, "Foot", 1, true) then
        y += -target.Size.Y * 0.5 + 0.42
    end
    return CFrame.new(plan.offset[1], y, plan.offset[3])
        * CFrame.Angles(
            math.rad(plan.rotation[1]),
            math.rad(plan.rotation[2]),
            math.rad(plan.rotation[3])
        )
end

local function buildPart(parent: Model, target: BasePart, plan: any): BasePart
    local visual = if plan.shape == "Wedge" then Instance.new("WedgePart") else Instance.new("Part")
    visual.Name = plan.name
    visual.Size = Vector3.new(plan.size[1], plan.size[2], plan.size[3])
    visual.Color = Color3.fromRGB(plan.color[1], plan.color[2], plan.color[3])
    visual.Material = MATERIALS[plan.material] or Enum.Material.SmoothPlastic
    if visual:IsA("Part") then
        visual.Shape = if plan.shape == "Cylinder"
            then Enum.PartType.Cylinder
            elseif plan.shape == "Ball" then Enum.PartType.Ball
            else Enum.PartType.Block
    end
    visual.Anchored = false
    visual.CanCollide = false
    visual.CanQuery = false
    visual.CanTouch = false
    visual.CastShadow = true
    visual.Massless = true
    visual.TopSurface = Enum.SurfaceType.Smooth
    visual.BottomSurface = Enum.SurfaceType.Smooth
    visual.CFrame = target.CFrame * localFrame(plan, target)
    visual.Parent = parent

    local weld = Instance.new("WeldConstraint")
    weld.Name = "EquipmentWeld"
    weld.Part0 = target
    weld.Part1 = visual
    weld.Parent = visual
    return visual
end

local function buildHeldPart(model: Model, target: BasePart, visual: BasePart)
    visual.Anchored = false
    visual.CanCollide = false
    visual.CanTouch = false
    visual.CanQuery = false
    visual.Massless = true
    visual.CastShadow = true
    visual.Parent = model
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = target
    weld.Part1 = visual
    weld.Parent = visual
end

function GearVisualService._refresh(self: GearVisualService, player: Player)
    local character = player.Character
    if character == nil or character.Parent == nil then
        return
    end

    local oldVisuals = character:FindFirstChild(VISUAL_MODEL_NAME)
    if oldVisuals ~= nil then
        oldVisuals:Destroy()
    end
    if not self._profileService:isLoaded(player) then
        return
    end

    local model = Instance.new("Model")
    model.Name = VISUAL_MODEL_NAME
    model.Archivable = false
    local equipped = self._profileService:equippedSnapshot(player)
    local visualPartCount = 0
    for slot, itemId in equipped do
        local itemPlan = self._gearVisualPlan.get(itemId)
        if itemPlan ~= nil and itemPlan.slot == slot then
            model:SetAttribute(string.format("%sItemId", slot), itemId)
            for _, partPlan in itemPlan.parts do
                local target = targetFor(character, partPlan.target)
                if target ~= nil then
                    buildPart(model, target, partPlan)
                    visualPartCount += 1
                end
            end
        end
    end
    --[[
        The held tool, in the hand that uses it.

        A strike used to happen with visibly empty hands. The selected starter
        tool (and the bow when one is equipped) is welded to the right hand as
        a small silhouette: enough to say what the character is holding at
        gameplay distance, cheap enough to rebuild on every respawn. The torch
        also actually lights -- its blurb says "lights the dark", and a claim
        on a plaque has to be true in play.
    ]]
    local rightHand = targetFor(character, "RightHand")
    -- The bow's visual comes from GearVisualPlan like every other equipment
    -- piece; only the starter tools are held here, because they are tutorial
    -- state rather than equipment. A weapon in the hand wins the hand.
    local heldId = if equipped.weapon ~= nil then nil else self._profileService:selectedTool(player)
    if rightHand ~= nil and heldId ~= nil then
        local hold = CFrame.new(0, -0.55, 0)
        if heldId == "axe" or heldId == "hammer" or heldId == "torch" then
            local handle = Instance.new("Part")
            handle.Name = "HeldToolHandle"
            handle.Size = Vector3.new(0.28, 2.4, 0.28)
            handle.Color = Color3.fromRGB(111, 76, 48)
            handle.Material = Enum.Material.Wood
            handle.CFrame = rightHand.CFrame * hold
            buildHeldPart(model, rightHand, handle)
            visualPartCount += 1
            if heldId == "axe" then
                local head = Instance.new("Part")
                head.Name = "HeldAxeHead"
                head.Size = Vector3.new(1.15, 0.5, 0.26)
                head.Color = Color3.fromRGB(154, 169, 174)
                head.Material = Enum.Material.Metal
                head.CFrame = rightHand.CFrame * hold * CFrame.new(0.35, 1.0, 0)
                buildHeldPart(model, rightHand, head)
                visualPartCount += 1
            elseif heldId == "hammer" then
                local head = Instance.new("Part")
                head.Name = "HeldHammerHead"
                head.Size = Vector3.new(1.05, 0.55, 0.55)
                head.Color = Color3.fromRGB(123, 132, 137)
                head.Material = Enum.Material.Metal
                head.CFrame = rightHand.CFrame * hold * CFrame.new(0, 1.05, 0)
                buildHeldPart(model, rightHand, head)
                visualPartCount += 1
            else
                local flame = Instance.new("Part")
                flame.Name = "HeldTorchFlame"
                flame.Size = Vector3.new(0.5, 0.9, 0.5)
                flame.Color = Color3.fromRGB(255, 158, 54)
                flame.Material = Enum.Material.Neon
                flame.CFrame = rightHand.CFrame * hold * CFrame.new(0, 1.35, 0)
                buildHeldPart(model, rightHand, flame)
                local glow = Instance.new("PointLight")
                glow.Color = Color3.fromRGB(255, 168, 82)
                glow.Brightness = 1.6
                glow.Range = 16
                glow.Shadows = false
                glow.Parent = flame
                visualPartCount += 1
            end
        end
    end
    model:SetAttribute("VisualPartCount", visualPartCount)
    model.Parent = character
end

function GearVisualService._bindPlayer(self: GearVisualService, player: Player)
    if self._connections[player] ~= nil then
        return
    end
    self._connections[player] = player.CharacterAdded:Connect(function()
        task.defer(function()
            self:_refresh(player)
        end)
    end)
    if player.Character ~= nil then
        task.defer(function()
            self:_refresh(player)
        end)
    end
end

--[[
    Public refresh: the tool yard calls this the moment a starter tool is
    chosen, so the tool appears in the hand at the pedestal rather than on the
    next respawn.
]]
function GearVisualService.refresh(self: GearVisualService, player: Player)
    task.defer(function()
        self:_refresh(player)
    end)
end

function GearVisualService.Init(self: GearVisualService)
    self._profileService:onLoaded(function(player: Player)
        self:_bindPlayer(player)
        self:_refresh(player)
    end)
    self._profileService:onEquipmentChanged(function(player: Player)
        self:_refresh(player)
    end)
end

function GearVisualService.Start(self: GearVisualService)
    Players.PlayerAdded:Connect(function(player: Player)
        self:_bindPlayer(player)
    end)
    Players.PlayerRemoving:Connect(function(player: Player)
        local connection = self._connections[player]
        if connection ~= nil then
            connection:Disconnect()
            self._connections[player] = nil
        end
    end)
    for _, player in Players:GetPlayers() do
        self:_bindPlayer(player)
    end
    self._logger:info("gear_visuals_started", {
        itemPlans = #self._gearVisualPlan.list(),
    })
end

return GearVisualService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">LobbyService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Drives the Emberhollow departure platform.

    All the rules about whether a departure may start, how long is left, and
    who may board live in the pure LobbyDeparture module. This service owns
    only the parts that need the world: who is physically standing on the
    platform, moving a launched party to the arrival clearing, and keeping a
    departed player there across respawns.

    Occupancy is measured server-side from character positions every tick. A
    client cannot claim to be on the platform, and a client that asks for a
    departure is only ever asking -- LobbyDeparture re-checks every bound.
]]

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local LobbyService = {}
LobbyService.__index = LobbyService
LobbyService.Name = "LobbyService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type LobbyService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _lobbyDeparture: any,
        _runHandoff: any,
        _isRunServer: boolean,
        _featureFlags: any,
        _worldService: any,
        _analyticsService: any,
        _partyService: any,
        _state: any,
        _departed: { [Player]: boolean },
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
        _lastPublishedSeconds: number,
    },
    LobbyService
))

local PLATFORM_VERTICAL_TOLERANCE = 12

function LobbyService.new(
    logger: Logger,
    config: any,
    lobbyDeparture: any,
    runHandoff: any,
    featureFlags: any,
    worldService: any,
    analyticsService: any
): LobbyService
    return setmetatable({
        Name = LobbyService.Name,
        _logger = logger,
        _config = config,
        _lobbyDeparture = lobbyDeparture,
        _runHandoff = runHandoff,
        _isRunServer = false,
        _featureFlags = featureFlags,
        _worldService = worldService,
        _analyticsService = analyticsService,
        _partyService = nil,
        _state = lobbyDeparture.create(),
        _departed = {},
        _onChanged = nil,
        _heartbeat = nil,
        _lastPublishedSeconds = -1,
    }, LobbyService)
end

function LobbyService.Init(_self: LobbyService, _context: any) end

function LobbyService.setChangedHandler(self: LobbyService, callback: (string?) -> ())
    self._onChanged = callback
end

--[[
    Parties, if this server has them.

    Optional on purpose. Everything below works without a party service and
    behaves exactly as it did before parties existed: seats are spent in the
    order the platform reports them, a departure carries no party ID, and
    nobody is issued a ticket home. What a party adds is an ordering and a way
    back, not a requirement.
]]
function LobbyService.setPartyService(self: LobbyService, partyService: any)
    self._partyService = partyService
end

function LobbyService._notify(self: LobbyService, message: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(message)
    end
end

local function rootOf(player: Player): BasePart?
    local character = player.Character
    if character == nil then
        return nil
    end
    local root = character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

--[[
    Players physically standing on the platform.

    Measured from the server's own view of character positions, never from a
    client claim. A departed player is excluded so someone who walks back onto
    the platform after launching cannot be counted into the next party while
    still mid-transition.
]]
function LobbyService.readyPlayers(self: LobbyService): { Player }
    local center, radius = self._worldService:departurePlatform()
    local ready = {}
    for _, player in Players:GetPlayers() do
        if not self._departed[player] then
            local root = rootOf(player)
            if root ~= nil then
                local offset = root.Position - center
                --[[
                    The built platform (WorldService) is a square, RADIUS*2 on
                    a side -- but this used to test the flat offset's
                    magnitude against RADIUS, which is the circle *inscribed*
                    in that square. A circle's corners fall short of the
                    square's, so a player standing in any of the platform's
                    four corners -- visibly on the dais, arguably the part of
                    it closest to the doorway -- was told to stand on the
                    platform while doing exactly that. About a fifth of the
                    platform's own surface area (1 - pi/4) was a dead zone.
                    Testing each axis against RADIUS independently matches the
                    square WorldService actually builds, corners included.
                ]]
                if
                    math.abs(offset.X) <= radius
                    and math.abs(offset.Z) <= radius
                    and math.abs(offset.Y) <= PLATFORM_VERTICAL_TOLERANCE
                then
                    table.insert(ready, player)
                end
            end
        end
    end
    return ready
end

function LobbyService.isDeparted(self: LobbyService, player: Player): boolean
    return self._departed[player] == true
end

--[[
    A client asking to start a departure for `size` players.

    Every bound is re-checked in LobbyDeparture against the server's own ready
    count and the configured capacity, so a forged size or a spammed request
    cannot start, resize, or rush a countdown.
]]
function LobbyService.requestDeparture(self: LobbyService, player: Player, size: any): any
    if not self._featureFlags:isEnabled("lobby_departure_enabled") then
        return { accepted = false, reason = "lobby_disabled" }
    end
    local ready = self:readyPlayers(self)
    local readyCount = #ready
    local now = workspace:GetServerTimeNow()
    local nextState, result = self._lobbyDeparture.requestDeparture(
        self._state,
        size,
        now,
        readyCount,
        self._config.MaxExpeditionPlayers
    )
    self._state = nextState
    self._analyticsService:lobbyDeparture(player, "request", result.accepted, result.reason, size)
    if result.accepted then
        self:_notify(
            string.format("DEPARTING IN %d — STAND ON THE PLATFORM", result.secondsRemaining)
        )
    elseif result.reason == "platform_empty" then
        self:_notify("STAND ON THE PLATFORM TO DEPART")
    elseif result.reason == "already_counting" then
        self:_notify("A DEPARTURE IS ALREADY UNDER WAY")
    end
    return result
end

function LobbyService.snapshot(self: LobbyService): any
    local now = workspace:GetServerTimeNow()
    local view = self._lobbyDeparture.snapshot(self._state, now)
    return {
        counting = view.counting,
        partySize = view.partySize,
        secondsRemaining = view.secondsRemaining,
        readyCount = #self:readyPlayers(self),
        maxPartySize = self._config.MaxExpeditionPlayers,
    }
end

--[[
    Send a boarded party to the arrival clearing.

    Players are placed in a small ring so a full party does not land inside one
    another, and marked departed so a respawn keeps them in the game rather
    than dropping them back into the lobby.
]]
--[[
    Is this server a run, or the lobby?

    Resolved once from the teleport payload this server was started with.
    Anything unrecognised resolves to a lobby, which is the safe direction:
    a server that wrongly thinks it is a run drops players into the world
    with no way to start one, while a server that wrongly thinks it is a
    lobby only shows a staging room they can depart from again.
]]
function LobbyService.isRunServer(self: LobbyService): boolean
    return self._isRunServer
end

--[[
    Read the teleport payload a joining player arrived with.

    The payload travels per player, so the first arrival carrying a valid run
    payload settles what this server is, and later joins cannot change it. The
    payload is inert by design -- it can say "this is a run" and nothing about
    rewards or progression -- so trusting it decides only which room the
    player wakes up in.
]]
function LobbyService._adoptArrival(self: LobbyService, player: Player)
    local data: any = nil
    pcall(function()
        data = player:GetJoinData().TeleportData
    end)
    local read = self._runHandoff.readPayload(data)
    if not read.isRun then
        return
    end
    if not self._isRunServer then
        self._isRunServer = true
        self._logger:info("run_server_adopted", { partySize = read.partySize })
    end
    -- A run server that knows which party it belongs to can recognise one of
    -- its own members coming back on a rejoin ticket and leave them where
    -- they landed, rather than forwarding them into the world they are
    -- already standing in.
    if read.partyId ~= nil and self._partyService ~= nil then
        self._partyService:adoptRun(read.partyId)
    end
    -- Departed players skip the lodge: the existing respawn path puts them at
    -- the arrival clearing and keeps them there.
    self._departed[player] = true
end

--[[
    Send a boarded party to its own reserved server.

    Reserving and teleporting are separate calls and either can fail. Both are
    wrapped, and any failure runs the same recovery: the party stays in the
    lodge, the departure is cancelled, and nothing is consumed. A half-sent
    party that lost its staging state is worse than one that never left.
]]
function LobbyService._teleportParty(self: LobbyService, boarding: { Player }): boolean
    if not self._featureFlags:isEnabled("reserved_run_servers_enabled") then
        return false
    end
    local placeId = game.PlaceId
    if placeId == 0 then
        -- Studio and unpublished builds cannot reserve a server. Fall back to
        -- moving the party in place so the lodge still works while testing.
        self._logger:info("run_teleport_skipped", { reason = "unpublished_place" })
        return false
    end

    --[[
        The party is formed before the server is reserved, because its ID has
        to ride the payload, and the tickets are written after the code comes
        back but before anybody is sent. That order is load-bearing in both
        directions: a ticket written after the teleport is written to a
        profile nobody is holding any more.
    ]]
    local partyId: string? = nil
    if self._partyService ~= nil then
        partyId = self._partyService:formDeparture(boarding)
    end

    local payload, built =
        self._runHandoff.buildPayload(#boarding, workspace:GetServerTimeNow(), partyId)
    if payload == nil then
        self._logger:warn("run_teleport_payload_invalid", { reason = built.reason })
        return false
    end

    local reserved, accessCode = pcall(function()
        return TeleportService:ReserveServer(placeId)
    end)
    if not reserved or type(accessCode) ~= "string" then
        self:_recoverFromTeleportFailure(boarding, "reserve_failed")
        return true
    end

    if partyId ~= nil and self._partyService ~= nil then
        self._partyService:issueTickets(partyId, boarding, accessCode)
    end

    local options = Instance.new("TeleportOptions")
    options.ReservedServerAccessCode = accessCode
    options:SetTeleportData(payload)

    local sent = pcall(function()
        TeleportService:TeleportAsync(placeId, boarding, options)
    end)
    if not sent then
        self:_recoverFromTeleportFailure(boarding, "teleport_failed")
        return true
    end

    self._logger:info("run_teleport_started", { boarded = #boarding })
    self._analyticsService:lobbyDeparture(nil, "teleport", true, nil, #boarding)
    return true
end

function LobbyService._recoverFromTeleportFailure(
    self: LobbyService,
    boarding: { Player },
    reason: string
)
    local recovery = self._runHandoff.failureRecovery(reason)
    for _, player in boarding do
        self._departed[player] = nil
    end
    if recovery.cancelDeparture then
        self._state = self._lobbyDeparture.cancel(self._state)
    end
    self._logger:warn("run_teleport_failed", { reason = recovery.reason, party = #boarding })
    self._analyticsService:lobbyDeparture(nil, "teleport", false, recovery.reason, #boarding)
    self:_notify(recovery.message)
end

function LobbyService._launch(self: LobbyService, boarding: { Player })
    -- Each party gets its own world when reserved servers are on. Only when
    -- that is unavailable -- Studio, an unpublished place, or the flag off --
    -- does the party move within this server instead.
    if self:_teleportParty(boarding) then
        for _, player in boarding do
            self._departed[player] = true
        end
        return
    end

    local destination = self._worldService:arrivalSpawnPosition()
    for index, player in boarding do
        local character = player.Character
        if character ~= nil then
            local angle = (index - 1) / math.max(1, #boarding) * math.pi * 2
            local offset = Vector3.new(math.cos(angle) * 4, 0, math.sin(angle) * 4)
            character:PivotTo(CFrame.new(destination + offset))
        end
        self._departed[player] = true
    end
    self._logger:info("lobby_departure_launched", { boarded = #boarding })
    self._analyticsService:lobbyDeparture(nil, "launch", true, nil, #boarding)
    self:_notify(string.format("THE PARTY OF %d HAS LEFT FOR EMBERHOLLOW", #boarding))
end

function LobbyService.Start(self: LobbyService)
    Players.PlayerRemoving:Connect(function(player: Player)
        self._departed[player] = nil
    end)
    for _, player in Players:GetPlayers() do
        self:_adoptArrival(player)
    end
    Players.PlayerAdded:Connect(function(player: Player)
        self:_adoptArrival(player)
        player.CharacterAdded:Connect(function(character: Model)
            -- A player who already left keeps playing the game after a death
            -- instead of being returned to the staging yard.
            if not self._departed[player] then
                return
            end
            task.defer(function()
                if character.Parent ~= nil then
                    character:PivotTo(CFrame.new(self._worldService:arrivalSpawnPosition()))
                end
            end)
        end)
    end)

    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.25 then
            return
        end
        accumulator = 0
        if not self._featureFlags:isEnabled("lobby_departure_enabled") then
            return
        end

        local ready = self:readyPlayers(self)
        local now = workspace:GetServerTimeNow()
        local nextState, result = self._lobbyDeparture.tick(self._state, now, #ready)
        self._state = nextState

        if result.launch then
            --[[
                Seats used to be spent in whatever order the engine listed
                players, so a bystander standing on the dais could take one
                from somebody's party. A party is asked first now; without
                one this is the same list it always was.
            ]]
            local capacity = math.min(result.capacity, #ready)
            local boarding = {}
            if self._partyService ~= nil then
                boarding = self._partyService:boardingOrder(ready, capacity)
            else
                for index = 1, capacity do
                    table.insert(boarding, ready[index])
                end
            end
            self:_launch(boarding)
            self._lastPublishedSeconds = -1
            return
        end

        if result.reason == "platform_emptied" then
            self:_notify("DEPARTURE CANCELLED — THE PLATFORM IS EMPTY")
            self._lastPublishedSeconds = -1
            return
        end

        -- Publish once per whole second so the countdown rail ticks without
        -- pushing a snapshot every frame.
        local view = self._lobbyDeparture.snapshot(nextState, now)
        if view.counting and view.secondsRemaining ~= self._lastPublishedSeconds then
            self._lastPublishedSeconds = view.secondsRemaining
            self:_notify(nil)
        end
    end)
end

return LobbyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">Logger</string>
            <string name="Source"><![CDATA[--!strict

local Logger = {}
Logger.__index = Logger

export type Fields = { [string]: any }
export type Sink = (level: string, line: string, fields: Fields) -> ()
export type Logger = typeof(setmetatable(
    {} :: {
        _environment: string,
        _minimumLevel: number,
        _sink: Sink,
    },
    Logger
))

local levels = {
    debug = 1,
    info = 2,
    warn = 3,
    error = 4,
}

local function defaultSink(level: string, line: string, _fields: Fields)
    if level == "warn" or level == "error" then
        warn(line)
    else
        print(line)
    end
end

local function formatFields(fields: Fields): string
    local keys: { string } = {}
    for key in fields do
        table.insert(keys, key)
    end
    table.sort(keys)

    local output: { string } = {}
    for _, key in keys do
        table.insert(output, string.format("%s=%s", key, tostring(fields[key])))
    end

    return table.concat(output, " ")
end

function Logger.new(environment: string, minimumLevel: string, sink: Sink?): Logger
    assert(levels[minimumLevel] ~= nil, "unknown minimum log level")
    return setmetatable({
        _environment = environment,
        _minimumLevel = levels[minimumLevel],
        _sink = sink or defaultSink,
    }, Logger)
end

function Logger._emit(self: Logger, level: string, event: string, fields: Fields?)
    if levels[level] < self._minimumLevel then
        return
    end

    local safeFields = fields or {}
    local suffix = formatFields(safeFields)
    local line =
        string.format("[LastLight][%s][%s] %s", string.upper(level), self._environment, event)
    if suffix ~= "" then
        line ..= " " .. suffix
    end

    self._sink(level, line, safeFields)
end

function Logger.debug(self: Logger, event: string, fields: Fields?)
    self:_emit("debug", event, fields)
end

function Logger.info(self: Logger, event: string, fields: Fields?)
    self:_emit("info", event, fields)
end

function Logger.warn(self: Logger, event: string, fields: Fields?)
    self:_emit("warn", event, fields)
end

function Logger.error(self: Logger, event: string, fields: Fields?)
    self:_emit("error", event, fields)
end

return table.freeze(Logger)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">NetworkService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkService = {}
NetworkService.__index = NetworkService
NetworkService.Name = "NetworkService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type NetworkService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _folder: Folder?,
        _actionPayloadContract: any,
        _actionRequest: RemoteEvent?,
        _stateChanged: RemoteEvent?,
        _getState: RemoteFunction?,
        _performanceReport: RemoteEvent?,
        _actionHandler: ((Player, any) -> ())?,
        _actionObserver: ((Player) -> ())?,
        _performanceHandler: ((Player, any) -> ())?,
        _snapshotProvider: ((Player) -> any)?,
        _snapshotCache: { [Player]: { at: number, value: any } },
        _lastActionAt: { [Player]: number },
        _lastStateAt: { [Player]: number },
    },
    NetworkService
))

function NetworkService.new(logger: Logger): NetworkService
    return setmetatable({
        Name = NetworkService.Name,
        _logger = logger,
        _folder = nil,
        _actionPayloadContract = nil,
        _actionRequest = nil,
        _stateChanged = nil,
        _getState = nil,
        _performanceReport = nil,
        _actionHandler = nil,
        _actionObserver = nil,
        _performanceHandler = nil,
        _snapshotProvider = nil,
        _snapshotCache = {},
        _lastActionAt = {},
        _lastStateAt = {},
    }, NetworkService)
end

local function makeRemote(className: string, name: string, parent: Instance): Instance
    local remote = Instance.new(className)
    remote.Name = name
    remote.Parent = parent
    return remote
end

function NetworkService.Init(self: NetworkService, context: any)
    local runtimeIds = context.runtimeIds
    self._actionPayloadContract =
        assert(context.actionPayloadContract, "action payload contract unavailable")
    local existing = ReplicatedStorage:FindFirstChild(runtimeIds.FolderName)
    if existing ~= nil then
        existing:Destroy()
    end

    local folder = Instance.new("Folder")
    folder.Name = runtimeIds.FolderName
    folder:SetAttribute("SchemaVersion", 1)
    folder:SetAttribute("WorldReady", false)
    folder.Parent = ReplicatedStorage

    self._folder = folder
    self._actionRequest =
        makeRemote("RemoteEvent", runtimeIds.Remotes.ActionRequest, folder) :: RemoteEvent
    self._stateChanged =
        makeRemote("RemoteEvent", runtimeIds.Remotes.StateChanged, folder) :: RemoteEvent
    self._getState =
        makeRemote("RemoteFunction", runtimeIds.Remotes.GetState, folder) :: RemoteFunction
    self._performanceReport =
        makeRemote("RemoteEvent", runtimeIds.Remotes.PerformanceReport, folder) :: RemoteEvent
end

function NetworkService.Start(self: NetworkService)
    local actionRequest = assert(self._actionRequest, "action remote unavailable")
    local getState = assert(self._getState, "state function unavailable")
    local contract = assert(self._actionPayloadContract, "action payload contract unavailable")
    local performanceReport = assert(self._performanceReport, "performance remote unavailable")

    -- Telemetry, kept off the action path on purpose. The handler bounds and
    -- rate limits the payload itself; nothing here can grant a player
    -- anything, so the worst a lying client achieves is a wrong row in its own
    -- performance report.
    performanceReport.OnServerEvent:Connect(function(player: Player, payload: any)
        local handler = self._performanceHandler
        if handler ~= nil then
            handler(player, payload)
        end
    end)

    actionRequest.OnServerEvent:Connect(function(player: Player, payload: any)
        if not contract.isValidTransport(payload) then
            return
        end
        local now = os.clock()
        local lastActionAt = self._lastActionAt[player]
        if lastActionAt ~= nil and os.clock() - lastActionAt < 0.05 then
            return
        end
        self._lastActionAt[player] = now
        local observer = self._actionObserver
        if observer ~= nil then
            observer(player)
        end
        local handler = self._actionHandler
        if handler ~= nil then
            handler(player, payload)
        end
    end)

    getState.OnServerInvoke = function(player: Player)
        if typeof(player) ~= "Instance" or not player:IsA("Player") then
            return nil
        end
        local lastStateAt = self._lastStateAt[player]
        if lastStateAt ~= nil and os.clock() - lastStateAt < 0.1 then
            return nil
        end
        self._lastStateAt[player] = os.clock()
        local provider = self._snapshotProvider
        if provider == nil then
            return nil
        end
        local now = os.clock()
        local cached = self._snapshotCache[player]
        if cached ~= nil and now - cached.at < 0.2 then
            return cached.value
        end

        local snapshot = provider(player)
        self._snapshotCache[player] = {
            at = now,
            value = snapshot,
        }
        return snapshot
    end
    Players.PlayerRemoving:Connect(function(player: Player)
        self._snapshotCache[player] = nil
        self._lastActionAt[player] = nil
        self._lastStateAt[player] = nil
    end)

    self._logger:info("network_started", { schemaVersion = 1 })
end

function NetworkService.setActionHandler(self: NetworkService, handler: (Player, any) -> ())
    self._actionHandler = handler
end

-- Counts accepted actions for the remote-traffic budget. Set after the fact
-- because the observer belongs to a service built later, and kept separate
-- from the handler so measuring can never change what a payload does.
function NetworkService.setActionObserver(self: NetworkService, observer: (Player) -> ())
    self._actionObserver = observer
end

function NetworkService.setPerformanceHandler(self: NetworkService, handler: (Player, any) -> ())
    self._performanceHandler = handler
end

function NetworkService.setSnapshotProvider(self: NetworkService, provider: (Player) -> any)
    self._snapshotProvider = provider
end

function NetworkService.send(self: NetworkService, player: Player, snapshot: any)
    local stateChanged = self._stateChanged
    if stateChanged ~= nil and player.Parent ~= nil then
        self._snapshotCache[player] = {
            at = os.clock(),
            value = snapshot,
        }
        stateChanged:FireClient(player, snapshot)
    end
end

function NetworkService.broadcast(self: NetworkService, snapshotProvider: (Player) -> any)
    for _, player in Players:GetPlayers() do
        self:send(player, snapshotProvider(player))
    end
end

function NetworkService.setWorldReady(self: NetworkService, ready: boolean)
    local folder = self._folder
    if folder ~= nil then
        folder:SetAttribute("WorldReady", ready)
    end
end

function NetworkService.isWorldReady(self: NetworkService): boolean
    local folder = self._folder
    return folder ~= nil and folder:GetAttribute("WorldReady") == true
end

function NetworkService.folder(self: NetworkService): Folder
    return assert(self._folder, "network service has not initialized")
end

return table.freeze(NetworkService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">OldGrowthService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local OldGrowthService = {}
OldGrowthService.__index = OldGrowthService
OldGrowthService.Name = "OldGrowthService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type AttackVisual = {
    label: TextLabel,
    marker: Part,
}

type Attack = {
    areaCFrame: CFrame,
    definition: any,
    flow: any,
    target: Player,
    visual: AttackVisual,
}

export type OldGrowthService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _expeditionService: any,
        _survivalService: any,
        _combatService: any,
        _professionService: any,
        _encounter: any,
        _enemyAttackFlow: any,
        _enemyCombatRules: any,
        _builder: any,
        _analyticsService: any,
        _featureFlags: any,
        _state: any,
        _arena: any,
        _model: Model?,
        _strikeHandler: ((Player) -> ())?,
        _attack: Attack?,
        _attackIndex: number,
        _lastAttackAt: number,
        _markedUntil: number,
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
        _activationGate: (() -> boolean)?,
    },
    OldGrowthService
))

local ACTIVATION_RADIUS = 28
local ENCOUNTER_RADIUS = 58
local STRIKE_RANGE = 14

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function weakPoint(model: Model): BasePart?
    local heart = model:FindFirstChild("AmberHeart")
    return if heart ~= nil
            and heart:IsA("BasePart")
            and heart:GetAttribute("WeakPoint") == true
        then heart
        else nil
end

function OldGrowthService.new(
    logger: Logger,
    worldService: any,
    expeditionService: any,
    survivalService: any,
    combatService: any,
    professionService: any,
    encounter: any,
    enemyAttackFlow: any,
    enemyCombatRules: any,
    builder: any,
    analyticsService: any,
    featureFlags: any
): OldGrowthService
    return setmetatable({
        Name = OldGrowthService.Name,
        _logger = logger,
        _worldService = worldService,
        _expeditionService = expeditionService,
        _survivalService = survivalService,
        _combatService = combatService,
        _professionService = professionService,
        _encounter = encounter,
        _enemyAttackFlow = enemyAttackFlow,
        _enemyCombatRules = enemyCombatRules,
        _builder = builder,
        _analyticsService = analyticsService,
        _featureFlags = featureFlags,
        _state = nil,
        _arena = nil,
        _model = nil,
        _strikeHandler = nil,
        _attack = nil,
        _attackIndex = 0,
        _lastAttackAt = 0,
        _markedUntil = 0,
        _onChanged = nil,
        _heartbeat = nil,
        _activationGate = nil,
    }, OldGrowthService)
end

function OldGrowthService.setActivationGate(self: OldGrowthService, gate: (() -> boolean)?)
    self._activationGate = gate
end

function OldGrowthService.Init(self: OldGrowthService, _context: any)
    local manifest = assert(self._expeditionService:manifest(), "expedition manifest unavailable")
    self._arena = assert(self._worldService:oldGrowthArena(), "Old Growth arena unavailable")
    self._state = self._encounter.create(
        self._expeditionService:runId(),
        manifest.hash,
        self._featureFlags:isEnabled("old_growth_elite_enabled")
    )
    self._worldService:setOldGrowthPresentation(self._state.status)
end

function OldGrowthService.Start(self: OldGrowthService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.05 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
    self._logger:info("old_growth_ready", {
        enabled = self._state.status ~= "disabled",
        elite = self._encounter.Id,
        manifest = self._state.manifestHash,
    })
end

function OldGrowthService.setChangedHandler(self: OldGrowthService, callback: (string?) -> ())
    self._onChanged = callback
end

function OldGrowthService._notify(self: OldGrowthService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function OldGrowthService._inArena(self: OldGrowthService, player: Player, radius: number): boolean
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return false
    end
    local root = rootPart(player)
    return root ~= nil and (root.Position - self._arena.center).Magnitude <= radius
end

function OldGrowthService._spawnModel(self: OldGrowthService, target: Player)
    if self._model ~= nil and self._model.Parent ~= nil then
        return
    end
    local targetRoot = rootPart(target)
    local lookAt = if targetRoot == nil
        then self._arena.center + Vector3.new(0, 0, -10)
        else targetRoot.Position
    local model = self._builder.build(self._arena.center, lookAt, self._encounter.MaxHealth)
    model.Parent =
        assert(self._arena.fireSource.Parent, "Old Growth arena lost its streamed module")
    task.spawn(function()
        if model.Parent ~= nil then
            self._worldService:placeEnemyVisual(model, "old_growth")
        end
    end)
    self._model = model
    --[[
        Tappable like every night creature: on touch there is no STRIKE
        button by design -- the tap IS the strike -- and this model never
        carried the StrikeClick the enemies got when every monster was made
        tappable. On a tablet the amber heart was therefore unhittable: the
        owner stood on the telegraph, tapped the heart, and nothing
        happened. Same recipe as BramblewakeEnemyBuilder: one detector on
        the model so any visible part answers the tap.
    ]]
    local click = Instance.new("ClickDetector")
    click.Name = "StrikeClick"
    click.MaxActivationDistance = 42
    click.CursorIcon = ""
    click.Parent = model
    click.MouseClick:Connect(function(clicker: Player)
        local handler = self._strikeHandler
        if handler ~= nil then
            handler(clicker)
        end
    end)
    self._builder.setState(model, self._state.health, false, false)
end

function OldGrowthService.setStrikeHandler(self: OldGrowthService, handler: (Player) -> ())
    self._strikeHandler = handler
end

function OldGrowthService._clearAttack(self: OldGrowthService)
    local attack = self._attack
    if attack == nil then
        return
    end
    if attack.visual.marker.Parent ~= nil then
        attack.visual.marker:Destroy()
    end
    self._attack = nil
end

function OldGrowthService._groundPosition(self: OldGrowthService, targetRoot: BasePart): Vector3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { targetRoot.Parent :: Model }
    if self._model ~= nil then
        table.insert(excluded, self._model)
    end
    params.FilterDescendantsInstances = excluded
    local result = workspace:Raycast(
        targetRoot.Position + Vector3.new(0, 3, 0),
        Vector3.new(0, -18, 0),
        params
    )
    return if result == nil
        then targetRoot.Position - Vector3.new(0, 2.8, 0)
        else result.Position + Vector3.new(0, 0.14, 0)
end

function OldGrowthService._attackArea(
    self: OldGrowthService,
    definition: any,
    targetRoot: BasePart
): CFrame
    local ground = self:_groundPosition(targetRoot)
    if definition.shape == "circle" or self._model == nil or self._model.PrimaryPart == nil then
        return CFrame.new(ground)
    end
    local origin = self._model.PrimaryPart.Position
    local direction =
        Vector3.new(targetRoot.Position.X - origin.X, 0, targetRoot.Position.Z - origin.Z)
    if direction.Magnitude < 0.01 then
        direction = Vector3.new(0, 0, -1)
    end
    direction = direction.Unit
    local center = Vector3.new(origin.X, ground.Y, origin.Z) + direction * definition.length * 0.5
    return CFrame.lookAt(center, center + direction)
end

function OldGrowthService._createAttackVisual(
    _self: OldGrowthService,
    definition: any,
    areaCFrame: CFrame
): AttackVisual
    local marker = Instance.new("Part")
    marker.Name = "OldGrowthAttackWarning"
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.CastShadow = false
    marker.Color = if definition.shape == "lane"
        then Color3.fromRGB(101, 187, 112)
        else Color3.fromRGB(255, 148, 82)
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.5
    if definition.shape == "lane" then
        marker.Size = Vector3.new(definition.width, 0.2, definition.length)
        marker.CFrame = areaCFrame
    else
        marker.Shape = Enum.PartType.Cylinder
        marker.Size = Vector3.new(0.2, definition.radius * 2, definition.radius * 2)
        marker.CFrame = areaCFrame * CFrame.Angles(0, 0, math.rad(90))
    end
    marker.Parent = workspace

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "OldGrowthAttackLabel"
    billboard.Adornee = marker
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 120
    billboard.Size = UDim2.fromOffset(270, 68)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.4, 0)
    billboard.Parent = marker

    local label = Instance.new("TextLabel")
    label.Name = "Warning"
    label.BackgroundColor3 = Color3.fromRGB(26, 38, 29)
    label.BackgroundTransparency = 0.08
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = definition.attackName .. "\n" .. definition.instruction
    label.TextColor3 = Color3.fromRGB(248, 233, 198)
    label.TextScaled = true
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local stroke = Instance.new("UIStroke")
    stroke.Color = marker.Color
    stroke.Thickness = 2
    stroke.Transparency = 0.08
    stroke.Parent = label
    return {
        label = label,
        marker = marker,
    }
end

function OldGrowthService._startAttack(self: OldGrowthService, target: Player, now: number)
    local targetRoot = rootPart(target)
    if targetRoot == nil then
        return
    end
    self._attackIndex += 1
    local definition = self._encounter.attack(self._attackIndex, self._state.shieldIndex)
    local areaCFrame = self:_attackArea(definition, targetRoot)
    self._attack = {
        areaCFrame = areaCFrame,
        definition = definition,
        flow = self._enemyAttackFlow.create(target.UserId, now, definition.windup),
        target = target,
        visual = self:_createAttackVisual(definition, areaCFrame),
    }
    self._lastAttackAt = now
    self._analyticsService:eliteAttackTelegraphed(
        target,
        self._encounter.Id,
        definition.attackId,
        definition.shape,
        definition.windup
    )
    self:_notify(nil)
end

function OldGrowthService._clearPath(self: OldGrowthService, target: Player): boolean
    local model = self._model
    local root = rootPart(target)
    local character = target.Character
    if model == nil or model.PrimaryPart == nil or root == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { model }
    local result = workspace:Raycast(
        model.PrimaryPart.Position,
        root.Position - model.PrimaryPart.Position,
        params
    )
    return result == nil or result.Instance:IsDescendantOf(character)
end

function OldGrowthService._insideAttack(
    self: OldGrowthService,
    attack: Attack,
    targetRoot: BasePart
): boolean
    local localPosition = attack.areaCFrame:PointToObjectSpace(targetRoot.Position)
    return self._enemyCombatRules.contains(
        attack.definition.shape,
        localPosition.X,
        localPosition.Z,
        attack.definition.radius,
        attack.definition.width,
        attack.definition.length
    )
end

function OldGrowthService._stepAttack(self: OldGrowthService, now: number)
    local attack = self._attack
    if attack == nil then
        return
    end
    local targetRoot = rootPart(attack.target)
    local resolving = now >= attack.flow.endsAt
    local decision = self._enemyAttackFlow.evaluate(attack.flow, now, {
        clearPath = not resolving or self:_clearPath(attack.target),
        inImpactArea = not resolving
            or (targetRoot ~= nil and self:_insideAttack(attack, targetRoot)),
        targetCanAct = self._survivalService:canAct(attack.target),
        targetPresent = attack.target.Parent ~= nil and attack.target:GetAttribute(
            "LastLightInExpedition"
        ) == true and targetRoot ~= nil,
    })
    if decision.status == "pending" then
        attack.visual.label.Text = string.format(
            "%s\n%s · %.1fs",
            attack.definition.attackName,
            attack.definition.instruction,
            math.max(0, decision.remaining or 0)
        )
        return
    end

    local target = attack.target
    local definition = attack.definition
    self:_clearAttack()
    if decision.status == "cancel" or decision.status == "miss" then
        self._analyticsService:eliteAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            decision.reason or decision.status
        )
        self:_notify(nil)
        return
    end
    if self._combatService:avoidsDamage(target, now) then
        self._analyticsService:eliteAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            "dodged"
        )
        self:_notify(nil)
        return
    end

    local damage, guarded =
        self._professionService:mitigateIncomingDamage(target, definition.damage, now)
    damage = self._combatService:mitigateShieldedDamage(target, damage, now)
    local result = self._survivalService:damage(target, damage, self._encounter.Id)
    if result.applied and definition.attackId == "old_growth_root_lane" then
        self._combatService:applyRooted(
            target,
            definition.rootedDuration,
            definition.rootedMultiplier
        )
    end
    self._analyticsService:eliteAttackResult(
        target,
        self._encounter.Id,
        definition.attackId,
        if result.applied then (if guarded then "guarded_hit" else "hit") else "blocked"
    )
    if result.downed then
        self:_notify("ALLY DOWN — " .. definition.attackName)
    elseif guarded and result.applied then
        self:_notify("LANTERN GUARD ABSORBS " .. definition.attackName)
    else
        self:_notify(nil)
    end
end

function OldGrowthService._syncCarrierVisuals(self: OldGrowthService, now: number)
    for _, player in Players:GetPlayers() do
        local snapshot = self._encounter.snapshot(self._state, player.UserId, now)
        player:SetAttribute("LastLightCarryingOldGrowthFire", snapshot.carryingFire)
        player:SetAttribute("LastLightOldGrowthFireExpiresAt", snapshot.fireExpiresAt)
        local root = rootPart(player)
        if root ~= nil then
            local light = root:FindFirstChild("OldGrowthCarryLight")
            if snapshot.carryingFire and light == nil then
                local pointLight = Instance.new("PointLight")
                pointLight.Name = "OldGrowthCarryLight"
                pointLight.Color = Color3.fromRGB(255, 181, 76)
                pointLight.Brightness = 2.2
                pointLight.Range = 18
                pointLight.Shadows = false
                pointLight.Parent = root
            elseif not snapshot.carryingFire and light ~= nil then
                light:Destroy()
            end
        end
    end
end

function OldGrowthService._playersInArena(self: OldGrowthService): { Player }
    local players = {}
    for _, player in Players:GetPlayers() do
        if self:_inArena(player, ENCOUNTER_RADIUS) and self._survivalService:canAct(player) then
            table.insert(players, player)
        end
    end
    return players
end

function OldGrowthService._nearestPlayer(self: OldGrowthService, players: { Player }): Player?
    local anchor = self._arena.center
    if self._model ~= nil and self._model.PrimaryPart ~= nil then
        anchor = self._model.PrimaryPart.Position
    end
    local nearest: Player? = nil
    local nearestDistance = math.huge
    for _, player in players do
        local root = rootPart(player)
        if root ~= nil then
            local distance = (root.Position - anchor).Magnitude
            if distance < nearestDistance then
                nearest = player
                nearestDistance = distance
            end
        end
    end
    return nearest
end

function OldGrowthService._step(self: OldGrowthService, now: number)
    local previousRevision = self._state.revision
    self._state = self._encounter.expire(self._state, now)
    if self._state.revision ~= previousRevision then
        self:_syncCarrierVisuals(now)
        self:_notify("LANTERN FIRE FADED — TAKE ANOTHER FLAME")
    end

    if
        self._state.status == "dormant"
        and (self._activationGate == nil or (self._activationGate :: () -> boolean)())
    then
        for _, player in Players:GetPlayers() do
            if
                self:_inArena(player, ACTIVATION_RADIUS) and self._survivalService:canAct(player)
            then
                local nextState, result = self._encounter.activate(self._state, player.UserId)
                if result.accepted then
                    self._state = nextState
                    self:_spawnModel(player)
                    self._lastAttackAt = now
                    self._worldService:setOldGrowthPresentation(self._state.status)
                    self._analyticsService:eliteStarted(
                        player,
                        self._encounter.Id,
                        self._state.manifestHash
                    )
                    self:_notify("OLD GROWTH AWAKENS — STRIKE THE AMBER HEART")
                end
                break
            end
        end
        return
    end
    if self._state.status ~= "vulnerable" and self._state.status ~= "shielded" then
        return
    end

    local players = self:_playersInArena()
    for _, player in players do
        self._state = self._encounter.join(self._state, player.UserId)
    end
    if self._model == nil or self._model.Parent == nil then
        local target = self:_nearestPlayer(players)
        if target ~= nil then
            self:_spawnModel(target)
        end
    end
    if self._markedUntil > 0 and now >= self._markedUntil then
        self._markedUntil = 0
        if self._model ~= nil then
            self._builder.setState(
                self._model,
                self._state.health,
                self._state.status == "shielded",
                false
            )
        end
        self:_notify(nil)
    end
    if self._attack ~= nil then
        self:_stepAttack(now)
        return
    end
    local target = self:_nearestPlayer(players)
    if target == nil then
        return
    end
    local tuning = self._encounter.Tuning
    local cooldown = if self._state.status == "shielded"
        then tuning.shieldedAttackCooldownSeconds
        else tuning.attackCooldownSeconds
    if now < self._markedUntil then
        cooldown *= tuning.markedAttackCooldownMultiplier
    end
    if now - self._lastAttackAt >= cooldown then
        self:_startAttack(target, now)
    end
end

function OldGrowthService.interact(
    self: OldGrowthService,
    player: Player,
    prompt: ProximityPrompt
): any
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return {
            accepted = false,
            message = "ENTER THE OLD GROWTH ARENA WHILE ACTIVE",
            reason = "player_unavailable",
        }
    end
    local promptParent = prompt.Parent
    local interaction = if promptParent == nil
        then nil
        else promptParent:GetAttribute("EliteInteraction")
    local now = workspace:GetServerTimeNow()
    local nextState, result
    if interaction == "fire_source" then
        nextState, result = self._encounter.takeFire(self._state, player.UserId, now)
    elseif interaction == "root_heart" then
        nextState, result = self._encounter.burnHeart(self._state, player.UserId, now)
    else
        return {
            accepted = false,
            message = "THAT ELITE INTERACTION IS INVALID",
            reason = "invalid_interaction",
        }
    end
    if not result.accepted then
        result.message = if result.reason == "fire_required"
            then "TAKE LANTERN FIRE BEFORE TOUCHING THE ROOT HEART"
            elseif result.reason == "fire_claimed" then "AN ALLY ALREADY CARRIES THE FIRE"
            else "THE ROOT SHIELD IS NOT CALLING FOR FIRE"
        return result
    end

    self._state = nextState
    self._worldService:setOldGrowthPresentation(self._state.status)
    self:_syncCarrierVisuals(now)
    if result.reason == "fire_taken" then
        result.message = "LANTERN FIRE HELD — REACH THE ROOT HEART"
        self:_notify(result.message)
    else
        result.message = "ROOT SHIELD BURNED — AMBER HEART EXPOSED"
        if self._model ~= nil then
            self._builder.setState(self._model, self._state.health, false, now < self._markedUntil)
        end
        self._analyticsService:elitePhase(
            player,
            self._encounter.Id,
            self._state.shieldIndex + 1,
            "shield_burned"
        )
        self:_notify(result.message)
    end
    return result
end

function OldGrowthService._lineOfSight(
    _self: OldGrowthService,
    player: Player,
    model: Model
): boolean
    local root = rootPart(player)
    local heart = weakPoint(model)
    local character = player.Character
    if root == nil or heart == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    -- Exclude the elite itself: its own invisible hitbox parts sit between
    -- most angles and the heart, and a creature's body is not cover against
    -- striking its exposed weak point. Only real world geometry blocks. The
    -- old check demanded the ray hit the heart part first, which also failed
    -- whenever the heart was non-queryable -- combined with the visual pass
    -- clearing CanQuery, that made the encounter uncompletable.
    params.FilterDescendantsInstances = { character, model }
    local result = workspace:Raycast(root.Position, heart.Position - root.Position, params)
    return result == nil
end

function OldGrowthService.damageNearest(self: OldGrowthService, player: Player): (boolean, string)
    if self._state.status ~= "vulnerable" and self._state.status ~= "shielded" then
        return false, "No elite threat is active."
    end
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return false, "Enter the Old Growth arena to strike."
    end
    local model = self._model
    local root = rootPart(player)
    local heart = if model == nil then nil else weakPoint(model)
    if model == nil or root == nil or heart == nil then
        return false, "Old Growth is still taking shape."
    end
    if (root.Position - heart.Position).Magnitude > STRIKE_RANGE then
        return false, "Move closer to the amber heart."
    end
    if not self:_lineOfSight(player, model) then
        return false, "The amber heart is behind the trunk."
    end

    local tuning = self._encounter.Tuning
    local amount = if workspace:GetServerTimeNow() < self._markedUntil
        then tuning.markedStrikeDamage
        else tuning.strikeDamage
    local nextState, result = self._encounter.strike(self._state, player.UserId, amount)
    if not result.accepted then
        if result.reason == "shielded" then
            return false, "ROOT SHIELD — MOVE LANTERN FIRE TO THE HEART"
        end
        return false, "Old Growth cannot be struck right now."
    end
    self._state = nextState
    self._builder.setState(
        model,
        self._state.health,
        self._state.status == "shielded",
        workspace:GetServerTimeNow() < self._markedUntil
    )
    self._worldService:setOldGrowthPresentation(self._state.status)
    if result.completed then
        self:_clearAttack()
        for participantId in self._state.participants do
            local userId = tonumber(participantId)
            if userId ~= nil then
                self._expeditionService:grantEncounterReward(
                    userId,
                    self._encounter.Id,
                    self._encounter.rewardTransactionId(self._state, userId),
                    self._encounter.Reward
                )
            end
        end
        self:_syncCarrierVisuals(workspace:GetServerTimeNow())
        self._analyticsService:eliteCompleted(
            player,
            self._encounter.Id,
            self._state.manifestHash,
            self._state.shieldIndex,
            self:_participantCount()
        )
        self:_notify("OLD GROWTH CLEANSED — +3 AMBER SAP UNBANKED")
        return true, "Old Growth cleansed. Amber Sap added to the expedition pouch."
    end
    if result.shieldStarted then
        self._analyticsService:elitePhase(
            player,
            self._encounter.Id,
            self._state.shieldIndex,
            "shield_started"
        )
        self:_notify("ROOT SHIELD — TAKE LANTERN FIRE TO THE HEART")
        return true, "A root shield closes around the amber heart."
    end
    self:_notify(
        string.format("HIT — OLD GROWTH %d / %d", self._state.health, self._encounter.MaxHealth)
    )
    return true, "Your tool strikes the amber heart."
end

function OldGrowthService._participantCount(self: OldGrowthService): number
    local count = 0
    for _ in self._state.participants do
        count += 1
    end
    return count
end

function OldGrowthService.canMarkNearest(
    self: OldGrowthService,
    player: Player,
    range: number
): (boolean, string)
    local model = self._model
    local root = rootPart(player)
    if
        not self:combatActive()
        or model == nil
        or model.PrimaryPart == nil
        or root == nil
        or not self:_inArena(player, ENCOUNTER_RADIUS)
        or not self._survivalService:canAct(player)
    then
        return false, "NO ELITE THREAT CAN BE MARKED"
    end
    if (root.Position - model.PrimaryPart.Position).Magnitude > range then
        return false, "MOVE CLOSER TO MARK OLD GROWTH"
    end
    if not self:_lineOfSight(player, model) then
        return false, "OLD GROWTH IS HIDDEN BY THE TRUNK"
    end
    return true, "FOXFIRE MARK READY"
end

function OldGrowthService.markNearest(
    self: OldGrowthService,
    player: Player,
    range: number,
    duration: number
): (boolean, string)
    local allowed, reason = self:canMarkNearest(player, range)
    if not allowed then
        return false, reason
    end
    self._markedUntil = workspace:GetServerTimeNow() + duration
    if self._model ~= nil then
        self._builder.setState(
            self._model,
            self._state.health,
            self._state.status == "shielded",
            true
        )
    end
    local message = "FOXFIRE MARK — OLD GROWTH TELEGRAPHS SLOWED"
    self:_notify(message)
    return true, message
end

function OldGrowthService.threatSnapshot(self: OldGrowthService, viewer: Player): any
    local attack = self._attack
    if attack == nil or attack.target ~= viewer then
        return nil
    end
    return {
        attackId = attack.definition.attackId,
        displayName = attack.definition.attackName,
        enemyId = self._encounter.Id,
        enemyName = "OLD GROWTH",
        instruction = attack.definition.instruction,
        resolvesAt = attack.flow.endsAt,
        shape = attack.definition.shape,
    }
end

function OldGrowthService.snapshot(self: OldGrowthService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return nil
    end
    -- The elite rail appears only near an active or just-completed encounter
    -- (its runbook's words). A dormant snapshot leaked the full-health rail to
    -- anyone within the arena radius -- during a Blackout relay, whose farm
    -- root sits beside this arena, every carrier saw "OLD GROWTH · 360/360"
    -- one stage before the encounter is even reachable, and the Blackout
    -- runbook explicitly requires no health rail before the relay completes.
    if self._state.status == "dormant" then
        return nil
    end
    local snapshot =
        self._encounter.snapshot(self._state, player.UserId, workspace:GetServerTimeNow())
    if not self:_inArena(player, ENCOUNTER_RADIUS + 18) and not snapshot.carryingFire then
        return nil
    end
    return snapshot
end

function OldGrowthService.combatActive(self: OldGrowthService): boolean
    return self._state.status == "vulnerable" or self._state.status == "shielded"
end

function OldGrowthService.isComplete(self: OldGrowthService): boolean
    return self._state.status == "complete"
end

function OldGrowthService.enabled(self: OldGrowthService): boolean
    return self._state.status ~= "disabled"
end

return table.freeze(OldGrowthService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">PartyService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Parties at the lodge, and the way back to one.

    All the rules about who may join, who boards first and whether a returning
    player may be sent anywhere live in the pure PartySession module. This
    service owns only the parts that need the running game: which Player owns
    which user ID, who is physically standing on the departure platform, the
    profile write that persists a rejoin ticket, and the teleport that spends
    one.

    Two things it is deliberately careful about:

      * **The access code never leaves the server.** A rejoin ticket carries
        a reserved-server access code, which is the entire key to a private
        world. It is written to the profile, which is server-owned storage,
        and the only thing that reaches a client is PartySession.publicTicket
        -- available, party size, seconds left. Nothing here builds a snapshot
        field by hand out of a ticket, because that is the version of this
        rule that stops being true the first time somebody adds a field.
      * **An invitation names nobody.** The invite press carries no payload at
        all: it offers a seat to whoever the server can see standing on the
        platform. A press cannot be forged into naming a stranger across the
        map, because there is no name in it to forge.
]]

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local PartyService = {}
PartyService.__index = PartyService
PartyService.Name = "PartyService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type PartyService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _partySession: any,
        _profileService: any,
        _analyticsService: any,
        _parties: { [string]: any },
        _partyByUser: { [number]: string },
        _inviteByUser: { [number]: string },
        --[[
            The party that is mid-launch, held in one slot rather than added
            to `_parties`. A departure is sealed and then never touched again,
            so filing it with the live rosters would grow that table by one
            per launch for the life of the server and nothing would ever read
            the entries. One slot is enough because the platform launches one
            party at a time, and an unclaimed one is simply overwritten by the
            next.
        ]]
        _departing: any,
        _runPartyId: string?,
        _onToast: ((Player?, string) -> ())?,
        _platformProvider: (() -> { Player })?,
        _blockReader: ((number, number) -> boolean)?,
    },
    PartyService
))

function PartyService.new(
    logger: Logger,
    config: any,
    partySession: any,
    profileService: any,
    analyticsService: any
): PartyService
    return setmetatable({
        Name = PartyService.Name,
        _logger = logger,
        _config = config,
        _partySession = partySession,
        _profileService = profileService,
        _analyticsService = analyticsService,
        _parties = {},
        _partyByUser = {},
        _inviteByUser = {},
        _departing = nil,
        _runPartyId = nil,
        _onToast = nil,
        _platformProvider = nil,
        _blockReader = nil,
    }, PartyService)
end

function PartyService.Init(_self: PartyService, _context: any) end

function PartyService.setToastHandler(self: PartyService, callback: (Player?, string) -> ())
    self._onToast = callback
end

--[[
    Who the server can see standing on the departure platform.

    Supplied by LobbyService, which already measures occupancy from character
    positions every tick. Asking it rather than measuring again means an
    invitation and a boarding pass always agree about who is on the dais.
]]
function PartyService.setPlatformProvider(self: PartyService, provider: () -> { Player })
    self._platformProvider = provider
end

function PartyService._toast(self: PartyService, player: Player?, message: string)
    local handler = self._onToast
    if handler ~= nil then
        handler(player, message)
    end
end

local function now(): number
    return workspace:GetServerTimeNow()
end

function PartyService._partyOf(self: PartyService, player: Player): (string?, any)
    local partyId = self._partyByUser[player.UserId]
    if partyId == nil then
        return nil, nil
    end
    local state = self._parties[partyId]
    if state == nil then
        -- A roster that dissolved out from under a stale index. Clear rather
        -- than resurrect: an empty party would gladly accept an invitation.
        self._partyByUser[player.UserId] = nil
        return nil, nil
    end
    return partyId, state
end

--[[
    Whether these two people are travelling together, by user ID.

    Read by the town gate rather than by anything in the party flow: a town set
    to "invited" has to know who the founder asked along, and the party roster
    is the record of exactly that. An outstanding invitation counts, because
    being asked is the invitation -- a player who has been offered a seat and
    has not yet pressed JOIN was still chosen.

    By ID rather than by Player because the founder may have left the server
    and their user ID is what the town still remembers them by.
]]
function PartyService.sharesPartyWith(
    self: PartyService,
    firstUserId: number,
    secondUserId: number
): boolean
    if firstUserId == secondUserId then
        return true
    end
    local held = self._partyByUser[firstUserId]
    if held ~= nil then
        if self._partyByUser[secondUserId] == held then
            return true
        end
        if self._inviteByUser[secondUserId] == held then
            return true
        end
    end
    local theirs = self._partyByUser[secondUserId]
    return theirs ~= nil and self._inviteByUser[firstUserId] == theirs
end

--[[
    Whether these two may be put in a party together.

    Asked of the same authority quick chat asks -- one block reader for the
    whole game, because a suppression rule with two homes is a rule that stops
    being true in one of them. Absent a reader (a server built without the
    social service) nobody is blocked, which is the state this game shipped in
    before there was a reader at all.
]]
function PartyService._blocked(self: PartyService, first: Player, second: Player): boolean
    local reader = self._blockReader
    if reader == nil then
        return false
    end
    return reader(first.UserId, second.UserId) or reader(second.UserId, first.UserId)
end

function PartyService.setBlockReader(self: PartyService, reader: (number, number) -> boolean)
    self._blockReader = reader
end

function PartyService._store(self: PartyService, partyId: string, state: any)
    if state == nil then
        self._parties[partyId] = nil
        for userId, held in self._partyByUser do
            if held == partyId then
                self._partyByUser[userId] = nil
            end
        end
        for userId, held in self._inviteByUser do
            if held == partyId then
                self._inviteByUser[userId] = nil
            end
        end
        return
    end
    self._parties[partyId] = state
    for _, userId in self._partySession.memberIds(state) do
        self._partyByUser[userId] = partyId
    end
end

--[[
    Offer a seat to everyone else standing on the platform.

    A party is created only if there is somebody to ask. Pressing invite on an
    empty dais leaves no roster lying around, which matters because an
    existing party changes who boards first -- a party of one would quietly
    outrank the friend who walks up thirty seconds later.

    Anyone already in a party is skipped rather than refused. Two overlapping
    parties is a problem with no good answer at the platform, and the simplest
    honest rule is that you leave the one you are in before you join another.

    SAFETY-CHANNEL: party_invite -- a block skips a player here, silently and
    in both directions. Silently because the alternative tells the presser who
    has blocked them, which is a disclosure the platform deliberately does not
    make; both directions because an invitation is a two-way relationship and a
    seat offered to somebody you blocked is a seat beside them.
]]
function PartyService.invite(self: PartyService, player: Player): any
    local provider = self._platformProvider
    if provider == nil then
        return { accepted = false, reason = "no_platform" }
    end

    local standing = provider()
    local onPlatform = false
    local eligible: { Player } = {}
    for _, other in standing do
        if other == player then
            onPlatform = true
        elseif self._partyByUser[other.UserId] == nil and not self:_blocked(player, other) then
            table.insert(eligible, other)
        end
    end

    if not onPlatform then
        self:_toast(player, "STAND ON THE PLATFORM TO GATHER A PARTY")
        return { accepted = false, reason = "not_on_platform" }
    end
    if #eligible == 0 then
        self:_toast(player, "NOBODY ELSE IS STANDING HERE TO ASK")
        return { accepted = false, reason = "nobody_to_ask" }
    end

    local partyId, state = self:_partyOf(player)
    local createdHere = false
    if state == nil then
        local created, result = self._partySession.create(player.UserId, now())
        if created == nil then
            return { accepted = false, reason = result.reason }
        end
        partyId = created.partyId
        state = created
        createdHere = true
        self:_store(created.partyId, created)
    end

    local asked = 0
    local refusal: string? = nil
    for _, other in eligible do
        local nextState, result = self._partySession.invite(
            state,
            player.UserId,
            other.UserId,
            now(),
            self._config.MaxExpeditionPlayers
        )
        if result.accepted then
            state = nextState
            asked += 1
            self._inviteByUser[other.UserId] = partyId :: string
            self:_toast(
                other,
                string.format(
                    "%s ASKS YOU TO TRAVEL WITH THEM — JOIN OR DECLINE",
                    player.DisplayName
                )
            )
        else
            refusal = result.reason
        end
    end
    self:_store(partyId :: string, state)

    if asked == 0 then
        --[[
            A roster nobody joined must not survive the press. The paragraph
            above is only true if the party created a moment ago is taken
            back when every invitation was refused, because a stray party of
            one still outranks the friend who walks up thirty seconds later.

            The refusal is reported rather than assumed, too. "No room" was
            being said for every reason a party can turn somebody down, which
            makes the one message that will ever be read the one least likely
            to be true.
        ]]
        if createdHere then
            self:_store(partyId :: string, nil)
        end
        self:_toast(
            player,
            if refusal == "party_full"
                then "THERE IS NO ROOM LEFT IN YOUR PARTY"
                else "NOBODY HERE CAN BE ASKED RIGHT NOW"
        )
        return { accepted = false, reason = refusal or "nobody_to_ask" }
    end
    self:_toast(player, string.format("ASKED %d TO TRAVEL WITH YOU", asked))
    self._logger:info("party_invited", { partyId = partyId, asked = asked })
    return { accepted = true, asked = asked }
end

function PartyService.reply(self: PartyService, player: Player, accept: boolean): any
    local partyId = self._inviteByUser[player.UserId]
    local state = if partyId == nil then nil else self._parties[partyId]
    if state == nil then
        self._inviteByUser[player.UserId] = nil
        self:_toast(player, "NOBODY HAS ASKED YOU TO TRAVEL WITH THEM")
        return { accepted = false, reason = "no_invite" }
    end

    if not accept then
        local nextState = self._partySession.decline(state, player.UserId, now())
        self._inviteByUser[player.UserId] = nil
        self:_store(partyId :: string, nextState)
        self:_toast(player, "YOU TRAVEL ALONE")
        return { accepted = true, joined = false }
    end

    local nextState, result =
        self._partySession.accept(state, player.UserId, now(), self._config.MaxExpeditionPlayers)
    if not result.accepted then
        self._inviteByUser[player.UserId] = nil
        self:_toast(
            player,
            if result.reason == "party_full"
                then "THAT PARTY FILLED BEFORE YOU ANSWERED"
                else "THAT INVITATION HAS PASSED"
        )
        return { accepted = false, reason = result.reason }
    end

    self._inviteByUser[player.UserId] = nil
    self:_store(partyId :: string, nextState)
    for _, userId in self._partySession.memberIds(nextState) do
        local member = Players:GetPlayerByUserId(userId)
        if member ~= nil then
            self:_toast(
                member,
                string.format("PARTY OF %d — %s IS WITH YOU", result.size, player.DisplayName)
            )
        end
    end
    self._logger:info("party_joined", { partyId = partyId, size = result.size })
    return { accepted = true, joined = true }
end

function PartyService.leave(self: PartyService, player: Player): any
    local partyId, state = self:_partyOf(player)
    if state == nil then
        self:_toast(player, "YOU ARE NOT IN A PARTY")
        return { accepted = false, reason = "not_in_party" }
    end

    local nextState, result = self._partySession.leave(state, player.UserId, now())
    if not result.accepted then
        return { accepted = false, reason = result.reason }
    end
    self._partyByUser[player.UserId] = nil
    self:_store(partyId :: string, nextState)
    self:_toast(player, "YOU TRAVEL ALONE")

    if result.handedTo ~= nil then
        local leader = Players:GetPlayerByUserId(result.handedTo)
        if leader ~= nil then
            self:_toast(leader, "THE PARTY IS YOURS TO LEAD NOW")
        end
    end
    return { accepted = true, dissolved = result.dissolved == true }
end

--[[
    Re-order a boarding list so the party goes first.

    Called by LobbyService with everyone standing on the dais and the number
    of seats the chosen size allows. Before this, seats were spent in whatever
    order `Players:GetPlayers()` returned, so a bystander who wandered onto
    the platform could take one from somebody's party. Presence is still the
    platform's business: this only re-orders what it reports.
]]
function PartyService.boardingOrder(
    self: PartyService,
    ready: { Player },
    capacity: number
): { Player }
    local byUserId: { [number]: Player } = {}
    local userIds: { number } = {}
    for _, player in ready do
        byUserId[player.UserId] = player
        table.insert(userIds, player.UserId)
    end

    -- Whichever party has the most people on the dais is the one being
    -- boarded. With two parties standing on one platform somebody's run is
    -- going to be interrupted, and the larger group is the less bad answer.
    local best: any = nil
    local bestPresent = 0
    for _, partyId in self._partyByUser do
        local state = self._parties[partyId]
        if state ~= nil then
            local present = 0
            for _, userId in self._partySession.memberIds(state) do
                if byUserId[userId] ~= nil then
                    present += 1
                end
            end
            if present > bestPresent then
                best = state
                bestPresent = present
            end
        end
    end

    local ordered: { Player } = {}
    for _, userId in self._partySession.boardingOrder(best, userIds, capacity) do
        local player = byUserId[userId]
        if player ~= nil then
            table.insert(ordered, player)
        end
    end
    return ordered
end

--[[
    Form the party that is actually leaving, and name it.

    Called before the reserved server is asked for, because the ID has to ride
    the teleport payload. The party formed here is the boarding list rather
    than whatever roster existed at the lodge -- see PartySession's own note on
    why: a stranger who boarded is in that world too, and needs a way home
    from it.
]]
function PartyService.formDeparture(self: PartyService, boarding: { Player }): string?
    local userIds: { number } = {}
    for _, player in boarding do
        table.insert(userIds, player.UserId)
    end

    local formed, result = self._partySession.createForDeparture(userIds, now())
    if formed == nil then
        self._logger:warn("party_departure_unformed", { reason = result.reason })
        return nil
    end
    local sealed = self._partySession.depart(formed, now())

    -- The lodge-side parties these people were in are finished: they have
    -- left, and the rosters that decided their boarding order have nothing
    -- left to decide.
    for _, player in boarding do
        local partyId = self._partyByUser[player.UserId]
        self._partyByUser[player.UserId] = nil
        self._inviteByUser[player.UserId] = nil
        if partyId ~= nil and self._parties[partyId] ~= nil then
            local remaining = self._partySession.leave(self._parties[partyId], player.UserId, now())
            self:_store(partyId, remaining)
        end
    end

    --[[
        Held in the one departing slot, not filed with the live rosters. A
        sealed party is read exactly once, by issueTickets a moment later, and
        adding it to `_parties` would grow that table by one entry per launch
        for the life of the server with nothing ever reading them again.
    ]]
    self._departing = sealed
    self._logger:info("party_departed", { partyId = sealed.partyId, size = #userIds })
    return sealed.partyId
end

--[[
    Write each traveller their way back.

    Called after the reserved server exists and before the teleport, because
    a profile is saved when its player leaves and a ticket written afterwards
    would be a ticket written to a profile nobody is holding.
]]
function PartyService.issueTickets(
    self: PartyService,
    partyId: string,
    boarding: { Player },
    accessCode: string
)
    local state = self._departing
    if state == nil or state.partyId ~= partyId then
        self._logger:warn("party_tickets_unissued", { partyId = partyId })
        return
    end
    -- The slot is spent whether or not every write lands. A departure is read
    -- once, and leaving it filled would hand the next launch's tickets to the
    -- party before it.
    self._departing = nil

    local issued = 0
    for _, player in boarding do
        local ticket, result =
            self._partySession.issueTicket(state, player.UserId, accessCode, now())
        if ticket == nil then
            self._logger:warn("party_ticket_refused", { reason = result.reason })
        elseif self._profileService:setRejoinTicket(player, ticket) then
            issued += 1
        else
            --[[
                A traveller who boards without a ticket has no way back and no
                sign that anything went wrong, which is the quietest failure
                in this whole wave. It is worth a line each rather than only
                a total, because the total looks fine until somebody counts.
            ]]
            self._logger:warn("party_ticket_unwritten", { partyId = partyId })
        end
    end
    self._logger:info(
        "party_tickets_issued",
        { partyId = partyId, issued = issued, boarded = #boarding }
    )
end

--[[
    Tell this server which party's run it is.

    Read from the teleport payload by LobbyService. Without it a member who
    dropped and came back to the same reserved server would be offered a
    rejoin into the world they are standing in, forever.
]]
function PartyService.adoptRun(self: PartyService, partyId: string)
    if self._runPartyId == nil then
        self._runPartyId = partyId
        self._logger:info("party_run_adopted", { partyId = partyId })
    end
end

function PartyService.rejoin(self: PartyService, player: Player): any
    local read = self._partySession.readTicket(
        self._profileService:rejoinTicket(player),
        now(),
        self._runPartyId
    )
    if not read.rejoin then
        if read.reason == "expired" then
            self._profileService:setRejoinTicket(player, nil)
            self:_toast(player, "THAT ROAD HAS GONE COLD — THE PLATFORM IS STILL HERE")
        else
            self:_toast(player, "THERE IS NOWHERE TO GO BACK TO")
        end
        return { accepted = false, reason = read.reason }
    end

    local placeId = game.PlaceId
    if placeId == 0 then
        -- Studio and unpublished builds cannot resolve a reserved server, the
        -- same limit the departure teleport lives with.
        self._logger:info("party_rejoin_skipped", { reason = "unpublished_place" })
        self:_toast(player, "THE ROAD BACK NEEDS A PUBLISHED WORLD")
        return { accepted = false, reason = "unpublished_place" }
    end

    local sent = pcall(function()
        TeleportService:TeleportToPrivateServer(placeId, read.accessCode, { player })
    end)
    if not sent then
        --[[
            The ticket is kept. A teleport can fail for a minute and succeed
            on the next press, and throwing away the only way back to punish a
            transient failure is the worse of the two mistakes. It expires on
            its own soon enough.
        ]]
        self._logger:warn("party_rejoin_failed", { partyId = read.partyId })
        self:_toast(player, "THE ROAD DID NOT OPEN — TRY AGAIN")
        return { accepted = false, reason = "teleport_failed" }
    end

    self._logger:info("party_rejoin_started", { partyId = read.partyId })
    return { accepted = true }
end

--[[
    What a client may be told about parties.

    Every field here is presentation. The rejoin half comes from
    PartySession.publicTicket rather than from the stored ticket, so the access
    code is absent by construction rather than by omission.

    SAFETY-CHANNEL: party_roster -- the only party information that reaches a
    player: a size, whether they lead, and two display names. No user IDs, no
    text anybody wrote, and no way to see a roster of a party you are not in or
    have not been asked into. A player cannot be put in a party with somebody
    they blocked by that person's action, because the invite that would do it
    is skipped upstream.
]]
function PartyService.snapshot(self: PartyService, player: Player): any
    local _, state = self:_partyOf(player)
    local inviteFrom: string? = nil
    local invitePartyId = self._inviteByUser[player.UserId]
    if invitePartyId ~= nil then
        local inviteState = self._parties[invitePartyId]
        local invite = self._partySession.pendingInvite(inviteState, player.UserId, now())
        if invite == nil then
            self._inviteByUser[player.UserId] = nil
        else
            local from = Players:GetPlayerByUserId(invite.fromUserId)
            inviteFrom = if from ~= nil then from.DisplayName else "SOMEONE"
        end
    end

    local leaderName: string? = nil
    if state ~= nil then
        local leader = Players:GetPlayerByUserId(state.leaderUserId)
        leaderName = if leader ~= nil then leader.DisplayName else nil
    end

    return {
        inParty = state ~= nil,
        size = self._partySession.size(state),
        leader = state ~= nil and state.leaderUserId == player.UserId,
        leaderName = leaderName,
        inviteFrom = inviteFrom,
        rejoin = self._partySession.publicTicket(
            self._profileService:rejoinTicket(player),
            now(),
            self._runPartyId
        ),
    }
end

function PartyService.Start(self: PartyService)
    Players.PlayerRemoving:Connect(function(player: Player)
        local partyId, state = self:_partyOf(player)
        if state ~= nil then
            self:_store(partyId :: string, self._partySession.leave(state, player.UserId, now()))
        end
        self._partyByUser[player.UserId] = nil
        self._inviteByUser[player.UserId] = nil
    end)

    --[[
        The offer is made once, when the profile is loaded, because that is
        the first moment the ticket can be read at all. It is a toast and a
        button rather than an automatic teleport: a player who deliberately
        left a run and came back to town should not be dragged out of it by
        the game deciding it knows better.
    ]]
    self._profileService:onLoaded(function(player: Player)
        local public = self._partySession.publicTicket(
            self._profileService:rejoinTicket(player),
            now(),
            self._runPartyId
        )
        if public == nil then
            return
        end
        self:_toast(
            player,
            string.format("YOUR PARTY OF %d IS STILL OUT THERE — REJOIN THEM", public.partySize)
        )
    end)
end

return PartyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">PerformanceService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Samples a live session against the performance budgets.

    Milestone 3's exit gate wants a 30-minute run on a target device to meet
    frame, memory, join, and network budgets. This is the thing that makes that
    sentence produce numbers: it collects samples while people play and hands
    them to PerformanceBudget, which decides whether the run passed.

    Split of responsibility, because it decides what is trustworthy:

      * The server measures what it owns -- its own heartbeat, how long each
        player waited to become interactive, and how much remote traffic each
        client actually sent. None of it can be influenced by a client.
      * The client reports what only it can see -- its frame rate, its worst
        stall, its memory. That arrives over a separate telemetry remote,
        bounded and rate limited, and grants nothing.

    Samples are capped so a server left running overnight cannot grow this into
    a leak. The cap drops the oldest, which keeps the recent run intact -- the
    30 minutes anyone is actually reporting on.

    It also owns the **session lifecycle** the release gates are read from, and
    that is not a second job: join-to-interactive was already measured here,
    and a session's start, its end and the fact that it never started are the
    same clock read at three moments. Splitting them across services is how a
    join failure rate ends up counted against a denominator gathered somewhere
    else.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PerformanceService = {}
PerformanceService.__index = PerformanceService
PerformanceService.Name = "PerformanceService"

local MAX_SAMPLES = 5000

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type PerformanceService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _performanceBudget: any,
        _sessionSegment: any,
        _analyticsService: any,
        _samples: { [string]: { number } },
        _joinedAt: { [Player]: number },
        _interactive: { [Player]: boolean },
        _actionCounts: { [Player]: number },
        _lastReportAt: { [Player]: number },
        _lastHeardAt: { [Player]: number },
        _lastIntroductionAt: { [Player]: number },
        _platform: { [Player]: string },
        _lastFps: { [Player]: number },
        _frames: number,
        _windowStartedAt: number,
        _heartbeat: RBXScriptConnection?,
        _startedAt: number,
        _lastBreachLogAt: { [string]: number },
        _shuttingDown: boolean,
        _soakProbe: any,
        _soakRun: any,
        _soakCounters: { [string]: () -> number? },
    },
    PerformanceService
))

function PerformanceService.new(
    logger: Logger,
    config: any,
    performanceBudget: any,
    sessionSegment: any,
    analyticsService: any,
    soakProbe: any
): PerformanceService
    return setmetatable({
        Name = PerformanceService.Name,
        _logger = logger,
        _config = config,
        _performanceBudget = performanceBudget,
        _sessionSegment = sessionSegment,
        _analyticsService = analyticsService,
        _samples = {},
        _joinedAt = {},
        _interactive = {},
        _actionCounts = {},
        _lastReportAt = {},
        _lastHeardAt = {},
        _lastIntroductionAt = {},
        _platform = {},
        _lastFps = {},
        _frames = 0,
        _windowStartedAt = 0,
        _heartbeat = nil,
        _startedAt = 0,
        _lastBreachLogAt = {},
        _shuttingDown = false,
        _soakProbe = soakProbe,
        _soakRun = nil,
        _soakCounters = {},
    }, PerformanceService)
end

--[[
    The soak half, which asks a different question from everything above.

    The budgets judge whether a run felt good. A soak asks whether the
    server is holding on to things, and that only shows up over cycles --
    so this samples once per town cycle at one fixed phase and hands the
    series to SoakProbe, which owns every rule about what a series means.

    The counters are injected rather than reached for. This service has no
    business knowing how many creatures EnemyService believes in or how
    large a profile encodes to, and a soak that reached across the whole
    server for its own numbers would be a second copy of every service's
    internals, going stale on its own schedule.

    It is off unless something turns it on. Reading instance counts costs a
    full descendant walk, which is affordable once a cycle and not
    affordable as a thing that happens on every server forever for a
    measurement nobody is reading.
]]
function PerformanceService.setSoakCounters(
    self: PerformanceService,
    counters: { [string]: () -> number? }
)
    self._soakCounters = counters
end

function PerformanceService.beginSoak(self: PerformanceService, phase: string): boolean
    if self._soakProbe == nil then
        return false
    end
    self._soakRun = self._soakProbe.begin(phase)
    self._logger:info("soak_started", { phase = phase })
    return true
end

function PerformanceService.isSoaking(self: PerformanceService): boolean
    return self._soakRun ~= nil
end

--[[
    One cycle's reading. A counter that errors or answers with something
    that is not a number is left out of the sample entirely rather than
    filled in with a zero -- a zero is a reading, and an absent metric is
    what SoakProbe's `missing` list exists to report.
]]
function PerformanceService.sampleSoak(self: PerformanceService, cycle: number, phase: string): any
    local run = self._soakRun
    if run == nil then
        return nil
    end

    local counts: { [string]: number } = {}
    for metricId, counter in self._soakCounters do
        local ok, value = pcall(counter)
        if ok and type(value) == "number" then
            counts[metricId] = value
        else
            self._logger:warn("soak_counter_failed", { metric = metricId })
        end
    end

    local nextRun, result = self._soakProbe.record(run, cycle, phase, counts)
    if not result.accepted then
        -- Loudly, because a refused sample is a sampler wired to the wrong
        -- hook, and a soak quietly collecting nothing is the exact shape of
        -- a gate that passes because nobody measured it.
        self._logger:warn("soak_sample_refused", { cycle = cycle, reason = result.reason })
        return nil
    end
    self._soakRun = nextRun

    local report = self._soakProbe.report(nextRun)
    self._logger:info("soak_sample", {
        cycle = cycle,
        verdict = report.verdict,
        cycles = report.cycles,
        instances = counts.instances,
        enemies = counts.tracked_enemies,
        residue = counts.player_residue,
        profileBytes = counts.profile_bytes,
    })
    return report
end

function PerformanceService.soakReport(self: PerformanceService): any
    local run = self._soakRun
    if run == nil then
        return nil
    end
    return self._soakProbe.report(run)
end

function PerformanceService._record(self: PerformanceService, metricId: string, value: number)
    if not self._performanceBudget.isValidMetric(metricId) then
        return
    end
    local samples = self._samples[metricId]
    if samples == nil then
        samples = {}
        self._samples[metricId] = samples
    end
    table.insert(samples, value)
    if #samples > MAX_SAMPLES then
        table.remove(samples, 1)
    end

    -- A breach is worth saying out loud while the run is still happening, so
    -- whoever is holding the phone knows which minute to look at later. Once
    -- per metric per two minutes: a machine that sits at 15 fps otherwise
    -- prints the same warning every second and buries every real error in
    -- the log (observed: hundreds per session drowning a rejection that was
    -- actually being hunted).
    if self._performanceBudget.classify(metricId, value) == "breach" then
        local now = os.clock()
        local lastAt = self._lastBreachLogAt[metricId]
        if lastAt == nil or now - lastAt >= 120 then
            self._lastBreachLogAt[metricId] = now
            self._logger:warn("performance_budget_breach", {
                metric = metricId,
                value = value,
            })
        end
    end
end

--[[
    How a session finished, decided from what a server can actually see.

    Roblox does not tell a server that a client crashed; PlayerRemoving fires
    the same way for a player who quit and a player whose phone died. What
    differs is the telemetry: a client reports on a fixed interval right up to
    the moment it closes, so a session whose last report is several intervals
    stale at the moment the player disappears stopped rather than left.

    Three intervals of slack, deliberately generous. A client that missed one
    report to a stall is not a crash, and calling it one would fail the
    crash-free gate on the devices the gate exists to protect. A shutdown is
    named separately because a server closing is not a player's session ending
    badly, and counting a scheduled restart as fifty crashes is how a gate
    gets ignored.
]]
function PerformanceService._sessionEndReason(self: PerformanceService, player: Player): string
    if self._shuttingDown then
        return "shutdown"
    end
    -- Anything the client said, not only a sample. A player who becomes
    -- interactive and quits inside the first reporting interval has sent an
    -- introduction and no sample, and reading only samples would file that
    -- perfectly ordinary exit as a crash.
    local lastAt = self._lastHeardAt[player]
    if lastAt == nil then
        -- Never said anything at all. If they never became interactive this is
        -- a join that did not finish; if they did, it is a client that went
        -- quiet immediately, which is the same shape as a crash.
        return if self._interactive[player] then "dropped" else "left"
    end
    if os.clock() - lastAt > self._config.PerformanceReportIntervalSeconds * 3 then
        return "dropped"
    end
    return "left"
end

function PerformanceService._closeSession(self: PerformanceService, player: Player)
    local joinedAt = self._joinedAt[player]
    if joinedAt == nil then
        return
    end
    local interactive = self._interactive[player] == true
    local duration = os.clock() - joinedAt
    local platform = self._platform[player] or "unknown"
    local reason = self:_sessionEndReason(player)

    -- A player who left before the world would answer them never had a
    -- session, and counting them as one that ended cleanly hides the join
    -- failure rate inside the crash-free rate.
    -- GATE-METRIC: join_failed
    if not interactive and reason ~= "shutdown" then
        self._analyticsService:joinFailed(player, "left_before_interactive", duration, platform)
    end

    -- GATE-METRIC: session_ended
    self._analyticsService:sessionEnded(
        player.UserId,
        reason,
        duration,
        interactive,
        platform,
        self._sessionSegment.id(platform, self._sessionSegment.tier(self._lastFps[player]))
    )
end

function PerformanceService.Init(self: PerformanceService, _context: any)
    Players.PlayerAdded:Connect(function(player: Player)
        self._joinedAt[player] = os.clock()
        self._actionCounts[player] = 0
    end)
    Players.PlayerRemoving:Connect(function(player: Player)
        self:_closeSession(player)
        self._joinedAt[player] = nil
        self._interactive[player] = nil
        self._actionCounts[player] = nil
        self._lastReportAt[player] = nil
        self._lastHeardAt[player] = nil
        self._lastIntroductionAt[player] = nil
        self._platform[player] = nil
        self._lastFps[player] = nil
    end)
end

function PerformanceService.Start(self: PerformanceService)
    self._startedAt = os.clock()
    self._windowStartedAt = os.clock()

    -- Heartbeat rate is counted over a one-second window rather than taken
    -- from a single delta. One long frame is a spike, which the client already
    -- reports; what the budget asks about the server is the sustained rate.
    self._heartbeat = RunService.Heartbeat:Connect(function()
        self._frames += 1
        local now = os.clock()
        local elapsed = now - self._windowStartedAt
        if elapsed < 1 then
            return
        end

        self:_record("server_heartbeat_hz", self._frames / elapsed)

        for player, count in self._actionCounts do
            if count > 0 then
                self:_record("remote_actions_per_second", count / elapsed)
                self._actionCounts[player] = 0
            end
        end

        self._frames = 0
        self._windowStartedAt = now
    end)

    -- A server closing is not fifty players crashing, and the only moment that
    -- distinction can be drawn is before the PlayerRemoving storm that follows.
    game:BindToClose(function()
        self._shuttingDown = true
    end)

    self._logger:info("performance_service_started", {
        memoryCeilingMb = self._config.BaselinePhoneMemoryCeilingMb,
    })
end

--[[
    Called when a player reaches interactive play. Only the first call counts:
    the budget is join-to-interactive, not every later state load.

    `createdAt` is the profile's own first-seen stamp and turns into the number
    D1 and D7 return are counted from. It is passed in rather than looked up
    because this service has no business holding a profile; the caller is
    already inside the load that produced one.
]]
function PerformanceService.markInteractive(
    self: PerformanceService,
    player: Player,
    createdAt: number?
)
    if self._interactive[player] then
        return
    end
    local joinedAt = self._joinedAt[player]
    if joinedAt == nil then
        return
    end
    self._interactive[player] = true
    local joinSeconds = os.clock() - joinedAt
    self:_record("join_seconds", joinSeconds)

    local elapsedDays = if createdAt == nil or createdAt <= 0
        then 0
        else math.max(0, math.floor((os.time() - createdAt) / 86400))
    -- GATE-METRIC: interactive_session
    self._analyticsService:sessionStarted(
        player,
        joinSeconds,
        self._platform[player] or "unknown",
        elapsedDays
    )
end

function PerformanceService.noteAction(self: PerformanceService, player: Player)
    local count = self._actionCounts[player]
    if count ~= nil then
        self._actionCounts[player] = count + 1
    end
end

--[[
    Take a client's frame and memory sample.

    Rate limited on the server's clock rather than trusting the client to keep
    to the interval, and every field is bounded before it reaches the report.
    A refused report is counted in the log, not silently dropped, because a
    client that cannot report is itself a symptom worth seeing.
]]
function PerformanceService.acceptClientReport(
    self: PerformanceService,
    player: Player,
    payload: any
): boolean
    local now = os.clock()
    local interval = self._config.PerformanceReportIntervalSeconds

    --[[
        A client saying what it is, which arrives on its own message with no
        frame data in it -- it is sent on the first frame and there is nothing
        to sample for another whole interval.

        It gets its own limit rather than skipping the sample one. Returning
        early past a rate limit is how a bounded remote becomes an unbounded
        one, and the shape a client would reach for is exactly this: a payload
        the handler answers before it has counted it. Accepted rather than
        rejected so a legitimate introduction does not print the warning that
        means "a client is sending nonsense", which is the line somebody
        hunting a real problem would be reading.
    ]]
    local platform = self._sessionSegment.platformOf(payload)
    if self._sessionSegment.isIntroduction(payload) then
        local lastIntroductionAt = self._lastIntroductionAt[player]
        if lastIntroductionAt ~= nil and now - lastIntroductionAt < interval then
            return false
        end
        self._lastIntroductionAt[player] = now
        self._lastHeardAt[player] = now
        self._platform[player] = platform
        return true
    end
    if platform ~= nil then
        self._platform[player] = platform
    end

    local lastAt = self._lastReportAt[player]
    if lastAt ~= nil and now - lastAt < interval * 0.5 then
        return false
    end

    local sample = self._performanceBudget.sanitizeClientReport(payload)
    if sample == nil then
        self._logger:warn("performance_report_rejected", { player = player.UserId })
        return false
    end
    self._lastReportAt[player] = now
    self._lastHeardAt[player] = now
    self._lastFps[player] = sample.fps

    self:_record("client_fps", sample.fps)
    self:_record("frame_spike_ms", sample.spikeMs)
    self:_record(
        "client_memory_headroom",
        self._performanceBudget.memoryHeadroom(
            sample.memoryMb,
            self._config.BaselinePhoneMemoryCeilingMb
        )
    )
    return true
end

function PerformanceService.report(self: PerformanceService): any
    return self._performanceBudget.report(self._samples)
end

function PerformanceService.formattedReport(self: PerformanceService): { string }
    local report = self:report()
    local lines = self._performanceBudget.format(report)
    table.insert(
        lines,
        1,
        string.format(
            "%s after %.0f min, %d players",
            string.upper(report.verdict),
            (os.clock() - self._startedAt) / 60,
            #Players:GetPlayers()
        )
    )
    return lines
end

function PerformanceService.Stop(self: PerformanceService)
    local heartbeat = self._heartbeat
    if heartbeat ~= nil then
        heartbeat:Disconnect()
        self._heartbeat = nil
    end
end

return table.freeze(PerformanceService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="142">
          <Properties>
            <string name="Name">PhaseService</string>
            <string name="Source"><![CDATA[--!strict

local PhaseService = {}
PhaseService.__index = PhaseService
PhaseService.Name = "PhaseService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type PhaseService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _enemyService: any,
        _nightSchedule: any,
        _duskSeconds: number,
        _nightSeconds: number,
        _phase: string,
        _phaseEndsAt: number,
        _active: boolean,
        _generation: number,
        _onChanged: ((string?) -> ())?,
        _onComplete: (() -> ())?,
    },
    PhaseService
))

function PhaseService.new(
    logger: Logger,
    worldService: any,
    enemyService: any,
    nightSchedule: any,
    duskSeconds: number,
    nightSeconds: number
): PhaseService
    return setmetatable({
        Name = PhaseService.Name,
        _logger = logger,
        _worldService = worldService,
        _enemyService = enemyService,
        _nightSchedule = nightSchedule,
        _duskSeconds = duskSeconds,
        _nightSeconds = nightSeconds,
        _phase = "day",
        _phaseEndsAt = 0,
        _active = false,
        _generation = 0,
        _onChanged = nil,
        _onComplete = nil,
    }, PhaseService)
end

function PhaseService.Init(_self: PhaseService, _context: any) end

function PhaseService.Start(_self: PhaseService) end

function PhaseService.setChangedHandler(self: PhaseService, callback: (string?) -> ())
    self._onChanged = callback
end

function PhaseService.setCompleteHandler(self: PhaseService, callback: () -> ())
    self._onComplete = callback
end

function PhaseService._notify(self: PhaseService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

local function waitUntil(target: number, generation: number, service: PhaseService): boolean
    while workspace:GetServerTimeNow() < target do
        if service._generation ~= generation or not service._active then
            return false
        end
        task.wait(0.15)
    end
    return service._generation == generation and service._active
end

function PhaseService.startFirstNight(self: PhaseService): boolean
    if self._active then
        return false
    end

    self._active = true
    self._generation += 1
    local generation = self._generation
    self._phase = "dusk"
    self._phaseEndsAt = workspace:GetServerTimeNow() + self._duskSeconds
    self._worldService:setDusk(true)
    self:_notify("DUSK FALLS — PREPARE THE LIGHT")
    self._logger:info("first_night_dusk_started", { duration = self._duskSeconds })

    task.spawn(function()
        if not waitUntil(self._phaseEndsAt, generation, self) then
            return
        end

        self._phase = "night"
        local nightStartedAt = workspace:GetServerTimeNow()
        self._phaseEndsAt = nightStartedAt + self._nightSeconds
        self._worldService:setNight(true)
        self._enemyService:startNight()
        self:_notify("NIGHT HAS ARRIVED")
        self._logger:info("first_night_started", { duration = self._nightSeconds })

        for _, beat in self._nightSchedule.beats(self._nightSeconds) do
            if not waitUntil(nightStartedAt + beat.at, generation, self) then
                return
            end
            if beat.kind == "spawn" then
                self._enemyService:spawn(beat.enemyId)
            elseif beat.kind == "breach" then
                self._enemyService:setBreach()
            elseif beat.kind == "warning" then
                self:_notify("THE FOREST GOES QUIET")
            end
        end

        if not waitUntil(self._phaseEndsAt, generation, self) then
            return
        end
        self:_finishFirstNight()
    end)

    return true
end

function PhaseService.ensureFirstNight(self: PhaseService)
    if not self._active and self._phase ~= "reveal" then
        self:startFirstNight()
    end
end

function PhaseService._finishFirstNight(self: PhaseService)
    self._active = false
    self._phase = "reveal"
    self._phaseEndsAt = 0
    self._enemyService:stopNight()
    self._worldService:setNight(false)
    self._worldService:setBeaconVisible(true)
    self:_notify("DAWN BREAKS — A MEMORY CALLS")
    -- The night resolving, which is a server fact. Each player's own crossing
    -- is `first_night_completed` from the tutorial, and the two are named
    -- apart on purpose: a gate that reads a completion rate per player must
    -- not be able to read this one by accident.
    self._logger:info("first_night_resolved")

    local callback = self._onComplete
    if callback ~= nil then
        callback()
    end
end

function PhaseService.snapshot(self: PhaseService): any
    return {
        phase = self._phase,
        phaseEndsAt = self._phaseEndsAt,
        nightActive = self._active and self._phase == "night",
        lanternHealth = self._enemyService:lanternHealth(),
        enemyCount = self._enemyService:activeCount(),
    }
end

function PhaseService.isNightActive(self: PhaseService): boolean
    return self._active and self._phase == "night"
end

function PhaseService.hasCompletedFirstNight(self: PhaseService): boolean
    return self._phase == "reveal"
end

return table.freeze(PhaseService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="143">
          <Properties>
            <string name="Name">PlayerCombatService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PlayerCombatService = {}
PlayerCombatService.__index = PlayerCombatService
PlayerCombatService.Name = "PlayerCombatService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type PlayerCombatService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _combatState: any,
        _statusEffectState: any,
        _featureFlags: any,
        _survivalService: any,
        _analyticsService: any,
        _equipmentStatsProvider: ((Player) -> any)?,
        _states: { [Player]: any },
        _statusStates: { [Player]: any },
        _lastPublishedStamina: { [Player]: number },
        _lastPublishedDrowsy: { [Player]: boolean },
        _lastPublishedRooted: { [Player]: boolean },
        _lastRejectionAt: { [Player]: number },
        _nextPublishAt: { [Player]: number },
        _onChanged: ((Player, string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
    },
    PlayerCombatService
))

local function humanoid(player: Player): Humanoid?
    local character = player.Character
    return if character == nil then nil else character:FindFirstChildOfClass("Humanoid")
end

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

function PlayerCombatService.new(
    logger: Logger,
    config: any,
    combatState: any,
    statusEffectState: any,
    featureFlags: any,
    survivalService: any,
    analyticsService: any
): PlayerCombatService
    return setmetatable({
        Name = PlayerCombatService.Name,
        _logger = logger,
        _config = config,
        _combatState = combatState,
        _statusEffectState = statusEffectState,
        _featureFlags = featureFlags,
        _survivalService = survivalService,
        _analyticsService = analyticsService,
        _equipmentStatsProvider = nil,
        _states = {},
        _statusStates = {},
        _lastPublishedStamina = {},
        _lastPublishedDrowsy = {},
        _lastPublishedRooted = {},
        _lastRejectionAt = {},
        _nextPublishAt = {},
        _onChanged = nil,
        _heartbeat = nil,
    }, PlayerCombatService)
end

function PlayerCombatService.setEquipmentStatsProvider(
    self: PlayerCombatService,
    provider: (Player) -> any
)
    self._equipmentStatsProvider = provider
end

function PlayerCombatService._staminaRegenMultiplier(
    self: PlayerCombatService,
    player: Player
): number
    local provider = self._equipmentStatsProvider
    if provider == nil then
        return 1
    end
    local stats = provider(player)
    -- The held tool's endurance identity rides the attribute channel the
    -- tool selector maintains (the fishing kit's patience), multiplied
    -- into the same clamp equipment already lives inside.
    local toolRegen = tonumber(player:GetAttribute("LastLightToolStaminaRegen")) or 1
    return math.clamp(
        (
            if type(stats) == "table" and type(stats.staminaRegenMultiplier) == "number"
                then stats.staminaRegenMultiplier
                else 1
        ) * math.clamp(toolRegen, 0.75, 1.25),
        0.75,
        1.5
    )
end

function PlayerCombatService.Init(_self: PlayerCombatService, _context: any) end

function PlayerCombatService.setChangedHandler(
    self: PlayerCombatService,
    callback: (Player, string?) -> ()
)
    self._onChanged = callback
end

function PlayerCombatService._notify(self: PlayerCombatService, player: Player, message: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(player, message)
    end
end

function PlayerCombatService._syncPlayer(self: PlayerCombatService, player: Player)
    local state = self._states[player]
    if state == nil then
        return
    end
    local now = workspace:GetServerTimeNow()
    local snapshot = self._combatState.snapshot(state, now)
    local statusState = self._statusStates[player] or self._statusEffectState.create()
    local status = self._statusEffectState.snapshot(statusState, now)
    local dodgeActive = self._featureFlags:isEnabled("combat_mobility_enabled")
        and snapshot.dodgeActive
    player:SetAttribute("LastLightStamina", snapshot.stamina)
    player:SetAttribute("LastLightMaxStamina", snapshot.maxStamina)
    player:SetAttribute("LastLightSprinting", snapshot.sprinting)
    player:SetAttribute("LastLightDodging", dodgeActive)
    player:SetAttribute("LastLightDodgeActiveUntil", snapshot.dodgeActiveUntil)
    player:SetAttribute("LastLightDodgeReadyAt", snapshot.dodgeReadyAt)
    player:SetAttribute("LastLightDrowsy", status.drowsy)
    player:SetAttribute("LastLightDrowsyUntil", status.drowsyUntil)
    player:SetAttribute("LastLightRooted", status.rooted)
    player:SetAttribute("LastLightRootedUntil", status.rootedUntil)
    player:SetAttribute("LastLightShielded", status.shielded)
    player:SetAttribute("LastLightShieldUntil", status.shieldUntil)
    player:SetAttribute("LastLightStaminaRegenMultiplier", self:_staminaRegenMultiplier(player))

    local activeHumanoid = humanoid(player)
    if activeHumanoid ~= nil then
        -- The climbing kit's sure-footedness applies only while actually
        -- sprinting: walking pace and the downed crawl stay everyone's.
        local toolSprint =
            math.clamp(tonumber(player:GetAttribute("LastLightToolSprintSpeed")) or 1, 1, 1.15)
        activeHumanoid.WalkSpeed = if not self._survivalService:canAct(player)
            then self._config.DownedWalkSpeed
            elseif snapshot.sprinting then self._config.SprintWalkSpeed
                * status.movementMultiplier
                * toolSprint
            else self._config.BaseWalkSpeed * status.movementMultiplier
    end
end

function PlayerCombatService._markPublished(self: PlayerCombatService, player: Player, now: number)
    local state = self._states[player]
    if state == nil then
        return
    end
    local snapshot = self._combatState.snapshot(state, now)
    self._lastPublishedStamina[player] = snapshot.stamina
    self._nextPublishAt[player] = now + 0.25
end

function PlayerCombatService._bindPlayer(self: PlayerCombatService, player: Player)
    if self._states[player] ~= nil then
        return
    end
    local now = workspace:GetServerTimeNow()
    self._states[player] = self._combatState.create(now)
    self._statusStates[player] = self._statusEffectState.create()
    self._lastPublishedStamina[player] = self._config.MaxStamina
    self._lastPublishedDrowsy[player] = false
    self._lastPublishedRooted[player] = false
    self._nextPublishAt[player] = now

    player.CharacterAdded:Connect(function(character: Model)
        local resetAt = workspace:GetServerTimeNow()
        self._states[player] = self._combatState.create(resetAt)
        self._statusStates[player] = self._statusEffectState.create()
        self._lastPublishedStamina[player] = self._config.MaxStamina
        self._lastPublishedDrowsy[player] = false
        self._lastPublishedRooted[player] = false
        self._nextPublishAt[player] = resetAt
        task.spawn(function()
            local activeHumanoid = character:WaitForChild("Humanoid", 8)
            if
                activeHumanoid ~= nil
                and activeHumanoid:IsA("Humanoid")
                and player.Parent ~= nil
            then
                self:_syncPlayer(player)
                self:_notify(player, nil)
            end
        end)
    end)
    self:_syncPlayer(player)
end

function PlayerCombatService.Start(self: PlayerCombatService)
    Players.PlayerAdded:Connect(function(player: Player)
        self:_bindPlayer(player)
    end)
    Players.PlayerRemoving:Connect(function(player: Player)
        self._states[player] = nil
        self._statusStates[player] = nil
        self._lastPublishedStamina[player] = nil
        self._lastPublishedDrowsy[player] = nil
        self._lastPublishedRooted[player] = nil
        self._lastRejectionAt[player] = nil
        self._nextPublishAt[player] = nil
    end)
    for _, player in Players:GetPlayers() do
        self:_bindPlayer(player)
    end

    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.1 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
end

function PlayerCombatService._step(self: PlayerCombatService, now: number)
    local enabled = self._featureFlags:isEnabled("combat_mobility_enabled")
    for player, state in self._states do
        -- Read real movement from the humanoid so a player standing still with
        -- run toggled on is not charged for going nowhere.
        local activeHumanoid = humanoid(player)
        local moving = activeHumanoid ~= nil and activeHumanoid.MoveDirection.Magnitude > 0.05
        local nextState = self._combatState.advance(
            state,
            now,
            enabled and self._survivalService:canAct(player),
            self:_staminaRegenMultiplier(player),
            moving
        )
        self._states[player] = nextState

        local snapshot = self._combatState.snapshot(nextState, now)
        local statusState = self._statusStates[player] or self._statusEffectState.create()
        local status = self._statusEffectState.snapshot(statusState, now)
        local lastStamina = self._lastPublishedStamina[player]
        local nextPublishAt = self._nextPublishAt[player] or now
        local resourcePublish = lastStamina ~= snapshot.stamina and now >= nextPublishAt
        local sprintChanged = state.sprinting ~= nextState.sprinting
        local dodgeChanged = player:GetAttribute("LastLightDodging")
            ~= (enabled and snapshot.dodgeActive)
        local drowsyChanged = self._lastPublishedDrowsy[player] ~= status.drowsy
        local rootedChanged = self._lastPublishedRooted[player] ~= status.rooted
        if resourcePublish or sprintChanged or dodgeChanged or drowsyChanged or rootedChanged then
            self:_syncPlayer(player)
        end
        if drowsyChanged then
            self._lastPublishedDrowsy[player] = status.drowsy
            self:_notify(
                player,
                if status.drowsy then "DROWSY — KEEP MOVING" else "DROWSINESS CLEARED"
            )
        end
        if rootedChanged then
            self._lastPublishedRooted[player] = status.rooted
            self:_notify(
                player,
                if status.rooted then "ROOTED — KEEP MOVING" else "ROOTS RELEASED"
            )
        end
        if resourcePublish then
            self:_markPublished(player, now)
            self:_notify(player, nil)
        end
    end
end

function PlayerCombatService.applyRooted(
    self: PlayerCombatService,
    player: Player,
    duration: number,
    multiplier: number
): boolean
    local state = self._states[player]
    local statusState = self._statusStates[player]
    if state == nil or statusState == nil or not self._survivalService:canAct(player) then
        return false
    end
    local now = workspace:GetServerTimeNow()
    local nextState, _result =
        self._combatState.setSprint(state, false, now, true, self:_staminaRegenMultiplier(player))
    self._states[player] = nextState
    self._statusStates[player] =
        self._statusEffectState.applyRooted(statusState, now, duration, multiplier)
    self._lastPublishedRooted[player] = true
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    self:_notify(player, "ROOTED — MOVEMENT SLOWED")
    return true
end

function PlayerCombatService.applyDrowsy(
    self: PlayerCombatService,
    player: Player,
    duration: number,
    multiplier: number
): boolean
    local state = self._states[player]
    local statusState = self._statusStates[player]
    if state == nil or statusState == nil or not self._survivalService:canAct(player) then
        return false
    end
    local now = workspace:GetServerTimeNow()
    local nextState, _result =
        self._combatState.setSprint(state, false, now, true, self:_staminaRegenMultiplier(player))
    self._states[player] = nextState
    self._statusStates[player] =
        self._statusEffectState.applyDrowsy(statusState, now, duration, multiplier)
    self._lastPublishedDrowsy[player] = true
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    self:_notify(player, "DROWSY — MOVEMENT SLOWED")
    return true
end

function PlayerCombatService.applyShield(
    self: PlayerCombatService,
    player: Player,
    duration: number,
    multiplier: number
): boolean
    local statusState = self._statusStates[player]
    if statusState == nil or not self._survivalService:canAct(player) then
        return false
    end
    local now = workspace:GetServerTimeNow()
    self._statusStates[player] =
        self._statusEffectState.applyShield(statusState, now, duration, multiplier)
    self:_syncPlayer(player)
    return true
end

-- snapshot() reads the stored stamina as of the last periodic advance (up
-- to ~0.1s stale, see PlayerCombatService._step), while restoreStamina
-- advances fresh before mutating. A caller that gates on snapshot()'s
-- value and only later calls restoreStamina can see stamina go from
-- "not full" to "full" in that gap — this advances (without persisting)
-- so a precondition check sees exactly what restoreStamina is about to see.
--[[
    Shake off whatever is being done to this player. Returns whether
    anything was actually cleared, so a caller can refuse to spend an item
    on a player who is fine -- the same rule stamina restoration has had
    since it shipped.
]]
function PlayerCombatService.clearAfflictions(self: PlayerCombatService, player: Player): any
    local statusState = self._statusStates[player]
    if statusState == nil then
        return { applied = false, reason = "no_state" }
    end
    local now = workspace:GetServerTimeNow()
    if not self._statusEffectState.afflicted(statusState, now) then
        return { applied = false, reason = "nothing_to_clear" }
    end
    local nextStatus, had = self._statusEffectState.clearAfflictions(statusState)
    self._statusStates[player] = nextStatus
    self:_syncPlayer(player)
    return { applied = had, reason = if had then "cleared" else "nothing_to_clear" }
end

--[[
    Whether anything is being done to this player right now. Read before
    the item is spent.
]]
function PlayerCombatService.isAfflicted(self: PlayerCombatService, player: Player): boolean
    local statusState = self._statusStates[player]
    if statusState == nil then
        return false
    end
    return self._statusEffectState.afflicted(statusState, workspace:GetServerTimeNow())
end

function PlayerCombatService.peekStamina(self: PlayerCombatService, player: Player): number?
    local state = self._states[player]
    if state == nil then
        return nil
    end
    local now = workspace:GetServerTimeNow()
    local advanced = self._combatState.advance(
        state,
        now,
        self._survivalService:canAct(player),
        self:_staminaRegenMultiplier(player)
    )
    return self._combatState.snapshot(advanced, now).stamina
end

function PlayerCombatService.restoreStamina(
    self: PlayerCombatService,
    player: Player,
    amount: number
): any
    local state = self._states[player]
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    local now = workspace:GetServerTimeNow()
    local nextState, result = self._combatState.restoreStamina(
        state,
        now,
        amount,
        self._survivalService:canAct(player),
        self:_staminaRegenMultiplier(player)
    )
    self._states[player] = nextState
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    if result.applied then
        self:_notify(player, nil)
    end
    return result
end

-- Independent of ProfessionService.mitigateIncomingDamage (Warden's guard):
-- the two are checked separately at each damage call site so an item-granted
-- shield stacks with a profession's own mitigation instead of overriding it.
function PlayerCombatService.mitigateShieldedDamage(
    self: PlayerCombatService,
    player: Player,
    amount: number,
    now: number
): (number, boolean)
    local statusState = self._statusStates[player]
    if statusState == nil then
        return amount, false
    end
    local status = self._statusEffectState.snapshot(statusState, now)
    if not status.shielded then
        return amount, false
    end
    return math.max(1, math.ceil(amount * status.damageMultiplier)), true
end

function PlayerCombatService.setSprint(
    self: PlayerCombatService,
    player: Player,
    enabled: boolean
): any
    if not self._featureFlags:isEnabled("combat_mobility_enabled") then
        return {
            applied = false,
            reason = "combat_mobility_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    local now = workspace:GetServerTimeNow()
    local nextState, result = self._combatState.setSprint(
        state,
        enabled,
        now,
        self._survivalService:canAct(player),
        self:_staminaRegenMultiplier(player)
    )
    self._states[player] = nextState
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    self._analyticsService:combatAction(
        player,
        "sprint",
        result.applied,
        result.reason,
        result.stamina
    )
    if result.applied then
        self:_notify(player, nil)
    elseif enabled and result.reason == "insufficient_stamina" then
        self:_notify(player, "STAMINA LOW — RELEASE RUN TO RECOVER")
    end
    return result
end

function PlayerCombatService.dodge(self: PlayerCombatService, player: Player): any
    if not self._featureFlags:isEnabled("combat_mobility_enabled") then
        return {
            applied = false,
            reason = "combat_mobility_disabled",
        }
    end
    local state = self._states[player]
    local activeHumanoid = humanoid(player)
    local root = rootPart(player)
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    if activeHumanoid == nil or root == nil or activeHumanoid.Health <= 0 then
        return {
            applied = false,
            reason = "character_unavailable",
        }
    end

    local now = workspace:GetServerTimeNow()
    local nextState, result = self._combatState.dodge(
        state,
        now,
        self._survivalService:canAct(player),
        self:_staminaRegenMultiplier(player)
    )
    self._states[player] = nextState
    if result.applied then
        local direction = activeHumanoid.MoveDirection
        if direction.Magnitude < 0.1 then
            direction = root.CFrame.LookVector
        end
        direction = Vector3.new(direction.X, 0, direction.Z)
        if direction.Magnitude > 0.01 then
            direction = direction.Unit
            local velocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(
                direction.X * self._config.DodgeSpeed,
                velocity.Y,
                direction.Z * self._config.DodgeSpeed
            )
        end
    end
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    local reportResult = result.applied
        or now - (self._lastRejectionAt[player] or -math.huge) >= 0.75
    if reportResult then
        self._analyticsService:combatAction(
            player,
            "dodge",
            result.applied,
            result.reason,
            result.stamina
        )
    end
    if result.applied then
        self:_notify(player, nil)
    elseif reportResult then
        self._lastRejectionAt[player] = now
        if result.reason == "insufficient_stamina" then
            self:_notify(player, "STAMINA LOW — DODGE NEEDS 35")
        elseif result.reason == "dodge_cooldown" then
            self:_notify(player, "DODGE RECHARGING")
        end
    end
    return result
end

function PlayerCombatService.avoidsDamage(
    self: PlayerCombatService,
    player: Player,
    now: number
): boolean
    local state = self._states[player]
    return self._featureFlags:isEnabled("combat_mobility_enabled")
        and state ~= nil
        and self._combatState.avoidsDamage(state, now)
end

function PlayerCombatService.snapshot(self: PlayerCombatService, player: Player): any
    local now = workspace:GetServerTimeNow()
    local state = self._states[player]
    local snapshot = if state == nil
        then self._combatState.snapshot(self._combatState.create(now), now)
        else self._combatState.snapshot(state, now)
    local statusState = self._statusStates[player] or self._statusEffectState.create()
    local status = self._statusEffectState.snapshot(statusState, now)
    snapshot.enabled = self._featureFlags:isEnabled("combat_mobility_enabled")
    if not snapshot.enabled then
        snapshot.dodgeActive = false
    end
    snapshot.drowsy = status.drowsy
    snapshot.drowsyUntil = status.drowsyUntil
    snapshot.rooted = status.rooted
    snapshot.rootedUntil = status.rootedUntil
    snapshot.movementMultiplier = status.movementMultiplier
    snapshot.shielded = status.shielded
    snapshot.shieldUntil = status.shieldUntil
    return snapshot
end

return table.freeze(PlayerCombatService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="144">
          <Properties>
            <string name="Name">PlayerSurvivalService</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PlayerSurvivalService = {}
PlayerSurvivalService.__index = PlayerSurvivalService
PlayerSurvivalService.Name = "PlayerSurvivalService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type ReviveChannel = {
    target: Player,
    reviver: Player,
    flow: any,
    tuning: any,
}

type DownedVisual = {
    character: Model,
    highlight: Highlight,
    interactionId: string,
    label: TextLabel,
    prompt: ProximityPrompt,
}

export type PlayerSurvivalService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _runtimeIds: any,
        _reviveFlow: any,
        _survivalState: any,
        _featureFlags: any,
        _worldService: any,
        _analyticsService: any,
        _equipmentStatsProvider: ((Player) -> any)?,
        _gearWearAccruer: ((Player) -> ())?,
        _reviveTuningProvider: ((Player) -> any)?,
        _expeditionFailureHandler: ((Player) -> any)?,
        _partyRecoveryProvider: ((number, number) -> any)?,
        _partyRecoveryPending: boolean,
        _states: { [Player]: any },
        _spawned: { [Player]: boolean },
        _channels: { [Player]: ReviveChannel },
        _prompts: { [string]: ProximityPrompt },
        _targets: { [string]: Player },
        _visuals: { [Player]: DownedVisual },
        _regenCarry: { [Player]: number },
        _lastRegenAt: number?,
        _onChanged: ((Player?, string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
    },
    PlayerSurvivalService
))

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function humanoid(player: Player): Humanoid?
    local character = player.Character
    return if character == nil then nil else character:FindFirstChildOfClass("Humanoid")
end

local function playerLabel(player: Player): string
    return string.sub(player.DisplayName, 1, 20)
end

function PlayerSurvivalService.new(
    logger: Logger,
    config: any,
    runtimeIds: any,
    reviveFlow: any,
    survivalState: any,
    featureFlags: any,
    worldService: any,
    analyticsService: any
): PlayerSurvivalService
    return setmetatable({
        Name = PlayerSurvivalService.Name,
        _logger = logger,
        _config = config,
        _runtimeIds = runtimeIds,
        _reviveFlow = reviveFlow,
        _survivalState = survivalState,
        _featureFlags = featureFlags,
        _worldService = worldService,
        _analyticsService = analyticsService,
        _equipmentStatsProvider = nil,
        _gearWearAccruer = nil,
        _reviveTuningProvider = nil,
        _expeditionFailureHandler = nil,
        _partyRecoveryProvider = nil,
        _partyRecoveryPending = false,
        _states = {},
        _spawned = {},
        _channels = {},
        _prompts = {},
        _targets = {},
        _visuals = {},
        -- SurvivalState.heal only accepts whole positive points, so lantern
        -- regen accumulates fractional progress here and spends it a point at
        -- a time. Without the carry every tick would round to an invalid heal
        -- and silently do nothing.
        _regenCarry = {},
        _lastRegenAt = nil,
        _onChanged = nil,
        _heartbeat = nil,
    }, PlayerSurvivalService)
end

function PlayerSurvivalService.setEquipmentStatsProvider(
    self: PlayerSurvivalService,
    provider: (Player) -> any
)
    self._equipmentStatsProvider = provider
end

function PlayerSurvivalService.setGearWearAccruer(
    self: PlayerSurvivalService,
    accruer: (Player) -> ()
)
    self._gearWearAccruer = accruer
end

function PlayerSurvivalService.setReviveTuningProvider(
    self: PlayerSurvivalService,
    provider: (Player) -> any
)
    self._reviveTuningProvider = provider
end

function PlayerSurvivalService.setExpeditionFailureHandler(
    self: PlayerSurvivalService,
    handler: (Player) -> any
)
    self._expeditionFailureHandler = handler
end

function PlayerSurvivalService.setPartyRecoveryProvider(
    self: PlayerSurvivalService,
    provider: (number, number) -> any
)
    self._partyRecoveryProvider = provider
end

function PlayerSurvivalService._recordExpeditionFailure(
    self: PlayerSurvivalService,
    player: Player
): string?
    local handler = self._expeditionFailureHandler
    if handler == nil or player:GetAttribute("LastLightInExpedition") ~= true then
        return nil
    end
    local result = handler(player)
    return if type(result) == "table" and type(result.message) == "string"
        then result.message
        else nil
end

function PlayerSurvivalService._reviveTuning(self: PlayerSurvivalService, player: Player): any
    local provider = self._reviveTuningProvider
    if provider == nil then
        return {
            duration = self._config.ReviveChannelSeconds,
            health = self._config.ReviveHealth,
            professionId = nil,
            rescueTitle = "FIELD RESCUE",
            specialized = false,
            wardSeconds = self._config.ReviveInvulnerabilitySeconds,
        }
    end
    return provider(player)
end

function PlayerSurvivalService._equipmentDamage(
    self: PlayerSurvivalService,
    player: Player,
    amount: number
): (number, number)
    if amount ~= amount or amount <= 0 or amount >= math.huge or amount ~= math.floor(amount) then
        return amount, 0
    end
    local provider = self._equipmentStatsProvider
    if provider == nil then
        return amount, 0
    end
    local stats = provider(player)
    local reduction = math.clamp(
        if type(stats) == "table" and type(stats.damageReduction) == "number"
            then stats.damageReduction
            else 0,
        0,
        0.25
    )
    return math.max(1, math.ceil(amount * (1 - reduction))), reduction
end

function PlayerSurvivalService.Init(_self: PlayerSurvivalService, _context: any) end

function PlayerSurvivalService.setChangedHandler(
    self: PlayerSurvivalService,
    callback: (Player?, string?) -> ()
)
    self._onChanged = callback
end

function PlayerSurvivalService._notify(
    self: PlayerSurvivalService,
    player: Player?,
    message: string?
)
    local callback = self._onChanged
    if callback ~= nil then
        callback(player, message)
    end
end

function PlayerSurvivalService._syncPlayer(self: PlayerSurvivalService, player: Player)
    local state = self._states[player]
    if state == nil then
        return
    end
    local snapshot = self._survivalState.snapshot(state, workspace:GetServerTimeNow())
    player:SetAttribute("LastLightHealth", snapshot.health)
    player:SetAttribute("LastLightMaxHealth", snapshot.maxHealth)
    player:SetAttribute("LastLightDowned", snapshot.downed)
    player:SetAttribute("LastLightBleedoutAt", snapshot.bleedoutAt)
    local _, equipmentReduction = self:_equipmentDamage(player, 100)
    player:SetAttribute("LastLightEquipmentDamageReduction", equipmentReduction)

    local activeHumanoid = humanoid(player)
    if activeHumanoid ~= nil then
        activeHumanoid.MaxHealth = snapshot.maxHealth
        activeHumanoid.Health = math.max(1, snapshot.health)
        activeHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        activeHumanoid.WalkSpeed = if snapshot.downed
            then self._config.DownedWalkSpeed
            else self._config.BaseWalkSpeed
        activeHumanoid.JumpHeight = if snapshot.downed then 0 else self._config.BaseJumpHeight
        activeHumanoid.JumpPower = if snapshot.downed then 0 else self._config.BaseJumpPower
    end
end

function PlayerSurvivalService._clearVisual(self: PlayerSurvivalService, player: Player)
    player:SetAttribute("LastLightReviveEndsAt", nil)
    player:SetAttribute("LastLightReviverUserId", nil)
    player:SetAttribute("LastLightReviveProfessionId", nil)
    player:SetAttribute("LastLightReviveHealth", nil)
    player:SetAttribute("LastLightReviveWardSeconds", nil)
    local visual = self._visuals[player]
    if visual == nil then
        local character = player.Character
        if
            character ~= nil
            and CollectionService:HasTag(character, self._runtimeIds.PlayerDownedTag)
        then
            CollectionService:RemoveTag(character, self._runtimeIds.PlayerDownedTag)
        end
        return
    end
    self._prompts[visual.interactionId] = nil
    self._targets[visual.interactionId] = nil
    if visual.prompt.Parent ~= nil then
        visual.prompt:Destroy()
    end
    if visual.highlight.Parent ~= nil then
        visual.highlight:Destroy()
    end
    if CollectionService:HasTag(visual.character, self._runtimeIds.PlayerDownedTag) then
        CollectionService:RemoveTag(visual.character, self._runtimeIds.PlayerDownedTag)
    end
    self._visuals[player] = nil
end

function PlayerSurvivalService._createVisual(self: PlayerSurvivalService, player: Player)
    self:_clearVisual(player)
    local targetRoot = rootPart(player)
    local character = player.Character
    local state = self._states[player]
    if targetRoot == nil or character == nil or state == nil then
        return
    end

    local interactionId = string.format("revive:%d:%d", player.UserId, state.revision)
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = "LastLightRevivePrompt"
    prompt.ActionText = "REVIVE"
    prompt.ObjectText = playerLabel(player)
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = self._config.ReviveDistance
    prompt.RequiresLineOfSight = true
    prompt.Style = Enum.ProximityPromptStyle.Custom
    prompt:SetAttribute("ActionId", self._runtimeIds.Actions.Revive)
    prompt:SetAttribute("InteractionId", interactionId)
    prompt:SetAttribute("TargetUserId", player.UserId)
    prompt.Parent = targetRoot
    CollectionService:AddTag(prompt, self._runtimeIds.InteractionTag)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DownedMarker"
    billboard.Adornee = targetRoot
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 120
    billboard.Size = UDim2.fromOffset(210, 58)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 4.8, 0)
    billboard.Parent = prompt

    local label = Instance.new("TextLabel")
    label.Name = "DownedLabel"
    label.BackgroundColor3 = Color3.fromRGB(47, 20, 18)
    label.BackgroundTransparency = 0.08
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.TextColor3 = Color3.fromRGB(255, 230, 194)
    label.TextScaled = true
    label.TextStrokeTransparency = 0.72
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 181, 76)
    stroke.Thickness = 2
    stroke.Transparency = 0.12
    stroke.Parent = label

    local highlight = Instance.new("Highlight")
    highlight.Name = "DownedOutline"
    highlight.FillColor = Color3.fromRGB(165, 55, 47)
    highlight.FillTransparency = 0.72
    highlight.OutlineColor = Color3.fromRGB(255, 181, 76)
    highlight.OutlineTransparency = 0.08
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    CollectionService:AddTag(character, self._runtimeIds.PlayerDownedTag)

    self._prompts[interactionId] = prompt
    self._targets[interactionId] = player
    self._visuals[player] = {
        character = character,
        highlight = highlight,
        interactionId = interactionId,
        label = label,
        prompt = prompt,
    }
end

function PlayerSurvivalService._updateVisual(
    self: PlayerSurvivalService,
    player: Player,
    now: number
)
    local visual = self._visuals[player]
    local state = self._states[player]
    if visual == nil or state == nil then
        return
    end
    local snapshot = self._survivalState.snapshot(state, now)
    visual.label.Text = string.format(
        "✚ %s DOWN\n%02ds · REVIVE",
        string.upper(playerLabel(player)),
        snapshot.timeRemaining
    )
end

function PlayerSurvivalService._bindPlayer(self: PlayerSurvivalService, player: Player)
    if self._states[player] ~= nil then
        return
    end
    self._states[player] = self._survivalState.create(workspace:GetServerTimeNow())

    local function characterAdded(character: Model)
        local now = workspace:GetServerTimeNow()
        local previousState = self._states[player]
        local returningCharacter = self._spawned[player] == true
        self._spawned[player] = true
        local resetFromDowned = previousState ~= nil and previousState.status == "downed"
        self:_cancelChannel(player, "target_character_reset")
        for target, channel in self._channels do
            if channel.reviver == player then
                self:_cancelChannel(target, "reviver_character_reset")
            end
        end
        self:_clearVisual(player)
        if returningCharacter then
            self._states[player] = self._survivalState.respawn(previousState, now)
        elseif resetFromDowned then
            self._states[player] = self._survivalState.safeRetreat(previousState, now)
        else
            self._states[player] = self._survivalState.create(now)
        end
        task.spawn(function()
            local activeHumanoid = character:WaitForChild("Humanoid", 8)
            if
                activeHumanoid ~= nil
                and activeHumanoid:IsA("Humanoid")
                and player.Parent ~= nil
            then
                activeHumanoid.BreakJointsOnDeath = false
                self:_syncPlayer(player)
                if returningCharacter or resetFromDowned then
                    local retreatMessage = nil
                    if player:GetAttribute("LastLightInExpedition") == true then
                        retreatMessage = self:_recordExpeditionFailure(player)
                        self._worldService:exitBramblewake(player)
                    end
                    self._analyticsService:playerRecovered(
                        player,
                        if resetFromDowned
                            then "character_reset_safe_retreat"
                            else "character_respawn_safe_retreat"
                    )
                    self:_notify(player, retreatMessage or "SAFE RETREAT — CHARACTER RESET")
                end
                self:_notify(nil, nil)
            end
        end)
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character ~= nil then
        characterAdded(player.Character)
    else
        self:_syncPlayer(player)
    end
end

function PlayerSurvivalService.Start(self: PlayerSurvivalService)
    Players.PlayerAdded:Connect(function(player: Player)
        self:_bindPlayer(player)
    end)
    Players.PlayerRemoving:Connect(function(player: Player)
        self:_cancelChannel(player, "target_left")
        self:_clearVisual(player)
        self._states[player] = nil
        self._spawned[player] = nil
        self._regenCarry[player] = nil
        for target, channel in self._channels do
            if channel.reviver == player then
                self:_cancelChannel(target, "reviver_left")
            end
        end
        task.defer(function()
            self:_attemptPartyRecovery()
        end)
    end)
    for _, player in Players:GetPlayers() do
        self:_bindPlayer(player)
    end

    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.1 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
end

function PlayerSurvivalService.canAct(self: PlayerSurvivalService, player: Player): boolean
    local state = self._states[player]
    return state ~= nil and self._survivalState.canAct(state)
end

function PlayerSurvivalService.damage(
    self: PlayerSurvivalService,
    player: Player,
    amount: number,
    source: string
): any
    if not self._featureFlags:isEnabled("player_survival_enabled") then
        return {
            applied = false,
            reason = "survival_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    local now = workspace:GetServerTimeNow()
    local mitigatedAmount, equipmentReduction = self:_equipmentDamage(player, amount)
    local nextState, result = self._survivalState.damage(state, mitigatedAmount, now)
    if not result.applied then
        return result
    end

    self._states[player] = nextState
    result.rawDamage = amount
    result.equipmentReduction = equipmentReduction
    -- Gear that softened a blow wears from it; spawned so profile work
    -- can never stall or fail the damage path itself.
    if equipmentReduction > 0 and self._gearWearAccruer ~= nil then
        task.spawn(self._gearWearAccruer :: (Player) -> (), player)
    end
    self:_syncPlayer(player)
    if result.downed then
        self:_createVisual(player)
        self._analyticsService:playerDowned(player, string.sub(source, 1, 48))
        self:_notify(player, "DOWNED — CRAWL TOWARD LIGHT")
        self:_attemptPartyRecovery()
    else
        self:_notify(nil, nil)
    end
    return result
end

function PlayerSurvivalService._attemptPartyRecovery(self: PlayerSurvivalService)
    local provider = self._partyRecoveryProvider
    if provider == nil or self._partyRecoveryPending then
        return
    end

    local eligible, downed = self:_eligibleParty()
    if #eligible < 1 or downed ~= #eligible then
        return
    end

    self._partyRecoveryPending = true
    local result = provider(#eligible, downed)
    if type(result) ~= "table" or result.accepted ~= true then
        self._partyRecoveryPending = false
        return
    end

    local channelTargets: { Player } = {}
    for target in self._channels do
        table.insert(channelTargets, target)
    end
    for _, target in channelTargets do
        self:_cancelChannel(target, "town_guard_last_stand")
    end
    local now = workspace:GetServerTimeNow()
    local recovered = {}
    for _, player in eligible do
        local state = self._states[player]
        if state ~= nil and state.status == "downed" then
            local nextState, recovery = self._survivalState.revive(state, now, {
                health = result.recoveryHealth,
                wardSeconds = result.recoveryWardSeconds,
            })
            if recovery.applied then
                self._states[player] = nextState
                self:_clearVisual(player)
                self:_syncPlayer(player)
                player:SetAttribute("LastLightGuardRecoveryNight", result.nightNumber)
                table.insert(recovered, player)
                self._analyticsService:playerRecovered(player, "town_guard_last_stand")
            end
        end
    end
    self._worldService:showTownGuardRecovery(recovered, result)
    self:_notify(
        nil,
        string.format(
            "THE NIGHT WATCH ANSWERS — %d TRAVELER%s RALLIED · LANTERN -%d",
            #recovered,
            if #recovered == 1 then "" else "S",
            result.lanternSpent or result.lanternCost or 0
        )
    )
    self._partyRecoveryPending = false
end

function PlayerSurvivalService.canHealInRadius(
    self: PlayerSurvivalService,
    source: Player,
    radius: number
): (boolean, string)
    if not self:canAct(source) then
        return false, "YOU CANNOT HEAL WHILE DOWNED"
    end
    local sourceRoot = rootPart(source)
    if sourceRoot == nil then
        return false, "YOUR CHARACTER IS STILL LOADING"
    end
    for player, state in self._states do
        local targetRoot = rootPart(player)
        if
            state.status == "active"
            and state.health < state.maxHealth
            and targetRoot ~= nil
            and (sourceRoot.Position - targetRoot.Position).Magnitude <= radius
        then
            return true, "GUIDING PULSE READY"
        end
    end
    return false, "NO INJURED TRAVELER IS WITHIN THE PULSE"
end

function PlayerSurvivalService.healInRadius(
    self: PlayerSurvivalService,
    source: Player,
    amount: number,
    radius: number
): any
    local canHeal, reason = self:canHealInRadius(source, radius)
    if not canHeal then
        return {
            affected = 0,
            healed = 0,
            reason = reason,
        }
    end

    local sourceRoot = assert(rootPart(source), "healing source root disappeared")
    local affected = 0
    local totalHealed = 0
    for player, state in self._states do
        local targetRoot = rootPart(player)
        if
            targetRoot ~= nil
            and (sourceRoot.Position - targetRoot.Position).Magnitude <= radius
        then
            local nextState, result = self._survivalState.heal(state, amount)
            if result.applied then
                self._states[player] = nextState
                affected += 1
                totalHealed += result.healed or 0
                self:_syncPlayer(player)
            end
        end
    end
    self:_notify(nil, nil)
    return {
        affected = affected,
        healed = totalHealed,
        reason = "healed",
    }
end

function PlayerSurvivalService.interaction(
    self: PlayerSurvivalService,
    interactionId: string
): ProximityPrompt?
    return self._prompts[interactionId]
end

function PlayerSurvivalService._canReach(
    self: PlayerSurvivalService,
    reviver: Player,
    target: Player
): boolean
    local reviverRoot = rootPart(reviver)
    local targetRoot = rootPart(target)
    local reviverCharacter = reviver.Character
    local targetCharacter = target.Character
    if
        reviverRoot == nil
        or targetRoot == nil
        or reviverCharacter == nil
        or targetCharacter == nil
        or (reviverRoot.Position - targetRoot.Position).Magnitude > self._config.ReviveDistance
    then
        return false
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { reviverCharacter }
    local result =
        workspace:Raycast(reviverRoot.Position, targetRoot.Position - reviverRoot.Position, params)
    return result == nil or result.Instance:IsDescendantOf(targetCharacter)
end

function PlayerSurvivalService.beginRevive(
    self: PlayerSurvivalService,
    reviver: Player,
    interactionId: string
): any
    local target = self._targets[interactionId]
    local prompt = self._prompts[interactionId]
    if target == nil or prompt == nil or not prompt.Enabled then
        return {
            accepted = false,
            message = "THAT RESCUE MARK IS NO LONGER ACTIVE",
            reason = "unknown_revive",
        }
    end
    if target == reviver then
        return {
            accepted = false,
            message = "AN ALLY MUST COMPLETE THE REVIVE",
            reason = "self_revive",
        }
    end
    if not self:canAct(reviver) then
        return {
            accepted = false,
            message = "YOU CANNOT REVIVE WHILE DOWNED",
            reason = "reviver_downed",
        }
    end
    local targetState = self._states[target]
    if targetState == nil or targetState.status ~= "downed" then
        return {
            accepted = false,
            message = "THAT ALLY IS ALREADY SAFE",
            reason = "target_not_downed",
        }
    end
    if not self:_canReach(reviver, target) then
        return {
            accepted = false,
            message = "MOVE CLOSER WITH A CLEAR PATH",
            reason = "revive_out_of_range",
        }
    end

    local existing = self._channels[target]
    if existing ~= nil then
        return {
            accepted = existing.reviver == reviver,
            message = if existing.reviver == reviver
                then "REVIVE IN PROGRESS — STAY CLOSE"
                else "ANOTHER ALLY IS REVIVING THEM",
            reason = "revive_in_progress",
        }
    end

    local reviverState = assert(self._states[reviver], "reviver survival state is missing")
    local now = workspace:GetServerTimeNow()
    local tuning = self:_reviveTuning(reviver)
    local channel = {
        target = target,
        reviver = reviver,
        tuning = tuning,
        flow = self._reviveFlow.create(
            target.UserId,
            reviver.UserId,
            reviverState.revision,
            now,
            tuning.duration
        ),
    }
    self._channels[target] = channel
    prompt.ActionText = if tuning.specialized then tuning.rescueTitle else "REVIVING"
    target:SetAttribute("LastLightReviveEndsAt", channel.flow.endsAt)
    target:SetAttribute("LastLightReviverUserId", reviver.UserId)
    target:SetAttribute("LastLightReviveProfessionId", tuning.professionId)
    target:SetAttribute("LastLightReviveHealth", tuning.health)
    target:SetAttribute("LastLightReviveWardSeconds", tuning.wardSeconds)
    self:_notify(nil, nil)
    return {
        accepted = true,
        message = string.format(
            "%s — %s — STAY CLOSE",
            tuning.rescueTitle,
            string.upper(playerLabel(target))
        ),
        reason = "revive_started",
    }
end

function PlayerSurvivalService._cancelChannel(
    self: PlayerSurvivalService,
    target: Player,
    reason: string
)
    local channel = self._channels[target]
    if channel == nil then
        return
    end
    self._channels[target] = nil
    target:SetAttribute("LastLightReviveEndsAt", nil)
    target:SetAttribute("LastLightReviverUserId", nil)
    target:SetAttribute("LastLightReviveProfessionId", nil)
    target:SetAttribute("LastLightReviveHealth", nil)
    target:SetAttribute("LastLightReviveWardSeconds", nil)
    local visual = self._visuals[target]
    if visual ~= nil then
        visual.prompt.ActionText = "REVIVE"
    end
    self._logger:info("player_revive_cancelled", {
        reason = reason,
        reviver = channel.reviver.UserId,
        target = target.UserId,
    })
    self:_notify(channel.reviver, "REVIVE INTERRUPTED")
end

function PlayerSurvivalService._completeRevive(
    self: PlayerSurvivalService,
    target: Player,
    channel: ReviveChannel,
    now: number
)
    local state = self._states[target]
    if state == nil then
        self:_cancelChannel(target, "target_left")
        return
    end
    local nextState, result = self._survivalState.revive(state, now, {
        health = channel.tuning.health,
        wardSeconds = channel.tuning.wardSeconds,
    })
    if not result.applied then
        self:_cancelChannel(target, result.reason)
        return
    end

    self._channels[target] = nil
    self._states[target] = nextState
    self:_clearVisual(target)
    self:_syncPlayer(target)
    self._analyticsService:playerRevived(
        target,
        channel.reviver,
        math.max(0, now - channel.flow.startedAt)
    )
    self:_notify(
        target,
        string.format(
            "BACK ON YOUR FEET — %d HEALTH · %.1fs LIGHT WARD",
            result.health,
            channel.tuning.wardSeconds
        )
    )
    self:_notify(channel.reviver, channel.tuning.rescueTitle .. " COMPLETE")
end

function PlayerSurvivalService._recover(self: PlayerSurvivalService, player: Player, now: number)
    local state = self._states[player]
    if state == nil then
        return
    end
    local nextState, result = self._survivalState.recover(state, now)
    if not result.applied then
        return
    end

    self._channels[player] = nil
    self._states[player] = nextState
    self:_clearVisual(player)
    self:_syncPlayer(player)
    local retreatMessage = nil
    if player:GetAttribute("LastLightInExpedition") == true then
        retreatMessage = self:_recordExpeditionFailure(player)
        self._worldService:exitBramblewake(player)
    else
        local character = player.Character
        if character ~= nil then
            character:PivotTo(self._worldService:spawnCFrame())
        end
    end
    self._analyticsService:playerRecovered(player, "bleedout_safe_retreat")
    self:_notify(player, retreatMessage or "SAFE RETREAT — UNBANKED POUCH RETAINED")
end

--[[
    Slow health recovery for players standing in the First Lantern's light.

    Without this a player who is not a Medic has no way back to full health at
    all: the only other sources are the Medic's ability and the health granted
    by a revive. Kept deliberately weak and anchored to the town so it does not
    replace the Medic in the field.
]]
function PlayerSurvivalService._stepLanternRegen(self: PlayerSurvivalService, now: number)
    local radius = tonumber(self._config.LanternSafeRadius)
    local rate = tonumber(self._config.LanternRegenPerSecond)
    if radius == nil or rate == nil or rate <= 0 then
        return
    end
    local worldService = self._worldService
    if worldService == nil or worldService.lanternSafeCenter == nil then
        return
    end
    local center = worldService:lanternSafeCenter()
    if center == nil then
        return
    end

    -- Clamped so a long server hitch cannot bank a full heal in one tick.
    local elapsed = math.clamp(now - (self._lastRegenAt or now), 0, 1)
    self._lastRegenAt = now
    if elapsed <= 0 then
        return
    end

    -- Anyone currently channeling a revive is excluded. SurvivalState.heal
    -- bumps the healed player's revision, and ReviveFlow.evaluate cancels a
    -- channel with reviver_state_changed the moment the reviver's revision
    -- differs from the one captured at revive start. Since a whole point lands
    -- roughly every 0.6s and a revive runs 2.5s, an injured player reviving an
    -- ally inside the safe zone would have the channel cancelled out from
    -- under them every single time -- and the town, next to the lantern, is
    -- exactly where reviving is most likely to happen.
    local reviving: { [Player]: boolean } = {}
    for _, channel in self._channels do
        reviving[channel.reviver] = true
    end

    local healedAny = false
    for player, state in self._states do
        local root = rootPart(player)
        -- Out of the light, downed, mid-revive, and already at full health all
        -- mean the same thing here: bank nothing and drop whatever fractional
        -- progress was carried, so leaving and returning does not resume
        -- mid-point.
        local eligible = root ~= nil
            and (root.Position - center).Magnitude <= radius
            and self._survivalState.canAct(state)
            and not reviving[player]
            and state.health < state.maxHealth
        if not eligible then
            self._regenCarry[player] = nil
        else
            local carried = (self._regenCarry[player] or 0) + rate * elapsed
            local whole = math.floor(carried)
            self._regenCarry[player] = carried - whole
            if whole >= 1 then
                local nextState, result = self._survivalState.heal(state, whole)
                if result.applied then
                    self._states[player] = nextState
                    self:_syncPlayer(player)
                    healedAny = true
                end
            end
        end
    end

    -- _syncPlayer only writes attributes and the Humanoid. The HUD renders
    -- from the survival snapshot published through the changed handler, so
    -- without this the health pill sits at its stale value while the
    -- authoritative state climbs, then jumps when some unrelated event
    -- finally triggers a publish.
    if healedAny then
        self:_notify(nil, nil)
    end
end

function PlayerSurvivalService._step(self: PlayerSurvivalService, now: number)
    for player, state in self._states do
        local activeHumanoid = humanoid(player)
        if activeHumanoid ~= nil then
            local expectedHealth = math.max(1, state.health)
            if activeHumanoid.Health ~= expectedHealth then
                activeHumanoid.Health = expectedHealth
            end
        end
        if state.status == "downed" then
            self:_updateVisual(player, now)
            if type(state.bleedoutAt) == "number" and now >= state.bleedoutAt then
                self:_recover(player, now)
            end
        end
    end

    self:_stepLanternRegen(now)

    for target, channel in self._channels do
        local reviverState = self._states[channel.reviver]
        local targetState = self._states[target]
        local decision = self._reviveFlow.evaluate(channel.flow, now, {
            reachable = reviverState ~= nil
                and targetState ~= nil
                and self:_canReach(channel.reviver, target),
            reviverCanAct = reviverState ~= nil and self._survivalState.canAct(reviverState),
            reviverPresent = channel.reviver.Parent ~= nil and reviverState ~= nil,
            reviverRevision = if reviverState == nil then -1 else reviverState.revision,
            targetDowned = targetState ~= nil and targetState.status == "downed",
            targetPresent = target.Parent ~= nil and targetState ~= nil,
        })
        if decision.status == "cancel" then
            self:_cancelChannel(target, decision.reason)
        elseif decision.status == "complete" then
            self:_completeRevive(target, channel, now)
        end
    end
end

local function directionLabel(viewerRoot: BasePart, targetRoot: BasePart): string
    local offset = targetRoot.Position - viewerRoot.Position
    if offset.Magnitude < 0.01 then
        return "HERE"
    end
    local direction = offset.Unit
    local forward = viewerRoot.CFrame.LookVector:Dot(direction)
    local right = viewerRoot.CFrame.RightVector:Dot(direction)
    if math.abs(forward) >= math.abs(right) then
        return if forward >= 0 then "AHEAD" else "BEHIND"
    end
    return if right >= 0 then "RIGHT" else "LEFT"
end

function PlayerSurvivalService.snapshot(self: PlayerSurvivalService, viewer: Player): any
    local now = workspace:GetServerTimeNow()
    local state = self._states[viewer]
    local selfSnapshot = if state == nil
        then self._survivalState.snapshot(self._survivalState.create(now), now)
        else self._survivalState.snapshot(state, now)
    local viewerRoot = rootPart(viewer)

    local downedCount = 0
    local priorityAlly = nil
    local priorityTime = math.huge
    local priorityDistance = math.huge
    for player, candidateState in self._states do
        if player ~= viewer and candidateState.status == "downed" then
            downedCount += 1
            local candidateRoot = rootPart(player)
            local timeRemaining = self._survivalState.snapshot(candidateState, now).timeRemaining
            local distance = if viewerRoot == nil or candidateRoot == nil
                then math.huge
                else (viewerRoot.Position - candidateRoot.Position).Magnitude
            if
                timeRemaining < priorityTime
                or (timeRemaining == priorityTime and distance < priorityDistance)
            then
                priorityAlly = player
                priorityTime = timeRemaining
                priorityDistance = distance
            end
        end
    end

    local ally = nil
    if priorityAlly ~= nil then
        local allyState = self._states[priorityAlly]
        local allyRoot = rootPart(priorityAlly)
        local channel = self._channels[priorityAlly]
        ally = {
            bleedoutAt = allyState.bleedoutAt,
            direction = if viewerRoot == nil or allyRoot == nil
                then "UNKNOWN"
                else directionLabel(viewerRoot, allyRoot),
            distance = if priorityDistance == math.huge
                then nil
                else math.floor(priorityDistance + 0.5),
            displayName = playerLabel(priorityAlly),
            inReviveRange = priorityDistance <= self._config.ReviveDistance,
            reviveEndsAt = if channel == nil then nil else channel.flow.endsAt,
            userId = priorityAlly.UserId,
        }
    end

    local nearestActive = nil
    local nearestActiveDistance = math.huge
    if selfSnapshot.downed and viewerRoot ~= nil then
        for player, candidateState in self._states do
            if player ~= viewer and self._survivalState.canAct(candidateState) then
                local candidateRoot = rootPart(player)
                if candidateRoot ~= nil then
                    local distance = (viewerRoot.Position - candidateRoot.Position).Magnitude
                    if distance < nearestActiveDistance then
                        nearestActive = player
                        nearestActiveDistance = distance
                    end
                end
            end
        end
    end

    local nearestAlly = nil
    if nearestActive ~= nil then
        local nearestRoot = rootPart(nearestActive)
        nearestAlly = {
            direction = if nearestRoot == nil
                then "UNKNOWN"
                else directionLabel(viewerRoot :: BasePart, nearestRoot),
            distance = math.floor(nearestActiveDistance + 0.5),
            displayName = playerLabel(nearestActive),
        }
    end

    selfSnapshot.nearestAlly = nearestAlly
    selfSnapshot.reviveEndsAt = viewer:GetAttribute("LastLightReviveEndsAt")
    return {
        ally = ally,
        downedCount = downedCount,
        enabled = self._featureFlags:isEnabled("player_survival_enabled"),
        partyDown = self:_partyDown(),
        self = selfSnapshot,
    }
end

--[[
    Everybody who could act is down.

    This game has no permanent loss, so defeat is the party wipe -- the exact
    condition the guard's last stand answers, computed with the same
    eligibility rule so the two can never disagree about what a wipe is.
    Reported in the snapshot because it is the single worst moment in the game
    to open a storefront, and the rule that says so has to be able to see it.
]]
function PlayerSurvivalService._partyDown(self: PlayerSurvivalService): boolean
    local eligible, downed = self:_eligibleParty()
    return #eligible > 0 and downed == #eligible
end

--[[
    Who counts as the party right now, and how many of them are down.

    One reader, because the comment above claims the wipe the store refuses on
    and the wipe the last stand answers cannot disagree, and a claim like that
    made of two copies of a predicate is a claim with a half-life. A player
    still in the tutorial or away in an expedition is neither: the first has
    not joined the defense and the second is not standing in it.
]]
function PlayerSurvivalService._eligibleParty(self: PlayerSurvivalService): ({ Player }, number)
    local eligible: { Player } = {}
    local downed = 0
    for player, state in self._states do
        if
            player.Parent ~= nil
            and player:GetAttribute("LastLightTutorialSurvivalReady") == true
            and player:GetAttribute("LastLightInExpedition") ~= true
        then
            table.insert(eligible, player)
            if state.status == "downed" then
                downed += 1
            end
        end
    end
    return eligible, downed
end

return table.freeze(PlayerSurvivalService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="145">
          <Properties>
            <string name="Name">PrivateServerService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    The private server's control rail, and the latch behind it.

    `PrivateServerControls` decides everything decidable without a running
    server -- who may press, what a press does to the state, and the one rule
    that every press ends this server's rewards. This service is the shell: it
    holds the state, asks the pure module, and turns the answer into the three
    things in this game that can be held still.

    It is deliberately the only caller of `ProfileService:beginPractice`,
    `TownNightService:setHold`/`stepPhase`, `EnemyService:setStillness` and
    `ExpeditionService:rebuildWithSeed`. Those five entry points exist for this
    file and nothing else reaches them, which is what keeps "a practice phase
    grants nothing" a statement about one path rather than about five.

    The order inside `press` is load-bearing: refuse, then latch, then move the
    world. Latching before the world is touched closes a window the width of a
    DataStore round trip in which the clock is already stopped and the rewards
    are not yet off; asking the refusal before either keeps a press that cannot
    land from latching anything at all.
]]

local PrivateServerService = {}
PrivateServerService.__index = PrivateServerService
PrivateServerService.Name = "PrivateServerService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type PrivateServerService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _controls: any,
        _profileService: any,
        _townNightService: any,
        _enemyService: any,
        _expeditionService: any,
        _analyticsService: any,
        _state: any,
    },
    PrivateServerService
))

function PrivateServerService.new(
    logger: Logger,
    privateServerControls: any,
    profileService: any,
    townNightService: any,
    enemyService: any,
    analyticsService: any
): PrivateServerService
    return setmetatable({
        Name = PrivateServerService.Name,
        _logger = logger,
        _controls = privateServerControls,
        _profileService = profileService,
        _townNightService = townNightService,
        _enemyService = enemyService,
        _expeditionService = nil,
        _analyticsService = analyticsService,
        _state = privateServerControls.default(),
    }, PrivateServerService)
end

function PrivateServerService.Init(_self: PrivateServerService, _context: any) end

function PrivateServerService.Start(_self: PrivateServerService) end

function PrivateServerService.setExpeditionService(
    self: PrivateServerService,
    expeditionService: any
)
    self._expeditionService = expeditionService
end

--[[
    What Roblox says about this server, in the shape the pure module reads.

    A Studio session is neither a private server nor a reserved one, so the
    attribute is the only way to reach this rail from a playtest at all --
    the same reason `LastLightStudioStore` exists, and it fakes exactly one
    thing: the owner. Every refusal, every latch and every consequence below
    is the real path.
]]
function PrivateServerService.server(_self: PrivateServerService): any
    local studioOwner = tonumber(game:GetAttribute("LastLightStudioPrivateServer"))
    if studioOwner ~= nil and studioOwner > 0 then
        return { privateServerId = "studio", privateServerOwnerId = studioOwner }
    end
    return {
        privateServerId = game.PrivateServerId,
        privateServerOwnerId = game.PrivateServerOwnerId,
    }
end

function PrivateServerService.state(self: PrivateServerService): any
    return self._controls.normalize(self._state)
end

function PrivateServerService.isPractice(self: PrivateServerService): boolean
    return not self._controls.rewardsAllowed(self._state)
end

function PrivateServerService.readout(
    self: PrivateServerService,
    player: Player,
    controlId: string
): string
    return self._controls.readout(
        self._state,
        controlId,
        self._profileService:discoveredSeeds(player)
    )
end

--[[
    Press one of the boards.

    Returns a message rather than a boolean because every path here has
    something worth saying: a refusal names which of the three reasons it is,
    and an acceptance names what the world now does. A control that changed
    the server and said nothing would be indistinguishable from a dead board,
    which is the failure #337 found on the store's BUY button.
]]
function PrivateServerService.press(
    self: PrivateServerService,
    player: Player,
    controlId: any
): (boolean, string)
    local allowed, reason = self._controls.authority(self:server(), player.UserId)
    if not allowed then
        return false, self._controls.refusal(reason)
    end

    local seeds = self._profileService:discoveredSeeds(player)
    local result = self._controls.apply(self._state, controlId, seeds)
    if not result.ok then
        return false, self._controls.refusal(result.reason)
    end

    local control = self._controls.byId(controlId)

    --[[
        Asked before anything is committed, and the ordering here is the whole
        of the review's finding about it.

        Two properties have to hold at once and they pull in opposite
        directions. A press whose world effect never lands must not advance the
        state or latch practice -- otherwise a refused seed press leaves
        `seedIndex` naming a seed the wood is not built on, and the readout
        starts lying about which wood you are standing next to. But the latch
        must also come *before* the world moves, or there is a window the width
        of a DataStore round trip in which the clock is already stopped and the
        rewards are not yet off.

        Both hold if the refusal is asked first: nothing is committed for a
        press that cannot land, and nothing can be written between the latch and
        the change it pays for.
    ]]
    local ready, refusal = self:_ready(control)
    if not ready then
        return false, refusal
    end

    local firstPress = self._controls.rewardsAllowed(self._state)
    if firstPress then
        self._profileService:beginPractice("private_server_control:" .. tostring(controlId))
        self._logger:warn("private_server_practice_engaged", {
            control = controlId,
            owner = player.UserId,
        })
    end
    self._state = result.state

    local message = self:_engage(player, control, result, seeds)
    if firstPress then
        message ..= " · THIS SERVER NO LONGER SAVES"
    end
    return true, message
end

-- Whether this control's world effect can land right now. Only the two that
-- can fail have anything to say; a toggle is a field and always can.
function PrivateServerService._ready(self: PrivateServerService, control: any): (boolean, string)
    if control.id == "call_phase" then
        if not self._townNightService:isRunning() then
            return false, "THERE IS NO CLOCK TO CALL ON YET"
        end
    elseif control.id == "choose_seed" then
        local expeditionService = self._expeditionService
        if expeditionService == nil then
            return false, "THE WOOD IS NOT STANDING YET"
        end
        if expeditionService:occupied() then
            return false, "SOMEBODY IS STILL IN THE WOOD"
        end
    end
    return true, ""
end

function PrivateServerService._engage(
    self: PrivateServerService,
    player: Player,
    control: any,
    result: any,
    seeds: any
): string
    if control.id == "hold_clock" then
        self._townNightService:setHold(result.state.hold)
        return if result.state.hold then "THE CLOCK IS HELD" else "THE CLOCK RUNS AGAIN"
    elseif control.id == "still_dark" then
        self._enemyService:setStillness(result.state.still)
        return if result.state.still then "THE DARK HOLDS STILL" else "THE DARK MOVES AGAIN"
    elseif control.id == "call_phase" then
        self._townNightService:stepPhase()
        return "THE PHASE IS CALLED"
    elseif control.id == "choose_seed" then
        local chosen = self._controls.chosenSeed(result.state, seeds)
        local expeditionService = self._expeditionService :: any
        --[[
            Cycling back past the end of the history is a return to the seed
            this server rolled for itself, which has to mean rebuilding to it
            rather than leaving the last chosen one standing. A control that
            said THIS SERVER'S OWN over somebody else's wood would be lying in
            the one place the readout is all the player has.
        ]]
        local _, ownSeed = expeditionService:currentSeed()
        local seed = if chosen == nil then ownSeed else chosen.seed
        local rebuilt, why = expeditionService:rebuildWithSeed(seed)
        if not rebuilt then
            return if why == "expedition_occupied"
                then "SOMEBODY IS STILL IN THE WOOD"
                else "THAT SEED DOES NOT ANSWER"
        end
        return "THE WOOD IS " .. self:readout(player, control.id)
    end
    return "SET"
end

--[[
    Everything the rail's boards read, for the snapshot.

    Built per player because the seed board reads that player's own history,
    and a rail that showed the owner's chosen seed to a guest would be showing
    them a number out of a save they cannot see.
]]
function PrivateServerService.snapshot(self: PrivateServerService, player: Player): any
    local allowed = self._controls.authority(self:server(), player.UserId)
    local boards = {}
    for _, control in self._controls.controls() do
        table.insert(boards, {
            id = control.id,
            label = control.label,
            readout = self:readout(player, control.id),
        })
    end
    return {
        available = allowed,
        practice = self:isPractice(),
        boards = boards,
    }
end

return PrivateServerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="146">
          <Properties>
            <string name="Name">ProfessionService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local ProfessionService = {}
ProfessionService.__index = ProfessionService
ProfessionService.Name = "ProfessionService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type ProfessionService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _catalog: any,
        _professionState: any,
        _professionMastery: any,
        _professionRescue: any,
        _featureFlags: any,
        _profileService: any,
        _worldService: any,
        _survivalService: any,
        _analyticsService: any,
        _states: { [Player]: any },
        _enemyService: any,
        _combatService: any,
        _switchProvider: ((Player) -> (boolean, string?))?,
        _onChanged: ((Player, string?) -> ())?,
    },
    ProfessionService
))

function ProfessionService.new(
    logger: Logger,
    catalog: any,
    professionState: any,
    professionMastery: any,
    professionRescue: any,
    featureFlags: any,
    profileService: any,
    worldService: any,
    survivalService: any,
    analyticsService: any
): ProfessionService
    return setmetatable({
        Name = ProfessionService.Name,
        _logger = logger,
        _catalog = catalog,
        _professionState = professionState,
        _professionMastery = professionMastery,
        _professionRescue = professionRescue,
        _featureFlags = featureFlags,
        _profileService = profileService,
        _worldService = worldService,
        _survivalService = survivalService,
        _analyticsService = analyticsService,
        _states = {},
        _enemyService = nil,
        _combatService = nil,
        _switchProvider = nil,
        _onChanged = nil,
    }, ProfessionService)
end

function ProfessionService.Init(self: ProfessionService, _context: any)
    self._profileService:onLoaded(function(player: Player, profile: any)
        self:_profileLoaded(player, profile)
    end)
end

function ProfessionService.Start(self: ProfessionService)
    Players.PlayerRemoving:Connect(function(player: Player)
        self._states[player] = nil
    end)

    for _, player in Players:GetPlayers() do
        local profile = self._profileService:get(player)
        if profile ~= nil then
            self:_profileLoaded(player, profile)
        end
    end
end

function ProfessionService.setEnemyService(self: ProfessionService, enemyService: any)
    self._enemyService = enemyService
end

-- Late-bound like the enemy service: the combat service exists before this
-- one in the bootstrap, but taking it here rather than in the constructor
-- keeps the constructor signature stable and mirrors how every other
-- cross-service edge in this file is wired.
function ProfessionService.setCombatService(self: ProfessionService, combatService: any)
    self._combatService = combatService
end

function ProfessionService.setSwitchProvider(
    self: ProfessionService,
    provider: (Player) -> (boolean, string?)
)
    self._switchProvider = provider
end

function ProfessionService.setChangedHandler(
    self: ProfessionService,
    callback: (Player, string?) -> ()
)
    self._onChanged = callback
end

function ProfessionService._notify(self: ProfessionService, player: Player, message: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(player, message)
    end
end

function ProfessionService._syncPlayer(self: ProfessionService, player: Player)
    local state = self._states[player]
    if state == nil then
        return
    end
    local snapshot = self._professionState.snapshot(state, workspace:GetServerTimeNow())
    player:SetAttribute("LastLightProfessionId", snapshot.selectedId)
    player:SetAttribute("LastLightProfessionReadyAt", snapshot.cooldownReadyAt)
    player:SetAttribute("LastLightProfessionActiveUntil", snapshot.activeUntil)
end

function ProfessionService._profileLoaded(self: ProfessionService, player: Player, profile: any)
    if self._states[player] ~= nil then
        return
    end
    local selectedId = if type(profile.profession) == "table"
        then profile.profession.selectedId
        else nil
    self._states[player] = self._professionState.create(selectedId, workspace:GetServerTimeNow())
    self:_syncPlayer(player)
end

function ProfessionService._switchAvailability(
    self: ProfessionService,
    player: Player
): (boolean, string?)
    if not self._survivalService:canAct(player) then
        return false, "YOU CANNOT SWITCH PROFESSION WHILE DOWNED"
    end
    local provider = self._switchProvider
    if provider == nil then
        return false, "PROFESSION SWITCHING IS STILL LOADING"
    end
    return provider(player)
end

function ProfessionService.select(
    self: ProfessionService,
    player: Player,
    professionId: string
): any
    if not self._featureFlags:isEnabled("profession_kits_enabled") then
        return {
            accepted = false,
            message = "PROFESSIONS ARE TEMPORARILY UNAVAILABLE",
            reason = "feature_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            accepted = false,
            message = "YOUR PROFESSION LOADOUT IS STILL LOADING",
            reason = "player_loading",
        }
    end

    local canSwitch, unavailableMessage = self:_switchAvailability(player)
    local now = workspace:GetServerTimeNow()
    local nextState, result = self._professionState.select(state, professionId, now, canSwitch)
    if not result.accepted then
        local message = unavailableMessage
        if result.reason == "unknown_profession" then
            message = "THAT PROFESSION DOES NOT EXIST"
        end
        self._analyticsService:professionSelected(player, professionId, false, result.reason)
        return {
            accepted = false,
            message = message or "PROFESSION SWITCHING IS UNAVAILABLE",
            reason = result.reason,
        }
    end

    self._states[player] = nextState
    self:_syncPlayer(player)
    local definition = self._catalog.get(professionId)
    if result.changed then
        self._profileService:setProfession(player, professionId)
        self._analyticsService:professionSelected(player, professionId, true, nil)
        self._logger:info("profession_selected", {
            player = player.UserId,
            profession = professionId,
        })
    end
    local message = if result.changed
        then string.format("%s READY — %s", definition.displayName, definition.abilityName)
        else string.format("%s IS ALREADY EQUIPPED", definition.displayName)
    self:_notify(player, message)
    return {
        accepted = true,
        changed = result.changed,
        message = message,
        reason = result.reason,
    }
end

function ProfessionService.selectSpecialization(
    self: ProfessionService,
    player: Player,
    specializationId: string
): any
    local professionId = self._professionMastery.specializationProfession(specializationId)
    local analyticsProfessionId = professionId or "unknown_profession"
    local function reject(message: string, reason: string): any
        self._analyticsService:professionSpecializationSelected(
            player,
            analyticsProfessionId,
            specializationId,
            false,
            reason
        )
        return {
            accepted = false,
            message = message,
            reason = reason,
        }
    end

    if not self._featureFlags:isEnabled("profession_kits_enabled") then
        return reject("PROFESSIONS ARE TEMPORARILY UNAVAILABLE", "feature_disabled")
    end
    local state = self._states[player]
    if state == nil then
        return reject("YOUR PROFESSION MASTERY IS STILL LOADING", "player_loading")
    end
    local snapshot = self._professionState.snapshot(state, workspace:GetServerTimeNow())
    if professionId == nil then
        return reject("THAT MASTERY PATH DOES NOT EXIST", "invalid_specialization")
    end
    if snapshot.selectedId ~= professionId then
        return reject(
            "EQUIP THE MATCHING PROFESSION BEFORE CHOOSING THIS PATH",
            "profession_mismatch"
        )
    end
    local canSwitch, unavailableMessage = self:_switchAvailability(player)
    if not canSwitch then
        return reject(
            unavailableMessage or "MASTERY PATHS CAN ONLY CHANGE IN SAFE DAYLIGHT",
            "switch_unavailable"
        )
    end
    local result =
        self._profileService:selectProfessionSpecialization(player, professionId, specializationId)
    local definition = self._professionMastery.specializationDefinition(specializationId)
    if not result.applied then
        local message = if result.duplicate
            then string.format("%s IS ALREADY YOUR MASTERY PATH", definition.name)
            elseif result.reason == "specialization_locked" then "REACH MASTERY RANK 10 FIRST"
            elseif
                result.reason == "profile_unavailable"
            then "YOUR PROFILE IS STILL LOADING OR READ-ONLY — TRY AGAIN"
            else "THAT MASTERY PATH CANNOT BE CHOSEN"
        local accepted = result.duplicate == true
        self._analyticsService:professionSpecializationSelected(
            player,
            professionId,
            specializationId,
            accepted,
            result.reason
        )
        return {
            accepted = accepted,
            changed = false,
            message = message,
            reason = result.reason,
        }
    end
    self._analyticsService:professionSpecializationSelected(
        player,
        professionId,
        specializationId,
        true,
        nil
    )
    self._logger:info("profession_specialization_selected", {
        player = player.UserId,
        profession = professionId,
        specialization = specializationId,
    })
    local message = string.format("%s PATH CHOSEN — %s", definition.name, definition.description)
    self:_notify(player, message)
    return {
        accepted = true,
        changed = true,
        message = message,
        reason = "selected",
    }
end

--[[
    Every ally the tonic can reach, by the same measure the pour will use.

    Counted from the caster's root the way canHealInRadius counts, so the
    preflight and the application cannot disagree about who is close enough.
    Includes the caster: an Alchemist alone at low stamina is a valid pour.
]]
function ProfessionService._staminaNeedInRadius(
    self: ProfessionService,
    player: Player,
    radius: number
): { Player }
    local needing = {}
    local combatService = self._combatService
    local character = player.Character
    local sourceRoot = if character == nil
        then nil
        else character:FindFirstChild("HumanoidRootPart")
    if combatService == nil or sourceRoot == nil or not sourceRoot:IsA("BasePart") then
        return needing
    end
    for _, other in Players:GetPlayers() do
        local otherCharacter = other.Character
        local otherRoot = if otherCharacter == nil
            then nil
            else otherCharacter:FindFirstChild("HumanoidRootPart")
        if
            otherRoot ~= nil
            and otherRoot:IsA("BasePart")
            and self._survivalService:canAct(other)
            and (otherRoot.Position - sourceRoot.Position).Magnitude <= radius
        then
            local snapshot = combatService:snapshot(other)
            if snapshot ~= nil and snapshot.stamina < snapshot.maxStamina then
                table.insert(needing, other)
            end
        end
    end
    return needing
end

function ProfessionService._abilityPreflight(
    self: ProfessionService,
    player: Player,
    definition: any,
    tuning: any
): (boolean, string)
    local effectRadius = definition.effectRadius + tuning.effectRadiusBonus
    local enemyService = self._enemyService
    if definition.id == self._catalog.Ids.Scout then
        if enemyService == nil then
            return false, "THREAT TRACKING IS STILL LOADING"
        end
        return enemyService:canMarkNearest(player, effectRadius)
    elseif definition.id == self._catalog.Ids.Warden then
        if enemyService == nil or not enemyService:combatActive() then
            return false, "LANTERN GUARD NEEDS AN ACTIVE THREAT"
        end
        return true, "LANTERN GUARD READY"
    elseif definition.id == self._catalog.Ids.Engineer then
        if enemyService == nil then
            return false, "LANTERN REPAIRS ARE STILL LOADING"
        end
        return enemyService:canRepairLantern(player, effectRadius)
    elseif definition.id == self._catalog.Ids.Medic then
        return self._survivalService:canHealInRadius(player, effectRadius)
    elseif definition.id == self._catalog.Ids.Alchemist then
        -- The tonic serves either need. Refusing only when nobody in reach
        -- wants health OR stamina keeps the no-op-cast protection the other
        -- kits have without making the brew fussier than the pulse.
        local canHeal = self._survivalService:canHealInRadius(player, effectRadius)
        if canHeal or #self:_staminaNeedInRadius(player, effectRadius) > 0 then
            return true, "SPOREBRIGHT TONIC READY"
        end
        return false, "EVERYONE IN REACH IS ALREADY HALE"
    elseif definition.id == self._catalog.Ids.Beastkeeper then
        if enemyService == nil then
            return false, "YOUR HOUND IS STILL WAKING"
        end
        return enemyService:canLureThreat(player, effectRadius)
    elseif definition.id == self._catalog.Ids.Runebinder then
        if enemyService == nil then
            return false, "THE RUNES ARE STILL SETTLING"
        end
        return enemyService:canStillThreat(player, effectRadius)
    end
    return true, "LANTERN GUARD READY"
end

function ProfessionService._applyAbility(
    self: ProfessionService,
    player: Player,
    definition: any,
    tuning: any
): (string, number)
    local effectAmount = definition.effectAmount + tuning.effectAmountBonus
    local effectRadius = definition.effectRadius + tuning.effectRadiusBonus
    local activeSeconds = if definition.id == self._catalog.Ids.Scout
            or definition.id == self._catalog.Ids.Warden
            or definition.id == self._catalog.Ids.Beastkeeper
            or definition.id == self._catalog.Ids.Runebinder
        then definition.activeSeconds + tuning.activeSecondsBonus
        else definition.activeSeconds
    if definition.id == self._catalog.Ids.Scout then
        local _, message = self._enemyService:markNearest(player, effectRadius, activeSeconds)
        return message, 1
    elseif definition.id == self._catalog.Ids.Warden then
        return "LANTERN GUARD ACTIVE — ENEMY DAMAGE REDUCED", 1
    elseif definition.id == self._catalog.Ids.Engineer then
        local _, message = self._enemyService:repairLantern(player, effectRadius, effectAmount)
        return message, 1
    elseif definition.id == self._catalog.Ids.Alchemist then
        -- One effectAmount, two effects: the full number is stamina, half of
        -- it is the mend, so the Brewer specialization deepens both at once
        -- and neither half competes with the Medic's dedicated heal.
        local healResult =
            self._survivalService:healInRadius(player, math.floor(effectAmount / 2), effectRadius)
        local restored = 0
        for _, other in self:_staminaNeedInRadius(player, effectRadius) do
            local result = self._combatService:restoreStamina(other, effectAmount)
            if result.applied then
                restored += 1
            end
        end
        local affected = math.max(healResult.affected, restored)
        return string.format(
            "SPOREBRIGHT TONIC — %d TRAVELER%s RESTORED",
            affected,
            if affected == 1 then "" else "S"
        ),
            affected
    elseif definition.id == self._catalog.Ids.Beastkeeper then
        local _, message = self._enemyService:lureThreat(player, effectRadius, activeSeconds)
        return message, 1
    elseif definition.id == self._catalog.Ids.Runebinder then
        local _, message = self._enemyService:stillThreat(player, effectRadius, activeSeconds)
        return message, 1
    end

    local healResult = self._survivalService:healInRadius(player, effectAmount, effectRadius)
    return string.format(
        "GUIDING PULSE — %d TRAVELER%s RESTORED",
        healResult.affected,
        if healResult.affected == 1 then "" else "S"
    ),
        healResult.affected
end

function ProfessionService.useAbility(self: ProfessionService, player: Player): any
    if not self._featureFlags:isEnabled("profession_kits_enabled") then
        return {
            accepted = false,
            message = "PROFESSION ABILITIES ARE TEMPORARILY UNAVAILABLE",
            reason = "feature_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            accepted = false,
            message = "YOUR PROFESSION LOADOUT IS STILL LOADING",
            reason = "player_loading",
        }
    end

    local now = workspace:GetServerTimeNow()
    local decision = self._professionState.canUse(state, now, self._survivalService:canAct(player))
    if not decision.accepted then
        local message = if decision.reason == "profession_required"
            then "CHOOSE A PROFESSION IN EMBERHOLLOW"
            elseif decision.reason == "cooldown" then string.format(
                "ABILITY RECHARGING — %.1fs",
                decision.remaining or 0
            )
            else "YOU CANNOT USE AN ABILITY RIGHT NOW"
        self._analyticsService:professionAbility(
            player,
            state.selectedId or "none",
            false,
            decision.reason,
            0
        )
        return {
            accepted = false,
            message = message,
            reason = decision.reason,
        }
    end

    local definition = decision.definition
    local masteryState = self._profileService:masterySnapshot(player)
    local tuning = self._professionMastery.tuning(masteryState, definition.id)
    local validTarget, preflightMessage = self:_abilityPreflight(player, definition, tuning)
    if not validTarget then
        self._analyticsService:professionAbility(player, definition.id, false, "invalid_target", 0)
        return {
            accepted = false,
            message = preflightMessage,
            reason = "invalid_target",
        }
    end

    local cooldownSeconds = math.max(1, definition.cooldownSeconds - tuning.cooldownReduction)
    local activeSeconds = if definition.id == self._catalog.Ids.Scout
            or definition.id == self._catalog.Ids.Warden
            or definition.id == self._catalog.Ids.Beastkeeper
            or definition.id == self._catalog.Ids.Runebinder
        then definition.activeSeconds + tuning.activeSecondsBonus
        else definition.activeSeconds
    local nextState =
        self._professionState.commitAbility(state, now, cooldownSeconds, activeSeconds)
    self._states[player] = nextState
    self:_syncPlayer(player)
    local message, affected = self:_applyAbility(player, definition, tuning)
    self._worldService:showProfessionAbility(
        player,
        definition.id,
        definition.effectRadius + tuning.effectRadiusBonus,
        activeSeconds
    )
    local masteryResult = self._profileService:awardMastery(player, definition.id, 10)
    if masteryResult.leveledUp then
        message = string.format(
            "%s · %s RANK %d — %s",
            message,
            definition.displayName,
            masteryResult.level,
            masteryResult.rankName
        )
        if masteryResult.specializationUnlocked then
            message ..= " · SPECIALIZATIONS UNLOCKED"
        end
        self._analyticsService:professionMasteryRank(
            player,
            definition.id,
            masteryResult.level,
            masteryResult.rankName
        )
    end
    self._analyticsService:professionAbility(player, definition.id, true, nil, affected)
    self:_notify(player, message)
    return {
        accepted = true,
        affected = affected,
        message = message,
        reason = "used",
    }
end

function ProfessionService.mitigateIncomingDamage(
    self: ProfessionService,
    player: Player,
    amount: number,
    now: number
): (number, boolean)
    local state = self._states[player]
    if state == nil or not self._professionState.mitigatesDamage(state, now) then
        return amount, false
    end
    local masteryState = self._profileService:masterySnapshot(player)
    local tuning = self._professionMastery.tuning(masteryState, self._catalog.Ids.Warden)
    local definition = self._catalog.get(self._catalog.Ids.Warden)
    local damageReduction =
        math.clamp((definition.effectAmount + tuning.effectAmountBonus) / 100, 0, 0.8)
    return math.max(1, math.ceil(amount * (1 - damageReduction))), true
end

function ProfessionService.rescueTuning(
    self: ProfessionService,
    player: Player,
    baseDuration: number,
    baseHealth: number,
    baseWardSeconds: number
): any
    local state = self._states[player]
    local now = workspace:GetServerTimeNow()
    local profession = if state == nil
        then self._professionState.snapshot(self._professionState.create(nil, now), now)
        else self._professionState.snapshot(state, now)
    local mastery = self._professionMastery.tuning(
        self._profileService:masterySnapshot(player),
        profession.selectedId
    )
    return self._professionRescue.resolve(
        profession.selectedId,
        mastery.level,
        baseDuration,
        baseHealth,
        baseWardSeconds,
        mastery
    )
end

function ProfessionService.snapshot(self: ProfessionService, player: Player): any
    local now = workspace:GetServerTimeNow()
    local state = self._states[player]
    local snapshot = if state == nil
        then self._professionState.snapshot(self._professionState.create(nil, now), now)
        else self._professionState.snapshot(state, now)
    local switchable, unavailableMessage = self:_switchAvailability(player)
    snapshot.enabled = self._featureFlags:isEnabled("profession_kits_enabled")
    snapshot.switchable = switchable
    snapshot.switchUnavailableMessage = unavailableMessage
    snapshot.mastery = self._professionMastery.tuning(
        self._profileService:masterySnapshot(player),
        snapshot.selectedId
    )
    return snapshot
end

return table.freeze(ProfessionService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="147">
          <Properties>
            <string name="Name">ProfileService</string>
            <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ProfileService = {}
ProfileService.__index = ProfileService
ProfileService.Name = "ProfileService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type ProfileService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _analyticsService: any,
        _persistent: boolean,
        _profiles: { [Player]: any },
        _writable: { [Player]: boolean },
        _dirty: { [Player]: boolean },
        _saving: { [Player]: boolean },
        _loading: { [Player]: boolean },
        _lockHeartbeat: { [Player]: number },
        _loadedEvent: BindableEvent,
        _equipmentChangedEvent: BindableEvent,
        _saveSchema: any,
        _townVisitPolicy: any,
        _profilePersistence: any,
        _profileBackup: any,
        _adminInspectionReport: any,
        _config: any,
        _jobId: string,
        _store: GlobalDataStore?,
        _backupStore: GlobalDataStore?,
        _lastBackupAt: { [number]: number },
        _practice: boolean,
    },
    ProfileService
))

-- The materials the launch region actually uses. Kept explicit rather than
-- derived so a future region's currency cannot be granted by an old hook.
local LAUNCH_MATERIAL_IDS = table.freeze({
    "material_heartwood",
    "material_meadow_fiber",
    "material_amber_sap",
    "material_brightcap",
    "material_spring_clay",
})

function ProfileService.new(
    logger: Logger,
    persistent: boolean,
    analyticsService: any
): ProfileService
    return setmetatable({
        Name = ProfileService.Name,
        _logger = logger,
        _analyticsService = analyticsService,
        _persistent = persistent,
        _profiles = {},
        _writable = {},
        _dirty = {},
        _saving = {},
        _loading = {},
        _lockHeartbeat = {},
        _loadedEvent = Instance.new("BindableEvent"),
        _equipmentChangedEvent = Instance.new("BindableEvent"),
        _saveSchema = nil,
        _townVisitPolicy = nil,
        _profilePersistence = nil,
        _profileBackup = nil,
        _adminInspectionReport = nil,
        _config = nil,
        _jobId = "",
        _store = nil,
        _backupStore = nil,
        _lastBackupAt = {},
        _practice = false,
    }, ProfileService)
end

function ProfileService.Init(self: ProfileService, context: any)
    self._saveSchema = context.saveSchema
    self._townVisitPolicy = assert(context.townVisitPolicy, "town visit policy unavailable")
    self._profilePersistence =
        assert(context.profilePersistence, "profile persistence rules unavailable")
    self._profileBackup = assert(context.profileBackup, "profile backup rules unavailable")
    self._adminInspectionReport =
        assert(context.adminInspectionReport, "admin inspection report unavailable")
    self._config = assert(context.config, "config unavailable")
    -- Studio has no JobId. A stable stand-in keeps the lock logic identical
    -- there instead of leaving every Studio session sharing an empty ID.
    self._jobId = if game.JobId ~= nil and game.JobId ~= ""
        then game.JobId
        else "studio-" .. tostring(os.time())
    if self._persistent then
        self._store = DataStoreService:GetDataStore("LastLightProfile_v1")
        -- A separate store rather than another field on the profile: a backup
        -- must survive whatever went wrong with the profile, and a ring of
        -- snapshots living inside the value it is meant to protect would be
        -- lost to the same bad write.
        self._backupStore = DataStoreService:GetDataStore("LastLightProfileBackup_v1")
    end
end

--[[
    Copy a save aside, if this one is worth copying.

    Deliberately never raises: a backup is a best-effort safety net, and a
    DataStore hiccup on this path must not take down the load or save that
    triggered it. A failure is logged and the caller carries on -- the
    alternative, refusing to save because the backup failed, would turn a
    redundancy feature into a new way to lose progress.
]]
function ProfileService._captureBackup(
    self: ProfileService,
    userId: number,
    profile: any,
    storedSchemaVersion: any,
    forcedReason: string?
): string?
    if not self._persistent or self._backupStore == nil or profile == nil then
        return nil
    end

    local now = os.time()
    local key = string.format("player_%d", userId)
    local capturedReason: string? = nil

    local ok, message = pcall(function()
        (self._backupStore :: GlobalDataStore):UpdateAsync(key, function(current: any)
            local decision = if forcedReason ~= nil
                then { capture = true, reason = forcedReason }
                else self._profileBackup.shouldCapture(
                    current,
                    storedSchemaVersion,
                    self._config.SaveSchemaVersion,
                    now,
                    self._config.ProfileBackupIntervalSeconds
                )
            if not decision.capture then
                return nil
            end
            capturedReason = decision.reason
            return self._profileBackup.capture(
                current,
                profile,
                now,
                decision.reason,
                self._config.ProfileBackupRetained
            )
        end)
    end)

    if not ok then
        self._logger:warn("profile_backup_failed", {
            player = userId,
            reason = tostring(message),
        })
        return nil
    end

    if capturedReason ~= nil then
        self._lastBackupAt[userId] = now
        self._logger:info("profile_backup_captured", {
            player = userId,
            reason = capturedReason,
            revision = profile.revision,
            schemaVersion = profile.schemaVersion,
        })
    end
    return capturedReason
end

function ProfileService._load(self: ProfileService, player: Player)
    if self._loading[player] or self._profiles[player] ~= nil then
        return
    end
    self._loading[player] = true

    local now = os.time()
    local profile = self._saveSchema.default(now)
    local source = "fallback"
    local writable = not self._persistent

    if self._persistent and self._store ~= nil then
        local finished = false
        local ok = false
        local result: any = nil

        task.spawn(function()
            ok, result = pcall(function()
                return (self._store :: GlobalDataStore):GetAsync(
                    string.format("player_%d", player.UserId)
                )
            end)
            finished = true
        end)

        local deadline = os.clock() + 6
        while not finished and os.clock() < deadline and player.Parent ~= nil do
            task.wait(0.1)
        end

        local outcome = self._profilePersistence.loadOutcome(finished, ok, result)
        source = outcome.source
        writable = outcome.writable

        --[[
            Two ways a stored save is gone rather than merely unavailable, and
            both are zero-tolerance rather than a failed transaction.

            A stored value that is not a table cannot be folded into anything;
            normalize hands back a default and the player restarts the game
            with their own key overwritten on the next save. And a save stamped
            with a schema this build has never heard of was written by a newer
            one -- folding it down drops whatever that build added, silently,
            and the player who rolled back is the one who pays.
        ]]
        -- GATE-METRIC: save_loss
        if outcome.useStored then
            if type(result) ~= "table" then
                self._analyticsService:saveLoss(player.UserId, "load", "stored_value_not_a_table")
            elseif
                type(result.schemaVersion) == "number"
                and result.schemaVersion > self._config.SaveSchemaVersion
            then
                self._analyticsService:saveLoss(player.UserId, "load", "schema_from_future")
            end
        end

        if outcome.useStored or outcome.source == "new" then
            -- Photograph the stored bytes *before* normalize folds them into
            -- the current shape. This is the moment TECHNICAL_ARCHITECTURE asks
            -- for a backup: a migration here is not a numbered pipeline that
            -- can be replayed backwards, it is a fold into the current default,
            -- so anything it drops is gone with nothing left to compare against.
            -- Spawned rather than awaited -- a player must never wait on the
            -- join path for a redundancy write.
            if outcome.useStored and type(result) == "table" then
                local storedValue = result
                local storedSchemaVersion = storedValue.schemaVersion
                task.spawn(function()
                    self:_captureBackup(player.UserId, storedValue, storedSchemaVersion, nil)
                end)
            end
            profile = self._saveSchema.normalize(if outcome.useStored then result else nil, now)
        elseif finished then
            self._logger:warn("profile_load_failed", {
                player = player.UserId,
                reason = tostring(result),
            })
        else
            self._logger:warn("profile_load_timed_out", { player = player.UserId })
        end

        -- A profile arriving into a practice server is read-only from its
        -- first frame, and never claims a lock. Claiming one would make this
        -- server the sole writer of a save it has already promised never to
        -- write, which is the hostage the release above is about.
        if self._practice then
            writable = false
            source = "practice_read_only"
        end

        -- A profile another live server still holds is played read-only rather
        -- than refused: the player gets a session, and nothing they do in it
        -- can overwrite the copy the other server is still writing.
        if writable then
            local lockDecision = self._profilePersistence.acquireLock(
                if type(result) == "table" then result.sessionLock else nil,
                self._jobId,
                now,
                self._config.ProfileLockStaleAfterSeconds
            )
            if not lockDecision.acquired then
                writable = false
                source = "locked_read_only"
                self._logger:warn("profile_locked_by_another_server", {
                    player = player.UserId,
                    reason = lockDecision.reason,
                })
            elseif lockDecision.reason ~= "unlocked" then
                self._logger:info("profile_lock_acquired", {
                    player = player.UserId,
                    reason = lockDecision.reason,
                })
            end
        end
    else
        source = "session"
    end

    -- The load half of the transaction-success gate, emitted only where there
    -- was a store to reach: a Studio session with no persistence is not a
    -- DataStore round trip, and counting it as a successful one would flatter
    -- the number with results from a machine no player is on.
    -- GATE-METRIC: profile_transaction
    if self._persistent and self._store ~= nil then
        self._analyticsService:profileTransaction(
            player.UserId,
            "load",
            writable and (source == "datastore" or source == "new"),
            source
        )
    end

    if player.Parent == nil then
        self._loading[player] = nil
        return
    end

    profile = self:_applyStudioStock(profile, now)
    self._profiles[player] = profile
    self._writable[player] = writable
    self._loading[player] = nil
    self._loadedEvent:Fire(player, profile)
    self._logger:info("profile_loaded", {
        player = player.UserId,
        source = source,
        stage = profile.tutorial.stage,
    })
end

--[[
    A stocked profile for live verification, and nothing else.

    Several systems can only be judged by playing them -- arming a snare
    costs materials, whetting a blade needs one that has dulled -- and
    reaching that state honestly means a full playthrough every time
    somebody wants to look at a two-second interaction. A live session on
    2026-08-06 spent itself discovering exactly that, and closed with the
    checks still open.

    So: set `LastLightStockProfile` on the DataModel to a number and a
    joining profile arrives with that many of each launch material. Three
    guards, all of which must hold:

      * Studio only. RunService:IsStudio() is false on every Roblox server.
      * Non-persistent environments only. Production runs with persistence
        on; this is refused there even if someone sets the attribute.
      * Logged loudly, every time, with the amount.

    It grants materials, which are earned in play and spent in play. It
    cannot grant progress, chapters, professions or gear, because those
    are the things a verification run is supposed to actually perform.

    The attribute is read at join and again whenever it changes, because a
    Play session starts from a fresh DataModel: a value set while editing
    does not survive into the run, and a driver who has already pressed
    play should not have to restart to stock a purse.
]]
function ProfileService._applyStudioStock(self: ProfileService, profile: any, now: number): any
    if self._persistent or not RunService:IsStudio() then
        return profile
    end
    local requested = tonumber(game:GetAttribute("LastLightStockProfile"))
    if requested == nil then
        return profile
    end
    local amount = math.clamp(math.floor(requested), 1, 200)
    local nextProfile = table.clone(profile)
    nextProfile.inventory = table.clone(profile.inventory)
    local materials = table.clone(profile.inventory.materials)
    for _, materialId in LAUNCH_MATERIAL_IDS do
        materials[materialId] = (tonumber(materials[materialId]) or 0) + amount
    end
    nextProfile.inventory.materials = materials
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    self._logger:warn("studio_profile_stocked", {
        amount = amount,
        materials = #LAUNCH_MATERIAL_IDS,
    })
    return nextProfile
end

function ProfileService._watchStudioStock(self: ProfileService)
    if self._persistent or not RunService:IsStudio() then
        return
    end
    game:GetAttributeChangedSignal("LastLightStockProfile"):Connect(function()
        for player, profile in self._profiles do
            local stocked = self:_applyStudioStock(profile, os.time())
            if stocked ~= profile then
                self._profiles[player] = stocked
                self._loadedEvent:Fire(player, stocked)
            end
        end
    end)
end

function ProfileService.Start(self: ProfileService)
    self:_watchStudioStock()
    Players.PlayerAdded:Connect(function(player: Player)
        task.spawn(function()
            self:_load(player)
        end)
    end)

    Players.PlayerRemoving:Connect(function(player: Player)
        -- The last save a session ever gets. Everything before it has another
        -- beat coming to repair it; this one does not, so a failure here is
        -- the session's progress gone rather than a retry pending -- which is
        -- exactly what the zero-tolerance save-loss gate is counting.
        local hadUnsavedWork = self._dirty[player] == true
        -- A save already in flight is not a failure: `save` refuses a second
        -- concurrent write and returns false for it, and the one that is
        -- running may well land. Counting that as a lost save would put a
        -- zero-tolerance event on the ordinary race between the autosave beat
        -- and a player closing the app.
        local saveInFlight = self._saving[player] == true
        if
            not self:save(player)
            and hadUnsavedWork
            and not saveInFlight
            and self._writable[player] == true
        then
            self._analyticsService:saveLoss(player.UserId, "save", "final_save_failed")
        end
        self._profiles[player] = nil
        self._writable[player] = nil
        self._dirty[player] = nil
        self._saving[player] = nil
        self._loading[player] = nil
        self._lockHeartbeat[player] = nil
    end)

    for _, player in Players:GetPlayers() do
        task.spawn(function()
            self:_load(player)
        end)
    end

    if self._persistent then
        task.spawn(function()
            while true do
                task.wait(self._config.ProfileLockHeartbeatSeconds)
                for player in self._dirty do
                    if player.Parent ~= nil then
                        task.spawn(function()
                            self:save(player)
                        end)
                    end
                end

                -- A player who is simply standing still writes nothing, and a
                -- lock only refreshes on write. Without this pass their own
                -- lock goes stale underneath them and another server becomes
                -- free to reclaim a profile that is still being played.
                local now = os.time()
                for player in self._profiles do
                    if
                        player.Parent ~= nil
                        and self._writable[player] == true
                        and self._dirty[player] == nil
                        and self._profilePersistence.shouldRefreshLock(
                            self._lockHeartbeat[player],
                            now,
                            self._config.ProfileLockHeartbeatSeconds
                        )
                    then
                        local target = player
                        task.spawn(function()
                            self:save(target)
                        end)
                    end
                end
            end
        end)
    end

    game:BindToClose(function()
        local remaining = 0
        for player in self._profiles do
            remaining += 1
            task.spawn(function()
                self:save(player)
                remaining -= 1
            end)
        end

        local deadline = os.clock() + 7
        while remaining > 0 and os.clock() < deadline do
            task.wait(0.1)
        end
    end)
end

function ProfileService.onLoaded(
    self: ProfileService,
    callback: (Player, any) -> ()
): RBXScriptConnection
    return self._loadedEvent.Event:Connect(callback)
end

function ProfileService.onEquipmentChanged(
    self: ProfileService,
    callback: (Player, any) -> ()
): RBXScriptConnection
    return self._equipmentChangedEvent.Event:Connect(callback)
end

--[[
    Entries this service is still holding for players who are no longer in
    the server.

    Roblox exposes no count of live script connections, so this is the
    observable half of the same question: a connection that outlived a
    player kept its closure alive, and a closure that outlived a player
    kept its table entry alive too. Every per-player table is walked rather
    than a representative one, because a cleanup that forgets a single
    table is exactly the shape this is looking for.
]]
function ProfileService.playerResidue(self: ProfileService): number
    local present: { [Player]: boolean } = {}
    for _, player in Players:GetPlayers() do
        present[player] = true
    end
    local residue = 0
    local tables: { { [Player]: any } } = {
        self._profiles,
        self._writable,
        self._dirty,
        self._saving,
        self._loading,
        self._lockHeartbeat,
    }
    for _, held in tables do
        for player in held do
            if not present[player] then
                residue += 1
            end
        end
    end
    return residue
end

--[[
    The largest profile this server is holding, in the bytes a DataStore
    would charge for it. The largest rather than the average, because the
    save that stops fitting is one player's, and an average over a lobby of
    fresh profiles hides it.
]]
function ProfileService.largestProfileBytes(self: ProfileService): number
    local largest = 0
    for _, profile in self._profiles do
        local ok, encoded = pcall(function()
            return game:GetService("HttpService"):JSONEncode(profile)
        end)
        if ok and type(encoded) == "string" then
            largest = math.max(largest, #encoded)
        end
    end
    return largest
end

function ProfileService.get(self: ProfileService, player: Player): any
    return self._profiles[player]
end

function ProfileService.isLoaded(self: ProfileService, player: Player): boolean
    return self._profiles[player] ~= nil
end

function ProfileService.isWritable(self: ProfileService, player: Player): boolean
    return self._profiles[player] ~= nil
        and not self._practice
        and (not self._persistent or self._writable[player] == true)
end

--[[
    Turn this server into a practice server, for good.

    Every mutation in the game funnels through `isWritable` and every durable
    write through `save`, which is why practice is two lines rather than an
    audit of forty reward paths. That matters more than the line count: "a
    practice phase grants nothing" is the exit-gate claim, and a claim held at
    one seam can be checked, while a claim held at forty is a claim somebody
    will add a forty-first path beside.

    Three things happen in an order that is not arbitrary.

    **One last honest save.** Progress earned before the latch was earned under
    ordinary rules and belongs to the player. Dropping it would make engaging a
    control a punishment for everything that came before it, which is not what
    practice means.

    **Then the latch**, before any lock is released, so nothing can be written
    between the flush and the renunciation.

    **Then the locks go back.** A session lock is this server's claim to be the
    only writer of a profile. A server that has renounced writing forever and
    still holds the claim is holding somebody's save hostage: they would leave,
    join a real server, and play their own game read-only until a lock that will
    never beat again goes stale. So practice gives the locks back, and a profile
    that arrives after the latch never claims one at all.
]]
function ProfileService.beginPractice(self: ProfileService, reason: string): boolean
    if self._practice then
        return false
    end

    for player in self._profiles do
        if self._persistent and self._writable[player] == true then
            self:save(player)
        end
    end

    self._practice = true
    self._logger:warn("profile_practice_engaged", { reason = reason })

    for player in self._profiles do
        if self._persistent and self._writable[player] == true then
            self:_releaseLock(player)
        end
    end

    --[[
        And the bookkeeping goes with the claim, because leaving it behind
        makes this latch write to a zero-tolerance gate.

        `_writable` still true and `_dirty` still set is a server that says it
        may write and never does. The leave path reads exactly those two -- a
        failed save plus unsaved work plus a writable profile -- and files
        `save_loss`, so every departure from a practice server would report lost
        progress against the one metric RELEASE_GATES.md allows no failures on.
        Nothing was lost: the flush above is the whole of it. The heartbeat has
        the smaller version of the same bug, respawning a save task for every
        still-dirty player forever, because `save` now returns before anything
        can clear the flag.
    ]]
    for player in self._profiles do
        self._writable[player] = false
        self._dirty[player] = nil
    end
    return true
end

function ProfileService.isPractice(self: ProfileService): boolean
    return self._practice
end

function ProfileService.recordDiscoveredSeed(
    self: ProfileService,
    player: Player,
    regionId: any,
    seed: any
): boolean
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return false
    end
    local nextProfile = self._saveSchema.withDiscoveredSeed(profile, regionId, seed, os.time())
    if nextProfile == profile then
        return false
    end
    self._profiles[player] = nextProfile
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return true
end

function ProfileService.discoveredSeeds(self: ProfileService, player: Player): { any }
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.discoveredSeeds(profile)
end

--[[
    Hand a profile's session lock back without touching the profile.

    Deliberately not a save: the stored copy is whatever the flush above left,
    and writing the in-memory profile again here would be the practice server
    persisting one more time on its way out of the business of persisting.
]]
function ProfileService._releaseLock(self: ProfileService, player: Player)
    local store = self._store
    if store == nil then
        return
    end
    local jobId = self._jobId
    local ok, message = pcall(function()
        store:UpdateAsync(string.format("player_%d", player.UserId), function(current: any)
            if type(current) ~= "table" then
                return current
            end
            local held = current.sessionLock
            -- Only ours. A lock some other server claimed while this one was
            -- flushing is not this one's to give away.
            if type(held) ~= "table" or held.jobId ~= jobId then
                return current
            end
            local written = table.clone(current)
            written.sessionLock = nil
            return written
        end)
    end)
    if not ok then
        self._logger:warn("profile_lock_release_failed", {
            player = player.UserId,
            reason = tostring(message),
        })
    end
end

function ProfileService.setTutorial(
    self: ProfileService,
    player: Player,
    stage: string,
    selectedTool: string?
): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end

    local previousTool = profile.tutorial.selectedTool
    self._profiles[player] = self._saveSchema.withTutorial(profile, stage, selectedTool, os.time())
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    if selectedTool ~= previousTool then
        -- The held-tool visual rides the equipment-changed signal: choosing a
        -- starter tool should put it in the hand at the pedestal, not on the
        -- next respawn, and the gear visual service already listens here.
        self._equipmentChangedEvent:Fire(
            player,
            self._saveSchema.equippedSnapshot(self._profiles[player])
        )
    end
    return true
end

function ProfileService.gearTraitOf(self: ProfileService, player: Player, itemId: any): any
    local profile = self._profiles[player]
    if profile == nil then
        return nil
    end
    local traits = (profile :: any).gearTraits
    return if type(traits) == "table" and type(itemId) == "string" then traits[itemId] else nil
end

function ProfileService.accrueGearWear(
    self: ProfileService,
    player: Player,
    itemId: any,
    pointsOverride: number?
): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { applied = false }
    end
    local nextProfile, result = self._saveSchema.withGearWear(profile, itemId, pointsOverride or 2)
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent and self._writable[player] == true then
            self._dirty[player] = true
        end
    end
    return result
end

function ProfileService.repairGear(self: ProfileService, player: Player, itemId: any): any
    local profile = self._profiles[player]
    if profile == nil then
        return { applied = false, reason = "profile_loading" }
    end
    if not self:isWritable(player) then
        return { applied = false, reason = "profile_read_only" }
    end
    local nextProfile, result = self._saveSchema.withRepairedGear(profile, itemId, os.time())
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent and self._writable[player] == true then
            self._dirty[player] = true
        end
    end
    return result
end

function ProfileService.spendMaterials(self: ProfileService, player: Player, cost: any): any
    local profile = self._profiles[player]
    if profile == nil then
        return { applied = false, reason = "profile_loading" }
    end
    if not self:isWritable(player) then
        return { applied = false, reason = "profile_read_only" }
    end
    local nextProfile, result = self._saveSchema.withSpentMaterials(profile, cost, os.time())
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent and self._writable[player] == true then
            self._dirty[player] = true
        end
    end
    return result
end

--[[
    Field repair: the most-worn item, no material cost. Used by a carried
    item rather than a bench, so it works where a bench cannot.
]]
function ProfileService.fieldRepairGear(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return { applied = false, reason = "profile_loading" }
    end
    if not self:isWritable(player) then
        return { applied = false, reason = "profile_read_only" }
    end
    local nextProfile, result = self._saveSchema.withFieldRepair(profile, os.time())
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent and self._writable[player] == true then
            self._dirty[player] = true
        end
    end
    return result
end

function ProfileService.hasWornGear(self: ProfileService, player: Player): boolean
    local wear = self:gearWearOf(player)
    for _, points in wear do
        if (tonumber(points) or 0) > 0 then
            return true
        end
    end
    return false
end

function ProfileService.gearWearOf(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    return if profile ~= nil then (profile :: any).gearWear or {} else {}
end

function ProfileService.saveLoadout(self: ProfileService, player: Player, slot: number): any
    local profile = self._profiles[player]
    if profile == nil then
        return { applied = false, reason = "profile_loading" }
    end
    if not self:isWritable(player) then
        return { applied = false, reason = "profile_read_only" }
    end
    local nextProfile, result = self._saveSchema.withLoadout(profile, slot, os.time())
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent and self._writable[player] == true then
            self._dirty[player] = true
        end
    end
    return result
end

function ProfileService.loadoutAt(self: ProfileService, player: Player, slot: any): any
    local profile = self._profiles[player]
    if profile == nil then
        return nil
    end
    return self._saveSchema.loadoutAt(profile, slot)
end

function ProfileService.setProfession(
    self: ProfileService,
    player: Player,
    professionId: string
): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end

    self._profiles[player] = self._saveSchema.withProfession(profile, professionId, os.time())
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return true
end

function ProfileService.awardMastery(
    self: ProfileService,
    player: Player,
    professionId: string,
    amount: number
): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { applied = false, reason = "profile_unavailable" }
    end
    local nextProfile, result =
        self._saveSchema.withMasteryAward(profile, professionId, amount, os.time())
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    return result
end

