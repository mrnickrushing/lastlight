ResidentRoster.Order = ORDER

function ResidentRoster.get(residentId: any): Resident?
    return if type(residentId) == "string" then DEFINITIONS[residentId] else nil
end

function ResidentRoster.require(residentId: string): Resident
    local definition = DEFINITIONS[residentId]
    assert(definition ~= nil, string.format("unknown resident ID %q", residentId))
    return definition
end

function ResidentRoster.list(): { Resident }
    local result: { Resident } = {}
    for _, residentId in ORDER do
        table.insert(result, DEFINITIONS[residentId])
    end
    return result
end

--[[
    Who is in town at a given chapter. Chapter defaults to one, which is
    what every caller that predates the roster means, so nothing changes
    for a save that has not left Bramblewake.
]]
--[[
    Who is in town at a given point in the story. `ending` is the finale's
    own id and only matters to the postgame residents: one of them is in
    town or is not depending on what a party did with the light, and a
    caller that does not know the ending gets the town without them, which
    is the correct answer for every save that has not finished.
]]
function ResidentRoster.idsForChapter(chapter: number?, ending: string?): { string }
    local reached = math.max(1, math.floor(tonumber(chapter) or 1))
    local ids: { string } = {}
    for _, residentId in ORDER do
        local definition = DEFINITIONS[residentId]
        local allowed = true
        if definition.requiresEnding ~= nil then
            allowed = false
            for _, endingId in definition.requiresEnding do
                if endingId == ending then
                    allowed = true
                    break
                end
            end
        end
        if allowed and definition.arrivesInChapter <= reached then
            table.insert(ids, residentId)
        end
    end
    return ids
end

function ResidentRoster.jobs(): { [string]: Job }
    local jobs: { [string]: Job } = {}
    for _, residentId in ORDER do
        jobs[residentId] = DEFINITIONS[residentId].job
    end
    return jobs
end

function ResidentRoster.questIdFor(residentId: any): string?
    local definition = ResidentRoster.get(residentId)
    return if definition == nil then nil else definition.questId
end

return table.freeze(ResidentRoster)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="92">
        <Properties>
          <string name="Name">ReviveFlow</string>
          <string name="Source"><![CDATA[--!strict

local ReviveFlow = {}

export type Channel = {
    endsAt: number,
    reviverRevision: number,
    reviverUserId: number,
    startedAt: number,
    targetUserId: number,
}
export type Conditions = {
    reachable: boolean,
    reviverCanAct: boolean,
    reviverPresent: boolean,
    reviverRevision: number,
    targetDowned: boolean,
    targetPresent: boolean,
}
export type DecisionStatus = "cancel" | "complete" | "pending"
export type Decision = {
    elapsed: number?,
    reason: string?,
    remaining: number?,
    status: DecisionStatus,
}

local function finiteNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeNonNegative(value: any): boolean
    return finiteNumber(value) and value >= 0 and value == math.floor(value)
end

function ReviveFlow.create(
    targetUserId: number,
    reviverUserId: number,
    reviverRevision: number,
    now: number,
    duration: number
): Channel
    assert(wholeNonNegative(targetUserId), "target user ID is invalid")
    assert(wholeNonNegative(reviverUserId), "reviver user ID is invalid")
    assert(targetUserId ~= reviverUserId, "players cannot revive themselves")
    assert(wholeNonNegative(reviverRevision), "reviver revision is invalid")
    assert(finiteNumber(now), "revive start time is invalid")
    assert(finiteNumber(duration) and duration > 0, "revive duration is invalid")

    return table.freeze({
        endsAt = now + duration,
        reviverRevision = reviverRevision,
        reviverUserId = reviverUserId,
        startedAt = now,
        targetUserId = targetUserId,
    })
end

function ReviveFlow.evaluate(channel: Channel, now: number, conditions: Conditions): Decision
    assert(finiteNumber(now), "revive evaluation time is invalid")
    if conditions.targetPresent ~= true then
        return {
            reason = "target_left",
            status = "cancel",
        }
    end
    if conditions.reviverPresent ~= true then
        return {
            reason = "reviver_left",
            status = "cancel",
        }
    end
    if conditions.targetDowned ~= true then
        return {
            reason = "target_not_downed",
            status = "cancel",
        }
    end
    if conditions.reviverCanAct ~= true then
        return {
            reason = "reviver_cannot_act",
            status = "cancel",
        }
    end
    if conditions.reviverRevision ~= channel.reviverRevision then
        return {
            reason = "reviver_state_changed",
            status = "cancel",
        }
    end
    if conditions.reachable ~= true then
        return {
            reason = "revive_out_of_range",
            status = "cancel",
        }
    end
    if now >= channel.endsAt then
        return {
            elapsed = math.max(0, now - channel.startedAt),
            status = "complete",
        }
    end
    return {
        remaining = math.max(0, channel.endsAt - now),
        status = "pending",
    }
end

return table.freeze(ReviveFlow)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="93">
        <Properties>
          <string name="Name">RolloutCohorts</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Which players a flag has reached, and in what order it reaches them.

    Milestone 13's rollout is four rungs -- team and trusted testers, then a
    small allowlist across devices and age ranges with guardian consent, then
    a larger cohort behind controlled flags, then the creator and community
    test once moderation and scale look healthy. The flag service this game
    has shipped since Milestone 1 answers one question globally: on, or off.
    A staged rollout needs it to answer per player, and the interesting part
    is not the answer. It is what happens when somebody *advances* the stage.

    **The ladder only ever widens.** A flag moved from `team` to `allowlist`
    must not take the feature away from the testers who have been living with
    it, because those are the people whose reports the next rung is decided
    on. That is not a promise kept by whoever edits the table -- it is
    structural here: `admits` walks the rungs from the bottom up to the flag's
    current stage and returns at the first one that lets the player in, so a
    later stage cannot narrow an earlier one. There is no rung that subtracts.

    **A cohort-scoped flag read without a player is refused, not guessed.**
    Every call site in this game today asks globally, and a flag that becomes
    cohort-scoped while one of them still asks globally has to answer
    something. Both answers are wrong in a way that is invisible: `true` ships
    an unreleased feature to the whole population, which is the exact thing
    a staged rollout exists to prevent, and `false` makes it untestable for
    the cohort it was turned on for. So there is no answer. The read throws,
    the same way an unknown flag already does, because this can only be
    reached by a programming mistake and a loud one costs a Studio session
    while a quiet one costs a beta.

    **A bucket is stable per player and independent per flag.** Stable
    because a feature that is on in one server and off in the next is worse
    than a feature that is off: the player reports a bug nobody can
    reproduce. Independent because if the same players are picked for every
    flag, the beta has one cohort wearing four flags and every measurement is
    about that one group.

    The independence is the part that had to be measured rather than
    reasoned about. The first version hashed `flag .. userId` and ran the
    result through the same Lehmer step `ExpeditionGenerator` uses, and every
    operation in that chain is affine -- so changing the flag name shifted
    every player's bucket by one constant. Two flags at ten percent produced
    cohorts that were **perfectly disjoint** (measured: 0 players in both,
    against 201 expected), and two flags at fifty percent would have cut the
    population into exact complements, so no player would ever have seen both
    features. Folding the two hashes together with an exclusive or breaks the
    affinity, and the same measurement then returns 200 against 201 expected.

    Pure. No players, no services, no clock: user IDs and flag names in,
    booleans out.
]]

local RolloutCohorts = {}

export type Stage = "off" | "team" | "allowlist" | "cohort" | "everyone"

export type Rollout = {
    stage: Stage,
    -- What share of the population the `cohort` rung admits, 0 to 100. Read
    -- at no other stage, and required at every stage so a flag advancing to
    -- `cohort` cannot arrive without one.
    percent: number,
}

export type Roster = {
    -- Milestone 13 rung one: the team and the trusted testers.
    team: { [number]: boolean },
    -- Rung two: the consented allowlist across devices and age ranges.
    allowlist: { [number]: boolean },
}

--[[
    The rungs, in the order the roadmap climbs them. `off` is a real rung
    rather than an absent one: a flag nobody has yet is a state a matrix has
    to be able to say out loud, and it is where every unreleased flag in this
    game sits today.
]]
local STAGES: { Stage } = table.freeze({
    "off" :: Stage,
    "team",
    "allowlist",
    "cohort",
    "everyone",
})

local RANK: { [string]: number } = {}
for index, stage in STAGES do
    RANK[stage] = index
end
table.freeze(RANK)

local HASH_MULTIPLIER = 33
local HASH_MODULUS = 2147483647
local MIX_MULTIPLIER = 16807
local BUCKETS = 100

local function textHash(text: string): number
    local result = 0
    for index = 1, #text do
        result = (result * HASH_MULTIPLIER + string.byte(text, index)) % HASH_MODULUS
    end
    return result
end

function RolloutCohorts.stages(): { Stage }
    return table.clone(STAGES)
end

function RolloutCohorts.rank(stage: any): number?
    if type(stage) ~= "string" then
        return nil
    end
    return RANK[stage]
end

function RolloutCohorts.isStage(value: any): boolean
    return RolloutCohorts.rank(value) ~= nil
end

--[[
    Whether this stage has a single answer for the whole population.

    `off` and `everyone` do; the three rungs between them do not, and a read
    of one of those without a player is the refusal this module exists to
    make loud.
]]
function RolloutCohorts.isScoped(stage: any): boolean
    local rank = RolloutCohorts.rank(stage)
    return rank ~= nil and rank > 1 and rank < #STAGES
end

--[[
    The one answer a global read is allowed to give. `everyone` is the only
    stage that is on for a player nobody has said anything about, which is
    what makes the flag table and the stage matrix the same fact rather than
    two facts that can drift.
]]
function RolloutCohorts.globalDefault(stage: any): boolean
    return stage == "everyone"
end

--[[
    Where a player sits in the 0..99 spread for one flag.

    The two hashes are folded with an exclusive or rather than concatenated,
    for the reason written at the top of this file: concatenation is affine
    all the way through and produced rotations of one ordering instead of a
    different ordering per flag.
]]
function RolloutCohorts.bucket(flag: string, userId: number): number
    local folded = bit32.bxor(textHash(flag), textHash("u" .. tostring(math.floor(userId))))
    local state = folded % HASH_MODULUS
    if state == 0 then
        state = 1
    end
    return ((state * MIX_MULTIPLIER) % HASH_MODULUS) % BUCKETS
end

local function inRoster(roster: Roster?, key: string, userId: number): boolean
    if roster == nil then
        return false
    end
    local list = (roster :: any)[key]
    return type(list) == "table" and list[userId] == true
end

--[[
    Whether this player has the flag, and which rung let them in.

    The walk is bottom-up on purpose. Every rung is asked in turn until one
    admits or the flag's own stage is passed, so widening a rollout can only
    ever add people. There is no branch here that takes the feature back off
    somebody, which is the property the whole module is for.
]]
function RolloutCohorts.admits(
    flag: string,
    rollout: Rollout,
    roster: Roster?,
    userId: number
): (boolean, string)
    local ceiling = RolloutCohorts.rank(rollout.stage)
    if ceiling == nil then
        return false, "unknown_stage"
    end

    if type(userId) ~= "number" or userId ~= userId or math.floor(userId) ~= userId then
        return false, "no_subject"
    end

    for rank = 2, ceiling do
        local stage = STAGES[rank]
        if stage == "team" then
            if inRoster(roster, "team", userId) then
                return true, "team"
            end
        elseif stage == "allowlist" then
            if inRoster(roster, "allowlist", userId) then
                return true, "allowlist"
            end
        elseif stage == "cohort" then
            local percent = rollout.percent
            if type(percent) == "number" and RolloutCohorts.bucket(flag, userId) < percent then
                return true, "cohort"
            end
        elseif stage == "everyone" then
            return true, "everyone"
        end
    end

    if ceiling == 1 then
        return false, "stage_off"
    end
    return false, "outside_cohort"
end

return table.freeze(RolloutCohorts)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="94">
        <Properties>
          <string name="Name">RunHandoff</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The contract for handing a departing party to its own run server.

    Pure logic: no TeleportService, no players. It decides what a departure
    payload must contain, whether an arriving server should trust one, and
    what a server should do when a teleport fails. Keeping that here means the
    rules can be tested without a live game, which matters more than usual
    because reserved-server teleports cannot be exercised in Studio at all.

    The rules:

      * A run server is told what it is by its teleport payload. A server that
        receives no payload, or one it cannot verify, behaves as a lobby --
        the safe default, because a wrong guess in that direction strands a
        player in an empty world rather than merely showing them the lodge.
      * Payloads are validated field by field on arrival. Teleport data is
        reachable by exploiters on some paths, so nothing in it is trusted as
        authority: it may say "this is a run", never "give me rewards".
      * A failed teleport returns the party to the lobby with the departure
        cancelled and nothing consumed. A half-sent party that lost its
        staging state is worse than a party that never left.
      * The party size that was chosen travels with the payload so the run
        server can bound its own population without asking the lobby.
      * **The party's ID travels too, and is the only reason it is here.** A
        run server that knows which party it belongs to can recognise one of
        its own members arriving on a rejoin ticket and leave them where they
        landed, instead of forwarding them to the world they are standing in.
        Like everything else in the payload it is inert: it names a party, it
        does not prove membership of one, and nothing is granted on it.
]]

local RunHandoff = {}

export type Payload = {
    schemaVersion: number,
    kind: string,
    partySize: number,
    departedAt: number,
    partyId: string?,
}

--[[
    Bumped to 2 when the party ID joined the payload. A server mid-flight
    across a deploy carries a version-1 payload, which now reads as a
    mismatch and resolves to a lobby -- the safe direction the whole module
    is built on, and the reason the version is checked before anything else.
]]
local SCHEMA_VERSION = 2
local RUN_KIND = "last_light_run"
local MAX_PARTY_SIZE = 8
local MAX_PARTY_ID_LENGTH = 64

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeBetween(value: any, low: number, high: number): boolean
    return finite(value) and value >= low and value <= high and value == math.floor(value)
end

function RunHandoff.schemaVersion(): number
    return SCHEMA_VERSION
end

function RunHandoff.runKind(): string
    return RUN_KIND
end

local function isPartyId(value: any): boolean
    return type(value) == "string" and #value > 0 and #value <= MAX_PARTY_ID_LENGTH
end

--[[
    Build the payload a departing party carries to its run server.

    `partySize` is the size the lobby actually launched, not the size that was
    requested, so a party that shrank on the platform arrives described
    correctly.

    `partyId` is optional because this module has to keep working for a
    departure that formed no party -- one player stepping onto the platform
    and tapping a number is still a run, and refusing it for want of a roster
    would be the party system taking something away.
]]
function RunHandoff.buildPayload(partySize: any, now: any, partyId: any): (Payload?, any)
    if not wholeBetween(partySize, 1, MAX_PARTY_SIZE) then
        return nil, { accepted = false, reason = "invalid_party_size" }
    end
    if not finite(now) or now < 0 then
        return nil, { accepted = false, reason = "invalid_time" }
    end
    if partyId ~= nil and not isPartyId(partyId) then
        return nil, { accepted = false, reason = "invalid_party_id" }
    end
    return {
        schemaVersion = SCHEMA_VERSION,
        kind = RUN_KIND,
        partySize = partySize,
        departedAt = now,
        partyId = partyId,
    }, { accepted = true }
end

--[[
    Decide what an arriving server is.

    Anything unrecognised resolves to a lobby. A server that wrongly believes
    it is a run skips the lodge and drops a player into the world with no way
    to start one; a server that wrongly believes it is a lobby merely shows a
    staging room the player can depart from again.
]]
function RunHandoff.readPayload(value: any): any
    if type(value) ~= "table" then
        return { isRun = false, reason = "no_payload" }
    end
    if value.schemaVersion ~= SCHEMA_VERSION then
        return { isRun = false, reason = "schema_mismatch" }
    end
    if value.kind ~= RUN_KIND then
        return { isRun = false, reason = "unknown_kind" }
    end
    if not wholeBetween(value.partySize, 1, MAX_PARTY_SIZE) then
        return { isRun = false, reason = "invalid_party_size" }
    end
    if not finite(value.departedAt) or value.departedAt < 0 then
        return { isRun = false, reason = "invalid_time" }
    end
    --[[
        An unreadable party ID is dropped rather than rejected. The run is
        still a run; what is lost is only the server's ability to recognise
        its own returning members, and refusing the whole payload over that
        would strand a party in the lodge to protect a convenience.
    ]]
    return {
        isRun = true,
        partySize = value.partySize,
        departedAt = value.departedAt,
        partyId = if isPartyId(value.partyId) then value.partyId else nil,
    }
end

--[[
    What to do when a teleport attempt fails.

    Always returns the party to the lobby and always cancels the departure.
    Reserving and teleporting are separate calls that can each fail, and the
    only safe response to either is to put everyone back where they were
    standing with nothing spent.
]]
function RunHandoff.failureRecovery(reason: any): any
    return {
        returnToLobby = true,
        cancelDeparture = true,
        reason = if type(reason) == "string" and #reason > 0 then reason else "unknown",
        message = "THE ROAD DID NOT OPEN - EVERYONE IS STILL HERE",
    }
end

return table.freeze(RunHandoff)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="95">
        <Properties>
          <string name="Name">RuntimeIds</string>
          <string name="Source"><![CDATA[--!strict

local ExpeditionEventFlow = require("./ExpeditionEventFlow")
local PrivateServerControls = require("./PrivateServerControls")
local ProfessionMastery = require("./ProfessionMastery")
local TownProgression = require("./TownProgression")

local professionSpecializationInteractionIds = {}
local professionSpecializationInteractionIdBySpecialization = {}
for _, specializationId in ProfessionMastery.specializationIds() do
    local interactionId = "mastery_" .. specializationId
    assert(
        professionSpecializationInteractionIdBySpecialization[specializationId] == nil,
        "duplicate profession specialization runtime ID: " .. specializationId
    )
    table.insert(professionSpecializationInteractionIds, interactionId)
    professionSpecializationInteractionIdBySpecialization[specializationId] = interactionId
end

-- One construction interaction per building, generated from the shared
-- sixteen-building list rather than written out by hand, the same reasoning
-- TownProgression.luau itself gives for driving the later eleven buildings
-- off one table: a building added to the town gets an interaction ID for
-- free instead of needing someone to remember to add one.
local constructionInteractionIds = {}
-- Storm damage is per building now, so a repair prompt belongs to a building
-- the same way a construction prompt does. Generated from the same list for the
-- same reason: a building added to the town gets both for free.
local townRepairInteractionIds = {}
for _, buildingId in TownProgression.buildingIds() do
    constructionInteractionIds[buildingId] = "construction_" .. buildingId
    townRepairInteractionIds[buildingId] = "town_repair_" .. buildingId
end

-- One board per private-server control, generated from the control list rather
-- than written out, for the reason the construction prompts are generated: a
-- control added to the catalog gets a board it can be pressed on instead of
-- needing somebody to remember to add one. The rail is the only place these
-- exist, so a control with no board is a control nobody can reach.
local privateControlInteractionIds: { [string]: string } = {}
for _, control in PrivateServerControls.controls() do
    privateControlInteractionIds[control.id] = "private_control_" .. control.id
end

local RuntimeIds = {
    FolderName = "LastLightRuntime",
    WorldName = "LastLightWorld",
    InteractionTag = "LastLightInteractable",
    AmbientMoteTag = "LastLightAmbientMote",
    AmbientMotionTag = "LastLightAmbientMotion",
    AmbientLightTag = "LastLightAmbientLight",
    AmbientSwayTag = "LastLightAmbientSway",
    ExpeditionModuleTag = "LastLightExpeditionModule",
    ExpeditionPointOfInterestTag = "LastLightExpeditionPOI",
    ExpeditionEventTag = "LastLightExpeditionEvent",
    ExpeditionEventStepTag = "LastLightExpeditionEventStep",
    ExpeditionExtractionTag = "LastLightExpeditionExtraction",
    ExpeditionEliteTag = "LastLightExpeditionElite",
    ExpeditionBossTag = "LastLightExpeditionBoss",
    ExpeditionBlackoutTag = "LastLightExpeditionBlackout",
    PlayerDownedTag = "LastLightPlayerDowned",
    eventInteractionId = ExpeditionEventFlow.interactionId,
    Remotes = table.freeze({
        ActionRequest = "ActionRequest",
        StateChanged = "StateChanged",
        GetState = "GetState",
        -- Deliberately not an action kind. Perf samples are telemetry that
        -- grants nothing, and keeping them off the action remote means the
        -- gameplay payload contract stays one field per kind.
        PerformanceReport = "PerformanceReport",
    }),
    Actions = table.freeze({
        Rescue = "rescue",
        Gather = "gather",
        ChooseTool = "choose_tool",
        Build = "build",
        Prepare = "prepare",
        PlaceDecoration = "place_decoration",
        Reveal = "reveal",
        Interact = "interact",
        UseTool = "use_tool",
        Sprint = "sprint",
        Dodge = "dodge",
        ProfessionAbility = "profession_ability",
        SelectProfession = "select_profession",
        CompactHud = "compact_hud",
        ExpeditionEvent = "expedition_event",
        OldGrowthFire = "old_growth_fire",
        WardenStagChoice = "warden_stag_choice",
        BramblewakeBlackout = "bramblewake_blackout",
        Extract = "extract",
        Revive = "revive",
        CraftItem = "craft_item",
        UseGear = "use_gear",
        EquipGear = "equip_gear",
        LobbyDepart = "lobby_depart",
        SaveLoadout = "save_loadout",
        RepairGear = "repair_gear",
        CompanionCommand = "companion_command",
        ApplyLoadout = "apply_loadout",
        GatherResource = "gather_resource",
        OpenFieldBook = "open_field_book",
        TalkResident = "talk_resident",
        RepairTown = "repair_town",
        ResolveTownIncident = "resolve_town_incident",
        RecoverExpeditionCache = "recover_expedition_cache",
        SelectProfessionSpecialization = "select_profession_specialization",
        ContributeConstruction = "contribute_construction",
        RecoverMemoryFragment = "recover_memory_fragment",
        --[[
            Parties. Four kinds rather than one because they are four
            different questions, and folding them into a mode field would
            put a target and a verb in the same payload -- which is two
            extra fields, and the one-extra-field rule is the wall that
            #219 was found against.

            PartyInvite carries nothing at all on purpose: it offers a seat
            to whoever is standing on the departure platform, measured
            server-side, so a press cannot name a stranger across the map
            and cannot be forged into naming one.
        ]]
        PartyInvite = "party_invite",
        PartyReply = "party_reply",
        PartyLeave = "party_leave",
        PartyRejoin = "party_rejoin",
        --[[
            One phrase from a closed vocabulary, and nothing else. The phrase
            decides both what is said and what kind of marker it leaves; where
            the marker lands is the sender's own position, read server-side.
            A payload that could name a place would be a payload that could
            name somebody else's place.
        ]]
        QuickChat = "quick_chat",
        --[[
            Who may visit this town. Interaction-routed like every other thing
            in the world you walk up to: the gate carries it, the client sends
            a plain Interact naming the gate, and the server reads the ActionId
            off the prompt. No payload, because the press does not choose a
            value -- it takes the next one, and the gate says which that is.
        ]]
        SetVisitPolicy = "set_visit_policy",
        --[[
            The store, in four kinds because they are four different questions
            and the taxonomy already counts them apart: a view, a card looked
            at, a prompt raised, a thing worn.

            OpenStore is interaction-routed and carries nothing -- the
            outfitter's stand is the only door, so there is no payload in which
            to name a store that is somewhere else. The other three each carry
            exactly one id.

            EquipCosmetic names a cosmetic and never a slot. The slot is the
            catalog's answer about that cosmetic, which is the only version of
            it a server should trust: #331's review found `equip` letting any
            owned cosmetic go in any slot, so an outfit could be worn as a
            lantern shell. A payload that cannot name a slot cannot name the
            wrong one. Pressing an id you are already wearing takes it off,
            which is what keeps taking-off from needing a second field.
        ]]
        OpenStore = "open_store",
        StoreDetail = "store_detail",
        StorePurchase = "store_purchase",
        EquipCosmetic = "equip_cosmetic",
        --[[
            A board on the private server's control rail, and it carries no
            payload at all -- not even which board.

            Which control was pressed is an attribute on the prompt the player
            is standing at, read server-side, the same way a profession
            specialization's is. That is deliberate rather than tidy: these
            controls end a server's rewards permanently, and a payload naming
            one would let a client end them from anywhere, at any moment, with
            no rail in front of it. There is nothing to forge because there is
            nothing in the payload.
        ]]
        PrivateControl = "private_control",
    }),
    InteractionIds = table.freeze({
        Mara = "mara_rescue",
        Heartwood = "heartwood_gather",
        ToolAxe = "tool_axe",
        ToolHammer = "tool_hammer",
        ToolTorch = "tool_torch",
        ToolPick = "tool_pick",
        ToolSickle = "tool_sickle",
        ToolFishingKit = "tool_fishing_kit",
        ToolClimbingKit = "tool_climbing_kit",
        ToolSurveyKit = "tool_survey_kit",
        Barricade = "barricade_build",
        Lantern = "first_lantern_prepare",
        Beacon = "bramblewake_reveal",
        Wayhome = "bramblewake_wayhome",
        OldGrowthFireSource = "old_growth_fire_source",
        OldGrowthHeart = "old_growth_root_heart",
        WardenStagRootNorth = "warden_stag_root_node_north",
        WardenStagRootEast = "warden_stag_root_node_east",
        WardenStagRootSouth = "warden_stag_root_node_south",
        WardenStagRootWest = "warden_stag_root_node_west",
        WardenStagAntlerLeft = "warden_stag_antler_left",
        WardenStagAntlerRight = "warden_stag_antler_right",
        BlackoutFireSource = "blackout_fire_source",
        BlackoutRootFarm = "blackout_root_farm",
        BlackoutRootMill = "blackout_root_mill",
        BlackoutRootCathedral = "blackout_root_cathedral",
        BlackoutDecisionFarmland = "blackout_decision_farmland",
        BlackoutDecisionWild = "blackout_decision_wild",
        BlackoutDecisionShared = "blackout_decision_shared",
        CraftMeadowSatchel = "craft_meadow_satchel_bench",
        CraftAmberCharm = "craft_amber_charm_bench",
        CraftIronrootHood = "craft_ironroot_hood_bench",
        CraftBrambleBoots = "craft_bramble_boots_bench",
        CraftThornwoodBow = "craft_thornwood_bow_bench",
        CraftHeartwoodMaul = "craft_heartwood_maul_bench",
        CraftBriarLance = "craft_briar_lance_bench",
        CraftFoxfireSling = "craft_foxfire_sling_bench",
        CraftAmberEdge = "craft_amber_edge_bench",
        CraftWardenCudgel = "craft_warden_cudgel_bench",
        QuestBoard = "quest_board",
        --[[
            The town gate, which is where you decide who comes through it.
            An interaction rather than a HUD control on purpose: the owner's
            screen is a portrait phone, this HUD has already had to take
            buttons back off it twice, and a setting about the town belongs in
            the town. The same reasoning moved FIND and STRIKE onto the world
            objects they act on.
        ]]
        TownGate = "town_gate_policy",
        --[[
            The outfitter's stand in the departure lodge, which is the only
            way into the store.

            A storefront that opens from a HUD button is a storefront that can
            open at any moment, and the moments this one may not open in are
            the whole of the milestone's exit gate. Making it a thing you walk
            up to in a room you are not being attacked in means the refusal is
            the rule's second line of defence rather than its only one -- the
            same reasoning that put the visit policy on the town gate.
        ]]
        Outfitter = "outfitter_stand",
    }),
    ResidentInteractionIds = table.freeze({
        npc_tomas_reed = "resident_tomas_reed",
        npc_pip_wren = "resident_pip_wren",
        npc_ena_moss = "resident_ena_moss",
    }),
    PrivateControlInteractionIds = table.freeze(privateControlInteractionIds),
    ConstructionInteractionIds = table.freeze(constructionInteractionIds),
    TownRepairInteractionIdByBuilding = table.freeze(townRepairInteractionIds),
    ProfessionSpecializationInteractionIds = table.freeze(professionSpecializationInteractionIds),
    ProfessionSpecializationInteractionIdBySpecialization = table.freeze(
        professionSpecializationInteractionIdBySpecialization
    ),
}

return table.freeze(RuntimeIds)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="96">
        <Properties>
          <string name="Name">SaveSchema</string>
          <string name="Source"><![CDATA[--!strict

local ToolCatalog = require("./ToolCatalog")
local TutorialFlow = require("./TutorialFlow")
local ExpeditionInventory = require("./ExpeditionInventory")
local ProfessionCatalog = require("./ProfessionCatalog")
local ChapterCatalog = require("./ChapterCatalog")
local Crafting = require("./Crafting")
local HollowFinale = require("./Content/Definitions/HollowFinale")
local NamelessNight = require("./NamelessNightEncounter")
local MemoryFragments = require("./MemoryFragments")
local PartySession = require("./PartySession")
local TownVisitPolicy = require("./TownVisitPolicy")
local Entitlements = require("./Entitlements")
local CosmeticCatalog = require("./CosmeticCatalog")
local Quests = require("./Quests")
local ProfessionMastery = require("./ProfessionMastery")
local Equipment = require("./Equipment")
local GearTraits = require("./GearTraits")
local GearWear = require("./GearWear")
local ResidentLife = require("./ResidentLife")
local ResidentRoster = require("./ResidentRoster")
local TownDecorations = require("./TownDecorations")
local TownProgression = require("./TownProgression")
local TownCondition = require("./TownCondition")
local TownConstruction = require("./TownConstruction")

local SaveSchema = {}

export type Tutorial = {
    stage: TutorialFlow.Stage,
    complete: boolean,
    selectedTool: string?,
    completedAt: number?,
}

export type Profile = {
    schemaVersion: number,
    createdAt: number,
    updatedAt: number,
    revision: number,
    tutorial: Tutorial,
    inventory: any,
    loadouts: { any },
    gearWear: { [string]: number },
    gearTraits: { [string]: string },
    profession: {
        selectedId: string?,
        mastery: ProfessionMastery.State,
    },
    story: {
        chapterOne: {
            completedAt: number?,
            decision: string?,
            status: string,
            transactionId: string?,
            wardenOutcome: string?,
        },
        --[[
            Chapters II onward. Chapter I keeps its original home above --
            too many systems read story.chapterOne to move it for tidiness
            -- but every chapter after it is stored uniformly here, keyed
            by chapter id, and validated against ChapterCatalog.
        ]]
        chapters: { [string]: any },
        --[[
            The finale's own record. It could not live in `chapters`: that
            block is deliberately five fixed fields, and the Hollow
            records what a party did in its scenes as well as what they
            chose at the end -- the post left empty, the light spent, who
            came back up. The epilogue reads all of it.
        ]]
        finale: {
            abandonedPost: string?,
            completedAt: number?,
            ending: string?,
            leftBehind: string?,
            light: number,
            rescued: string?,
            status: string,
            transactionId: string?,
        },
        fragments: { [string]: boolean },
    },
    town: {
        nightNumber: number,
        condition: TownCondition.State,
        construction: { [string]: number },
        residents: ResidentLife.State,
        crisis: ResidentLife.Crisis?,
        decorations: TownDecorations.State,
    },
    gear: { [string]: number },
    equipped: Equipment.Equipped,
    quests: {
        claimed: { [string]: boolean },
    },
    --[[
        Everything about this player's relationship to other players. One
        field so far: the ticket back to the party they were with when they
        dropped. It is a block rather than a bare `rejoin` because the rest of
        Milestone 11 arrives here too -- a visit policy, a block list -- and a
        second migration to make room for them would be a migration spent on
        tidying.

        The ticket holds a reserved-server access code, which is the whole key
        to a private world. It is written here because a profile is server-
        owned storage; it must never be put in a snapshot. PartySession's
        `publicTicket` is the shape a client may see.
    ]]
    social: {
        rejoin: PartySession.Ticket?,
        --[[
            Who may visit this player's Emberhollow. Lives beside the rejoin
            ticket because both answer the same question from opposite ends --
            the ticket is how you get back to people, the policy is who gets to
            you -- and because a `social` table with one field in it was always
            going to gain a second.
        ]]
        visitPolicy: TownVisitPolicy.Policy,
    },
    --[[
        What this player owns, what they are wearing, and every purchase
        already applied.

        Stored on the profile because entitlements are resolved outside
        gameplay and land as plain data -- nothing downstream asks the platform
        anything. The distinction the whole design rests on: gameplay branches
        on `equipped`, which is a profile field like every other, and never on
        `entitlements`, which only the commerce seam is allowed to read.
    ]]
    commerce: Entitlements.State,
    --[[
        The seeds this player has already walked, newest first.

        It exists for one reader: a private server's owner choosing which
        expedition to run again. "Among already-discovered seeds" is the whole
        bound in MONETIZATION_LIVEOPS_ANALYTICS' description of the control,
        and a bound that cannot be checked against anything is not a bound --
        so the history is a save field rather than a session's memory, because
        a player who found a layout on Tuesday means it on Thursday.

        Capped, and the cap is the point rather than tidiness: an unbounded
        list on a profile grows for the life of an account, and M12's soak gate
        asks in as many words that profile size not grow without bound. A
        history long enough to find a run you remember is short.
    ]]
    expeditions: {
        seeds: { { regionId: string, seed: number, walkedAt: number } },
    },
}

local MAX_NIGHT_NUMBER = 1_000_000
-- Long enough to hold a run somebody remembers, short enough that the list is
-- a fixed cost on every save rather than a growing one.
local MAX_DISCOVERED_SEEDS = 24

local CHAPTER_ONE_DECISIONS = table.freeze({
    restore_farmland = true,
    wild_regrowth = true,
    shared_agroforest = true,
})
local WARDEN_OUTCOMES = table.freeze({
    preserved = true,
    scarred = true,
    harmed = true,
})

function SaveSchema.default(now: number): Profile
    return {
        schemaVersion = 25,
        createdAt = now,
        updatedAt = now,
        revision = 0,
        tutorial = {
            stage = "arrive",
            complete = false,
            selectedTool = nil,
            completedAt = nil,
        },
        inventory = ExpeditionInventory.default(),
        loadouts = {},
        gearWear = {},
        gearTraits = {},
        profession = {
            selectedId = nil,
            mastery = ProfessionMastery.default(),
        },
        story = {
            chapterOne = {
                completedAt = nil,
                decision = nil,
                status = "unresolved",
                transactionId = nil,
                wardenOutcome = nil,
            },
            chapters = {},
            finale = {
                abandonedPost = nil,
                completedAt = nil,
                ending = nil,
                leftBehind = nil,
                light = NamelessNight.StartingLight,
                rescued = nil,
                status = "unresolved",
                transactionId = nil,
            },
            fragments = MemoryFragments.normalize(nil),
        },
        town = {
            nightNumber = 1,
            condition = TownCondition.default(),
            construction = TownConstruction.default(),
            residents = ResidentLife.default(),
            crisis = nil,
            decorations = TownDecorations.default(),
        },
        gear = Crafting.default(),
        equipped = Equipment.default(),
        quests = {
            claimed = Quests.default(),
        },
        social = {
            rejoin = nil,
            visitPolicy = TownVisitPolicy.Default,
        },
        commerce = Entitlements.default(),
        expeditions = { seeds = {} },
    }
end

-- Newest first, deduplicated by region and seed, capped. Deduplicating matters
-- more than it looks: the same seed walked twice is one layout, and a history
-- that counted it twice would push a genuinely different run off the end.
local function normalizeSeeds(value: any): { { regionId: string, seed: number, walkedAt: number } }
    local seeds = {}
    if type(value) ~= "table" then
        return seeds
    end
    local seen: { [string]: boolean } = {}
    for _, entry in value do
        if
            type(entry) == "table"
            and type(entry.regionId) == "string"
            and #entry.regionId <= 48
        then
            local seed = tonumber(entry.seed)
            local walkedAt = tonumber(entry.walkedAt)
            if seed ~= nil and seed == seed and seed >= 0 and seed < math.huge then
                local key = entry.regionId .. ":" .. tostring(math.floor(seed))
                if not seen[key] then
                    seen[key] = true
                    table.insert(seeds, {
                        regionId = entry.regionId,
                        seed = math.floor(seed),
                        walkedAt = if walkedAt ~= nil
                                and walkedAt == walkedAt
                                and walkedAt >= 0
                            then math.floor(walkedAt)
                            else 0,
                    })
                    if #seeds >= MAX_DISCOVERED_SEEDS then
                        break
                    end
                end
            end
        end
    end
    return seeds
end

function SaveSchema.normalize(value: any, now: number): Profile
    local profile = SaveSchema.default(now)
    if type(value) ~= "table" then
        return profile
    end

    if type(value.createdAt) == "number" and value.createdAt > 0 then
        profile.createdAt = value.createdAt
    end
    if type(value.updatedAt) == "number" and value.updatedAt > 0 then
        profile.updatedAt = value.updatedAt
    end
    if type(value.revision) == "number" and value.revision >= 0 then
        profile.revision = math.floor(value.revision)
    end

    --[[
        Schema 17: saved loadouts. Up to three slots, each remembering a
        profession, a weapon, and a tool -- every id revalidated against its
        own catalog on load, so a retired item degrades to an empty field
        rather than a faulting apply. Absent entirely (any pre-17 save),
        the player simply has no kits saved yet.
    ]]
    profile.loadouts = {}
    if type(value.loadouts) == "table" then
        for slot = 1, 3 do
            local raw = value.loadouts[slot]
            if type(raw) == "table" then
                profile.loadouts[slot] = {
                    professionId = if ProfessionCatalog.isValid(raw.professionId)
                        then raw.professionId
                        else nil,
                    weaponItemId = if Equipment.isKnown(raw.weaponItemId)
                        then raw.weaponItemId
                        else nil,
                    toolId = if ToolCatalog.isValid(raw.toolId) then raw.toolId else nil,
                }
            end
        end
    end

    -- Schema 18: equipment wear. Absent on any pre-18 save (nothing had
    -- dulled yet); junk and retired items are stripped by GearWear itself.
    profile.gearWear = GearWear.normalize(value.gearWear)
    -- Schema 19: rolled equipment traits. Revalidated per item against the
    -- trait pools; a pre-19 save arrives traitless and rolls at next craft.
    profile.gearTraits = GearTraits.normalize(value.gearTraits)

    local tutorial = value.tutorial
    if type(tutorial) == "table" then
        if TutorialFlow.isValidStage(tutorial.stage) then
            profile.tutorial.stage = tutorial.stage
        end
        if tutorial.complete == true or profile.tutorial.stage == "complete" then
            profile.tutorial.complete = true
            profile.tutorial.stage = "complete"
        end
        -- Validated against the tool catalog rather than three literals:
        -- the roster is eight families now, and the catalog is where a
        -- tool's very existence is decided.
        if ToolCatalog.isValid(tutorial.selectedTool) then
            profile.tutorial.selectedTool = tutorial.selectedTool
        end
        if
            profile.tutorial.complete
            and type(tutorial.completedAt) == "number"
            and tutorial.completedAt > 0
        then
            profile.tutorial.completedAt = tutorial.completedAt
        end
    end

    profile.inventory = ExpeditionInventory.normalize(value.inventory)
    local profession = value.profession
    if type(profession) == "table" then
        if ProfessionCatalog.isValid(profession.selectedId) then
            profile.profession.selectedId = profession.selectedId
        end
        profile.profession.mastery = ProfessionMastery.normalize(profession.mastery)
    end
    local story = value.story
    local chapterOne = if type(story) == "table" then story.chapterOne else nil
    if
        type(chapterOne) == "table"
        and chapterOne.status == "complete"
        and CHAPTER_ONE_DECISIONS[chapterOne.decision] == true
        and WARDEN_OUTCOMES[chapterOne.wardenOutcome] == true
        and type(chapterOne.transactionId) == "string"
        and chapterOne.transactionId ~= ""
        and #chapterOne.transactionId <= 160
        and type(chapterOne.completedAt) == "number"
        and chapterOne.completedAt > 0
    then
        profile.story.chapterOne = {
            completedAt = chapterOne.completedAt,
            decision = chapterOne.decision,
            status = "complete",
            transactionId = chapterOne.transactionId,
            wardenOutcome = chapterOne.wardenOutcome,
        }
    end
    --[[
        Chapters II onward. A record survives only if it names a chapter
        the catalog knows, with a decision and an outcome that chapter
        actually offers, and a real transaction id -- the same bar chapter
        one's record has always had to clear.
    ]]
    local chapters = if type(story) == "table" then story.chapters else nil
    if type(chapters) == "table" then
        for chapterId, record in chapters do
            if
                type(record) == "table"
                and record.status == "complete"
                and ChapterCatalog.get(chapterId) ~= nil
                and chapterId ~= "chapter_one"
                and ChapterCatalog.isDecision(chapterId, record.decision)
                and ChapterCatalog.isOutcome(chapterId, record.outcome)
                and type(record.transactionId) == "string"
                and record.transactionId ~= ""
                and #record.transactionId <= 160
                and type(record.completedAt) == "number"
                and record.completedAt > 0
            then
                profile.story.chapters[chapterId] = {
                    completedAt = record.completedAt,
                    decision = record.decision,
                    outcome = record.outcome,
                    status = "complete",
                    transactionId = record.transactionId,
                }
            end
        end
    end
    --[[
        The finale. A record survives only if it names an ending the
        Hollow actually offers, with a real transaction id -- the same bar
        every chapter record clears. Everything else it carries is
        detail the epilogue reads, and each field is dropped on its own
        rather than taking the record down with it, because a save that
        forgot which post was abandoned should still remember how the
        story ended.
    ]]
    local finale = if type(story) == "table" then story.finale else nil
    if type(finale) == "table" and finale.status == "complete" then
        local ending: string? = nil
        for _, definition in HollowFinale.Endings do
            if definition.id == finale.ending then
                ending = definition.id
            end
        end
        local post: string? = nil
        for _, postId in NamelessNight.PostIds do
            if postId == finale.abandonedPost then
                post = postId
            end
        end
        if
            ending ~= nil
            and type(finale.transactionId) == "string"
            and finale.transactionId ~= ""
            and #finale.transactionId <= 160
            and type(finale.completedAt) == "number"
            and finale.completedAt > 0
        then
            profile.story.finale = {
                abandonedPost = post,
                completedAt = finale.completedAt,
                ending = ending,
                leftBehind = if type(finale.leftBehind) == "string"
                        and ResidentRoster.get(finale.leftBehind) ~= nil
                    then finale.leftBehind
                    else nil,
                light = math.clamp(
                    math.floor(tonumber(finale.light) or 0),
                    0,
                    NamelessNight.StartingLight
                ),
                rescued = if type(finale.rescued) == "string"
                        and ResidentRoster.get(finale.rescued) ~= nil
                    then finale.rescued
                    else nil,
                status = "complete",
                transactionId = finale.transactionId,
            }
        end
    end
    -- Recovered memory fragments. Unknown IDs are dropped the same way gear
    -- and quest claims drop theirs, so a retired fragment cannot keep
    -- occupying an archive count. A schema-13 profile simply arrives with
    -- none recovered, which is the truthful migration: nothing was collected
    -- before the system existed.
    profile.story.fragments =
        MemoryFragments.normalize(if type(story) == "table" then story.fragments else nil)
    local town = value.town
    if
        type(town) == "table"
        and type(town.nightNumber) == "number"
        and town.nightNumber >= 1
        and town.nightNumber <= MAX_NIGHT_NUMBER
        and town.nightNumber == math.floor(town.nightNumber)
    then
        profile.town.nightNumber = town.nightNumber
    end
    profile.town.condition =
        TownCondition.normalize(if type(town) == "table" then town.condition else nil)

    --[[
        Construction orders (schema 12) must grandfather every save that
        predates them. A save from before this field existed carries no
        `town.construction` table at all -- that absence, not any particular
        value inside it, is what marks a pre-migration profile, because a
        genuinely fresh schema-12 save also starts with an empty table (no
        building funded yet) and must not be treated as needing a rescue.

        Grandfathering happens by re-deriving the exact ceiling nights and
        chapter one already granted, using TownProgression.resolve against
        the `profile` this function has already built above -- its
        town.nightNumber and story.chapterOne are already the trustworthy,
        normalized values for this save, not the raw (and possibly forged)
        input. Seeding the ledger to that ceiling means every building a
        player already had looks exactly as built as it did a moment ago;
        only growth beyond what nights had already unlocked requires payment
        from here on. Getting this wrong either lets a hostile save claim
        stages nights never granted, or -- far worse -- rolls every existing
        town back to bare construction sites the instant this ships.
    ]]
    if type(town) == "table" and type(town.construction) == "table" then
        profile.town.construction = TownConstruction.normalize(town.construction)
    else
        profile.town.construction =
            TownConstruction.normalize(TownProgression.resolve(profile).buildingStages)
    end

    -- Resident life (schema 15). A pre-15 profile arrives with everyone
    -- healthy, no bonds, and no crisis -- the truthful migration: none of it
    -- existed before the system did.
    profile.town.residents =
        ResidentLife.normalize(if type(town) == "table" then town.residents else nil)
    local crisis = if type(town) == "table" then town.crisis else nil
    if
        type(crisis) == "table"
        and type(crisis.id) == "string"
        and type(crisis.kind) == "string"
        and type(crisis.title) == "string"
        and type(crisis.detail) == "string"
        and type(crisis.startedNight) == "number"
    then
        profile.town.crisis = {
            id = crisis.id,
            kind = crisis.kind,
            title = crisis.title,
            detail = crisis.detail,
            startedNight = math.max(1, math.floor(crisis.startedNight)),
        }
    else
        profile.town.crisis = nil
    end

    -- Decorations (schema 16): a pre-16 save simply has none placed.
    profile.town.decorations =
        TownDecorations.normalize(if type(town) == "table" then town.decorations else nil)

    profile.gear = Crafting.normalizeGear(value.gear)
    profile.equipped = Equipment.normalize(value.equipped)
    local quests = value.quests
    profile.quests.claimed =
        Quests.normalizeClaimed(if type(quests) == "table" then quests.claimed else nil)

    --[[
        Schema 22: the rejoin ticket. A pre-22 save arrives with none, which
        is the truthful migration -- there were no parties to be a member of,
        so there is nothing anyone should be sent back to.

        The bounding is PartySession's, not a copy of it, and it is strict:
        an unreadable ticket is no ticket. A ticket is the one saved field
        that resolves to a teleport, so the cost of accepting a bad one is a
        player thrown at a world that may not be theirs, and the cost of
        refusing a good one is that they walk to the platform again.
    ]]
    profile.social.rejoin = PartySession.normalizeTicket(
        if type(value.social) == "table" then value.social.rejoin else nil
    )
    -- An era-22 save has no policy, and the value it arrives with is the one
    -- it was already being played under: every town before this schema was
    -- open to whoever the matchmaker sent. Migrating them to `closed` would be
    -- a silent change of behaviour dressed as a safe default.
    profile.social.visitPolicy = TownVisitPolicy.normalize(
        if type(value.social) == "table" then value.social.visitPolicy else nil
    )

    -- An era-23 save owns nothing and wears nothing, because there was nothing
    -- to own: no product existed and no receipt had ever been processed. The
    -- empty default is the honest migration rather than a conservative one.
    profile.commerce = Entitlements.normalize(value.commerce, function(cosmeticId: string): boolean
        return CosmeticCatalog.get(cosmeticId) ~= nil
    end)

    -- An era-24 save has walked expeditions and remembers none of them, which
    -- is the truth rather than a loss: nothing recorded a seed before this
    -- schema, so an empty history is exactly what that player has. It fills up
    -- again on the next run they walk.
    profile.expeditions = {
        seeds = normalizeSeeds(
            if type(value.expeditions) == "table" then value.expeditions.seeds else nil
        ),
    }

    profile.schemaVersion = 25
    return profile
end

--[[
    Record a seed this player has now walked.

    Called where a manifest is actually built for somebody rather than where a
    departure is requested, because a seed nobody reached is not a seed they
    discovered -- and "already-discovered" is the only bound seed selection
    has.
]]
function SaveSchema.withDiscoveredSeed(
    profile: Profile,
    regionId: any,
    seed: any,
    now: number
): Profile
    local numericSeed = tonumber(seed)
    if type(regionId) ~= "string" or numericSeed == nil then
        return profile
    end
    local nextProfile = table.clone(profile)
    local seeds = { { regionId = regionId, seed = numericSeed, walkedAt = now } }
    for _, entry in profile.expeditions.seeds do
        table.insert(seeds, entry)
    end
    nextProfile.expeditions = { seeds = normalizeSeeds(seeds) }
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

-- A copy, for the same reason `commerce` hands back copies: a caller that
-- edited the profile's own table in place would change a save with no
-- normalization, no revision bump and nothing written.
function SaveSchema.discoveredSeeds(profile: Profile): { { regionId: string, seed: number } }
    local seeds = {}
    for _, entry in profile.expeditions.seeds do
        table.insert(seeds, { regionId = entry.regionId, seed = entry.seed })
    end
    return seeds
end

function SaveSchema.withTutorial(
    profile: Profile,
    stage: TutorialFlow.Stage,
    selectedTool: string?,
    now: number
): Profile
    local nextProfile = table.clone(profile)
    nextProfile.tutorial = table.clone(profile.tutorial)
    nextProfile.tutorial.stage = stage
    nextProfile.tutorial.complete = stage == "complete"
    nextProfile.tutorial.selectedTool = selectedTool
    if stage == "complete" then
        if not profile.tutorial.complete or nextProfile.tutorial.completedAt == nil then
            nextProfile.tutorial.completedAt = now
        end
    else
        nextProfile.tutorial.completedAt = nil
    end
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

function SaveSchema.withProfession(profile: Profile, professionId: string, now: number): Profile
    assert(ProfessionCatalog.isValid(professionId), "profession ID is invalid")
    local nextProfile = table.clone(profile)
    nextProfile.profession = table.clone(profile.profession)
    nextProfile.profession.selectedId = professionId
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

function SaveSchema.withMasteryAward(
    profile: Profile,
    professionId: string,
    amount: number,
    now: number
): (Profile, any)
    local nextMastery, result =
        ProfessionMastery.award(profile.profession.mastery, professionId, amount)
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.profession = table.clone(profile.profession)
    nextProfile.profession.mastery = nextMastery
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.withProfessionSpecialization(
    profile: Profile,
    professionId: string,
    specializationId: string,
    now: number
): (Profile, any)
    local nextMastery, result = ProfessionMastery.selectSpecialization(
        profile.profession.mastery,
        professionId,
        specializationId
    )
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.profession = table.clone(profile.profession)
    nextProfile.profession.mastery = nextMastery
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.withUnbankedExpeditionReward(
    profile: Profile,
    transactionId: string,
    manifestHash: string,
    reward: any,
    now: number
): (Profile, any)
    local nextInventory, result =
        ExpeditionInventory.addUnbanked(profile.inventory, transactionId, manifestHash, reward, now)
    if not result.applied then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.inventory = nextInventory
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.expeditionPending(profile: Profile): any
    return ExpeditionInventory.pending(profile.inventory)
end

function SaveSchema.expeditionRecoveryCacheId(
    runId: string,
    userId: number,
    fingerprint: string
): string
    return ExpeditionInventory.recoveryCacheId(runId, userId, fingerprint)
end

function SaveSchema.withExpeditionFailureCache(
    profile: Profile,
    cacheId: string,
    manifestHash: string,
    now: number
): (Profile, any)
    local nextInventory, result =
        ExpeditionInventory.cacheAfterFailure(profile.inventory, cacheId, manifestHash, now)
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.inventory = nextInventory
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.expeditionRecovery(profile: Profile): any
    return ExpeditionInventory.activeRecovery(profile.inventory)
end

function SaveSchema.expeditionCachedTransactionIds(profile: Profile): { string }
    return ExpeditionInventory.cachedTransactionIds(profile.inventory)
end

function SaveSchema.withRecoveredExpeditionCache(
    profile: Profile,
    cacheId: string,
    now: number
): (Profile, any)
    local nextInventory, result = ExpeditionInventory.recover(profile.inventory, cacheId, now)
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.inventory = nextInventory
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.expeditionSettlementId(
    runId: string,
    userId: number,
    pendingFingerprint: string
): string
    return ExpeditionInventory.settlementId(runId, userId, pendingFingerprint)
end

function SaveSchema.withExpeditionSettlement(
    profile: Profile,
    settlementId: string,
    manifestHash: string,
    now: number
): (Profile, any)
    local nextInventory, result = ExpeditionInventory.settle(
        profile.inventory,
        settlementId,
        manifestHash,
        now,
        TownProgression.storageCapForTier(TownProgression.resolve(profile).tier)
    )
    if not result.applied then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.inventory = nextInventory
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.hasExpeditionSettlement(profile: Profile, settlementId: string): boolean
    return ExpeditionInventory.hasSettlement(profile.inventory, settlementId)
end

function SaveSchema.hasExpeditionReward(profile: Profile, transactionId: string): boolean
    return ExpeditionInventory.hasReward(profile.inventory, transactionId)
end

function SaveSchema.findExpeditionSettlementForRewards(
    profile: Profile,
    rewardTransactionIds: { string }
): (string?, any?)
    return ExpeditionInventory.findSettlementForRewards(profile.inventory, rewardTransactionIds)
end

function SaveSchema.withChapterOneResolution(
    profile: Profile,
    transactionId: string,
    decision: string,
    wardenOutcome: string,
    now: number
): (Profile, any)
    assert(transactionId ~= "" and #transactionId <= 160, "chapter transaction ID is invalid")
    assert(CHAPTER_ONE_DECISIONS[decision] == true, "chapter decision is invalid")
    assert(WARDEN_OUTCOMES[wardenOutcome] == true, "Warden outcome is invalid")
    local current = profile.story.chapterOne
    if current.status == "complete" then
        return profile,
            {
                applied = false,
                duplicate = current.transactionId == transactionId,
                reason = if current.transactionId == transactionId
                    then "duplicate"
                    else "chapter_already_resolved",
                record = table.clone(current),
            }
    end

    local nextProfile = table.clone(profile)
    nextProfile.story = table.clone(profile.story)
    nextProfile.story.chapterOne = {
        completedAt = now,
        decision = decision,
        status = "complete",
        transactionId = transactionId,
        wardenOutcome = wardenOutcome,
    }
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile,
        {
            applied = true,
            duplicate = false,
            reason = "resolved",
            record = table.clone(nextProfile.story.chapterOne),
        }
end

function SaveSchema.chapterOne(profile: Profile): any
    return table.clone(profile.story.chapterOne)
end

--[[
    Resolve chapter II or later. Same idempotency contract as chapter
    one's: a repeat of the same transaction is a duplicate rather than an
    error, a different transaction against a resolved chapter is refused,
    and a chapter cannot be resolved before the one it requires.
]]
function SaveSchema.withChapterResolution(
    profile: Profile,
    chapterId: string,
    transactionId: string,
    decision: string,
    outcome: string,
    now: number
): (Profile, any)
    assert(transactionId ~= "" and #transactionId <= 160, "chapter transaction ID is invalid")
    local definition = ChapterCatalog.get(chapterId)
    assert(definition ~= nil, "chapter is unknown")
    assert(chapterId ~= "chapter_one", "chapter one resolves through its own path")
    assert(ChapterCatalog.isDecision(chapterId, decision), "chapter decision is invalid")
    assert(ChapterCatalog.isOutcome(chapterId, outcome), "chapter outcome is invalid")

    local current = profile.story.chapters[chapterId]
    if type(current) == "table" and current.status == "complete" then
        return profile,
            {
                applied = false,
                duplicate = current.transactionId == transactionId,
                reason = if current.transactionId == transactionId
                    then "duplicate"
                    else "chapter_already_resolved",
                record = table.clone(current),
            }
    end
    if not SaveSchema.isChapterComplete(profile, (definition :: any).requires) then
        return profile,
            {
                applied = false,
                duplicate = false,
                reason = "chapter_locked",
                record = nil,
            }
    end

    local nextProfile: any = table.clone(profile)
    nextProfile.story = table.clone(profile.story)
    nextProfile.story.chapters = table.clone(profile.story.chapters)
    nextProfile.story.chapters[chapterId] = {
        completedAt = now,
        decision = decision,
        outcome = outcome,
        status = "complete",
        transactionId = transactionId,
    }
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile,
        {
            applied = true,
            duplicate = false,
            reason = "resolved",
            record = table.clone(nextProfile.story.chapters[chapterId]),
        }
end

--[[
    Record the finale.

    Written like a chapter resolution and idempotent the same way, but it
    writes two places: the finale block, which carries what a party did in
    the Hollow's scenes, and chapter seven's record, so everything that
    already reasons about chapters (tier floors, resident arrival, the
    story's shape) sees the last chapter close without learning a new
    thing to read.

    The ending is chapter seven's decision and the world state it produces
    is its outcome, which keeps the catalog's contract intact: a player
    chose `ending_shared`, and what the world became is `lantern_shared`.
]]
local ENDING_OUTCOMES: { [string]: string } = {
    ending_kept = "lantern_kept",
    ending_ended = "lantern_out",
    ending_shared = "lantern_shared",
}

function SaveSchema.withFinaleResolution(
    profile: Profile,
    transactionId: string,
    record: any,
    now: number
): (Profile, any)
    assert(transactionId ~= "" and #transactionId <= 160, "finale transaction ID is invalid")
    assert(type(record) == "table", "finale record is required")
    local outcome = ENDING_OUTCOMES[record.ending]
    assert(outcome ~= nil, "finale ending is unknown")

    local current = profile.story.finale
    if current.status == "complete" then
        return profile,
            {
                applied = false,
                duplicate = current.transactionId == transactionId,
                reason = if current.transactionId == transactionId
                    then "duplicate"
                    else "finale_already_resolved",
                record = table.clone(current),
            }
    end
    if not SaveSchema.isChapterComplete(profile, "chapter_six") then
        return profile,
            { applied = false, duplicate = false, reason = "chapter_locked", record = nil }
    end

    local nextProfile: any = table.clone(profile)
    nextProfile.story = table.clone(profile.story)
    nextProfile.story.chapters = table.clone(profile.story.chapters)
    nextProfile.story.finale = {
        abandonedPost = record.abandonedPost,
        completedAt = now,
        ending = record.ending,
        leftBehind = record.leftBehind,
        light = math.clamp(math.floor(tonumber(record.light) or 0), 0, NamelessNight.StartingLight),
        rescued = record.rescued,
        status = "complete",
        transactionId = transactionId,
    }
    nextProfile.story.chapters.chapter_seven = {
        completedAt = now,
        decision = record.ending,
        outcome = outcome,
        status = "complete",
        transactionId = transactionId,
    }
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile,
        {
            applied = true,
            duplicate = false,
            reason = "resolved",
            record = table.clone(nextProfile.story.finale),
        }
end

function SaveSchema.isChapterComplete(profile: Profile, chapterId: any): boolean
    if chapterId == nil then
        return true
    end
    if chapterId == "chapter_one" then
        return profile.story.chapterOne.status == "complete"
    end
    local record = profile.story.chapters[chapterId]
    return type(record) == "table" and record.status == "complete"
end

function SaveSchema.chapterRecord(profile: Profile, chapterId: any): any
    if chapterId == "chapter_one" then
        return table.clone(profile.story.chapterOne)
    end
    local record = profile.story.chapters[chapterId]
    return if type(record) == "table" then table.clone(record) else nil
end

--[[
    How far the story has come, as a chapter number: the highest chapter
    whose own prerequisites are all satisfied and which is itself
    complete, plus one -- i.e. the chapter now being played. Residents use
    this to know whether they have arrived yet.
]]
function SaveSchema.chapterProgress(profile: Profile): number
    local reached = 1
    for _, definition in ChapterCatalog.list() do
        if SaveSchema.isChapterComplete(profile, definition.id) then
            reached = math.max(reached, definition.number + 1)
        end
    end
    return math.min(reached, #ChapterCatalog.Order)
end

-- The town's night count is server-session state (see TownNightService) that
-- gets pushed out to every connected player's own profile whenever a night
-- completes, so a later server session can resume from whichever returning
-- player's record is highest instead of always restarting at night one.
function SaveSchema.withNightNumber(profile: Profile, nightNumber: number, now: number): Profile
    assert(
        type(nightNumber) == "number"
            and nightNumber >= 1
            and nightNumber <= MAX_NIGHT_NUMBER
            and nightNumber == math.floor(nightNumber),
        "night number is invalid"
    )
    if nightNumber <= profile.town.nightNumber then
        return profile
    end
    local nextProfile = table.clone(profile)
    nextProfile.town = table.clone(profile.town)
    nextProfile.town.nightNumber = nightNumber
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

function SaveSchema.nightNumber(profile: Profile): number
    return profile.town.nightNumber
end

--[[
    Write, or clear, the ticket back to the party this player left with.

    Passing nil clears it, which is the call made the moment a rejoin is
    spent or refused: a ticket that outlives its usefulness is an offer the
    lodge keeps making for a world that has emptied out.

    The ticket is bounded on the way in as well as on the way out. It is
    handed over by a service that built it from a teleport call's return
    value, and a reserved-server code that came back as something other than
    a string should stop here rather than at the next load.

    Clearing is nil and only nil. A malformed ticket is refused outright
    rather than treated as a clear, because those two look identical here and
    are opposite in effect: one is a player who has arrived home, the other is
    a bad write that would silently take away the way back from a player who
    still has one.
]]
function SaveSchema.withRejoinTicket(profile: Profile, ticket: any, now: number): Profile
    local bounded = if ticket == nil then nil else PartySession.normalizeTicket(ticket)
    if ticket ~= nil and bounded == nil then
        return profile
    end
    if bounded == nil and profile.social.rejoin == nil then
        return profile
    end
    local nextProfile = table.clone(profile)
    nextProfile.social = table.clone(profile.social)
    nextProfile.social.rejoin = bounded
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

function SaveSchema.rejoinTicket(profile: Profile): any
    return profile.social.rejoin
end

--[[
    Set who may visit. A value the catalog does not know is refused outright
    rather than normalized to the default: the caller is the gate, the gate
    only ever offers the next value in the list, and quietly writing something
    else would mean a press that says one thing and stores another.
]]
function SaveSchema.withVisitPolicy(profile: Profile, policy: any, now: number): Profile
    if not TownVisitPolicy.isValid(policy) or policy == profile.social.visitPolicy then
        return profile
    end
    local nextProfile = table.clone(profile)
    nextProfile.social = table.clone(profile.social)
    nextProfile.social.visitPolicy = policy
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

function SaveSchema.visitPolicy(profile: Profile): TownVisitPolicy.Policy
    return TownVisitPolicy.normalize(profile.social.visitPolicy)
end

--[[
    Commerce state, read and written whole.

    Deliberately one accessor pair rather than a field-by-field API: every
    change to what a player owns comes from a receipt, and a receipt is applied
    by `Entitlements` in one step. Handing callers a way to set an entitlement
    directly would be handing them a way to grant one.
]]
function SaveSchema.commerce(profile: Profile): Entitlements.State
    --[[
        A copy, not the profile's own table. Every other accessor here hands
        back a scalar or a frozen value; commerce is three mutable maps, and a
        caller that edited one in place would grant an entitlement without
        going through `withCommerce` -- no normalization, no revision bump, no
        dirty flag, and a save that never records it.
    ]]
    return {
        entitlements = table.clone(profile.commerce.entitlements),
        processed = table.clone(profile.commerce.processed),
        equipped = table.clone(profile.commerce.equipped),
    }
end

function SaveSchema.withCommerce(profile: Profile, commerce: any, now: number): Profile
    local bounded = Entitlements.normalize(commerce, function(cosmeticId: string): boolean
        return CosmeticCatalog.get(cosmeticId) ~= nil
    end)
    local nextProfile = table.clone(profile)
    nextProfile.commerce = bounded
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

-- Whether two condition states describe the same town. Compared building by
-- building rather than through the derived average, because two different sets
-- of damaged buildings can average to the same number and writing one over the
-- other would lose a player's repairs without changing the revision.
local function sameTownCondition(left: TownCondition.State, right: TownCondition.State): boolean
    if
        left.lastNightNumber ~= right.lastNightNumber
        or left.lastDamage ~= right.lastDamage
        or left.repairsCompleted ~= right.repairsCompleted
    then
        return false
    end
    for buildingId, integrity in left.buildings do
        if right.buildings[buildingId] ~= integrity then
            return false
        end
    end
    for buildingId, integrity in right.buildings do
        if left.buildings[buildingId] ~= integrity then
            return false
        end
    end
    return true
end

function SaveSchema.withTownCondition(profile: Profile, condition: any, now: number): Profile
    local normalized = TownCondition.normalize(condition)
    local current = TownCondition.normalize(profile.town.condition)
    if sameTownCondition(normalized, current) then
        return profile
    end
    local nextProfile = table.clone(profile)
    nextProfile.town = table.clone(profile.town)
    nextProfile.town.condition = normalized
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

function SaveSchema.townCondition(profile: Profile): any
    return TownCondition.snapshot(profile.town.condition)
end

function SaveSchema.residentLifeSnapshot(profile: Profile): any
    local resolved = TownProgression.resolve(profile)
    return ResidentLife.snapshot(
        profile.town.residents,
        profile.town.nightNumber,
        resolved.residentIds,
        profile.town.crisis
    )
end

function SaveSchema.residentDawnBoons(profile: Profile): { ResidentLife.Boon }
    local resolved = TownProgression.resolve(profile)
    return ResidentLife.dawnBoons(
        profile.town.residents,
        profile.town.nightNumber,
        resolved.buildingStages,
        resolved.residentIds
    )
end

--[[
    A night's resident outcome: injuries, recoveries, and whatever crisis the
    night earned. One revision bump for the whole settlement, and clearing a
    crisis is part of the same write so the two can never disagree.
]]
function SaveSchema.withResidentNight(
    profile: Profile,
    context: ResidentLife.NightContext,
    now: number
): (Profile, ResidentLife.NightReport)
    local nextResidents, report = ResidentLife.resolveNight(profile.town.residents, context)
    local nextProfile = table.clone(profile)
    nextProfile.town = table.clone(profile.town)
    nextProfile.town.residents = nextResidents
    if report.crisis ~= nil then
        nextProfile.town.crisis = report.crisis
    elseif profile.town.crisis ~= nil then
        local anyInjured = false
        for _, residentId in ResidentLife.Ids do
            if ResidentLife.isInjured(nextResidents, residentId, context.nightNumber + 1) then
                anyInjured = true
                break
            end
        end
        if not anyInjured then
            nextProfile.town.crisis = nil
        end
    end
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, report
end

function SaveSchema.withResidentCheck(
    profile: Profile,
    residentId: string,
    now: number
): (Profile, ResidentLife.CheckResult)
    local nextResidents, result =
        ResidentLife.checkOn(profile.town.residents, residentId, profile.town.nightNumber)
    if not result.accepted then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.town = table.clone(profile.town)
    nextProfile.town.residents = nextResidents
    -- Care can end a crisis: when the last injury is tended, the town
    -- exhales in the same write.
    if nextProfile.town.crisis ~= nil then
        local anyInjured = false
        for _, id in ResidentLife.Ids do
            if ResidentLife.isInjured(nextResidents, id, profile.town.nightNumber) then
                anyInjured = true
                break
            end
        end
        if not anyInjured then
            nextProfile.town.crisis = nil
        end
    end
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.withCraftedItem(profile: Profile, recipeId: string, now: number): (Profile, any)
    local nextMaterials, nextGear, result =
        Crafting.craft(profile.inventory.materials, profile.gear, recipeId)
    if not result.applied then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.inventory = table.clone(profile.inventory)
    nextProfile.inventory.materials = nextMaterials
    nextProfile.gear = nextGear
    --[[
        The trait rolls here, at the first craft of this item type, from
        the profile's own creation time -- deterministic per save, distinct
        across saves, and never re-rolled: crafting a second bow keeps the
        first roll, because the trait belongs to YOUR bows, not to a copy.
    ]]
    nextProfile.gearTraits = table.clone((profile :: any).gearTraits or {})
    if result.itemId ~= nil and nextProfile.gearTraits[result.itemId] == nil then
        local rolled = GearTraits.rollFor(result.itemId, profile.createdAt)
        if rolled ~= nil then
            nextProfile.gearTraits[result.itemId] = rolled
            result.traitId = rolled
        end
    end
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

--[[
    Recover one memory fragment.

    Idempotent by way of MemoryFragments.collect: a repeat recovery is
    reported, never applied, so a duplicated interaction cannot double-count
    the archive or bump the revision.
]]
function SaveSchema.withMemoryFragment(
    profile: Profile,
    fragmentId: string,
    now: number
): (Profile, any)
    local nextFragments, result = MemoryFragments.collect(
        profile.story.fragments,
        fragmentId,
        profile.story.chapterOne.status == "complete"
    )
    if not result.accepted then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.story = table.clone(profile.story)
    nextProfile.story.fragments = nextFragments
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.memoryFragmentSnapshot(profile: Profile): any
    return MemoryFragments.snapshot(
        profile.story.fragments,
        profile.story.chapterOne.status == "complete"
    )
end

function SaveSchema.weaponStrikeProfile(profile: Profile): any
    return Equipment.weaponStrikeProfile(profile.equipped)
end

function SaveSchema.gearSnapshot(profile: Profile): { [string]: number }
    return table.clone(profile.gear)
end

-- Spends materials to advance one building's construction by exactly one
-- stage. `ceilingStage` is the caller's own tier-derived ceiling for this
-- building (see TownProgression.resolve), not trusted from anywhere the
-- profile itself stores, since nights and chapter one already govern it
-- independently of what a player has paid for.
function SaveSchema.withConstructionContribution(
    profile: Profile,
    buildingId: string,
    ceilingStage: number,
    now: number
): (Profile, any)
    local nextMaterials, nextConstruction, result = TownConstruction.contribute(
        profile.inventory.materials,
        profile.town.construction,
        buildingId,
        ceilingStage,
        now
    )
    if not result.applied then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.inventory = table.clone(profile.inventory)
    nextProfile.inventory.materials = nextMaterials
    nextProfile.town = table.clone(profile.town)
    nextProfile.town.construction = nextConstruction
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.constructionSnapshot(profile: Profile): { [string]: number }
    return table.clone(profile.town.construction)
end

function SaveSchema.withPlacedDecoration(
    profile: Profile,
    decorationId: string,
    now: number
): (Profile, any)
    local tier = TownProgression.resolve(profile).tier
    local nextMaterials, nextDecorations, result = TownDecorations.place(
        profile.inventory.materials,
        profile.town.decorations,
        decorationId,
        tier
    )
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.inventory = table.clone(profile.inventory)
    nextProfile.inventory.materials = nextMaterials
    nextProfile.town = table.clone(profile.town)
    nextProfile.town.decorations = nextDecorations
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.decorationsSnapshot(profile: Profile): any
    local tier = TownProgression.resolve(profile).tier
    return {
        placed = table.clone(profile.town.decorations),
        count = TownDecorations.count(profile.town.decorations),
        cap = TownDecorations.capForTier(tier),
    }
end

function SaveSchema.masterySnapshot(profile: Profile): ProfessionMastery.State
    return ProfessionMastery.snapshot(profile.profession.mastery)
end

function SaveSchema.equippedSnapshot(profile: Profile): Equipment.Equipped
    return Equipment.normalize(profile.equipped)
end

function SaveSchema.equipmentStats(profile: Profile): any
    --[[
        Wear reaches passive gear the same way it reaches weapons: worn
        halves what the piece adds, failing removes it entirely. The trait
        nudge rides the same per-item factor, so a worn STURDY hood fades
        as one thing, not two.
    ]]
    local wear = (profile :: any).gearWear or {}
    local effectiveness: { [string]: number } = {}
    for _, itemId in profile.equipped do
        if type(itemId) == "string" then
            effectiveness[itemId] = GearWear.effectiveness(wear, itemId)
        end
    end
    local stats = Equipment.stats(profile.equipped, effectiveness)
    -- Passive trait nudges fold in under the same clamps Equipment.stats
    -- already enforces, so a trait can shade a build but never escape it.
    local traits = (profile :: any).gearTraits or {}
    for _, itemId in profile.equipped do
        local trait = GearTraits.get(traits[itemId])
        if trait ~= nil then
            local itemEffectiveness = if type(itemId) == "string"
                then effectiveness[itemId] or 1
                else 1
            stats.damageReduction = math.clamp(
                stats.damageReduction + (trait.damageReductionBonus or 0) * itemEffectiveness,
                0,
                0.25
            )
            stats.staminaRegenMultiplier = math.clamp(
                stats.staminaRegenMultiplier + (trait.staminaRegenBonus or 0) * itemEffectiveness,
                0.75,
                1.5
            )
        end
    end
    return stats
end

function SaveSchema.withEquippedItem(profile: Profile, itemId: string, now: number): (Profile, any)
    local nextEquipped, result = Equipment.equip(profile.gear, profile.equipped, itemId)
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.equipped = nextEquipped
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.withUnequippedItem(profile: Profile, slot: string, now: number): (Profile, any)
    local nextEquipped, result = Equipment.unequip(profile.equipped, slot)
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.equipped = nextEquipped
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.withUsedGearItem(profile: Profile, itemId: string, now: number): (Profile, any)
    local nextGear, result = Crafting.useItem(profile.gear, itemId)
    if not result.applied then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.gear = nextGear
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

local function questSignals(profile: Profile): Quests.Signals
    local craftedItems = 0
    for _, count in profile.gear do
        craftedItems += count
    end
    --[[
        The Milestone 7 resident quests read facts the profile already
        keeps: how much is banked, how far construction has come, how many
        decorations stand, how many pieces of gear have rolled a trait,
        and how many residents count you as more than a stranger.
    ]]
    local materialsBanked = 0
    for _, count in profile.inventory.materials do
        materialsBanked += math.max(0, math.floor(tonumber(count) or 0))
    end
    local buildingsRaised = 0
    for _, stage in (profile :: any).town.construction do
        if (tonumber(stage) or 0) >= 1 then
            buildingsRaised += 1
        end
    end
    local decorationsPlaced = 0
    for _, placed in (profile :: any).town.decorations do
        if placed == true then
            decorationsPlaced += 1
        end
    end
    local gearTraits = 0
    for _ in (profile :: any).gearTraits or {} do
        gearTraits += 1
    end
    local residentsBonded = 0
    for _, resident in (profile :: any).town.residents do
        if type(resident) == "table" and (tonumber(resident.bond) or 0) >= 50 then
            residentsBonded += 1
        end
    end
    local chaptersResolved = 0
    if (profile :: any).story.chapterOne.status == "complete" then
        chaptersResolved += 1
    end
    for _, record in (profile :: any).story.chapters do
        if type(record) == "table" and record.status == "complete" then
            chaptersResolved += 1
        end
    end
    local fragmentsRecovered = 0
    local fragmentsByRegion: { [string]: number } = {}
    for fragmentId, found in (profile :: any).story.fragments do
        if found == true then
            fragmentsRecovered += 1
            local definition = MemoryFragments.byId(fragmentId)
            local regionId = if definition ~= nil
                then (definition :: any).regionId or "region_bramblewake"
                else nil
            if regionId ~= nil then
                fragmentsByRegion[regionId] = (fragmentsByRegion[regionId] or 0) + 1
            end
        end
    end
    local masteryByProfession: { [string]: number } = {}
    for professionId, entry in (profile :: any).profession.mastery do
        if type(entry) == "table" then
            masteryByProfession[professionId] = math.max(0, tonumber(entry.level) or 0)
        end
    end
    return {
        bramblewakeSettlements = #profile.inventory.settlementOrder,
        chaptersResolved = chaptersResolved,
        fragmentsByRegion = fragmentsByRegion,
        fragmentsRecovered = fragmentsRecovered,
        masteryByProfession = masteryByProfession,
        buildingsRaised = buildingsRaised,
        craftedItems = craftedItems,
        decorationsPlaced = decorationsPlaced,
        gearTraits = gearTraits,
        materialsBanked = materialsBanked,
        nightsSurvived = math.max(0, profile.town.nightNumber - 1),
        residentsBonded = residentsBonded,
    }
end

-- Opportunistic, not event-driven: call this after any action that could
-- move a quest signal (a night completing, a craft succeeding, an
-- expedition settling). Safe to call anytime, including when nothing is
-- newly claimable — it just returns an empty result list and the same
-- profile reference.
function SaveSchema.checkAndClaimQuests(profile: Profile, now: number): (Profile, { any })
    local nextClaimed, nextMaterials, claimedResults = Quests.checkAndClaim(
        profile.quests.claimed,
        profile.inventory.materials,
        questSignals(profile)
    )
    if #claimedResults == 0 then
        return profile, claimedResults
    end

    local nextProfile = table.clone(profile)
    nextProfile.quests = table.clone(profile.quests)
    nextProfile.quests.claimed = nextClaimed
    nextProfile.inventory = table.clone(profile.inventory)
    nextProfile.inventory.materials = nextMaterials
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, claimedResults
end

function SaveSchema.questSnapshot(profile: Profile): { any }
    return Quests.snapshot(profile.quests.claimed, questSignals(profile))
end

function SaveSchema.townConsequence(profile: Profile): TownProgression.Consequence
    return TownProgression.resolve(profile)
end

--[[
    Save the player's current kit into a slot: the profession they wear, the
    weapon in their hand, the tool at their hip. Reads the profile's own
    authoritative fields, so a loadout can never remember something the
    save does not actually hold.
]]
function SaveSchema.withLoadout(profile: Profile, slot: number, now: number): (Profile, any)
    if type(slot) ~= "number" or slot ~= math.floor(slot) or slot < 1 or slot > 3 then
        return profile, { applied = false, reason = "invalid_slot" }
    end
    local nextProfile: any = table.clone(profile)
    nextProfile.loadouts = table.clone((profile :: any).loadouts or {})
    local equipped = (profile :: any).equipped or {}
    local loadout = {
        professionId = (profile :: any).profession.selectedId,
        weaponItemId = equipped.weapon,
        toolId = (profile :: any).tutorial.selectedTool,
    }
    nextProfile.loadouts[slot] = loadout
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, { applied = true, slot = slot, loadout = table.clone(loadout) }
end

function SaveSchema.loadoutAt(profile: Profile, slot: any): any
    if type(slot) ~= "number" or slot ~= math.floor(slot) or slot < 1 or slot > 3 then
        return nil
    end
    local loadouts = (profile :: any).loadouts
    return if type(loadouts) == "table" then loadouts[slot] else nil
end

function SaveSchema.withGearWear(profile: Profile, itemId: any, points: number): (Profile, any)
    local nextWear, result = GearWear.accrue((profile :: any).gearWear or {}, itemId, points)
    if not result.applied then
        return profile, result
    end
    local nextProfile: any = table.clone(profile)
    nextProfile.gearWear = nextWear
    nextProfile.revision += 1
    return nextProfile, result
end

--[[
    Spend a flat table of materials ({ materialId = amount }) atomically:
    either every line is affordable and all are deducted, or nothing
    changes. Defense trap arming pays through this; it adds no profile
    field, so no schema bump rides along with it.
]]
function SaveSchema.withSpentMaterials(profile: Profile, cost: any, now: number): (Profile, any)
    local materials = (profile :: any).inventory.materials or {}
    if type(cost) ~= "table" then
        return profile, { applied = false, reason = "invalid_cost" }
    end
    for materialId, amount in cost do
        if type(amount) ~= "number" or amount <= 0 then
            return profile, { applied = false, reason = "invalid_cost" }
        end
        if (tonumber(materials[materialId]) or 0) < amount then
            return profile, { applied = false, reason = "insufficient_materials" }
        end
    end
    local nextMaterials: { [string]: number } = table.clone(materials)
    for materialId, amount in cost do
        local remaining = (nextMaterials[materialId] or 0) - amount
        if remaining <= 0 then
            nextMaterials[materialId] = nil
        else
            nextMaterials[materialId] = remaining
        end
    end
    local nextProfile: any = table.clone(profile)
    nextProfile.inventory = table.clone((profile :: any).inventory)
    nextProfile.inventory.materials = nextMaterials
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, { applied = true }
end

function SaveSchema.withRepairedGear(profile: Profile, itemId: any, now: number): (Profile, any)
    local materials = (profile :: any).inventory.materials or {}
    local nextWear, nextMaterials, result =
        GearWear.repair((profile :: any).gearWear or {}, materials, itemId)
    if not result.applied then
        return profile, result
    end
    local nextProfile: any = table.clone(profile)
    nextProfile.gearWear = nextWear
    nextProfile.inventory = table.clone((profile :: any).inventory)
    nextProfile.inventory.materials = nextMaterials
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

--[[
    Repair a worn item in the field, with no material cost.

    Bench repair spends half a recipe's materials, which is right in a
    town with a wallet open. A field repair is a thing a player crafted
    and carried, so it has already been paid for -- charging twice would
    make the item strictly worse than walking home, which is the one place
    it cannot be used.

    Picks the most-worn item rather than taking a name, because the point
    of it is being used in a hurry.
]]
function SaveSchema.withFieldRepair(profile: Profile, now: number): (Profile, any)
    local wear = (profile :: any).gearWear or {}
    local worstId: string? = nil
    local worstPoints = 0
    for itemId, points in wear do
        local amount = tonumber(points) or 0
        if amount > worstPoints then
            worstId = itemId
            worstPoints = amount
        end
    end
    if worstId == nil then
        return profile, { applied = false, reason = "nothing_worn" }
    end
    local nextProfile: any = table.clone(profile)
    nextProfile.gearWear = table.clone(wear)
    nextProfile.gearWear[worstId] = nil
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile,
        { applied = true, itemId = worstId, points = worstPoints, reason = "repaired" }
end

return table.freeze(SaveSchema)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="97">
        <Properties>
          <string name="Name">SessionSegment</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The two slices every per-segment release gate is read on.

    RELEASE_GATES.md sets a second, looser threshold for every reliability and
    comprehension gate and then says who it applies to: "each advertised
    platform class -- phone, tablet, desktop, and console" and "each supported
    device/performance segment". A threshold that can only be read across the
    whole population is half a gate, because the whole population is exactly
    where a phone-only failure hides.

    So a session carries two labels, and both are decided here:

      * **platform class** is what the player is holding. It is a client fact
        and nothing else can know it -- a server sees a userId and a network
        connection, not a screen. It arrives over the telemetry remote as one
        of four bounded words and is never trusted for anything but a label; no
        rule, reward or refusal in this game reads it.
      * **performance tier** is how well that device is actually running,
        taken from the frame rate the client reports. Two phones are not one
        segment: the gate that matters is whether the game is playable on the
        slow half of them, and averaging the slow half into the fast half is
        the arithmetic that hides it.

    Pure and free of Roblox datatypes, because the Lune runner has none: the
    caller passes booleans and numbers and gets a word back.
]]

local SessionSegment = {}

-- The four classes RELEASE_GATES.md advertises, plus the honest fifth. A
-- session whose client has not introduced itself yet is `unknown` rather than
-- being guessed into `desktop`, which is the class it would be assumed into by
-- a "has a keyboard" test run against no data at all.
local PLATFORMS = table.freeze({
    console = true,
    desktop = true,
    phone = true,
    tablet = true,
    unknown = true,
})

local TIERS = table.freeze({
    high = true,
    low = true,
    mid = true,
    unknown = true,
})

-- Where a touch screen stops being a phone. Measured on the shorter edge in
-- points, because a phone held sideways is still a phone; 600 is the width at
-- which the HUD's portrait rules stop applying and is therefore the same line
-- the layout already draws.
local TABLET_MIN_SHORT_EDGE = 600

function SessionSegment.isValidPlatform(value: any): boolean
    return type(value) == "string" and PLATFORMS[value] == true
end

function SessionSegment.isValidTier(value: any): boolean
    return type(value) == "string" and TIERS[value] == true
end

--[[
    What the player is holding, from what the client can see about itself.

    Order matters. A console reports a ten-foot interface and also a gamepad; a
    Windows tablet reports touch and a keyboard. The first question is always
    the most specific one, so a device that answers yes to two tests is filed
    under the narrower.
]]
function SessionSegment.platformClass(
    tenFootInterface: boolean,
    touchEnabled: boolean,
    keyboardEnabled: boolean,
    viewportWidth: number,
    viewportHeight: number
): string
    if tenFootInterface then
        return "console"
    end
    if not touchEnabled then
        return "desktop"
    end
    -- A touch screen with a keyboard attached is a laptop or a Windows tablet
    -- being used as one. It is filed by its screen rather than its keyboard,
    -- because the reach and safe-area problems the mobile gates exist for are
    -- a property of the screen.
    if
        viewportWidth <= 0
        or viewportHeight <= 0
        or viewportWidth ~= viewportWidth
        or viewportHeight ~= viewportHeight
    then
        return if keyboardEnabled then "desktop" else "unknown"
    end
    local shortEdge = math.min(viewportWidth, viewportHeight)
    if shortEdge >= TABLET_MIN_SHORT_EDGE then
        return "tablet"
    end
    return "phone"
end

--[[
    How well it is running, from the frame rate the client reported.

    The boundaries are the two numbers the performance budget already treats as
    meaningful -- 30 is the floor a session is expected to hold and 50 is
    comfortably above it -- so a tier cannot disagree with a budget verdict
    about the same device.
]]
function SessionSegment.tier(fps: any): string
    if type(fps) ~= "number" or fps ~= fps or fps <= 0 then
        return "unknown"
    end
    if fps >= 50 then
        return "high"
    end
    if fps >= 30 then
        return "mid"
    end
    return "low"
end

-- The device/performance segment as one word, which is the unit the sample
-- minimum is counted in: "each supported device/performance segment needs at
-- least 50 first-session samples".
function SessionSegment.id(platform: any, tier: any): string
    local resolvedPlatform = if SessionSegment.isValidPlatform(platform)
        then platform
        else "unknown"
    local resolvedTier = if SessionSegment.isValidTier(tier) then tier else "unknown"
    return resolvedPlatform .. "/" .. resolvedTier
end

--[[
    The platform a telemetry payload claims, or nil.

    Read separately from the frame samples because it arrives separately: a
    client says what it is on its first frame and does not have a frame rate
    to report for another five seconds. A session that ends inside those five
    seconds is precisely the session the join and crash gates are about, so its
    platform has to be known before its first sample rather than with it.

    Bounded the same way the sample is, and for the same reason: this runs
    *before* `sanitizeClientReport` on a payload a client composed, so if it
    accepted a smuggled key the whitelist below it would never see one. The
    schema version is checked here too -- a payload from a client build that
    does not agree with this one about what the fields mean is not a label, it
    is a guess.
]]
function SessionSegment.platformOf(payload: any): string?
    if type(payload) ~= "table" or payload.schemaVersion ~= 1 then
        return nil
    end
    for key in payload do
        if
            key ~= "schemaVersion"
            and key ~= "fps"
            and key ~= "spikeMs"
            and key ~= "memoryMb"
            and key ~= "platform"
        then
            return nil
        end
    end
    local platform = payload.platform
    if not SessionSegment.isValidPlatform(platform) or platform == "unknown" then
        return nil
    end
    return platform
end

-- Whether a payload is a client introducing itself rather than reporting a
-- sample. An introduction carries no frame data, which is the whole reason it
-- exists: it is sent before there is any.
function SessionSegment.isIntroduction(payload: any): boolean
    return SessionSegment.platformOf(payload) ~= nil
        and type(payload) == "table"
        and payload.fps == nil
end

return table.freeze(SessionSegment)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="98">
        <Properties>
          <string name="Name">SfxCatalog</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Every sound effect in the game, and the rules for when state changes make
    one play.

    The game shipped with music and nothing else: a silent axe, silent
    gathering, a silent night falling. Feedback sound is half of what makes
    tapping feel like hitting, so this catalog exists — but the decisions
    about WHEN a cue fires live here as pure data-in data-out, so a spec can
    hold them still, and the controller that owns actual Sound instances
    stays too thin to break.

    Every cue uses an engine-bundled rbxasset sound. Bundled files ship with
    the client: no moderation queue, no asset permissions, no CDN fetch —
    exactly the failure modes that already bit the authored meshes. The trade
    is a small palette, so distinct cues reuse a file at different playback
    speeds.
]]

local SfxCatalog = {}

export type Cue = {
    id: string,
    soundId: string,
    volume: number,
    minSpeed: number,
    maxSpeed: number,
    cooldown: number,
}

local function cue(
    id: string,
    soundId: string,
    volume: number,
    minSpeed: number,
    maxSpeed: number,
    cooldown: number
): Cue
    return table.freeze({
        id = id,
        soundId = soundId,
        volume = volume,
        minSpeed = minSpeed,
        maxSpeed = maxSpeed,
        cooldown = cooldown,
    })
end

local SLASH = "rbxasset://sounds/swordslash.wav"
local PING = "rbxasset://sounds/electronicpingshort.wav"
local BUTTON = "rbxasset://sounds/button.wav"
local SNAP = "rbxasset://sounds/snap.mp3"
local BASS = "rbxasset://sounds/bass.wav"

local CUES: { [string]: Cue } = {
    -- Input feedback: played directly by input handlers, not by the resolver,
    -- because a swing must sound on the tap, not a snapshot later.
    swing = cue("swing", SLASH, 0.35, 0.92, 1.08, 0.12),
    tap = cue("tap", BUTTON, 0.4, 0.95, 1.1, 0.1),

    -- Snapshot-driven cues.
    gather = cue("gather", PING, 0.32, 1.1, 1.3, 0.15),
    bank = cue("bank", PING, 0.4, 0.72, 0.82, 0.3),
    objective = cue("objective", SNAP, 0.45, 0.98, 1.05, 0.8),
    night = cue("night", BASS, 0.6, 0.7, 0.78, 2),
    encounter = cue("encounter", BASS, 0.65, 0.55, 0.62, 2),
    downed = cue("downed", BASS, 0.55, 0.42, 0.48, 2),
    revived = cue("revived", PING, 0.4, 1.35, 1.5, 1),
}

SfxCatalog.Cues = table.freeze(CUES)

function SfxCatalog.get(id: string): Cue?
    return CUES[id]
end

--[[
    What the previous snapshot's relevant corners looked like, extracted so
    the comparison never holds a reference to a whole snapshot.
]]
export type Signature = {
    resources: number,
    banked: number,
    objective: string,
    nightActive: boolean,
    blackoutStatus: string,
    encounterActive: boolean,
    downed: boolean,
}

local function bankedTotal(bankedMaterials: any): number
    if type(bankedMaterials) == "number" then
        return bankedMaterials
    end
    if type(bankedMaterials) ~= "table" then
        return 0
    end
    local total = 0
    for _, amount in bankedMaterials do
        if type(amount) == "number" then
            total += amount
        end
    end
    return total
end

function SfxCatalog.signature(snapshot: any): Signature
    local elite = if type(snapshot.elite) == "table" then snapshot.elite else nil
    local boss = if type(snapshot.boss) == "table" then snapshot.boss else nil
    local blackout = if type(snapshot.blackout) == "table" then snapshot.blackout else nil
    local survival = if type(snapshot.survival) == "table" then snapshot.survival else nil
    return {
        resources = tonumber(snapshot.resources) or 0,
        banked = bankedTotal(snapshot.bankedMaterials),
        objective = tostring(snapshot.objective or ""),
        nightActive = snapshot.nightActive == true,
        blackoutStatus = if blackout ~= nil then tostring(blackout.status or "") else "",
        encounterActive = (elite ~= nil and elite.active == true)
            or (boss ~= nil and boss.active == true),
        downed = survival ~= nil and survival.downed == true,
    }
end

--[[
    The cues a state change earns. Pure: previous signature + new snapshot in,
    cue ids out. The first snapshot of a session passes previous = nil and
    earns nothing — a reconnect mid-night is not a night falling.
]]
function SfxCatalog.resolveTransitions(previous: Signature?, snapshot: any): ({ string }, Signature)
    local nextSignature = SfxCatalog.signature(snapshot)
    if previous == nil then
        return {}, nextSignature
    end
    local cues: { string } = {}
    if nextSignature.resources > previous.resources then
        table.insert(cues, "gather")
    end
    if nextSignature.banked > previous.banked then
        table.insert(cues, "bank")
    end
    if nextSignature.objective ~= previous.objective and nextSignature.objective ~= "" then
        table.insert(cues, "objective")
    end
    if nextSignature.nightActive and not previous.nightActive then
        table.insert(cues, "night")
    end
    if nextSignature.blackoutStatus == "relay" and previous.blackoutStatus ~= "relay" then
        table.insert(cues, "encounter")
    end
    if nextSignature.encounterActive and not previous.encounterActive then
        table.insert(cues, "encounter")
    end
    if nextSignature.downed and not previous.downed then
        table.insert(cues, "downed")
    elseif previous.downed and not nextSignature.downed then
        table.insert(cues, "revived")
    end
    return cues, nextSignature
end

return table.freeze(SfxCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="99">
        <Properties>
          <string name="Name">SoakProbe</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Whether a server left running is holding on to things.

    M12's soak gate asks that nothing grows without bound over a long
    session. The tempting way to check that is to read a counter at the
    start and again at the end and subtract, and it is wrong in three ways
    that all produce a pass on a leaking build.

    **The first cycle is not a baseline.** A server builds its town,
    spawns its residents and wires its world on the way into cycle one, so
    every one-time allocation in the game lands between the first sample
    and the second. Measured from sample one, a build that then holds
    perfectly steady reports a leak; widen the tolerance until that stops
    and the tolerance is now wide enough to hide a real one. So the
    baseline is the **second** sample, and a soak that has not run three
    cycles has not measured anything.

    **A sample is only comparable to a sample taken at the same point in
    the cycle.** Instance count during a night is legitimately higher than
    at dawn -- there are creatures in the world. A series that drifted
    across phases would produce a number that means nothing, and it would
    look exactly like a number that means something. Every sample carries
    the phase it was taken at and a series that mixes them is refused
    rather than averaged.

    **A leak's signature is that it does not stop.** A metric can rise at
    every single sample and still sit under a flat tolerance for the
    length of a test, which is the shape of every leak that was ever
    shipped: it was small enough for an hour. So growth is judged per
    cycle rather than in total, and a metric that rose at every step from
    the baseline onward is a breach on its own -- it has not levelled off,
    and a run twice as long would not have passed.

    One metric is declared **unobservable** and it is the one the gate
    names first: Roblox exposes no count of live script connections. There
    is no API, so a number here would be a number this game invented, and
    a gate reading an invented number is worse than a gate reading
    nothing. What a soak *can* watch is the residue this game leaves for
    itself -- the per-player tables every service keeps -- and that is a
    real metric with a real reading, because a connection that outlives a
    player is a connection whose table entry outlives them too. The count
    of unobservable metrics is pinned by its spec for the same reason the
    release gates pin their `review` rows: a threshold nobody wants to
    instrument becoming a second one is how a gate quietly stops being a
    gate.

    Pure. No Roblox services, no clock, no instances. Whatever samples it
    hands it numbers.
]]

local SoakProbe = {}

export type Verdict = "ok" | "watch" | "breach" | "incomplete"

export type Metric = {
    id: string,
    label: string,
    -- What one more cycle is allowed to add. A leak scales with cycles, so
    -- the allowance does too; a flat budget passes any leak slow enough.
    perCycleAllowance: number,
    --[[
        Whether the runtime can answer this at all. A metric declared
        unobservable is reported as such and never contributes a verdict,
        which is different from a metric nobody happened to sample.
    ]]
    observable: boolean,
    why: string,
}

export type Sample = {
    cycle: number,
    phase: string,
    counts: { [string]: number },
}

export type Run = {
    phase: string,
    samples: { Sample },
}

export type MetricReport = {
    id: string,
    verdict: Verdict,
    -- Why it read that way, so a breach names which of the two it is.
    reason: string,
    baseline: number,
    last: number,
    growthPerCycle: number,
    allowance: number,
    monotone: boolean,
    cycles: number,
}

export type Report = {
    verdict: Verdict,
    cycles: number,
    metrics: { MetricReport },
    missing: { string },
    unobservable: { string },
}

-- Three samples is the least that can say anything: one to warm up, one to
-- be the baseline, one to be compared against it.
SoakProbe.MinimumCycles = 3

--[[
    How many samples a monotone rise has to span before it is a breach on
    its own. Over three samples "rose every time" is two coin flips and
    happens by accident on a metric that idles between two values; over
    five it is a slope.
]]
SoakProbe.MonotoneCycles = 5

local ORDER: { string } = {
    "instances",
    "connections",
    "tracked_enemies",
    "player_residue",
    "profile_bytes",
}

local DEFINITIONS: { [string]: Metric } = {
    instances = table.freeze({
        id = "instances",
        label = "Instances under the world",
        --[[
            Not zero. Dressing a town is not instant and a decoration a
            player placed on cycle four is a permanent instance that is
            supposed to persist, so a hard zero would fail on the game
            working. Sixteen a cycle is far under any leak that matters
            and far over the handful a played cycle legitimately adds.
        ]]
        perCycleAllowance = 16,
        observable = true,
        why = "A creature, a marker or a billboard that is never destroyed is an "
            .. "instance the world keeps forever.",
    }),
    connections = table.freeze({
        id = "connections",
        label = "Live script connections",
        perCycleAllowance = 0,
        observable = false,
        why = "Roblox exposes no count of live connections. A number here would be "
            .. "one this game invented, so the residue metric watches the tables a "
            .. "leaked connection would keep alive instead.",
    }),
    tracked_enemies = table.freeze({
        id = "tracked_enemies",
        label = "Creatures the server still believes in",
        -- Zero, and this one really is zero: a night ends by clearing its
        -- queue, so a creature outliving the night it belongs to is the
        -- bug rather than a cost of playing.
        perCycleAllowance = 0,
        observable = true,
        why = "A defeated creature still counted is a wave schedule that stalls "
            .. "behind something nobody can fight.",
    }),
    player_residue = table.freeze({
        id = "player_residue",
        label = "Entries held for players who have left",
        perCycleAllowance = 0,
        observable = true,
        why = "Every service keeps tables keyed by player. One that survives the "
            .. "player is the observable half of a connection that survived them.",
    }),
    profile_bytes = table.freeze({
        id = "profile_bytes",
        label = "Encoded size of a profile",
        --[[
            A profile is supposed to grow -- a night survived, a recipe
            crafted, a seed walked are all things a save remembers. What
            it may not do is grow *per cycle without bound*, which is why
            the seed history is capped. 256 bytes a cycle is generous for
            the former and nowhere near enough to hide the latter.
        ]]
        perCycleAllowance = 256,
        observable = true,
        why = "A save that grows every night eventually stops fitting in a "
            .. "DataStore value, and it fails for the player who played most.",
    }),
}

SoakProbe.Order = table.freeze(ORDER)
SoakProbe.Metrics = table.freeze(DEFINITIONS)

function SoakProbe.metric(metricId: any): Metric?
    return if type(metricId) == "string" then DEFINITIONS[metricId] else nil
end

function SoakProbe.isObservable(metricId: any): boolean
    local definition = SoakProbe.metric(metricId)
    return definition ~= nil and definition.observable
end

--[[
    Start a run at a named phase. The phase is fixed here rather than read
    off the first sample, because a sampler wired to the wrong hook would
    otherwise define its own correctness.
]]
function SoakProbe.begin(phase: string): Run
    assert(type(phase) == "string" and phase ~= "", "a soak run needs a phase to sample at")
    return { phase = phase, samples = {} }
end

export type RecordResult = {
    accepted: boolean,
    reason: string,
}

--[[
    Add one cycle's counts. Refused, rather than absorbed, when the sample
    cannot be compared to the ones beside it: a different phase means a
    different question, and a repeated or reversed cycle number means the
    sampler fired twice and would halve the apparent growth of a real
    leak.
]]
function SoakProbe.record(run: Run, cycle: any, phase: any, counts: any): (Run, RecordResult)
    if type(cycle) ~= "number" or cycle ~= math.floor(cycle) or cycle < 1 then
        return run, { accepted = false, reason = "cycle_invalid" }
    end
    if phase ~= run.phase then
        return run, { accepted = false, reason = "phase_mismatch" }
    end
    if type(counts) ~= "table" then
        return run, { accepted = false, reason = "counts_invalid" }
    end
    local previous = run.samples[#run.samples]
    if previous ~= nil and cycle <= previous.cycle then
        return run, { accepted = false, reason = "cycle_repeated" }
    end

    local kept: { [string]: number } = {}
    for metricId, value in counts do
        --[[
            An unknown metric is dropped rather than carried, and an
            unobservable one is dropped too: accepting a reading for
            `connections` would let a caller quietly supply the invented
            number this module exists to refuse.
        ]]
        if
            SoakProbe.isObservable(metricId)
            and type(value) == "number"
            and value == value
            and value >= 0
            and value < math.huge
        then
            kept[metricId] = value
        end
    end

    local nextRun: Run = { phase = run.phase, samples = table.clone(run.samples) }
    table.insert(nextRun.samples, { cycle = cycle, phase = phase, counts = kept })
    return nextRun, { accepted = true, reason = "recorded" }
end

local function reportFor(run: Run, definition: Metric): MetricReport?
    local values: { number } = {}
    local cycles: { number } = {}
    for _, sample in run.samples do
        local value = sample.counts[definition.id]
        if value ~= nil then
            table.insert(values, value)
            table.insert(cycles, sample.cycle)
        end
    end
    if #values < SoakProbe.MinimumCycles then
        return nil
    end

    -- The second sample, because the first one paid for everything the
    -- server builds on its way in.
    local baseline = values[2]
    local last = values[#values]

    --[[
        Growth is measured over the **tail**, from the middle sample to the
        last, and that is a lesson a live run taught rather than a
        refinement. Emberhollow builds more of itself as it tiers up: a
        real seven-cycle soak stepped 982 instances in one cycle when the
        town raised new buildings, then held flat for three. Measured from
        the baseline that reads as 200 a cycle forever, so a healthy server
        breaches on the game working -- and a gate that cries wolf on every
        server is a gate nobody reads.

        The tail asks the question the gate actually has: **is it still
        growing?** A one-time build-out is over by the time the tail starts;
        a leak is not, because a leak is defined by not stopping. It is also
        the rule `PerformanceBudget` already argued for on frame rate: judge
        the tail, because a mean hides the thing you are looking for.
    ]]
    local middle = math.max(2, math.ceil((#values + 1) / 2))
    local from = values[middle]
    local span = cycles[#cycles] - cycles[middle]
    local growth = if span > 0 then (last - from) / span else 0

    local monotone = true
    for index = 3, #values do
        if values[index] <= values[index - 1] then
            monotone = false
            break
        end
    end

    --[[
        Two ways to fail, and they are worth telling apart in the report
        rather than only in the verdict. `over_allowance` is a metric
        growing faster than it is allowed to. `still_climbing` is the
        quieter one: under the allowance, and up at every step from the
        baseline, so this run passed and a longer one would not have --
        which makes it a result about the length of the test rather than
        about the build.
    ]]
    local overAllowance = growth > definition.perCycleAllowance
    local stillClimbing = monotone and #values >= SoakProbe.MonotoneCycles

    local verdict: Verdict = "ok"
    local reason = "steady"
    if overAllowance or stillClimbing then
        verdict = "breach"
        reason = if overAllowance then "over_allowance" else "still_climbing"
    elseif monotone and growth > 0 then
        verdict = "watch"
        reason = "climbing"
    end

    return {
        id = definition.id,
        verdict = verdict,
        reason = reason,
        baseline = baseline,
        last = last,
        growthPerCycle = growth,
        allowance = definition.perCycleAllowance,
        monotone = monotone,
        cycles = #values,
    }
end

--[[
    The run's verdict. A metric nobody sampled is `missing` and drags the
    whole run to `incomplete`, which is PerformanceBudget's rule and the
    same reasoning: the failure a soak gate exists to catch is somebody
    claiming a pass for something nobody looked at.
]]
function SoakProbe.report(run: Run): Report
    local metrics: { MetricReport } = {}
    local missing: { string } = {}
    local unobservable: { string } = {}
    local worst: Verdict = "ok"

    for _, metricId in ORDER do
        local definition = DEFINITIONS[metricId]
        if not definition.observable then
            table.insert(unobservable, metricId)
            continue
        end
        local report = reportFor(run, definition)
        if report == nil then
            table.insert(missing, metricId)
        else
            table.insert(metrics, report)
            if report.verdict == "breach" then
                worst = "breach"
            elseif report.verdict == "watch" and worst == "ok" then
                worst = "watch"
            end
        end
    end

    if #missing > 0 and worst ~= "breach" then
        worst = "incomplete"
    end

    return {
        verdict = worst,
        cycles = #run.samples,
        metrics = metrics,
        missing = missing,
        unobservable = unobservable,
    }
end

return table.freeze(SoakProbe)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="100">
        <Properties>
          <string name="Name">StatusEffectState</string>
          <string name="Source"><![CDATA[--!strict

local StatusEffectState = {}

export type State = {
    drowsyUntil: number,
    drowsyMultiplier: number,
    rootedUntil: number,
    rootedMultiplier: number,
    shieldUntil: number,
    shieldMultiplier: number,
}

export type Snapshot = {
    drowsy: boolean,
    drowsyUntil: number,
    movementMultiplier: number,
    rooted: boolean,
    rootedUntil: number,
    shielded: boolean,
    shieldUntil: number,
    damageMultiplier: number,
}

function StatusEffectState.create(): State
    return {
        drowsyUntil = 0,
        drowsyMultiplier = 1,
        rootedUntil = 0,
        rootedMultiplier = 1,
        shieldUntil = 0,
        shieldMultiplier = 1,
    }
end

function StatusEffectState.applyDrowsy(
    state: State,
    now: number,
    duration: number,
    multiplier: number
): State
    local nextState = table.clone(state)
    local untilTime = now + math.max(0, duration)
    if untilTime >= state.drowsyUntil then
        nextState.drowsyUntil = untilTime
        nextState.drowsyMultiplier = math.clamp(multiplier, 0.25, 1)
    end
    return nextState
end

function StatusEffectState.applyRooted(
    state: State,
    now: number,
    duration: number,
    multiplier: number
): State
    local nextState = table.clone(state)
    local untilTime = now + math.max(0, duration)
    if untilTime >= state.rootedUntil then
        nextState.rootedUntil = untilTime
        nextState.rootedMultiplier = math.clamp(multiplier, 0.25, 1)
    end
    return nextState
end

-- Reduces incoming damage for a short window, the same duration+multiplier
-- shape applyDrowsy/applyRooted already use for movement, just applied to
-- damage instead. Kept independent of ProfessionService's Warden-only
-- mitigateIncomingDamage so an item-granted shield can stack with (rather
-- than replace) a profession's own guard ability.
function StatusEffectState.applyShield(
    state: State,
    now: number,
    duration: number,
    multiplier: number
): State
    local nextState = table.clone(state)
    local untilTime = now + math.max(0, duration)
    if untilTime >= state.shieldUntil then
        nextState.shieldUntil = untilTime
        nextState.shieldMultiplier = math.clamp(multiplier, 0.1, 1)
    end
    return nextState
end

function StatusEffectState.clear(_state: State): State
    return StatusEffectState.create()
end

--[[
    Clear what was done to you, and only that.

    A player drinking something to shake off a rooting or a drowsiness
    must not also lose the shield they just put up -- that would make the
    cure worse than the condition in exactly the moment it is reached
    for. So this drops drowsy and rooted and leaves the shield alone,
    which is the difference between a cure and a reset.
]]
function StatusEffectState.clearAfflictions(state: State): (State, boolean)
    local nextState = table.clone(state)
    local had = state.drowsyUntil > 0 or state.rootedUntil > 0
    nextState.drowsyUntil = 0
    nextState.drowsyMultiplier = 1
    nextState.rootedUntil = 0
    nextState.rootedMultiplier = 1
    return nextState, had
end

-- Whether anything is currently being done to this player, which is the
-- precondition a cure has to clear before it is spent.
function StatusEffectState.afflicted(state: State, now: number): boolean
    return now < state.drowsyUntil or now < state.rootedUntil
end

function StatusEffectState.snapshot(state: State, now: number): Snapshot
    local active = now < state.drowsyUntil
    local rooted = now < state.rootedUntil
    local shielded = now < state.shieldUntil
    local movementMultiplier = 1
    if active then
        movementMultiplier = math.min(movementMultiplier, state.drowsyMultiplier)
    end
    if rooted then
        movementMultiplier = math.min(movementMultiplier, state.rootedMultiplier)
    end
    return {
        drowsy = active,
        drowsyUntil = if active then state.drowsyUntil else 0,
        movementMultiplier = movementMultiplier,
        rooted = rooted,
        rootedUntil = if rooted then state.rootedUntil else 0,
        shielded = shielded,
        shieldUntil = if shielded then state.shieldUntil else 0,
        damageMultiplier = if shielded then state.shieldMultiplier else 1,
    }
end

return table.freeze(StatusEffectState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="101">
        <Properties>
          <string name="Name">StoreAvailability</string>
          <string name="Source"><![CDATA[--!strict

--[[
    When the store may open, and -- more to the point -- when it may not.

    Milestone 11's exit gate is one sentence: *the store never interrupts
    onboarding, active defense, downed state, or defeat.* The monetization
    document says the same thing from the other side, listing "popups during
    downed, defeat, urgent defense, or first-session teaching" among the
    explicitly prohibited. Both are rules about a moment rather than about a
    product, which is why they belong in a predicate rather than in a comment
    beside a button.

    **It is pure, and both sides call it.** The server decides -- a client that
    decided would be a client that could decide otherwise -- but the HUD asks
    the same function with the same snapshot fields, so a panel that is open
    when a night starts closes itself on the frame the state changes rather
    than waiting for somebody to press something. One rule, two readers, no
    second copy to drift.

    **The order the refusals are checked in is the message a player gets.** A
    player who is downed during a lost night is being refused for the worst
    reason that applies, not the first one the code happened to look at.
]]

local StoreAvailability = {}

export type Context = {
    -- The kill switch. `cosmetic_store_enabled` is false until there are
    -- products to sell, and a flag that only hides the button is not a kill
    -- switch.
    storeEnabled: boolean?,
    tutorialComplete: boolean?,
    nightActive: boolean?,
    -- Creatures standing in the world right now. Night is not the only defense
    -- this game runs: a blackout relay, a town incident and both boss fights
    -- all put a player in one during daylight, and every one of them is a
    -- moment a store is not welcome in.
    enemyCount: number?,
    downed: boolean?,
    -- Everybody who could act is down. This game has no permanent loss, so
    -- defeat is the party wipe -- the moment the guard's last stand exists to
    -- answer, and the single worst moment in the game to be sold something.
    partyDown: boolean?,
}

export type Verdict = {
    open: boolean,
    reason: string,
    label: string,
}

--[[
    Every refusal, in the order they are asked, with the line a player reads.

    The labels are the same voice as every other refusal in the HUD, and none
    of them apologises for the store: a player told "not now" during a night
    should read it as the game protecting the night.
]]
local REFUSALS: { { reason: string, label: string } } = table.freeze({
    table.freeze({ reason = "store_disabled", label = "THE OUTFITTER IS NOT OPEN YET" }),
    table.freeze({
        reason = "defeat",
        label = "THE PARTY IS DOWN — THAT IS ALL THAT MATTERS NOW",
    }),
    table.freeze({ reason = "downed", label = "GET BACK ON YOUR FEET FIRST" }),
    table.freeze({ reason = "active_defense", label = "NOT WHILE SOMETHING IS OUT THERE" }),
    table.freeze({ reason = "onboarding", label = "FINISH THE FIRST NIGHT FIRST" }),
})

local OPEN: Verdict = table.freeze({ open = true, reason = "open", label = "OUTFITTER" })

local function refusal(reason: string): Verdict
    for _, entry in REFUSALS do
        if entry.reason == reason then
            return table.freeze({ open = false, reason = entry.reason, label = entry.label })
        end
    end
    -- Unreachable through `evaluate`; kept as a total function so a caller
    -- asking about a reason nobody wrote gets a closed store rather than nil.
    return table.freeze({ open = false, reason = reason, label = "THE OUTFITTER IS CLOSED" })
end

function StoreAvailability.reasons(): { { reason: string, label: string } }
    return REFUSALS
end

function StoreAvailability.evaluate(context: any): Verdict
    if type(context) ~= "table" then
        return refusal("store_disabled")
    end
    if context.storeEnabled ~= true then
        return refusal("store_disabled")
    end
    --[[
        Defeat before downed, and downed before the defense that caused it.

        A wiped party is one refusal, not one per member, and the player being
        told about it is being told the most important true thing. Checking in
        the other order would answer a lost night with "not while something is
        out there", which is technically correct and reads as the game not
        having noticed.
    ]]
    if context.partyDown == true then
        return refusal("defeat")
    end
    if context.downed == true then
        return refusal("downed")
    end
    local enemyCount = tonumber(context.enemyCount) or 0
    if context.nightActive == true or enemyCount > 0 then
        return refusal("active_defense")
    end
    --[[
        Onboarding last, and it is the only one that is not about danger.

        First-session teaching is a prohibited moment for its own reason: a
        player who has not finished the first night has not yet been shown what
        any of this is for, and a storefront is the loudest possible answer to
        a question they have not asked.
    ]]
    if context.tutorialComplete ~= true then
        return refusal("onboarding")
    end
    return OPEN
end

return table.freeze(StoreAvailability)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="102">
        <Properties>
          <string name="Name">StoreCard</string>
          <string name="Source"><![CDATA[--!strict

--[[
    What a store card is allowed to say, and what it may not be drawn without.

    The monetization document is specific about this and the roadmap's exit
    gate repeats it: every product shows a real preview, the exact Robux price,
    permanence, and owned state, and no product may confuse price or
    permanence. A card is therefore not a layout -- it is a claim about a
    purchase, and a claim missing one of its four facts is worse than no claim
    at all.

    So the refusal is structural. `build` returns **nil** when it cannot make an
    honest card, and the reason why, rather than returning a card with a blank
    where the price goes. A player who sees a BUY button over an empty price is
    a player who does not know what they are agreeing to, and a store that
    shows nothing is merely a store that is not open yet.

    **The price never comes from here.** It is passed in, because it has to be
    read from platform product information at the moment it is asked for --
    a number written into the source is a number that is wrong the first time
    the owner edits it in the Creator Dashboard, and a card showing the wrong
    price is the worst failure in this file.

    **Nothing here names a cosmetic.** A card is built from whatever product and
    plan it is handed. That is what lets `CosmeticNeutrality.spec` say no module
    outside the catalog can name a cosmetic id: the store renders the catalog
    rather than knowing it.
]]

local StoreCard = {}

export type Context = {
    -- Nil is a real answer and means "the platform has not told us". The
    -- dashboard product may not exist yet, or the web call may have failed.
    priceInRobux: number?,
    owned: boolean?,
    equipped: boolean?,
    -- The geometry the card draws. A preview is one of the four required
    -- facts, so a product whose grants resolve to nothing drawable has no
    -- honest card either. Only its *presence* travels: see `previewParts`.
    preview: { any }?,
}

export type Card = {
    productId: string,
    displayName: string,
    detail: string,
    priceLabel: string,
    priceInRobux: number,
    permanenceLabel: string,
    ownedLabel: string,
    owned: boolean,
    equipped: boolean,
    --[[
        What the one button on the card does: `buy`, or nothing at all.

        An owned product loses the buy button entirely rather than greying it
        out, which is what the owned state is for -- a product with a price on
        it that the player already has is the "sells a player the same thing
        twice" case. And the button never becomes WEAR: a product may grant
        more than one cosmetic, and a single button cannot honestly say which
        of them it would put on. Wearing lives on the wardrobe row, which is
        one row per cosmetic and therefore never ambiguous.
    ]]
    action: string,
    actionLabel: string,
    assurance: string,
    --[[
        How many parts the preview turned out to have, rather than the parts.

        The card is built on a server and read by a client that already holds
        the catalog, so shipping the geometry would put the same plan on the
        wire on every snapshot push to say something the client can look up.
        What has to travel is that the check passed: a card exists only if
        there was real geometry behind it, and this is the number that says so.
    ]]
    previewParts: number,
}

export type WardrobeRow = {
    cosmeticId: string,
    displayName: string,
    slot: string,
    equipped: boolean,
    actionLabel: string,
    previewParts: number,
}

--[[
    On every card, always, and built in rather than authored per product.

    MONETIZATION_LIVEOPS_ANALYTICS forbids paid power, and
    CHARACTER_KITS_SPEC's storefront review asks for the sentence in as many
    words. A line a copywriter has to remember to add is a line that will be
    missing from the twelfth product; a line the builder adds cannot be.
]]
local ASSURANCE = "COSMETIC ONLY — ABILITIES ARE EARNED IN PLAY"

local PERMANENCE_LABELS: { [string]: string } = table.freeze({
    permanent = "PERMANENT — YOURS FOR GOOD",
})

function StoreCard.assurance(): string
    return ASSURANCE
end

--[[
    The Robux figure as a player reads it.

    Whole numbers only: the platform prices in whole Robux, and a decimal point
    here would be this file inventing a currency.
]]
function StoreCard.priceLabel(priceInRobux: any): string?
    if type(priceInRobux) ~= "number" then
        return nil
    end
    if priceInRobux ~= priceInRobux or priceInRobux < 0 or priceInRobux == math.huge then
        return nil
    end
    if priceInRobux ~= math.floor(priceInRobux) then
        return nil
    end
    return string.format("%d ROBUX", priceInRobux)
end

function StoreCard.permanenceLabel(permanence: any): string?
    if type(permanence) ~= "string" then
        return nil
    end
    return PERMANENCE_LABELS[permanence]
end

--[[
    One card, or nothing and the reason.

    The four refusals below are the four facts the exit gate names, and the
    order is deliberate: a missing permanence or a missing preview is a
    catalog bug that should fail a spec, while a missing price is the ordinary
    state of a product whose dashboard half does not exist yet. Naming them
    apart is what lets the store say "not priced yet" without saying it about
    a genuinely broken entry.
]]
function StoreCard.build(product: any, context: any): (Card?, string)
    if type(product) ~= "table" or type(product.id) ~= "string" or #product.id == 0 then
        return nil, "no_product"
    end
    if type(product.displayName) ~= "string" or #product.displayName == 0 then
        return nil, "no_name"
    end
    local permanenceLabel = StoreCard.permanenceLabel(product.permanence)
    if permanenceLabel == nil then
        return nil, "no_permanence"
    end
    if type(context) ~= "table" then
        return nil, "no_owned_state"
    end
    -- Owned has to be a boolean, not merely truthy. Nil here means nobody
    -- asked, and a card that renders NOT OWNED because nobody asked is a card
    -- that will sell a player something they already have.
    if type(context.owned) ~= "boolean" then
        return nil, "no_owned_state"
    end
    local preview = context.preview
    if type(preview) ~= "table" or #preview == 0 then
        return nil, "no_preview"
    end
    local priceLabel = StoreCard.priceLabel(context.priceInRobux)
    if priceLabel == nil then
        return nil, "no_price"
    end

    local owned = context.owned
    local equipped = context.equipped == true
    return {
        productId = product.id,
        displayName = product.displayName,
        detail = if type(product.detail) == "string" then product.detail else "",
        priceLabel = priceLabel,
        priceInRobux = context.priceInRobux,
        permanenceLabel = permanenceLabel,
        ownedLabel = if owned then "OWNED" else "NOT OWNED",
        owned = owned,
        equipped = equipped,
        action = if owned then "owned" else "buy",
        actionLabel = if owned then "OWNED" else "BUY · " .. priceLabel,
        assurance = ASSURANCE,
        previewParts = #preview,
    },
        "ok"
end

--[[
    A row for something already owned, which needs no price at all.

    The wardrobe is a separate list from the shelf on purpose. A product can
    stop resolving -- delisted in the dashboard, or its web call failing -- and
    a store that showed owned cosmetics only through their sale cards would
    make a paid-for coat unwearable the moment the thing that sold it went
    away. That is the shape this project has now paid for four times: an
    entitlement that exists and a cosmetic that can be worn are different
    facts.
]]
function StoreCard.wardrobeRow(cosmetic: any, equipped: any): (WardrobeRow?, string)
    if type(cosmetic) ~= "table" or type(cosmetic.id) ~= "string" or #cosmetic.id == 0 then
        return nil, "no_cosmetic"
    end
    if type(cosmetic.displayName) ~= "string" or #cosmetic.displayName == 0 then
        return nil, "no_name"
    end
    if type(cosmetic.slot) ~= "string" or #cosmetic.slot == 0 then
        return nil, "no_slot"
    end
    if type(cosmetic.parts) ~= "table" or #cosmetic.parts == 0 then
        return nil, "no_preview"
    end
    if type(equipped) ~= "boolean" then
        return nil, "no_worn_state"
    end
    return {
        cosmeticId = cosmetic.id,
        displayName = cosmetic.displayName,
        slot = cosmetic.slot,
        equipped = equipped,
        actionLabel = if equipped then "TAKE OFF" else "WEAR",
        previewParts = #cosmetic.parts,
    },
        "ok"
end

return table.freeze(StoreCard)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="103">
        <Properties>
          <string name="Name">SurvivalState</string>
          <string name="Source"><![CDATA[--!strict

local Config = require("./Config")

local SurvivalState = {}

export type Status = "active" | "downed"
export type State = {
    bleedoutAt: number?,
    downedAt: number?,
    health: number,
    invulnerableUntil: number,
    maxHealth: number,
    revision: number,
    status: Status,
}
export type TransitionResult = {
    applied: boolean,
    damage: number?,
    healed: number?,
    downed: boolean?,
    health: number?,
    reason: string?,
}
export type Snapshot = {
    bleedoutAt: number?,
    downed: boolean,
    downedDuration: number,
    health: number,
    invulnerable: boolean,
    maxHealth: number,
    revision: number,
    timeRemaining: number,
}

local MAX_HEALTH = Config.MaxHealth
local DOWNED_SECONDS = Config.DownedSeconds
local REVIVE_HEALTH = Config.ReviveHealth
local RECOVERY_HEALTH = Config.RecoveryHealth
local REVIVE_INVULNERABILITY_SECONDS = Config.ReviveInvulnerabilitySeconds
local RECOVERY_INVULNERABILITY_SECONDS = Config.RecoveryInvulnerabilitySeconds

local function validNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function SurvivalState.create(now: number): State
    assert(validNumber(now), "survival state time is invalid")
    return {
        health = MAX_HEALTH,
        maxHealth = MAX_HEALTH,
        status = "active",
        downedAt = nil,
        bleedoutAt = nil,
        invulnerableUntil = now,
        revision = 0,
    }
end

function SurvivalState.damage(state: State, amount: number, now: number): (State, TransitionResult)
    if not validNumber(amount) or amount <= 0 or amount ~= math.floor(amount) then
        return state,
            {
                applied = false,
                reason = "invalid_damage",
            }
    end
    if state.status ~= "active" then
        return state, {
            applied = false,
            reason = "player_downed",
        }
    end
    if now < state.invulnerableUntil then
        return state, {
            applied = false,
            reason = "invulnerable",
        }
    end

    local nextState: State = table.clone(state)
    nextState.health = math.max(0, state.health - amount)
    nextState.revision += 1
    local downed = nextState.health == 0
    if downed then
        nextState.status = "downed"
        nextState.downedAt = now
        nextState.bleedoutAt = now + DOWNED_SECONDS
    end
    return nextState,
        {
            applied = true,
            damage = math.min(amount, state.health),
            downed = downed,
        }
end

function SurvivalState.heal(state: State, amount: number): (State, TransitionResult)
    if not validNumber(amount) or amount <= 0 or amount ~= math.floor(amount) then
        return state, {
            applied = false,
            reason = "invalid_heal",
        }
    end
    if state.status ~= "active" then
        return state, {
            applied = false,
            reason = "player_downed",
        }
    end
    if state.health >= state.maxHealth then
        return state, {
            applied = false,
            reason = "full_health",
        }
    end

    local nextState: State = table.clone(state)
    nextState.health = math.min(state.maxHealth, state.health + amount)
    nextState.revision += 1
    return nextState,
        {
            applied = true,
            healed = nextState.health - state.health,
            health = nextState.health,
        }
end

function SurvivalState.revive(state: State, now: number, tuning: any?): (State, TransitionResult)
    if state.status ~= "downed" then
        return state,
            {
                applied = false,
                reason = "player_not_downed",
            }
    end
    if type(state.bleedoutAt) ~= "number" or now >= state.bleedoutAt then
        return state,
            {
                applied = false,
                reason = "bleedout_expired",
            }
    end

    local reviveHealth = if type(tuning) == "table" and validNumber(tuning.health)
        then math.clamp(math.floor(tuning.health), REVIVE_HEALTH, state.maxHealth)
        else REVIVE_HEALTH
    local wardSeconds = if type(tuning) == "table" and validNumber(tuning.wardSeconds)
        then math.clamp(tuning.wardSeconds, REVIVE_INVULNERABILITY_SECONDS, 6)
        else REVIVE_INVULNERABILITY_SECONDS
    local nextState: State = table.clone(state)
    nextState.health = reviveHealth
    nextState.status = "active"
    nextState.downedAt = nil
    nextState.bleedoutAt = nil
    nextState.invulnerableUntil = now + wardSeconds
    nextState.revision += 1
    return nextState, {
        applied = true,
        health = nextState.health,
    }
end

function SurvivalState.recover(state: State, now: number): (State, TransitionResult)
    if state.status ~= "downed" then
        return state,
            {
                applied = false,
                reason = "player_not_downed",
            }
    end
    if type(state.bleedoutAt) ~= "number" or now < state.bleedoutAt then
        return state,
            {
                applied = false,
                reason = "bleedout_active",
            }
    end

    local nextState: State = table.clone(state)
    nextState.health = RECOVERY_HEALTH
    nextState.status = "active"
    nextState.downedAt = nil
    nextState.bleedoutAt = nil
    nextState.invulnerableUntil = now + RECOVERY_INVULNERABILITY_SECONDS
    nextState.revision += 1
    return nextState, {
        applied = true,
        health = nextState.health,
    }
end

function SurvivalState.safeRetreat(state: State, now: number): (State, TransitionResult)
    if state.status ~= "downed" then
        return state,
            {
                applied = false,
                reason = "player_not_downed",
            }
    end

    local nextState: State = table.clone(state)
    nextState.health = RECOVERY_HEALTH
    nextState.status = "active"
    nextState.downedAt = nil
    nextState.bleedoutAt = nil
    nextState.invulnerableUntil = now + RECOVERY_INVULNERABILITY_SECONDS
    nextState.revision += 1
    return nextState, {
        applied = true,
        health = nextState.health,
    }
end

function SurvivalState.respawn(state: State, now: number): State
    local nextState: State = table.clone(state)
    nextState.health = RECOVERY_HEALTH
    nextState.status = "active"
    nextState.downedAt = nil
    nextState.bleedoutAt = nil
    nextState.invulnerableUntil = now + RECOVERY_INVULNERABILITY_SECONDS
    nextState.revision += 1
    return nextState
end

function SurvivalState.canAct(state: State): boolean
    return state.status == "active" and state.health > 0
end

function SurvivalState.snapshot(state: State, now: number): Snapshot
    local bleedoutAt = if type(state.bleedoutAt) == "number" then state.bleedoutAt else nil
    return {
        bleedoutAt = bleedoutAt,
        downed = state.status == "downed",
        downedDuration = DOWNED_SECONDS,
        health = state.health,
        invulnerable = now < state.invulnerableUntil,
        maxHealth = state.maxHealth,
        revision = state.revision,
        timeRemaining = if bleedoutAt == nil then 0 else math.max(0, math.ceil(bleedoutAt - now)),
    }
end

SurvivalState.Constants = table.freeze({
    DownedSeconds = DOWNED_SECONDS,
    MaxHealth = MAX_HEALTH,
    RecoveryHealth = RECOVERY_HEALTH,
    ReviveHealth = REVIVE_HEALTH,
})

return table.freeze(SurvivalState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="104">
        <Properties>
          <string name="Name">TempestEnemies</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Tempest Reach's six standard enemies.

    The Fen waits and the Delve charges; the Reach *throws*. Almost
    everything here attacks along a line the weather is already pushing,
    so its fights are fought sideways: you are rarely running from the
    creature, you are getting out from between it and where the wind is
    going. Two of them cannot be beaten by damage alone -- the salt husk
    reforms unless it is dried out, and the storm ray's charge has to be
    grounded rather than dodged -- which is the region's whole lesson
    about weather being a thing you route rather than survive.
]]

local TempestEnemies = {}

export type EnemyDefinition = {
    id: string,
    displayName: string,
    modelKey: string,
    health: number,
    speed: number,
    attackRange: number,
    attackCooldown: number,
    playerDamage: number,
    lanternDamage: number,
    strikeRange: number,
    strikeDamage: number,
    attackId: string,
    attackName: string,
    instruction: string,
    shape: "circle" | "lane",
    radius: number?,
    width: number?,
    length: number?,
    windup: number,
    stationary: boolean,
    targetMode: "lantern" | "player",
    frontShield: boolean,
    frontalStrikeDamage: number?,
    flankStrikeDamage: number?,
    statusEffect: ("drowsy" | "spark_theft")?,
    statusDuration: number?,
    statusMultiplier: number?,
    statusLanternDamage: number?,
}

local function freezeDefinition(definition: EnemyDefinition): EnemyDefinition
    return table.freeze(definition)
end

local DEFINITIONS: { [string]: EnemyDefinition } = {
    -- Small, fast, and always shooting along the wind rather than at you.
    enemy_gale_imp = freezeDefinition({
        id = "enemy_gale_imp",
        displayName = "Gale Imp",
        modelKey = "gale_imp",
        health = 70,
        speed = 8.5,
        attackRange = 12,
        attackCooldown = 2.2,
        playerDamage = 20,
        lanternDamage = 5,
        strikeRange = 9,
        strikeDamage = 38,
        attackId = "gale_imp_gust",
        attackName = "GALE IMP GUST",
        instruction = "STEP OUT OF THE GUST LINE",
        shape = "lane",
        radius = nil,
        width = 5,
        length = 18,
        windup = 0.95,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Climbs whatever a town built to keep the sea out, and pulls it down.
    enemy_wreck_crawler = freezeDefinition({
        id = "enemy_wreck_crawler",
        displayName = "Wreck Crawler",
        modelKey = "wreck_crawler",
        health = 120,
        speed = 6,
        attackRange = 10,
        attackCooldown = 2.6,
        playerDamage = 26,
        lanternDamage = 14,
        strikeRange = 10,
        strikeDamage = 34,
        attackId = "wreck_crawler_haul",
        attackName = "RIGGING HAUL",
        instruction = "GET OFF THE RIGGING",
        shape = "circle",
        radius = 8,
        width = nil,
        length = nil,
        windup = 1.25,
        stationary = false,
        targetMode = "lantern",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Its charge is passed through grounding, not dodged. Outrunning a\n    -- thing that moves at nine and a half is not a plan.
    enemy_storm_ray = freezeDefinition({
        id = "enemy_storm_ray",
        displayName = "Storm Ray",
        modelKey = "storm_ray",
        health = 95,
        speed = 9.5,
        attackRange = 20,
        attackCooldown = 3.2,
        playerDamage = 32,
        lanternDamage = 8,
        strikeRange = 10,
        strikeDamage = 36,
        attackId = "storm_ray_charge",
        attackName = "STORM RAY CHARGE",
        instruction = "GROUND IT — DO NOT OUTRUN IT",
        shape = "lane",
        radius = nil,
        width = 7,
        length = 26,
        windup = 1.35,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Reforms near water unless it is dried. Damage alone only postpones.
    enemy_salt_husk = freezeDefinition({
        id = "enemy_salt_husk",
        displayName = "Salt Husk",
        modelKey = "salt_husk",
        health = 110,
        speed = 4.4,
        attackRange = 9,
        attackCooldown = 2.8,
        playerDamage = 24,
        lanternDamage = 10,
        strikeRange = 10,
        strikeDamage = 32,
        attackId = "salt_husk_break",
        attackName = "SALT BREAK",
        instruction = "DRY IT OUT OR IT COMES BACK",
        shape = "circle",
        radius = 7,
        width = nil,
        length = nil,
        windup = 1.15,
        stationary = false,
        targetMode = "lantern",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "drowsy",
        statusDuration = 6,
        statusMultiplier = 0.82,
        statusLanternDamage = nil,
    }),
    -- Never moves. Pulls you somewhere worse, which is the same problem\n    -- from the other end.
    enemy_rigging_snare = freezeDefinition({
        id = "enemy_rigging_snare",
        displayName = "Rigging Snare",
        modelKey = "rigging_snare",
        health = 85,
        speed = 0,
        attackRange = 16,
        attackCooldown = 3,
        playerDamage = 18,
        lanternDamage = 6,
        strikeRange = 11,
        strikeDamage = 40,
        attackId = "rigging_snare_pull",
        attackName = "SNARE PULL",
        instruction = "CUT LOOSE BEFORE THE HAZARD",
        shape = "lane",
        radius = nil,
        width = 4,
        length = 20,
        windup = 1.1,
        stationary = true,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Wave-shaped: wide, slow, and aimed at what a town built. Its face\n    -- is a wall and its flank is not, which is the Crank Guard's lesson\n    -- taught by water.
    enemy_breaker = freezeDefinition({
        id = "enemy_breaker",
        displayName = "Breaker",
        modelKey = "breaker",
        health = 150,
        speed = 5.2,
        attackRange = 14,
        attackCooldown = 3.6,
        playerDamage = 30,
        lanternDamage = 20,
        strikeRange = 12,
        strikeDamage = 34,
        attackId = "breaker_wave",
        attackName = "BREAKER",
        instruction = "BRACE OR CLEAR THE LINE",
        shape = "lane",
        radius = nil,
        width = 12,
        length = 24,
        windup = 1.6,
        stationary = false,
        targetMode = "lantern",
        frontShield = true,
        frontalStrikeDamage = 10,
        flankStrikeDamage = 42,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
}

local ORDER = table.freeze({
    "enemy_gale_imp",
    "enemy_wreck_crawler",
    "enemy_storm_ray",
    "enemy_salt_husk",
    "enemy_rigging_snare",
    "enemy_breaker",
})
function TempestEnemies.get(enemyId: string): EnemyDefinition?
    return DEFINITIONS[enemyId]
end

function TempestEnemies.require(enemyId: string): EnemyDefinition
    local definition = DEFINITIONS[enemyId]
    assert(definition ~= nil, string.format("unknown Tempest enemy ID %q", enemyId))
    return definition
end

function TempestEnemies.order(): { string }
    return table.clone(ORDER)
end

function TempestEnemies.all(): { EnemyDefinition }
    local result: { EnemyDefinition } = {}
    for _, enemyId in ORDER do
        table.insert(result, DEFINITIONS[enemyId])
    end
    return result
end

return table.freeze(TempestEnemies)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="105">
        <Properties>
          <string name="Name">TideboundTitanEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Tidebound Titan -- chapter IV's boss, standing in the channel
    where the harbour used to be.

    Three phases, and the content catalog's non-profession solution read
    literally: climb wrecks, ground lightning, lower tide.

    - **Climb.** It is too big to reach from the water. Wrecks around the
      channel can be climbed to fighting height, and each phase asks for
      more of them because the Titan pulls the ones you used back under.
    - **Ground.** At height, the storm is the danger rather than the
      Titan: its charge has to be earthed through rods before it lands,
      which is the same lesson the Storm Ray teaches small.
    - **Lower.** Grounded, the tide gates can be worked, and a lowered
      tide is the only thing that brings the Titan's own weight against
      it. That is when it can be struck.

    The chapter's decision sits in the third verb. The gates can be
    lowered gently, over a long turn that leaves the harbour's channel
    intact, or slammed, which drops the tide at once and takes the
    channel's mouth with it. A town that wants its harbour back later
    cares which; a party in trouble tonight may not.
]]

local TideboundTitanEncounter = {}

export type Status =
    "disabled"
    | "locked"
    | "dormant"
    | "unreachable"
    | "grounding"
    | "exposed"
    | "complete"

export type State = {
    climbed: { [string]: boolean },
    grounded: { [string]: boolean },
    health: number,
    manifestHash: string,
    outcome: string?,
    participants: { [string]: boolean },
    phase: number,
    revision: number,
    runId: string,
    status: Status,
    slammedGates: number,
}

local MAX_HEALTH = 540
local PHASE_THRESHOLDS = table.freeze({ 360, 180, 0 })
local CLIMBS_REQUIRED = table.freeze({ 2, 3, 4 })
local WRECK_IDS = table.freeze({
    "wreck_collier",
    "wreck_packet",
    "wreck_trawler",
    "wreck_cutter",
})
local ROD_IDS = table.freeze({
    "rod_seaward",
    "rod_landward",
})
local GATE_IDS = table.freeze({
    gate_north = true,
    gate_south = true,
})

local TIDE_SURGE = table.freeze({
    attackId = "tidebound_titan_surge",
    attackName = "TIDE SURGE",
    damage = 28,
    instruction = "GET ABOVE THE SURGE LINE",
    length = 36,
    shape = "lane",
    width = 12,
    windup = 1.5,
})

local STORM_CROWN = table.freeze({
    attackId = "tidebound_titan_crown",
    attackName = "STORM CROWN",
    damage = 32,
    instruction = "GROUND IT — DO NOT STAND HIGHEST",
    radius = 15,
    shape = "circle",
    windup = 1.7,
})

local HARBOUR_BREAK = table.freeze({
    attackId = "tidebound_titan_break",
    attackName = "HARBOUR BREAK",
    damage = 34,
    instruction = "OFF THE STONE — IT IS TAKING THE WALL",
    radius = 17,
    shape = "circle",
    windup = 1.9,
})

TideboundTitanEncounter.Id = "boss_tidebound_titan"
TideboundTitanEncounter.MaxHealth = MAX_HEALTH
TideboundTitanEncounter.WreckIds = WRECK_IDS
TideboundTitanEncounter.RodIds = ROD_IDS
TideboundTitanEncounter.GateIds = GATE_IDS
TideboundTitanEncounter.Reward = table.freeze({
    amount = 5,
    materialId = "material_ships_iron",
})
TideboundTitanEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.6,
    exposedAttackCooldownSeconds = 3,
    groundingAttackCooldownSeconds = 4.4,
    markedStrikeDamage = 48,
    strikeDamage = 42,
    unreachableAttackCooldownSeconds = 4.8,
})

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "boss participant user ID is invalid")
    return tostring(userId)
end

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.climbed = table.clone(state.climbed)
    nextState.grounded = table.clone(state.grounded)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function countKeys(values: { [string]: boolean }): number
    local count = 0
    for _, value in values do
        if value then
            count += 1
        end
    end
    return count
end

local function isActive(status: Status): boolean
    return status == "unreachable" or status == "grounding" or status == "exposed"
end

local function climbsRequired(phase: number): number
    return CLIMBS_REQUIRED[phase] or CLIMBS_REQUIRED[#CLIMBS_REQUIRED]
end

function TideboundTitanEncounter.create(
    runId: string,
    manifestHash: string,
    enabled: boolean
): State
    assert(runId ~= "", "Tidebound Titan run ID is required")
    assert(manifestHash ~= "", "Tidebound Titan manifest hash is required")
    return {
        climbed = {},
        grounded = {},
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        outcome = nil,
        participants = {},
        phase = 1,
        revision = 0,
        runId = runId,
        slammedGates = 0,
        status = if enabled then "locked" else "disabled",
    }
end

function TideboundTitanEncounter.unlock(state: State): (State, any)
    if state.status ~= "locked" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "dormant"
    nextState.revision += 1
    return nextState, { accepted = true, reason = "unlocked" }
end

function TideboundTitanEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "unreachable"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function TideboundTitanEncounter.join(state: State, userId: number): State
    if not isActive(state.status) then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function TideboundTitanEncounter.climbWreck(
    state: State,
    userId: number,
    wreckId: any
): (State, any)
    if state.status ~= "unreachable" then
        return state, { accepted = false, reason = state.status }
    end
    local valid = false
    for _, id in WRECK_IDS do
        if id == wreckId then
            valid = true
            break
        end
    end
    if not valid then
        return state, { accepted = false, reason = "unknown_wreck" }
    end
    if state.climbed[wreckId] then
        return state, { accepted = false, reason = "already_climbed" }
    end
    local nextState = cloneState(state)
    nextState.climbed[wreckId] = true
    nextState.participants[participantKey(userId)] = true
    local climbed = countKeys(nextState.climbed)
    local required = climbsRequired(state.phase)
    local atHeight = climbed >= required
    if atHeight then
        nextState.status = "grounding"
        nextState.grounded = {}
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            atHeight = atHeight,
            climbed = climbed,
            reason = if atHeight then "at_height" else "wreck_climbed",
            remaining = math.max(0, required - climbed),
        }
end

function TideboundTitanEncounter.groundRod(state: State, userId: number, rodId: any): (State, any)
    if state.status ~= "grounding" then
        return state, { accepted = false, reason = state.status }
    end
    local valid = false
    for _, id in ROD_IDS do
        if id == rodId then
            valid = true
            break
        end
    end
    if not valid then
        return state, { accepted = false, reason = "unknown_rod" }
    end
    if state.grounded[rodId] then
        return state, { accepted = false, reason = "already_grounded" }
    end
    local nextState = cloneState(state)
    nextState.grounded[rodId] = true
    nextState.participants[participantKey(userId)] = true
    local earthed = countKeys(nextState.grounded) >= #ROD_IDS
    if earthed then
        nextState.status = "exposed"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            earthed = earthed,
            reason = if earthed then "storm_earthed" else "rod_set",
        }
end

--[[
    Work the tide gates. Gently is the long turn that leaves the channel
    whole; slamming drops the tide at once and takes the channel's mouth
    with it. Either lowers the tide -- the difference is what the town
    finds in the morning, and the chapter remembers which was chosen.
]]
function TideboundTitanEncounter.lowerTide(
    state: State,
    userId: number,
    gateId: any,
    slam: boolean
): (State, any)
    if state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end
    if type(gateId) ~= "string" or GATE_IDS[gateId] ~= true then
        return state, { accepted = false, reason = "unknown_gate" }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    if slam then
        nextState.slammedGates += 1
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = if slam then "gate_slammed" else "gate_eased",
            slammed = slam,
        }
end

function TideboundTitanEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Tidebound Titan strike amount is invalid")
    if state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local threshold = PHASE_THRESHOLDS[state.phase]
    nextState.health = math.max(threshold, state.health - amount)
    local phaseFinished = nextState.health <= threshold
    if phaseFinished then
        if state.phase >= #PHASE_THRESHOLDS then
            nextState.health = 0
            nextState.status = "complete"
            --[[
                What the harbour is afterwards, counted across the whole
                fight rather than one phase of it. Three phases offer two
                gates each, so six slams is a party that chose speed every
                time it was asked; none is a party that never did. The
                first draft called two "broken", which made a single
                hurried phase indistinguishable from a policy -- a spec
                walking one slammed phase and two eased ones caught it.
            ]]
            local slams = nextState.slammedGates
            nextState.outcome = if slams == 0
                then "navigable"
                elseif slams >= 4 then "broken"
                else "scoured"
        else
            nextState.phase += 1
            nextState.climbed = {}
            nextState.grounded = {}
            nextState.status = "unreachable"
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            outcome = nextState.outcome,
            phase = nextState.phase,
            phaseFinished = phaseFinished,
            reason = if nextState.status == "complete"
                then "completed"
                elseif phaseFinished then "next_phase"
                else "damaged",
        }
end

function TideboundTitanEncounter.attack(attackIndex: number, phase: number, status: Status?): any
    if status == "grounding" then
        return STORM_CROWN
    end
    if phase >= 3 then
        return if attackIndex % 2 == 0 then HARBOUR_BREAK else TIDE_SURGE
    elseif phase == 2 and attackIndex % 2 == 0 then
        return STORM_CROWN
    end
    return TIDE_SURGE
end

function TideboundTitanEncounter.snapshot(state: State, userId: number): any
    local climbed = countKeys(state.climbed)
    local required = climbsRequired(state.phase)
    local instruction = if state.status == "unreachable"
        then string.format("CLIMB THE WRECKS %d/%d", climbed, required)
        elseif state.status == "grounding" then "GROUND THE STORM BEFORE IT LANDS"
        elseif state.status == "exposed" then "LOWER THE TIDE — EASE THE GATES OR SLAM THEM"
        elseif state.status == "complete" then if state.outcome == "navigable"
            then "THE TITAN IS DOWN · THE CHANNEL STILL RUNS"
            elseif state.outcome == "broken" then "THE TITAN IS DOWN · THE HARBOUR MOUTH IS GONE"
            else "THE TITAN IS DOWN · THE CHANNEL IS SCOURED"
        elseif state.status == "dormant" then "ENTER THE CHANNEL"
        elseif state.status == "locked" then "CLEAR THE REACH'S ELITES TO REACH IT"
        elseif state.status == "disabled" then "TIDEBOUND TITAN TEMPORARILY DORMANT"
        else "TIDEBOUND TITAN"
    return {
        active = isActive(state.status),
        choiceAvailable = state.status == "exposed",
        climbsRequired = required,
        complete = state.status == "complete",
        displayName = "TIDEBOUND TITAN",
        enabled = state.status ~= "disabled",
        exposed = state.status == "exposed",
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        outcome = state.outcome,
        phase = state.phase,
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        slammedGates = state.slammedGates,
        status = state.status,
        wrecksClimbed = climbed,
    }
end

function TideboundTitanEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        TideboundTitanEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(TideboundTitanEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="106">
        <Properties>
          <string name="Name">ToolCatalog</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The eight tool families -- axes, hammers, lanterns (the torch), picks,
    sickles, fishing kits, climbing kits, and survey instruments -- one held
    tool per family for now, each with a bounded identity expressed through
    hooks the game already has. Combat identity flows through the strike
    context, work identity through timed-action durations, endurance
    identities through the per-player stamina and sprint paths, and the
    survey's exploration identity through the objective-marker resolver.

    Every number is a small trade rather than a power ramp: the axe hits a
    quarter harder but reaches like a hand, the torch reaches four studs
    further at a small cost, the pick and sickle each hurry only their own
    kind of harvest, and nothing here can exceed the clamps combat and
    stamina already enforce. A client never submits any of these -- the
    server reads the catalog by the tool id it stored.

    The fishing and climbing kits carry their stat identities now; their
    full mechanics (a pond catch loop, real traversal) are recorded as open
    work in the Milestone 6 runbook rather than pretended at here.
]]

local ToolCatalog = {}

export type Definition = {
    id: string,
    family: string,
    displayName: string,
    description: string,
    strikeDamageMultiplier: number?,
    strikeRangeBonus: number?,
    actionDurationMultiplier: number?,
    gatherDurationMultiplier: number?,
    gatherMaterials: { [string]: boolean }?,
    staminaRegenMultiplier: number?,
    sprintSpeedMultiplier: number?,
    surveyRevealsNodes: boolean?,
}

local ORDER = table.freeze({
    "axe",
    "hammer",
    "torch",
    "pick",
    "sickle",
    "fishing_kit",
    "climbing_kit",
    "survey_kit",
})

local DEFINITIONS: { [string]: Definition } = {
    axe = table.freeze({
        id = "axe",
        family = "axe",
        displayName = "HAND AXE",
        description = "Strikes land a quarter harder.",
        strikeDamageMultiplier = 1.25,
    }),
    hammer = table.freeze({
        id = "hammer",
        family = "hammer",
        displayName = "BUILDER'S HAMMER",
        description = "Gather and build work runs a quarter faster.",
        actionDurationMultiplier = 0.75,
    }),
    torch = table.freeze({
        id = "torch",
        family = "lantern",
        displayName = "HAND TORCH",
        description = "Swung fire reaches four studs further at a small cost.",
        strikeDamageMultiplier = 0.9,
        strikeRangeBonus = 4,
    }),
    pick = table.freeze({
        id = "pick",
        family = "pick",
        displayName = "IRONROOT PICK",
        description = "Sap and clay come loose a quarter faster; a heavy point.",
        strikeDamageMultiplier = 1.05,
        gatherDurationMultiplier = 0.75,
        gatherMaterials = table.freeze({
            material_amber_sap = true,
            material_spring_clay = true,
        }),
    }),
    sickle = table.freeze({
        id = "sickle",
        family = "sickle",
        displayName = "MEADOW SICKLE",
        description = "Fiber and brightcap fall a quarter faster; a sweeping arc.",
        strikeRangeBonus = 2,
        gatherDurationMultiplier = 0.75,
        gatherMaterials = table.freeze({
            material_meadow_fiber = true,
            material_brightcap = true,
        }),
    }),
    fishing_kit = table.freeze({
        id = "fishing_kit",
        family = "fishing_kit",
        displayName = "FISHING KIT",
        description = "An angler's patience: stamina returns 10% faster.",
        staminaRegenMultiplier = 1.1,
    }),
    climbing_kit = table.freeze({
        id = "climbing_kit",
        family = "climbing_kit",
        displayName = "CLIMBING KIT",
        description = "Sure-footed: running carries you 8% faster.",
        sprintSpeedMultiplier = 1.08,
    }),
    survey_kit = table.freeze({
        id = "survey_kit",
        family = "survey_kit",
        displayName = "SURVEY GLASS",
        description = "Marks the nearest unharvested node on your trail.",
        surveyRevealsNodes = true,
    }),
}

function ToolCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function ToolCatalog.get(id: any): Definition?
    return if type(id) == "string" then DEFINITIONS[id] else nil
end

function ToolCatalog.list(): { Definition }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

return table.freeze(ToolCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="107">
        <Properties>
          <string name="Name">TownCondition</string>
          <string name="Source"><![CDATA[--!strict

local TownProgression = require("./TownProgression")

--[[
    How badly each building came through the night, and what repairing one
    does.

    Until build `0.49.0` this was a single town-wide integrity number and a
    derived 0-3 "damage level" that decided how many of three hardcoded repair
    piles appeared. That model had a specific tell that it was the wrong shape:
    repairing the inn's storm frame could make the archive's roof brace vanish,
    because no repair belonged to a building -- every repair added twenty to one
    shared number, and which sites were visible was purely a function of that
    number. A player could not damage one building, and could not fix one
    either.

    Now every building carries its own integrity, is damaged on its own, and is
    repaired on its own. The state shape deliberately mirrors TownConstruction's
    -- a `{ [buildingId]: number }` map normalized against
    `TownProgression.buildingIds()` -- because the two describe the same set of
    objects from two directions (how far built, how badly damaged) and there is
    no reason for them to be read differently.

    Three properties are worth stating because they are what makes the
    per-building model behave in a shared town:

      * **Which buildings take damage is chosen by night number alone.** The
        same rule TownNightIncident already uses, for the same reason: a replay
        is deterministic and a player who reconnects cannot reroll a gentler
        night.
      * **A building is never destroyed.** Damage floors at
        MIN_BUILDING_INTEGRITY, so a bad night creates work rather than deleting
        a building, its services, or the paths around it.
      * **Merging prefers the newest night, then the better-repaired building --
        per building.** Two players who repaired different buildings on the same
        day both keep their work, which the old single-number merge could not
        express: it had to pick one player's whole town over the other's.
]]

local TownCondition = {}

export type State = {
    buildings: { [string]: number },
    lastNightNumber: number,
    lastDamage: number,
    repairsCompleted: number,
}

local MIN_BUILDING_INTEGRITY = 25
local FULL_INTEGRITY = 100
local REPAIR_AMOUNT = 20
-- What one struck building loses. Chosen so a single hit leaves an obviously
-- damaged building that four repairs restore, rather than a scratch nobody
-- would cross the square to fix.
local DAMAGE_PER_BUILDING = 35

local function validNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function isValidBuildingId(buildingId: any): boolean
    if type(buildingId) ~= "string" then
        return false
    end
    for _, id in TownProgression.buildingIds() do
        if id == buildingId then
            return true
        end
    end
    return false
end

local function clampIntegrity(value: any): number
    return math.clamp(
        math.floor(tonumber(value) or FULL_INTEGRITY),
        MIN_BUILDING_INTEGRITY,
        FULL_INTEGRITY
    )
end

-- How many buildings a night of this severity strikes. The thresholds are the
-- ones the single-number model already used to pick a damage amount, kept so
-- that how hard a night felt does not change with this rewrite -- only where
-- the damage lands.
local function struckCount(lanternHealth: number): number
    if lanternHealth >= 90 then
        return 0
    elseif lanternHealth >= 70 then
        return 1
    elseif lanternHealth >= 45 then
        return 2
    end
    return 3
end

function TownCondition.default(): State
    return {
        buildings = {},
        lastNightNumber = 0,
        lastDamage = 0,
        repairsCompleted = 0,
    }
end

--[[
    An absent building is a whole one.

    Storing only damaged buildings keeps the saved map small and, more usefully,
    means a building added to the roster later starts undamaged everywhere
    without a migration touching every profile.
]]
function TownCondition.integrityFor(state: any, buildingId: any): number
    if type(state) ~= "table" or type(state.buildings) ~= "table" then
        return FULL_INTEGRITY
    end
    if not isValidBuildingId(buildingId) then
        return FULL_INTEGRITY
    end
    local stored = state.buildings[buildingId]
    if not validNumber(stored) then
        return FULL_INTEGRITY
    end
    return clampIntegrity(stored)
end

function TownCondition.normalize(value: any): State
    local result = TownCondition.default()
    if type(value) ~= "table" then
        return result
    end

    if type(value.buildings) == "table" then
        for buildingId, integrity in value.buildings do
            if isValidBuildingId(buildingId) and validNumber(integrity) then
                local clamped = clampIntegrity(integrity)
                if clamped < FULL_INTEGRITY then
                    result.buildings[buildingId] = clamped
                end
            end
        end
    elseif validNumber(value.integrity) then
        -- A schema-12 profile: one town-wide integrity, no per-building map.
        -- Every building inherits the town's number, which preserves how
        -- damaged the town was and how much repair work is outstanding. It
        -- cannot recover *which* buildings were hit, because the old model
        -- never recorded that.
        local shared = clampIntegrity(value.integrity)
        if shared < FULL_INTEGRITY then
            for _, buildingId in TownProgression.buildingIds() do
                result.buildings[buildingId] = shared
            end
        end
    end

    if validNumber(value.lastNightNumber) and value.lastNightNumber >= 0 then
        result.lastNightNumber = math.clamp(math.floor(value.lastNightNumber), 0, 1_000_000)
    end
    if validNumber(value.lastDamage) then
        result.lastDamage = math.clamp(math.floor(value.lastDamage), 0, 999)
    end
    if validNumber(value.repairsCompleted) and value.repairsCompleted >= 0 then
        result.repairsCompleted = math.floor(value.repairsCompleted)
    end
    return result
end

--[[
    Which buildings this night strikes.

    `damageable` is the set of buildings that physically exist to be broken --
    the caller's business, because whether a building is a finished structure or
    still a construction site lives in TownConstruction, not here. Selection
    walks forward from an offset derived from the night number, wrapping, so the
    same night always strikes the same buildings no matter who is connected or
    how many times the server restarts.
]]
function TownCondition.struckBuildings(
    damageable: { string },
    lanternHealth: number,
    nightNumber: number
): { string }
    if type(damageable) ~= "table" or #damageable == 0 then
        return {}
    end
    local ordered = table.clone(damageable)
    table.sort(ordered)

    local count = math.min(struckCount(math.clamp(lanternHealth, 0, 100)), #ordered)
    if count <= 0 then
        return {}
    end

    local struck = {}
    local offset = (math.floor(nightNumber) - 1) % #ordered
    for step = 0, count - 1 do
        table.insert(struck, ordered[((offset + step) % #ordered) + 1])
    end
    return struck
end

function TownCondition.afterNight(
    state: State,
    endingLanternHealth: number,
    nightNumber: number,
    damageable: { string }?
): (State, any)
    local current = TownCondition.normalize(state)
    if
        not validNumber(endingLanternHealth)
        or not validNumber(nightNumber)
        or nightNumber < 1
        or nightNumber ~= math.floor(nightNumber)
    then
        return current, { applied = false, reason = "invalid_night_result" }
    end
    if nightNumber <= current.lastNightNumber then
        return current, { applied = false, reason = "night_already_recorded" }
    end

    -- `nil` means no roster was supplied, so every known building counts. An
    -- explicit table means exactly that set -- including an empty one, which
    -- says nothing is standing to be damaged. Those two must not collapse into
    -- each other: a tier-zero town is entirely construction sites, so the world
    -- legitimately reports an empty roster on a new save's first night, and
    -- treating that as "damage everything" would wreck sixteen buildings nobody
    -- has built yet.
    local roster: { string } = if damageable == nil
        then TownProgression.buildingIds()
        else damageable

    local lanternHealth = math.clamp(endingLanternHealth, 0, 100)
    local struck = TownCondition.struckBuildings(roster, lanternHealth, nightNumber)

    local nextState = TownCondition.normalize(current)
    local applied = 0
    local damagedIds = {}
    for _, buildingId in struck do
        local before = TownCondition.integrityFor(nextState, buildingId)
        local after = math.max(MIN_BUILDING_INTEGRITY, before - DAMAGE_PER_BUILDING)
        if after < FULL_INTEGRITY then
            nextState.buildings[buildingId] = after
        end
        applied += before - after
        table.insert(damagedIds, buildingId)
    end

    nextState.lastNightNumber = math.floor(nightNumber)
    nextState.lastDamage = applied
    return nextState,
        {
            applied = true,
            damage = applied,
            struck = damagedIds,
            damageLevel = #damagedIds,
            integrity = TownCondition.averageIntegrity(nextState, roster),
            reason = if applied > 0 then "night_damage" else "clean_defense",
        }
end

--[[
    Repair one building.

    Deliberately narrow: a repair names its building and moves nothing else. The
    old model could not express this -- every repair added to one shared number,
    so fixing the inn could visibly un-damage the archive.
]]
function TownCondition.repair(state: State, buildingId: any): (State, any)
    local current = TownCondition.normalize(state)
    if not isValidBuildingId(buildingId) then
        return current, { applied = false, reason = "unknown_building" }
    end

    local before = TownCondition.integrityFor(current, buildingId)
    if before >= FULL_INTEGRITY then
        return current,
            { applied = false, reason = "building_already_repaired", buildingId = buildingId }
    end

    local nextState = TownCondition.normalize(current)
    local after = math.min(FULL_INTEGRITY, before + REPAIR_AMOUNT)
    if after >= FULL_INTEGRITY then
        nextState.buildings[buildingId] = nil
    else
        nextState.buildings[buildingId] = after
    end
    nextState.repairsCompleted += 1

    return nextState,
        {
            applied = true,
            buildingId = buildingId,
            restored = after - before,
            buildingIntegrity = after,
            integrity = TownCondition.averageIntegrity(nextState, nil),
            reason = "building_repaired",
        }
end

-- The town's overall health, kept because analytics, the HUD, and the existing
-- world attributes all speak in one number. It is derived from the buildings
-- rather than stored, so it can never disagree with them.
function TownCondition.averageIntegrity(state: any, roster: { string }?): number
    -- Same roster rule as afterNight: nil is "every known building", an
    -- explicit table is exactly that set, and an empty one means nothing stands
    -- to be damaged -- which averages to a whole town, not a broken one.
    local ids: { string } = if roster == nil then TownProgression.buildingIds() else roster
    if #ids == 0 then
        return FULL_INTEGRITY
    end
    local total = 0
    for _, buildingId in ids do
        total += TownCondition.integrityFor(state, buildingId)
    end
    return math.floor(total / #ids)
end

--[[
    Prefer the newest defended night; within the same night, prefer the
    better-repaired copy of each building.

    Per building rather than wholesale, which is the behaviour the old
    single-number merge could not express: two players who repaired different
    buildings on the same day would previously have had one player's entire town
    chosen over the other's, silently discarding half the work.
]]
function TownCondition.merge(current: any, incoming: any): State
    local left = TownCondition.normalize(current)
    local right = TownCondition.normalize(incoming)

    if right.lastNightNumber > left.lastNightNumber then
        return right
    elseif left.lastNightNumber > right.lastNightNumber then
        return left
    end

    local merged = TownCondition.default()
    merged.lastNightNumber = left.lastNightNumber
    merged.lastDamage = math.min(left.lastDamage, right.lastDamage)
    merged.repairsCompleted = math.max(left.repairsCompleted, right.repairsCompleted)

    for _, buildingId in TownProgression.buildingIds() do
        local best = math.max(
            TownCondition.integrityFor(left, buildingId),
            TownCondition.integrityFor(right, buildingId)
        )
        if best < FULL_INTEGRITY then
            merged.buildings[buildingId] = best
        end
    end
    return merged
end

--[[
    What the world and the HUD read.

    `roster` is the set of buildings that physically stand. Damaged buildings
    outside it are omitted rather than reported, because a migrated schema-12
    profile marks *every* building damaged -- including ones this town has only
    ever had as construction sites -- and presenting repair work for a building
    nobody has built would put a repair prompt on an empty lot.
]]
function TownCondition.snapshot(state: State, roster: { string }?): any
    local current = TownCondition.normalize(state)
    local standing: { [string]: boolean }? = nil
    if roster ~= nil then
        standing = {}
        for _, buildingId in roster do
            (standing :: { [string]: boolean })[buildingId] = true
        end
    end

    local damaged = {}
    local repairsRemaining = 0
    for _, buildingId in TownProgression.buildingIds() do
        if standing ~= nil and standing[buildingId] ~= true then
            continue
        end
        local integrity = TownCondition.integrityFor(current, buildingId)
        if integrity < FULL_INTEGRITY then
            table.insert(damaged, { buildingId = buildingId, integrity = integrity })
            repairsRemaining += math.ceil((FULL_INTEGRITY - integrity) / REPAIR_AMOUNT)
        end
    end
    table.sort(damaged, function(a, b)
        return a.buildingId < b.buildingId
    end)

    return {
        integrity = TownCondition.averageIntegrity(current, roster),
        damageLevel = #damaged,
        damagedBuildings = damaged,
        lastNightNumber = current.lastNightNumber,
        lastDamage = current.lastDamage,
        repairsCompleted = current.repairsCompleted,
        repairsRemaining = repairsRemaining,
    }
end

TownCondition.MinimumIntegrity = MIN_BUILDING_INTEGRITY
TownCondition.RepairAmount = REPAIR_AMOUNT
TownCondition.DamagePerBuilding = DAMAGE_PER_BUILDING

return table.freeze(TownCondition)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="108">
        <Properties>
          <string name="Name">TownConstruction</string>
          <string name="Source"><![CDATA[--!strict

local TownProgression = require("./TownProgression")
local TownConstructionCatalog = require("./TownConstructionCatalog")

-- The player-funded half of a building's stage. TownProgression still owns
-- the ceiling nights and chapter-one grant a building -- how far it is
-- *allowed* to go -- while this module owns how far it has actually been
-- *built*, paid for out of the same material wallet Crafting spends. A
-- building's rendered stage is always the lesser of the two: nights alone
-- no longer finish a building by themselves, but they never let payment
-- outrun what the story has earned either.
local TownConstruction = {}

local MAX_STAGE = TownConstructionCatalog.maxStage()

local function isValidBuildingId(buildingId: any): boolean
    if type(buildingId) ~= "string" then
        return false
    end
    for _, id in TownProgression.buildingIds() do
        if id == buildingId then
            return true
        end
    end
    return false
end

local function clampStage(value: any): number
    return math.clamp(math.floor(tonumber(value) or 0), 0, MAX_STAGE)
end

function TownConstruction.default(): { [string]: number }
    return {}
end

function TownConstruction.normalize(value: any): { [string]: number }
    local normalized: { [string]: number } = {}
    if type(value) ~= "table" then
        return normalized
    end
    for buildingId, stage in value do
        if isValidBuildingId(buildingId) and type(stage) == "number" then
            normalized[buildingId] = clampStage(stage)
        end
    end
    return normalized
end

function TownConstruction.stageFor(construction: any, buildingId: any): number
    if type(construction) ~= "table" or not isValidBuildingId(buildingId) then
        return 0
    end
    return clampStage(construction[buildingId])
end

-- The cost to advance from `currentStage` to `currentStage + 1`, or nil if
-- `currentStage` is already maxed (or not a real stage at all).
function TownConstruction.costFor(currentStage: number): { [string]: number }?
    if type(currentStage) ~= "number" then
        return nil
    end
    local floored = math.floor(currentStage)
    if floored ~= currentStage or floored < 0 or floored >= MAX_STAGE then
        return nil
    end
    return TownConstructionCatalog.costToReach(floored + 1)
end

-- Spends materials to advance one building exactly one stage, or leaves
-- every input untouched and reports why. Refusal order matters: a building
-- already at stage three is "already_maxed" even when the tier ceiling also
-- reads three, because there being nothing left to build is the more
-- accurate reason than the tier not being the blocker. Mirrors
-- Crafting.craft's shape and its own "insufficient_materials" reason string
-- exactly, since both spend the same wallet.
--
-- `_now` is accepted rather than dropped so a caller can pass the same
-- timestamp it already carries for revision bookkeeping without a special
-- case; nothing here is timestamped today, so it goes unused.
function TownConstruction.contribute(
    materials: { [string]: number },
    construction: { [string]: number },
    buildingId: any,
    ceilingStage: number,
    _now: number
): ({ [string]: number }, { [string]: number }, any)
    if not isValidBuildingId(buildingId) then
        return materials,
            construction,
            {
                applied = false,
                reason = "unknown_building",
            }
    end

    local currentStage = TownConstruction.stageFor(construction, buildingId)
    if currentStage >= MAX_STAGE then
        return materials,
            construction,
            {
                applied = false,
                buildingId = buildingId,
                reason = "already_maxed",
            }
    end

    local ceiling = clampStage(ceilingStage)
    if currentStage >= ceiling then
        return materials,
            construction,
            {
                applied = false,
                buildingId = buildingId,
                reason = "tier_not_ready",
            }
    end

    local cost = TownConstruction.costFor(currentStage)
    if cost == nil then
        return materials,
            construction,
            {
                applied = false,
                buildingId = buildingId,
                reason = "already_maxed",
            }
    end

    for materialId, amount in cost do
        if (materials[materialId] or 0) < amount then
            return materials,
                construction,
                {
                    applied = false,
                    buildingId = buildingId,
                    reason = "insufficient_materials",
                }
        end
    end

    local nextMaterials = table.clone(materials)
    for materialId, amount in cost do
        nextMaterials[materialId] = nextMaterials[materialId] - amount
    end

    local nextConstruction = table.clone(construction)
    local nextStage = currentStage + 1
    nextConstruction[buildingId] = nextStage

    return nextMaterials,
        nextConstruction,
        {
            applied = true,
            buildingId = buildingId,
            stage = nextStage,
        }
end

-- Reconciles two accumulators for the same shared town, the same
-- never-regress rule TownProgression.merge uses for the tier ceiling: every
-- building keeps the higher of the two stages, and unknown or malformed
-- input on either side normalizes down to nothing rather than erroring.
function TownConstruction.merge(current: any, incoming: any): { [string]: number }
    local normalizedCurrent = TownConstruction.normalize(current)
    local normalizedIncoming = TownConstruction.normalize(incoming)
    local merged: { [string]: number } = {}
    for _, buildingId in TownProgression.buildingIds() do
        merged[buildingId] =
            math.max(normalizedCurrent[buildingId] or 0, normalizedIncoming[buildingId] or 0)
    end
    return merged
end

return table.freeze(TownConstruction)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="109">
        <Properties>
          <string name="Name">TownConstructionCatalog</string>
          <string name="Source"><![CDATA[--!strict

-- Cost to advance a building one construction stage, table-driven by the
-- stage being reached rather than sixteen bespoke curves. TownProgression's
-- own doc comment already made this call for the eleven later buildings --
-- "eleven more bespoke expressions would be eleven more things to get
-- subtly wrong" -- and a per-building cost curve would multiply that same
-- risk by sixteen for no gameplay benefit anyone asked for: every building
-- becoming buildable at the same rate is the point, not a limitation.
--
-- Costs escalate with the stage reached, not the building, and lean on the
-- same four materials Crafting already spends (CraftingCatalog recipes run
-- 2-5 units per material). A construction stage is a town-wide, permanent
-- upgrade rather than one personal accessory, so it is priced well above a
-- single recipe: stage one is roughly double the heaviest existing recipe,
-- and stage three introduces brightcap only at the top so the last stretch
-- of any building still wants a supply run across all three gathered
-- materials rather than a single stockpile.
local TownConstructionCatalog = {}

export type StageCost = { [string]: number }

local MAX_STAGE = 3

local COSTS: { [number]: StageCost } = {
    [1] = table.freeze({
        material_heartwood = 8,
    }),
    [2] = table.freeze({
        material_heartwood = 8,
        material_amber_sap = 6,
    }),
    [3] = table.freeze({
        material_heartwood = 12,
        material_amber_sap = 10,
        material_brightcap = 4,
    }),
}

-- The material cost to reach `stage` (1-3) from `stage - 1`. Nil for stage
-- zero (nothing to reach; a construction site is the starting state, not a
-- purchase) and for anything past three (already fully built).
function TownConstructionCatalog.costToReach(stage: number): StageCost?
    if type(stage) ~= "number" then
        return nil
    end
    local floored = math.floor(stage)
    if floored ~= stage or floored < 1 or floored > MAX_STAGE then
        return nil
    end
    return COSTS[floored]
end

function TownConstructionCatalog.maxStage(): number
    return MAX_STAGE
end

return table.freeze(TownConstructionCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="110">
        <Properties>
          <string name="Name">TownDecorations</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Town decorations: authored slots, material costs, and a tier cap.

    Milestone 4's "decoration caps" deliverable, built the same shape as
    construction: the player spends the material wallet to make the town
    theirs, the tier decides how much of that the town can hold, and every
    rule lives here pure so the spec can pin it. Slots are authored — a
    banner goes where a banner pole stands — because free placement is a
    griefing surface and a streaming problem this game does not need.

    Decorations are identity, never power: no slot changes a stat anywhere.
]]

local TownDecorations = {}

export type Slot = {
    id: string,
    displayName: string,
    kind: string,
    cost: { [string]: number },
}

export type State = { [string]: boolean }

local SLOTS: { Slot } = table.freeze({
    table.freeze({
        id = "decor_plaza_banner_east",
        displayName = "EAST PLAZA BANNER",
        kind = "banner",
        cost = table.freeze({ material_meadow_fiber = 3, material_heartwood = 1 }) :: { [string]: number },
    }),
    table.freeze({
        id = "decor_plaza_banner_west",
        displayName = "WEST PLAZA BANNER",
        kind = "banner",
        cost = table.freeze({ material_meadow_fiber = 3, material_heartwood = 1 }) :: { [string]: number },
    }),
    table.freeze({
        id = "decor_road_garland_north",
        displayName = "NORTH ROAD GARLAND",
        kind = "garland",
        cost = table.freeze({ material_meadow_fiber = 2, material_brightcap = 1 }) :: { [string]: number },
    }),
    table.freeze({
        id = "decor_road_garland_south",
        displayName = "SOUTH ROAD GARLAND",
        kind = "garland",
        cost = table.freeze({ material_meadow_fiber = 2, material_brightcap = 1 }) :: { [string]: number },
    }),
    table.freeze({
        id = "decor_planter_gate",
        displayName = "GATE PLANTER",
        kind = "planter",
        cost = table.freeze({ material_heartwood = 2, material_amber_sap = 1 }) :: { [string]: number },
    }),
    table.freeze({
        id = "decor_planter_archive",
        displayName = "ARCHIVE PLANTER",
        kind = "planter",
        cost = table.freeze({ material_heartwood = 2, material_amber_sap = 1 }) :: { [string]: number },
    }),
    table.freeze({
        id = "decor_planter_inn",
        displayName = "INN PLANTER",
        kind = "planter",
        cost = table.freeze({ material_heartwood = 2, material_amber_sap = 1 }) :: { [string]: number },
    }),
    table.freeze({
        id = "decor_planter_workshop",
        displayName = "WORKSHOP PLANTER",
        kind = "planter",
        cost = table.freeze({ material_heartwood = 2, material_amber_sap = 1 }) :: { [string]: number },
    }),
})

local SLOTS_BY_ID: { [string]: Slot } = {}
for _, slot in SLOTS do
    SLOTS_BY_ID[slot.id] = slot
end
table.freeze(SLOTS_BY_ID)

TownDecorations.Slots = SLOTS

function TownDecorations.slot(id: string): Slot?
    return SLOTS_BY_ID[id]
end

--[[
    How many decorations the town can carry at a tier. Grows with the town
    like storage does, and tops out below the slot count on purpose: a maxed
    town still chooses which corners it dresses.
]]
function TownDecorations.capForTier(tier: number): number
    return 2 + math.clamp(math.floor(tonumber(tier) or 0), 0, 3) * 2
end

function TownDecorations.default(): State
    return {}
end

function TownDecorations.normalize(value: any): State
    local state: State = {}
    if type(value) ~= "table" then
        return state
    end
    for id, placed in value do
        if SLOTS_BY_ID[id] ~= nil and placed == true then
            state[id] = true
        end
    end
    return state
end

function TownDecorations.count(state: State): number
    local total = 0
    for _ in state do
        total += 1
    end
    return total
end

--[[
    Place a decoration. Same contract as construction's contribute: wallet
    and state in, wallet and state out, with a reason a toast can speak. The
    caller charges nothing on refusal because nothing here mutates.
]]
function TownDecorations.place(
    materials: { [string]: number },
    state: State,
    decorationId: any,
    tier: number
): ({ [string]: number }, State, any)
    local slot = if type(decorationId) == "string" then SLOTS_BY_ID[decorationId] else nil
    if slot == nil then
        return materials, state, { applied = false, reason = "unknown_decoration" }
    end
    if state[slot.id] == true then
        return materials, state, { applied = false, reason = "already_placed" }
    end
    if TownDecorations.count(state) >= TownDecorations.capForTier(tier) then
        return materials, state, { applied = false, reason = "decoration_cap" }
    end
    for materialId, amount in slot.cost do
        if (materials[materialId] or 0) < amount then
            return materials, state, { applied = false, reason = "insufficient_materials" }
        end
    end

    local nextMaterials = table.clone(materials)
    for materialId, amount in slot.cost do
        nextMaterials[materialId] = nextMaterials[materialId] - amount
    end
    local nextState = table.clone(state)
    nextState[slot.id] = true
    return nextMaterials, nextState, { applied = true, decorationId = slot.id }
end

-- Shared towns keep every decoration either player paid for.
function TownDecorations.merge(current: any, incoming: any): State
    local merged = TownDecorations.normalize(current)
    for id in TownDecorations.normalize(incoming) do
        merged[id] = true
    end
    return merged
end

return table.freeze(TownDecorations)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="111">
        <Properties>
          <string name="Name">TownGuardLastStand</string>
          <string name="Source"><![CDATA[--!strict

local TownGuardLastStand = {}

export type State = {
    usedNight: number,
}

local LANTERN_COST = 12
local MINIMUM_LANTERN_HEALTH = 30
local RECOVERY_HEALTH = 50
local RECOVERY_WARD_SECONDS = 5

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function TownGuardLastStand.default(): State
    return { usedNight = 0 }
end

function TownGuardLastStand.normalize(value: any): State
    if type(value) ~= "table" or not finite(value.usedNight) or value.usedNight < 0 then
        return TownGuardLastStand.default()
    end
    return { usedNight = math.floor(value.usedNight) }
end

function TownGuardLastStand.attempt(state: State, context: any): (State, any)
    local current = TownGuardLastStand.normalize(state)
    if type(context) ~= "table" then
        return current, { accepted = false, reason = "invalid_context" }
    end
    local nightNumber = context.nightNumber
    local lanternHealth = context.lanternHealth
    local eligiblePlayers = context.eligiblePlayers
    local downedPlayers = context.downedPlayers
    if
        not finite(nightNumber)
        or nightNumber < 1
        or nightNumber ~= math.floor(nightNumber)
        or not finite(lanternHealth)
        or not finite(eligiblePlayers)
        or not finite(downedPlayers)
        or eligiblePlayers < 0
        or downedPlayers < 0
        or eligiblePlayers ~= math.floor(eligiblePlayers)
        or downedPlayers ~= math.floor(downedPlayers)
    then
        return current, { accepted = false, reason = "invalid_context" }
    end
    if context.phase ~= "night" then
        return current, { accepted = false, reason = "night_inactive" }
    end
    if eligiblePlayers < 1 then
        return current, { accepted = false, reason = "party_empty" }
    end
    if downedPlayers ~= eligiblePlayers then
        return current, { accepted = false, reason = "party_still_active" }
    end
    if current.usedNight == nightNumber then
        return current, { accepted = false, reason = "last_stand_spent" }
    end
    if lanternHealth < MINIMUM_LANTERN_HEALTH then
        return current, { accepted = false, reason = "lantern_too_weak" }
    end

    local nextState = { usedNight = nightNumber }
    return nextState,
        {
            accepted = true,
            lanternCost = LANTERN_COST,
            nightNumber = nightNumber,
            partySize = eligiblePlayers,
            reason = "guard_recovery",
            recoveryHealth = RECOVERY_HEALTH,
            recoveryWardSeconds = RECOVERY_WARD_SECONDS,
        }
end

TownGuardLastStand.LanternCost = LANTERN_COST
TownGuardLastStand.MinimumLanternHealth = MINIMUM_LANTERN_HEALTH
TownGuardLastStand.RecoveryHealth = RECOVERY_HEALTH
TownGuardLastStand.RecoveryWardSeconds = RECOVERY_WARD_SECONDS

return table.freeze(TownGuardLastStand)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="112">
        <Properties>
          <string name="Name">TownNightIncident</string>
          <string name="Source"><![CDATA[--!strict

local TownNightIncident = {}

local SITE_IDS = table.freeze({ "archive", "workshop", "inn" })

local DEFINITIONS = table.freeze({
    EMBERFALL = table.freeze({
        table.freeze({
            id = "incident_emberfall_cinders",
            title = "ROOFTOP CINDERS",
            instruction = "SMOTHER THREE CINDER NESTS BEFORE THEY CATCH",
            actionText = "SMOTHER",
            objectText = "Cinder Nest",
            duration = 42,
            lanternPenalty = 12,
            sites = SITE_IDS,
        }),
        table.freeze({
            id = "incident_emberfall_flues",
            title = "SPARKING FLUES",
            instruction = "CAP THREE SPARKING FLUES BEFORE THE ROOFS IGNITE",
            actionText = "CAP",
            objectText = "Sparking Flue",
            duration = 42,
            lanternPenalty = 12,
            sites = SITE_IDS,
        }),
    }),
    MIRETIDE = table.freeze({
        table.freeze({
            id = "incident_miretide_clogs",
            title = "CHOKED DRAINS",
            instruction = "PULL THREE ROOT CLOGS BEFORE THE SQUARE FLOODS",
            actionText = "CLEAR",
            objectText = "Root Clog",
            duration = 42,
            lanternPenalty = 12,
            sites = SITE_IDS,
        }),
        table.freeze({
            id = "incident_miretide_seeps",
            title = "MIRE SEEPS",
            instruction = "SEAL THREE MIRE SEEPS BEFORE THE FOUNDATIONS SINK",
            actionText = "SEAL",
            objectText = "Mire Seep",
            duration = 42,
            lanternPenalty = 12,
            sites = SITE_IDS,
        }),
    }),
    ROOTMOON = table.freeze({
        table.freeze({
            id = "incident_rootmoon_anchors",
            title = "ROOT ANCHORS",
            instruction = "SEVER THREE ANCHORS FEEDING THE NIGHT ASSAULT",
            actionText = "SEVER",
            objectText = "Root Anchor",
            duration = 42,
            lanternPenalty = 12,
            sites = SITE_IDS,
        }),
        table.freeze({
            id = "incident_rootmoon_snares",
            title = "SNARE PODS",
            instruction = "BREAK THREE SNARE PODS BEFORE THEY BLOOM",
            actionText = "BREAK",
            objectText = "Snare Pod",
            duration = 42,
            lanternPenalty = 12,
            sites = SITE_IDS,
        }),
    }),
    ["ASHEN VEIL"] = table.freeze({
        table.freeze({
            id = "incident_ashen_watchfires",
            title = "DARK WATCHFIRES",
            instruction = "RELIGHT THREE WATCHFIRES BEFORE THE VEIL CLOSES",
            actionText = "RELIGHT",
            objectText = "Watchfire",
            duration = 42,
            lanternPenalty = 12,
            sites = SITE_IDS,
        }),
        table.freeze({
            id = "incident_ashen_bells",
            title = "SILENCED BELLS",
            instruction = "RING THREE WARD BELLS BEFORE THE VEIL SETTLES",
            actionText = "RING",
            objectText = "Ward Bell",
            duration = 42,
            lanternPenalty = 12,
            sites = SITE_IDS,
        }),
    }),
})

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function TownNightIncident.forTheme(theme: any, nightNumber: number?): any
    local variants = if type(theme) == "string" then DEFINITIONS[theme] else nil
    if variants == nil then
        return nil
    end
    local cycle = if type(nightNumber) == "number" and nightNumber >= 1
        then math.floor((nightNumber - 1) / 4)
        else 0
    return variants[cycle % #variants + 1]
end

function TownNightIncident.create(theme: string, nightNumber: number, now: number): any
    assert(nightNumber >= 1 and nightNumber == math.floor(nightNumber), "night number is invalid")
    local definition = TownNightIncident.forTheme(theme, nightNumber)
    assert(definition ~= nil, "town-night incident theme is unknown")
    assert(finite(now), "incident start time is invalid")
    return {
        definition = definition,
        endsAt = now + definition.duration,
        nightNumber = nightNumber,
        resolved = {},
        resolvedCount = 0,
        startedAt = now,
        status = "active",
    }
end

local function knownSite(definition: any, siteId: any): boolean
    if type(siteId) ~= "string" then
        return false
    end
    for _, known in definition.sites do
        if known == siteId then
            return true
        end
    end
    return false
end

function TownNightIncident.interact(state: any, siteId: any, now: number): (any, any)
    assert(finite(now), "incident interaction time is invalid")
    if state.status ~= "active" then
        return state, { accepted = false, reason = "incident_inactive" }
    end
    if now >= state.endsAt then
        local expired: any = table.clone(state)
        expired.status = "failed"
        return expired, { accepted = false, reason = "incident_expired" }
    end
    if not knownSite(state.definition, siteId) then
        return state, { accepted = false, reason = "unknown_site" }
    end
    if state.resolved[siteId] == true then
        return state, { accepted = false, reason = "site_resolved" }
    end

    local nextState: any = table.clone(state)
    nextState.resolved = table.clone(state.resolved)
    nextState.resolved[siteId] = true
    nextState.resolvedCount += 1
    local completed = nextState.resolvedCount >= #state.definition.sites
    nextState.status = if completed then "complete" else "active"
    return nextState,
        {
            accepted = true,
            completed = completed,
            remaining = math.max(0, #state.definition.sites - nextState.resolvedCount),
            siteId = siteId,
        }
end

function TownNightIncident.expire(state: any, now: number): (any, any)
    assert(finite(now), "incident expiry time is invalid")
    if state.status ~= "active" then
        return state, { applied = false, reason = "incident_inactive" }
    end
    if now < state.endsAt then
        return state, { applied = false, reason = "incident_active" }
    end
    local nextState: any = table.clone(state)
    nextState.status = "failed"
    return nextState,
        {
            applied = true,
            lanternPenalty = state.definition.lanternPenalty,
            unresolved = #state.definition.sites - state.resolvedCount,
        }
end

function TownNightIncident.snapshot(state: any?): any
    if state == nil then
        return nil
    end
    return {
        endsAt = state.endsAt,
        id = state.definition.id,
        instruction = state.definition.instruction,
        resolved = state.resolvedCount,
        required = #state.definition.sites,
        status = state.status,
        title = state.definition.title,
    }
end

return table.freeze(TownNightIncident)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="113">
        <Properties>
          <string name="Name">TownNightSchedule</string>
          <string name="Source"><![CDATA[--!strict

local TownNightSchedule = {}

export type Beat = {
    at: number,
    kind: "spawn" | "warning" | "breach" | "incident",
    enemyId: string?,
    incidentId: string?,
    theme: string?,
    wave: number?,
}

-- The same six-enemy Bramblewake roster the authored first night uses. Normal
-- nights reuse it rather than adding new content: escalating pressure comes
-- from wave count, not new enemies, until a later production pass adds
-- night-specific variety.
local ROSTER: { string } = {
    "enemy_rootling",
    "enemy_briarback",
    "enemy_zombie",
    "enemy_hollow_crow",
    "enemy_snapvine",
    "enemy_bark_ram",
}

local MIN_WAVES = 3
local MAX_WAVES = 8
-- The director's ceiling for a full party. Solo nights keep MAX_WAVES; the
-- extra headroom only opens as real defenders stand in the town.
local MAX_WAVES_GROUP = 12
local THEMES = table.freeze({ "EMBERFALL", "MIRETIDE", "ROOTMOON", "ASHEN VEIL" })
local THEME_PROFILES = table.freeze({
    EMBERFALL = table.freeze({
        id = "EMBERFALL",
        instruction = "KEEP ATTACKERS OFF THE FIRST LANTERN",
        healthMultiplier = 1,
        speedMultiplier = 1,
        playerDamageMultiplier = 1,
        lanternDamageMultiplier = 1.25,
    }),
    MIRETIDE = table.freeze({
        id = "MIRETIDE",
        instruction = "SLOW ADVANCE · HEAVIER BLOWS",
        healthMultiplier = 1,
        speedMultiplier = 0.82,
        playerDamageMultiplier = 1.2,
        lanternDamageMultiplier = 1,
    }),
    ROOTMOON = table.freeze({
        id = "ROOTMOON",
        instruction = "ARMORED GROWTH · FOCUS EACH TARGET",
        healthMultiplier = 1.25,
        speedMultiplier = 0.94,
        playerDamageMultiplier = 1,
        lanternDamageMultiplier = 1,
    }),
    ["ASHEN VEIL"] = table.freeze({
        id = "ASHEN VEIL",
        instruction = "FRAGILE HUNTERS · FAST APPROACH",
        healthMultiplier = 0.85,
        speedMultiplier = 1.25,
        playerDamageMultiplier = 1,
        lanternDamageMultiplier = 1,
    }),
})

function TownNightSchedule.theme(nightNumber: number): string
    assert(nightNumber >= 1 and nightNumber == math.floor(nightNumber), "night number is invalid")
    return THEMES[(nightNumber - 1) % #THEMES + 1]
end

function TownNightSchedule.profile(nightNumber: number): any
    local theme = TownNightSchedule.theme(nightNumber)
    return THEME_PROFILES[theme]
end

--[[
    The enemy director, in one function: the night's pressure scales with
    how many defenders actually stand in the town. partySize 1 (or absent)
    is EXACTLY the pre-director schedule -- solo nights were tuned to
    breathe and this must not move them -- and each additional eligible
    defender adds one wave, up to a group ceiling above the solo cap.
    Deterministic like everything else in this module: same night, same
    party size, same layout.
]]
function TownNightSchedule.waveCount(nightNumber: number, partySize: number?): number
    assert(
        nightNumber >= 1 and nightNumber == math.floor(nightNumber),
        "night number must be a positive integer"
    )
    local solo = math.clamp(MIN_WAVES - 1 + nightNumber, MIN_WAVES, MAX_WAVES)
    local size = if type(partySize) == "number" and partySize == partySize
        then math.clamp(math.floor(partySize), 1, 8)
        else 1
    return math.clamp(solo + (size - 1), MIN_WAVES, MAX_WAVES_GROUP)
end

-- Deterministic by design (no randomness) so a night's wave layout is fully
-- reproducible and testable, matching this project's existing expedition and
-- first-night schedules.
function TownNightSchedule.beats(
    duration: number,
    nightNumber: number,
    partySize: number?
): { Beat }
    assert(duration > 0, "duration must be positive")
    local waves = TownNightSchedule.waveCount(nightNumber, partySize)
    local theme = TownNightSchedule.theme(nightNumber)
    local result: { Beat } = {
        { at = 0, kind = "warning", enemyId = nil, theme = theme, wave = nil },
    }

    local windowStart = duration * 0.05
    local windowEnd = duration * 0.85
    local span = math.max(windowEnd - windowStart, 0)
    local breachAfterWave = math.ceil(waves / 2)
    local lastValidAt = math.max(duration - 1, 0)

    for index = 1, waves do
        local at = if waves == 1
            then windowStart
            else windowStart + span * (index - 1) / (waves - 1)
        at = math.min(at, lastValidAt)
        local rosterIndex = (index - 1 + nightNumber - 1) % #ROSTER + 1
        local enemyId = ROSTER[rosterIndex]
        table.insert(
            result,
            { at = at, kind = "spawn", enemyId = enemyId, theme = theme, wave = index }
        )
        if index == breachAfterWave then
            table.insert(result, {
                at = math.min(at + 1, lastValidAt),
                kind = "breach",
                enemyId = nil,
                theme = theme,
                wave = index,
            })
        end
    end

    table.insert(result, {
        at = math.min(duration * 0.58, lastValidAt),
        kind = "incident",
        enemyId = nil,
        incidentId = "theme_incident",
        theme = theme,
        wave = nil,
    })

    table.sort(result, function(a, b)
        return a.at < b.at
    end)
    return result
end

function TownNightSchedule.pending(
    duration: number,
    nightNumber: number,
    elapsed: number,
    partySize: number?
): { Beat }
    local result: { Beat } = {}
    for _, beat in TownNightSchedule.beats(duration, nightNumber, partySize) do
        if beat.at >= elapsed then
            table.insert(result, beat)
        end
    end
    return result
end

return table.freeze(TownNightSchedule)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="114">
        <Properties>
          <string name="Name">TownPermissions</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Who may change a shared town, and in which direction.

    Milestone 4's exit gate asks that "visitors cannot modify or steal without
    permission." Most of that is already true by construction: every profile
    write is keyed to the player it belongs to, so a visitor has no path to a
    host's save, and TownProgression.merge is monotonic -- tier, growth stage,
    and building stages only ever take the maximum, so arriving with a fresh
    profile can never tear down what a host has built.

    Town condition was the exception. Its merge resolves on night number first,
    so a visitor arriving from night fifty with a wrecked town replaced a host's
    intact one outright: a stranger walks in and the walls are suddenly broken.
    Nobody stole anything, but the host's town changed because someone else
    visited, which is the thing the gate is asking about.

    The rule here restores the same shape the rest of the town already has:

      * a **host** may move their own town in either direction, because their
        own nights are what damage it and their own repairs are what fix it;
      * a **visitor** may only ever contribute upward. Their higher night count
        and their completed repairs carry, their damage does not.

    Stated as an invariant: no arrival by another player may lower integrity,
    reduce a building stage, or remove a resident. A town gets better when
    people visit, or it stays the same.
]]

local TownPermissions = {}

export type Role = "host" | "visitor"

export type Decision = {
    allowed: boolean,
    reason: string,
}

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

-- Bounds an integrity reading supplied by the caller. Deliberately not a reader
-- itself: where the number comes from is TownCondition's business, and a local
-- copy of that knowledge is what silently broke this guard once already.
local function integrityOf(value: any): number
    if not finite(value) then
        return 0
    end
    return math.clamp(value, 0, 100)
end

--[[
    Which role a player holds in the town they are standing in.

    Ownership is by user ID and nothing else. A display name can be changed to
    match someone else's; the numeric ID a player joins with cannot.
]]
function TownPermissions.roleFor(actorUserId: any, hostUserId: any): Role
    if
        finite(actorUserId)
        and finite(hostUserId)
        and actorUserId > 0
        and actorUserId == hostUserId
    then
        return "host"
    end
    return "visitor"
end

function TownPermissions.isHost(actorUserId: any, hostUserId: any): boolean
    return TownPermissions.roleFor(actorUserId, hostUserId) == "host"
end

--[[
    Whether this actor may apply a change that lowers shared town state.

    Only the host may. Everything else is refused with a reason rather than
    silently dropped, so a caller can tell a player why nothing happened.
]]
function TownPermissions.canDegrade(actorUserId: any, hostUserId: any): Decision
    if TownPermissions.isHost(actorUserId, hostUserId) then
        return { allowed = true, reason = "host" }
    end
    return { allowed = false, reason = "visitors_cannot_damage_a_town" }
end

--[[
    Resolve an incoming town condition against the current one.

    `merge` is the existing TownCondition.merge and `readIntegrity` its
    averageIntegrity, both passed in rather than required so this module stays
    free of a dependency it would only use here and so the host path provably
    keeps its old behaviour.

    `readIntegrity` is required rather than optional on purpose. Town condition
    stopped storing a single `integrity` field when damage became per building,
    and the local reader that used to pluck it off the table silently answered
    zero for every town once that happened -- which made `merged < current`
    false in every case and quietly turned this guard off. A missing accessor is
    a programming error and should say so, not degrade into an unprotected town.

    The visitor path never returns anything with lower integrity than what is
    already standing, whatever night number rides along with it.
]]
function TownPermissions.resolveCondition(
    current: any,
    incoming: any,
    role: Role,
    merge: (any, any) -> any,
    readIntegrity: (any) -> number
): any
    assert(type(merge) == "function", "resolveCondition needs a merge function")
    assert(type(readIntegrity) == "function", "resolveCondition needs an integrity reader")

    local merged = merge(current, incoming)
    if role == "host" then
        return merged
    end

    -- A visitor's contribution is accepted only where it does not cost the host
    -- anything. If the merge would lower integrity, the town keeps what it had.
    if integrityOf(readIntegrity(merged)) < integrityOf(readIntegrity(current)) then
        return current
    end
    return merged
end

--[[
    Whether an actor may take a specific owned object.

    The recovery satchels and delivery crates already carry an OwnerUserId, and
    this is the same question asked in one place: an unowned object is free to
    anyone, an owned one belongs to its owner.
]]
function TownPermissions.canTake(actorUserId: any, ownerUserId: any): Decision
    if not finite(ownerUserId) or ownerUserId <= 0 then
        return { allowed = true, reason = "unowned" }
    end
    if finite(actorUserId) and actorUserId == ownerUserId then
        return { allowed = true, reason = "owner" }
    end
    return { allowed = false, reason = "belongs_to_another_traveler" }
end

return table.freeze(TownPermissions)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="115">
        <Properties>
          <string name="Name">TownProgression</string>
          <string name="Source"><![CDATA[--!strict

local ChapterCatalog = require("./ChapterCatalog")
local ResidentRoster = require("./ResidentRoster")

local TownProgression = {}

export type Consequence = {
    tier: number,
    title: string,
    detail: string,
    decision: string?,
    wardenOutcome: string?,
    landscapeKind: string,
    memorialKind: string,
    growthStage: number,
    buildingStages: { [string]: number },
    residentIds: { string },
}

--[[
    The tier at which each later building first breaks ground.

    The five original buildings keep their own hand-written curves below: they
    are the survival core and their exact staging is pinned by tests. Everything
    added for the sixteen-building town is declared here instead, because eleven
    more bespoke expressions would be eleven more things to get subtly wrong.

    A town fills in the order it would actually need things. Defence and food
    come first, because those are what a settlement that survives its nights
    wants next. Production follows once there is something to protect. The
    fourth-tier group is the long tail a town only reaches after ten nights, so
    the last thing a player unlocks is the stage they celebrate on.
]]
local BUILDING_FIRST_TIER: { [string]: number } = {
    building_guardhouse = 1,
    building_kitchen = 1,

    building_sawmill = 2,
    building_forge = 2,
    building_watchtower = 2,
    building_market = 2,

    building_celebration_stage = 3,
    building_engineer_yard = 3,
    building_trade_post = 3,
    building_trapworks = 3,
    building_waterworks = 3,

    -- Tiers four and five are the story's rather than the calendar's, and
    -- what they add is what a crew brought home rather than what a town
    -- outgrew. The Reach teaches signalling, cold storage and charity to a
    -- place that has been hoarding; the Vale teaches rope, bells and
    -- nursing to a place that has been burying.
    building_signal_house = 4,
    building_cold_store = 4,
    building_almshouse = 4,

    building_ropewalk = 5,
    building_bell_tower = 5,
    building_infirmary = 5,

    -- Tiers six and seven are the last two, and what they add is what a
    -- town does after the story rather than during it. The Crown teaches
    -- it to keep a record; the Hollow leaves it deciding what to do with
    -- a light it now understands.
    building_glassworks = 6,
    building_memorial_hall = 6,
    building_records_office = 6,

    building_lamp_house = 7,
    building_deep_well = 7,
    building_meeting_hall = 7,
}

--[[
    How much of each material the town's stores can hold. Tier is the only
    input on purpose: storage is a thing the town grows, not a stat a player
    buys. Tier 0 starts snug enough that a few good expeditions press against
    it, and each tier earns real headroom.
]]
function TownProgression.storageCapForTier(tier: number): number
    return 80 + math.clamp(math.floor(tonumber(tier) or 0), 0, 7) * 60
end

local function buildingStages(tier: number): { [string]: number }
    -- Stage zero is a readable construction site, while stages one through
    -- three are increasingly complete buildings. Core services arrive first;
    -- the inn opens only after the town has survived enough nights to support
    -- visitors instead of appearing fully formed on a fresh save.
    local stages = {
        building_first_lantern = math.max(1, tier),
        building_archive = tier,
        building_town_board = math.max(1, tier),
        building_workbench = math.max(1, tier),
        building_inn = math.max(0, tier - 1),
    }

    for buildingId, firstTier in BUILDING_FIRST_TIER do
        stages[buildingId] = math.clamp(tier - firstTier + 1, 0, 3)
    end

    return stages
end

function TownProgression.buildingIds(): { string }
    local ids = {
        "building_first_lantern",
        "building_archive",
        "building_town_board",
        "building_workbench",
        "building_inn",
    }
    for buildingId in BUILDING_FIRST_TIER do
        table.insert(ids, buildingId)
    end
    table.sort(ids)
    return ids
end

--[[
    Reads a chapter's completion straight off the profile's story table.
    TownProgression cannot ask SaveSchema (SaveSchema requires this
    module), so it applies the same test SaveSchema.normalize already
    guarantees holds for anything stored there.
]]
local function chapterComplete(story: any, chapterId: string): boolean
    if type(story) ~= "table" then
        return false
    end
    if chapterId == "chapter_one" then
        return type(story.chapterOne) == "table" and story.chapterOne.status == "complete"
    end
    local chapters = story.chapters
    if type(chapters) ~= "table" then
        return false
    end
    local record = chapters[chapterId]
    return type(record) == "table" and record.status == "complete"
end

local function reachedChapter(story: any): number
    local reached = 1
    for _, definition in ChapterCatalog.list() do
        if chapterComplete(story, definition.id) then
            reached = math.max(reached, definition.number + 1)
        end
    end
    return math.min(reached, #ChapterCatalog.Order)
end

--[[
    Who stands in town. Tier 0 is the pre-chapter tutorial town, empty of
    named residents; after that the cast is the story's, via the roster --
    chapter I's three, then the Delve's four, then the Fen's four. Mara is
    present from the tutorial and is built separately.
]]
local function residentIds(tier: number, story: any): { string }
    if tier < 1 then
        return {}
    end
    -- The finale's ending decides one resident: Orin is in town or he is
    -- still below, depending on what was done with the light.
    local finale = if type(story) == "table" then story.finale else nil
    local ending = if type(finale) == "table" and finale.status == "complete"
        then finale.ending
        else nil
    return ResidentRoster.idsForChapter(reachedChapter(story), ending)
end

function TownProgression.resolve(profile: any): Consequence
    local chapter = if type(profile) == "table" and type(profile.story) == "table"
        then profile.story.chapterOne
        else nil
    local town = if type(profile) == "table" and type(profile.town) == "table"
        then profile.town
        else nil
    local nights = if town ~= nil and type(town.nightNumber) == "number"
        then town.nightNumber
        else 1
    local story = if type(profile) == "table" then profile.story else nil
    --[[
        The town grows to tier 7, but the road there is the story's:
        nights alone still cap at 3, exactly as they always have
        (spec-pinned). Stilling the Bellows Maw lifts the ceiling to 4,
        lowering the harbour's tide lifts it to 5, the Crown lifts it to 6
        and the Hollow to 7. Each resolved chapter also floors the tier,
        so coming home from a chapter always shows something changed.
    ]]
    local ceiling = if chapterComplete(story, "chapter_seven")
        then 7
        elseif chapterComplete(story, "chapter_six") then 6
        elseif chapterComplete(story, "chapter_four") then 5
        elseif chapterComplete(story, "chapter_two") then 4
        else 3
    local tier = math.clamp(math.floor(math.max(0, nights - 1) / 3), 0, ceiling)
    local decision = if type(chapter) == "table" then chapter.decision else nil
    local outcome = if type(chapter) == "table" then chapter.wardenOutcome else nil
    if type(chapter) == "table" and chapter.status == "complete" then
        tier = math.max(1, tier)
    end
    if chapterComplete(story, "chapter_two") then
        tier = math.max(2, tier)
    end
    if chapterComplete(story, "chapter_three") then
        tier = math.max(3, tier)
    end
    if chapterComplete(story, "chapter_four") then
        tier = math.max(4, tier)
    end
    if chapterComplete(story, "chapter_five") then
        tier = math.max(5, tier)
    end
    if chapterComplete(story, "chapter_six") then
        tier = math.max(6, tier)
    end
    if chapterComplete(story, "chapter_seven") then
        tier = math.max(7, tier)
    end
    local title = if decision == "restore_farmland"
        then "FARMLAND RENEWED"
        elseif decision == "wild_regrowth" then "WILD REGROWTH"
        elseif decision == "shared_agroforest" then "SHARED AGROFOREST"
        else "EMBERHOLLOW AWAKENS"
    local detail = if outcome == "preserved"
        then "The Warden's mercy keeps the old paths open."
        elseif outcome == "scarred" then "Scored roots mark a harder road through the forest."
        elseif outcome == "harmed" then "Broken antlers leave the town under a watchful shadow."
        else "Every safe night makes the lantern town stronger."
    local landscapeKind = if decision == "restore_farmland"
        then "cultivated_fields"
        elseif decision == "wild_regrowth" then "living_grove"
        elseif decision == "shared_agroforest" then "community_orchard"
        else "seed_ground"
    local memorialKind = if outcome == "preserved"
        then "living_antlers"
        elseif outcome == "scarred" then "scarred_antlers"
        elseif outcome == "harmed" then "broken_antlers"
        else "unmarked_stone"
    return {
        tier = tier,
        title = title,
        detail = detail,
        decision = decision,
        wardenOutcome = outcome,
        landscapeKind = landscapeKind,
        memorialKind = memorialKind,
        growthStage = math.min(tier, 3),
        buildingStages = buildingStages(tier),
        residentIds = residentIds(tier, story),
    }
end

-- Emberhollow is one shared server world even though progression is stored per
-- player. Reconcile arrivals monotonically so a fresh or lower-tier player can
-- never tear down buildings and residents that are already visible. The first
-- resolved chapter consequence seen by the server owns the shared landscape;
-- later conflicting personal choices remain in those players' profiles and
-- snapshots without making the physical world flicker between joins.
function TownProgression.merge(current: any, incoming: Consequence): Consequence
    if type(current) ~= "table" then
        return incoming
    end

    local currentTier = math.clamp(math.floor(tonumber(current.tier) or 0), 0, 4)
    local incomingTier = math.clamp(math.floor(tonumber(incoming.tier) or 0), 0, 4)
    local base = if incomingTier > currentTier then incoming else current
    local result = table.clone(base)
    result.tier = math.max(currentTier, incomingTier)
    result.growthStage = math.max(
        math.clamp(math.floor(tonumber(current.growthStage) or 0), 0, 3),
        math.clamp(math.floor(tonumber(incoming.growthStage) or 0), 0, 3)
    )

    local mergedStages = {}
    -- Read from the shared list rather than a copy of it: a building added to
    -- the town but forgotten here would silently stop reconciling between
    -- players, which looks like the building flickering as people join.
    for _, buildingId in TownProgression.buildingIds() do
        local currentStages = if type(current.buildingStages) == "table"
            then current.buildingStages
            else {}
        local incomingStages = if type(incoming.buildingStages) == "table"
            then incoming.buildingStages
            else {}
        mergedStages[buildingId] = math.max(
            math.clamp(math.floor(tonumber(currentStages[buildingId]) or 0), 0, 3),
            math.clamp(math.floor(tonumber(incomingStages[buildingId]) or 0), 0, 3)
        )
    end
    result.buildingStages = mergedStages

    local residentSet = {}
    for _, source in { current.residentIds, incoming.residentIds } do
        if type(source) == "table" then
            for _, residentId in source do
                if type(residentId) == "string" then
                    residentSet[residentId] = true
                end
            end
        end
    end
    -- Rebuilt in roster order so every joiner sees the same cast in the
    -- same order. This list used to hardcode chapter I's three, which
    -- silently evicted later arrivals from a merged town.
    local mergedResidents = {}
    for _, residentId in ResidentRoster.Order do
        if residentSet[residentId] == true then
            table.insert(mergedResidents, residentId)
        end
    end
    result.residentIds = mergedResidents

    local consequenceSource = if type(current.decision) == "string"
        then current
        elseif type(incoming.decision) == "string" then incoming
        else base
    result.title = consequenceSource.title
    result.detail = consequenceSource.detail
    result.decision = consequenceSource.decision
    result.wardenOutcome = consequenceSource.wardenOutcome
    result.landscapeKind = consequenceSource.landscapeKind
    result.memorialKind = consequenceSource.memorialKind
    return result :: Consequence
end

return table.freeze(TownProgression)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="116">
        <Properties>
          <string name="Name">TownVisitPolicy</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Who may stand in your Emberhollow, and what standing there gets them.

    A town in this game has always had a host and visitors -- `TownPermissions`
    settled that in Milestone 4, and its invariant has held since: a visit may
    improve a town or leave it alone, never break it. What was missing is the
    other half of the sentence. A player had no say in *who* visited, and no
    way to be told that they were the one being let in.

    This module is that say, as four values and one question.

    **What a policy actually governs, and what it cannot.** It does not govern
    presence. Roblox decides which server a player lands in, and a game that
    tried to eject somebody on arrival would be a game that bricks a public
    join -- the player did nothing wrong by being matched. So the policy
    governs what this game does control: whether the arriving player's town
    record is **adopted into** the host's town, and whether they may **read**
    the host's showcase. Refused, they are an outsider: they walk the same
    world, they play their own nights and their own expeditions and their own
    profile, and the host's Emberhollow is scenery they may not touch or
    inspect. That is a real boundary rather than a decorative one, because
    adoption is the only channel by which one player's save has ever reached
    another player's town.

    **A refusal cannot silently become a downgrade.** An outsider contributes
    nothing, which is strictly less than the visitor's upward-only
    contribution, so the Milestone 4 invariant is not merely preserved by this
    change -- it is preserved twice over, and the spec re-asserts it against
    this path rather than trusting that.

    The four values are ordered from most open to least, and that order is
    load-bearing: cycling the gate walks it, and a spec pins it so a value
    added in the middle cannot quietly change what a press does.
]]

export type Policy = "open" | "friends" | "invited" | "closed"

--[[
    What the arriving player is to the host, decided by the server before this
    module is asked anything. Deliberately not "friend or not": a party member
    is admitted by a town set to `invited` whether or not they are on the
    host's friends list, because being asked along is the invitation.
]]
export type Relation = "host" | "friend" | "invited" | "stranger"

export type Decision = {
    allowed: boolean,
    reason: string,
}

local TownVisitPolicy = {
    Default = "open" :: Policy,
}

local ORDER: { Policy } = { "open", "friends", "invited", "closed" }

local LABELS: { [string]: string } = {
    open = "OPEN TO ALL TRAVELLERS",
    friends = "OPEN TO FRIENDS",
    invited = "OPEN TO THOSE YOU ASKED ALONG",
    closed = "CLOSED — THIS TOWN IS YOURS ALONE",
}

--[[
    Which relations each policy admits.

    Written out rather than derived from the order, because "friends admits an
    invited stranger" is a decision and not an accident of sorting: somebody
    you asked onto the departure platform is somebody you chose, and a town
    that admits your friends but not the party you just built is a town that
    refuses the people you are actually playing with.
]]
local ADMITS: { [string]: { [string]: boolean } } = {
    open = { host = true, friend = true, invited = true, stranger = true },
    friends = { host = true, friend = true, invited = true, stranger = false },
    invited = { host = true, friend = false, invited = true, stranger = false },
    closed = { host = true, friend = false, invited = false, stranger = false },
}

local POLICY_SET: { [string]: boolean } = {}
for _, policy in ORDER do
    POLICY_SET[policy] = true
    assert(ADMITS[policy] ~= nil, "policy with no admission row: " .. policy)
    assert(LABELS[policy] ~= nil, "policy with no label: " .. policy)
end
assert(POLICY_SET[TownVisitPolicy.Default], "default policy is not a policy")

function TownVisitPolicy.isValid(policy: any): boolean
    return type(policy) == "string" and POLICY_SET[policy] == true
end

--[[
    Bound whatever came out of storage. An unreadable policy resolves to the
    default rather than to `closed`: a corrupt byte must not lock a player out
    of their own town's social life, and the default is the state every save
    before this schema was in anyway.
]]
function TownVisitPolicy.normalize(policy: any): Policy
    if TownVisitPolicy.isValid(policy) then
        return policy :: Policy
    end
    return TownVisitPolicy.Default
end

function TownVisitPolicy.list(): { Policy }
    return ORDER
end

function TownVisitPolicy.label(policy: any): string
    return LABELS[TownVisitPolicy.normalize(policy)]
end

-- The gate is one prompt, so a press walks the list and wraps. The order is
-- pinned by spec for exactly this reason.
function TownVisitPolicy.next(policy: any): Policy
    local current = TownVisitPolicy.normalize(policy)
    for index, value in ORDER do
        if value == current then
            return ORDER[(index % #ORDER) + 1]
        end
    end
    return TownVisitPolicy.Default
end

--[[
    The one question. A host is always admitted to their own town, and that is
    checked first rather than left to the table, because a policy value nobody
    thought about must never be able to lock a founder out of the place they
    built.
]]
function TownVisitPolicy.admits(policy: any, relation: any): Decision
    if relation == "host" then
        return { allowed = true, reason = "host" }
    end
    if relation ~= "friend" and relation ~= "invited" and relation ~= "stranger" then
        -- An unknown relation is treated as the least of them. Guessing
        -- upward here would mean a new relation kind ships admitted by every
        -- town in the game before anybody decides it should be.
        relation = "stranger"
    end
    local row = ADMITS[TownVisitPolicy.normalize(policy)]
    if row[relation] == true then
        return { allowed = true, reason = tostring(relation) }
    end
    return { allowed = false, reason = "refused_" .. tostring(relation) }
end

--[[
    The role a player holds once the policy has spoken.

    Three roles rather than TownPermissions' two, and the third is a narrowing
    of the second: `visitor` is what `TownPermissions` has always meant, and
    `outsider` is a visitor whose contribution and whose reading are both
    refused. Everything downstream that already asks TownPermissions about a
    host or a visitor keeps working unchanged, because an outsider never
    reaches it.
]]
function TownVisitPolicy.roleFor(policy: any, relation: any): string
    if relation == "host" then
        return "host"
    end
    return if TownVisitPolicy.admits(policy, relation).allowed then "visitor" else "outsider"
end

return table.freeze(TownVisitPolicy)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="117">
        <Properties>
          <string name="Name">TutorialFlow</string>
          <string name="Source"><![CDATA[--!strict

local TutorialFlow = {}

export type Stage =
    "arrive"
    | "gather"
    | "choose_tool"
    | "build"
    | "prepare"
    | "survive"
    | "reveal"
    | "complete"

export type Definition = {
    index: number,
    action: string?,
    next: Stage?,
    objective: string,
    detail: string,
    mara: string,
    -- World interactions that satisfy this stage. The client raises a marker
    -- over each one, because an objective a player cannot find is the same as
    -- an objective that does not exist: "choose a starter tool" said nothing
    -- about where the tools were.
    targets: { string }?,
}

local ORDER: { Stage } = {
    "arrive",
    "gather",
    "choose_tool",
    "build",
    "prepare",
    "survive",
    "reveal",
    "complete",
}

local DEFINITIONS: { [Stage]: Definition } = {
    arrive = {
        targets = { "mara_rescue" },
        index = 1,
        action = "rescue",
        next = "gather",
        objective = "FREE MARA",
        detail = "Follow the lantern path to the fallen roots.",
        mara = "Over here! The roots tighten when the light fades.",
    },
    gather = {
        targets = { "heartwood_gather" },
        index = 2,
        action = "gather",
        next = "choose_tool",
        objective = "GATHER HEARTWOOD",
        detail = "Collect 3 Heartwood from the glowing stump.",
        mara = "Heartwood remembers sunlight. We can build with it.",
    },
    choose_tool = {
        targets = { "tool_axe", "tool_hammer", "tool_torch" },
        index = 3,
        action = "choose_tool",
        next = "build",
        objective = "CHOOSE A STARTER TOOL",
        detail = "Axe hits harder · hammer works faster · torch reaches further and lights the dark. Not permanent.",
        mara = "Choose what feels right. Emberhollow needs every kind of helper.",
    },
    build = {
        targets = { "barricade_build" },
        index = 4,
        action = "build",
        next = "prepare",
        objective = "BUILD THE BARRICADE",
        detail = "Use 3 Heartwood at the marked construction plot.",
        mara = "Place the braces toward the dark trail.",
    },
    prepare = {
        targets = { "first_lantern_prepare" },
        index = 5,
        action = "prepare",
        next = "survive",
        objective = "LIGHT THE FIRST LANTERN",
        detail = "Start the two-minute defense when you are ready.",
        mara = "Night is close. Light the lantern when you are ready.",
    },
    survive = {
        targets = { "first_lantern_prepare" },
        index = 6,
        action = nil,
        next = "reveal",
        objective = "KEEP THE LIGHT ALIVE",
        detail = "Defend the lantern until dawn.",
        mara = "Stay in the light. Rootlings hate a steady flame.",
    },
    reveal = {
        targets = { "bramblewake_reveal" },
        index = 7,
        action = "reveal",
        next = "complete",
        objective = "FOLLOW THE FIRST LIGHT",
        detail = "Reach the dawn beacon and reveal Bramblewake.",
        mara = "The lantern knows your name. Go—see what it remembered.",
    },
    complete = {
        index = 8,
        action = nil,
        next = nil,
        objective = "EMBERHOLLOW REMEMBERS YOU",
        detail = "First Light complete. The wider world is now ahead.",
        mara = "You brought the morning back. Welcome home.",
    },
}

function TutorialFlow.isValidStage(value: any): boolean
    return type(value) == "string" and DEFINITIONS[value :: Stage] ~= nil
end

function TutorialFlow.definition(stage: Stage): Definition
    local definition = DEFINITIONS[stage]
    assert(definition ~= nil, string.format("unknown tutorial stage %q", tostring(stage)))
    return definition
end

function TutorialFlow.advance(stage: Stage, action: string): (Stage?, string?)
    local definition = TutorialFlow.definition(stage)
    if definition.action == nil then
        return nil, "stage does not accept a player action"
    end
    if action ~= definition.action then
        return nil, string.format("expected %s", definition.action)
    end
    return definition.next, nil
end

function TutorialFlow.advanceSystem(stage: Stage): (Stage?, string?)
    if stage ~= "survive" then
        return nil, "only survive advances from a system event"
    end
    return "reveal", nil
end

function TutorialFlow.progress(stage: Stage): (number, number)
    return TutorialFlow.definition(stage).index, #ORDER
end

-- The stage a fresh run begins at. Named rather than indexed at call sites so
-- reordering the flow cannot silently change where new sessions start.
function TutorialFlow.firstStage(): Stage
    return TutorialFlow.order()[1]
end

function TutorialFlow.order(): { Stage }
    return table.clone(ORDER)
end

return table.freeze(TutorialFlow)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="118">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict

export type EnvironmentName = "local" | "test" | "staging" | "production"
export type LogLevel = "debug" | "info" | "warn" | "error"
export type LogFields = { [string]: any }

export type Logger = {
    debug: (self: Logger, event: string, fields: LogFields?) -> (),
    info: (self: Logger, event: string, fields: LogFields?) -> (),
    warn: (self: Logger, event: string, fields: LogFields?) -> (),
    error: (self: Logger, event: string, fields: LogFields?) -> (),
}

export type FeatureFlagReader = {
    isEnabled: (self: FeatureFlagReader, flag: string) -> boolean,
}

export type ServiceContext = {
    environment: EnvironmentName,
    logger: Logger,
    featureFlags: FeatureFlagReader,
}

export type Service = {
    Name: string,
    Init: ((self: any, context: ServiceContext) -> ())?,
    Start: ((self: any) -> ())?,
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="119">
        <Properties>
          <string name="Name">WardenStagEncounter</string>
          <string name="Source"><![CDATA[--!strict

local WardenStagEncounter = {}

export type Status = "disabled" | "locked" | "dormant" | "cleansing" | "vulnerable" | "complete"

export type State = {
    antlersBroken: number,
    brokenAntlers: { [string]: boolean },
    cleansedNodes: { [string]: boolean },
    health: number,
    manifestHash: string,
    outcome: string?,
    participants: { [string]: boolean },
    phase: number,
    phaseAntlerBroken: boolean,
    revision: number,
    runId: string,
    status: Status,
}

local MAX_HEALTH = 480
local PHASE_THRESHOLDS = table.freeze({ 320, 160, 0 })
local ROOTS_REQUIRED = table.freeze({ 2, 3, 4 })
local ROOT_NODE_IDS = table.freeze({
    root_node_north = true,
    root_node_east = true,
    root_node_south = true,
    root_node_west = true,
})
local ANTLER_IDS = table.freeze({
    antler_left = true,
    antler_right = true,
})

local ROOTBOUND_CHARGE = table.freeze({
    attackId = "warden_stag_rootbound_charge",
    attackName = "ROOTBOUND CHARGE",
    damage = 24,
    instruction = "CLEAR THE CHARGE LANE",
    length = 42,
    rootedDuration = 1.2,
    rootedMultiplier = 0.45,
    shape = "lane",
    width = 11,
    windup = 1.55,
})

local ANTLER_ARC = table.freeze({
    attackId = "warden_stag_antler_arc",
    attackName = "ANTLER ARC",
    damage = 28,
    instruction = "LEAVE THE ANTLER RING",
    radius = 11,
    shape = "circle",
    windup = 1.7,
})

local MEMORY_STAMPEDE = table.freeze({
    attackId = "warden_stag_memory_stampede",
    attackName = "MEMORY STAMPEDE",
    damage = 32,
    instruction = "CROSS OUT OF THE MEMORY LANE",
    length = 48,
    rootedDuration = 1.5,
    rootedMultiplier = 0.38,
    shape = "lane",
    width = 14,
    windup = 1.9,
})

WardenStagEncounter.Id = "boss_warden_stag"
WardenStagEncounter.MaxHealth = MAX_HEALTH
WardenStagEncounter.RootNodeIds = ROOT_NODE_IDS
WardenStagEncounter.AntlerIds = ANTLER_IDS
WardenStagEncounter.Reward = table.freeze({
    amount = 5,
    materialId = "material_amber_sap",
})
WardenStagEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.5,
    cleansingAttackCooldownSeconds = 4.4,
    markedAttackCooldownMultiplier = 1.35,
    markedStrikeDamage = 46,
    strikeDamage = 40,
})

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "boss participant user ID is invalid")
    return tostring(userId)
end

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.brokenAntlers = table.clone(state.brokenAntlers)
    nextState.cleansedNodes = table.clone(state.cleansedNodes)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function countKeys(values: { [string]: boolean }): number
    local count = 0
    for _, value in values do
        if value then
            count += 1
        end
    end
    return count
end

local function isActive(status: Status): boolean
    return status == "cleansing" or status == "vulnerable"
end

function WardenStagEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Warden Stag run ID is required")
    assert(manifestHash ~= "", "Warden Stag manifest hash is required")
    return {
        antlersBroken = 0,
        brokenAntlers = {},
        cleansedNodes = {},
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        outcome = nil,
        participants = {},
        phase = 1,
        phaseAntlerBroken = false,
        revision = 0,
        runId = runId,
        status = if enabled then "locked" else "disabled",
    }
end

function WardenStagEncounter.unlock(state: State): (State, any)
    if state.status ~= "locked" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.status = "dormant"
    nextState.revision += 1
    return nextState, {
        accepted = true,
        reason = "unlocked",
    }
end

function WardenStagEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.status = "cleansing"
    nextState.revision += 1
    return nextState, {
        accepted = true,
        reason = "activated",
    }
end

function WardenStagEncounter.join(state: State, userId: number): State
    if not isActive(state.status) then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function WardenStagEncounter.cleanseRoot(state: State, userId: number, nodeId: string): (State, any)
    if state.status ~= "cleansing" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    if ROOT_NODE_IDS[nodeId] ~= true then
        return state,
            {
                accepted = false,
                reason = "invalid_root_node",
            }
    end
    if state.cleansedNodes[nodeId] then
        return state,
            {
                accepted = false,
                reason = "already_cleansed",
            }
    end

    local nextState = cloneState(state)
    nextState.cleansedNodes[nodeId] = true
    nextState.participants[participantKey(userId)] = true
    local cleansed = countKeys(nextState.cleansedNodes)
    local required = ROOTS_REQUIRED[nextState.phase]
    local exposed = cleansed >= required
    if exposed then
        nextState.status = "vulnerable"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            cleansed = cleansed,
            exposed = exposed,
            reason = if exposed then "heart_exposed" else "root_cleansed",
            required = required,
        }
end

function WardenStagEncounter.breakAntler(
    state: State,
    userId: number,
    antlerId: string
): (State, any)
    if state.status ~= "cleansing" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    if ANTLER_IDS[antlerId] ~= true then
        return state,
            {
                accepted = false,
                reason = "invalid_antler",
            }
    end
    if state.phaseAntlerBroken then
        return state,
            {
                accepted = false,
                reason = "phase_antler_already_broken",
            }
    end
    if state.brokenAntlers[antlerId] then
        return state,
            {
                accepted = false,
                reason = "antler_already_broken",
            }
    end

    local nextState = cloneState(state)
    nextState.brokenAntlers[antlerId] = true
    nextState.antlersBroken += 1
    nextState.phaseAntlerBroken = true
    nextState.participants[participantKey(userId)] = true
    nextState.status = "vulnerable"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            antlersBroken = nextState.antlersBroken,
            exposed = true,
            reason = "antler_broken",
        }
end

function WardenStagEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Warden Stag strike amount is invalid")
    if state.status ~= "vulnerable" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local threshold = PHASE_THRESHOLDS[state.phase]
    nextState.health = math.max(threshold, state.health - amount)
    local phaseFinished = nextState.health <= threshold
    if phaseFinished then
        if state.phase >= #PHASE_THRESHOLDS then
            nextState.health = 0
            nextState.status = "complete"
            nextState.outcome = if nextState.antlersBroken == 0
                then "preserved"
                elseif nextState.antlersBroken >= 2 then "harmed"
                else "scarred"
        else
            nextState.phase += 1
            nextState.phaseAntlerBroken = false
            nextState.cleansedNodes = {}
            nextState.status = "cleansing"
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            outcome = nextState.outcome,
            phase = nextState.phase,
            phaseFinished = phaseFinished,
            reason = if nextState.status == "complete"
                then "completed"
                elseif phaseFinished then "next_phase"
                else "damaged",
        }
end

function WardenStagEncounter.attack(attackIndex: number, phase: number): any
    if phase >= 3 then
        return if attackIndex % 2 == 0 then ANTLER_ARC else MEMORY_STAMPEDE
    elseif phase == 2 and attackIndex % 2 == 0 then
        return ANTLER_ARC
    end
    return ROOTBOUND_CHARGE
end

function WardenStagEncounter.snapshot(state: State, userId: number): any
    local cleansed = countKeys(state.cleansedNodes)
    local required = ROOTS_REQUIRED[state.phase] or ROOTS_REQUIRED[#ROOTS_REQUIRED]
    local instruction = if state.status == "cleansing"
        then string.format(
            "CLEANSE LIVING ROOTS %d/%d · BREAKING ANTLERS CHANGES THE FOREST",
            cleansed,
            required
        )
        elseif state.status == "vulnerable" then "HEART EXPOSED · STRIKE THE MEMORY SEAL"
        elseif state.status == "complete" then if state.outcome == "preserved"
            then "WARDEN STAG CALMED · FOREST ALLY PRESERVED"
            elseif state.outcome == "harmed" then "WARDEN STAG DEFEATED · FOREST HARMED"
            else "WARDEN STAG DEFEATED · FOREST SCARRED"
        elseif state.status == "dormant" then "ENTER THE WARDEN'S SEAL"
        elseif state.status == "locked" then "CLEANSE OLD GROWTH TO OPEN THE WARDEN'S SEAL"
        elseif state.status == "disabled" then "WARDEN STAG TEMPORARILY DORMANT"
        else "WARDEN STAG"
    return {
        active = isActive(state.status),
        antlersBroken = state.antlersBroken,
        choiceAvailable = state.status == "cleansing" and state.antlersBroken < 2,
        cleansedNodes = cleansed,
        complete = state.status == "complete",
        displayName = "WARDEN STAG",
        enabled = state.status ~= "disabled",
        exposed = state.status == "vulnerable",
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        outcome = state.outcome,
        phase = state.phase,
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        rootNodesRequired = required,
        status = state.status,
    }
end

function WardenStagEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        WardenStagEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(WardenStagEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="120">
        <Properties>
          <string name="Name">WeatherProfile</string>
          <string name="Source"><![CDATA[--!strict

local WeatherProfile = {}

local STREAK_COUNTS = table.freeze({
    day = 10,
    dusk = 14,
    night = 18,
    reveal = 8,
})

function WeatherProfile.streakCount(phase: string): number
    return STREAK_COUNTS[string.lower(phase)] or STREAK_COUNTS.day
end

--[[
    The contract's face. A weather kind scales what the base phase would
    show rather than replacing it: storm doubles the falling streaks and
    darkens them, mist thins them to a slow drift, spores tint the fall
    amber and let it hang. Pure data so the client controller stays a
    renderer and this table stays testable.
]]
local CONTRACT_WEATHER = {
    clear = {
        countScale = 1,
        speedScale = 1,
        transparency = 0.68,
        color = { 163, 193, 201 },
    },
    mist = {
        countScale = 0.45,
        speedScale = 0.35,
        transparency = 0.82,
        color = { 190, 205, 208 },
    },
    storm = {
        countScale = 2,
        speedScale = 1.55,
        transparency = 0.5,
        color = { 140, 168, 182 },
    },
    spores = {
        countScale = 0.8,
        speedScale = 0.25,
        transparency = 0.62,
        color = { 214, 182, 118 },
    },
}

function WeatherProfile.contractWeather(kind: any): any
    local key = if type(kind) == "string" then string.lower(kind) else "clear"
    return CONTRACT_WEATHER[key] or CONTRACT_WEATHER.clear
end

function WeatherProfile.wrapHeight(height: number, floor: number, ceiling: number): number
    assert(ceiling > floor, "weather ceiling must be above floor")
    if height >= floor then
        return height
    end
    local span = ceiling - floor
    return ceiling - ((floor - height) % span)
end

return table.freeze(WeatherProfile)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="121">
        <Properties>
          <string name="Name">WhiteHowlerEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The White Howler -- chapter V's boss, and the reason the Vale is
    quiet.

    Three phases, and the catalog's non-profession solution read
    literally: manage noise, share warmth, track aurora.

    - **Noise.** It hunts sound, so the fight opens with the party going
      round the bowl silencing the things that are making it -- a bell
      rope, a kettle line, a wind vane, a kennel gate. Each phase asks
      for one more of them, because between phases it wakes the ones you
      left.
    - **Warmth.** Quiet, it stops hunting and starts waiting, and waiting
      in Frostmere is what kills. Warmth has to be spent to stay in the
      bowl at all, and every share is a decision about where it goes.
    - **Aurora.** Fed and quiet, it breaks and runs, and only the light
      over the ridge shows where. The marks have to be read in order;
      guessing at them loses the trail and the phase starts over.

    The chapter's decision is in the second verb. Warmth can be spent on
    the party's own fire, which is the safe and obvious thing, or carried
    up to the Howler's den, where its pups are. The den costs: a party
    that warms it is colder when the trail opens and has further to read
    before it catches up. What the Vale keeps afterwards depends on how
    often that price was paid -- a valley with a predator still in it, a
    valley with none, or the long middle where the line thins out but
    does not end.
]]

local WhiteHowlerEncounter = {}

export type Status =
    "disabled"
    | "locked"
    | "dormant"
    | "listening"
    | "warming"
    | "tracking"
    | "exposed"
    | "complete"

export type State = {
    denPhases: { boolean },
    followed: { [string]: boolean },
    health: number,
    hushed: { [string]: boolean },
    manifestHash: string,
    outcome: string?,
    participants: { [string]: boolean },
    phase: number,
    revision: number,
    runId: string,
    shared: { [string]: boolean },
    status: Status,
}

local MAX_HEALTH = 560
local PHASE_THRESHOLDS = table.freeze({ 375, 190, 0 })
local NOISE_IDS = table.freeze({
    "noise_bell_rope",
    "noise_kettle_line",
    "noise_wind_vane",
    "noise_kennel_gate",
})
local HUSH_REQUIRED = table.freeze({ 2, 3, 4 })
local WARMTH_IDS = table.freeze({
    "warmth_lantern",
    "warmth_kettle",
    "warmth_coat",
})
local WARMTH_REQUIRED = 2
local TRACK_IDS = table.freeze({
    "track_ridge",
    "track_bowl",
    "track_stair",
    "track_cairn",
})
local TRACKS_REQUIRED = 2

local SNOW_BREATH = table.freeze({
    attackId = "white_howler_breath",
    attackName = "SNOW BREATH",
    damage = 30,
    instruction = "GET BEHIND SOMETHING SOLID",
    length = 34,
    shape = "lane",
    width = 9,
    windup = 1.5,
})

local LISTENING_STILL = table.freeze({
    attackId = "white_howler_listen",
    attackName = "IT IS LISTENING",
    damage = 26,
    instruction = "STOP MOVING",
    radius = 15,
    shape = "circle",
    windup = 1.9,
})

local WHITEOUT = table.freeze({
    attackId = "white_howler_whiteout",
    attackName = "WHITEOUT",
    damage = 34,
    instruction = "FOLLOW THE LIGHT, NOT THE SOUND",
    radius = 19,
    shape = "circle",
    windup = 1.7,
})

WhiteHowlerEncounter.Id = "boss_white_howler"
WhiteHowlerEncounter.MaxHealth = MAX_HEALTH
WhiteHowlerEncounter.NoiseIds = NOISE_IDS
WhiteHowlerEncounter.WarmthIds = WARMTH_IDS
WhiteHowlerEncounter.TrackIds = TRACK_IDS
WhiteHowlerEncounter.WarmthRequired = WARMTH_REQUIRED
WhiteHowlerEncounter.Reward = table.freeze({
    amount = 5,
    materialId = "material_frostmere_wool",
})
WhiteHowlerEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.6,
    exposedAttackCooldownSeconds = 4.4,
    strikeDamage = 45,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.denPhases = table.clone(state.denPhases)
    nextState.followed = table.clone(state.followed)
    nextState.hushed = table.clone(state.hushed)
    nextState.participants = table.clone(state.participants)
    nextState.shared = table.clone(state.shared)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

local function countTrue(set: { [string]: boolean }): number
    local total = 0
    for _, value in set do
        if value then
            total += 1
        end
    end
    return total
end

local function contains(list: { string }, value: any): boolean
    for _, entry in list do
        if entry == value then
            return true
        end
    end
    return false
end

function WhiteHowlerEncounter.hushRequired(phase: number): number
    return HUSH_REQUIRED[math.clamp(phase, 1, #HUSH_REQUIRED)]
end

--[[
    A phase that warmed the den has one more mark to read before the
    trail is caught. That is the whole price of the decision, and it is
    paid in the phase that made it rather than banked for later.
]]
function WhiteHowlerEncounter.tracksRequired(state: State): number
    local extra = if state.denPhases[state.phase] then 1 else 0
    return math.min(#TRACK_IDS, TRACKS_REQUIRED + extra)
end

function WhiteHowlerEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "White Howler run ID is required")
    assert(manifestHash ~= "", "White Howler manifest hash is required")
    return {
        denPhases = { false, false, false },
        followed = {},
        health = MAX_HEALTH,
        hushed = {},
        manifestHash = manifestHash,
        outcome = nil,
        participants = {},
        phase = 1,
        revision = 0,
        runId = runId,
        shared = {},
        status = if enabled then "locked" else "disabled",
    }
end

function WhiteHowlerEncounter.unlock(state: State): (State, any)
    if state.status ~= "locked" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "dormant"
    nextState.revision += 1
    return nextState, { accepted = true, reason = "unlocked" }
end

function WhiteHowlerEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "listening"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function WhiteHowlerEncounter.join(state: State, userId: number): State
    if state.status == "disabled" or state.status == "locked" or state.status == "complete" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function WhiteHowlerEncounter.hush(state: State, userId: number, noiseId: any): (State, any)
    if state.status ~= "listening" then
        return state, { accepted = false, reason = state.status }
    end
    if not contains(NOISE_IDS, noiseId) then
        return state, { accepted = false, reason = "unknown_noise" }
    end
    if state.hushed[noiseId] then
        return state, { accepted = false, reason = "already_hushed" }
    end
    local nextState = cloneState(state)
    nextState.hushed[noiseId] = true
    nextState.participants[participantKey(userId)] = true
    local required = WhiteHowlerEncounter.hushRequired(state.phase)
    local hushed = countTrue(nextState.hushed)
    if hushed >= required then
        nextState.status = "warming"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            hushed = hushed,
            reason = if nextState.status == "warming" then "bowl_quiet" else "hushed",
            required = required,
        }
end

function WhiteHowlerEncounter.shareWarmth(
    state: State,
    userId: number,
    warmthId: any,
    toDen: boolean
): (State, any)
    if state.status ~= "warming" then
        return state, { accepted = false, reason = state.status }
    end
    if not contains(WARMTH_IDS, warmthId) then
        return state, { accepted = false, reason = "unknown_warmth" }
    end
    if state.shared[warmthId] then
        return state, { accepted = false, reason = "already_shared" }
    end
    local nextState = cloneState(state)
    nextState.shared[warmthId] = true
    nextState.participants[participantKey(userId)] = true
    if toDen then
        nextState.denPhases[state.phase] = true
    end
    local shared = countTrue(nextState.shared)
    if shared >= WARMTH_REQUIRED then
        nextState.status = "tracking"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            den = toDen,
            reason = if nextState.status == "tracking" then "warmth_shared" else "warmth_given",
            required = WARMTH_REQUIRED,
            shared = shared,
        }
end

--[[
    The marks have to be read in the order the aurora laid them. A wrong
    one is not a small penalty -- the trail is lost and the phase begins
    again at the noise, because everything the party did to get quiet is
    undone by casting about in the dark.
]]
function WhiteHowlerEncounter.followTrack(state: State, userId: number, trackId: any): (State, any)
    if state.status ~= "tracking" then
        return state, { accepted = false, reason = state.status }
    end
    if not contains(TRACK_IDS, trackId) then
        return state, { accepted = false, reason = "unknown_track" }
    end
    local followed = countTrue(state.followed)
    local expected = TRACK_IDS[followed + 1]
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    if trackId ~= expected then
        nextState.followed = {}
        nextState.hushed = {}
        nextState.shared = {}
        nextState.status = "listening"
        nextState.revision += 1
        return nextState, { accepted = false, lost = true, reason = "trail_lost" }
    end
    nextState.followed[trackId] = true
    local total = followed + 1
    local required = WhiteHowlerEncounter.tracksRequired(nextState)
    if total >= required then
        nextState.status = "exposed"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            followed = total,
            reason = if nextState.status == "exposed" then "run_down" else "track_read",
            required = required,
        }
end

function WhiteHowlerEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "White Howler strike amount is invalid")
    if state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - amount)
    local threshold = PHASE_THRESHOLDS[state.phase]
    if nextState.health <= threshold then
        if state.phase >= #PHASE_THRESHOLDS then
            nextState.health = 0
            nextState.status = "complete"
            local dens = 0
            for _, warmed in nextState.denPhases do
                if warmed then
                    dens += 1
                end
            end
            nextState.outcome = if dens >= #PHASE_THRESHOLDS
                then "sheltered"
                elseif dens == 0 then "silenced"
                else "thinned"
        else
            nextState.phase = state.phase + 1
            nextState.status = "listening"
            nextState.followed = {}
            nextState.hushed = {}
            nextState.shared = {}
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = amount,
            health = nextState.health,
            outcome = nextState.outcome,
            phase = nextState.phase,
            reason = if nextState.status == "complete"
                then "completed"
                elseif nextState.phase > state.phase then "phase_cleared"
                else "damaged",
        }
end

function WhiteHowlerEncounter.attack(attackIndex: number, phase: number, status: Status?): any
    if status == "tracking" then
        return WHITEOUT
    end
    if status == "listening" then
        return LISTENING_STILL
    end
    if phase >= 3 and attackIndex % 2 == 0 then
        return WHITEOUT
    end
    return SNOW_BREATH
end

function WhiteHowlerEncounter.snapshot(state: State, userId: number): any
    local instruction = if state.status == "listening"
        then string.format(
            "QUIET THE BOWL — %d OF %d",
            countTrue(state.hushed),
            WhiteHowlerEncounter.hushRequired(state.phase)
        )
        elseif state.status == "warming" then string.format(
            "SHARE WARMTH — %d OF %d GIVEN",
            countTrue(state.shared),
            WARMTH_REQUIRED
        )
        elseif state.status == "tracking" then string.format(
            "READ THE AURORA IN ORDER — %d OF %d",
            countTrue(state.followed),
            WhiteHowlerEncounter.tracksRequired(state)
        )
        elseif state.status == "exposed" then "IT HAS NOWHERE LEFT — STRIKE"
        elseif state.status == "complete" then if state.outcome == "sheltered"
            then "THE HOWLER IS DOWN · ITS DEN STILL BURNS"
            elseif state.outcome == "silenced" then "THE HOWLER IS DOWN · THE VALE IS SILENT"
            else "THE HOWLER IS DOWN · THE LINE THINS"
        elseif state.status == "locked" then "THE VALE IS NOT OPEN TO YOU YET"
        elseif state.status == "disabled" then "THE HOWLER DOES NOT ANSWER"
        else "SOMETHING IN THE BOWL IS LISTENING"
    return {
        active = state.status ~= "disabled"
            and state.status ~= "locked"
            and state.status ~= "dormant",
        complete = state.status == "complete",
        denPhases = table.clone(state.denPhases),
        displayName = "WHITE HOWLER",
        enabled = state.status ~= "disabled",
        health = state.health,
        hushRequired = WhiteHowlerEncounter.hushRequired(state.phase),
        hushed = countTrue(state.hushed),
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        outcome = state.outcome,
        phase = state.phase,
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        shared = countTrue(state.shared),
        status = state.status,
        tracksFollowed = countTrue(state.followed),
        tracksRequired = WhiteHowlerEncounter.tracksRequired(state),
        warmthRequired = WARMTH_REQUIRED,
    }
end

function WhiteHowlerEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        WhiteHowlerEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(WhiteHowlerEncounter)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="122">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="123">
      <Properties>
        <string name="Name">LastLightServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local root = ReplicatedStorage:WaitForChild("LastLight", 8)
assert(root ~= nil, "Last Light shared root did not replicate before bootstrap timeout")

local Config = require(root.Config)
local BramblewakeExpedition = require(root.Content.Definitions.BramblewakeExpedition)
local CraftingCatalog = require(root.CraftingCatalog)
local DefenseLanes = require(root.DefenseLanes)
local RegionAccess = require(root.RegionAccess)
local RegionBuilders = require(script.World.RegionBuilders)
local Equipment = require(root.Equipment)
local Consumables = require(root.Consumables)
local GearVisualPlan = require(root.GearVisualPlan)
local EnemyCatalog = require(root.EnemyCatalog)
local CombatState = require(root.CombatState)
local EnemyAttackFlow = require(root.EnemyAttackFlow)
local EnemyCombatRules = require(root.EnemyCombatRules)
local EnemyMotion = require(root.EnemyMotion)
local EngineerBrace = require(root.EngineerBrace)
local Environment = require(root.Environment)
local ExpeditionEventFlow = require(root.ExpeditionEventFlow)
local ExpeditionContracts = require(root.ExpeditionContracts)
local ExpeditionGenerator = require(root.ExpeditionGenerator)
local ExpeditionRewardLedger = require(root.ExpeditionRewardLedger)
local ExtractionPayoff = require(root.ExtractionPayoff)
local NightSchedule = require(root.NightSchedule)
local OldGrowthEncounter = require(root.OldGrowthEncounter)
local WardenStagEncounter = require(root.WardenStagEncounter)
local BramblewakeBlackout = require(root.BramblewakeBlackout)
local ProfessionCatalog = require(root.ProfessionCatalog)
local ProfessionAbilityVisuals = require(root.ProfessionAbilityVisuals)
local ProfessionMastery = require(root.ProfessionMastery)
local ProfessionRescue = require(root.ProfessionRescue)
local ProfessionState = require(root.ProfessionState)
local RateLimiter = require(root.RateLimiter)
local ResidentDialogue = require(root.ResidentDialogue)
local ResidentRoster = require(root.ResidentRoster)
local ReviveFlow = require(root.ReviveFlow)
local RuntimeIds = require(root.RuntimeIds)
local SaveSchema = require(root.SaveSchema)
local StatusEffectState = require(root.StatusEffectState)
local SurvivalState = require(root.SurvivalState)
local TownNightSchedule = require(root.TownNightSchedule)
local TownNightIncident = require(root.TownNightIncident)
local TownCondition = require(root.TownCondition)
local TownGuardLastStand = require(root.TownGuardLastStand)
local LobbyDeparture = require(root.LobbyDeparture)
local ActionProgress = require(root.ActionProgress)
local ToolCatalog = require(root.ToolCatalog)
local GearWear = require(root.GearWear)
local GearTraits = require(root.GearTraits)
local CompanionMotion = require(root.CompanionMotion)
local ActionPayloadContract = require(root.ActionPayloadContract)
local AdminInspectionReport = require(root.AdminInspectionReport)
local PerformanceBudget = require(root.PerformanceBudget)
local SessionSegment = require(root.SessionSegment)
local SoakProbe = require(root.SoakProbe)
local ProfilePersistence = require(root.ProfilePersistence)
local ProfileBackup = require(root.ProfileBackup)
local TownPermissions = require(root.TownPermissions)
local TownVisitPolicy = require(root.TownVisitPolicy)
local RolloutCohorts = require(root.RolloutCohorts)
local RunHandoff = require(root.RunHandoff)
local PartySession = require(root.PartySession)
local PrivateServerControls = require(root.PrivateServerControls)
local QuickChat = require(root.QuickChat)
local CosmeticCatalog = require(root.CosmeticCatalog)
local Entitlements = require(root.Entitlements)
local StoreAvailability = require(root.StoreAvailability)
local StoreCard = require(root.StoreCard)
local AdminRoster = require(root.AdminRoster)
local TownDecorations = require(root.TownDecorations)
local TownProgression = require(root.TownProgression)
local MemoryFragments = require(root.MemoryFragments)
local TownConstruction = require(root.TownConstruction)
local TutorialFlow = require(root.TutorialFlow)
local Registry = require(root.Content.Registry)
local Regions = require(root.Content.Definitions.Regions)

local AnalyticsService = require(script.Services.AnalyticsService)
local EnemyService = require(script.Services.EnemyService)
local ExpeditionService = require(script.Services.ExpeditionService)
local Logger = require(script.Services.Logger)
local FeatureFlagService = require(script.Services.FeatureFlagService)
local GearVisualService = require(script.Services.GearVisualService)
local NetworkService = require(script.Services.NetworkService)
local PerformanceService = require(script.Services.PerformanceService)
local OldGrowthService = require(script.Services.OldGrowthService)
local WardenStagService = require(script.Services.WardenStagService)
local BramblewakeBlackoutService = require(script.Services.BramblewakeBlackoutService)
local PhaseService = require(script.Services.PhaseService)
local ProfileService = require(script.Services.ProfileService)
local TownNightService = require(script.Services.TownNightService)
local LobbyService = require(script.Services.LobbyService)
local PartyService = require(script.Services.PartyService)
local SocialService = require(script.Services.SocialService)
local CommerceService = require(script.Services.CommerceService)
local PrivateServerService = require(script.Services.PrivateServerService)
local AdminService = require(script.Services.AdminService)
local CompanionService = require(script.Services.CompanionService)
local DefenseService = require(script.Services.DefenseService)
local RegionEncounterService = require(script.Services.RegionEncounterService)
local PlayerSurvivalService = require(script.Services.PlayerSurvivalService)
local PlayerCombatService = require(script.Services.PlayerCombatService)
local ProfessionService = require(script.Services.ProfessionService)
local TutorialService = require(script.Services.TutorialService)
local WorldService = require(script.Services.WorldService)
local ServiceRegistry = require(script.ServiceRegistry)
local BramblewakeEnemyBuilder = require(script.World.BramblewakeEnemyBuilder)
local OldGrowthBuilder = require(script.World.OldGrowthBuilder)
local WardenStagBuilder = require(script.World.WardenStagBuilder)

local environment, environmentError = Environment.resolve({
    isStudio = RunService:IsStudio(),
    placeId = game.PlaceId,
    requested = game:GetAttribute("LastLightEnvironment"),
    productionPlaceIds = Config.ProductionPlaceIds,
})
assert(environment ~= nil, environmentError)

local environmentConfig = Config.Environments[environment]
local logger = Logger.new(environment, environmentConfig.LogLevel)
local featureFlags = FeatureFlagService.new(
    Config.FeatureFlags,
    environmentConfig.AllowFlagOverrides,
    logger,
    RolloutCohorts,
    Config.FeatureFlagRollouts,
    Config.RolloutRoster
)
local content = Registry.new(Regions)
local networkService = NetworkService.new(logger)
-- Analytics before the profile service, because a profile transaction is one
-- of the release gates and the thing that measures it cannot be built after
-- the thing it measures.
local analyticsService = AnalyticsService.new(logger)
local profileService =
    ProfileService.new(logger, environmentConfig.UsePersistentData, analyticsService)
local gearVisualService = GearVisualService.new(logger, profileService, GearVisualPlan)
local worldService = WorldService.new(
    logger,
    ExtractionPayoff,
    TownProgression,
    ProfessionAbilityVisuals,
    TownConstruction,
    MemoryFragments,
    TownDecorations,
    CraftingCatalog,
    Consumables,
    ResidentRoster
)
--[[
    The third gate on a region, after its enabled flag and its chapter:
    can its builder actually draw a world a party could walk. Bramblewake
    can; the Delve and the Fen have module geometry and nothing else yet,
    and RegionBuilders is where that stays honest.
]]
RegionAccess.setReadinessProvider(function(regionId: string): boolean
    return RegionBuilders.readiness(regionId).walkable
end)

local expeditionService = ExpeditionService.new(
    logger,
    worldService,
    ExpeditionGenerator,
    RegionAccess,
    BramblewakeExpedition,
    featureFlags,
    ExpeditionEventFlow,
    ExpeditionRewardLedger,
    ExtractionPayoff,
    profileService,
    analyticsService,
    Config.BramblewakePreviewSeed,
    ExpeditionContracts
)
local survivalService = PlayerSurvivalService.new(
    logger,
    Config,
    RuntimeIds,
    ReviveFlow,
    SurvivalState,
    featureFlags,
    worldService,
    analyticsService
)
survivalService:setExpeditionFailureHandler(function(player: Player): any
    return expeditionService:failExpedition(player)
end)
local combatService = PlayerCombatService.new(
    logger,
    Config,
    CombatState,
    StatusEffectState,
    featureFlags,
    survivalService,
    analyticsService
)
local function equipmentStats(player: Player): any
    return profileService:equipmentStats(player)
end
survivalService:setEquipmentStatsProvider(equipmentStats)
combatService:setEquipmentStatsProvider(equipmentStats)
local professionService = ProfessionService.new(
    logger,
    ProfessionCatalog,
    ProfessionState,
    ProfessionMastery,
    ProfessionRescue,
    featureFlags,
    profileService,
    worldService,
    survivalService,
    analyticsService
)
survivalService:setReviveTuningProvider(function(player: Player): any
    return professionService:rescueTuning(
        player,
        Config.ReviveChannelSeconds,
        Config.ReviveHealth,
        Config.ReviveInvulnerabilitySeconds
    )
end)
local enemyService = EnemyService.new(
    logger,
    Config,
    worldService,
    survivalService,
    combatService,
    EnemyAttackFlow,
    EnemyCatalog,
    EnemyCombatRules,
    EnemyMotion,
    EngineerBrace,
    BramblewakeEnemyBuilder,
    analyticsService
)
professionService:setEnemyService(enemyService)
professionService:setCombatService(combatService)
expeditionService:bindEnemyService(enemyService)
enemyService:setProfessionService(professionService)
local companionService = CompanionService.new(logger, CompanionMotion)
--[[
    The six encounters the Delve and the Fen brought. Registered even
    though no region can open yet: a service that first boots on the day
    its content ships is a service nobody has ever booted, and that is the
    wrong day to find out.
]]
local regionEncounterService =
    RegionEncounterService.new(logger, profileService, survivalService, featureFlags)
local defenseService =
    DefenseService.new(logger, DefenseLanes, worldService, enemyService, profileService)
enemyService:setDefenseLanes(DefenseLanes)
local oldGrowthService = OldGrowthService.new(
    logger,
    worldService,
    expeditionService,
    survivalService,
    combatService,
    professionService,
    OldGrowthEncounter,
    EnemyAttackFlow,
    EnemyCombatRules,
    OldGrowthBuilder,
    analyticsService,
    featureFlags
)
enemyService:setEliteService(oldGrowthService)
local wardenStagService = WardenStagService.new(
    logger,
    worldService,
    expeditionService,
    survivalService,
    combatService,
    professionService,
    oldGrowthService,
    WardenStagEncounter,
    EnemyAttackFlow,
    EnemyCombatRules,
    WardenStagBuilder,
    analyticsService,
    featureFlags
)
enemyService:setBossService(wardenStagService)
local blackoutService = BramblewakeBlackoutService.new(
    logger,
    Config,
    worldService,
    expeditionService,
    profileService,
    survivalService,
    oldGrowthService,
    wardenStagService,
    BramblewakeBlackout,
    analyticsService,
    featureFlags
)
oldGrowthService:setActivationGate(function(): boolean
    return blackoutService:allowsOldGrowth()
end)
wardenStagService:setUnlockGate(function(): boolean
    return blackoutService:allowsWarden()
end)
local phaseService = PhaseService.new(
    logger,
    worldService,
    enemyService,
    NightSchedule,
    Config.FirstNightDuskSeconds,
    Config.FirstNightSeconds
)
local lobbyService = LobbyService.new(
    logger,
    Config,
    LobbyDeparture,
    RunHandoff,
    featureFlags,
    worldService,
    analyticsService
)
--[[
    Parties, and the way back to one. LobbyService measures who is standing on
    the departure platform every tick already, so the party service reads that
    rather than measuring the dais a second time: an invitation and a boarding
    pass have to agree about who was there, and two independent measurements
    is how they stop agreeing.
]]
local partyService =
    PartyService.new(logger, Config, PartySession, profileService, analyticsService)
partyService:setPlatformProvider(function(): { Player }
    return lobbyService:readyPlayers(lobbyService)
end)
lobbyService:setPartyService(partyService)
--[[
    Quick chat, the one channel a player has to another player. Registered
    beside the party service because they are the two halves of the same
    question -- who you are travelling with, and what you can say to them --
    and because the block list one of them consults is the block list the
    other one will (M11 wave D).
]]
local socialService =
    SocialService.new(logger, Config, QuickChat, RateLimiter, featureFlags, analyticsService)
--[[
    One block reader for the whole game. PartyService asks the same authority
    quick chat asks, rather than reaching for the platform a second time: a
    suppression rule with two homes is a rule that stops being true in one of
    them, and the safety review's whole claim is that every channel consults
    the same list.
]]
partyService:setBlockReader(function(fromUserId: number, toUserId: number): boolean
    return socialService:isSuppressed(fromUserId, toUserId)
end)

--[[
    The one module allowed to touch a purchase API, and the only grant
    authority in the game. Everything it decides is decided in the pure
    Entitlements module; what it owns is the profile write, the mailbox and the
    platform call.
]]
local commerceService = CommerceService.new(
    logger,
    Config,
    CosmeticCatalog,
    Entitlements,
    StoreCard,
    profileService,
    featureFlags,
    analyticsService
)

local performanceService = PerformanceService.new(
    logger,
    Config,
    PerformanceBudget,
    SessionSegment,
    analyticsService,
    SoakProbe
)
local adminService = AdminService.new(
    logger,
    AdminRoster,
    featureFlags,
    profileService,
    survivalService,
    combatService,
    worldService,
    expeditionService,
    performanceService,
    analyticsService
)
local townNightService = TownNightService.new(
    logger,
    Config,
    worldService,
    enemyService,
    TownNightSchedule,
    TownNightIncident,
    TownCondition,
    TownPermissions,
    TownVisitPolicy,
    TownGuardLastStand,
    analyticsService,
    featureFlags
)
townNightService:setDefense(defenseService, DefenseLanes)

--[[
    The soak, wired here because this is the only file that can see all
    three things it reads and none of them should learn about each other.

    The counters are injected rather than reached for. This service has no
    business knowing how many creatures EnemyService believes in or how
    large a profile encodes to, and a soak that reached across the server
    for its own numbers would be a second copy of every service's
    internals going stale on its own schedule.

    `LastLightSoak` is read **inside the observer, every cycle**, and that
    is not a style choice. A Studio Play session starts from a fresh
    DataModel that does not carry attributes set in Edit mode, so a check
    made once at boot can never be true in the only place this is ever
    driven from: the wiring existed, ran on every server, and was
    unreachable. Read per cycle it can also be turned on partway through a
    session, which is what a soak actually gets used like.

    Registering a counter costs nothing; running one costs a full
    descendant walk of the world. That is why the list is always installed
    and the sampling is not.
]]
performanceService:setSoakCounters({
    instances = function(): number
        return #workspace:GetDescendants()
    end,
    tracked_enemies = function(): number
        return enemyService:trackedCount()
    end,
    player_residue = function(): number
        return profileService:playerResidue()
    end,
    profile_bytes = function(): number
        return profileService:largestProfileBytes()
    end,
})
townNightService:setCycleObserver(function(cycle: number, phase: string)
    if game:GetAttribute("LastLightSoak") ~= true then
        return
    end
    if not performanceService:isSoaking() then
        performanceService:beginSoak(phase)
    end
    performanceService:sampleSoak(cycle, phase)
end)
--[[
    The private server's control rail.

    Constructed after the three things it can hold still, and it is the only
    caller of any of them: the profile write latch, the town clock's hold, the
    creature simulation's stillness and the expedition's rebuild all exist for
    this service. Keeping the callers to one is what makes "no private-server
    setting changes a reward" a claim about a single file rather than about
    however many places learned to stop the clock.
]]
local privateServerService = PrivateServerService.new(
    logger,
    PrivateServerControls,
    profileService,
    townNightService,
    enemyService,
    analyticsService
)
privateServerService:setExpeditionService(expeditionService)
--[[
    Who may visit this town, in the two pieces the service cannot supply
    itself.

    The policy is read once, from the founder's own profile, at the moment the
    server adopts them as host -- so a founder who disconnects leaves their
    gate exactly as they set it. The relation is the asynchronous half:
    friendship is a platform round trip, and a party membership is something
    PartyService already knows, so both are answered here and handed back
    through the callback rather than blocking a profile load on a web call.

    Order matters in the check. Being asked along beats being on a friends
    list, because the party is the group actually playing together; a stranger
    the founder invited onto the departure platform is somebody the founder
    chose, and a town set to "invited" should let them in.
]]
townNightService:setVisitPolicyProvider(function(hostUserId: number): string
    local hostPlayer = Players:GetPlayerByUserId(hostUserId)
    if hostPlayer == nil then
        return TownVisitPolicy.Default
    end
    return profileService:visitPolicy(hostPlayer)
end)
townNightService:setRelationResolver(
    function(actorUserId: number, hostUserId: number, resolve: (string) -> ())
        task.spawn(function()
            if partyService:sharesPartyWith(hostUserId, actorUserId) then
                resolve("invited")
                return
            end
            local hostPlayer = Players:GetPlayerByUserId(hostUserId)
            if hostPlayer ~= nil then
                local ok, friends = pcall(function(): boolean
                    return hostPlayer:IsFriendsWith(actorUserId)
                end)
                if ok and friends == true then
                    resolve("friend")
                    return
                end
                if not ok then
                    -- The platform did not answer. A stranger is the honest
                    -- reading and the safe one: it can only ever refuse, and a
                    -- refusal costs an upward contribution the town was fine
                    -- without, while a wrong "friend" opens a closed town.
                    logger:warn("town_friendship_unavailable", { host = hostUserId })
                end
            end
            resolve("stranger")
        end)
    end
)
survivalService:setPartyRecoveryProvider(
    function(eligiblePlayers: number, downedPlayers: number): any
        return townNightService:attemptLastStand(eligiblePlayers, downedPlayers)
    end
)
professionService:setSwitchProvider(function(player: Player): (boolean, string?)
    local profile = profileService:get(player)
    if profile == nil or profile.tutorial.complete ~= true then
        return false, "COMPLETE FIRST LIGHT TO CHOOSE A PROFESSION"
    end
    if phaseService:snapshot().nightActive or townNightService:isNightActive() then
        return false, "RETURN TO DAYLIGHT BEFORE SWITCHING PROFESSION"
    end
    if expeditionService:snapshot(player).active then
        return false, "RETURN THROUGH THE WAYHOME GATE BEFORE SWITCHING"
    end
    return true, nil
end)
local tutorialService = TutorialService.new(
    logger,
    Config,
    RuntimeIds,
    TutorialFlow,
    RateLimiter,
    featureFlags,
    networkService,
    profileService,
    worldService,
    enemyService,
    survivalService,
    combatService,
    professionService,
    phaseService,
    townNightService,
    lobbyService,
    expeditionService,
    oldGrowthService,
    wardenStagService,
    blackoutService,
    analyticsService,
    CraftingCatalog,
    Equipment,
    ResidentDialogue,
    ActionProgress,
    ToolCatalog,
    GearWear,
    GearTraits,
    Consumables,
    TownVisitPolicy,
    StoreAvailability
)

local services = ServiceRegistry.new({
    environment = environment,
    logger = logger,
    featureFlags = featureFlags,
    content = content,
    runtimeIds = RuntimeIds,
    saveSchema = SaveSchema,
    actionPayloadContract = ActionPayloadContract,
    adminInspectionReport = AdminInspectionReport,
    profilePersistence = ProfilePersistence,
    townVisitPolicy = TownVisitPolicy,
    privateServerControls = PrivateServerControls,
    profileBackup = ProfileBackup,
    config = Config,
})
services:register(featureFlags)
services:register(performanceService)
services:register(networkService)
services:register(profileService)
services:register(gearVisualService)
services:register(analyticsService)
services:register(worldService)
services:register(expeditionService)
services:register(survivalService)
services:register(combatService)
services:register(professionService)
services:register(enemyService)
services:register(oldGrowthService)
services:register(wardenStagService)
services:register(blackoutService)
services:register(phaseService)
services:register(lobbyService)
services:register(townNightService)
services:register(companionService)
services:register(defenseService)
services:register(regionEncounterService)
services:register(partyService)
services:register(socialService)
services:register(commerceService)
services:register(privateServerService)
-- Without this the departure countdown never reached a client: LobbyService
-- published every whole second into a handler nobody had set, so the panel
-- froze at "DEPARTING IN 10" while the server counted down and launched.
lobbyService:setChangedHandler(function(toast: string?)
    tutorialService:broadcastLobby(toast)
end)
worldService:setClickHandler(function(clicker: Player, interactionId: string)
    tutorialService:interactFromClick(clicker, interactionId)
end)
tutorialService:setCompanionService(companionService)
tutorialService:setPartyService(partyService)
tutorialService:setSocialService(socialService)
tutorialService:setCommerceService(commerceService)
tutorialService:setPrivateServerService(privateServerService)
--[[
    A grant has to arrive somewhere the buyer can see.

    `applyReceipt` and the mailbox drain both settle correctly on their own,
    and both were silent: the live pass granted a product, watched the ledger
    and the profile take it, and the card in front of the buyer went on saying
    NOT OWNED until an unrelated push happened along. A purchase that lands
    without a word is the one moment in this game where the player has already
    paid.
]]
commerceService:setGrantHandler(function(player: Player, granted: { string })
    -- A grant that handed over nothing is a bug somewhere behind this, not a
    -- sentence to read out: "0 THINGS ARE YOURS" is worse than silence.
    if #granted == 0 then
        return
    end
    tutorialService:announceTo(
        player,
        if #granted == 1
            then "IT IS YOURS — WEAR IT AT THE OUTFITTER"
            else string.format("%d THINGS ARE YOURS — WEAR THEM AT THE OUTFITTER", #granted)
    )
end)
partyService:setToastHandler(function(player: Player?, message: string)
    if player ~= nil then
        tutorialService:toastPlayer(player, message)
    else
        tutorialService:toastEveryone(message)
    end
end)
--[[
    Passive gear wears from the blows it softens: one point per mitigated
    hit, against the weapon's two per landed strike -- you strike more
    often than you are struck. Toasts only on a condition change, so the
    Field Book nags exactly twice per piece: once worn, once failing.
]]
survivalService:setGearWearAccruer(function(player: Player)
    for slot, itemId in profileService:equippedSnapshot(player) do
        if slot ~= "weapon" and type(itemId) == "string" then
            local wearResult = profileService:accrueGearWear(player, itemId, 1)
            if
                wearResult.applied
                and wearResult.conditionAfter ~= wearResult.conditionBefore
                and wearResult.conditionAfter ~= "sound"
            then
                local name =
                    string.upper((string.gsub((string.gsub(itemId, "^gear_", "")), "_", " ")))
                tutorialService:toastPlayer(
                    player,
                    if wearResult.conditionAfter == "failing"
                        then "YOUR " .. name .. " HAS FAILED — IT SHIELDS NOTHING NOW"
                        else "YOUR " .. name .. " IS WORN — IT PROTECTS LESS"
                )
            end
        end
    end
end)
regionEncounterService:setToastHandler(function(player: Player?, message: string)
    if player ~= nil then
        tutorialService:toastPlayer(player, message)
    else
        tutorialService:toastEveryone(message)
    end
end)
defenseService:setToastHandler(function(player: Player?, message: string)
    if player ~= nil then
        tutorialService:toastPlayer(player, message)
    else
        tutorialService:toastEveryone(message)
    end
end)
enemyService:setStrikeHandler(function(clicker: Player)
    tutorialService:strikeFromClick(clicker)
end)
oldGrowthService:setStrikeHandler(function(clicker: Player)
    tutorialService:strikeFromClick(clicker)
end)
wardenStagService:setStrikeHandler(function(clicker: Player)
    tutorialService:strikeFromClick(clicker)
end)
-- The three sample sources the server owns. Join time is measured to the
-- moment a profile is loaded, which is the first moment a player can actually
-- do anything, rather than to the moment their character appeared.
networkService:setPerformanceHandler(function(player: Player, payload: any)
    performanceService:acceptClientReport(player, payload)
end)
profileService:onLoaded(function(player: Player, profile: any)
    performanceService:markInteractive(player, profile.createdAt)
end)
networkService:setActionObserver(function(player: Player)
    performanceService:noteAction(player)
end)
adminService:setTutorialService(tutorialService)
services:register(adminService)
services:register(tutorialService)
services:initialize()
services:start()

logger:info("server_boot_complete", {
    build = Config.BuildVersion,
    contentDefinitions = content:count(),
    environment = environment,
    services = services:count(),
})
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="124">
        <Properties>
          <string name="Name">ServiceRegistry</string>
          <string name="Source"><![CDATA[--!strict

local ServiceRegistry = {}
ServiceRegistry.__index = ServiceRegistry

export type Service = {
    Name: string,
    Init: ((self: any, context: any) -> ())?,
    Start: ((self: any) -> ())?,
}

export type Registry = typeof(setmetatable(
    {} :: {
        _context: any,
        _ordered: { Service },
        _byName: { [string]: Service },
        _state: string,
    },
    ServiceRegistry
))

function ServiceRegistry.new(context: any): Registry
    return setmetatable({
        _context = context,
        _ordered = {},
        _byName = {},
        _state = "registering",
    }, ServiceRegistry)
end

function ServiceRegistry.register(self: Registry, service: Service)
    assert(self._state == "registering", "services can only register before initialization")
    assert(type(service.Name) == "string" and service.Name ~= "", "service must have a Name")
    assert(self._byName[service.Name] == nil, "duplicate service " .. service.Name)

    self._byName[service.Name] = service
    table.insert(self._ordered, service)
end

function ServiceRegistry.get(self: Registry, name: string): Service?
    return self._byName[name]
end

function ServiceRegistry.initialize(self: Registry)
    assert(self._state == "registering", "service registry already initialized")
    self._state = "initializing"

    for _, service in self._ordered do
        local initialize = service.Init
        if initialize ~= nil then
            local ok, message = xpcall(function()
                initialize(service, self._context)
            end, debug.traceback)
            if not ok then
                self._state = "failed"
                error(string.format("service %s failed to initialize: %s", service.Name, message))
            end
        end
    end

    self._state = "initialized"
end

function ServiceRegistry.start(self: Registry)
    assert(self._state == "initialized", "services must initialize before start")
    self._state = "starting"

    for _, service in self._ordered do
        local start = service.Start
        if start ~= nil then
            local ok, message = xpcall(function()
                start(service)
            end, debug.traceback)
            if not ok then
                self._state = "failed"
                error(string.format("service %s failed to start: %s", service.Name, message))
            end
        end
    end

    self._state = "started"
end

function ServiceRegistry.state(self: Registry): string
    return self._state
end

function ServiceRegistry.count(self: Registry): number
    return #self._ordered
end

return table.freeze(ServiceRegistry)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="125">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Runs admin commands typed in chat.

    Every decision about who may run what lives in the pure AdminRoster module.
    This service only listens, asks, and — if the answer is yes — performs the
    effect through the same service methods the game itself uses. It never
    reaches into state directly, so an admin command cannot put the game
    somewhere the game cannot otherwise be.

    Three properties matter more than the commands themselves:

      * The feature flag is a real off switch. It is checked on every message,
        not cached at startup, so flipping it stops admin commands mid-session
        for everyone including the roster.
      * Nothing is silent. Every accepted command is logged with the admin's
        user ID and the value applied, which is the audit trail the roadmap
        asks for before admin tooling counts as done.
      * Refusals are quiet to everyone else. An ordinary player typing chat
        gets no reply and no hint that a roster exists.
]]

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local AdminService = {}
AdminService.__index = AdminService
AdminService.Name = "AdminService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type AdminService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _adminRoster: any,
        _featureFlags: any,
        _profileService: any,
        _survivalService: any,
        _combatService: any,
        _tutorialService: any,
        _worldService: any,
        _expeditionService: any,
        _performanceService: any,
        _analyticsService: any,
    },
    AdminService
))

function AdminService.new(
    logger: Logger,
    adminRoster: any,
    featureFlags: any,
    profileService: any,
    survivalService: any,
    combatService: any,
    worldService: any,
    expeditionService: any,
    performanceService: any,
    analyticsService: any
): AdminService
    return setmetatable({
        Name = AdminService.Name,
        _logger = logger,
        _adminRoster = adminRoster,
        _featureFlags = featureFlags,
        _profileService = profileService,
        _survivalService = survivalService,
        _combatService = combatService,
        _tutorialService = nil,
        _worldService = worldService,
        _expeditionService = expeditionService,
        _performanceService = performanceService,
        _analyticsService = analyticsService,
    }, AdminService)
end

function AdminService.Init(_self: AdminService, _context: any) end

-- Set after construction because TutorialService is built later and owns the
-- player-facing toast an admin needs as confirmation.
function AdminService.setTutorialService(self: AdminService, tutorialService: any)
    self._tutorialService = tutorialService
end

function AdminService._reply(self: AdminService, player: Player, message: string)
    local tutorialService = self._tutorialService
    if tutorialService ~= nil then
        tutorialService:adminToast(player, message)
    end
end

function AdminService._run(self: AdminService, player: Player, decision: any)
    local command = decision.command

    if command == "night" then
        -- Town tier derives from the night count, so this is also how a
        -- tester brings the resident cast in without editing the gate that
        -- authored them to arrive with chapter one.
        self._profileService:setNightNumber(player, decision.value)
        self:_reply(
            player,
            string.format("NIGHT SET TO %d — REJOIN TO SEE THE TOWN", decision.value)
        )
    elseif command == "give" then
        self._tutorialService:adminGrantResources(player, decision.value)
        self:_reply(player, string.format("HEARTWOOD SET TO %d", decision.value))
    elseif command == "perf" then
        -- The headline goes to the toast because a tester on a phone cannot
        -- read a table, and every line goes to the log because whoever closes
        -- the exit gate needs the numbers rather than the verdict.
        local lines = self._performanceService:formattedReport()
        self:_reply(player, lines[1])
        for _, line in lines do
            self._logger:info("performance_report", { line = line })
        end
    elseif command == "heal" then
        self._survivalService:healInRadius(player, 500)
        self._combatService:restoreStamina(player, 100)
        self:_reply(player, "HEALED")
    elseif command == "phase" then
        local applied = self._worldService:adminSetPhase(decision.text)
        self:_reply(
            player,
            if applied
                then string.upper(decision.text) .. " APPLIED"
                else "PHASE UNAVAILABLE RIGHT NOW"
        )
    elseif command == "go" then
        -- Uses the same enter and exit the game uses, so an admin cannot
        -- arrive somewhere the transition would not normally put them.
        if command == nil then
            return
        end
        if decision.text == "bramblewake" then
            if player:GetAttribute("LastLightInExpedition") == true then
                self:_reply(player, "ALREADY IN BRAMBLEWAKE")
            else
                local entered = self._expeditionService:enter(player)
                self:_reply(player, if entered then "ENTERING BRAMBLEWAKE" else "ENTRY UNAVAILABLE")
            end
        else
            if player:GetAttribute("LastLightInExpedition") ~= true then
                self:_reply(player, "ALREADY IN TOWN")
            else
                local left = self._worldService:exitBramblewake(player)
                self:_reply(
                    player,
                    if left then "RETURNING TO EMBERHOLLOW" else "RETURN UNAVAILABLE"
                )
            end
        end
    elseif command == "where" then
        local root = if player.Character ~= nil
            then player.Character:FindFirstChild("HumanoidRootPart")
            else nil
        if root ~= nil and root:IsA("BasePart") then
            local at = root.Position
            self:_reply(player, string.format("%.0f, %.0f, %.0f", at.X, at.Y, at.Z))
        end
    elseif command == "inspect" then
        -- The roster only reaches this branch with allowed = true once
        -- decision.text is a non-empty string of bounded length -- see
        -- AdminRoster.authorize's inspect case -- so the cast documents an
        -- invariant this file does not itself enforce, rather than skips one.
        self:_inspect(player, decision.text :: string)
    elseif command == "unlock" then
        self:_unlock(player, decision.text :: string)
    elseif command == "backups" then
        self:_backups(player, decision.text :: string)
    elseif command == "restore" then
        self:_restore(player, decision.text :: string)
    elseif command == "restoreat" then
        self:_restoreAt(player, decision.text :: string, decision.value :: number)
    elseif command == "export" then
        self:_export(player, decision.text :: string)
    end

    self._logger:info("admin_command", {
        admin = player.UserId,
        command = command,
        value = decision.value,
        text = decision.text,
    })
end

--[[
    A username or a raw user ID, resolved to a user ID -- or nil, with the
    refusal already sent, so both /inspect and /unlock can share one lookup
    instead of two copies drifting apart.
]]
function AdminService._resolveTarget(self: AdminService, admin: Player, argument: string): number?
    local resolvedId: number? = tonumber(argument)
    if resolvedId == nil then
        local ok, byName = pcall(function()
            return Players:GetUserIdFromNameAsync(argument)
        end)
        if ok and type(byName) == "number" then
            resolvedId = byName
        end
    end
    if resolvedId == nil or resolvedId <= 0 then
        self:_reply(admin, "NO PLAYER NAMED " .. string.upper(argument))
        return nil
    end
    return math.floor(resolvedId)
end

--[[
    Reads a save without needing the target online, and writes the full
    result to the log rather than the toast.

    A toast is a HUD element sized for one line -- "HEALED", "NIGHT SET TO
    4". The report this produces has a dozen fields and is the actual audit
    record an operator wants, so it goes to Output next to profile_loaded and
    profile_saved, where the rest of a save's history already lives. The
    toast only confirms the command ran and gives the one number worth
    seeing without leaving the game.
]]
function AdminService._inspect(self: AdminService, admin: Player, argument: string)
    local userId = self:_resolveTarget(admin, argument)
    if userId == nil then
        return
    end

    local report = self._profileService:inspect(userId)
    if not report.found then
        self._logger:info("admin_inspection", {
            admin = admin.UserId,
            target = userId,
            found = false,
        })
        self:_reply(admin, string.format("NO SAVE ON RECORD FOR %d", userId))
        return
    end

    self._logger:info("admin_inspection", {
        admin = admin.UserId,
        target = userId,
        found = true,
        schemaVersion = report.schemaVersion,
        nightNumber = report.nightNumber,
        tutorialStage = report.tutorialStage,
        tutorialComplete = report.tutorialComplete,
        chapterOneStatus = report.chapterOneStatus,
        chapterOneDecision = report.chapterOneDecision,
        professionId = report.professionId,
        professionsWithMastery = report.professionsWithMastery,
        equippedCount = report.equippedCount,
        gearStacks = report.gearStacks,
        lockHeld = report.lock.held,
        lockHolder = report.lock.holder,
        lockStale = report.lock.stale,
    })
    self:_reply(
        admin,
        string.format(
            "%d — NIGHT %s · %s%s — SEE OUTPUT FOR FULL REPORT",
            userId,
            tostring(report.nightNumber),
            string.upper(tostring(report.tutorialStage)),
            if report.lock.held and report.lock.stale ~= true then " · LOCKED" else ""
        )
    )
end

--[[
    Lists the copies held for a player, changing nothing.

    Always the first half of a repair: /restore is a deliberate move backwards
    in someone's progress, and this is how an operator sees how far back it
    would go and why each copy was taken before deciding.
]]
function AdminService._backups(self: AdminService, admin: Player, argument: string)
    local userId = self:_resolveTarget(admin, argument)
    if userId == nil then
        return
    end

    local summary = self._profileService:backupSummary(userId)
    self._logger:info("admin_backup_list", {
        admin = admin.UserId,
        target = userId,
        count = summary.count,
        newestRevision = summary.newestRevision,
        newestCapturedAt = summary.newestCapturedAt,
        entries = summary.entries,
    })

    if summary.count == 0 then
        self:_reply(admin, string.format("NO BACKUPS ON RECORD FOR %d", userId))
        return
    end

    self:_reply(
        admin,
        string.format(
            "%d — %d BACKUP%s · NEWEST REV %s — SEE OUTPUT",
            userId,
            summary.count,
            if summary.count == 1 then "" else "S",
            tostring(summary.newestRevision)
        )
    )
end

--[[
    Rolls a save back to its newest copy.

    The write half, and the one command here that changes a player's progress
    rather than the world around them, so it is worth being explicit about what
    keeps it safe. ProfileService refuses while a live server holds the profile,
    copies the replaced profile before overwriting it -- so running /restore
    twice undoes the first -- and writes only a profile this player already had.
    Nothing here merges, tops up, or grants.
]]
--[[
    Restores a named copy (1 = oldest kept). The same safety rails as
    /restore -- pre-restore capture, lock refusal, revision advance -- with
    the one difference that the operator explicitly chose the point in
    history after reading /backups.
]]
function AdminService._restoreAt(
    self: AdminService,
    admin: Player,
    argument: string,
    copyIndex: number
)
    local userId = self:_resolveTarget(admin, argument)
    if userId == nil then
        return
    end
    local result = self._profileService:restoreLatestBackup(userId, copyIndex)
    self._logger:info("admin_restore_at", {
        admin = admin.UserId,
        target = userId,
        copyIndex = copyIndex,
        applied = result.applied,
        reason = result.reason,
        restoredRevision = result.restoredRevision,
    })
    if result.applied then
        self:_reply(
            admin,
            string.format(
                "%d — RESTORED COPY %d · REV %s (WAS %s)",
                userId,
                copyIndex,
                tostring(result.restoredRevision),
                tostring(result.fromRevision)
            )
        )
    elseif result.reason == "no_such_copy" then
        self:_reply(admin, string.format("%d — NO COPY %d ON RECORD", userId, copyIndex))
    else
        self:_reply(
            admin,
            string.format("%d — RESTORE UNAVAILABLE (%s)", userId, tostring(result.reason))
        )
    end
end

--[[
    Dumps the stored profile as JSON into the server log, chunked under the
    log line ceiling, and answers with a summary. The log is the export
    channel because chat truncates and this game ships no file I/O.
]]
function AdminService._export(self: AdminService, admin: Player, argument: string)
    local userId = self:_resolveTarget(admin, argument)
    if userId == nil then
        return
    end
    local result = self._profileService:exportProfile(userId)
    if not result.ok then
        self:_reply(
            admin,
            string.format("%d — EXPORT FAILED (%s)", userId, tostring(result.reason))
        )
        return
    end
    local json = result.json :: string
    local chunkSize = 3500
    local chunks = math.ceil(#json / chunkSize)
    for index = 1, chunks do
        self._logger:info("admin_export_chunk", {
            admin = admin.UserId,
            target = userId,
            chunk = index,
            of = chunks,
            data = string.sub(json, (index - 1) * chunkSize + 1, index * chunkSize),
        })
    end
    self:_reply(
        admin,
        string.format("%d — EXPORTED %d CHARS IN %d LOG CHUNKS", userId, #json, chunks)
    )
end

function AdminService._restore(self: AdminService, admin: Player, argument: string)
    local userId = self:_resolveTarget(admin, argument)
    if userId == nil then
        return
    end

    local result = self._profileService:restoreLatestBackup(userId)
    self._logger:info("admin_restore", {
        admin = admin.UserId,
        target = userId,
        applied = result.applied,
        reason = result.reason,
        fromRevision = result.fromRevision,
        restoredRevision = result.restoredRevision,
        capturedAt = result.capturedAt,
        schemaVersion = result.schemaVersion,
    })

    if result.applied then
        self:_reply(
            admin,
            string.format(
                "%d — RESTORED TO REV %s (WAS %s) · RUN AGAIN TO UNDO",
                userId,
                tostring(result.restoredRevision),
                tostring(result.fromRevision)
            )
        )
        return
    end

    local reply = if result.reason == "no_backup_on_record"
        then string.format("NO BACKUPS ON RECORD FOR %d", userId)
        elseif result.reason == "no_save_on_record" then string.format(
            "NO SAVE ON RECORD FOR %d",
            userId
        )
        elseif result.reason == "lock_is_active" then string.format(
            "%d — A SERVER IS STILL HOLDING THIS SAVE",
            userId
        )
        else string.format("%d — RESTORE UNAVAILABLE RIGHT NOW", userId)
    self:_reply(admin, reply)
end

--[[
    Clears a lock, but only the ProfileService method backing this will ever
    clear a lock that is already dead. Every refusal reason it can return
    means the same thing to a player waiting to get back in: try rejoining
    now, because the lock either never existed, was already gone, or was
    just cleared. The one reason that does not is lock_is_active, and that
    one is not a bug to route around -- it means a server is still genuinely
    holding this save, and forcing it open from here is the exact race this
    whole system exists to prevent.
]]
function AdminService._unlock(self: AdminService, admin: Player, argument: string)
    local userId = self:_resolveTarget(admin, argument)
    if userId == nil then
        return
    end

    local result = self._profileService:forceUnlock(userId)
    self._logger:info("admin_unlock", {
        admin = admin.UserId,
        target = userId,
        applied = result.applied,
        reason = result.reason,
    })

    if result.applied then
        self:_reply(admin, string.format("%d — LOCK CLEARED (%s)", userId, result.reason))
        return
    end

    local reply = if result.reason == "no_save_on_record"
        then string.format("NO SAVE ON RECORD FOR %d", userId)
        elseif result.reason == "already_unlocked" then string.format(
            "%d — NOT LOCKED",
            userId
        )
        elseif result.reason == "lock_is_active" then string.format(
            "%d — A SERVER IS STILL HOLDING THIS SAVE",
            userId
        )
        else string.format("%d — UNLOCK UNAVAILABLE RIGHT NOW", userId)
    self:_reply(admin, reply)
end

function AdminService._onChatted(self: AdminService, player: Player, message: string)
    local decision = self._adminRoster.authorize(
        player.UserId,
        message,
        self._featureFlags:isEnabled("admin_commands_enabled")
    )
    if decision.allowed then
        local ok, err = pcall(function()
            self:_run(player, decision)
        end)
        if not ok then
            self._logger:warn("admin_command_failed", {
                admin = player.UserId,
                command = decision.command,
                error = tostring(err),
            })
            self:_reply(player, "THAT COMMAND FAILED")
        end
        return
    end

    --[[
        Somebody who is not on the roster typing a real command.

        This is the one refusal worth counting, and it is deliberately counted
        *before* the silence rule below: they still hear nothing, because a
        reply is how a roster gets probed, but a stranger reaching for /restore
        is exactly the "unauthorized admin mutation" the zero-tolerance gate
        names and it must not be invisible to the people watching. Ordinary
        chat is not counted, because ordinary chat is not an attempt.
    ]]
    -- GATE-METRIC: unauthorized_mutation
    if decision.reason == "not_an_admin" then
        self._analyticsService:unauthorizedMutation(
            player.UserId,
            "admin_command",
            tostring(decision.command)
        )
    end

    -- Ordinary chat produces nothing at all. Only someone who typed a real
    -- command and is on the roster hears why it was refused, so the roster
    -- stays invisible to everyone else.
    if decision.reason == "not_a_command" or decision.reason == "not_an_admin" then
        return
    end
    if not self._adminRoster.isAdmin(player.UserId) then
        return
    end
    if decision.reason == "out_of_range" then
        self:_reply(
            player,
            string.format(
                "%s TAKES %d TO %d",
                string.upper(tostring(decision.command)),
                decision.low,
                decision.high
            )
        )
    elseif decision.reason == "unknown_destination" then
        self:_reply(player, "GO TAKES TOWN OR BRAMBLEWAKE")
    elseif decision.reason == "unknown_phase" then
        self:_reply(player, "PHASE TAKES DAY, DUSK, OR NIGHT")
    elseif decision.reason == "invalid_inspection_target" then
        self:_reply(player, "INSPECT TAKES A USERNAME OR USER ID")
    elseif decision.reason == "invalid_unlock_target" then
        self:_reply(player, "UNLOCK TAKES A USERNAME OR USER ID")
    elseif decision.reason == "invalid_backup_target" then
        self:_reply(
            player,
            string.format(
                "%s TAKES A USERNAME OR USER ID",
                string.upper(tostring(decision.command))
            )
        )
    elseif decision.reason == "admin_disabled" then
        self:_reply(player, "ADMIN COMMANDS ARE OFF")
    end
end

--[[
    Register one TextChatCommand per admin command.

    Player.Chatted is a legacy-chat event and does not fire when an
    experience uses TextChatService, which is the default for anything made
    recently. Every admin command in this game was therefore dead on arrival:
    the message went out as ordinary chat, nothing listened, and the only
    symptom was that typing it did nothing at all.

    AutocompleteVisible is false on every one of them. A registered command
    otherwise appears in the chat autocomplete for every player in the
    server, which would advertise the roster to exactly the people the silent
    refusals elsewhere in this file exist to keep it from.
]]
function AdminService._registerChatCommands(self: AdminService)
    for _, name in self._adminRoster.commandNames() do
        local command = Instance.new("TextChatCommand")
        command.Name = "LastLightAdmin_" .. name
        command.PrimaryAlias = "/" .. name
        command.AutocompleteVisible = false
        command.Triggered:Connect(function(textSource: TextSource, text: string)
            local player = Players:GetPlayerByUserId(textSource.UserId)
            if player ~= nil then
                self:_onChatted(player, text)
            end
        end)
        command.Parent = TextChatService
    end
end

function AdminService.Start(self: AdminService)
    -- Both paths are wired because only one of them can fire. Under
    -- TextChatService the commands above carry every message and Chatted
    -- stays silent; under legacy chat there are no TextChatCommands and
    -- Chatted is the only route. Neither knows about the other, and running
    -- both costs nothing.
    local registered, err = pcall(function()
        self:_registerChatCommands()
    end)
    if not registered then
        self._logger:warn("admin_chat_commands_unavailable", { error = tostring(err) })
    end

    local function bind(player: Player)
        player.Chatted:Connect(function(message: string)
            self:_onChatted(player, message)
        end)
    end
    for _, player in Players:GetPlayers() do
        bind(player)
    end
    Players.PlayerAdded:Connect(bind)

    self._logger:info("admin_service_started", {
        admins = #self._adminRoster.adminUserIds(),
        enabled = self._featureFlags:isEnabled("admin_commands_enabled"),
        chatCommands = registered,
    })
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source"><![CDATA[--!strict

local RobloxAnalytics = game:GetService("AnalyticsService")
local RunService = game:GetService("RunService")

local AnalyticsService = {}
AnalyticsService.__index = AnalyticsService
AnalyticsService.Name = "AnalyticsService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type AnalyticsService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _startedAt: { [Player]: number },
        _expeditionStarted: { [Player]: boolean },
    },
    AnalyticsService
))

function AnalyticsService.new(logger: Logger): AnalyticsService
    return setmetatable({
        Name = AnalyticsService.Name,
        _logger = logger,
        _startedAt = {},
        _expeditionStarted = {},
    }, AnalyticsService)
end

function AnalyticsService.Init(_self: AnalyticsService, _context: any) end

function AnalyticsService.Start(_self: AnalyticsService) end

function AnalyticsService.stage(self: AnalyticsService, player: Player, step: number, stage: string)
    if self._startedAt[player] == nil then
        self._startedAt[player] = os.clock()
    end

    self._logger:info("tutorial_funnel_step", {
        player = player.UserId,
        stage = stage,
        step = step,
    })

    if not RunService:IsStudio() then
        local ok, message = pcall(function()
            RobloxAnalytics:LogOnboardingFunnelStepEvent(player, step, stage, {})
        end)
        if not ok then
            self._logger:warn("analytics_funnel_failed", {
                player = player.UserId,
                reason = tostring(message),
                stage = stage,
            })
        end
    end
end

function AnalyticsService.complete(self: AnalyticsService, player: Player)
    local startedAt = self._startedAt[player]
    local elapsed = if startedAt == nil then 0 else math.floor(os.clock() - startedAt)
    self._logger:info("tutorial_completed", {
        durationSeconds = elapsed,
        player = player.UserId,
    })

    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "FirstLightCompleted", math.max(1, elapsed), {})
        end)
    end
end

--[[
    The events a release gate is read from.

    RELEASE_GATES.md is the document a promotion decision is made against, and
    every threshold in it names a rate: transaction success, crash-free
    sessions, join failure, first-night completion, receipts that reached a
    grant. A rate needs a numerator and a denominator, and until this block
    existed most of them had neither -- which is the failure mode the gate
    document is least able to detect, because a dashboard reading zero and a
    dashboard reading nothing look identical to the person approving a
    release. A gate nobody measures is a gate nobody can fail.

    Each function below is the emitter one row of that document names, and the
    document names it back. `GateMetrics.spec` holds the two lists against each
    other in both directions, so a threshold added without an emitter fails on
    the day it is written down and an emitter that stops being called fails on
    the day its call site goes.

    Two rules the shape follows. **Every one of these is a server event**: the
    document says operational rates use authoritative server events and that
    client telemetry cannot hide a server failure, so nothing here is a client
    reporting its own success. And **every one carries the dimensions its
    per-segment threshold is read on**, because a gate that can only be read
    across the whole population is exactly the gate a phone-only failure hides
    behind.
]]

--[[
    One profile read or write, and whether it landed.

    The denominator of "profile load/save transaction success at least 99.9%".
    Both directions are the same event with a `kind`, because the gate is one
    number over both and splitting it into two events would let a build pass by
    counting only the easy half.
]]
function AnalyticsService.profileTransaction(
    self: AnalyticsService,
    userId: number,
    kind: string,
    ok: boolean,
    reason: string?
)
    self._logger:info("profile_transaction", {
        kind = string.sub(kind, 1, 24),
        ok = ok,
        reason = string.sub(reason or "ok", 1, 48),
        user = userId,
    })
end

--[[
    A save that is gone, or a stored profile that could not be understood.

    Zero-tolerance. This is deliberately not the same event as a failed
    transaction: a failed write that the next write repairs costs a player
    nothing, and folding the two together would bury the six-a-day event that
    stops a release under the thousand-a-day one that does not.
]]
function AnalyticsService.saveLoss(
    self: AnalyticsService,
    userId: number,
    kind: string,
    reason: string
)
    self._logger:warn("save_loss", {
        kind = string.sub(kind, 1, 24),
        reason = string.sub(reason, 1, 64),
        user = userId,
    })
end

--[[
    A session that reached play, with the two labels it is sliced by.

    "An interactive session begins when the player can move and act in
    Emberhollow, not when the client process starts" -- so this fires when the
    profile is loaded and the world will answer, not at PlayerAdded. It is the
    denominator of the crash-free gate, the sample it carries is the join p95
    gate, and `daysSinceFirstSession` is what D1 and D7 return are counted from.
]]
function AnalyticsService.sessionStarted(
    self: AnalyticsService,
    player: Player,
    joinSeconds: number,
    platform: string,
    daysSinceFirstSession: number
)
    self._logger:info("interactive_session", {
        daysSinceFirstSession = daysSinceFirstSession,
        joinSeconds = math.floor(joinSeconds * 100 + 0.5) / 100,
        -- Their first day, which is what "eligible new players" means in the
        -- gate document's denominators.
        newPlayer = daysSinceFirstSession <= 0,
        platform = platform,
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "InteractiveSession", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = platform,
            })
        end)
    end
end

--[[
    Somebody who joined and never got to play.

    The numerator of the join failure gate. Its denominator is this plus
    `interactive_session`, which is why both live in the same service and are
    emitted from the same place: counting failures against a denominator
    gathered somewhere else is how a rate quietly becomes a count.
]]
function AnalyticsService.joinFailed(
    self: AnalyticsService,
    player: Player,
    reason: string,
    waitedSeconds: number,
    platform: string
)
    self._logger:warn("join_failed", {
        platform = platform,
        player = player.UserId,
        reason = string.sub(reason, 1, 32),
        waitedSeconds = math.floor(waitedSeconds * 100 + 0.5) / 100,
    })
end

--[[
    How a session finished, which is the only way a crash is ever counted.

    Roblox has no crash signal. What a server can see is that a client stopped
    talking to it before it disappeared: telemetry arrives on a fixed interval,
    so a session whose last report is several intervals stale at the moment the
    player leaves did not close, it stopped. That is an approximation and the
    gate document says so; it is also the same approximation every crash-free
    metric on this platform is built on, and it is strictly better than a
    number nobody collects.
]]
function AnalyticsService.sessionEnded(
    self: AnalyticsService,
    userId: number,
    reason: string,
    durationSeconds: number,
    interactive: boolean,
    platform: string,
    segment: string
)
    self._logger:info("session_ended", {
        durationSeconds = math.floor(durationSeconds + 0.5),
        interactive = interactive,
        platform = platform,
        reason = string.sub(reason, 1, 24),
        segment = segment,
        user = userId,
    })
end

--[[
    A seed whose generated manifest could not be validated, so the known-good
    walk was handed out instead.

    Two gates read this. The fallback rate is a reliability threshold; a
    fallback on a *critical path* is zero-tolerance, because an impossible seed
    on the road to a chapter is a player who cannot finish the game. The event
    carries the region and the seed so the second can be reproduced rather than
    described.
]]
function AnalyticsService.generatorFallback(
    self: AnalyticsService,
    regionId: string,
    seed: number,
    reason: string
)
    self._logger:warn("generator_fallback", {
        reason = string.sub(reason, 1, 48),
        region = string.sub(regionId, 1, 48),
        seed = seed,
    })
end

--[[
    One player through their first night.

    "First-night completion after onboarding" is a ratio against players who
    finished onboarding, so it is emitted per player at the moment their own
    tutorial advances past the night, rather than once per server when the
    night resolves. A server-wide event would count a night, not a person, and
    the gate is about people.
]]
function AnalyticsService.firstNightCompleted(self: AnalyticsService, player: Player)
    self._logger:info("first_night_completed", { player = player.UserId })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "FirstNightCompleted", 1, {})
        end)
    end
end

--[[
    A request that tried to change something it had no right to change.

    Zero-tolerance covers "unauthorized economy, entitlement, admin, or
    progression mutation", and the honest reading is that the gate is about
    attempts that *succeeded*. Nothing here can emit that, because a mutation
    this game let through is by definition one it did not notice. What it can
    emit is every attempt it refused, which is the signal that says whether
    anybody is trying -- and the rate at which a refusal fires is the first
    place a hole shows up, since an exploit found is an exploit probed for
    first.
]]
function AnalyticsService.unauthorizedMutation(
    self: AnalyticsService,
    userId: number,
    surface: string,
    reason: string
)
    self._logger:warn("unauthorized_mutation", {
        reason = string.sub(reason, 1, 48),
        surface = string.sub(surface, 1, 32),
        user = userId,
    })
end

--[[
    Money taken and nothing handed over.

    The other zero-tolerance commerce event, and the one that costs a real
    person real currency: a receipt this build cannot resolve to a product, or
    a grant whose durable write did not land. Both leave the platform holding a
    completed purchase with no entitlement behind it. Neither is a retry --
    `receipt_result` carries those -- because a retry is the system working.
]]
function AnalyticsService.purchaseLoss(
    self: AnalyticsService,
    userId: number,
    productId: string,
    reason: string
)
    self._logger:warn("purchase_loss", {
        product = string.sub(productId, 1, 48),
        reason = string.sub(reason, 1, 48),
        user = userId,
    })
end

--[[
    What the platform's purchase prompt came back as.

    "Canceled prompts produce no receipt and no grant" is a gate about
    something *not* happening, and the only way to check that a cancel produced
    nothing is to know a cancel happened. Without this the metric is the
    absence of an event, which is indistinguishable from the store being shut.
]]
function AnalyticsService.purchasePlatformResult(
    self: AnalyticsService,
    userId: number,
    productId: string,
    purchased: boolean
)
    self._logger:info("purchase_platform_result", {
        product = string.sub(productId, 1, 48),
        purchased = purchased,
        user = userId,
    })
end

function AnalyticsService.expeditionStarted(self: AnalyticsService, player: Player, snapshot: any)
    if self._expeditionStarted[player] then
        return
    end
    self._expeditionStarted[player] = true

    self._logger:info("expedition_started", {
        hash = snapshot.manifestHash,
        player = player.UserId,
        region = "region_bramblewake",
        seed = snapshot.seed,
        source = snapshot.source,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "BramblewakeExpeditionStarted", 1, {})
        end)
    end
end

function AnalyticsService.expeditionEventStarted(
    self: AnalyticsService,
    player: Player,
    definition: any,
    manifestHash: string
)
    self._logger:info("expedition_event_started", {
        event = definition.id,
        hash = manifestHash,
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, definition.analyticsId .. "Started", 1, {})
        end)
    end
end

function AnalyticsService.expeditionEventCompleted(
    self: AnalyticsService,
    player: Player,
    definition: any,
    manifestHash: string,
    transactionId: string,
    participantCount: number
)
    self._logger:info("expedition_event_completed", {
        event = definition.id,
        hash = manifestHash,
        participantCount = participantCount,
        player = player.UserId,
        transaction = transactionId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(
                player,
                definition.analyticsId .. "Completed",
                math.max(1, participantCount),
                {}
            )
        end)
    end
end

function AnalyticsService.expeditionEventFailed(
    self: AnalyticsService,
    eventId: string,
    manifestHash: string,
    participantCount: number
)
    self._logger:info("expedition_event_failed", {
        event = eventId,
        hash = manifestHash,
        participantCount = participantCount,
        reason = "expired",
    })
end

function AnalyticsService.expeditionExtracted(
    self: AnalyticsService,
    player: Player,
    manifestHash: string,
    settlementId: string?,
    bankedAmount: number
)
    self._logger:info("expedition_extracted", {
        bankedAmount = bankedAmount,
        hash = manifestHash,
        player = player.UserId,
        settlement = settlementId or "empty",
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(
                player,
                "BramblewakeExtracted",
                math.max(1, bankedAmount),
                {}
            )
        end)
    end
end

function AnalyticsService.expeditionExtractionFailed(
    self: AnalyticsService,
    player: Player,
    manifestHash: string,
    reason: string?
)
    self._logger:warn("expedition_extraction_failed", {
        hash = manifestHash,
        player = player.UserId,
        reason = reason or "unknown",
    })
end

function AnalyticsService.playerDowned(self: AnalyticsService, player: Player, source: string)
    self._logger:info("player_downed", {
        player = player.UserId,
        source = source,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "PlayerDowned", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = source,
            })
        end)
    end
end

function AnalyticsService.playerRevived(
    self: AnalyticsService,
    player: Player,
    reviver: Player,
    duration: number
)
    self._logger:info("player_revived", {
        duration = duration,
        player = player.UserId,
        reviver = reviver.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "PlayerRevived", 1, {})
        end)
    end
end

function AnalyticsService.playerRecovered(self: AnalyticsService, player: Player, reason: string)
    self._logger:info("player_recovered", {
        player = player.UserId,
        reason = reason,
    })
end

function AnalyticsService.lobbyDeparture(
    self: AnalyticsService,
    player: Player?,
    action: string,
    accepted: boolean,
    reason: string?,
    value: any
)
    self._logger:info("lobby_departure", {
        action = action,
        accepted = accepted,
        reason = reason,
        value = value,
        player = if player ~= nil then player.UserId else nil,
    })
end

function AnalyticsService.combatAction(
    self: AnalyticsService,
    player: Player,
    action: string,
    applied: boolean,
    reason: string?,
    stamina: number
)
    self._logger:info("combat_action", {
        action = action,
        applied = applied,
        player = player.UserId,
        reason = reason or "accepted",
        stamina = math.floor(stamina + 0.5),
    })
    if applied and action == "dodge" and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "CombatDodgeUsed", 1, {})
        end)
    end
end

function AnalyticsService.enemyAttackResult(
    self: AnalyticsService,
    player: Player,
    result: string,
    enemyId: string?
)
    local resolvedEnemyId = string.sub(enemyId or "enemy_unknown", 1, 48)
    self._logger:info("enemy_attack_result", {
        enemy = resolvedEnemyId,
        player = player.UserId,
        result = result,
    })
    if result == "dodged" and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "EnemyAttackDodged", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = resolvedEnemyId,
            })
        end)
    end
end

function AnalyticsService.professionSelected(
    self: AnalyticsService,
    player: Player,
    professionId: string,
    accepted: boolean,
    reason: string?
)
    self._logger:info("profession_selected", {
        accepted = accepted,
        player = player.UserId,
        profession = string.sub(professionId, 1, 32),
        reason = reason or "accepted",
    })
    if accepted and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "ProfessionSelected", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = professionId,
            })
        end)
    end
end

function AnalyticsService.professionAbility(
    self: AnalyticsService,
    player: Player,
    professionId: string,
    accepted: boolean,
    reason: string?,
    affected: number
)
    self._logger:info("profession_ability", {
        accepted = accepted,
        affected = affected,
        player = player.UserId,
        profession = string.sub(professionId, 1, 32),
        reason = reason or "accepted",
    })
    if accepted and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "ProfessionAbilityUsed", math.max(1, affected), {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = professionId,
            })
        end)
    end
end

function AnalyticsService.professionMasteryRank(
    self: AnalyticsService,
    player: Player,
    professionId: string,
    level: number,
    rankName: string
)
    self._logger:info("profession_mastery_rank", {
        level = level,
        player = player.UserId,
        profession = string.sub(professionId, 1, 32),
        rank = string.sub(rankName, 1, 24),
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "ProfessionMasteryRank", level, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = professionId,
                [Enum.AnalyticsCustomFieldKeys.CustomField02.Name] = rankName,
            })
        end)
    end
end

