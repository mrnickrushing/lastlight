        id = "quest_mystery_mireglass",
        displayName = "WHAT THE WATER TOOK",
        objective = table.freeze({
            kind = "fragments_in_region",
            regionId = "region_mireglass",
            threshold = 2,
        }),
        reward = table.freeze({ materialId = "material_mirror_reed", amount = 8 }),
    }),
    quest_mystery_tempest = table.freeze({
        id = "quest_mystery_tempest",
        displayName = "WHAT THE COAST SIGNALLED",
        objective = table.freeze({
            kind = "fragments_in_region",
            regionId = "region_tempest",
            threshold = 2,
        }),
        reward = table.freeze({ materialId = "material_storm_glass", amount = 8 }),
    }),
    quest_mystery_frostmere = table.freeze({
        id = "quest_mystery_frostmere",
        displayName = "WHAT THE VALLEY STOPPED SAYING",
        objective = table.freeze({
            kind = "fragments_in_region",
            regionId = "region_frostmere",
            threshold = 2,
        }),
        reward = table.freeze({ materialId = "material_aurora_salt", amount = 8 }),
    }),
    quest_mystery_cinderfall = table.freeze({
        id = "quest_mystery_cinderfall",
        displayName = "WHAT THE CROWN WOULD NOT SAY",
        objective = table.freeze({
            kind = "fragments_in_region",
            regionId = "region_cinderfall",
            threshold = 2,
        }),
        reward = table.freeze({ materialId = "material_ash_silk", amount = 8 }),
    }),
}

function QuestCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function QuestCatalog.get(id: string): Quest?
    return DEFINITIONS[id]
end

function QuestCatalog.list(): { Quest }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

return table.freeze(QuestCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="85">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[--!strict

local QuestCatalog = require("./QuestCatalog")

local Quests = {}

export type Signals = {
    nightsSurvived: number,
    craftedItems: number,
    bramblewakeSettlements: number,
    -- Milestone 7's resident quests. Every one of these is derived from
    -- something the profile already stores, so no new tracking rides
    -- along with the new residents.
    buildingsRaised: number,
    decorationsPlaced: number,
    gearTraits: number,
    materialsBanked: number,
    residentsBonded: number,
    --[[
        The Reach's and the Vale's residents. Both of these are counts of
        things the profile already stores -- resolved chapters and
        recovered fragments -- for the same reason the milestone-7 group
        was: a resident quest must not be the thing that introduces a new
        piece of tracking, because then the quest owns a system and the
        system cannot be changed without the quest noticing.
    ]]
    chaptersResolved: number,
    fragmentsRecovered: number,
    --[[
        Keyed signals. The counts above answer "how many"; these answer
        "how many of that one", which is the difference between a quest
        that any activity satisfies and a quest that sends a player
        somewhere specific. An objective using one names its key, so the
        catalog stays the only place that decides what a quest is about.
    ]]
    fragmentsByRegion: { [string]: number },
    masteryByProfession: { [string]: number },
}

local function currentValue(objective: any, signals: Signals): number
    local kind = objective.kind
    if kind == "fragments_in_region" then
        return signals.fragmentsByRegion[tostring(objective.regionId)] or 0
    elseif kind == "profession_mastery" then
        return signals.masteryByProfession[tostring(objective.professionId)] or 0
    elseif kind == "survive_nights" then
        return signals.nightsSurvived
    elseif kind == "craft_items" then
        return signals.craftedItems
    elseif kind == "bramblewake_settlements" then
        return signals.bramblewakeSettlements
    elseif kind == "buildings_raised" then
        return signals.buildingsRaised
    elseif kind == "decorations_placed" then
        return signals.decorationsPlaced
    elseif kind == "gear_traits" then
        return signals.gearTraits
    elseif kind == "materials_banked" then
        return signals.materialsBanked
    elseif kind == "residents_bonded" then
        return signals.residentsBonded
    elseif kind == "chapters_resolved" then
        return signals.chaptersResolved
    elseif kind == "fragments_recovered" then
        return signals.fragmentsRecovered
    end
    return 0
end

function Quests.default(): { [string]: boolean }
    return {}
end

function Quests.normalizeClaimed(value: any): { [string]: boolean }
    local claimed: { [string]: boolean } = {}
    if type(value) ~= "table" then
        return claimed
    end
    for questId, isClaimed in value do
        if QuestCatalog.isValid(questId) and isClaimed == true then
            claimed[questId] = true
        end
    end
    return claimed
end

-- Progress is always read live from `signals`, never stored, so a quest
-- that briefly regresses (e.g. crafting an item and then using it up)
-- doesn't lose credit once already claimed — only the claimed set persists.
--[[
    Whether a quest's arc has reached it yet. A stage whose predecessor is
    unclaimed is not merely hidden -- it does not progress either, so a
    player cannot satisfy stage three by accident while stage one is still
    open and then have both claim themselves in the same tick.
]]
function Quests.isUnlocked(questId: string, claimed: { [string]: boolean }): boolean
    local quest = QuestCatalog.get(questId)
    if quest == nil then
        return false
    end
    local requires = quest.requires
    if requires == nil then
        return true
    end
    return claimed[requires] == true
end

function Quests.progress(questId: string, signals: Signals): (number, number, boolean)
    if not QuestCatalog.isValid(questId) then
        return 0, 0, false
    end
    local quest = QuestCatalog.get(questId) :: QuestCatalog.Quest
    local current = currentValue(quest.objective, signals)
    local threshold = quest.objective.threshold
    return current, threshold, current >= threshold
end

function Quests.snapshot(claimed: { [string]: boolean }, signals: Signals): { any }
    local result = {}
    for _, quest in QuestCatalog.list() do
        local unlocked = Quests.isUnlocked(quest.id, claimed)
        local current, threshold, complete = Quests.progress(quest.id, signals)
        table.insert(result, {
            claimed = claimed[quest.id] == true,
            complete = complete and unlocked,
            displayName = quest.displayName,
            id = quest.id,
            locked = not unlocked,
            progress = if unlocked then current else 0,
            requires = quest.requires,
            threshold = threshold,
        })
    end
    return result
end

-- Silently claims every not-yet-claimed quest whose objective is currently
-- met, granting each one's material reward. Called opportunistically after
-- any action that could move a signal (a night completing, a craft
-- succeeding, an expedition settling) rather than through an accept step.
-- Resident quest-givers surface this progress and its story context, so a quest that's already
-- satisfiable claims itself the moment it's checked.
function Quests.checkAndClaim(
    claimed: { [string]: boolean },
    materials: { [string]: number },
    signals: Signals
): ({ [string]: boolean }, { [string]: number }, { any })
    local claimedResults = {}
    local nextClaimed = claimed
    local nextMaterials = materials

    for _, quest in QuestCatalog.list() do
        --[[
            Unlock is judged against the set this pass started with, not
            the running one. Otherwise claiming stage one would unlock
            stage two inside the same loop and a player who had already
            satisfied everything would receive a whole arc's rewards in
            one tick without ever hearing the next request. One stage per
            arc per pass; the next pass takes the next one.
        ]]
        if claimed[quest.id] ~= true and Quests.isUnlocked(quest.id, claimed) then
            local _current, _threshold, complete = Quests.progress(quest.id, signals)
            if complete then
                if nextClaimed == claimed then
                    nextClaimed = table.clone(claimed)
                end
                if nextMaterials == materials then
                    nextMaterials = table.clone(materials)
                end
                nextClaimed[quest.id] = true
                nextMaterials[quest.reward.materialId] = (
                    nextMaterials[quest.reward.materialId] or 0
                ) + quest.reward.amount
                table.insert(claimedResults, {
                    displayName = quest.displayName,
                    questId = quest.id,
                    reward = table.clone(quest.reward),
                })
            end
        end
    end

    return nextClaimed, nextMaterials, claimedResults
end

return table.freeze(Quests)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">QuickChat</string>
          <string name="Source"><![CDATA[--!strict

--[[
    What a player is allowed to say to another player, and where it lands.

    This is a closed vocabulary rather than a chat box, and that is the whole
    design. Free text in a game with a young audience means a moderation
    pipeline, a filter, an appeal path and a human reading reports; a fixed
    list of twenty-four phrases means moderation is structural -- there is no
    string a player can compose, so there is nothing to moderate. The safety
    review in Milestone 11 reads that as a property of the code rather than as
    a promise about it.

    A phrase does two things at once. It says something, and it marks a place:
    **the sender's own position, resolved by the server**. The payload that
    carries a phrase carries a phrase id and nothing else -- no vector, no
    target, no name -- which is both the one-extra-field contract every action
    here obeys and the reason a ping cannot be forged into marking somewhere
    the sender is not standing. #219 is the reason that rule is a wall: the
    departure press quietly grew a second field and every real press was
    dropped for months.

    Courtesy is the exception, and deliberately: a thank-you is speech, and
    speech has no place in it. Those six phrases resolve to a ping kind that
    marks nothing, so they appear in the call log and never as a marker in the
    world. Six people being polite must not put six cards over the town.

    Presentation lives here too, as plain numbers, for the reason the census
    keeps teaching: a colour the client picks by name is a colour a new ping
    kind silently does not have. Everything the HUD needs to draw a ping comes
    off the catalog entry, so a phrase that exists is a phrase that can be
    drawn.
]]

export type PingKind = {
    id: string,
    label: string,
    glyph: string,
    seconds: number,
    marks: boolean,
    colour: { number },
}

export type Phrase = {
    id: string,
    category: string,
    text: string,
    ping: string,
}

export type Call = {
    id: string,
    phraseId: string,
    category: string,
    text: string,
    ping: string,
    fromUserId: number,
    fromName: string,
    at: number,
    expiresAt: number,
    marks: boolean,
    x: number?,
    y: number?,
    z: number?,
}

local QuickChat = {
    -- A phrase id is a catalog key, and the catalog is the only source of
    -- them. The bound is here so the transport can refuse a long string
    -- before anything looks it up.
    MaxPhraseIdLength = 32,
    -- How many calls the server keeps. Long enough that a player who looked
    -- away sees what was said, short enough that a log is not a chat history.
    LogLength = 6,
}

local PING_KINDS: { PingKind } = {
    {
        id = "danger",
        label = "DANGER",
        glyph = "▲",
        seconds = 8,
        marks = true,
        colour = { 214, 88, 72 },
    },
    {
        id = "aid",
        label = "AID",
        glyph = "✚",
        -- The longest life of any marker. A player asking for help is asking
        -- for a walk, and a walk across a module takes longer than a callout
        -- is worth remembering.
        seconds = 20,
        marks = true,
        colour = { 255, 186, 92 },
    },
    {
        id = "move",
        label = "MOVE",
        glyph = "➤",
        seconds = 6,
        marks = true,
        colour = { 146, 206, 142 },
    },
    {
        id = "hold",
        label = "HOLD",
        glyph = "■",
        seconds = 12,
        marks = true,
        colour = { 168, 190, 200 },
    },
    {
        id = "found",
        label = "FOUND",
        glyph = "◆",
        -- A node does not walk away, so the marker on it outlives every other
        -- kind. This is the one a party actually navigates by.
        seconds = 30,
        marks = true,
        colour = { 226, 198, 128 },
    },
    {
        id = "reply",
        label = "REPLY",
        glyph = "·",
        -- Spoken, not placed. Zero seconds is not a marker that vanishes
        -- instantly; marks = false means one is never built at all.
        seconds = 6,
        marks = false,
        colour = { 200, 208, 202 },
    },
}

local CATEGORIES = {
    { id = "danger", label = "DANGER" },
    { id = "direction", label = "DIRECTION" },
    { id = "need", label = "NEED" },
    { id = "courtesy", label = "COURTESY" },
}

--[[
    Twenty-four phrases, six per category, written to be useful on a night
    rather than to be a greeting card. Every one of them is something this
    game actually asks a party to say: the lantern is the shared clock, being
    downed is the loudest thing that happens to anybody, and a harvest node
    somebody else found is the difference between banking a pouch and not.
]]
local PHRASES: { Phrase } = {
    { id = "qc_enemy_here", category = "danger", text = "ENEMY HERE", ping = "danger" },
    { id = "qc_something_big", category = "danger", text = "SOMETHING BIG", ping = "danger" },
    {
        id = "qc_lantern_failing",
        category = "danger",
        text = "THE LANTERN IS FAILING",
        ping = "danger",
    },
    { id = "qc_i_am_down", category = "danger", text = "I AM DOWN", ping = "aid" },
    { id = "qc_fall_back", category = "danger", text = "FALL BACK", ping = "danger" },
    { id = "qc_watch_the_dark", category = "danger", text = "WATCH THE DARK", ping = "danger" },

    { id = "qc_going_here", category = "direction", text = "GOING HERE", ping = "move" },
    { id = "qc_this_way", category = "direction", text = "THIS WAY", ping = "move" },
    { id = "qc_holding_here", category = "direction", text = "HOLDING HERE", ping = "hold" },
    { id = "qc_wait_for_me", category = "direction", text = "WAIT FOR ME", ping = "hold" },
    {
        id = "qc_for_the_gate",
        category = "direction",
        text = "HEADING FOR THE GATE",
        ping = "move",
    },
    { id = "qc_splitting_off", category = "direction", text = "SPLITTING OFF", ping = "move" },

    { id = "qc_need_help", category = "need", text = "NEED HELP", ping = "aid" },
    { id = "qc_need_rootfire", category = "need", text = "NEED ROOTFIRE", ping = "aid" },
    { id = "qc_short_materials", category = "need", text = "SHORT ON MATERIALS", ping = "aid" },
    { id = "qc_harvest_here", category = "need", text = "HARVEST HERE", ping = "found" },
    { id = "qc_memory_here", category = "need", text = "A MEMORY HERE", ping = "found" },
    { id = "qc_event_here", category = "need", text = "SOMETHING HAPPENING HERE", ping = "found" },

    { id = "qc_yes", category = "courtesy", text = "YES", ping = "reply" },
    { id = "qc_no", category = "courtesy", text = "NO", ping = "reply" },
    { id = "qc_ready", category = "courtesy", text = "READY", ping = "reply" },
    { id = "qc_thank_you", category = "courtesy", text = "THANK YOU", ping = "reply" },
    { id = "qc_my_mistake", category = "courtesy", text = "MY MISTAKE", ping = "reply" },
    { id = "qc_well_done", category = "courtesy", text = "WELL DONE", ping = "reply" },
}

local pingById: { [string]: PingKind } = {}
for _, kind in PING_KINDS do
    assert(pingById[kind.id] == nil, "duplicate quick chat ping kind: " .. kind.id)
    pingById[kind.id] = table.freeze(kind)
end

local categoryById: { [string]: { id: string, label: string } } = {}
for _, category in CATEGORIES do
    assert(categoryById[category.id] == nil, "duplicate quick chat category: " .. category.id)
    categoryById[category.id] = table.freeze(category)
end

local phraseById: { [string]: Phrase } = {}
local phrasesByCategory: { [string]: { Phrase } } = {}
for _, phrase in PHRASES do
    assert(phraseById[phrase.id] == nil, "duplicate quick chat phrase: " .. phrase.id)
    assert(
        categoryById[phrase.category] ~= nil,
        string.format("quick chat phrase %s names no category", phrase.id)
    )
    assert(
        pingById[phrase.ping] ~= nil,
        string.format("quick chat phrase %s names no ping kind", phrase.id)
    )
    assert(
        #phrase.id <= QuickChat.MaxPhraseIdLength,
        string.format("quick chat phrase id %s is longer than the transport allows", phrase.id)
    )
    phraseById[phrase.id] = table.freeze(phrase)
    local bucket = phrasesByCategory[phrase.category]
    if bucket == nil then
        bucket = {}
        phrasesByCategory[phrase.category] = bucket
    end
    table.insert(bucket, phraseById[phrase.id])
end
for _, bucket in phrasesByCategory do
    table.freeze(bucket)
end

--[[
    The wheel the client draws, as data.

    The equip panel shipped as a hardcoded list of eight items and left ninety
    craftable items unwearable with every spec green (#299). A phrase wheel is
    the same shape: a hand-written list of buttons beside a catalog is a
    catalog with entries nobody can reach. So the layout is derived here and
    the spec can assert that walking it visits every phrase exactly once.
]]
function QuickChat.wheel(): { { category: string, label: string, phrases: { Phrase } } }
    local wheel = {}
    for _, category in CATEGORIES do
        table.insert(wheel, {
            category = category.id,
            label = category.label,
            phrases = phrasesByCategory[category.id] or {},
        })
    end
    return wheel
end

function QuickChat.list(): { Phrase }
    return PHRASES
end

function QuickChat.categories(): { { id: string, label: string } }
    return CATEGORIES
end

function QuickChat.pingKinds(): { PingKind }
    return PING_KINDS
end

function QuickChat.byId(phraseId: any): Phrase?
    if type(phraseId) ~= "string" or #phraseId > QuickChat.MaxPhraseIdLength then
        return nil
    end
    return phraseById[phraseId]
end

function QuickChat.pingKind(kindId: any): PingKind?
    if type(kindId) ~= "string" then
        return nil
    end
    return pingById[kindId]
end

--[[
    Build the record of one thing said.

    Pure, and given the position rather than asking for it: the shared layer
    cannot hold a Vector3 (the Lune runner has no Roblox datatypes, and a
    first draft of CompanionMotion failed typecheck for exactly this), and
    more importantly the position must come from the server reading the
    sender's own character. A caller that has no position -- a player without
    a character, mid-respawn -- still gets a call; it simply marks nothing.
]]
function QuickChat.call(
    phrase: Phrase,
    fromUserId: number,
    fromName: string,
    now: number,
    sequence: number,
    x: number?,
    y: number?,
    z: number?
): Call
    local kind = assert(pingById[phrase.ping], "phrase names no ping kind")
    local placed = kind.marks and x ~= nil and y ~= nil and z ~= nil
    return table.freeze({
        id = string.format("call_%d", sequence),
        phraseId = phrase.id,
        category = phrase.category,
        text = phrase.text,
        ping = phrase.ping,
        fromUserId = fromUserId,
        fromName = fromName,
        at = now,
        expiresAt = now + kind.seconds,
        marks = placed,
        x = if placed then x else nil,
        y = if placed then y else nil,
        z = if placed then z else nil,
    })
end

--[[
    Who may see what was said, as a pure rule over a list of calls.

    Three things suppress a call and all three are checked here rather than at
    the four places a snapshot is built, because the door a rule is enforced
    at is the door it can be forgotten at:

      * it has expired;
      * the recipient has blocked the sender, which the caller answers through
        `isSuppressed` -- the platform's block list is the authority and it is
        asynchronous, so resolving it is the service's job and applying it is
        this one's;
      * for a marker, it is further away than a marker is useful. A ping is
        guidance, and guidance to somewhere four hundred studs off is noise on
        the screen. Distance is not applied to the log line: hearing that a
        party member is down is the point even when you cannot get there.

    A player always sees their own calls. Blocking yourself is not a thing,
    and a wheel press that appears to do nothing is a wheel press a player
    presses again.
]]
function QuickChat.visibleCalls(
    calls: { Call },
    recipientUserId: number,
    isSuppressed: (number) -> boolean,
    now: number
): { Call }
    local visible = {}
    for _, call in calls do
        if call.expiresAt > now then
            if call.fromUserId == recipientUserId or not isSuppressed(call.fromUserId) then
                table.insert(visible, call)
            end
        end
    end
    return visible
end

function QuickChat.visiblePings(
    calls: { Call },
    recipientUserId: number,
    isSuppressed: (number) -> boolean,
    now: number,
    originX: number?,
    originY: number?,
    originZ: number?,
    radius: number
): { Call }
    local visible = {}
    for _, call in QuickChat.visibleCalls(calls, recipientUserId, isSuppressed, now) do
        if call.marks and call.x ~= nil and call.y ~= nil and call.z ~= nil then
            local withinRange = true
            if originX ~= nil and originY ~= nil and originZ ~= nil then
                local dx = call.x - originX
                local dy = call.y - originY
                local dz = call.z - originZ
                withinRange = dx * dx + dy * dy + dz * dz <= radius * radius
            end
            if withinRange then
                table.insert(visible, call)
            end
        end
    end
    return visible
end

return table.freeze(QuickChat)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--!strict

local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Limiter = typeof(setmetatable(
    {} :: {
        _rate: number,
        _burst: number,
        _buckets: { [string]: { tokens: number, updatedAt: number } },
    },
    RateLimiter
))

function RateLimiter.new(ratePerSecond: number, burst: number): Limiter
    assert(ratePerSecond > 0, "rate must be positive")
    assert(burst >= 1, "burst must be at least one")
    return setmetatable({
        _rate = ratePerSecond,
        _burst = burst,
        _buckets = {},
    }, RateLimiter)
end

function RateLimiter.allow(self: Limiter, key: string, now: number, cost: number?): boolean
    local requested = cost or 1
    if requested <= 0 then
        return true
    end

    local bucket = self._buckets[key]
    if bucket == nil then
        bucket = { tokens = self._burst, updatedAt = now }
        self._buckets[key] = bucket
    end

    local elapsed = math.max(0, now - bucket.updatedAt)
    bucket.tokens = math.min(self._burst, bucket.tokens + elapsed * self._rate)
    bucket.updatedAt = now

    if bucket.tokens < requested then
        return false
    end

    bucket.tokens -= requested
    return true
end

function RateLimiter.clear(self: Limiter, key: string)
    self._buckets[key] = nil
end

return table.freeze(RateLimiter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">RegionAccess</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Which regions a departure may actually target.

    Three regions now exist as content, but existence is not access: a
    region is walkable only when its catalog has a builder (the Regions
    registry's `enabled` flag, still false for everything but
    Bramblewake), its registry dependencies are themselves enabled, and
    the story has reached its chapter. This module is the one place those
    three tests compose, so the departure flow, the generator call, and a
    future region-select UI all refuse for the same reasons in the same
    order.

    Today every request resolves to Bramblewake, exactly as before this
    module existed. When the Delve's builder lands, flipping its `enabled`
    flag in Content/Definitions/Regions.luau is the whole switch -- the
    chapter gate is already waiting behind it.
]]

local ChapterCatalog = require("./ChapterCatalog")
local Regions = require("./Content/Definitions/Regions")

local RegionAccess = {}

export type Verdict = {
    allowed: boolean,
    reason: string,
}

local REGIONS_BY_ID: { [string]: any } = {}
for _, region in Regions do
    REGIONS_BY_ID[region.id] = region
end
table.freeze(REGIONS_BY_ID)

local DEFAULT_REGION_ID = "region_bramblewake"

RegionAccess.DefaultRegionId = DEFAULT_REGION_ID

local function chapterComplete(story: any, chapterId: string?): boolean
    if chapterId == nil then
        return true
    end
    if type(story) ~= "table" then
        return false
    end
    if chapterId == "chapter_one" then
        return type(story.chapterOne) == "table" and story.chapterOne.status == "complete"
    end
    local chapters = story.chapters
    if type(chapters) ~= "table" then
        return false
    end
    local record = chapters[chapterId]
    return type(record) == "table" and record.status == "complete"
end

--[[
    Has the story reached a region's chapter? A region belongs to the
    chapter it hosts, and that chapter is playable once its prerequisite
    chapter is complete -- Bramblewake needs nothing, the Delve needs the
    Warden resolved, the Fen needs the Maw.
]]
function RegionAccess.chapterReached(story: any, regionId: any): boolean
    local chapter = ChapterCatalog.forRegion(regionId)
    if chapter == nil then
        -- a region with no chapter (a future postgame area) is gated only
        -- by its enabled flag
        return true
    end
    return chapterComplete(story, (chapter :: any).requires)
end

--[[
    Readiness is the server's business (the builders live there), so the
    shared layer takes it as an injected fact rather than reaching for a
    server module it cannot see. Absent, every enabled region is treated
    as walkable, which is the behavior this module had before readiness
    existed.
]]
local readinessProvider: ((string) -> boolean)? = nil

function RegionAccess.setReadinessProvider(provider: ((string) -> boolean)?)
    readinessProvider = provider
end

function RegionAccess.evaluate(regionId: any, story: any): Verdict
    local region = if type(regionId) == "string" then REGIONS_BY_ID[regionId] else nil
    if region == nil then
        return { allowed = false, reason = "region_unknown" }
    end
    if region.enabled ~= true then
        return { allowed = false, reason = "region_not_built" }
    end
    for _, dependencyId in region.dependencies do
        local dependency = REGIONS_BY_ID[dependencyId]
        if dependency == nil or dependency.enabled ~= true then
            return { allowed = false, reason = "region_dependency_missing" }
        end
    end
    if not RegionAccess.chapterReached(story, regionId) then
        return { allowed = false, reason = "chapter_not_reached" }
    end
    -- A region whose builder cannot yet draw a walkable world is refused
    -- even if somebody flips its enabled flag: the flag says "we mean to
    -- ship this", readiness says "a party would find something there".
    if readinessProvider ~= nil and not readinessProvider(regionId :: string) then
        return { allowed = false, reason = "region_not_walkable" }
    end
    return { allowed = true, reason = "open" }
end

-- The regions a departure could offer this profile, in registry order.
function RegionAccess.available(story: any): { string }
    local ids: { string } = {}
    for _, region in Regions do
        if RegionAccess.evaluate(region.id, story).allowed then
            table.insert(ids, region.id)
        end
    end
    return ids
end

--[[
    Resolve a requested destination. Anything that is not an open region
    resolves to Bramblewake rather than erroring -- a malformed or
    too-early request earns the default walk, never a broken server. The
    same shape ExpeditionContracts.resolve gives malformed contract ids.
]]
function RegionAccess.destinationFor(regionId: any, story: any): string
    if RegionAccess.evaluate(regionId, story).allowed then
        return regionId :: string
    end
    return DEFAULT_REGION_ID
end

return table.freeze(RegionAccess)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">ResidentDialogue</string>
          <string name="Source"><![CDATA[--!strict

local QuestCatalog = require("./QuestCatalog")
local ResidentRoster = require("./ResidentRoster")

local ResidentDialogue = {}

export type Response = {
    message: string,
    questId: string,
    state: string,
}

--[[
    Names and quests come from the roster now; the two tables that used to
    hold them here were the first place the roster drifted, which is why
    it exists.
]]
--[[
    A resident's arc, in order, taken from the quest catalog rather than
    from a list here -- the roster names where an arc starts and the
    catalog's `requires` chain says what follows, so the two cannot drift
    into disagreeing about what somebody is asking for.
]]
local RESIDENT_ARCS: { [string]: { string } } = {}
local RESIDENT_NAMES: { [string]: string } = {}
for _, definition in ResidentRoster.list() do
    RESIDENT_ARCS[definition.id] = { definition.questId }
    RESIDENT_NAMES[definition.id] = definition.displayName
end
for _, quest in QuestCatalog.list() do
    local residentId = quest.residentId
    if residentId ~= nil and quest.requires ~= nil and RESIDENT_ARCS[residentId] ~= nil then
        table.insert(RESIDENT_ARCS[residentId], quest.id)
    end
end
table.freeze(RESIDENT_NAMES)

--[[
    What the residents brought back from their own regions say once their
    work is done. Chapter I's three answer to the town's decisions, which
    is handled below; these four-and-four answer to the places they came
    from, and each one is a person rather than a job title.
]]
--[[
    What each resident asks for, in their own words.

    The four asks built on `bramblewake_settlements` name the pouch on purpose.
    That signal counts settled Wayhome deliveries -- a trip that banks nothing
    records no settlement, because there is nothing to settle -- and every one
    of these lines used to describe it as a trip or a return, which promises
    credit for walking out and back empty-handed and never pays it. A player
    who does exactly what the words say and still reads 0/3 has been told the
    quest is broken by the quest itself.
]]
local GUIDANCE = table.freeze({
    npc_tomas_reed = "CRAFT ONE USEFUL ITEM AT THE WORKBENCH",
    npc_pip_wren = "HELP THE LANTERN ROAD SURVIVE THREE NIGHTS",
    npc_ena_moss = "BANK A POUCH FROM BRAMBLEWAKE THREE TIMES",
    npc_hesper_vane = "BRING ME GEAR THAT HAS FOUND ITS OWN CHARACTER",
    npc_odell_crane = "FILL THE STORES — SIXTY OF ANYTHING WILL DO",
    npc_junie_falk = "KEEP THE LIGHT LIT FOR SEVEN NIGHTS",
    npc_bartram_hoke = "RAISE FOUR BUILDINGS SO THERE IS SOMEWHERE TO COOK",
    npc_saoirse_quill = "BANK EIGHT POUCHES FROM BRAMBLEWAKE AND I WILL RULE THE COLUMN",
    npc_wren_dabbler = "PUT UP THREE DECORATIONS — THIS TOWN SHOULD LOOK LIVED IN",
    npc_marek_still = "CRAFT SIX THINGS AND LOOK TWICE AT EACH",
    npc_lissen_ford = "BE TRUSTED BY THREE RESIDENTS — CHECK ON THEM",
    npc_isolde_maren = "KEEP THE LIGHT LIT FOURTEEN NIGHTS. I HAVE DONE LONGER FOR LESS",
    npc_cass_pell = "MAKE TWENTY THINGS WITH YOUR HANDS AND I WILL TEACH YOU ROPE",
    npc_alder_kine = "TWO HUNDRED IN THE STORES. I WANT TO SEE THE COLUMN IN BLACK ONCE",
    npc_nell_barrow = "FOURTEEN LOADS BANKED FROM BRAMBLEWAKE — THE LOAD IS THE PART THAT COUNTS",
    npc_anselm_rill = "FIND FOUR OF WHAT THIS PLACE REMEMBERS. SOMEBODY SHOULD KEEP IT",
    npc_ivy_thorn = "BE TRUSTED BY EIGHT OF US. I COUNT BY NAME, NOT BY HEAD",
    npc_halvard_sunn = "CLOSE EVERY CHAPTER. A STORE IS ONLY FULL WHEN NOTHING IS STILL OPEN",
    npc_maud_ferrow = "RAISE TWELVE BUILDINGS. TWELVE DOORS IS A TOWN, NOT A CAMP",
    npc_sabine_ash = "MAKE FORTY THINGS. NOT ONE OF THEM SHAPED LIKE A PERSON",
    npc_theo_marl = "FIND EIGHT OF WHAT THIS WORLD REMEMBERS AND I WILL COPY THEM OUT",
    npc_delia_kass = "BE TRUSTED BY FOURTEEN OF US. NAMES, NOT NUMBERS",
    npc_bran_holt = "TWENTY BUILDINGS STANDING. I WILL CUT THE BEAMS FOR THE REST",
    npc_orin_vale = "CLOSE ALL SEVEN. I HAVE BEEN WAITING ON THE LAST ONE A LONG TIME",
    npc_signe_marr = "FOUR HUNDRED IN THE STORES. A TOWN SHOULD NEVER BE THIRSTY AGAIN",
    npc_ruth_calder = "PUT UP EIGHT DECORATIONS. NOBODY MEETS IN A ROOM NOBODY LIKES",
    npc_edda_pyne = "THIRTY NIGHTS. I WILL HAVE THE WARDS UP BY THE TENTH",
})

local ARRIVAL_LINES = table.freeze({
    npc_hesper_vane = "A TOOL YOU KEPT SHARP IS A DAY YOU MEANT TO SURVIVE. BRING ME THE DULL ONES.",
    npc_odell_crane = "FULL STORES AND A QUIET BELL. I COULD ALMOST SIT DOWN.",
    npc_junie_falk = "SEVEN NIGHTS LIT IN A ROW. DOWN BELOW WE NEVER MANAGED THREE.",
    npc_bartram_hoke = "A REAL KITCHEN. I HAVE BEEN COOKING OUT OF A HELMET SINCE I WAS TWENTY.",
    npc_saoirse_quill = "NAMES OUT AND NAMES BACK, AND THE COLUMNS AGREE. I HAVE NOT WRITTEN THAT IN YEARS.",
    npc_wren_dabbler = "I WOVE ONE FOR EVERY HOUSE THE WATER TOOK. NOW I WEAVE THEM FOR DOORS THAT STAND.",
    npc_marek_still = "LOOK TWICE AT WHAT YOU CARRY. THE FEN TAUGHT ME THAT AND IT COST IT NOTHING.",
    npc_lissen_ford = "EVERY HEAD COUNTED AT DUSK, AND EVERY ONE OF THEM KNOWS YOUR NAME. THAT IS THE WORK.",
    npc_isolde_maren = "FOURTEEN NIGHTS AND THE LIGHT NEVER WENT OUT. NOBODY DROWNED LOOKING FOR IT.",
    npc_cass_pell = "GOOD ROPE IS A PROMISE YOU CAN PULL ON. THIS TOWN HAS ENOUGH OF IT NOW.",
    npc_alder_kine = "THE COLUMN IS IN BLACK. I HAVE NOT WRITTEN THAT SINCE THE HARBOUR WENT.",
    npc_nell_barrow = "EVERY TRIP OUT CAME BACK. THAT IS THE ONLY LEDGER I HAVE EVER KEPT.",
    npc_anselm_rill = "FOUR THINGS THIS PLACE REMEMBERS, AND SOMEONE ALIVE TO REMEMBER THEM.",
    npc_ivy_thorn = "EIGHT NAMES, ALL OF THEM ANSWERING. THE ABBEY NEVER MANAGED THAT.",
    npc_halvard_sunn = "NOTHING LEFT OPEN AND THE STORE STILL SHUT. THAT IS A WINTER SURVIVED.",
    npc_maud_ferrow = "TWELVE DOORS, AND NOT ONE OF THEM MINE TO GIVE AWAY. GOOD.",
    npc_sabine_ash = "FORTY THINGS AND NOT A FACE AMONG THEM. I CAN WORK IN A TOWN LIKE THIS.",
    npc_theo_marl = "EIGHT OF THEM, COPIED OUT PROPERLY. THE SCRATCHED NAMES GO IN THE SAME BOOK NOW.",
    npc_delia_kass = "FOURTEEN PEOPLE WHO KNOW YOUR NAME AND YOU KNOW THEIRS. THAT IS A MEMORIAL.",
    npc_bran_holt = "TWENTY STANDING. LET SOMETHING TRY TO BURN THIS ONE.",
    npc_orin_vale = "ALL SEVEN CLOSED, AND I AM STANDING IN DAYLIGHT. I HAD STOPPED EXPECTING IT.",
    npc_signe_marr = "FOUR HUNDRED IN STORE AND THE WELL STILL COLD. NOBODY GOES SHORT THIS YEAR.",
    npc_ruth_calder = "EIGHT THINGS SOMEBODY CHOSE TO PUT UP. NOW IT IS A ROOM AND NOT A SHELTER.",
    npc_edda_pyne = "THIRTY NIGHTS AND THE WARDS TOOK THE FIRST BITE OF EVERY ONE.",
})

--[[
    Later stages of an arc speak for themselves rather than for the person
    -- the same resident is asking, so the name is already on the line,
    and what changes is what they want next. Stage one keeps GUIDANCE and
    ARRIVAL_LINES above, which players have already heard.
]]
local STAGE_GUIDANCE = table.freeze({
    quest_tomas_second_bench = "TWELVE THINGS MADE. I WANT A BENCH THAT LOOKS WORKED AT",
    quest_tomas_full_house = "TEN PEOPLE WHO TRUST YOU. THEN EVERY BED HERE IS FULL",
    quest_pip_further_roads = "SIX LOADS BANKED FROM BRAMBLEWAKE. I WANT THE FAR ROADS ON THE BOARD",
    quest_pip_every_night = "TWENTY-ONE NIGHTS POSTED BEFORE THEY ARRIVED. NOT ONE SURPRISE",
    quest_ena_first_growth = "FIVE THINGS PLANTED OR HUNG. THIS PLACE SHOULD LOOK TENDED",
    quest_ena_the_archive = "SIX OF WHAT THE FOREST KEPT. IT IS A STORY, NOT A COLLECTION",
})

local STAGE_STORIES = table.freeze({
    quest_tomas_second_bench = "TWELVE THINGS OFF THAT BENCH AND THE GRAIN IS GOING SMOOTH. THAT IS WHAT A TOOL BENCH IS FOR.",
    quest_tomas_full_house = "EVERY BED FULL AND I KNOW WHO IS IN EACH ONE. I DID NOT THINK I WOULD SEE THAT AGAIN.",
    quest_pip_further_roads = "SIX RUNS OUT AND SIX BACK. THE FAR ROADS ARE ON THE BOARD NOW, IN INK.",
    quest_pip_every_night = "TWENTY-ONE NIGHTS AND NOBODY WAS SURPRISED BY ANY OF THEM. THAT IS THE WHOLE JOB.",
    quest_ena_first_growth = "FIVE THINGS PLANTED, AND THE TOWN LOOKS TENDED INSTEAD OF OCCUPIED.",
    quest_ena_the_archive = "SIX OF THEM, IN ORDER. IT IS A STORY, AND SOMEBODY IS FINALLY READING IT.",
})

local function questById(quests: any, questId: string): any
    if type(quests) ~= "table" then
        return nil
    end
    for _, quest in quests do
        if type(quest) == "table" and quest.id == questId then
            return quest
        end
    end
    return nil
end

local function completedStory(residentId: string, consequence: any, questId: string?): string
    -- A later stage of an arc has its own answer; only stage one falls
    -- back to the resident's arrival line.
    local staged = if questId ~= nil then STAGE_STORIES[questId] else nil
    if staged ~= nil then
        return staged
    end
    local arrival = ARRIVAL_LINES[residentId]
    if arrival ~= nil then
        return arrival
    end
    local decision = if type(consequence) == "table" then consequence.decision else nil
    local wardenOutcome = if type(consequence) == "table" then consequence.wardenOutcome else nil
    if residentId == "npc_tomas_reed" then
        if decision == "restore_farmland" then
            return "THE RENEWED FIELDS NEED TOOLS AS MUCH AS SEED. KEEP THE BENCH BUSY."
        elseif decision == "wild_regrowth" then
            return "THE WILD GROVE GIVES LESS ON COMMAND, BUT MORE TO THOSE WHO LISTEN."
        elseif decision == "shared_agroforest" then
            return "FOREST AND FIELD ARE SHARING ONE TABLE NOW. THAT IS WORTH BUILDING FOR."
        end
        return "ONE GOOD TOOL CAN TURN A BAD NIGHT. KEEP MAKING WHAT THE TOWN NEEDS."
    elseif residentId == "npc_pip_wren" then
        if wardenOutcome == "preserved" then
            return "THE WARDEN LEFT OLD TRACKS OPEN. I HAVE MARKED THE SAFEST ONES."
        elseif wardenOutcome == "scarred" then
            return "THE SCARRED TRAILS SHIFT AFTER RAIN. FOLLOW THE FRESH AMBER MARKS."
        elseif wardenOutcome == "harmed" then
            return "THE FOREST IS WATCHING THE ROAD NOW. TRAVEL WITH LIGHT AND COMPANY."
        end
        return "THREE DAWNS PROVE A ROAD CAN HOLD. THE NEXT ONE STILL NEEDS A SCOUT."
    elseif decision == "restore_farmland" then
        return "I SAVED BRAMBLEWAKE SEED FOR THESE FURROWS. THE FIRST SHOOTS ARE YOURS TOO."
    elseif decision == "wild_regrowth" then
        return "THE GROVE IS CHOOSING ITS OWN SHAPE. WATCH WHERE THE BRIGHTCAPS RETURN."
    elseif decision == "shared_agroforest" then
        return "ROOT, CROP, AND LANTERN ARE GROWING TOGETHER. KEEP BRINGING PEOPLE HOME."
    end
    return "EVERY SAFE RETURN TEACHES THE GREENWARD HOW TO GROW AROUND US."
end

function ResidentDialogue.respond(residentId: any, quests: any, consequence: any): Response?
    if type(residentId) ~= "string" then
        return nil
    end
    local arc = RESIDENT_ARCS[residentId]
    local residentName = RESIDENT_NAMES[residentId]
    if arc == nil or residentName == nil then
        return nil
    end
    --[[
        Whichever stage of their arc they are on: the first one they have
        not finished. A stage the caller knows nothing about is not the
        answer -- an arc can run ahead of what a snapshot carries -- so an
        unknown stage falls back to the last one there is a record for,
        and a resident who has been answered talks about what happened
        rather than repeating a request.
    ]]
    local questId: string? = nil
    local lastKnown: string? = nil
    for _, candidate in arc do
        local record = questById(quests, candidate)
        if record ~= nil then
            lastKnown = candidate
            if record.claimed ~= true then
                questId = candidate
                break
            end
        end
    end
    -- arc[1] always exists: the roster's own questId seeded it.
    local currentQuestId: string = questId or lastKnown or arc[1]

    local quest = questById(quests, currentQuestId)
    if quest == nil then
        return {
            message = residentName .. ": CHECK BACK WHEN THE GREENWARD RECORDS ARE READY.",
            questId = currentQuestId,
            state = "loading",
        }
    end
    if quest.claimed == true then
        return {
            message = residentName
                .. ": "
                .. completedStory(residentId, consequence, currentQuestId),
            questId = currentQuestId,
            state = "story",
        }
    end

    local current = math.max(0, math.floor(tonumber(quest.progress) or 0))
    local threshold = math.max(1, math.floor(tonumber(quest.threshold) or 1))
    -- The default names nothing in particular, because a resident with no
    -- authored ask used to borrow Ena's and tell a player to go to Bramblewake
    -- for a quest that counts something else entirely.
    local guidance = STAGE_GUIDANCE[currentQuestId]
        or GUIDANCE[residentId]
        or "THERE IS WORK HERE WHEN YOU ARE READY"
    return {
        message = string.format(
            "%s: %s — %d/%d. I WILL MARK IT WHEN IT IS DONE.",
            residentName,
            guidance,
            math.min(current, threshold),
            threshold
        ),
        questId = currentQuestId,
        state = if current >= threshold then "ready" else "active",
    }
end

return table.freeze(ResidentDialogue)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="90">
        <Properties>
          <string name="Name">ResidentLife</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Resident life: jobs, injury, bonds, and town crises.

    Milestone 4 asks for residents who are part of the town's systems rather
    than scenery on a schedule. This module is the whole of that judgement,
    kept pure — night outcomes in, next resident state out — so the specs can
    hold every rule still and the services stay wiring.

    Design rules this module enforces:
    - Everything here is deterministic. An injury is caused by a workplace
      falling, never by a dice roll, so a player can always answer "why".
    - Effects touch town systems only (repairs, warnings, the lantern's
      floor). No resident boon ever changes player damage, speed, or drops —
      that keeps the no-paid-power line easy to hold forever.
    - Bonds are per-profile: they are the town remembering *you*.
]]

local ResidentRoster = require("./ResidentRoster")

local ResidentLife = {}

export type ResidentState = {
    injuredUntilNight: number,
    bond: number,
    lastVisitNight: number,
}

export type State = { [string]: ResidentState }

export type Job = {
    residentId: string,
    buildingId: string,
    title: string,
    boon: string,
    boonLabel: string,
}

export type NightContext = {
    nightNumber: number,
    buildingIntegrity: { [string]: number },
    lanternHitFloor: boolean,
}

export type Crisis = {
    id: string,
    kind: string,
    title: string,
    detail: string,
    startedNight: number,
}

export type NightReport = {
    injuries: { string },
    recoveries: { string },
    crisis: Crisis?,
}

--[[
    Who exists, and what job each holds, now comes from ResidentRoster --
    one list instead of the several that used to drift apart. Chapter I's
    three still come first, in their original order, with their original
    jobs, so nothing about an existing town changes.
]]
local RESIDENT_IDS = ResidentRoster.Order

local JOBS: { [string]: Job } = table.freeze(ResidentRoster.jobs())

-- A workplace this damaged injures its keeper during the night's chaos.
local INJURY_INTEGRITY_THRESHOLD = 0.5
-- Nights of rest an injury costs, before anyone checks on them.
local INJURY_REST_NIGHTS = 2
local BOND_MAX = 100
local BOND_VISIT = 1
local BOND_CARE = 5

ResidentLife.Ids = RESIDENT_IDS
ResidentLife.Jobs = JOBS
ResidentLife.BondTiers = table.freeze({
    { threshold = 75, title = "KINDRED" },
    { threshold = 50, title = "TRUSTED" },
    { threshold = 25, title = "ACQUAINTED" },
    { threshold = 0, title = "NEWCOMER" },
})

local function defaultResident(): ResidentState
    return {
        injuredUntilNight = 0,
        bond = 0,
        lastVisitNight = 0,
    }
end

function ResidentLife.default(): State
    local state: State = {}
    for _, residentId in RESIDENT_IDS do
        state[residentId] = defaultResident()
    end
    return state
end

function ResidentLife.normalize(value: any): State
    local state = ResidentLife.default()
    if type(value) ~= "table" then
        return state
    end
    for _, residentId in RESIDENT_IDS do
        local stored = value[residentId]
        if type(stored) == "table" then
            local resident = state[residentId]
            resident.injuredUntilNight =
                math.max(0, math.floor(tonumber(stored.injuredUntilNight) or 0))
            resident.bond = math.clamp(math.floor(tonumber(stored.bond) or 0), 0, BOND_MAX)
            resident.lastVisitNight = math.max(0, math.floor(tonumber(stored.lastVisitNight) or 0))
        end
    end
    return state
end

function ResidentLife.isInjured(state: State, residentId: string, nightNumber: number): boolean
    local resident = state[residentId]
    return resident ~= nil and resident.injuredUntilNight >= nightNumber
end

function ResidentLife.bondTitle(bond: number): string
    for _, tier in ResidentLife.BondTiers do
        if bond >= tier.threshold then
            return tier.title
        end
    end
    return "NEWCOMER"
end

local function clone(state: State): State
    local next: State = {}
    for residentId, resident in state do
        next[residentId] = {
            injuredUntilNight = resident.injuredUntilNight,
            bond = resident.bond,
            lastVisitNight = resident.lastVisitNight,
        }
    end
    return next
end

--[[
    A night has ended; decide who it hurt and whether the town tips into
    crisis. Injuries come only from a resident's own workplace falling below
    half integrity while they were out defending it. Two or more injuries at
    once is a crisis: the clinic story writes itself, and the town needs its
    players to go check on people.
]]
function ResidentLife.resolveNight(state: State, context: NightContext): (State, NightReport)
    local nextState = clone(state)
    local report: NightReport = { injuries = {}, recoveries = {}, crisis = nil }
    for _, residentId in RESIDENT_IDS do
        local resident = nextState[residentId]
        local job = JOBS[residentId]
        local wasInjured = resident.injuredUntilNight >= context.nightNumber
        if not wasInjured and resident.injuredUntilNight > 0 then
            resident.injuredUntilNight = 0
            table.insert(report.recoveries, residentId)
        end
        local integrity = context.buildingIntegrity[job.buildingId]
        if not wasInjured and integrity ~= nil and integrity < INJURY_INTEGRITY_THRESHOLD then
            resident.injuredUntilNight = context.nightNumber + INJURY_REST_NIGHTS
            table.insert(report.injuries, residentId)
        end
    end

    local injuredNow = 0
    for _, residentId in RESIDENT_IDS do
        if ResidentLife.isInjured(nextState, residentId, context.nightNumber + 1) then
            injuredNow += 1
        end
    end
    if injuredNow >= 2 then
        report.crisis = {
            id = string.format("crisis_clinic_%d", context.nightNumber),
            kind = "care",
            title = "THE CLINIC IS FULL",
            detail = "Check on the injured residents to help them back on their feet.",
            startedNight = context.nightNumber,
        }
    elseif context.lanternHitFloor and injuredNow >= 1 then
        report.crisis = {
            id = string.format("crisis_darkwatch_%d", context.nightNumber),
            kind = "care",
            title = "A HARD NIGHT'S TOLL",
            detail = "The light nearly failed and someone was hurt. Check on them.",
            startedNight = context.nightNumber,
        }
    end
    return nextState, report
end

export type CheckResult = {
    accepted: boolean,
    reason: string?,
    healed: boolean,
    bond: number,
}

--[[
    A player checks on a resident. Injured: recovery accelerates by one night
    and the bond grows properly — care is how people become close. Healthy:
    a small bond nudge, once per night, so the loop is worth doing without
    being a tapping exercise.
]]
function ResidentLife.checkOn(
    state: State,
    residentId: string,
    nightNumber: number
): (State, CheckResult)
    local resident = state[residentId]
    if resident == nil then
        return state, { accepted = false, reason = "unknown_resident", healed = false, bond = 0 }
    end
    local nextState = clone(state)
    local target = nextState[residentId]
    if target.injuredUntilNight >= nightNumber then
        target.injuredUntilNight = math.max(0, target.injuredUntilNight - 1)
        target.bond = math.min(BOND_MAX, target.bond + BOND_CARE)
        target.lastVisitNight = nightNumber
        return nextState,
            {
                accepted = true,
                reason = nil,
                healed = target.injuredUntilNight < nightNumber,
                bond = target.bond,
            }
    end
    if target.lastVisitNight >= nightNumber then
        return state,
            {
                accepted = false,
                reason = "already_visited",
                healed = false,
                bond = target.bond,
            }
    end
    target.bond = math.min(BOND_MAX, target.bond + BOND_VISIT)
    target.lastVisitNight = nightNumber
    return nextState, { accepted = true, reason = nil, healed = false, bond = target.bond }
end

export type Boon = {
    residentId: string,
    boon: string,
    label: string,
}

--[[
    What the healthy, employed residents contribute at dawn. A resident sits
    a boon out while injured or while their workplace is an unbuilt site —
    which is exactly the pressure that makes repairs and rescues matter.
]]
function ResidentLife.dawnBoons(
    state: State,
    nightNumber: number,
    buildingStages: { [string]: number },
    activeResidentIds: { string }
): { Boon }
    local active: { [string]: boolean } = {}
    for _, residentId in activeResidentIds do
        active[residentId] = true
    end
    local boons: { Boon } = {}
    for _, residentId in RESIDENT_IDS do
        local job = JOBS[residentId]
        if
            active[residentId]
            and not ResidentLife.isInjured(state, residentId, nightNumber)
            and (buildingStages[job.buildingId] or 0) > 0
        then
            table.insert(boons, { residentId = residentId, boon = job.boon, label = job.boonLabel })
        end
    end
    return boons
end

--[[
    Snapshot for the client: status, job, and bond per resident, plus the
    crisis if one is standing. Pure formatting; the client renders it in the
    Field Book and never decides anything from it.
]]
function ResidentLife.snapshot(
    state: State,
    nightNumber: number,
    activeResidentIds: { string },
    crisis: Crisis?
): { [string]: any }
    local residents = {}
    local active: { [string]: boolean } = {}
    for _, residentId in activeResidentIds do
        active[residentId] = true
    end
    for _, residentId in RESIDENT_IDS do
        local resident = state[residentId]
        local job = JOBS[residentId]
        table.insert(residents, {
            residentId = residentId,
            title = job.title,
            buildingId = job.buildingId,
            present = active[residentId] == true,
            injured = ResidentLife.isInjured(state, residentId, nightNumber),
            bond = resident.bond,
            bondTitle = ResidentLife.bondTitle(resident.bond),
        })
    end
    return {
        residents = residents,
        crisis = crisis,
    }
end

return table.freeze(ResidentLife)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="91">
        <Properties>
          <string name="Name">ResidentRoster</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Who lives in Emberhollow, and who is going to.

    Three residents shipped with chapter I and have been named in half a
    dozen places since -- ResidentLife's job table, the dialogue module,
    the world's placement code. Milestone 7 adds eight more, drawn from
    the two new regions, and eight more hand-maintained lists is how a
    roster drifts out of agreement with itself. So the roster lives here
    once: identity, home region, when they arrive, the job they take, and
    the quest they carry.

    Arrival is the important field. A resident is not in town because a
    module exists; they arrive when their chapter does. Chapter I's three
    are present from the first dawn, the Delve's four arrive with chapter
    II, and the Fen's four with chapter III -- so a fresh save still meets
    exactly the three people it always met, and the town fills as the
    story does.

    Nobody here is a job title with a name attached. Each one wanted
    something in their own region, failed or half-succeeded at it, and
    brought that with them.
]]

local ResidentRoster = {}

export type Job = {
    residentId: string,
    buildingId: string,
    title: string,
    boon: string,
    boonLabel: string,
}

export type Resident = {
    id: string,
    displayName: string,
    fullName: string,
    homeRegion: string,
    arrivesInChapter: number,
    questId: string,
    job: Job,
    --[[
        Postgame only. A resident with this arrives with chapter seven and
        only for the endings named -- which is how the town can be
        different afterwards without the roster growing a second copy of
        itself for each ending.
    ]]
    requiresEnding: { string }?,
    -- One line about who they are, for the world sign and the Field Book.
    introduction: string,
}

local function resident(definition: Resident): Resident
    return table.freeze({
        id = definition.id,
        displayName = definition.displayName,
        fullName = definition.fullName,
        homeRegion = definition.homeRegion,
        arrivesInChapter = definition.arrivesInChapter,
        questId = definition.questId,
        introduction = definition.introduction,
        job = table.freeze(definition.job),
        requiresEnding = if definition.requiresEnding ~= nil
            then table.freeze(table.clone(definition.requiresEnding))
            else nil,
    })
end

