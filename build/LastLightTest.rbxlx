    }),
    gear_cinderfall_seal = table.freeze({
        slot = "charm",
        displayName = "CINDERFALL SEAL",
        description = "Softens incoming damage by 7%. Heavy, and worth it.",
        damageReduction = 0.07,
        staminaRegenMultiplier = 1.0,
    }),
}

function Equipment.default(): Equipped
    return {}
end

function Equipment.normalize(value: any): Equipped
    local result: Equipped = {}
    if type(value) ~= "table" then
        return result
    end
    for slot, itemId in value do
        if type(slot) == "string" and type(itemId) == "string" and DEFINITIONS[itemId] ~= nil then
            local definition = DEFINITIONS[itemId]
            if definition.slot == slot then
                result[slot] = itemId
            end
        end
    end
    return result
end

function Equipment.get(itemId: any): any
    return if type(itemId) == "string" then DEFINITIONS[itemId] else nil
end

function Equipment.isKnown(itemId: any): boolean
    return type(itemId) == "string" and DEFINITIONS[itemId] ~= nil
end

function Equipment.equip(
    gear: { [string]: number },
    equipped: Equipped,
    itemId: any
): (Equipped, any)
    local definition = Equipment.get(itemId)
    if definition == nil then
        return equipped, { applied = false, reason = "unknown_equipment" }
    end
    if (gear[itemId] or 0) < 1 then
        return equipped, { applied = false, reason = "not_owned" }
    end
    local nextEquipped = Equipment.normalize(equipped)
    nextEquipped[definition.slot] = itemId
    return nextEquipped,
        {
            applied = true,
            itemId = itemId,
            slot = definition.slot,
        }
end

function Equipment.unequip(equipped: Equipped, slot: any): (Equipped, any)
    if type(slot) ~= "string" then
        return equipped, { applied = false, reason = "invalid_slot" }
    end
    local nextEquipped = Equipment.normalize(equipped)
    if nextEquipped[slot] == nil then
        return equipped, { applied = false, reason = "empty_slot" }
    end
    nextEquipped[slot] = nil
    return nextEquipped, { applied = true, slot = slot }
end

--[[
    What the equipped weapon changes about a strike.

    Returns nil for bare hands: the caller keeps its own defaults, so nothing
    about existing combat moves unless a weapon is actually equipped. `ranged`
    is what the client's projectile visual keys off -- only the bow and sling
    families throw something; the lance's reach is an extended arm, not a shot.
]]
function Equipment.weaponStrikeProfile(equipped: Equipped): any
    local normalized = Equipment.normalize(equipped)
    local weaponId = normalized.weapon
    if type(weaponId) ~= "string" then
        return nil
    end
    local definition = DEFINITIONS[weaponId]
    if definition == nil or definition.kind == nil then
        return nil
    end
    return {
        itemId = weaponId,
        kind = definition.kind,
        ranged = definition.strikeRange ~= nil,
        strikeRange = definition.strikeRange,
        meleeReach = definition.meleeReach,
        strikeDamageMultiplier = definition.strikeDamageMultiplier or 1,
        onHitStaminaRefund = definition.onHitStaminaRefund,
        onHitSnareSeconds = definition.onHitSnareSeconds,
    }
end

--[[
    effectivenessByItem is the wear system's seam: 1 (or absent) leaves an
    item's contribution bit-identical to the pre-wear math, 0.5 halves the
    part of it that differs from "wearing nothing", and 0 contributes
    nothing at all -- failing gear hangs on the body but shields nobody.
]]
function Equipment.stats(equipped: Equipped, effectivenessByItem: { [string]: number }?): any
    local damageReduction = 0
    local staminaRegenMultiplier = 1
    for _, itemId in Equipment.normalize(equipped) do
        if type(itemId) == "string" then
            local definition = DEFINITIONS[itemId]
            if definition ~= nil then
                local effectiveness = if effectivenessByItem ~= nil
                    then effectivenessByItem[itemId] or 1
                    else 1
                damageReduction += definition.damageReduction * effectiveness
                staminaRegenMultiplier *= 1 + (definition.staminaRegenMultiplier - 1) * effectiveness
            end
        end
    end
    return {
        damageReduction = math.clamp(damageReduction, 0, 0.25),
        staminaRegenMultiplier = math.clamp(staminaRegenMultiplier, 0.75, 1.5),
    }
end

function Equipment.list(): { any }
    local result = {}
    for itemId, definition in DEFINITIONS do
        table.insert(result, {
            itemId = itemId,
            slot = definition.slot,
            displayName = definition.displayName,
            description = definition.description,
        })
    end
    table.sort(result, function(a, b)
        return a.itemId < b.itemId
    end)
    return result
end

return table.freeze(Equipment)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">ExpeditionContracts</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Expedition contracts: the party names its risk before the platform
    launches, and Bramblewake answers in kind.

    Milestone 5's "contracts and risk modifiers" deliverable, kept pure. A
    contract trades risk for reward inside tight bounds — enemies hit
    harder, the pouch pays better — and the exchange is always earned in
    play, never purchasable. Weather is the contract's face: the sky tells
    the party what they signed.

    Multiplier bounds are deliberate: 0.75–1.5 keeps every contract inside
    the same clamp the combat code already trusts, so no contract can turn
    an enemy into a one-shot or a reward into an economy leak.
]]

local ExpeditionContracts = {}

export type Contract = {
    id: string,
    title: string,
    detail: string,
    rewardMultiplier: number,
    enemyDamageMultiplier: number,
    weather: string,
}

local CONTRACTS: { Contract } = table.freeze({
    table.freeze({
        id = "contract_standard",
        title = "STANDARD SWEEP",
        detail = "The woods as they are. Even trade.",
        rewardMultiplier = 1,
        enemyDamageMultiplier = 1,
        weather = "clear",
    }),
    table.freeze({
        id = "contract_quiet_roads",
        title = "QUIET ROADS",
        detail = "Mist keeps the worst asleep. Lighter pouch, lighter bruises.",
        rewardMultiplier = 0.75,
        enemyDamageMultiplier = 0.8,
        weather = "mist",
    }),
    table.freeze({
        id = "contract_storm_salvage",
        title = "STORM SALVAGE",
        detail = "Rain wakes the roots. What you carry out is worth more.",
        rewardMultiplier = 1.25,
        enemyDamageMultiplier = 1.2,
        weather = "storm",
    }),
    table.freeze({
        id = "contract_deep_growth",
        title = "DEEP GROWTH",
        detail = "The forest at full strength. The pouch pays for the scars.",
        rewardMultiplier = 1.5,
        enemyDamageMultiplier = 1.35,
        weather = "spores",
    }),
})

local CONTRACTS_BY_ID: { [string]: Contract } = {}
for _, contract in CONTRACTS do
    CONTRACTS_BY_ID[contract.id] = contract
end
table.freeze(CONTRACTS_BY_ID)

ExpeditionContracts.List = CONTRACTS

function ExpeditionContracts.get(id: any): Contract?
    if type(id) ~= "string" then
        return nil
    end
    return CONTRACTS_BY_ID[id]
end

function ExpeditionContracts.default(): Contract
    return CONTRACTS[1]
end

-- Unknown or absent ids resolve to the standard sweep: a malformed request
-- never earns more risk or more reward than the even trade.
function ExpeditionContracts.resolve(id: any): Contract
    return ExpeditionContracts.get(id) or ExpeditionContracts.default()
end

function ExpeditionContracts.applyReward(contract: Contract, amount: number): number
    if type(amount) ~= "number" or amount <= 0 then
        return 0
    end
    return math.max(1, math.ceil(amount * contract.rewardMultiplier))
end

return table.freeze(ExpeditionContracts)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">ExpeditionEventFlow</string>
          <string name="Source"><![CDATA[--!strict

local ExpeditionEventFlow = {}

local INTERACTION_PREFIX = "exp_event:"

local function findStep(definition: any, stepId: string): any?
    for _, step in definition.steps do
        if step.id == stepId then
            return step
        end
    end
    return nil
end

local function participantList(participants: { [string]: boolean }): { string }
    local result = {}
    for participantId in participants do
        table.insert(result, participantId)
    end
    table.sort(result)
    return result
end

function ExpeditionEventFlow.validateDefinition(definition: any): (boolean, { string })
    local issues = {}
    local function issue(message: string)
        table.insert(issues, message)
    end

    if type(definition) ~= "table" then
        return false, { "event definition must be a table" }
    end
    --[[
        Every region owns a two-letter event namespace (bw, ir, ...). The
        rule is still that an event id names its region -- it just no
        longer names one region in particular, now that the generator
        composes more than one.
    ]]
    if type(definition.id) ~= "string" or string.match(definition.id, "^event_%l%l_%l") == nil then
        issue("event ID must use a regional event namespace")
    end
    if type(definition.displayName) ~= "string" or definition.displayName == "" then
        issue("event must have a display name")
    end
    if type(definition.objective) ~= "string" or definition.objective == "" then
        issue("event must have an objective")
    end
    if type(definition.detail) ~= "string" or definition.detail == "" then
        issue("event must have player guidance")
    end
    if
        type(definition.durationSeconds) ~= "number"
        or definition.durationSeconds < 30
        or definition.durationSeconds > 300
    then
        issue("event duration must be between 30 and 300 seconds")
    end
    if definition.defaultSolution ~= true then
        issue("event must have a profession-independent solution")
    end
    if definition.criticalPathBlocking ~= false then
        issue("event must not block the expedition critical path")
    end
    if
        type(definition.minimumRouteSpace) ~= "number"
        or definition.minimumRouteSpace < 8
        or definition.minimumRouteSpace > 48
    then
        issue("event route-space requirement is invalid")
    end
    if type(definition.startConditions) ~= "table" or #definition.startConditions == 0 then
        issue("event must declare start conditions")
    end
    if type(definition.incompatibleEvents) ~= "table" then
        issue("event must declare incompatible events")
    end
    if type(definition.failureResolution) ~= "string" or definition.failureResolution == "" then
        issue("event must declare a safe failure resolution")
    end
    if type(definition.localizationKey) ~= "string" or definition.localizationKey == "" then
        issue("event must declare a localization key")
    end
    if type(definition.analyticsId) ~= "string" or definition.analyticsId == "" then
        issue("event must declare an analytics ID")
    end
    if type(definition.killSwitchFlag) ~= "string" or definition.killSwitchFlag == "" then
        issue("event must declare a kill-switch flag")
    end
    -- Both variants are required. An event that reads clearly alone can be
    -- opaque in a group and the reverse, and an unauthored variant is
    -- indistinguishable at runtime from one that was never surfaced.
    for _, variant in { "soloVariant", "groupVariant" } do
        local authored = (definition :: any)[variant]
        if
            type(authored) ~= "table"
            or type(authored.guidance) ~= "string"
            or authored.guidance == ""
        then
            issue("event must declare " .. variant .. " guidance")
        end
    end

    local steps = definition.steps
    if type(steps) ~= "table" or #steps < 2 or #steps > 6 then
        issue("event must contain between two and six interaction steps")
    else
        local seenSteps: { [string]: boolean } = {}
        for _, step in steps do
            if type(step.id) ~= "string" or step.id == "" then
                issue("event step must have an ID")
            elseif seenSteps[step.id] then
                issue("event step IDs must be unique")
            else
                seenSteps[step.id] = true
            end
            if type(step.actionText) ~= "string" or step.actionText == "" then
                issue("event step must have action text")
            end
            if type(step.objectText) ~= "string" or step.objectText == "" then
                issue("event step must have object text")
            end
            local offset = step.offset
            if
                type(offset) ~= "table"
                or type(offset.x) ~= "number"
                or type(offset.y) ~= "number"
                or type(offset.z) ~= "number"
            then
                issue("event step must have a numeric world offset")
            end
        end
    end

    local reward = definition.reward
    if
        type(reward) ~= "table"
        or type(reward.materialId) ~= "string"
        or string.sub(reward.materialId, 1, 9) ~= "material_"
        or type(reward.amount) ~= "number"
        or reward.amount < 1
        or reward.amount ~= math.floor(reward.amount)
    then
        issue("event must declare a positive whole-material reward")
    end

    return #issues == 0, issues
end

function ExpeditionEventFlow.interactionId(eventId: string, stepId: string): string
    return INTERACTION_PREFIX .. eventId .. ":" .. stepId
end

function ExpeditionEventFlow.transactionId(
    runId: string,
    manifestHash: string,
    eventId: string
): string
    return string.format("event_reward:%s:%s:%s", runId, manifestHash, eventId)
end

function ExpeditionEventFlow.create(
    definition: any,
    runId: string,
    manifestHash: string,
    enabled: boolean?
): any
    local valid, issues = ExpeditionEventFlow.validateDefinition(definition)
    assert(valid, table.concat(issues, "; "))
    assert(type(runId) == "string" and runId ~= "", "expedition run ID is required")
    assert(type(manifestHash) == "string" and manifestHash ~= "", "manifest hash is required")

    local isEnabled = enabled ~= false and definition.enabled == true
    return {
        eventId = definition.id,
        runId = runId,
        manifestHash = manifestHash,
        status = if isEnabled then "dormant" else "disabled",
        progress = 0,
        total = #definition.steps,
        revision = 0,
        startedAt = nil,
        expiresAt = nil,
        completedAt = nil,
        failedAt = nil,
        completedSteps = {},
        participants = {},
        rewardTransactionId = nil,
    }
end

function ExpeditionEventFlow.expire(state: any, _definition: any, now: number): boolean
    if state.status ~= "active" or type(state.expiresAt) ~= "number" or now < state.expiresAt then
        return false
    end

    state.status = "failed"
    state.failedAt = now
    state.revision += 1
    return true
end

function ExpeditionEventFlow.contribute(
    state: any,
    definition: any,
    stepId: string,
    participantId: string,
    now: number
): any
    if state.eventId ~= definition.id then
        return {
            accepted = false,
            changed = false,
            reason = "event_mismatch",
        }
    end
    if state.status == "disabled" then
        return {
            accepted = false,
            changed = false,
            reason = "event_disabled",
        }
    end
    if findStep(definition, stepId) == nil then
        return {
            accepted = false,
            changed = false,
            reason = "unknown_step",
        }
    end
    if ExpeditionEventFlow.expire(state, definition, now) then
        return {
            accepted = false,
            changed = true,
            failed = true,
            reason = "event_expired",
        }
    end
    if state.status == "failed" then
        return {
            accepted = false,
            changed = false,
            reason = "event_failed",
        }
    end
    if state.completedSteps[stepId] == true then
        return {
            accepted = true,
            changed = false,
            duplicate = true,
            reason = "step_already_complete",
        }
    end
    if state.status == "completed" then
        return {
            accepted = true,
            changed = false,
            duplicate = true,
            reason = "event_already_complete",
        }
    end

    local started = false
    if state.status == "dormant" then
        state.status = "active"
        state.startedAt = now
        state.expiresAt = now + definition.durationSeconds
        started = true
    end

    state.completedSteps[stepId] = true
    state.participants[participantId] = true
    state.progress += 1
    state.revision += 1

    local completed = state.progress == state.total
    if completed then
        state.status = "completed"
        state.completedAt = now
        state.rewardTransactionId =
            ExpeditionEventFlow.transactionId(state.runId, state.manifestHash, state.eventId)
    end

    return {
        accepted = true,
        changed = true,
        completed = completed,
        started = started,
        progress = state.progress,
        total = state.total,
        rewardTransactionId = state.rewardTransactionId,
    }
end

--[[
    Which guidance a party should be reading.

    Group advice is chosen the moment a second player is working the event,
    because that is exactly when advice like "split up and turn separate
    latches" becomes possible to act on -- telling a lone player to split up
    is worse than telling them nothing. Before anyone has engaged, the solo
    line is the safe default: it describes the event rather than the party.
]]
function ExpeditionEventFlow.guidanceFor(definition: any, participantCount: any): string?
    local isGroup = type(participantCount) == "number"
        and participantCount == participantCount
        and participantCount >= 2
        and participantCount == math.floor(participantCount)
    local variant = if isGroup then definition.groupVariant else definition.soloVariant
    if type(variant) ~= "table" or type(variant.guidance) ~= "string" or variant.guidance == "" then
        return nil
    end
    return variant.guidance
end

function ExpeditionEventFlow.snapshot(state: any, definition: any, now: number): any
    local timeRemaining = nil
    if state.status == "active" and type(state.expiresAt) == "number" then
        timeRemaining = math.max(0, math.ceil(state.expiresAt - now))
    end

    local participants = participantList(state.participants)
    return {
        eventId = state.eventId,
        displayName = definition.displayName,
        status = state.status,
        objective = definition.objective,
        detail = definition.detail,
        completionMessage = definition.completionMessage,
        failureMessage = definition.failureMessage,
        failureResolution = definition.failureResolution,
        progress = state.progress,
        total = state.total,
        revision = state.revision,
        timeRemaining = timeRemaining,
        reward = definition.reward,
        rewardTransactionId = state.rewardTransactionId,
        participants = participants,
        guidance = ExpeditionEventFlow.guidanceFor(definition, #participants),
    }
end

return table.freeze(ExpeditionEventFlow)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">ExpeditionGenerator</string>
          <string name="Source"><![CDATA[--!strict

local Bramblewake = require("./Content/Definitions/BramblewakeExpedition")
local Ironroot = require("./Content/Definitions/IronrootExpedition")
local Mireglass = require("./Content/Definitions/MireglassExpedition")
local Tempest = require("./Content/Definitions/TempestExpedition")
local Cinderfall = require("./Content/Definitions/CinderfallExpedition")
local Frostmere = require("./Content/Definitions/FrostmereExpedition")
local ExpeditionEventFlow = require("./ExpeditionEventFlow")

--[[
    The generator is region-agnostic: everything it needs about a region --
    module pool, socket counts, budgets, required tags, the known-good
    fallback walk -- arrives from that region's catalog, which all declare
    the same shape. Adding a region is adding a catalog and a line in
    CATALOGS; no rule below knows a region by name.

    Bramblewake remains the default so every existing caller and every
    prior manifest hash is untouched, and the specs pin that.
]]
local ExpeditionGenerator = {}

local RANDOM_MODULUS = 2147483647
local RANDOM_MULTIPLIER = 16807
local HASH_MULTIPLIER = 33

local ROUTES = {
    { 0, 0, 1, 1, 0, 0, 3, 3, 0, 0, 0 },
    { 0, 0, 3, 3, 0, 0, 1, 1, 0, 0, 0 },
    { 1, 1, 0, 0, 0, 3, 3, 0, 0, 1, 1 },
    { 0, 1, 1, 0, 0, 0, 3, 3, 3, 0, 0 },
}

local DIRECTION_X = { 0, 1, 0, -1 }
local DIRECTION_Z = { -1, 0, 1, 0 }

local function normalizeSeed(seed: number): number
    local normalized = math.floor(math.abs(seed)) % RANDOM_MODULUS
    return if normalized == 0 then 1 else normalized
end

local function randomSource(seed: number): (number) -> number
    local state = normalizeSeed(seed)
    return function(maximum: number): number
        state = (state * RANDOM_MULTIPLIER) % RANDOM_MODULUS
        return (state % maximum) + 1
    end
end

local function shuffled(values: { any }, random: (number) -> number): { any }
    local result = table.clone(values)
    for index = #result, 2, -1 do
        local other = random(index)
        result[index], result[other] = result[other], result[index]
    end
    return result
end

local function indexDefinitions(definitions: { any }): { [string]: any }
    local byId: { [string]: any } = {}
    for _, definition in definitions do
        byId[definition.id] = definition
    end
    return byId
end

-- Catalogs are structurally alike but not identical (Bramblewake carries a
-- measured BuiltPartBudget the Delve cannot have until its builder ships),
-- so the list is typed by what the generator actually reads from it.
local CATALOGS: { any } = table.freeze({
    Bramblewake :: any,
    Ironroot :: any,
    Mireglass :: any,
    Tempest :: any,
    Frostmere :: any,
    Cinderfall :: any,
})
local DEFAULT_REGION_ID = Bramblewake.RegionId

type Region = {
    catalog: any,
    modulesById: { [string]: any },
    poisById: { [string]: any },
    eventsById: { [string]: any },
}

local REGIONS: { [string]: Region } = {}
for _, catalog in CATALOGS do
    REGIONS[catalog.RegionId] = {
        catalog = catalog,
        modulesById = indexDefinitions(catalog.Modules),
        poisById = indexDefinitions(catalog.PointsOfInterest),
        eventsById = indexDefinitions(catalog.Events),
    }
end

local function regionFor(regionId: any): Region
    local region = REGIONS[if type(regionId) == "string" then regionId else DEFAULT_REGION_ID]
    return region or REGIONS[DEFAULT_REGION_ID]
end

-- Definition lookups are region-wide: content ids carry their region's
-- prefix, so a single id never means two things.
local function findDefinition(field: string, id: any): any
    if type(id) ~= "string" then
        return nil
    end
    for _, region in REGIONS do
        local found = (region :: any)[field][id]
        if found ~= nil then
            return found
        end
    end
    return nil
end

local function hashText(hash: number, value: string): number
    local result = hash
    for index = 1, #value do
        result = (result * HASH_MULTIPLIER + string.byte(value, index)) % RANDOM_MODULUS
    end
    return result
end

function ExpeditionGenerator.computeHash(manifest: any): string
    local hash = hashText(5381, tostring(manifest.regionId))
    hash = hashText(hash, ":" .. tostring(manifest.version))
    for _, placement in manifest.modules do
        local fields = string.format(
            "|%s:%d:%d:%d:%s:%s",
            placement.moduleId,
            placement.cellX,
            placement.cellZ,
            placement.rotation,
            placement.poiId or "-",
            placement.eventId or "-"
        )
        hash = hashText(hash, fields)
    end
    return string.format("%08x", hash)
end

local function placeContent(manifest: any, random: (number) -> number, region: Region)
    local poiDefinitions = shuffled(region.catalog.PointsOfInterest, random)
    --[[
        A catalog may pin some of its points of interest so they place in
        every run. Bramblewake needs this because four of its POIs anchor
        memory fragments -- the story's collectibles -- and a fragment
        whose anchor only turns up one run in three is a story beat
        demoted to a lottery ticket. The pinned ones move to the front of
        the already-shuffled pool; the rotating remainder keeps its
        shuffled order. No extra random draws, so regions that pin nothing
        generate byte-identically to before this existed.
    ]]
    local fixedPoiIds = region.catalog.FixedPointOfInterestIds
    if fixedPoiIds ~= nil and #fixedPoiIds > 0 then
        local pinned: { [string]: boolean } = {}
        for _, poiId in fixedPoiIds do
            pinned[poiId] = true
        end
        local front, back = {}, {}
        for _, definition in poiDefinitions do
            if pinned[definition.id] then
                table.insert(front, definition)
            else
                table.insert(back, definition)
            end
        end
        for _, definition in back do
            table.insert(front, definition)
        end
        poiDefinitions = front
    end
    local eventDefinitions = shuffled(region.catalog.Events, random)
    local occupied: { [number]: boolean } = {}

    --[[
        A region's catalog holds more content than any one run shows: the
        Delve declares twelve points of interest and shows four. Placement
        therefore stops at the run's count, not at the pool's end. For
        Bramblewake, whose pool is exactly its run count, this is the same
        walk it always took.
    ]]
    local poiLimit = math.min(#poiDefinitions, region.catalog.PointOfInterestCount)
    local eventLimit = math.min(#eventDefinitions, region.catalog.EventCount)

    local poiPlacements = shuffled(manifest.modules, random)
    local poiIndex = 1
    for _, placement in poiPlacements do
        local moduleDefinition = region.modulesById[placement.moduleId]
        if moduleDefinition.poiSocket and not occupied[placement.index] then
            placement.poiId = poiDefinitions[poiIndex].id
            occupied[placement.index] = true
            poiIndex += 1
            if poiIndex > poiLimit then
                break
            end
        end
    end

    local eventPlacements = shuffled(manifest.modules, random)
    local eventIndex = 1
    for _, placement in eventPlacements do
        local moduleDefinition = region.modulesById[placement.moduleId]
        -- POI and event sockets occupy opposite authored corners of a module,
        -- so representative modules can host both without overlapping the
        -- critical path or each other. This is required to place all eight
        -- regional events while retaining all four POIs in twelve modules.
        if moduleDefinition.eventSocket then
            placement.eventId = eventDefinitions[eventIndex].id
            eventIndex += 1
            if eventIndex > eventLimit then
                break
            end
        end
    end
end

local function moduleByRole(region: Region, role: string): any
    for _, definition in region.catalog.Modules do
        if definition.role == role then
            return definition
        end
    end
    error(region.catalog.RegionId .. " catalog has no module with role " .. role)
end

--[[
    Choose the run's middle from the full pool.

    Every run still walks ModuleCount modules; the pool is what grew. The
    selection is constrained, not blind: required module ids come first,
    then each required tag's deficit is filled from the shuffled pool, then
    the remaining slots take whatever the shuffle offers. Attempts and the
    validator catch the rare shuffle this greedy pass cannot rescue.
]]
local function selectMiddle(
    region: Region,
    arrival: any,
    extraction: any,
    random: (number) -> number
): { any }
    local target = region.catalog.ModuleCount - 2
    local pool = {}
    for _, definition in region.catalog.Modules do
        if definition.role ~= "arrival" and definition.role ~= "extraction" then
            table.insert(pool, definition)
        end
    end
    pool = shuffled(pool, random)

    local chosen: { any } = {}
    local chosenIds: { [string]: boolean } = {}
    local tagCounts: { [string]: number } = {}
    local function countTags(definition: any)
        for _, tag in definition.tags do
            tagCounts[tag] = (tagCounts[tag] or 0) + 1
        end
    end
    countTags(arrival)
    countTags(extraction)
    local function take(definition: any)
        if chosenIds[definition.id] then
            return
        end
        chosenIds[definition.id] = true
        table.insert(chosen, definition)
        countTags(definition)
    end

    for _, moduleId in region.catalog.RequiredModuleIds do
        for _, definition in pool do
            if definition.id == moduleId then
                take(definition)
                break
            end
        end
    end
    for tag, minimum in region.catalog.RequiredTags :: { [string]: number } do
        while (tagCounts[tag] or 0) < minimum and #chosen < target do
            local found = false
            for _, definition in pool do
                if not chosenIds[definition.id] then
                    for _, candidateTag in definition.tags do
                        if candidateTag == tag then
                            take(definition)
                            found = true
                            break
                        end
                    end
                end
                if found then
                    break
                end
            end
            if not found then
                break
            end
        end
    end
    for _, definition in pool do
        if #chosen >= target then
            break
        end
        take(definition)
    end
    -- Selection order carries shuffle bias toward required content at the
    -- front; one more shuffle makes the walk order its own surprise.
    return shuffled(chosen, random)
end

local function assemble(
    seed: number,
    attempt: number,
    source: string,
    fixed: boolean,
    region: Region
): any
    local random = randomSource(seed + attempt * 7919)
    local arrival = moduleByRole(region, "arrival")
    local extraction = moduleByRole(region, "extraction")
    local middle
    if fixed then
        middle = {}
        for _, moduleId in region.catalog.FixedMiddleIds do
            table.insert(middle, region.modulesById[moduleId])
        end
    else
        middle = selectMiddle(region, arrival, extraction, random)
    end

    local sequence = { arrival }
    for _, definition in middle do
        table.insert(sequence, definition)
    end
    table.insert(sequence, extraction)

    local route = if fixed then ROUTES[1] else ROUTES[random(#ROUTES)]
    local modules = {}
    local cellX = 0
    local cellZ = 0
    for index, definition in sequence do
        local direction = if index <= #route then route[index] else route[#route]
        table.insert(modules, {
            index = index,
            moduleId = definition.id,
            cellX = cellX,
            cellZ = cellZ,
            rotation = direction * 90,
        })
        if index <= #route then
            cellX += DIRECTION_X[direction + 1]
            cellZ += DIRECTION_Z[direction + 1]
        end
    end

    local manifest = {
        version = region.catalog.Version,
        regionId = region.catalog.RegionId,
        seed = normalizeSeed(seed),
        source = source,
        attempts = attempt,
        modules = modules,
    }
    placeContent(manifest, random, region)
    manifest.hash = ExpeditionGenerator.computeHash(manifest)
    return manifest
end

function ExpeditionGenerator.validate(manifest: any): (boolean, { string })
    local issues: { string } = {}
    local function issue(message: string)
        table.insert(issues, message)
    end

    if type(manifest) ~= "table" then
        return false, { "manifest must be a table" }
    end
    if REGIONS[manifest.regionId] == nil then
        return false, { "manifest names no known region" }
    end
    local region = regionFor(manifest.regionId)
    local catalog = region.catalog
    if manifest.version ~= catalog.Version then
        issue("manifest version does not match the " .. catalog.RegionId .. " catalog")
    end
    if type(manifest.modules) ~= "table" or #manifest.modules ~= catalog.ModuleCount then
        issue(string.format("manifest must contain %d modules", catalog.ModuleCount))
        return false, issues
    end

    local seenModules: { [string]: boolean } = {}
    local seenCells: { [string]: boolean } = {}
    local seenPois: { [string]: boolean } = {}
    local seenEvents: { [string]: boolean } = {}
    local tagCounts: { [string]: number } = {}
    local totalParts = 0
    local totalLights = 0
    local totalEffects = 0

    for index, placement in manifest.modules do
        if placement.index ~= index then
            issue(string.format("module %d has an invalid sequence index", index))
        end
        local definition = region.modulesById[placement.moduleId]
        if definition == nil then
            issue(string.format("module %d references unknown content", index))
        else
            if definition.enabled ~= true then
                issue("manifest contains a disabled module")
            end
            if definition.defaultTraversal ~= true then
                issue("critical path requires a profession or premium traversal ability")
            end
            if seenModules[definition.id] then
                issue("module content repeats in the representative slice")
            end
            seenModules[definition.id] = true
            totalParts += definition.partBudget
            totalLights += definition.lightBudget
            totalEffects += definition.effectBudget
            for _, tag in definition.tags do
                tagCounts[tag] = (tagCounts[tag] or 0) + 1
            end
        end

        if type(placement.cellX) ~= "number" or type(placement.cellZ) ~= "number" then
            issue(string.format("module %d has invalid cell coordinates", index))
        else
            local cellKey = string.format("%d:%d", placement.cellX, placement.cellZ)
            if seenCells[cellKey] then
                issue("route overlaps a previously occupied streaming cell")
            end
            seenCells[cellKey] = true
            if index > 1 then
                local previous = manifest.modules[index - 1]
                local distance = math.abs(placement.cellX - previous.cellX)
                    + math.abs(placement.cellZ - previous.cellZ)
                if distance ~= 1 then
                    issue(string.format("module %d is disconnected from the critical path", index))
                end
            end
        end

        if placement.poiId ~= nil then
            if region.poisById[placement.poiId] == nil then
                issue("manifest references an unknown point of interest")
            elseif region.poisById[placement.poiId].enabled ~= true then
                issue("manifest contains a disabled point of interest")
            elseif seenPois[placement.poiId] then
                issue("point of interest repeats in one expedition")
            elseif definition ~= nil and not definition.poiSocket then
                issue("point of interest occupies an incompatible module")
            end
            seenPois[placement.poiId] = true
        end
        if placement.eventId ~= nil then
            local eventDefinition = region.eventsById[placement.eventId]
            if eventDefinition == nil then
                issue("manifest references an unknown event")
            elseif eventDefinition.enabled ~= true then
                issue("manifest contains a disabled event")
            elseif seenEvents[placement.eventId] then
                issue("event repeats in one expedition")
            elseif definition ~= nil and not definition.eventSocket then
                issue("event occupies an incompatible module")
            else
                local contractValid, contractIssues =
                    ExpeditionEventFlow.validateDefinition(eventDefinition)
                if not contractValid then
                    issue("event contract is invalid: " .. table.concat(contractIssues, ", "))
                end
                if eventDefinition.minimumRouteSpace > catalog.CellSize - 24 then
                    issue("event route-space requirement exceeds its module clearing")
                end
            end
            seenEvents[placement.eventId] = true
        end
    end

    local firstDefinition = region.modulesById[manifest.modules[1].moduleId]
    local lastDefinition = region.modulesById[manifest.modules[#manifest.modules].moduleId]
    if firstDefinition == nil or firstDefinition.role ~= "arrival" then
        issue("critical path does not begin at an arrival module")
    end
    if lastDefinition == nil or lastDefinition.role ~= "extraction" then
        issue("critical path does not end at an extraction module")
    end

    local poiCount = 0
    for _ in seenPois do
        poiCount += 1
    end
    local eventCount = 0
    for _ in seenEvents do
        eventCount += 1
    end
    if poiCount ~= catalog.PointOfInterestCount then
        issue(
            string.format("manifest must place %d points of interest", catalog.PointOfInterestCount)
        )
    end
    if eventCount ~= catalog.EventCount then
        issue(string.format("manifest must place %d events", catalog.EventCount))
    end

    local requiredTags = catalog.RequiredTags :: { [string]: number }
    for tag, minimum in requiredTags do
        if (tagCounts[tag] or 0) < minimum then
            issue(string.format("manifest does not meet the %s module minimum", tag))
        end
    end
    for _, moduleId in catalog.RequiredModuleIds do
        if not seenModules[moduleId] then
            issue("manifest is missing required module " .. moduleId)
        end
    end
    if totalParts > catalog.PartBudget then
        issue("manifest exceeds the regional part budget")
    end
    if totalLights > catalog.LightBudget then
        issue("manifest exceeds the regional light budget")
    end
    if totalEffects > catalog.EffectBudget then
        issue("manifest exceeds the regional effect budget")
    end
    if manifest.hash ~= ExpeditionGenerator.computeHash(manifest) then
        issue("manifest hash does not match its content")
    end

    return #issues == 0, issues
end

function ExpeditionGenerator.generate(
    seed: number,
    forceFallback: boolean?,
    avoidHashes: { [string]: boolean }?,
    regionId: string?
): any
    local region = regionFor(regionId)
    local normalizedSeed = normalizeSeed(seed)
    if not forceFallback then
        -- Repetition control: a caller that remembers recent manifests can
        -- ask for something it has not walked lately. A repeat is a
        -- preference, validity is a requirement — if every attempt lands on
        -- an avoided hash, the last valid manifest wins anyway.
        local lastValid = nil
        for attempt = 1, if avoidHashes ~= nil then 5 else 3 do
            local manifest = assemble(normalizedSeed, attempt, "generated", false, region)
            local valid = ExpeditionGenerator.validate(manifest)
            if valid then
                if avoidHashes == nil or avoidHashes[manifest.hash] ~= true then
                    return manifest
                end
                lastValid = manifest
            end
        end
        if lastValid ~= nil then
            return lastValid
        end
    end

    local fallback = assemble(normalizedSeed, 3, "known_good_fallback", true, region)
    local valid, issues = ExpeditionGenerator.validate(fallback)
    assert(
        valid,
        "known-good "
            .. region.catalog.RegionId
            .. " fallback is invalid: "
            .. table.concat(issues, "; ")
    )
    return fallback
end

function ExpeditionGenerator.moduleDefinition(moduleId: string): any
    return findDefinition("modulesById", moduleId)
end

function ExpeditionGenerator.pointOfInterestDefinition(poiId: string): any
    return findDefinition("poisById", poiId)
end

function ExpeditionGenerator.eventDefinition(eventId: string): any
    return findDefinition("eventsById", eventId)
end

-- The region catalogs the generator can compose, in declaration order.
function ExpeditionGenerator.regionIds(): { string }
    local ids: { string } = {}
    for _, catalog in CATALOGS do
        table.insert(ids, catalog.RegionId)
    end
    return ids
end

function ExpeditionGenerator.catalogFor(regionId: string?): any
    return regionFor(regionId).catalog
end

return table.freeze(ExpeditionGenerator)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">ExpeditionInventory</string>
          <string name="Source"><![CDATA[--!strict

local ExpeditionInventory = {}

local MAX_MATERIAL_STACK = 999999
local MAX_REWARD_AMOUNT = 100
local MAX_REWARD_TRANSACTIONS = 512
local MAX_SETTLEMENTS = 128
local MAX_RECOVERY_CACHES = 16
local HASH_MODULUS = 2147483647
local HASH_MULTIPLIER = 33

--[[
    Every material the ledger will accept, by region. A material outside
    this list is refused at the grant call, which is what keeps a bad
    reward shape from quietly inventing currency -- the lesson of #212.
]]
local KNOWN_MATERIALS = table.freeze({
    -- Bramblewake
    material_amber_sap = true,
    material_brightcap = true,
    material_heartwood = true,
    material_meadow_fiber = true,
    material_spring_clay = true,
    -- Ironroot Delve
    material_ironroot_ore = true,
    material_coalglass = true,
    material_glow_fungus = true,
    material_machine_oil = true,
    material_echo_crystal = true,
    -- Mireglass Fen
    material_mirror_reed = true,
    material_bog_iron = true,
    material_witchlight_pollen = true,
    material_eel_oil = true,
    material_blackwater_herb = true,
    -- Tempest Reach
    material_storm_glass = true,
    material_salt_kelp = true,
    material_ships_iron = true,
    material_rope_fiber = true,
    material_amberglass = true,
    -- Frostmere Vale
    material_frostmere_ice = true,
    material_thawed_iron = true,
    material_ember_moss = true,
    material_frostmere_wool = true,
    material_aurora_salt = true,
    -- Cinderfall Crown
    material_cindersteel = true,
    material_memory_glass = true,
    material_ash_silk = true,
    material_kiln_pearl = true,
    material_crown_coal = true,
})

local function hashText(hash: number, value: string): number
    local result = hash
    for index = 1, #value do
        result = (result * HASH_MULTIPLIER + string.byte(value, index)) % HASH_MODULUS
    end
    return result
end

local function validMaterialId(materialId: any): boolean
    return type(materialId) == "string" and KNOWN_MATERIALS[materialId] == true
end

local function validTransactionId(transactionId: any): boolean
    return type(transactionId) == "string" and transactionId ~= "" and #transactionId <= 180
end

local function cloneInventory(inventory: any): any
    return {
        materials = table.clone(inventory.materials),
        expeditionRewards = table.clone(inventory.expeditionRewards),
        rewardOrder = table.clone(inventory.rewardOrder),
        settlements = table.clone(inventory.settlements),
        settlementOrder = table.clone(inventory.settlementOrder),
        recoveryCaches = table.clone(inventory.recoveryCaches),
        recoveryOrder = table.clone(inventory.recoveryOrder),
    }
end

local function makeRewardSpace(inventory: any): boolean
    while #inventory.rewardOrder >= MAX_REWARD_TRANSACTIONS do
        local removeIndex = nil
        for index, transactionId in inventory.rewardOrder do
            local record = inventory.expeditionRewards[transactionId]
            if record ~= nil and record.status == "settled" then
                removeIndex = index
                break
            end
        end
        if removeIndex == nil then
            return false
        end
        local removedTransactionId = table.remove(inventory.rewardOrder, removeIndex)
        inventory.expeditionRewards[removedTransactionId] = nil
    end
    return true
end

local function normalizeMaterials(value: any): { [string]: number }
    local materials: { [string]: number } = {}
    if type(value) ~= "table" then
        return materials
    end
    for materialId, amount in value do
        if validMaterialId(materialId) and type(amount) == "number" and amount >= 0 then
            materials[materialId] = math.clamp(math.floor(amount), 0, MAX_MATERIAL_STACK)
        end
    end
    return materials
end

local function normalizeTransactionIds(value: any): { string }
    local transactionIds = {}
    local seen: { [string]: boolean } = {}
    if type(value) ~= "table" then
        return transactionIds
    end
    for _, transactionId in value do
        if #transactionIds >= MAX_REWARD_TRANSACTIONS then
            break
        end
        if validTransactionId(transactionId) and not seen[transactionId] then
            seen[transactionId] = true
            table.insert(transactionIds, transactionId)
        end
    end
    return transactionIds
end

function ExpeditionInventory.default(): any
    return {
        materials = {},
        expeditionRewards = {},
        rewardOrder = {},
        settlements = {},
        settlementOrder = {},
        recoveryCaches = {},
        recoveryOrder = {},
    }
end

function ExpeditionInventory.normalize(value: any): any
    local inventory = ExpeditionInventory.default()
    if type(value) ~= "table" then
        return inventory
    end

    inventory.materials = normalizeMaterials(value.materials)
    if type(value.expeditionRewards) == "table" and type(value.rewardOrder) == "table" then
        for _, transactionId in value.rewardOrder do
            if #inventory.rewardOrder >= MAX_REWARD_TRANSACTIONS then
                break
            end
            local record = value.expeditionRewards[transactionId]
            if
                validTransactionId(transactionId)
                and type(record) == "table"
                and validMaterialId(record.materialId)
                and type(record.amount) == "number"
                and record.amount >= 1
                and record.amount <= MAX_REWARD_AMOUNT
                and (record.status == "unbanked" or record.status == "cached" or record.status == "settled")
                and inventory.expeditionRewards[transactionId] == nil
            then
                inventory.expeditionRewards[transactionId] = {
                    amount = math.floor(record.amount),
                    grantedAt = if type(record.grantedAt) == "number"
                        then math.floor(record.grantedAt)
                        else 0,
                    manifestHash = if type(record.manifestHash) == "string"
                        then string.sub(record.manifestHash, 1, 32)
                        else "unknown",
                    materialId = record.materialId,
                    cacheId = if type(record.cacheId) == "string"
                            and validTransactionId(record.cacheId)
                        then record.cacheId
                        else nil,
                    settledBy = if type(record.settledBy) == "string"
                        then string.sub(record.settledBy, 1, 180)
                        else nil,
                    status = record.status,
                }
                table.insert(inventory.rewardOrder, transactionId)
            end
        end
    end

    if type(value.settlements) == "table" and type(value.settlementOrder) == "table" then
        for _, settlementId in value.settlementOrder do
            if #inventory.settlementOrder >= MAX_SETTLEMENTS then
                break
            end
            local record = value.settlements[settlementId]
            if
                validTransactionId(settlementId)
                and type(record) == "table"
                and inventory.settlements[settlementId] == nil
            then
                inventory.settlements[settlementId] = {
                    manifestHash = if type(record.manifestHash) == "string"
                        then string.sub(record.manifestHash, 1, 32)
                        else "unknown",
                    materials = normalizeMaterials(record.materials),
                    rewardTransactionIds = normalizeTransactionIds(record.rewardTransactionIds),
                    settledAt = if type(record.settledAt) == "number"
                        then math.floor(record.settledAt)
                        else 0,
                }
                table.insert(inventory.settlementOrder, settlementId)
            end
        end
    end
    if type(value.recoveryCaches) == "table" and type(value.recoveryOrder) == "table" then
        for _, cacheId in value.recoveryOrder do
            if #inventory.recoveryOrder >= MAX_RECOVERY_CACHES then
                break
            end
            local record = value.recoveryCaches[cacheId]
            if
                validTransactionId(cacheId)
                and type(record) == "table"
                and (record.status == "active" or record.status == "recovered")
                and inventory.recoveryCaches[cacheId] == nil
            then
                local transactionIds = normalizeTransactionIds(record.rewardTransactionIds)
                local validIds = {}
                for _, transactionId in transactionIds do
                    local reward = inventory.expeditionRewards[transactionId]
                    if
                        record.status == "recovered"
                        or (
                            reward ~= nil
                            and reward.status == "cached"
                            and reward.cacheId == cacheId
                        )
                    then
                        table.insert(validIds, transactionId)
                    end
                end
                if record.status == "recovered" or #validIds > 0 then
                    inventory.recoveryCaches[cacheId] = {
                        createdAt = if type(record.createdAt) == "number"
                            then math.floor(record.createdAt)
                            else 0,
                        manifestHash = if type(record.manifestHash) == "string"
                            then string.sub(record.manifestHash, 1, 32)
                            else "unknown",
                        recoveredAt = if type(record.recoveredAt) == "number"
                            then math.floor(record.recoveredAt)
                            else nil,
                        rewardTransactionIds = validIds,
                        status = record.status,
                    }
                    table.insert(inventory.recoveryOrder, cacheId)
                end
            end
        end
    end
    return inventory
end

function ExpeditionInventory.addUnbanked(
    inventory: any,
    transactionId: string,
    manifestHash: string,
    reward: any,
    now: number
): (any, any)
    if not validTransactionId(transactionId) then
        return inventory,
            {
                applied = false,
                reason = "invalid_transaction",
            }
    end
    if
        type(reward) ~= "table"
        or not validMaterialId(reward.materialId)
        or type(reward.amount) ~= "number"
        or reward.amount < 1
        or reward.amount > MAX_REWARD_AMOUNT
        or reward.amount ~= math.floor(reward.amount)
    then
        return inventory,
            {
                applied = false,
                reason = "invalid_reward",
            }
    end

    local existing = inventory.expeditionRewards[transactionId]
    if existing ~= nil then
        return inventory,
            {
                applied = false,
                duplicate = true,
                record = table.clone(existing),
            }
    end
    local nextInventory = cloneInventory(inventory)
    if not makeRewardSpace(nextInventory) then
        return inventory,
            {
                applied = false,
                reason = "unbanked_pouch_full",
            }
    end
    local record = {
        amount = reward.amount,
        grantedAt = math.floor(now),
        manifestHash = string.sub(manifestHash, 1, 32),
        materialId = reward.materialId,
        cacheId = nil,
        settledBy = nil,
        status = "unbanked",
    }
    nextInventory.expeditionRewards[transactionId] = record
    table.insert(nextInventory.rewardOrder, transactionId)
    return nextInventory, {
        applied = true,
        record = table.clone(record),
    }
end

local function recoveryMaterials(inventory: any, transactionIds: { string }): { [string]: number }
    local materials: { [string]: number } = {}
    for _, transactionId in transactionIds do
        local reward = inventory.expeditionRewards[transactionId]
        if reward ~= nil then
            materials[reward.materialId] = (materials[reward.materialId] or 0) + reward.amount
        end
    end
    return materials
end

function ExpeditionInventory.recoveryCacheId(
    runId: string,
    userId: number,
    fingerprint: string
): string
    assert(type(runId) == "string" and runId ~= "", "expedition run ID is required")
    assert(userId > 0, "recovery user ID is invalid")
    return string.format(
        "expedition_cache:%s:%d:%s",
        string.sub(runId, 1, 64),
        userId,
        string.sub(fingerprint, 1, 16)
    )
end

function ExpeditionInventory.cacheAfterFailure(
    inventory: any,
    cacheId: string,
    manifestHash: string,
    now: number
): (any, any)
    if not validTransactionId(cacheId) then
        return inventory, { applied = false, reason = "invalid_cache" }
    end
    local existing = inventory.recoveryCaches[cacheId]
    if existing ~= nil then
        return inventory,
            {
                applied = false,
                duplicate = true,
                cacheId = cacheId,
                record = table.clone(existing),
            }
    end
    local pending = ExpeditionInventory.pending(inventory)
    if pending.count < 2 then
        return inventory, { applied = false, reason = "insufficient_pouch" }
    end

    local selected = {}
    local cacheCount = math.floor(pending.count / 2)
    for index = pending.count - cacheCount + 1, pending.count do
        table.insert(selected, pending.transactionIds[index])
    end
    local nextInventory = cloneInventory(inventory)
    while #nextInventory.recoveryOrder >= MAX_RECOVERY_CACHES do
        local oldestId = nextInventory.recoveryOrder[1]
        local oldest = nextInventory.recoveryCaches[oldestId]
        if oldest == nil or oldest.status == "recovered" then
            table.remove(nextInventory.recoveryOrder, 1)
            nextInventory.recoveryCaches[oldestId] = nil
        else
            return inventory, { applied = false, reason = "recovery_cache_full" }
        end
    end
    for _, transactionId in selected do
        local reward = table.clone(nextInventory.expeditionRewards[transactionId])
        reward.status = "cached"
        reward.cacheId = cacheId
        nextInventory.expeditionRewards[transactionId] = reward
    end
    local record = {
        createdAt = math.floor(now),
        manifestHash = string.sub(manifestHash, 1, 32),
        recoveredAt = nil,
        rewardTransactionIds = selected,
        status = "active",
    }
    nextInventory.recoveryCaches[cacheId] = record
    table.insert(nextInventory.recoveryOrder, cacheId)
    return nextInventory,
        {
            applied = true,
            cacheId = cacheId,
            materials = recoveryMaterials(nextInventory, selected),
            record = table.clone(record),
            retained = pending.count - cacheCount,
            transactionIds = table.clone(selected),
        }
end

function ExpeditionInventory.activeRecovery(inventory: any): any
    for _, cacheId in inventory.recoveryOrder do
        local record = inventory.recoveryCaches[cacheId]
        if record ~= nil and record.status == "active" then
            return {
                cacheId = cacheId,
                createdAt = record.createdAt,
                manifestHash = record.manifestHash,
                materials = recoveryMaterials(inventory, record.rewardTransactionIds),
                transactionIds = table.clone(record.rewardTransactionIds),
            }
        end
    end
    return nil
end

function ExpeditionInventory.cachedTransactionIds(inventory: any): { string }
    local result = {}
    for _, transactionId in inventory.rewardOrder do
        local reward = inventory.expeditionRewards[transactionId]
        if reward ~= nil and reward.status == "cached" then
            table.insert(result, transactionId)
        end
    end
    table.sort(result)
    return result
end

function ExpeditionInventory.recover(inventory: any, cacheId: string, now: number): (any, any)
    local record = inventory.recoveryCaches[cacheId]
    if record == nil then
        return inventory, { applied = false, reason = "unknown_cache" }
    end
    if record.status ~= "active" then
        return inventory,
            {
                applied = false,
                cacheId = cacheId,
                duplicate = true,
                materials = recoveryMaterials(inventory, record.rewardTransactionIds),
                reason = "cache_recovered",
                transactionIds = table.clone(record.rewardTransactionIds),
            }
    end
    local nextInventory = cloneInventory(inventory)
    local recoveredRecord = table.clone(record)
    recoveredRecord.status = "recovered"
    recoveredRecord.recoveredAt = math.floor(now)
    nextInventory.recoveryCaches[cacheId] = recoveredRecord
    for _, transactionId in record.rewardTransactionIds do
        local reward = nextInventory.expeditionRewards[transactionId]
        if reward ~= nil and reward.status == "cached" and reward.cacheId == cacheId then
            local recoveredReward = table.clone(reward)
            recoveredReward.status = "unbanked"
            recoveredReward.cacheId = nil
            nextInventory.expeditionRewards[transactionId] = recoveredReward
        end
    end
    return nextInventory,
        {
            applied = true,
            cacheId = cacheId,
            materials = recoveryMaterials(nextInventory, record.rewardTransactionIds),
            transactionIds = table.clone(record.rewardTransactionIds),
        }
end

function ExpeditionInventory.pending(inventory: any): any
    local materials: { [string]: number } = {}
    local rewards = {}
    local transactionIds = {}
    for _, transactionId in inventory.rewardOrder do
        local record = inventory.expeditionRewards[transactionId]
        if record ~= nil and record.status == "unbanked" then
            materials[record.materialId] = (materials[record.materialId] or 0) + record.amount
            table.insert(transactionIds, transactionId)
            table.insert(rewards, {
                amount = record.amount,
                manifestHash = record.manifestHash,
                materialId = record.materialId,
                transactionId = transactionId,
            })
        end
    end
    table.sort(transactionIds)
    table.sort(rewards, function(left: any, right: any): boolean
        return left.transactionId < right.transactionId
    end)

    local hash = 5381
    for _, transactionId in transactionIds do
        hash = hashText(hash, "|" .. transactionId)
    end
    return {
        count = #transactionIds,
        fingerprint = string.format("%08x", hash),
        materials = materials,
        rewards = rewards,
        transactionIds = transactionIds,
    }
end

function ExpeditionInventory.settlementId(
    runId: string,
    userId: number,
    pendingFingerprint: string
): string
    assert(type(runId) == "string" and runId ~= "", "expedition run ID is required")
    assert(userId > 0, "settlement user ID is invalid")
    return string.format(
        "expedition_settlement:%s:%d:%s",
        string.sub(runId, 1, 64),
        userId,
        pendingFingerprint
    )
end

function ExpeditionInventory.settle(
    inventory: any,
    settlementId: string,
    manifestHash: string,
    now: number,
    storageCap: number?
): (any, any)
    if not validTransactionId(settlementId) then
        return inventory,
            {
                applied = false,
                reason = "invalid_settlement",
            }
    end
    local existing = inventory.settlements[settlementId]
    if existing ~= nil then
        return inventory,
            {
                applied = false,
                duplicate = true,
                record = table.clone(existing),
            }
    end

    local pending = ExpeditionInventory.pending(inventory)
    if pending.count == 0 then
        return inventory, {
            applied = false,
            empty = true,
        }
    end

    local nextInventory = cloneInventory(inventory)
    -- Milestone 4's storage cap. The town's stores hold what its tier has
    -- earned room for; surplus is counted and REPORTED, never silently
    -- discarded -- the toast that says "stores full" is the reason a player
    -- funds the next tier.
    local cap = math.min(MAX_MATERIAL_STACK, math.floor(tonumber(storageCap) or MAX_MATERIAL_STACK))
    local overflow: { [string]: number } = {}
    local overflowTotal = 0
    for materialId, amount in pending.materials do
        local current = nextInventory.materials[materialId] or 0
        local accepted = math.max(0, math.min(cap, current + amount) - current)
        nextInventory.materials[materialId] = current + accepted
        if accepted < amount then
            overflow[materialId] = amount - accepted
            overflowTotal += amount - accepted
        end
    end
    for _, transactionId in pending.transactionIds do
        local record = table.clone(nextInventory.expeditionRewards[transactionId])
        record.status = "settled"
        record.settledBy = settlementId
        nextInventory.expeditionRewards[transactionId] = record
    end

    local settlementRecord = {
        manifestHash = string.sub(manifestHash, 1, 32),
        materials = table.clone(pending.materials),
        overflow = if overflowTotal > 0 then table.clone(overflow) else nil,
        rewardTransactionIds = table.clone(pending.transactionIds),
        settledAt = math.floor(now),
    }
    nextInventory.settlements[settlementId] = settlementRecord
    table.insert(nextInventory.settlementOrder, settlementId)
    if #nextInventory.settlementOrder > MAX_SETTLEMENTS then
        local oldest = table.remove(nextInventory.settlementOrder, 1)
        nextInventory.settlements[oldest] = nil
    end

    return nextInventory,
        {
            applied = true,
            record = table.clone(settlementRecord),
            overflowTotal = overflowTotal,
        }
end

function ExpeditionInventory.hasSettlement(inventory: any, settlementId: string): boolean
    return inventory.settlements[settlementId] ~= nil
end

function ExpeditionInventory.hasReward(inventory: any, transactionId: string): boolean
    return inventory.expeditionRewards[transactionId] ~= nil
end

function ExpeditionInventory.findSettlementForRewards(
    inventory: any,
    rewardTransactionIds: { string }
): (string?, any?)
    if #rewardTransactionIds == 0 then
        return nil, nil
    end
    local wanted: { [string]: boolean } = {}
    for _, transactionId in rewardTransactionIds do
        wanted[transactionId] = true
    end
    for index = #inventory.settlementOrder, 1, -1 do
        local settlementId = inventory.settlementOrder[index]
        local record = inventory.settlements[settlementId]
        local found = 0
        if record ~= nil then
            for _, transactionId in record.rewardTransactionIds do
                if wanted[transactionId] then
                    found += 1
                end
            end
        end
        if found == #rewardTransactionIds then
            return settlementId, table.clone(record)
        end
    end
    return nil, nil
end

return table.freeze(ExpeditionInventory)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">ExpeditionRewardLedger</string>
          <string name="Source"><![CDATA[--!strict

local ExpeditionRewardLedger = {}

function ExpeditionRewardLedger.create(): any
    return {
        users = {},
    }
end

function ExpeditionRewardLedger.grant(
    ledger: any,
    userId: number,
    transactionId: string,
    manifestHash: string,
    reward: any
): (boolean, any)
    assert(type(userId) == "number" and userId > 0, "reward user ID is invalid")
    assert(
        type(transactionId) == "string" and transactionId ~= "",
        "reward transaction ID is required"
    )
    assert(
        type(reward) == "table"
            and type(reward.materialId) == "string"
            and string.sub(reward.materialId, 1, 9) == "material_"
            and type(reward.amount) == "number"
            -- Infinity satisfies both of the checks below on its own: it is
            -- greater than one, and math.floor of it is itself. Without this
            -- line an infinite amount was a valid reward.
            and reward.amount < math.huge
            and reward.amount >= 1
            and reward.amount == math.floor(reward.amount),
        "reward contract is invalid"
    )

    local userLedger = ledger.users[userId]
    if userLedger == nil then
        userLedger = {
            materials = {},
            settlements = {},
            transactions = {},
        }
        ledger.users[userId] = userLedger
    end
    local prior = userLedger.transactions[transactionId]
    if prior ~= nil then
        return false, table.clone(prior)
    end

    local result = {
        amount = reward.amount,
        manifestHash = manifestHash,
        materialId = reward.materialId,
        settled = false,
        transactionId = transactionId,
        userId = userId,
    }
    userLedger.transactions[transactionId] = result
    userLedger.materials[reward.materialId] = (userLedger.materials[reward.materialId] or 0)
        + reward.amount
    return true, table.clone(result)
end

function ExpeditionRewardLedger.pending(ledger: any, userId: number): any
    local userLedger = ledger.users[userId]
    local rewards = {}
    local transactionIds = {}
    if userLedger ~= nil then
        for transactionId, record in userLedger.transactions do
            if record.settled ~= true then
                table.insert(transactionIds, transactionId)
                table.insert(rewards, {
                    amount = record.amount,
                    manifestHash = record.manifestHash,
                    materialId = record.materialId,
                    transactionId = transactionId,
                })
            end
        end
    end
    table.sort(transactionIds)
    table.sort(rewards, function(left: any, right: any): boolean
        return left.transactionId < right.transactionId
    end)
    return {
        materials = if userLedger == nil then {} else table.clone(userLedger.materials),
        rewards = rewards,
        transactionCount = #transactionIds,
        transactionIds = transactionIds,
    }
end

function ExpeditionRewardLedger.settle(
    ledger: any,
    userId: number,
    settlementId: string,
    transactionIds: { string }
): (boolean, any)
    local userLedger = ledger.users[userId]
    if userLedger == nil then
        return false, {
            empty = true,
        }
    end
    local existing = userLedger.settlements[settlementId]
    if existing ~= nil then
        return false, table.clone(existing)
    end

    local settledIds = {}
    for _, transactionId in transactionIds do
        local record = userLedger.transactions[transactionId]
        if record ~= nil and record.settled ~= true then
            record.settled = true
            userLedger.materials[record.materialId] =
                math.max(0, (userLedger.materials[record.materialId] or 0) - record.amount)
            table.insert(settledIds, transactionId)
        end
    end
    local result = {
        settlementId = settlementId,
        transactionIds = settledIds,
    }
    userLedger.settlements[settlementId] = result
    return #settledIds > 0, table.clone(result)
end

function ExpeditionRewardLedger.snapshot(ledger: any, userId: number): any
    return ExpeditionRewardLedger.pending(ledger, userId)
end

return table.freeze(ExpeditionRewardLedger)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">ExtractionPayoff</string>
          <string name="Source"><![CDATA[--!strict

local ExtractionPayoff = {}

local PRESENTATION = table.freeze({
    -- Bramblewake
    material_amber_sap = table.freeze({ kind = "amber", label = "AMBER SAP" }),
    material_brightcap = table.freeze({ kind = "brightcap", label = "BRIGHTCAP" }),
    material_heartwood = table.freeze({ kind = "heartwood", label = "HEARTWOOD" }),
    material_meadow_fiber = table.freeze({ kind = "fiber", label = "MEADOW FIBER" }),
    material_spring_clay = table.freeze({ kind = "clay", label = "SPRING CLAY" }),
    -- Ironroot Delve
    material_ironroot_ore = table.freeze({ kind = "ore", label = "IRONROOT ORE" }),
    material_coalglass = table.freeze({ kind = "coalglass", label = "COALGLASS" }),
    material_glow_fungus = table.freeze({ kind = "fungus", label = "GLOW FUNGUS" }),
    material_machine_oil = table.freeze({ kind = "oil", label = "MACHINE OIL" }),
    material_echo_crystal = table.freeze({ kind = "crystal", label = "ECHO CRYSTAL" }),
    -- Mireglass Fen
    material_mirror_reed = table.freeze({ kind = "reed", label = "MIRROR REED" }),
    material_bog_iron = table.freeze({ kind = "bog_iron", label = "BOG IRON" }),
    material_witchlight_pollen = table.freeze({ kind = "pollen", label = "WITCHLIGHT POLLEN" }),
    material_eel_oil = table.freeze({ kind = "eel_oil", label = "EEL OIL" }),
    material_blackwater_herb = table.freeze({ kind = "herb", label = "BLACKWATER HERB" }),
    -- Tempest Reach
    material_storm_glass = table.freeze({ kind = "storm_glass", label = "STORM GLASS" }),
    material_salt_kelp = table.freeze({ kind = "kelp", label = "SALT KELP" }),
    material_ships_iron = table.freeze({ kind = "ships_iron", label = "SHIP'S IRON" }),
    material_rope_fiber = table.freeze({ kind = "rope", label = "ROPE FIBER" }),
    material_amberglass = table.freeze({ kind = "amberglass", label = "AMBERGLASS" }),
    -- Frostmere Vale
    material_frostmere_ice = table.freeze({ kind = "ice", label = "FROSTMERE ICE" }),
    material_thawed_iron = table.freeze({ kind = "thawed_iron", label = "THAWED IRON" }),
    material_ember_moss = table.freeze({ kind = "ember_moss", label = "EMBER MOSS" }),
    material_frostmere_wool = table.freeze({ kind = "wool", label = "FROSTMERE WOOL" }),
    material_aurora_salt = table.freeze({ kind = "aurora_salt", label = "AURORA SALT" }),
    -- Cinderfall Crown
    material_cindersteel = table.freeze({ kind = "cindersteel", label = "CINDERSTEEL" }),
    material_memory_glass = table.freeze({ kind = "memory_glass", label = "MEMORY GLASS" }),
    material_ash_silk = table.freeze({ kind = "ash_silk", label = "ASH SILK" }),
    material_kiln_pearl = table.freeze({ kind = "kiln_pearl", label = "KILN PEARL" }),
    material_crown_coal = table.freeze({ kind = "crown_coal", label = "CROWN COAL" }),
})

export type Entry = {
    amount: number,
    id: string,
    kind: string,
    label: string,
}

function ExtractionPayoff.summarize(materials: any): ({ Entry }, number)
    local entries: { Entry } = {}
    local total = 0
    if type(materials) ~= "table" then
        return entries, total
    end
    for materialId, amount in materials do
        local presentation = PRESENTATION[materialId]
        if presentation ~= nil and type(amount) == "number" and amount > 0 then
            local safeAmount = math.max(1, math.floor(amount))
            total += safeAmount
            table.insert(entries, {
                amount = safeAmount,
                id = materialId,
                kind = presentation.kind,
                label = presentation.label,
            })
        end
    end
    table.sort(entries, function(left: Entry, right: Entry): boolean
        return left.id < right.id
    end)
    return entries, total
end

function ExtractionPayoff.firstAvailableSlot(occupied: any, slotCount: number): number?
    if type(occupied) ~= "table" or slotCount < 1 then
        return nil
    end
    for slot = 1, math.floor(slotCount) do
        if occupied[slot] ~= true then
            return slot
        end
    end
    return nil
end

function ExtractionPayoff.claim(pending: any, owner: any): any
    if type(pending) ~= "table" or owner == nil then
        return nil
    end
    local payoff = pending[owner]
    pending[owner] = nil
    return payoff
end

return table.freeze(ExtractionPayoff)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">ForemanEchoEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Foreman Echo -- the Ironroot Delve's first elite.

    What is left of the shift boss still runs the mine. It does not fight
    you directly so much as it commands the machinery to: while it holds
    the signal board, it marks unsafe ground and the Delve's own equipment
    enforces the marks. The answer is not damage, it is authority. Three
    signal levers stand around the gallery; throwing all three strips the
    Echo of its command and leaves it exposed until it shouts the board
    back to life.

    Contract, matching the Old Growth's: profession-independent (levers
    are plain interactions), solo-passable (levers stay thrown, so one
    player can walk them), reward granted once per run per participant via
    a deterministic transaction id, disable-able, and no state that a
    client can assert -- every mutation here is called by the server.

    Distinct from the Old Growth by design: no carried fire, no burn
    window. Where the forest elite asks you to hold something fragile
    under pressure, the Delve elite asks you to shut things off in the
    right order while the ground itself is being turned against you.
]]

local ForemanEchoEncounter = {}

export type Status = "disabled" | "dormant" | "commanding" | "exposed" | "complete"

export type State = {
    health: number,
    levers: { [string]: boolean },
    manifestHash: string,
    markedUntil: number,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    seizeIndex: number,
    status: Status,
}

local MAX_HEALTH = 320
-- Each seize is the Echo shouting the board back: the levers reset and
-- must be walked again. Two seizes, so the encounter is three exposures.
local SEIZE_THRESHOLDS = table.freeze({ 210, 100 })
local LEVER_IDS = table.freeze({ "lever_north", "lever_shaft", "lever_south" })
local MARK_SECONDS = 6

local UNSAFE_MARK = table.freeze({
    attackId = "foreman_echo_mark",
    attackName = "UNSAFE GROUND",
    damage = 22,
    instruction = "LEAVE THE MARKED GROUND",
    radius = 11,
    shape = "circle",
    windup = 1.4,
})

local CART_ORDER = table.freeze({
    attackId = "foreman_echo_cart_order",
    attackName = "CART ORDER",
    damage = 26,
    instruction = "CLEAR THE RAIL LINE",
    length = 30,
    shape = "lane",
    width = 8,
    windup = 1.2,
})

ForemanEchoEncounter.Id = "elite_foreman_echo"
ForemanEchoEncounter.MaxHealth = MAX_HEALTH
ForemanEchoEncounter.LeverIds = LEVER_IDS
ForemanEchoEncounter.MarkSeconds = MARK_SECONDS
ForemanEchoEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_ironroot_ore",
})
ForemanEchoEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.2,
    commandingAttackCooldownSeconds = 2.6,
    markedStrikeDamage = 38,
    strikeDamage = 32,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.levers = table.clone(state.levers)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

local function isLever(leverId: any): boolean
    for _, id in LEVER_IDS do
        if id == leverId then
            return true
        end
    end
    return false
end

local function leversThrown(state: State): number
    local count = 0
    for _, id in LEVER_IDS do
        if state.levers[id] then
            count += 1
        end
    end
    return count
end

function ForemanEchoEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Foreman Echo run ID is required")
    assert(manifestHash ~= "", "Foreman Echo manifest hash is required")
    return {
        health = MAX_HEALTH,
        levers = {},
        manifestHash = manifestHash,
        markedUntil = 0,
        participants = {},
        revision = 0,
        runId = runId,
        seizeIndex = 0,
        status = if enabled then "dormant" else "disabled",
    }
end

function ForemanEchoEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "commanding"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function ForemanEchoEncounter.join(state: State, userId: number): State
    if state.status ~= "commanding" and state.status ~= "exposed" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    Throw one signal lever. Levers stay thrown, which is what keeps the
    encounter solo-passable: nobody has to hold three places at once.
    When the last one goes over, the Echo loses the board and is exposed.
]]
function ForemanEchoEncounter.throwLever(state: State, userId: number, leverId: any): (State, any)
    if state.status ~= "commanding" then
        return state, { accepted = false, reason = state.status }
    end
    if not isLever(leverId) then
        return state, { accepted = false, reason = "unknown_lever" }
    end
    if state.levers[leverId] then
        return state, { accepted = false, reason = "already_thrown" }
    end
    local nextState = cloneState(state)
    nextState.levers[leverId] = true
    nextState.participants[participantKey(userId)] = true
    local thrown = leversThrown(nextState)
    local exposed = thrown >= #LEVER_IDS
    if exposed then
        nextState.status = "exposed"
        nextState.markedUntil = 0
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            exposed = exposed,
            reason = if exposed then "command_broken" else "lever_thrown",
            remaining = #LEVER_IDS - thrown,
            thrown = thrown,
        }
end

function ForemanEchoEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Foreman Echo strike amount is invalid")
    if state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local nextHealth = math.max(0, state.health - amount)
    local threshold = SEIZE_THRESHOLDS[state.seizeIndex + 1]
    local seized = threshold ~= nil and nextHealth <= threshold
    if seized then
        -- The Echo shouts the board back: levers reset, command resumes.
        nextState.health = threshold
        nextState.seizeIndex += 1
        nextState.status = "commanding"
        nextState.levers = {}
    else
        nextState.health = nextHealth
        if nextHealth <= 0 then
            nextState.status = "complete"
            nextState.markedUntil = 0
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            reason = if nextState.status == "complete"
                then "completed"
                elseif seized then "board_seized"
                else "damaged",
            seized = seized,
        }
end

-- The Echo marks ground: a timestamp the service uses to keep the
-- telegraph and the damage window agreeing on one clock.
function ForemanEchoEncounter.markGround(state: State, now: number): (State, any)
    if state.status ~= "commanding" then
        return state, { accepted = false, reason = state.status }
    end
    if now < state.markedUntil then
        return state, { accepted = false, reason = "already_marked" }
    end
    local nextState = cloneState(state)
    nextState.markedUntil = now + MARK_SECONDS
    nextState.revision += 1
    return nextState, { accepted = true, markedUntil = nextState.markedUntil, reason = "marked" }
end

function ForemanEchoEncounter.expire(state: State, now: number): State
    if state.markedUntil == 0 or now < state.markedUntil then
        return state
    end
    local nextState = cloneState(state)
    nextState.markedUntil = 0
    nextState.revision += 1
    return nextState
end

function ForemanEchoEncounter.attack(attackIndex: number, seizeIndex: number): any
    -- Once the board has been seized back at least once, the Echo starts
    -- ordering carts as well as marking ground.
    if seizeIndex >= 1 and attackIndex % 2 == 0 then
        return CART_ORDER
    end
    return UNSAFE_MARK
end

function ForemanEchoEncounter.snapshot(state: State, userId: number, now: number): any
    local thrown = leversThrown(state)
    local instruction = if state.status == "commanding"
        then string.format("THROW THE SIGNAL LEVERS — %d OF %d", thrown, #LEVER_IDS)
        elseif state.status == "exposed" then "STRIKE THE FOREMAN"
        elseif state.status == "complete" then "THE SHIFT IS OVER"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE SIGNAL GALLERY"
    return {
        active = state.status == "commanding" or state.status == "exposed",
        complete = state.status == "complete",
        displayName = "FOREMAN ECHO",
        enabled = state.status ~= "disabled",
        exposed = state.status == "exposed",
        health = state.health,
        instruction = instruction,
        leversThrown = thrown,
        leverTotal = #LEVER_IDS,
        marked = now < state.markedUntil,
        markedUntil = if now < state.markedUntil then state.markedUntil else 0,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, state.seizeIndex + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        seizeIndex = state.seizeIndex,
        status = state.status,
    }
end

function ForemanEchoEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        ForemanEchoEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(ForemanEchoEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">FrostmereEnemies</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Frostmere Vale's six standard enemies.

    Every other roster answers the question "how does it reach you". This
    one answers "what does it take from you first". The hush pup hunts
    noise, so it finds whoever moved carelessly; the rime shell wears
    armour that only melts near warmth, so it has to be fought where a
    fire is; the cold echo freezes the ability you just used, which is the
    only roster in the game that spends a player's kit rather than their
    health.

    Which is why so little here hits hard. The valley's damage numbers are
    the lowest of any region and its status effects the most common: what
    kills in Frostmere is being cold, quiet and out of options at the same
    time, and these six are the things that arrange that.
]]

local FrostmereEnemies = {}

export type EnemyDefinition = {
    id: string,
    displayName: string,
    modelKey: string,
    health: number,
    speed: number,
    attackRange: number,
    attackCooldown: number,
    playerDamage: number,
    lanternDamage: number,
    strikeRange: number,
    strikeDamage: number,
    attackId: string,
    attackName: string,
    instruction: string,
    shape: "circle" | "lane",
    radius: number?,
    width: number?,
    length: number?,
    windup: number,
    stationary: boolean,
    targetMode: "lantern" | "player",
    frontShield: boolean,
    frontalStrikeDamage: number?,
    flankStrikeDamage: number?,
    statusEffect: ("drowsy" | "spark_theft")?,
    statusDuration: number?,
    statusMultiplier: number?,
    statusLanternDamage: number?,
}

local function freezeDefinition(definition: EnemyDefinition): EnemyDefinition
    return table.freeze(definition)
end

local DEFINITIONS: { [string]: EnemyDefinition } = {
    -- Hunts noise, so it arrives at whoever moved carelessly rather than\n    -- at whoever is closest.
    enemy_hush_pup = freezeDefinition({
        id = "enemy_hush_pup",
        displayName = "Hush Pup",
        modelKey = "hush_pup",
        health = 75,
        speed = 9,
        attackRange = 8,
        attackCooldown = 2,
        playerDamage = 16,
        lanternDamage = 4,
        strikeRange = 9,
        strikeDamage = 40,
        attackId = "hush_pup_pounce",
        attackName = "HUSH POUNCE",
        instruction = "IT HEARD YOU — BREAK ITS LINE",
        shape = "circle",
        radius = 6,
        width = nil,
        length = nil,
        windup = 0.8,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Its armour only melts near warmth, so the fight has to be taken to a\n    -- hearth. Struck cold it is the hardest thing in the valley; struck\n    -- warm it is the softest.
    enemy_rime_shell = freezeDefinition({
        id = "enemy_rime_shell",
        displayName = "Rime Shell",
        modelKey = "rime_shell",
        health = 160,
        speed = 3.8,
        attackRange = 9,
        attackCooldown = 3.2,
        playerDamage = 22,
        lanternDamage = 12,
        strikeRange = 10,
        strikeDamage = 26,
        attackId = "rime_shell_crush",
        attackName = "RIME CRUSH",
        instruction = "FIGHT IT WHERE THE FIRE IS",
        shape = "circle",
        radius = 8,
        width = nil,
        length = nil,
        windup = 1.5,
        stationary = false,
        targetMode = "lantern",
        frontShield = true,
        frontalStrikeDamage = 6,
        flankStrikeDamage = 40,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Makes sound somewhere it is not. Frail, and the reason a party stops\n    -- trusting its ears.
    enemy_bell_moth = freezeDefinition({
        id = "enemy_bell_moth",
        displayName = "Bell Moth",
        modelKey = "bell_moth",
        health = 60,
        speed = 7.5,
        attackRange = 14,
        attackCooldown = 2.6,
        playerDamage = 14,
        lanternDamage = 6,
        strikeRange = 9,
        strikeDamage = 42,
        attackId = "bell_moth_chime",
        attackName = "FALSE CHIME",
        instruction = "THE SOUND IS NOT WHERE IT SAYS",
        shape = "circle",
        radius = 9,
        width = nil,
        length = nil,
        windup = 1.2,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "drowsy",
        statusDuration = 6,
        statusMultiplier = 0.78,
        statusLanternDamage = nil,
    }),
    -- Buried, and visible only as a trail moving under the snow. It never\n    -- moves once it has you.
    enemy_snowbound = freezeDefinition({
        id = "enemy_snowbound",
        displayName = "Snowbound",
        modelKey = "snowbound",
        health = 130,
        speed = 0,
        attackRange = 7,
        attackCooldown = 3,
        playerDamage = 26,
        lanternDamage = 10,
        strikeRange = 10,
        strikeDamage = 34,
        attackId = "snowbound_grab",
        attackName = "BURIED GRAB",
        instruction = "THE TRAIL IN THE SNOW IS THE WARNING",
        shape = "circle",
        radius = 7,
        width = nil,
        length = nil,
        windup = 1.35,
        stationary = true,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Freezes the ability a player just spent, which is the only enemy in\n    -- the game that costs a kit rather than health.
    enemy_cold_echo = freezeDefinition({
        id = "enemy_cold_echo",
        displayName = "Cold Echo",
        modelKey = "cold_echo",
        health = 90,
        speed = 6.2,
        attackRange = 12,
        attackCooldown = 3.4,
        playerDamage = 18,
        lanternDamage = 7,
        strikeRange = 10,
        strikeDamage = 36,
        attackId = "cold_echo_still",
        attackName = "STILLED HAND",
        instruction = "IT IS TAKING WHAT YOU JUST USED",
        shape = "lane",
        radius = nil,
        width = 6,
        length = 22,
        windup = 1.45,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "drowsy",
        statusDuration = 8,
        statusMultiplier = 0.7,
        statusLanternDamage = nil,
    }),
    -- Eats the floor and the walls, which in a valley of shelters is the\n    -- most expensive thing anything here can do.
    enemy_ice_borer = freezeDefinition({
        id = "enemy_ice_borer",
        displayName = "Ice Borer",
        modelKey = "ice_borer",
        health = 115,
        speed = 5,
        attackRange = 11,
        attackCooldown = 3.6,
        playerDamage = 24,
        lanternDamage = 18,
        strikeRange = 11,
        strikeDamage = 32,
        attackId = "ice_borer_undermine",
        attackName = "UNDERMINE",
        instruction = "GET OFF WHAT IT IS EATING",
        shape = "circle",
        radius = 11,
        width = nil,
        length = nil,
        windup = 1.7,
        stationary = false,
        targetMode = "lantern",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
}

local ORDER = table.freeze({
    "enemy_hush_pup",
    "enemy_rime_shell",
    "enemy_bell_moth",
    "enemy_snowbound",
    "enemy_cold_echo",
    "enemy_ice_borer",
})
function FrostmereEnemies.get(enemyId: string): EnemyDefinition?
    return DEFINITIONS[enemyId]
end

function FrostmereEnemies.require(enemyId: string): EnemyDefinition
    local definition = DEFINITIONS[enemyId]
    assert(definition ~= nil, string.format("unknown Frostmere enemy ID %q", enemyId))
    return definition
end

function FrostmereEnemies.order(): { string }
    return table.clone(ORDER)
end

function FrostmereEnemies.all(): { EnemyDefinition }
    local result: { EnemyDefinition } = {}
    for _, enemyId in ORDER do
        table.insert(result, DEFINITIONS[enemyId])
    end
    return result
end

return table.freeze(FrostmereEnemies)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">GearTraits</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Equipment traits -- the M6 "equipment traits" deliverable: gear uses
    authored families with rolled minor traits. Each item TYPE rolls one
    trait per profile at its first craft, deterministically from the
    profile's own creation time and the item id: the same save always
    rolls the same trait for the same item (reproducible, no RNG service,
    fully testable), while two different saves see different rolls -- your
    Amber Edge is not my Amber Edge.

    Traits are minor by charter. Every bonus is a sidegrade-scale nudge
    inside clamps combat already enforces, never a second progression
    axis: rarity and power stay with the families themselves.
]]

local CraftingCatalog = require("./CraftingCatalog")
local Equipment = require("./Equipment")

local GearTraits = {}

export type Trait = {
    id: string,
    displayName: string,
    description: string,
    strikeDamageBonus: number?,
    reachBonus: number?,
    wearPointsOverride: number?,
    damageReductionBonus: number?,
    staminaRegenBonus: number?,
}

local function trait(definition: any): Trait
    return table.freeze(definition)
end

local WEAPON_TRAITS: { Trait } = table.freeze({
    trait({
        id = "trait_keen",
        displayName = "KEEN",
        description = "Strikes land 5% harder.",
        strikeDamageBonus = 0.05,
    }),
    trait({
        id = "trait_balanced",
        displayName = "BALANCED",
        description = "Reaches 2 studs further.",
        reachBonus = 2,
    }),
    trait({
        id = "trait_tempered",
        displayName = "TEMPERED",
        description = "Dulls at half the pace.",
        wearPointsOverride = 1,
    }),
})

local PASSIVE_TRAITS: { Trait } = table.freeze({
    trait({
        id = "trait_sturdy",
        displayName = "STURDY",
        description = "Softens incoming damage 2% more.",
        damageReductionBonus = 0.02,
    }),
    trait({
        id = "trait_light",
        displayName = "LIGHT",
        description = "Stamina returns 5% faster.",
        staminaRegenBonus = 0.05,
    }),
})

local TRAITS_BY_ID: { [string]: Trait } = {}
for _, pool in { WEAPON_TRAITS, PASSIVE_TRAITS } do
    for _, definition in pool do
        TRAITS_BY_ID[definition.id] = definition
    end
end
table.freeze(TRAITS_BY_ID)

local function poolFor(itemId: string): { Trait }?
    local definition = Equipment.get(itemId)
    if definition == nil then
        return nil
    end
    return if definition.slot == "weapon" then WEAPON_TRAITS else PASSIVE_TRAITS
end

local function hash(text: string): number
    local result = 5381
    for index = 1, #text do
        result = (result * 33 + string.byte(text, index)) % 2147483647
    end
    return result
end

function GearTraits.get(traitId: any): Trait?
    return if type(traitId) == "string" then TRAITS_BY_ID[traitId] else nil
end

function GearTraits.isValidFor(itemId: any, traitId: any): boolean
    local pool = if type(itemId) == "string" then poolFor(itemId) else nil
    if pool == nil then
        return false
    end
    for _, definition in pool do
        if definition.id == traitId then
            return true
        end
    end
    return false
end

-- The deterministic roll: same profile + same item = same trait, forever.
function GearTraits.rollFor(itemId: any, profileCreatedAt: any): string?
    local pool = if type(itemId) == "string" then poolFor(itemId) else nil
    if pool == nil or type(profileCreatedAt) ~= "number" then
        return nil
    end
    return pool[hash(itemId .. ":" .. tostring(math.floor(profileCreatedAt))) % #pool + 1].id
end

function GearTraits.normalize(value: any): { [string]: string }
    local traits: { [string]: string } = {}
    if type(value) ~= "table" then
        return traits
    end
    for itemId, traitId in value do
        if CraftingCatalog.isKnownOutputItem(itemId) and GearTraits.isValidFor(itemId, traitId) then
            traits[itemId] = traitId
        end
    end
    return traits
end

return table.freeze(GearTraits)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">GearVisualPlan</string>
          <string name="Source"><![CDATA[--!strict

local Equipment = require("./Equipment")

local GearVisualPlan = {}

export type PartPlan = {
    name: string,
    target: string,
    shape: string,
    size: { number },
    offset: { number },
    rotation: { number },
    color: { number },
    material: string,
}

export type ItemPlan = {
    itemId: string,
    slot: string,
    parts: { PartPlan },
}

local function part(
    name: string,
    target: string,
    shape: string,
    size: { number },
    offset: { number },
    rotation: { number },
    color: { number },
    material: string
): PartPlan
    return table.freeze({
        name = name,
        target = target,
        shape = shape,
        size = table.freeze(size),
        offset = table.freeze(offset),
        rotation = table.freeze(rotation),
        color = table.freeze(table.clone(color)),
        material = material,
    })
end

local hoodCloth = { 42, 58, 43 }
local hoodShadow = { 27, 35, 29 }
local ironroot = { 112, 85, 49 }
local brambleLeather = { 62, 48, 36 }
local brambleSole = { 31, 28, 24 }
local livingVine = { 78, 95, 48 }

local DEFINITIONS: { [string]: ItemPlan } = {
    gear_thornwood_bow = table.freeze({
        itemId = "gear_thornwood_bow",
        slot = "weapon",
        parts = table.freeze({
            part(
                "BowStave",
                "RightHand",
                "Block",
                { 0.22, 3.1, 0.5 },
                { 0, -0.55, 0 },
                { 0, 0, 12 },
                { 112, 84, 52 },
                "Wood"
            ),
            part(
                "BowString",
                "RightHand",
                "Block",
                { 0.06, 2.9, 0.06 },
                { 0.3, -0.55, 0 },
                { 0, 0, 0 },
                { 214, 205, 186 },
                "Fabric"
            ),
        }),
    }),
    gear_heartwood_maul = table.freeze({
        itemId = "gear_heartwood_maul",
        slot = "weapon",
        parts = table.freeze({
            part(
                "MaulHaft",
                "RightHand",
                "Block",
                { 0.28, 3.2, 0.28 },
                { 0, -0.7, 0 },
                { 0, 0, 8 },
                { 96, 68, 44 },
                "Wood"
            ),
            part(
                "MaulHead",
                "RightHand",
                "Block",
                { 1.7, 0.95, 0.95 },
                { 0.18, -2.15, 0 },
                { 0, 0, 8 },
                { 139, 98, 54 },
                "Wood"
            ),
        }),
    }),
    gear_briar_lance = table.freeze({
        itemId = "gear_briar_lance",
        slot = "weapon",
        parts = table.freeze({
            part(
                "LanceShaft",
                "RightHand",
                "Block",
                { 0.24, 4.6, 0.24 },
                { 0, -1.3, 0 },
                { 0, 0, 4 },
                { 104, 128, 68 },
                "Wood"
            ),
            part(
                "LanceTip",
                "RightHand",
                "Wedge",
                { 0.4, 0.95, 0.4 },
                { 0.16, -3.9, 0 },
                { 0, 0, 184 },
                { 74, 96, 46 },
                "Wood"
            ),
        }),
    }),
    gear_foxfire_sling = table.freeze({
        itemId = "gear_foxfire_sling",
        slot = "weapon",
        parts = table.freeze({
            part(
                "SlingStrap",
                "RightHand",
                "Block",
                { 0.14, 2.3, 0.14 },
                { 0, -0.5, 0 },
                { 0, 0, 24 },
                { 78, 58, 41 },
                "Fabric"
            ),
            part(
                "SlingPouch",
                "RightHand",
                "Ball",
                { 0.68, 0.5, 0.68 },
                { 0.45, -1.5, 0 },
                { 0, 0, 0 },
                { 94, 206, 176 },
                "Fabric"
            ),
        }),
    }),
    gear_amber_edge = table.freeze({
        itemId = "gear_amber_edge",
        slot = "weapon",
        parts = table.freeze({
            part(
                "EdgeGrip",
                "RightHand",
                "Block",
                { 0.3, 0.95, 0.3 },
                { 0, -0.25, 0 },
                { 0, 0, 0 },
                { 73, 54, 38 },
                "Fabric"
            ),
            part(
                "EdgeBlade",
                "RightHand",
                "Wedge",
                { 0.24, 2.3, 0.72 },
