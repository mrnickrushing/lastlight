      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">ChapterCatalog</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The chapters, and what each one asks the player to decide.

    Chapter I shipped as a special case: its record lives at
    story.chapterOne, its decision set and Warden outcome are validated by
    their own tables in SaveSchema, and half a dozen systems read it
    directly. That was right for one chapter and wrong for seven, so
    chapters II onward are described here instead -- id, region, the boss
    that closes them, the decision they ask, and the outcomes their boss
    can end on -- and stored uniformly under story.chapters.

    Chapter I is listed too, so anything that wants to reason about the
    story as a whole (which resident has arrived, which region is open,
    what the town remembers) can read one list. Its record is still read
    from its original home; this catalog describes it, it does not move it.
]]

local ChapterCatalog = {}

export type Chapter = {
    id: string,
    number: number,
    displayName: string,
    regionId: string,
    bossId: string,
    -- What the chapter asks the player to decide, in the player's words.
    decisionPrompt: string,
    -- The decisions a player can record for this chapter.
    decisions: { string },
    -- The outcomes its boss can end on, which the decision usually shapes.
    outcomes: { string },
    -- The chapter that must be complete before this one can be resolved.
    requires: string?,
}

local function chapter(definition: Chapter): Chapter
    return table.freeze({
        id = definition.id,
        number = definition.number,
        displayName = definition.displayName,
        regionId = definition.regionId,
        bossId = definition.bossId,
        decisionPrompt = definition.decisionPrompt,
        decisions = table.freeze(definition.decisions),
        outcomes = table.freeze(definition.outcomes),
        requires = definition.requires,
    })
end

local ORDER = table.freeze({
    "chapter_one",
    "chapter_two",
    "chapter_three",
    "chapter_four",
    "chapter_five",
    "chapter_six",
    "chapter_seven",
})

local DEFINITIONS: { [string]: Chapter } = {
    chapter_one = chapter({
        id = "chapter_one",
        number = 1,
        displayName = "THE LANTERN ROAD",
        regionId = "region_bramblewake",
        bossId = "boss_warden_stag",
        decisionPrompt = "WHAT GROWS BACK WHERE THE ROOTS WERE",
        decisions = { "restore_farmland", "wild_regrowth", "shared_agroforest" },
        outcomes = { "preserved", "scarred", "harmed" },
        requires = nil,
    }),
    chapter_two = chapter({
        id = "chapter_two",
        number = 2,
        displayName = "THE DELVE BELOW",
        regionId = "region_ironroot",
        bossId = "boss_bellows_maw",
        --[[
            The Maw's vent is the decision, and it is made with a wheel
            rather than a menu: the drifts are quick and the Delve's air
            pays for it, the flooded stope is slow and clean. What a crew
            reached for is what the chapter records.
        ]]
        decisionPrompt = "WHERE THE PRESSURE WENT",
        decisions = { "vent_drifts", "vent_stope", "vent_both" },
        outcomes = { "cleared", "fouled", "mixed" },
        requires = "chapter_one",
    }),
    chapter_three = chapter({
        id = "chapter_three",
        number = 3,
        displayName = "THE DROWNED COUNTRY",
        regionId = "region_mireglass",
        bossId = "boss_lantern_witch",
        --[[
            The Witch asks to be sealed rather than broken, and the seal
            only holds if it is given. Spending her copies to get there is
            the cost the ending remembers.
        ]]
        decisionPrompt = "WHAT WAS SPENT TO REACH HER",
        decisions = { "spared_copies", "spent_copies", "refused_her" },
        outcomes = { "sealed", "bound", "broken" },
        requires = "chapter_two",
    }),
    chapter_four = chapter({
        id = "chapter_four",
        number = 4,
        displayName = "THE HARBOUR MOUTH",
        regionId = "region_tempest",
        bossId = "boss_tidebound_titan",
        --[[
            The Titan's tide gates are the decision, and like the Maw's
            wheel they are worked rather than chosen. Eased down, the
            channel survives and the harbour can be a harbour again;
            slammed, the tide drops at once and takes the mouth with it.
            A party in trouble tonight may not care, which is the point.
        ]]
        decisionPrompt = "HOW THE TIDE WAS LOWERED",
        decisions = { "eased_gates", "slammed_gates", "mixed_gates" },
        outcomes = { "navigable", "scoured", "broken" },
        requires = "chapter_three",
    }),
    chapter_five = chapter({
        id = "chapter_five",
        number = 5,
        displayName = "THE QUIET VALE",
        regionId = "region_frostmere",
        bossId = "boss_white_howler",
        --[[
            The Howler's fight spends warmth three times, and each time
            it can go on the party's own fire or up to the den where its
            pups are. The den costs -- one more aurora mark to read in the
            phase that paid for it -- so the decision is made in the one
            currency the whole region is about.
        ]]
        decisionPrompt = "WHERE THE WARMTH WENT",
        decisions = { "warmed_den", "kept_warmth", "split_warmth" },
        outcomes = { "sheltered", "thinned", "silenced" },
        requires = "chapter_four",
    }),
    chapter_six = chapter({
        id = "chapter_six",
        number = 6,
        displayName = "THE CROWN STILL BURNING",
        regionId = "region_cinderfall",
        bossId = "boss_ash_regent",
        --[[
            The Regent is rooted deeper in something true than in
            something it made up, so an authentic statue is worth two
            anchors and a cast is worth one. That makes the fast way
            through the Crown the destruction of the only record of the
            people who died in it, and the chapter records how much of
            that a party was willing to do.
        ]]
        decisionPrompt = "WHAT WAS BROKEN TO REACH IT",
        decisions = { "spared_memories", "broke_some", "broke_them_all" },
        outcomes = { "remembered", "recast", "erased" },
        requires = "chapter_five",
    }),
    chapter_seven = chapter({
        id = "chapter_seven",
        number = 7,
        displayName = "THE HOLLOW BELOW",
        regionId = "region_hollow",
        bossId = "boss_nameless_night",
        --[[
            The finale's one menu, and the only one in the game. Everything
            else the Hollow asks is decided with a player's hands while
            something is happening; this is what is left when there is
            nothing happening any more.
        ]]
        decisionPrompt = "WHAT HAPPENS TO THE LIGHT",
        decisions = { "ending_kept", "ending_ended", "ending_shared" },
        outcomes = { "lantern_kept", "lantern_out", "lantern_shared" },
        requires = "chapter_six",
    }),
}

ChapterCatalog.Order = ORDER

function ChapterCatalog.get(chapterId: any): Chapter?
    return if type(chapterId) == "string" then DEFINITIONS[chapterId] else nil
end

function ChapterCatalog.require(chapterId: string): Chapter
    local definition = DEFINITIONS[chapterId]
    assert(definition ~= nil, string.format("unknown chapter ID %q", chapterId))
    return definition
end

function ChapterCatalog.list(): { Chapter }
    local result: { Chapter } = {}
    for _, chapterId in ORDER do
        table.insert(result, DEFINITIONS[chapterId])
    end
    return result
end

function ChapterCatalog.isDecision(chapterId: any, decision: any): boolean
    local definition = ChapterCatalog.get(chapterId)
    if definition == nil then
        return false
    end
    for _, candidate in definition.decisions do
        if candidate == decision then
            return true
        end
    end
    return false
end

function ChapterCatalog.isOutcome(chapterId: any, outcome: any): boolean
    local definition = ChapterCatalog.get(chapterId)
    if definition == nil then
        return false
    end
    for _, candidate in definition.outcomes do
        if candidate == outcome then
            return true
        end
    end
    return false
end

function ChapterCatalog.forRegion(regionId: any): Chapter?
    for _, chapterId in ORDER do
        if DEFINITIONS[chapterId].regionId == regionId then
            return DEFINITIONS[chapterId]
        end
    end
    return nil
end

--[[
    The chapter a boss's own outcome maps to. The encounters record their
    outcomes in their own words (the Maw says "cleared", the Witch says
    "sealed"), and the chapter records the same word -- this is the check
    that they cannot drift apart silently.
]]
function ChapterCatalog.forBoss(bossId: any): Chapter?
    for _, chapterId in ORDER do
        if DEFINITIONS[chapterId].bossId == bossId then
            return DEFINITIONS[chapterId]
        end
    end
    return nil
end

return table.freeze(ChapterCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">CinderfallEnemies</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Cinderfall Crown's six standard enemies.

    The other rosters ask how a thing reaches you or what it takes when it
    does. This one asks whether it is real. Half of these are not
    creatures at all -- the ash extra repeats one ceremonial attack
    forever because that is the move it was cast mid-way through, the
    false citizen is scenery until it is caught mending the scenery -- and
    a party's first job in any Crown fight is working out which of the
    things in front of them is actually doing something.

    That is why so much of the Crown's threat is indirect. The crown spark
    does no meaningful damage and makes everything near it worse; the
    false citizen repairs what you just broke; the parade giant does not
    chase, it divides. Killing the wrong one first is how a Crown fight
    goes long, and going long is what the region punishes.
]]

local CinderfallEnemies = {}

export type EnemyDefinition = {
    id: string,
    displayName: string,
    modelKey: string,
    health: number,
    speed: number,
    attackRange: number,
    attackCooldown: number,
    playerDamage: number,
    lanternDamage: number,
    strikeRange: number,
    strikeDamage: number,
    attackId: string,
    attackName: string,
    instruction: string,
    shape: "circle" | "lane",
    radius: number?,
    width: number?,
    length: number?,
    windup: number,
    stationary: boolean,
    targetMode: "lantern" | "player",
    frontShield: boolean,
    frontalStrikeDamage: number?,
    flankStrikeDamage: number?,
    statusEffect: ("drowsy" | "spark_theft")?,
    statusDuration: number?,
    statusMultiplier: number?,
    statusLanternDamage: number?,
}

local function freezeDefinition(definition: EnemyDefinition): EnemyDefinition
    return table.freeze(definition)
end

local DEFINITIONS: { [string]: EnemyDefinition } = {
    -- Cast mid-gesture and still making it. Predictable to the point of\n    -- being a rhythm, which is the only kindness the Crown offers.
    enemy_ash_extra = freezeDefinition({
        id = "enemy_ash_extra",
        displayName = "Ash Extra",
        modelKey = "ash_extra",
        health = 85,
        speed = 6.5,
        attackRange = 9,
        attackCooldown = 2.4,
        playerDamage = 17,
        lanternDamage = 6,
        strikeRange = 9,
        strikeDamage = 38,
        attackId = "ash_extra_ovation",
        attackName = "CEREMONIAL BOW",
        instruction = "IT ONLY KNOWS THE ONE MOVE",
        shape = "circle",
        radius = 7,
        width = nil,
        length = nil,
        windup = 1.1,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Reflects anything thrown at its face, which makes it the first\n    -- enemy in the game that punishes the safe option.
    enemy_glass_knight = freezeDefinition({
        id = "enemy_glass_knight",
        displayName = "Glass Knight",
        modelKey = "glass_knight",
        health = 150,
        speed = 4.6,
        attackRange = 10,
        attackCooldown = 3.2,
        playerDamage = 24,
        lanternDamage = 14,
        strikeRange = 10,
        strikeDamage = 30,
        attackId = "glass_knight_parry",
        attackName = "MIRROR PARRY",
        instruction = "GO ROUND — IT SENDS THE FRONT BACK",
        shape = "lane",
        radius = nil,
        width = 7,
        length = 26,
        windup = 1.5,
        stationary = false,
        targetMode = "lantern",
        frontShield = true,
        frontalStrikeDamage = 5,
        flankStrikeDamage = 42,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Travels between heat sources, so the lit modules are the ones it\n    -- can reach and a cold room is a room it has to cross open ground\n    -- to enter.
    enemy_kiln_worm = freezeDefinition({
        id = "enemy_kiln_worm",
        displayName = "Kiln Worm",
        modelKey = "kiln_worm",
        health = 120,
        speed = 7.8,
        attackRange = 8,
        attackCooldown = 2.8,
        playerDamage = 21,
        lanternDamage = 9,
        strikeRange = 10,
        strikeDamage = 34,
        attackId = "kiln_worm_surface",
        attackName = "SURFACING",
        instruction = "IT COMES UP WHERE THE HEAT IS",
        shape = "circle",
        radius = 10,
        width = nil,
        length = nil,
        windup = 1.25,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Almost harmless alone and the reason a Crown fight is hard. It\n    -- makes everything near it better, so it is always the correct\n    -- target and never the obvious one.
    enemy_crown_spark = freezeDefinition({
        id = "enemy_crown_spark",
        displayName = "Crown Spark",
        modelKey = "crown_spark",
        health = 55,
        speed = 9.2,
        attackRange = 13,
        attackCooldown = 3.4,
        playerDamage = 8,
        lanternDamage = 4,
        strikeRange = 9,
        strikeDamage = 20,
        attackId = "crown_spark_gild",
        attackName = "GILDING",
        instruction = "KILL THE SPARK, NOT WHAT IT IS FEEDING",
        shape = "circle",
        radius = 13,
        width = nil,
        length = nil,
        windup = 1.4,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "spark_theft",
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = 5,
    }),
    -- Slow, enormous, and uninterested in chasing anyone. It walks its\n    -- route, and what it does is separate a party from itself.
    enemy_parade_giant = freezeDefinition({
        id = "enemy_parade_giant",
        displayName = "Parade Giant",
        modelKey = "parade_giant",
        health = 240,
        speed = 2.6,
        attackRange = 12,
        attackCooldown = 4,
        playerDamage = 26,
        lanternDamage = 20,
        strikeRange = 12,
        strikeDamage = 40,
        attackId = "parade_giant_sweep",
        attackName = "PROCESSIONAL SWEEP",
        instruction = "DO NOT LET IT CUT THE PARTY IN HALF",
        shape = "lane",
        radius = nil,
        width = 11,
        length = 34,
        windup = 2,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Stands in the scenery until it is caught repairing the scenery.\n    -- Stationary because it is not fighting; it is working.
    enemy_false_citizen = freezeDefinition({
        id = "enemy_false_citizen",
        displayName = "False Citizen",
        modelKey = "false_citizen",
        health = 100,
        speed = 5.4,
        attackRange = 9,
        attackCooldown = 3,
        playerDamage = 19,
        lanternDamage = 8,
        strikeRange = 10,
        strikeDamage = 32,
        attackId = "false_citizen_mend",
        attackName = "MENDING",
        instruction = "IT IS PUTTING THE FIGHT BACK TOGETHER",
        shape = "circle",
        radius = 8,
        width = nil,
        length = nil,
        windup = 1.3,
        stationary = true,
        targetMode = "lantern",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
}

local ORDER = table.freeze({
    "enemy_ash_extra",
    "enemy_glass_knight",
    "enemy_kiln_worm",
    "enemy_crown_spark",
    "enemy_parade_giant",
    "enemy_false_citizen",
})
function CinderfallEnemies.get(enemyId: string): EnemyDefinition?
    return DEFINITIONS[enemyId]
end

function CinderfallEnemies.require(enemyId: string): EnemyDefinition
    local definition = DEFINITIONS[enemyId]
    assert(definition ~= nil, string.format("unknown Cinderfall enemy ID %q", enemyId))
    return definition
end

function CinderfallEnemies.order(): { string }
    return table.clone(ORDER)
end

function CinderfallEnemies.all(): { EnemyDefinition }
    local result: { EnemyDefinition } = {}
    for _, enemyId in ORDER do
        table.insert(result, DEFINITIONS[enemyId])
    end
    return result
end

return table.freeze(CinderfallEnemies)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">CombatState</string>
          <string name="Source"><![CDATA[--!strict

local Config = require("./Config")

local CombatState = {}

export type State = {
    dodgeInvulnerableUntil: number,
    dodgeReadyAt: number,
    lastUpdatedAt: number,
    regenBlockedUntil: number,
    revision: number,
    sprinting: boolean,
    stamina: number,
}
export type TransitionResult = {
    applied: boolean,
    reason: string?,
    stamina: number,
}
export type Snapshot = {
    dodgeActive: boolean,
    dodgeActiveUntil: number,
    dodgeCost: number,
    dodgeReadyAt: number,
    lowStamina: boolean,
    maxStamina: number,
    revision: number,
    sprinting: boolean,
    stamina: number,
}

local MAX_STAMINA = Config.MaxStamina
local SPRINT_DRAIN_PER_SECOND = Config.SprintDrainPerSecond
local STAMINA_REGEN_PER_SECOND = Config.StaminaRegenPerSecond
local STAMINA_REGEN_DELAY_SECONDS = Config.StaminaRegenDelaySeconds
local MIN_SPRINT_STAMINA = Config.MinSprintStamina
local DODGE_COST = Config.DodgeStaminaCost
local DODGE_COOLDOWN_SECONDS = Config.DodgeCooldownSeconds
local DODGE_INVULNERABILITY_SECONDS = Config.DodgeInvulnerabilitySeconds

local function finiteNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function copyAt(state: State, now: number): State
    local nextState: State = table.clone(state)
    nextState.lastUpdatedAt = math.max(state.lastUpdatedAt, now)
    return nextState
end

function CombatState.create(now: number): State
    assert(finiteNumber(now), "combat state time is invalid")
    return {
        dodgeInvulnerableUntil = now,
        dodgeReadyAt = now,
        lastUpdatedAt = now,
        regenBlockedUntil = now,
        revision = 0,
        sprinting = false,
        stamina = MAX_STAMINA,
    }
end

--[[
    `moving` defaults to true so existing callers keep their behaviour, but the
    service passes the player's real movement. Standing still with run toggled
    on used to drain the bar to nothing while the character had not gone
    anywhere, which reads as a bug and punishes a player for pausing to look
    around. Sprint now only costs while actually sprinting somewhere.
]]
function CombatState.advance(
    state: State,
    now: number,
    canAct: boolean,
    staminaRegenMultiplier: number?,
    moving: boolean?
): State
    assert(finiteNumber(now), "combat state time is invalid")
    local nextState = copyAt(state, now)
    local delta = math.max(0, now - state.lastUpdatedAt)
    local changed = false

    if not canAct and nextState.sprinting then
        nextState.sprinting = false
        changed = true
    end

    local spending = nextState.sprinting and canAct and moving ~= false
    if spending then
        local stamina = math.max(0, state.stamina - SPRINT_DRAIN_PER_SECOND * delta)
        if stamina ~= state.stamina then
            nextState.stamina = stamina
            nextState.regenBlockedUntil = now + STAMINA_REGEN_DELAY_SECONDS
            changed = true
        end
        if nextState.stamina <= 0 then
            nextState.sprinting = false
        end
    elseif canAct and now >= state.regenBlockedUntil and state.stamina < MAX_STAMINA then
        local regenMultiplier = math.clamp(
            if finiteNumber(staminaRegenMultiplier) then staminaRegenMultiplier :: number else 1,
            0.75,
            1.5
        )
        local stamina = math.min(
            MAX_STAMINA,
            state.stamina + STAMINA_REGEN_PER_SECOND * regenMultiplier * delta
        )
        if stamina ~= state.stamina then
            nextState.stamina = stamina
            changed = true
        end
    end

    if changed then
        nextState.revision += 1
    end
    return nextState
end

function CombatState.setSprint(
    state: State,
    enabled: boolean,
    now: number,
    canAct: boolean,
    staminaRegenMultiplier: number?
): (State, TransitionResult)
    local nextState = CombatState.advance(state, now, canAct, staminaRegenMultiplier)
    if enabled then
        if not canAct then
            return nextState,
                {
                    applied = false,
                    reason = "player_cannot_act",
                    stamina = nextState.stamina,
                }
        end
        if nextState.sprinting then
            return nextState,
                {
                    applied = false,
                    reason = "already_sprinting",
                    stamina = nextState.stamina,
                }
        end
        if nextState.stamina < MIN_SPRINT_STAMINA then
            return nextState,
                {
                    applied = false,
                    reason = "insufficient_stamina",
                    stamina = nextState.stamina,
                }
        end
        nextState.sprinting = true
        nextState.revision += 1
        return nextState,
            {
                applied = true,
                stamina = nextState.stamina,
            }
    end

    if not nextState.sprinting then
        return nextState,
            {
                applied = false,
                reason = "already_stopped",
                stamina = nextState.stamina,
            }
    end
    nextState.sprinting = false
    nextState.regenBlockedUntil = now + STAMINA_REGEN_DELAY_SECONDS
    nextState.revision += 1
    return nextState, {
        applied = true,
        stamina = nextState.stamina,
    }
end

function CombatState.dodge(
    state: State,
    now: number,
    canAct: boolean,
    staminaRegenMultiplier: number?
): (State, TransitionResult)
    local nextState = CombatState.advance(state, now, canAct, staminaRegenMultiplier)
    if not canAct then
        return nextState,
            {
                applied = false,
                reason = "player_cannot_act",
                stamina = nextState.stamina,
            }
    end
    if now < nextState.dodgeReadyAt then
        return nextState,
            {
                applied = false,
                reason = "dodge_cooldown",
                stamina = nextState.stamina,
            }
    end
    if nextState.stamina < DODGE_COST then
        return nextState,
            {
                applied = false,
                reason = "insufficient_stamina",
                stamina = nextState.stamina,
            }
    end

    nextState.stamina -= DODGE_COST
    nextState.sprinting = false
    nextState.dodgeInvulnerableUntil = now + DODGE_INVULNERABILITY_SECONDS
    nextState.dodgeReadyAt = now + DODGE_COOLDOWN_SECONDS
    nextState.regenBlockedUntil = now + STAMINA_REGEN_DELAY_SECONDS
    nextState.revision += 1
    return nextState, {
        applied = true,
        stamina = nextState.stamina,
    }
end

-- Instant, non-time-based restore (a consumed item's effect, not regen), so
-- it still routes through advance() first to settle any pending drain/regen
-- up to `now` before adding the flat amount, the same way dodge and
-- setSprint never mutate stamina without advancing state first.
function CombatState.restoreStamina(
    state: State,
    now: number,
    amount: number,
    canAct: boolean,
    staminaRegenMultiplier: number?
): (State, TransitionResult)
    local nextState = CombatState.advance(state, now, canAct, staminaRegenMultiplier)
    if not canAct then
        return nextState,
            {
                applied = false,
                reason = "player_cannot_act",
                stamina = nextState.stamina,
            }
    end
    local stamina = math.min(MAX_STAMINA, nextState.stamina + math.max(0, amount))
    if stamina == nextState.stamina then
        return nextState,
            {
                applied = false,
                reason = "stamina_full",
                stamina = nextState.stamina,
            }
    end
    nextState.stamina = stamina
    nextState.revision += 1
    return nextState, {
        applied = true,
        stamina = nextState.stamina,
    }
end

function CombatState.avoidsDamage(state: State, now: number): boolean
    return now < state.dodgeInvulnerableUntil
end

function CombatState.snapshot(state: State, now: number): Snapshot
    local stamina = math.clamp(math.floor(state.stamina), 0, MAX_STAMINA)
    return {
        dodgeActive = CombatState.avoidsDamage(state, now),
        dodgeActiveUntil = state.dodgeInvulnerableUntil,
        dodgeCost = DODGE_COST,
        dodgeReadyAt = state.dodgeReadyAt,
        lowStamina = stamina < DODGE_COST,
        maxStamina = MAX_STAMINA,
        revision = state.revision,
        sprinting = state.sprinting,
        stamina = stamina,
    }
end

CombatState.Constants = table.freeze({
    DodgeCooldownSeconds = DODGE_COOLDOWN_SECONDS,
    DodgeCost = DODGE_COST,
    DodgeInvulnerabilitySeconds = DODGE_INVULNERABILITY_SECONDS,
    MaxStamina = MAX_STAMINA,
    MinSprintStamina = MIN_SPRINT_STAMINA,
    SprintDrainPerSecond = SPRINT_DRAIN_PER_SECOND,
    StaminaRegenPerSecond = STAMINA_REGEN_PER_SECOND,
})

return table.freeze(CombatState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">CompanionMotion</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The pure half of a companion's movement: where it wants to stand
    relative to its keeper, and how far it moves this step. Number pairs
    only -- like every module in the shared layer, it knows no Roblox
    datatypes, so the Lune suite can hold its behavior without a world.
    The service assembles Vector3s and CFrames from these numbers.

    A companion keeps to its keeper's flank, not their heels: the follow
    offset sits beside and slightly behind, so the hound frames its keeper
    instead of shoving through them, and it only moves at all outside a
    settle radius so it rests when the keeper does.
]]

local CompanionMotion = {}

local FOLLOW_SIDE = 3.2
local FOLLOW_BACK = 2.4
local SETTLE_RADIUS = 1.6
local WALK_SPEED = 12
local RUN_SPEED = 22
local RUN_AT = 14
local TELEPORT_AT = 60

-- The flank offset in the keeper's local space: +X is their right side,
-- +Z is behind them (Roblox look vector is -Z).
function CompanionMotion.followOffset(): (number, number)
    return FOLLOW_SIDE, FOLLOW_BACK
end

--[[
    One flat movement step from (px, pz) toward (tx, tz). Returns the new
    coordinates and whether the companion is moving (for pose selection).
    Far past TELEPORT_AT the companion simply arrives -- a keeper who
    outran streaming should not watch their hound jog across the map.
]]
function CompanionMotion.step(
    px: number,
    pz: number,
    tx: number,
    tz: number,
    deltaTime: number
): (number, number, boolean)
    local dx = tx - px
    local dz = tz - pz
    local distance = math.sqrt(dx * dx + dz * dz)
    if distance <= SETTLE_RADIUS then
        return px, pz, false
    end
    if distance >= TELEPORT_AT then
        return tx, tz, false
    end
    local speed = if distance >= RUN_AT then RUN_SPEED else WALK_SPEED
    local travel = math.min(distance - SETTLE_RADIUS * 0.5, speed * math.max(deltaTime, 0))
    local scale = travel / distance
    return px + dx * scale, pz + dz * scale, true
end

CompanionMotion.Constants = table.freeze({
    SettleRadius = SETTLE_RADIUS,
    WalkSpeed = WALK_SPEED,
    RunSpeed = RUN_SPEED,
    RunAt = RUN_AT,
    TeleportAt = TELEPORT_AT,
})

return table.freeze(CompanionMotion)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict

return table.freeze({
    GameName = "Last Light",
    BuildVersion = "0.53.0",
    MaxExpeditionPlayers = 8,
    NormalDaySeconds = 12 * 60,
    DuskSeconds = 2 * 60,
    NormalNightSeconds = 6 * 60,
    BlackoutNightSeconds = 9 * 60,
    BlackoutInterval = 7,
    SaveSchemaVersion = 25,
    --[[
        The save schema freeze.

        Milestone 14's deliverable list says "frozen save schema except blocker
        fixes", and that is a promise nobody can keep by remembering. Setting
        this to the version the launch candidate ships on makes
        `validate_schema_freeze.py` refuse any bump past it, and the refusal
        names the two ways through: raise the freeze deliberately, or set
        SaveSchemaFreezeOverride to the exact version being allowed and say in
        the pull request why the fix is a blocker.

        `nil` means not frozen, which is the correct state until a launch
        candidate is declared. A freeze that is on during development is a
        freeze somebody turns off and forgets to turn back on.
    ]]
    SaveSchemaFreeze = nil :: number?,
    -- The one version a bump is allowed to reach while the freeze is set. Has
    -- to be typed out, so a blocker fix is a deliberate act rather than a
    -- number quietly incrementing past a guard.
    SaveSchemaFreezeOverride = nil :: number?,
    BootstrapTimeoutSeconds = 8,
    FirstNightDuskSeconds = 15,
    FirstNightSeconds = 120,
    BramblewakePreviewSeed = 1847,
    BaseWalkSpeed = 16,
    BaseJumpHeight = 7.2,
    BaseJumpPower = 50,
    SprintWalkSpeed = 24,
    MaxStamina = 100,
    -- A full bar used to empty in about five seconds, which made sprinting
    -- feel broken rather than costly. At 7/s a full bar carries roughly
    -- fourteen seconds of running, long enough to cross the arrival clearing
    -- or break away from a wave, while still forcing a decision in a fight.
    SprintDrainPerSecond = 7,
    StaminaRegenPerSecond = 16,
    StaminaRegenDelaySeconds = 0.75,
    MinSprintStamina = 10,
    DodgeStaminaCost = 35,
    DodgeCooldownSeconds = 1.25,
    DodgeInvulnerabilitySeconds = 0.42,
    DodgeSpeed = 43,
    RootlingAttackWindupSeconds = 0.9,
    RootlingAttackRadius = 7,
    DownedWalkSpeed = 6,
    MaxHealth = 100,
    DownedSeconds = 30,
    ReviveHealth = 35,
    RecoveryHealth = 50,
    -- Standing in the First Lantern's light is the only way a player who is
    -- not a Medic can recover health. Deliberately slow: a reason to come home
    -- between runs, not a substitute for the Medic's burst heal, which stays
    -- the only healing available out in the field.
    LanternSafeRadius = 34,
    LanternRegenPerSecond = 1.6,
    ReviveInvulnerabilitySeconds = 3,
    RecoveryInvulnerabilitySeconds = 5,
    InteractionDistance = 14,
    ReviveDistance = 12,
    ReviveChannelSeconds = 2.5,
    EngineerBraceSeconds = 12,
    EngineerBraceCapacity = 14,
    ActionRatePerSecond = 8,
    --[[
        Quick chat's own budget, separate from the action budget on purpose.
        A player working the phrase wheel must not lose the ability to swing,
        and a player in a fight must not lose the ability to say I AM DOWN.

        Three in hand and roughly one every two seconds after that: enough to
        answer a question and point at something without waiting, not enough
        to fill anybody's screen. The wheel is the one surface in the game
        whose whole purpose is to reach other players, so its ceiling is a
        civility setting rather than an anti-macro one.
    ]]
    QuickChatRatePerSecond = 0.5,
    QuickChatBurst = 3,
    -- How far a ping marker carries. A ping is guidance, and guidance to
    -- somewhere four hundred studs behind you is noise on the screen. The log
    -- line is not distance-limited: hearing that someone is down is the point
    -- even when you cannot reach them.
    QuickChatPingRadius = 400,
    -- What a baseline phone is assumed to have for this experience before
    -- Roblox starts reclaiming. Client memory headroom is measured against it,
    -- so it decides whether that budget reads as healthy or as one asset load
    -- from a reload. Provisional: TECHNICAL_ARCHITECTURE.md says budgets are
    -- finalized on the baseline device during the vertical slice, and this is
    -- one of the numbers that pass exists to replace.
    BaselinePhoneMemoryCeilingMb = 700,
    -- Session locking. A server refreshes its lock on the same ten-second beat
    -- as the autosave, and a lock is reclaimable once it has been silent for
    -- ninety -- nine missed beats. The gap is deliberately wide: reclaiming a
    -- lock that is merely slow means two servers writing one profile, which
    -- costs a player progress, while waiting too long only costs them a wait.
    -- The number that matters after a crash is this one, because a server that
    -- dies never releases its lock and this is the only way the player plays
    -- again.
    ProfileLockHeartbeatSeconds = 10,
    ProfileLockStaleAfterSeconds = 90,
    -- Backups. A copy every autosave would double the write traffic of the
    -- busiest path in the game to photograph a profile that usually has not
    -- meaningfully changed, so ordinary copies are taken at most this often.
    -- A schema change ignores the interval entirely -- that is the one moment
    -- the old shape stops being recoverable from the new one, and it is the
    -- case TECHNICAL_ARCHITECTURE asks for a backup before.
    ProfileBackupIntervalSeconds = 900,
    -- How many copies are kept. Bounded because a DataStore value has a hard
    -- size ceiling and a profile is not small: an unbounded history would
    -- eventually fail every write to the backup key, taking backups down at
    -- exactly the moment the save is growing fastest.
    ProfileBackupRetained = 3,
    -- How often a client reports its own frame and memory samples, and the
    -- floor the server enforces on that remote. Telemetry only: nothing a
    -- client reports here grants it anything.
    PerformanceReportIntervalSeconds = 5,
    --[[
        Creator Dashboard product IDs, keyed by this game's own product id.

        Empty, and that is the correct state: a developer product does not
        exist until somebody creates it in the dashboard and copies the number
        back. A product with no ID here cannot be bought, which is true of all
        of them today. The store flag below is off for the same reason -- there
        is nothing behind it yet.

        The spec that reads this table does not require it to be full. It
        requires that every key in it names a product the catalog knows, so a
        number pasted against a product that does not exist fails on the day it
        is pasted rather than on the day somebody presses buy.
    ]]
    CommerceProductIds = table.freeze({}),
    -- The Last Light universe (10611704810) and its start place. Registered
    -- per the publishing runbook so environment checks can tell a real
    -- production place from an unregistered one.
    ProductionPlaceIds = table.freeze({ 115897110071287 }),
    FeatureFlags = table.freeze({
        bounded_join = true,
        first_ten_minutes = true,
        input_action_system = true,
        combat_mobility_enabled = true,
        profession_kits_enabled = true,
        player_survival_enabled = true,
        -- Off: a session starts a fresh run at the lodge. Rejoining to find
        -- yourself halfway through a night you already left reads as the
        -- game having lost track, not as progress. The stage is still
        -- written to the profile, so turning this on resumes as before.
        tutorial_persistence = false,
        content_registry = true,
        bramblewake_events_enabled = true,
        old_growth_elite_enabled = true,
        warden_stag_boss_enabled = true,
        bramblewake_blackout_enabled = true,
        town_night_cycle_enabled = true,
        lobby_departure_enabled = true,
        -- Each departing party gets its own reserved server. Off falls back
        -- to moving the party within the current server, which is also what
        -- happens in Studio and on an unpublished place, where reserving is
        -- impossible.
        reserved_run_servers_enabled = true,
        -- Chat commands for the AdminRoster user IDs. Checked on every
        -- message rather than cached, so turning this off stops them
        -- mid-session for everyone, roster included.
        admin_commands_enabled = true,
        --[[
            The six encounters the Delve and the Fen brought, behind one
            switch. They cannot run at all until a region opens, so this
            starts on: the flag is here to turn them off in a hurry if one
            of them misbehaves in front of players, not to stage them in.
        ]]
        region_encounters_enabled = true,
        region_bramblewake_enabled = true,
        region_ironroot_enabled = false,
        region_mireglass_enabled = false,
        region_tempest_enabled = false,
        region_frostmere_enabled = false,
        region_cinderfall_enabled = false,
        region_hollow_enabled = false,
        --[[
            Quick chat, the only player-to-player channel this game has. On,
            because it is a closed vocabulary of twenty-four phrases rather
            than a text box -- there is nothing a player can compose, so there
            is nothing to moderate. The flag exists so a single press can take
            the channel away if the phrase list turns out to carry a meaning
            nobody intended, which is the failure mode a closed vocabulary
            actually has.
        ]]
        quick_chat_enabled = true,
        --[[
            The cosmetic store. Off, and it stays off until there are products
            in the Creator Dashboard, prices the owner has decided, and a
            purchase that has been made once with a real receipt. A store that
            is on with an empty catalog is a store that shows a player an empty
            room and asks them to trust it.
        ]]
        cosmetic_store_enabled = false,
    }),
    --[[
        Which rung of Milestone 13's rollout each flag has reached.

        The roadmap's four rungs are team and trusted testers, the consented
        allowlist, the larger controlled cohort, and everyone. `off` is the
        rung below all of them.

        This table is not a second copy of the switches above -- it is the
        same fact said in the vocabulary a staged rollout needs, and
        `RolloutCohorts.globalDefault` is what holds the two together: a flag
        at `everyone` is on for a player nobody has said anything about, and
        a flag at any other rung is not. `FeatureFlagService.spec` walks both
        tables and refuses any disagreement, so a flag added to one and not
        the other fails on the day it is added rather than on the day a
        cohort is supposed to see it.

        Nothing sits mid-ladder today, and that is the honest state rather
        than an oversight: the rungs are populations, and there is no
        population yet. `RolloutRoster` below is empty for the same reason
        `CommerceProductIds` is. Why each flag is where it is, is written in
        the matrix in BETA_ROLLOUT.md, which this table is checked against.

        `percent` is carried at every stage rather than only at `cohort`, so
        a flag advancing to the cohort rung cannot arrive without one and
        have somebody pick a number in the same commit that opens the gate.
    ]]
    FeatureFlagRollouts = table.freeze({
        bounded_join = table.freeze({ stage = "everyone", percent = 100 }),
        first_ten_minutes = table.freeze({ stage = "everyone", percent = 100 }),
        input_action_system = table.freeze({ stage = "everyone", percent = 100 }),
        combat_mobility_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        profession_kits_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        player_survival_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        tutorial_persistence = table.freeze({ stage = "off", percent = 0 }),
        content_registry = table.freeze({ stage = "everyone", percent = 100 }),
        bramblewake_events_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        old_growth_elite_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        warden_stag_boss_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        bramblewake_blackout_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        town_night_cycle_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        lobby_departure_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        reserved_run_servers_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        admin_commands_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        region_encounters_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        region_bramblewake_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        region_ironroot_enabled = table.freeze({ stage = "off", percent = 0 }),
        region_mireglass_enabled = table.freeze({ stage = "off", percent = 0 }),
        region_tempest_enabled = table.freeze({ stage = "off", percent = 0 }),
        region_frostmere_enabled = table.freeze({ stage = "off", percent = 0 }),
        region_cinderfall_enabled = table.freeze({ stage = "off", percent = 0 }),
        region_hollow_enabled = table.freeze({ stage = "off", percent = 0 }),
        quick_chat_enabled = table.freeze({ stage = "everyone", percent = 100 }),
        cosmetic_store_enabled = table.freeze({ stage = "off", percent = 0 }),
    }),
    --[[
        The two rosters the first two rungs are read from, by Roblox user ID.

        Empty, and correctly so: a trusted tester is a person the owner has
        asked, and an allowlisted player is one whose guardian has consented.
        Neither is something this repository can invent. A flag standing at
        `team` with an empty roster is on for nobody, which is the safe way
        for this to be wrong.

        By user ID rather than by name, for `AdminRoster`'s reason: a display
        name can be changed by the person using it, and the number they join
        with cannot.
    ]]
    RolloutRoster = table.freeze({
        team = table.freeze({}),
        allowlist = table.freeze({}),
    }),
    Environments = table.freeze({
        ["local"] = table.freeze({
            LogLevel = "debug",
            AllowFlagOverrides = true,
            UsePersistentData = false,
        }),
        test = table.freeze({
            LogLevel = "debug",
            AllowFlagOverrides = true,
            UsePersistentData = false,
        }),
        staging = table.freeze({
            LogLevel = "info",
            AllowFlagOverrides = true,
            UsePersistentData = true,
        }),
        production = table.freeze({
            LogLevel = "info",
            AllowFlagOverrides = false,
            UsePersistentData = true,
        }),
    }),
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Consumables</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The things a player uses rather than wears.

    This game shipped with two of them, and both were three hardcoded
    branches: one in TutorialService deciding what using it does, one in
    HUDController drawing its button and icon, one in the client deciding
    which id a keypress sends. That is survivable at two and not at
    seventeen, and the recipe count this milestone asks for cannot be met
    honestly while every new consumable needs three files edited in
    agreement.

    So a consumable is data. It names an effect the server already knows
    how to apply, the precondition that must hold before the item is
    spent -- a player must never lose one to a no-op -- and the lines the
    toast says either way. Adding another is one entry here and one
    recipe; nothing in the client or the services learns its name.

    Deliberately not here: the effects themselves. `restore_stamina` is
    PlayerCombatService's job and stays there. This says which effect,
    how much, and what the player is told.
]]

local Consumables = {}

export type Effect = {
    kind: string,
    amount: number,
    seconds: number?,
    radius: number?,
}

export type Consumable = {
    id: string,
    displayName: string,
    -- Short label for the HUD button, which has room for about eight.
    shortLabel: string,
    accent: { number },
    effect: Effect,
    --[[
        What has to be true before the item is spent. `nil` means the
        effect can always do something. The server owns the check; this
        names it, so a new consumable cannot quietly skip having one.
    ]]
    requires: string?,
    refusedMessage: string?,
    successMessage: string,
}

local function consumable(definition: Consumable): Consumable
    return table.freeze({
        accent = table.freeze(table.clone(definition.accent)),
        displayName = definition.displayName,
        effect = table.freeze(table.clone(definition.effect)),
        id = definition.id,
        refusedMessage = definition.refusedMessage,
        requires = definition.requires,
        shortLabel = definition.shortLabel,
        successMessage = definition.successMessage,
    })
end

--[[
    Three effect kinds, because three is what the services can already
    do: stamina back, a brief shield, and a heal that reaches the people
    standing near you. A fourth kind is a service change, not a catalog
    entry, and that boundary is the point of this file.
]]
local ORDER = table.freeze({
    "gear_meadow_satchel",
    "gear_amber_charm",
    "gear_delve_ration",
    "gear_coalglass_ward",
    "gear_reed_tonic",
    "gear_mirror_ward",
    "gear_fen_poultice",
    "gear_storm_ration",
    "gear_amberglass_ward",
    "gear_reach_poultice",
    "gear_ember_ration",
