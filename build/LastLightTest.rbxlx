        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">FeatureFlagService</string>
            <string name="Source"><![CDATA[--!strict

local FeatureFlagService = {}
FeatureFlagService.__index = FeatureFlagService
FeatureFlagService.Name = "FeatureFlagService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type FeatureFlagService = typeof(setmetatable(
    {} :: {
        Name: string,
        _defaults: { [string]: boolean },
        _overrides: { [string]: boolean },
        _allowOverrides: boolean,
        _logger: Logger,
    },
    FeatureFlagService
))

function FeatureFlagService.new(
    defaults: { [string]: boolean },
    allowOverrides: boolean,
    logger: Logger
): FeatureFlagService
    return setmetatable({
        Name = FeatureFlagService.Name,
        _defaults = table.clone(defaults),
        _overrides = {},
        _allowOverrides = allowOverrides,
        _logger = logger,
    }, FeatureFlagService)
end

function FeatureFlagService.Init(self: FeatureFlagService, _context: any)
    self._logger:info("feature_flags_initialized", {
        count = self:count(),
        overridesAllowed = self._allowOverrides,
    })
end

function FeatureFlagService.Start(self: FeatureFlagService)
    self._logger:info("feature_flags_started")
end

function FeatureFlagService.isEnabled(self: FeatureFlagService, flag: string): boolean
    local override = self._overrides[flag]
    if override ~= nil then
        return override
    end

    local value = self._defaults[flag]
    assert(value ~= nil, string.format("unknown feature flag %q", flag))
    return value
end

function FeatureFlagService.setOverride(
    self: FeatureFlagService,
    flag: string,
    enabled: boolean
): (boolean, string?)
    if not self._allowOverrides then
        self._logger:warn("feature_flag_override_rejected", { flag = flag })
        return false, "overrides are disabled in this environment"
    end

    if self._defaults[flag] == nil then
        return false, "unknown feature flag"
    end

    self._overrides[flag] = enabled
    self._logger:info("feature_flag_overridden", { flag = flag, enabled = enabled })
    return true, nil
end

function FeatureFlagService.clearOverride(self: FeatureFlagService, flag: string)
    self._overrides[flag] = nil
end

function FeatureFlagService.count(self: FeatureFlagService): number
    local count = 0
    for _ in self._defaults do
        count += 1
    end
    return count
end

function FeatureFlagService.snapshot(self: FeatureFlagService): { [string]: boolean }
    local snapshot = table.clone(self._defaults)
    for flag, value in self._overrides do
        snapshot[flag] = value
    end
    return snapshot
end

return table.freeze(FeatureFlagService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">GearVisualService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local GearVisualService = {}
GearVisualService.__index = GearVisualService
GearVisualService.Name = "GearVisualService"

local VISUAL_MODEL_NAME = "LastLightEquipmentVisuals"

local MATERIALS = {
    Fabric = Enum.Material.Fabric,
    Ground = Enum.Material.Ground,
    Wood = Enum.Material.Wood,
}

export type GearVisualService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: any,
        _profileService: any,
        _gearVisualPlan: any,
        _connections: { [Player]: RBXScriptConnection },
    },
    GearVisualService
))

function GearVisualService.new(
    logger: any,
    profileService: any,
    gearVisualPlan: any
): GearVisualService
    return setmetatable({
        Name = GearVisualService.Name,
        _logger = logger,
        _profileService = profileService,
        _gearVisualPlan = gearVisualPlan,
        _connections = {},
    }, GearVisualService)
end

local function targetFor(character: Model, targetName: string): BasePart?
    if targetName == "head" then
        return character:FindFirstChild("Head") :: BasePart?
    end
    local names = if targetName == "leftFoot"
        then { "LeftFoot", "LeftLowerLeg", "Left Leg" }
        else { "RightFoot", "RightLowerLeg", "Right Leg" }
    for _, name in names do
        local candidate = character:FindFirstChild(name)
        if candidate ~= nil and candidate:IsA("BasePart") then
            return candidate
        end
    end
    return nil
end

local function localFrame(plan: any, target: BasePart): CFrame
    local y = plan.offset[2]
    if plan.target ~= "head" and not string.find(target.Name, "Foot", 1, true) then
        y += -target.Size.Y * 0.5 + 0.42
    end
    return CFrame.new(plan.offset[1], y, plan.offset[3])
        * CFrame.Angles(
            math.rad(plan.rotation[1]),
            math.rad(plan.rotation[2]),
            math.rad(plan.rotation[3])
        )
end

local function buildPart(parent: Model, target: BasePart, plan: any): BasePart
    local visual = if plan.shape == "Wedge" then Instance.new("WedgePart") else Instance.new("Part")
    visual.Name = plan.name
    visual.Size = Vector3.new(plan.size[1], plan.size[2], plan.size[3])
    visual.Color = Color3.fromRGB(plan.color[1], plan.color[2], plan.color[3])
    visual.Material = MATERIALS[plan.material] or Enum.Material.SmoothPlastic
    if visual:IsA("Part") then
        visual.Shape = if plan.shape == "Cylinder"
            then Enum.PartType.Cylinder
            elseif plan.shape == "Ball" then Enum.PartType.Ball
            else Enum.PartType.Block
    end
    visual.Anchored = false
    visual.CanCollide = false
    visual.CanQuery = false
    visual.CanTouch = false
    visual.CastShadow = true
    visual.Massless = true
    visual.TopSurface = Enum.SurfaceType.Smooth
    visual.BottomSurface = Enum.SurfaceType.Smooth
    visual.CFrame = target.CFrame * localFrame(plan, target)
    visual.Parent = parent

    local weld = Instance.new("WeldConstraint")
    weld.Name = "EquipmentWeld"
    weld.Part0 = target
    weld.Part1 = visual
    weld.Parent = visual
    return visual
end

function GearVisualService._refresh(self: GearVisualService, player: Player)
    local character = player.Character
    if character == nil or character.Parent == nil then
        return
    end

    local oldVisuals = character:FindFirstChild(VISUAL_MODEL_NAME)
    if oldVisuals ~= nil then
        oldVisuals:Destroy()
    end
    if not self._profileService:isLoaded(player) then
        return
    end

    local model = Instance.new("Model")
    model.Name = VISUAL_MODEL_NAME
    model.Archivable = false
    local equipped = self._profileService:equippedSnapshot(player)
    local visualPartCount = 0
    for slot, itemId in equipped do
        local itemPlan = self._gearVisualPlan.get(itemId)
        if itemPlan ~= nil and itemPlan.slot == slot then
            model:SetAttribute(string.format("%sItemId", slot), itemId)
            for _, partPlan in itemPlan.parts do
                local target = targetFor(character, partPlan.target)
                if target ~= nil then
                    buildPart(model, target, partPlan)
                    visualPartCount += 1
                end
            end
        end
    end
    model:SetAttribute("VisualPartCount", visualPartCount)
    model.Parent = character
end

function GearVisualService._bindPlayer(self: GearVisualService, player: Player)
    if self._connections[player] ~= nil then
        return
    end
    self._connections[player] = player.CharacterAdded:Connect(function()
        task.defer(function()
            self:_refresh(player)
        end)
    end)
    if player.Character ~= nil then
        task.defer(function()
            self:_refresh(player)
        end)
    end
end

function GearVisualService.Init(self: GearVisualService)
    self._profileService:onLoaded(function(player: Player)
        self:_bindPlayer(player)
        self:_refresh(player)
    end)
    self._profileService:onEquipmentChanged(function(player: Player)
        self:_refresh(player)
    end)
end

function GearVisualService.Start(self: GearVisualService)
    Players.PlayerAdded:Connect(function(player: Player)
        self:_bindPlayer(player)
    end)
    Players.PlayerRemoving:Connect(function(player: Player)
        local connection = self._connections[player]
        if connection ~= nil then
            connection:Disconnect()
            self._connections[player] = nil
        end
    end)
    for _, player in Players:GetPlayers() do
        self:_bindPlayer(player)
    end
    self._logger:info("gear_visuals_started", {
        itemPlans = #self._gearVisualPlan.list(),
    })
end

return GearVisualService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Logger</string>
            <string name="Source"><![CDATA[--!strict

local Logger = {}
Logger.__index = Logger

export type Fields = { [string]: any }
export type Sink = (level: string, line: string, fields: Fields) -> ()
export type Logger = typeof(setmetatable(
    {} :: {
        _environment: string,
        _minimumLevel: number,
        _sink: Sink,
    },
    Logger
))

local levels = {
    debug = 1,
    info = 2,
    warn = 3,
    error = 4,
}

local function defaultSink(level: string, line: string, _fields: Fields)
    if level == "warn" or level == "error" then
        warn(line)
    else
        print(line)
    end
end

local function formatFields(fields: Fields): string
    local keys: { string } = {}
    for key in fields do
        table.insert(keys, key)
    end
    table.sort(keys)

    local output: { string } = {}
    for _, key in keys do
        table.insert(output, string.format("%s=%s", key, tostring(fields[key])))
    end

    return table.concat(output, " ")
end

function Logger.new(environment: string, minimumLevel: string, sink: Sink?): Logger
    assert(levels[minimumLevel] ~= nil, "unknown minimum log level")
    return setmetatable({
        _environment = environment,
        _minimumLevel = levels[minimumLevel],
        _sink = sink or defaultSink,
    }, Logger)
end

function Logger._emit(self: Logger, level: string, event: string, fields: Fields?)
    if levels[level] < self._minimumLevel then
        return
    end

    local safeFields = fields or {}
    local suffix = formatFields(safeFields)
    local line =
        string.format("[LastLight][%s][%s] %s", string.upper(level), self._environment, event)
    if suffix ~= "" then
        line ..= " " .. suffix
    end

    self._sink(level, line, safeFields)
end

function Logger.debug(self: Logger, event: string, fields: Fields?)
    self:_emit("debug", event, fields)
end

function Logger.info(self: Logger, event: string, fields: Fields?)
    self:_emit("info", event, fields)
end

function Logger.warn(self: Logger, event: string, fields: Fields?)
    self:_emit("warn", event, fields)
end

function Logger.error(self: Logger, event: string, fields: Fields?)
    self:_emit("error", event, fields)
end

return table.freeze(Logger)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">NetworkService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkService = {}
NetworkService.__index = NetworkService
NetworkService.Name = "NetworkService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type NetworkService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _folder: Folder?,
        _actionRequest: RemoteEvent?,
        _stateChanged: RemoteEvent?,
        _getState: RemoteFunction?,
        _actionHandler: ((Player, any) -> ())?,
        _snapshotProvider: ((Player) -> any)?,
        _snapshotCache: { [Player]: { at: number, value: any } },
        _lastActionAt: { [Player]: number },
        _lastStateAt: { [Player]: number },
    },
    NetworkService
))

function NetworkService.new(logger: Logger): NetworkService
    return setmetatable({
        Name = NetworkService.Name,
        _logger = logger,
        _folder = nil,
        _actionRequest = nil,
        _stateChanged = nil,
        _getState = nil,
        _actionHandler = nil,
        _snapshotProvider = nil,
        _snapshotCache = {},
        _lastActionAt = {},
        _lastStateAt = {},
    }, NetworkService)
end

local function isValidActionPayload(payload: any): boolean
    if type(payload) ~= "table" or payload.schemaVersion ~= 1 then
        return false
    end

    local kind = payload.kind
    if type(kind) ~= "string" or #kind == 0 or #kind > 32 then
        return false
    end

    local fieldCount = 0
    for key, value in payload do
        fieldCount += 1
        if fieldCount > 6 or type(key) ~= "string" then
            return false
        end
        local valueType = type(value)
        if valueType == "string" then
            if #value > 128 then
                return false
            end
        elseif valueType == "number" then
            if value ~= value or value == math.huge or value == -math.huge then
                return false
            end
        elseif valueType ~= "boolean" and valueType ~= "number" then
            return false
        end
    end
    return true
end

local function makeRemote(className: string, name: string, parent: Instance): Instance
    local remote = Instance.new(className)
    remote.Name = name
    remote.Parent = parent
    return remote
end

function NetworkService.Init(self: NetworkService, context: any)
    local runtimeIds = context.runtimeIds
    local existing = ReplicatedStorage:FindFirstChild(runtimeIds.FolderName)
    if existing ~= nil then
        existing:Destroy()
    end

    local folder = Instance.new("Folder")
    folder.Name = runtimeIds.FolderName
    folder:SetAttribute("SchemaVersion", 1)
    folder:SetAttribute("WorldReady", false)
    folder.Parent = ReplicatedStorage

    self._folder = folder
    self._actionRequest =
        makeRemote("RemoteEvent", runtimeIds.Remotes.ActionRequest, folder) :: RemoteEvent
    self._stateChanged =
        makeRemote("RemoteEvent", runtimeIds.Remotes.StateChanged, folder) :: RemoteEvent
    self._getState =
        makeRemote("RemoteFunction", runtimeIds.Remotes.GetState, folder) :: RemoteFunction
end

function NetworkService.Start(self: NetworkService)
    local actionRequest = assert(self._actionRequest, "action remote unavailable")
    local getState = assert(self._getState, "state function unavailable")

    actionRequest.OnServerEvent:Connect(function(player: Player, payload: any)
        if type(payload) ~= "table" then
            return
        end
        if not isValidActionPayload(payload) then
            return
        end
        local now = os.clock()
        local lastActionAt = self._lastActionAt[player]
        if lastActionAt ~= nil and os.clock() - lastActionAt < 0.05 then
            return
        end
        self._lastActionAt[player] = now
        local handler = self._actionHandler
        if handler ~= nil then
            handler(player, payload)
        end
    end)

    getState.OnServerInvoke = function(player: Player)
        if typeof(player) ~= "Instance" or not player:IsA("Player") then
            return nil
        end
        local lastStateAt = self._lastStateAt[player]
        if lastStateAt ~= nil and os.clock() - lastStateAt < 0.1 then
            return nil
        end
        self._lastStateAt[player] = os.clock()
        local provider = self._snapshotProvider
        if provider == nil then
            return nil
        end
        local now = os.clock()
        local cached = self._snapshotCache[player]
        if cached ~= nil and now - cached.at < 0.2 then
            return cached.value
        end

        local snapshot = provider(player)
        self._snapshotCache[player] = {
            at = now,
            value = snapshot,
        }
        return snapshot
    end
    Players.PlayerRemoving:Connect(function(player: Player)
        self._snapshotCache[player] = nil
        self._lastActionAt[player] = nil
        self._lastStateAt[player] = nil
    end)

    self._logger:info("network_started", { schemaVersion = 1 })
end

function NetworkService.setActionHandler(self: NetworkService, handler: (Player, any) -> ())
    self._actionHandler = handler
end

function NetworkService.setSnapshotProvider(self: NetworkService, provider: (Player) -> any)
    self._snapshotProvider = provider
end

function NetworkService.send(self: NetworkService, player: Player, snapshot: any)
    local stateChanged = self._stateChanged
    if stateChanged ~= nil and player.Parent ~= nil then
        self._snapshotCache[player] = {
            at = os.clock(),
            value = snapshot,
        }
        stateChanged:FireClient(player, snapshot)
    end
end

function NetworkService.broadcast(self: NetworkService, snapshotProvider: (Player) -> any)
    for _, player in Players:GetPlayers() do
        self:send(player, snapshotProvider(player))
    end
end

function NetworkService.setWorldReady(self: NetworkService, ready: boolean)
    local folder = self._folder
    if folder ~= nil then
        folder:SetAttribute("WorldReady", ready)
    end
end

function NetworkService.isWorldReady(self: NetworkService): boolean
    local folder = self._folder
    return folder ~= nil and folder:GetAttribute("WorldReady") == true
end

function NetworkService.folder(self: NetworkService): Folder
    return assert(self._folder, "network service has not initialized")
end

return table.freeze(NetworkService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">OldGrowthService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local OldGrowthService = {}
OldGrowthService.__index = OldGrowthService
OldGrowthService.Name = "OldGrowthService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type AttackVisual = {
    label: TextLabel,
    marker: Part,
}

type Attack = {
    areaCFrame: CFrame,
    definition: any,
    flow: any,
    target: Player,
    visual: AttackVisual,
}

export type OldGrowthService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _expeditionService: any,
        _survivalService: any,
        _combatService: any,
        _professionService: any,
        _encounter: any,
        _enemyAttackFlow: any,
        _enemyCombatRules: any,
        _builder: any,
        _analyticsService: any,
        _featureFlags: any,
        _state: any,
        _arena: any,
        _model: Model?,
        _attack: Attack?,
        _attackIndex: number,
        _lastAttackAt: number,
        _markedUntil: number,
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
        _activationGate: (() -> boolean)?,
    },
    OldGrowthService
))

local ACTIVATION_RADIUS = 28
local ENCOUNTER_RADIUS = 58
local STRIKE_RANGE = 14

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function weakPoint(model: Model): BasePart?
    local heart = model:FindFirstChild("AmberHeart")
    return if heart ~= nil
            and heart:IsA("BasePart")
            and heart:GetAttribute("WeakPoint") == true
        then heart
        else nil
end

function OldGrowthService.new(
    logger: Logger,
    worldService: any,
    expeditionService: any,
    survivalService: any,
    combatService: any,
    professionService: any,
    encounter: any,
    enemyAttackFlow: any,
    enemyCombatRules: any,
    builder: any,
    analyticsService: any,
    featureFlags: any
): OldGrowthService
    return setmetatable({
        Name = OldGrowthService.Name,
        _logger = logger,
        _worldService = worldService,
        _expeditionService = expeditionService,
        _survivalService = survivalService,
        _combatService = combatService,
        _professionService = professionService,
        _encounter = encounter,
        _enemyAttackFlow = enemyAttackFlow,
        _enemyCombatRules = enemyCombatRules,
        _builder = builder,
        _analyticsService = analyticsService,
        _featureFlags = featureFlags,
        _state = nil,
        _arena = nil,
        _model = nil,
        _attack = nil,
        _attackIndex = 0,
        _lastAttackAt = 0,
        _markedUntil = 0,
        _onChanged = nil,
        _heartbeat = nil,
        _activationGate = nil,
    }, OldGrowthService)
end

function OldGrowthService.setActivationGate(self: OldGrowthService, gate: (() -> boolean)?)
    self._activationGate = gate
end

function OldGrowthService.Init(self: OldGrowthService, _context: any)
    local manifest = assert(self._expeditionService:manifest(), "expedition manifest unavailable")
    self._arena = assert(self._worldService:oldGrowthArena(), "Old Growth arena unavailable")
    self._state = self._encounter.create(
        self._expeditionService:runId(),
        manifest.hash,
        self._featureFlags:isEnabled("old_growth_elite_enabled")
    )
    self._worldService:setOldGrowthPresentation(self._state.status)
end

function OldGrowthService.Start(self: OldGrowthService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.05 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
    self._logger:info("old_growth_ready", {
        enabled = self._state.status ~= "disabled",
        elite = self._encounter.Id,
        manifest = self._state.manifestHash,
    })
end

function OldGrowthService.setChangedHandler(self: OldGrowthService, callback: (string?) -> ())
    self._onChanged = callback
end

function OldGrowthService._notify(self: OldGrowthService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function OldGrowthService._inArena(self: OldGrowthService, player: Player, radius: number): boolean
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return false
    end
    local root = rootPart(player)
    return root ~= nil and (root.Position - self._arena.center).Magnitude <= radius
end

function OldGrowthService._spawnModel(self: OldGrowthService, target: Player)
    if self._model ~= nil and self._model.Parent ~= nil then
        return
    end
    local targetRoot = rootPart(target)
    local lookAt = if targetRoot == nil
        then self._arena.center + Vector3.new(0, 0, -10)
        else targetRoot.Position
    local model = self._builder.build(self._arena.center, lookAt, self._encounter.MaxHealth)
    model.Parent =
        assert(self._arena.fireSource.Parent, "Old Growth arena lost its streamed module")
    self._model = model
    self._builder.setState(model, self._state.health, false, false)
end

function OldGrowthService._clearAttack(self: OldGrowthService)
    local attack = self._attack
    if attack == nil then
        return
    end
    if attack.visual.marker.Parent ~= nil then
        attack.visual.marker:Destroy()
    end
    self._attack = nil
end

function OldGrowthService._groundPosition(self: OldGrowthService, targetRoot: BasePart): Vector3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { targetRoot.Parent :: Model }
    if self._model ~= nil then
        table.insert(excluded, self._model)
    end
    params.FilterDescendantsInstances = excluded
    local result = workspace:Raycast(
        targetRoot.Position + Vector3.new(0, 3, 0),
        Vector3.new(0, -18, 0),
        params
    )
    return if result == nil
        then targetRoot.Position - Vector3.new(0, 2.8, 0)
        else result.Position + Vector3.new(0, 0.14, 0)
end

function OldGrowthService._attackArea(
    self: OldGrowthService,
    definition: any,
    targetRoot: BasePart
): CFrame
    local ground = self:_groundPosition(targetRoot)
    if definition.shape == "circle" or self._model == nil or self._model.PrimaryPart == nil then
        return CFrame.new(ground)
    end
    local origin = self._model.PrimaryPart.Position
    local direction =
        Vector3.new(targetRoot.Position.X - origin.X, 0, targetRoot.Position.Z - origin.Z)
    if direction.Magnitude < 0.01 then
        direction = Vector3.new(0, 0, -1)
    end
    direction = direction.Unit
    local center = Vector3.new(origin.X, ground.Y, origin.Z) + direction * definition.length * 0.5
    return CFrame.lookAt(center, center + direction)
end

function OldGrowthService._createAttackVisual(
    _self: OldGrowthService,
    definition: any,
    areaCFrame: CFrame
): AttackVisual
    local marker = Instance.new("Part")
    marker.Name = "OldGrowthAttackWarning"
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.CastShadow = false
    marker.Color = if definition.shape == "lane"
        then Color3.fromRGB(101, 187, 112)
        else Color3.fromRGB(255, 148, 82)
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.5
    if definition.shape == "lane" then
        marker.Size = Vector3.new(definition.width, 0.2, definition.length)
        marker.CFrame = areaCFrame
    else
        marker.Shape = Enum.PartType.Cylinder
        marker.Size = Vector3.new(0.2, definition.radius * 2, definition.radius * 2)
        marker.CFrame = areaCFrame * CFrame.Angles(0, 0, math.rad(90))
    end
    marker.Parent = workspace

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "OldGrowthAttackLabel"
    billboard.Adornee = marker
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 120
    billboard.Size = UDim2.fromOffset(270, 68)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.4, 0)
    billboard.Parent = marker

    local label = Instance.new("TextLabel")
    label.Name = "Warning"
    label.BackgroundColor3 = Color3.fromRGB(26, 38, 29)
    label.BackgroundTransparency = 0.08
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = definition.attackName .. "\n" .. definition.instruction
    label.TextColor3 = Color3.fromRGB(248, 233, 198)
    label.TextScaled = true
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local stroke = Instance.new("UIStroke")
    stroke.Color = marker.Color
    stroke.Thickness = 2
    stroke.Transparency = 0.08
    stroke.Parent = label
    return {
        label = label,
        marker = marker,
    }
end

function OldGrowthService._startAttack(self: OldGrowthService, target: Player, now: number)
    local targetRoot = rootPart(target)
    if targetRoot == nil then
        return
    end
    self._attackIndex += 1
    local definition = self._encounter.attack(self._attackIndex, self._state.shieldIndex)
    local areaCFrame = self:_attackArea(definition, targetRoot)
    self._attack = {
        areaCFrame = areaCFrame,
        definition = definition,
        flow = self._enemyAttackFlow.create(target.UserId, now, definition.windup),
        target = target,
        visual = self:_createAttackVisual(definition, areaCFrame),
    }
    self._lastAttackAt = now
    self._analyticsService:eliteAttackTelegraphed(
        target,
        self._encounter.Id,
        definition.attackId,
        definition.shape,
        definition.windup
    )
    self:_notify(nil)
end

function OldGrowthService._clearPath(self: OldGrowthService, target: Player): boolean
    local model = self._model
    local root = rootPart(target)
    local character = target.Character
    if model == nil or model.PrimaryPart == nil or root == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { model }
    local result = workspace:Raycast(
        model.PrimaryPart.Position,
        root.Position - model.PrimaryPart.Position,
        params
    )
    return result == nil or result.Instance:IsDescendantOf(character)
end

function OldGrowthService._insideAttack(
    self: OldGrowthService,
    attack: Attack,
    targetRoot: BasePart
): boolean
    local localPosition = attack.areaCFrame:PointToObjectSpace(targetRoot.Position)
    return self._enemyCombatRules.contains(
        attack.definition.shape,
        localPosition.X,
        localPosition.Z,
        attack.definition.radius,
        attack.definition.width,
        attack.definition.length
    )
end

function OldGrowthService._stepAttack(self: OldGrowthService, now: number)
    local attack = self._attack
    if attack == nil then
        return
    end
    local targetRoot = rootPart(attack.target)
    local resolving = now >= attack.flow.endsAt
    local decision = self._enemyAttackFlow.evaluate(attack.flow, now, {
        clearPath = not resolving or self:_clearPath(attack.target),
        inImpactArea = not resolving
            or (targetRoot ~= nil and self:_insideAttack(attack, targetRoot)),
        targetCanAct = self._survivalService:canAct(attack.target),
        targetPresent = attack.target.Parent ~= nil and attack.target:GetAttribute(
            "LastLightInExpedition"
        ) == true and targetRoot ~= nil,
    })
    if decision.status == "pending" then
        attack.visual.label.Text = string.format(
            "%s\n%s · %.1fs",
            attack.definition.attackName,
            attack.definition.instruction,
            math.max(0, decision.remaining or 0)
        )
        return
    end

    local target = attack.target
    local definition = attack.definition
    self:_clearAttack()
    if decision.status == "cancel" or decision.status == "miss" then
        self._analyticsService:eliteAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            decision.reason or decision.status
        )
        self:_notify(nil)
        return
    end
    if self._combatService:avoidsDamage(target, now) then
        self._analyticsService:eliteAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            "dodged"
        )
        self:_notify(nil)
        return
    end

    local damage, guarded =
        self._professionService:mitigateIncomingDamage(target, definition.damage, now)
    damage = self._combatService:mitigateShieldedDamage(target, damage, now)
    local result = self._survivalService:damage(target, damage, self._encounter.Id)
    if result.applied and definition.attackId == "old_growth_root_lane" then
        self._combatService:applyRooted(
            target,
            definition.rootedDuration,
            definition.rootedMultiplier
        )
    end
    self._analyticsService:eliteAttackResult(
        target,
        self._encounter.Id,
        definition.attackId,
        if result.applied then (if guarded then "guarded_hit" else "hit") else "blocked"
    )
    if result.downed then
        self:_notify("ALLY DOWN — " .. definition.attackName)
    elseif guarded and result.applied then
        self:_notify("LANTERN GUARD ABSORBS " .. definition.attackName)
    else
        self:_notify(nil)
    end
end

function OldGrowthService._syncCarrierVisuals(self: OldGrowthService, now: number)
    for _, player in Players:GetPlayers() do
        local snapshot = self._encounter.snapshot(self._state, player.UserId, now)
        player:SetAttribute("LastLightCarryingOldGrowthFire", snapshot.carryingFire)
        player:SetAttribute("LastLightOldGrowthFireExpiresAt", snapshot.fireExpiresAt)
        local root = rootPart(player)
        if root ~= nil then
            local light = root:FindFirstChild("OldGrowthCarryLight")
            if snapshot.carryingFire and light == nil then
                local pointLight = Instance.new("PointLight")
                pointLight.Name = "OldGrowthCarryLight"
                pointLight.Color = Color3.fromRGB(255, 181, 76)
                pointLight.Brightness = 2.2
                pointLight.Range = 18
                pointLight.Shadows = false
                pointLight.Parent = root
            elseif not snapshot.carryingFire and light ~= nil then
                light:Destroy()
            end
        end
    end
end

function OldGrowthService._playersInArena(self: OldGrowthService): { Player }
    local players = {}
    for _, player in Players:GetPlayers() do
        if self:_inArena(player, ENCOUNTER_RADIUS) and self._survivalService:canAct(player) then
            table.insert(players, player)
        end
    end
    return players
end

function OldGrowthService._nearestPlayer(self: OldGrowthService, players: { Player }): Player?
    local anchor = self._arena.center
    if self._model ~= nil and self._model.PrimaryPart ~= nil then
        anchor = self._model.PrimaryPart.Position
    end
    local nearest: Player? = nil
    local nearestDistance = math.huge
    for _, player in players do
        local root = rootPart(player)
        if root ~= nil then
            local distance = (root.Position - anchor).Magnitude
            if distance < nearestDistance then
                nearest = player
                nearestDistance = distance
            end
        end
    end
    return nearest
end

function OldGrowthService._step(self: OldGrowthService, now: number)
    local previousRevision = self._state.revision
    self._state = self._encounter.expire(self._state, now)
    if self._state.revision ~= previousRevision then
        self:_syncCarrierVisuals(now)
        self:_notify("LANTERN FIRE FADED — TAKE ANOTHER FLAME")
    end

    if
        self._state.status == "dormant"
        and (self._activationGate == nil or (self._activationGate :: () -> boolean)())
    then
        for _, player in Players:GetPlayers() do
            if
                self:_inArena(player, ACTIVATION_RADIUS) and self._survivalService:canAct(player)
            then
                local nextState, result = self._encounter.activate(self._state, player.UserId)
                if result.accepted then
                    self._state = nextState
                    self:_spawnModel(player)
                    self._lastAttackAt = now
                    self._worldService:setOldGrowthPresentation(self._state.status)
                    self._analyticsService:eliteStarted(
                        player,
                        self._encounter.Id,
                        self._state.manifestHash
                    )
                    self:_notify("OLD GROWTH AWAKENS — STRIKE THE AMBER HEART")
                end
                break
            end
        end
        return
    end
    if self._state.status ~= "vulnerable" and self._state.status ~= "shielded" then
        return
    end

    local players = self:_playersInArena()
    for _, player in players do
        self._state = self._encounter.join(self._state, player.UserId)
    end
    if self._model == nil or self._model.Parent == nil then
        local target = self:_nearestPlayer(players)
        if target ~= nil then
            self:_spawnModel(target)
        end
    end
    if self._markedUntil > 0 and now >= self._markedUntil then
        self._markedUntil = 0
        if self._model ~= nil then
            self._builder.setState(
                self._model,
                self._state.health,
                self._state.status == "shielded",
                false
            )
        end
        self:_notify(nil)
    end
    if self._attack ~= nil then
        self:_stepAttack(now)
        return
    end
    local target = self:_nearestPlayer(players)
    if target == nil then
        return
    end
    local tuning = self._encounter.Tuning
    local cooldown = if self._state.status == "shielded"
        then tuning.shieldedAttackCooldownSeconds
        else tuning.attackCooldownSeconds
    if now < self._markedUntil then
        cooldown *= tuning.markedAttackCooldownMultiplier
    end
    if now - self._lastAttackAt >= cooldown then
        self:_startAttack(target, now)
    end
end

function OldGrowthService.interact(
    self: OldGrowthService,
    player: Player,
    prompt: ProximityPrompt
): any
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return {
            accepted = false,
            message = "ENTER THE OLD GROWTH ARENA WHILE ACTIVE",
            reason = "player_unavailable",
        }
    end
    local promptParent = prompt.Parent
    local interaction = if promptParent == nil
        then nil
        else promptParent:GetAttribute("EliteInteraction")
    local now = workspace:GetServerTimeNow()
    local nextState, result
    if interaction == "fire_source" then
        nextState, result = self._encounter.takeFire(self._state, player.UserId, now)
    elseif interaction == "root_heart" then
        nextState, result = self._encounter.burnHeart(self._state, player.UserId, now)
    else
        return {
            accepted = false,
            message = "THAT ELITE INTERACTION IS INVALID",
            reason = "invalid_interaction",
        }
    end
    if not result.accepted then
        result.message = if result.reason == "fire_required"
            then "TAKE LANTERN FIRE BEFORE TOUCHING THE ROOT HEART"
            elseif result.reason == "fire_claimed" then "AN ALLY ALREADY CARRIES THE FIRE"
            else "THE ROOT SHIELD IS NOT CALLING FOR FIRE"
        return result
    end

    self._state = nextState
    self._worldService:setOldGrowthPresentation(self._state.status)
    self:_syncCarrierVisuals(now)
    if result.reason == "fire_taken" then
        result.message = "LANTERN FIRE HELD — REACH THE ROOT HEART"
        self:_notify(result.message)
    else
        result.message = "ROOT SHIELD BURNED — AMBER HEART EXPOSED"
        if self._model ~= nil then
            self._builder.setState(self._model, self._state.health, false, now < self._markedUntil)
        end
        self._analyticsService:elitePhase(
            player,
            self._encounter.Id,
            self._state.shieldIndex + 1,
            "shield_burned"
        )
        self:_notify(result.message)
    end
    return result
end

function OldGrowthService._lineOfSight(
    _self: OldGrowthService,
    player: Player,
    model: Model
): boolean
    local root = rootPart(player)
    local heart = weakPoint(model)
    local character = player.Character
    if root == nil or heart == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    local result = workspace:Raycast(root.Position, heart.Position - root.Position, params)
    return result ~= nil and result.Instance == heart
end

function OldGrowthService.damageNearest(self: OldGrowthService, player: Player): (boolean, string)
    if self._state.status ~= "vulnerable" and self._state.status ~= "shielded" then
        return false, "No elite threat is active."
    end
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return false, "Enter the Old Growth arena to strike."
    end
    local model = self._model
    local root = rootPart(player)
    local heart = if model == nil then nil else weakPoint(model)
    if model == nil or root == nil or heart == nil then
        return false, "Old Growth is still taking shape."
    end
    if (root.Position - heart.Position).Magnitude > STRIKE_RANGE then
        return false, "Move closer to the amber heart."
    end
    if not self:_lineOfSight(player, model) then
        return false, "The amber heart is behind the trunk."
    end

    local tuning = self._encounter.Tuning
    local amount = if workspace:GetServerTimeNow() < self._markedUntil
        then tuning.markedStrikeDamage
        else tuning.strikeDamage
    local nextState, result = self._encounter.strike(self._state, player.UserId, amount)
    if not result.accepted then
        if result.reason == "shielded" then
            return false, "ROOT SHIELD — MOVE LANTERN FIRE TO THE HEART"
        end
        return false, "Old Growth cannot be struck right now."
    end
    self._state = nextState
    self._builder.setState(
        model,
        self._state.health,
        self._state.status == "shielded",
        workspace:GetServerTimeNow() < self._markedUntil
    )
    self._worldService:setOldGrowthPresentation(self._state.status)
    if result.completed then
        self:_clearAttack()
        for participantId in self._state.participants do
            local userId = tonumber(participantId)
            if userId ~= nil then
                self._expeditionService:grantEncounterReward(
                    userId,
                    self._encounter.Id,
                    self._encounter.rewardTransactionId(self._state, userId),
                    self._encounter.Reward
                )
            end
        end
        self:_syncCarrierVisuals(workspace:GetServerTimeNow())
        self._analyticsService:eliteCompleted(
            player,
            self._encounter.Id,
            self._state.manifestHash,
            self._state.shieldIndex,
            self:_participantCount()
        )
        self:_notify("OLD GROWTH CLEANSED — +3 AMBER SAP UNBANKED")
        return true, "Old Growth cleansed. Amber Sap added to the expedition pouch."
    end
    if result.shieldStarted then
        self._analyticsService:elitePhase(
            player,
            self._encounter.Id,
            self._state.shieldIndex,
            "shield_started"
        )
        self:_notify("ROOT SHIELD — TAKE LANTERN FIRE TO THE HEART")
        return true, "A root shield closes around the amber heart."
    end
    self:_notify(
        string.format("HIT — OLD GROWTH %d / %d", self._state.health, self._encounter.MaxHealth)
    )
    return true, "Your tool strikes the amber heart."
end

function OldGrowthService._participantCount(self: OldGrowthService): number
    local count = 0
    for _ in self._state.participants do
        count += 1
    end
    return count
end

function OldGrowthService.canMarkNearest(
    self: OldGrowthService,
    player: Player,
    range: number
): (boolean, string)
    local model = self._model
    local root = rootPart(player)
    if
        not self:combatActive()
        or model == nil
        or model.PrimaryPart == nil
        or root == nil
        or not self:_inArena(player, ENCOUNTER_RADIUS)
        or not self._survivalService:canAct(player)
    then
        return false, "NO ELITE THREAT CAN BE MARKED"
    end
    if (root.Position - model.PrimaryPart.Position).Magnitude > range then
        return false, "MOVE CLOSER TO MARK OLD GROWTH"
    end
    if not self:_lineOfSight(player, model) then
        return false, "OLD GROWTH IS HIDDEN BY THE TRUNK"
    end
    return true, "FOXFIRE MARK READY"
end

function OldGrowthService.markNearest(
    self: OldGrowthService,
    player: Player,
    range: number,
    duration: number
): (boolean, string)
    local allowed, reason = self:canMarkNearest(player, range)
    if not allowed then
        return false, reason
    end
    self._markedUntil = workspace:GetServerTimeNow() + duration
    if self._model ~= nil then
        self._builder.setState(
            self._model,
            self._state.health,
            self._state.status == "shielded",
            true
        )
    end
    local message = "FOXFIRE MARK — OLD GROWTH TELEGRAPHS SLOWED"
    self:_notify(message)
    return true, message
end

function OldGrowthService.threatSnapshot(self: OldGrowthService, viewer: Player): any
    local attack = self._attack
    if attack == nil or attack.target ~= viewer then
        return nil
    end
    return {
        attackId = attack.definition.attackId,
        displayName = attack.definition.attackName,
        enemyId = self._encounter.Id,
        enemyName = "OLD GROWTH",
        instruction = attack.definition.instruction,
        resolvesAt = attack.flow.endsAt,
        shape = attack.definition.shape,
    }
end

function OldGrowthService.snapshot(self: OldGrowthService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return nil
    end
    local snapshot =
        self._encounter.snapshot(self._state, player.UserId, workspace:GetServerTimeNow())
    if not self:_inArena(player, ENCOUNTER_RADIUS + 18) and not snapshot.carryingFire then
        return nil
    end
    return snapshot
end

function OldGrowthService.combatActive(self: OldGrowthService): boolean
    return self._state.status == "vulnerable" or self._state.status == "shielded"
end

function OldGrowthService.isComplete(self: OldGrowthService): boolean
    return self._state.status == "complete"
end

function OldGrowthService.enabled(self: OldGrowthService): boolean
    return self._state.status ~= "disabled"
end

return table.freeze(OldGrowthService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">PhaseService</string>
            <string name="Source"><![CDATA[--!strict

local PhaseService = {}
PhaseService.__index = PhaseService
PhaseService.Name = "PhaseService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type PhaseService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _enemyService: any,
        _nightSchedule: any,
        _duskSeconds: number,
        _nightSeconds: number,
        _phase: string,
        _phaseEndsAt: number,
        _active: boolean,
        _generation: number,
        _onChanged: ((string?) -> ())?,
        _onComplete: (() -> ())?,
    },
    PhaseService
))

function PhaseService.new(
    logger: Logger,
    worldService: any,
    enemyService: any,
    nightSchedule: any,
    duskSeconds: number,
    nightSeconds: number
): PhaseService
    return setmetatable({
        Name = PhaseService.Name,
        _logger = logger,
        _worldService = worldService,
        _enemyService = enemyService,
        _nightSchedule = nightSchedule,
        _duskSeconds = duskSeconds,
        _nightSeconds = nightSeconds,
        _phase = "day",
        _phaseEndsAt = 0,
        _active = false,
        _generation = 0,
        _onChanged = nil,
        _onComplete = nil,
    }, PhaseService)
end

function PhaseService.Init(_self: PhaseService, _context: any) end

function PhaseService.Start(_self: PhaseService) end

function PhaseService.setChangedHandler(self: PhaseService, callback: (string?) -> ())
    self._onChanged = callback
end

function PhaseService.setCompleteHandler(self: PhaseService, callback: () -> ())
    self._onComplete = callback
end

function PhaseService._notify(self: PhaseService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

local function waitUntil(target: number, generation: number, service: PhaseService): boolean
    while workspace:GetServerTimeNow() < target do
        if service._generation ~= generation or not service._active then
            return false
        end
        task.wait(0.15)
    end
    return service._generation == generation and service._active
end

function PhaseService.startFirstNight(self: PhaseService): boolean
    if self._active then
        return false
    end

    self._active = true
    self._generation += 1
    local generation = self._generation
    self._phase = "dusk"
    self._phaseEndsAt = workspace:GetServerTimeNow() + self._duskSeconds
    self._worldService:setDusk(true)
    self:_notify("DUSK FALLS — PREPARE THE LIGHT")
    self._logger:info("first_night_dusk_started", { duration = self._duskSeconds })

    task.spawn(function()
        if not waitUntil(self._phaseEndsAt, generation, self) then
            return
        end

        self._phase = "night"
        local nightStartedAt = workspace:GetServerTimeNow()
        self._phaseEndsAt = nightStartedAt + self._nightSeconds
        self._worldService:setNight(true)
        self._enemyService:startNight()
        self:_notify("NIGHT HAS ARRIVED")
        self._logger:info("first_night_started", { duration = self._nightSeconds })

        for _, beat in self._nightSchedule.beats(self._nightSeconds) do
            if not waitUntil(nightStartedAt + beat.at, generation, self) then
                return
            end
            if beat.kind == "spawn" then
                self._enemyService:spawn(beat.enemyId)
            elseif beat.kind == "breach" then
                self._enemyService:setBreach()
            elseif beat.kind == "warning" then
                self:_notify("THE FOREST GOES QUIET")
            end
        end

        if not waitUntil(self._phaseEndsAt, generation, self) then
            return
        end
        self:_finishFirstNight()
    end)

    return true
end

function PhaseService.ensureFirstNight(self: PhaseService)
    if not self._active and self._phase ~= "reveal" then
        self:startFirstNight()
    end
end

function PhaseService._finishFirstNight(self: PhaseService)
    self._active = false
    self._phase = "reveal"
    self._phaseEndsAt = 0
    self._enemyService:stopNight()
    self._worldService:setNight(false)
    self._worldService:setBeaconVisible(true)
    self:_notify("DAWN BREAKS — A MEMORY CALLS")
    self._logger:info("first_night_completed")

    local callback = self._onComplete
    if callback ~= nil then
        callback()
    end
end

function PhaseService.snapshot(self: PhaseService): any
    return {
        phase = self._phase,
        phaseEndsAt = self._phaseEndsAt,
        nightActive = self._active and self._phase == "night",
        lanternHealth = self._enemyService:lanternHealth(),
        enemyCount = self._enemyService:activeCount(),
    }
end

function PhaseService.isNightActive(self: PhaseService): boolean
    return self._active and self._phase == "night"
end

function PhaseService.hasCompletedFirstNight(self: PhaseService): boolean
    return self._phase == "reveal"
end

return table.freeze(PhaseService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">PlayerCombatService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PlayerCombatService = {}
PlayerCombatService.__index = PlayerCombatService
PlayerCombatService.Name = "PlayerCombatService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type PlayerCombatService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _combatState: any,
        _statusEffectState: any,
        _featureFlags: any,
        _survivalService: any,
        _analyticsService: any,
        _equipmentStatsProvider: ((Player) -> any)?,
        _states: { [Player]: any },
        _statusStates: { [Player]: any },
        _lastPublishedStamina: { [Player]: number },
        _lastPublishedDrowsy: { [Player]: boolean },
        _lastPublishedRooted: { [Player]: boolean },
        _lastRejectionAt: { [Player]: number },
        _nextPublishAt: { [Player]: number },
        _onChanged: ((Player, string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
    },
    PlayerCombatService
))

local function humanoid(player: Player): Humanoid?
    local character = player.Character
    return if character == nil then nil else character:FindFirstChildOfClass("Humanoid")
end

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

function PlayerCombatService.new(
    logger: Logger,
    config: any,
    combatState: any,
    statusEffectState: any,
    featureFlags: any,
    survivalService: any,
    analyticsService: any
): PlayerCombatService
    return setmetatable({
        Name = PlayerCombatService.Name,
        _logger = logger,
        _config = config,
        _combatState = combatState,
        _statusEffectState = statusEffectState,
        _featureFlags = featureFlags,
        _survivalService = survivalService,
        _analyticsService = analyticsService,
        _equipmentStatsProvider = nil,
        _states = {},
        _statusStates = {},
        _lastPublishedStamina = {},
        _lastPublishedDrowsy = {},
        _lastPublishedRooted = {},
        _lastRejectionAt = {},
        _nextPublishAt = {},
        _onChanged = nil,
        _heartbeat = nil,
    }, PlayerCombatService)
end

function PlayerCombatService.setEquipmentStatsProvider(
    self: PlayerCombatService,
    provider: (Player) -> any
)
    self._equipmentStatsProvider = provider
end

function PlayerCombatService._staminaRegenMultiplier(
    self: PlayerCombatService,
    player: Player
): number
    local provider = self._equipmentStatsProvider
    if provider == nil then
        return 1
    end
    local stats = provider(player)
    return math.clamp(
        if type(stats) == "table" and type(stats.staminaRegenMultiplier) == "number"
            then stats.staminaRegenMultiplier
            else 1,
        0.75,
        1.5
    )
end

function PlayerCombatService.Init(_self: PlayerCombatService, _context: any) end

function PlayerCombatService.setChangedHandler(
    self: PlayerCombatService,
    callback: (Player, string?) -> ()
)
    self._onChanged = callback
end

function PlayerCombatService._notify(self: PlayerCombatService, player: Player, message: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(player, message)
    end
end

function PlayerCombatService._syncPlayer(self: PlayerCombatService, player: Player)
    local state = self._states[player]
    if state == nil then
        return
    end
    local now = workspace:GetServerTimeNow()
    local snapshot = self._combatState.snapshot(state, now)
    local statusState = self._statusStates[player] or self._statusEffectState.create()
    local status = self._statusEffectState.snapshot(statusState, now)
    local dodgeActive = self._featureFlags:isEnabled("combat_mobility_enabled")
        and snapshot.dodgeActive
    player:SetAttribute("LastLightStamina", snapshot.stamina)
    player:SetAttribute("LastLightMaxStamina", snapshot.maxStamina)
    player:SetAttribute("LastLightSprinting", snapshot.sprinting)
    player:SetAttribute("LastLightDodging", dodgeActive)
    player:SetAttribute("LastLightDodgeActiveUntil", snapshot.dodgeActiveUntil)
    player:SetAttribute("LastLightDodgeReadyAt", snapshot.dodgeReadyAt)
    player:SetAttribute("LastLightDrowsy", status.drowsy)
    player:SetAttribute("LastLightDrowsyUntil", status.drowsyUntil)
    player:SetAttribute("LastLightRooted", status.rooted)
    player:SetAttribute("LastLightRootedUntil", status.rootedUntil)
    player:SetAttribute("LastLightShielded", status.shielded)
    player:SetAttribute("LastLightShieldUntil", status.shieldUntil)
    player:SetAttribute("LastLightStaminaRegenMultiplier", self:_staminaRegenMultiplier(player))

    local activeHumanoid = humanoid(player)
    if activeHumanoid ~= nil then
        activeHumanoid.WalkSpeed = if not self._survivalService:canAct(player)
            then self._config.DownedWalkSpeed
            elseif snapshot.sprinting then self._config.SprintWalkSpeed * status.movementMultiplier
            else self._config.BaseWalkSpeed * status.movementMultiplier
    end
end

function PlayerCombatService._markPublished(self: PlayerCombatService, player: Player, now: number)
    local state = self._states[player]
    if state == nil then
        return
    end
    local snapshot = self._combatState.snapshot(state, now)
    self._lastPublishedStamina[player] = snapshot.stamina
    self._nextPublishAt[player] = now + 0.25
end

function PlayerCombatService._bindPlayer(self: PlayerCombatService, player: Player)
    if self._states[player] ~= nil then
        return
    end
    local now = workspace:GetServerTimeNow()
    self._states[player] = self._combatState.create(now)
    self._statusStates[player] = self._statusEffectState.create()
    self._lastPublishedStamina[player] = self._config.MaxStamina
    self._lastPublishedDrowsy[player] = false
    self._lastPublishedRooted[player] = false
    self._nextPublishAt[player] = now

    player.CharacterAdded:Connect(function(character: Model)
        local resetAt = workspace:GetServerTimeNow()
        self._states[player] = self._combatState.create(resetAt)
        self._statusStates[player] = self._statusEffectState.create()
        self._lastPublishedStamina[player] = self._config.MaxStamina
        self._lastPublishedDrowsy[player] = false
        self._lastPublishedRooted[player] = false
        self._nextPublishAt[player] = resetAt
        task.spawn(function()
            local activeHumanoid = character:WaitForChild("Humanoid", 8)
            if
                activeHumanoid ~= nil
                and activeHumanoid:IsA("Humanoid")
                and player.Parent ~= nil
            then
                self:_syncPlayer(player)
                self:_notify(player, nil)
            end
        end)
    end)
    self:_syncPlayer(player)
end

function PlayerCombatService.Start(self: PlayerCombatService)
    Players.PlayerAdded:Connect(function(player: Player)
        self:_bindPlayer(player)
    end)
    Players.PlayerRemoving:Connect(function(player: Player)
        self._states[player] = nil
        self._statusStates[player] = nil
        self._lastPublishedStamina[player] = nil
        self._lastPublishedDrowsy[player] = nil
        self._lastPublishedRooted[player] = nil
        self._lastRejectionAt[player] = nil
        self._nextPublishAt[player] = nil
    end)
    for _, player in Players:GetPlayers() do
        self:_bindPlayer(player)
    end

    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.1 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
end

function PlayerCombatService._step(self: PlayerCombatService, now: number)
    local enabled = self._featureFlags:isEnabled("combat_mobility_enabled")
    for player, state in self._states do
        local nextState = self._combatState.advance(
            state,
            now,
            enabled and self._survivalService:canAct(player),
            self:_staminaRegenMultiplier(player)
        )
        self._states[player] = nextState

        local snapshot = self._combatState.snapshot(nextState, now)
        local statusState = self._statusStates[player] or self._statusEffectState.create()
        local status = self._statusEffectState.snapshot(statusState, now)
        local lastStamina = self._lastPublishedStamina[player]
        local nextPublishAt = self._nextPublishAt[player] or now
        local resourcePublish = lastStamina ~= snapshot.stamina and now >= nextPublishAt
        local sprintChanged = state.sprinting ~= nextState.sprinting
        local dodgeChanged = player:GetAttribute("LastLightDodging")
            ~= (enabled and snapshot.dodgeActive)
        local drowsyChanged = self._lastPublishedDrowsy[player] ~= status.drowsy
        local rootedChanged = self._lastPublishedRooted[player] ~= status.rooted
        if resourcePublish or sprintChanged or dodgeChanged or drowsyChanged or rootedChanged then
            self:_syncPlayer(player)
        end
        if drowsyChanged then
            self._lastPublishedDrowsy[player] = status.drowsy
            self:_notify(
                player,
                if status.drowsy then "DROWSY — KEEP MOVING" else "DROWSINESS CLEARED"
            )
        end
        if rootedChanged then
            self._lastPublishedRooted[player] = status.rooted
            self:_notify(
                player,
                if status.rooted then "ROOTED — KEEP MOVING" else "ROOTS RELEASED"
            )
        end
        if resourcePublish then
            self:_markPublished(player, now)
            self:_notify(player, nil)
        end
    end
end

function PlayerCombatService.applyRooted(
    self: PlayerCombatService,
    player: Player,
    duration: number,
    multiplier: number
): boolean
    local state = self._states[player]
    local statusState = self._statusStates[player]
    if state == nil or statusState == nil or not self._survivalService:canAct(player) then
        return false
    end
    local now = workspace:GetServerTimeNow()
    local nextState, _result =
        self._combatState.setSprint(state, false, now, true, self:_staminaRegenMultiplier(player))
    self._states[player] = nextState
    self._statusStates[player] =
        self._statusEffectState.applyRooted(statusState, now, duration, multiplier)
    self._lastPublishedRooted[player] = true
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    self:_notify(player, "ROOTED — MOVEMENT SLOWED")
    return true
end

function PlayerCombatService.applyDrowsy(
    self: PlayerCombatService,
    player: Player,
    duration: number,
    multiplier: number
): boolean
    local state = self._states[player]
    local statusState = self._statusStates[player]
    if state == nil or statusState == nil or not self._survivalService:canAct(player) then
        return false
    end
    local now = workspace:GetServerTimeNow()
    local nextState, _result =
        self._combatState.setSprint(state, false, now, true, self:_staminaRegenMultiplier(player))
    self._states[player] = nextState
    self._statusStates[player] =
        self._statusEffectState.applyDrowsy(statusState, now, duration, multiplier)
    self._lastPublishedDrowsy[player] = true
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    self:_notify(player, "DROWSY — MOVEMENT SLOWED")
    return true
end

function PlayerCombatService.applyShield(
    self: PlayerCombatService,
    player: Player,
    duration: number,
    multiplier: number
): boolean
    local statusState = self._statusStates[player]
    if statusState == nil or not self._survivalService:canAct(player) then
        return false
    end
    local now = workspace:GetServerTimeNow()
    self._statusStates[player] =
        self._statusEffectState.applyShield(statusState, now, duration, multiplier)
    self:_syncPlayer(player)
    return true
end

-- snapshot() reads the stored stamina as of the last periodic advance (up
-- to ~0.1s stale, see PlayerCombatService._step), while restoreStamina
-- advances fresh before mutating. A caller that gates on snapshot()'s
-- value and only later calls restoreStamina can see stamina go from
-- "not full" to "full" in that gap — this advances (without persisting)
-- so a precondition check sees exactly what restoreStamina is about to see.
function PlayerCombatService.peekStamina(self: PlayerCombatService, player: Player): number?
    local state = self._states[player]
    if state == nil then
        return nil
    end
    local now = workspace:GetServerTimeNow()
    local advanced = self._combatState.advance(
        state,
        now,
        self._survivalService:canAct(player),
        self:_staminaRegenMultiplier(player)
    )
    return self._combatState.snapshot(advanced, now).stamina
end

function PlayerCombatService.restoreStamina(
    self: PlayerCombatService,
    player: Player,
    amount: number
): any
    local state = self._states[player]
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    local now = workspace:GetServerTimeNow()
    local nextState, result = self._combatState.restoreStamina(
        state,
        now,
        amount,
        self._survivalService:canAct(player),
        self:_staminaRegenMultiplier(player)
    )
    self._states[player] = nextState
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    if result.applied then
        self:_notify(player, nil)
    end
    return result
end

-- Independent of ProfessionService.mitigateIncomingDamage (Warden's guard):
-- the two are checked separately at each damage call site so an item-granted
-- shield stacks with a profession's own mitigation instead of overriding it.
function PlayerCombatService.mitigateShieldedDamage(
    self: PlayerCombatService,
    player: Player,
    amount: number,
    now: number
): (number, boolean)
    local statusState = self._statusStates[player]
    if statusState == nil then
        return amount, false
    end
    local status = self._statusEffectState.snapshot(statusState, now)
    if not status.shielded then
        return amount, false
    end
    return math.max(1, math.ceil(amount * status.damageMultiplier)), true
end

function PlayerCombatService.setSprint(
    self: PlayerCombatService,
    player: Player,
    enabled: boolean
): any
    if not self._featureFlags:isEnabled("combat_mobility_enabled") then
        return {
            applied = false,
            reason = "combat_mobility_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    local now = workspace:GetServerTimeNow()
    local nextState, result = self._combatState.setSprint(
        state,
        enabled,
        now,
        self._survivalService:canAct(player),
        self:_staminaRegenMultiplier(player)
    )
    self._states[player] = nextState
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    self._analyticsService:combatAction(
        player,
        "sprint",
        result.applied,
        result.reason,
        result.stamina
    )
    if result.applied then
        self:_notify(player, nil)
    elseif enabled and result.reason == "insufficient_stamina" then
        self:_notify(player, "STAMINA LOW — RELEASE RUN TO RECOVER")
    end
    return result
end

function PlayerCombatService.dodge(self: PlayerCombatService, player: Player): any
    if not self._featureFlags:isEnabled("combat_mobility_enabled") then
        return {
            applied = false,
            reason = "combat_mobility_disabled",
        }
    end
    local state = self._states[player]
    local activeHumanoid = humanoid(player)
    local root = rootPart(player)
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    if activeHumanoid == nil or root == nil or activeHumanoid.Health <= 0 then
        return {
            applied = false,
            reason = "character_unavailable",
        }
    end

    local now = workspace:GetServerTimeNow()
    local nextState, result = self._combatState.dodge(
        state,
        now,
        self._survivalService:canAct(player),
        self:_staminaRegenMultiplier(player)
    )
    self._states[player] = nextState
    if result.applied then
        local direction = activeHumanoid.MoveDirection
        if direction.Magnitude < 0.1 then
            direction = root.CFrame.LookVector
        end
        direction = Vector3.new(direction.X, 0, direction.Z)
        if direction.Magnitude > 0.01 then
            direction = direction.Unit
            local velocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(
                direction.X * self._config.DodgeSpeed,
                velocity.Y,
                direction.Z * self._config.DodgeSpeed
            )
        end
    end
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    local reportResult = result.applied
        or now - (self._lastRejectionAt[player] or -math.huge) >= 0.75
    if reportResult then
        self._analyticsService:combatAction(
            player,
            "dodge",
            result.applied,
            result.reason,
            result.stamina
        )
    end
    if result.applied then
        self:_notify(player, nil)
    elseif reportResult then
        self._lastRejectionAt[player] = now
        if result.reason == "insufficient_stamina" then
            self:_notify(player, "STAMINA LOW — DODGE NEEDS 35")
        elseif result.reason == "dodge_cooldown" then
            self:_notify(player, "DODGE RECHARGING")
        end
    end
    return result
end

function PlayerCombatService.avoidsDamage(
    self: PlayerCombatService,
    player: Player,
    now: number
): boolean
    local state = self._states[player]
    return self._featureFlags:isEnabled("combat_mobility_enabled")
        and state ~= nil
        and self._combatState.avoidsDamage(state, now)
end

function PlayerCombatService.snapshot(self: PlayerCombatService, player: Player): any
    local now = workspace:GetServerTimeNow()
    local state = self._states[player]
    local snapshot = if state == nil
        then self._combatState.snapshot(self._combatState.create(now), now)
        else self._combatState.snapshot(state, now)
    local statusState = self._statusStates[player] or self._statusEffectState.create()
    local status = self._statusEffectState.snapshot(statusState, now)
    snapshot.enabled = self._featureFlags:isEnabled("combat_mobility_enabled")
    if not snapshot.enabled then
        snapshot.dodgeActive = false
    end
    snapshot.drowsy = status.drowsy
    snapshot.drowsyUntil = status.drowsyUntil
    snapshot.rooted = status.rooted
    snapshot.rootedUntil = status.rootedUntil
    snapshot.movementMultiplier = status.movementMultiplier
    snapshot.shielded = status.shielded
    snapshot.shieldUntil = status.shieldUntil
    return snapshot
end

return table.freeze(PlayerCombatService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">PlayerSurvivalService</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PlayerSurvivalService = {}
PlayerSurvivalService.__index = PlayerSurvivalService
PlayerSurvivalService.Name = "PlayerSurvivalService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type ReviveChannel = {
    target: Player,
    reviver: Player,
    flow: any,
    tuning: any,
}

type DownedVisual = {
    character: Model,
    highlight: Highlight,
    interactionId: string,
    label: TextLabel,
    prompt: ProximityPrompt,
}

export type PlayerSurvivalService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _runtimeIds: any,
        _reviveFlow: any,
        _survivalState: any,
        _featureFlags: any,
        _worldService: any,
        _analyticsService: any,
        _equipmentStatsProvider: ((Player) -> any)?,
        _reviveTuningProvider: ((Player) -> any)?,
        _expeditionFailureHandler: ((Player) -> any)?,
        _partyRecoveryProvider: ((number, number) -> any)?,
        _partyRecoveryPending: boolean,
        _states: { [Player]: any },
        _spawned: { [Player]: boolean },
        _channels: { [Player]: ReviveChannel },
        _prompts: { [string]: ProximityPrompt },
        _targets: { [string]: Player },
        _visuals: { [Player]: DownedVisual },
        _onChanged: ((Player?, string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
    },
    PlayerSurvivalService
))

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function humanoid(player: Player): Humanoid?
    local character = player.Character
    return if character == nil then nil else character:FindFirstChildOfClass("Humanoid")
end

local function playerLabel(player: Player): string
    return string.sub(player.DisplayName, 1, 20)
end

function PlayerSurvivalService.new(
    logger: Logger,
    config: any,
    runtimeIds: any,
    reviveFlow: any,
    survivalState: any,
    featureFlags: any,
    worldService: any,
    analyticsService: any
): PlayerSurvivalService
    return setmetatable({
        Name = PlayerSurvivalService.Name,
        _logger = logger,
        _config = config,
        _runtimeIds = runtimeIds,
        _reviveFlow = reviveFlow,
        _survivalState = survivalState,
        _featureFlags = featureFlags,
        _worldService = worldService,
        _analyticsService = analyticsService,
        _equipmentStatsProvider = nil,
        _reviveTuningProvider = nil,
        _expeditionFailureHandler = nil,
        _partyRecoveryProvider = nil,
        _partyRecoveryPending = false,
        _states = {},
        _spawned = {},
        _channels = {},
        _prompts = {},
        _targets = {},
        _visuals = {},
        _onChanged = nil,
        _heartbeat = nil,
    }, PlayerSurvivalService)
end

function PlayerSurvivalService.setEquipmentStatsProvider(
    self: PlayerSurvivalService,
    provider: (Player) -> any
)
    self._equipmentStatsProvider = provider
end

function PlayerSurvivalService.setReviveTuningProvider(
    self: PlayerSurvivalService,
    provider: (Player) -> any
)
    self._reviveTuningProvider = provider
end

function PlayerSurvivalService.setExpeditionFailureHandler(
    self: PlayerSurvivalService,
    handler: (Player) -> any
)
    self._expeditionFailureHandler = handler
end

function PlayerSurvivalService.setPartyRecoveryProvider(
    self: PlayerSurvivalService,
    provider: (number, number) -> any
)
    self._partyRecoveryProvider = provider
end

function PlayerSurvivalService._recordExpeditionFailure(
    self: PlayerSurvivalService,
    player: Player
): string?
    local handler = self._expeditionFailureHandler
    if handler == nil or player:GetAttribute("LastLightInExpedition") ~= true then
        return nil
    end
    local result = handler(player)
    return if type(result) == "table" and type(result.message) == "string"
        then result.message
        else nil
end

function PlayerSurvivalService._reviveTuning(self: PlayerSurvivalService, player: Player): any
    local provider = self._reviveTuningProvider
    if provider == nil then
        return {
            duration = self._config.ReviveChannelSeconds,
            health = self._config.ReviveHealth,
            professionId = nil,
            rescueTitle = "FIELD RESCUE",
            specialized = false,
            wardSeconds = self._config.ReviveInvulnerabilitySeconds,
        }
    end
    return provider(player)
end

function PlayerSurvivalService._equipmentDamage(
    self: PlayerSurvivalService,
    player: Player,
    amount: number
): (number, number)
    if amount ~= amount or amount <= 0 or amount >= math.huge or amount ~= math.floor(amount) then
        return amount, 0
    end
    local provider = self._equipmentStatsProvider
    if provider == nil then
        return amount, 0
    end
    local stats = provider(player)
    local reduction = math.clamp(
        if type(stats) == "table" and type(stats.damageReduction) == "number"
            then stats.damageReduction
            else 0,
        0,
        0.25
    )
    return math.max(1, math.ceil(amount * (1 - reduction))), reduction
end

function PlayerSurvivalService.Init(_self: PlayerSurvivalService, _context: any) end

function PlayerSurvivalService.setChangedHandler(
    self: PlayerSurvivalService,
    callback: (Player?, string?) -> ()
)
    self._onChanged = callback
end

function PlayerSurvivalService._notify(
    self: PlayerSurvivalService,
    player: Player?,
    message: string?
)
    local callback = self._onChanged
    if callback ~= nil then
        callback(player, message)
    end
end

function PlayerSurvivalService._syncPlayer(self: PlayerSurvivalService, player: Player)
    local state = self._states[player]
    if state == nil then
        return
    end
    local snapshot = self._survivalState.snapshot(state, workspace:GetServerTimeNow())
    player:SetAttribute("LastLightHealth", snapshot.health)
    player:SetAttribute("LastLightMaxHealth", snapshot.maxHealth)
    player:SetAttribute("LastLightDowned", snapshot.downed)
    player:SetAttribute("LastLightBleedoutAt", snapshot.bleedoutAt)
    local _, equipmentReduction = self:_equipmentDamage(player, 100)
    player:SetAttribute("LastLightEquipmentDamageReduction", equipmentReduction)

    local activeHumanoid = humanoid(player)
    if activeHumanoid ~= nil then
        activeHumanoid.MaxHealth = snapshot.maxHealth
        activeHumanoid.Health = math.max(1, snapshot.health)
        activeHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        activeHumanoid.WalkSpeed = if snapshot.downed
            then self._config.DownedWalkSpeed
            else self._config.BaseWalkSpeed
        activeHumanoid.JumpHeight = if snapshot.downed then 0 else self._config.BaseJumpHeight
        activeHumanoid.JumpPower = if snapshot.downed then 0 else self._config.BaseJumpPower
    end
end

function PlayerSurvivalService._clearVisual(self: PlayerSurvivalService, player: Player)
    player:SetAttribute("LastLightReviveEndsAt", nil)
    player:SetAttribute("LastLightReviverUserId", nil)
    player:SetAttribute("LastLightReviveProfessionId", nil)
    player:SetAttribute("LastLightReviveHealth", nil)
    player:SetAttribute("LastLightReviveWardSeconds", nil)
    local visual = self._visuals[player]
    if visual == nil then
        local character = player.Character
        if
            character ~= nil
            and CollectionService:HasTag(character, self._runtimeIds.PlayerDownedTag)
        then
            CollectionService:RemoveTag(character, self._runtimeIds.PlayerDownedTag)
        end
        return
    end
    self._prompts[visual.interactionId] = nil
    self._targets[visual.interactionId] = nil
    if visual.prompt.Parent ~= nil then
        visual.prompt:Destroy()
    end
    if visual.highlight.Parent ~= nil then
        visual.highlight:Destroy()
    end
    if CollectionService:HasTag(visual.character, self._runtimeIds.PlayerDownedTag) then
        CollectionService:RemoveTag(visual.character, self._runtimeIds.PlayerDownedTag)
    end
    self._visuals[player] = nil
end

function PlayerSurvivalService._createVisual(self: PlayerSurvivalService, player: Player)
    self:_clearVisual(player)
    local targetRoot = rootPart(player)
    local character = player.Character
    local state = self._states[player]
    if targetRoot == nil or character == nil or state == nil then
        return
    end

    local interactionId = string.format("revive:%d:%d", player.UserId, state.revision)
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = "LastLightRevivePrompt"
    prompt.ActionText = "REVIVE"
    prompt.ObjectText = playerLabel(player)
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = self._config.ReviveDistance
    prompt.RequiresLineOfSight = true
    prompt.Style = Enum.ProximityPromptStyle.Custom
    prompt:SetAttribute("ActionId", self._runtimeIds.Actions.Revive)
    prompt:SetAttribute("InteractionId", interactionId)
    prompt:SetAttribute("TargetUserId", player.UserId)
    prompt.Parent = targetRoot
    CollectionService:AddTag(prompt, self._runtimeIds.InteractionTag)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DownedMarker"
    billboard.Adornee = targetRoot
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 120
    billboard.Size = UDim2.fromOffset(210, 58)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 4.8, 0)
    billboard.Parent = prompt

    local label = Instance.new("TextLabel")
    label.Name = "DownedLabel"
    label.BackgroundColor3 = Color3.fromRGB(47, 20, 18)
    label.BackgroundTransparency = 0.08
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.TextColor3 = Color3.fromRGB(255, 230, 194)
    label.TextScaled = true
    label.TextStrokeTransparency = 0.72
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 181, 76)
    stroke.Thickness = 2
    stroke.Transparency = 0.12
    stroke.Parent = label

    local highlight = Instance.new("Highlight")
    highlight.Name = "DownedOutline"
    highlight.FillColor = Color3.fromRGB(165, 55, 47)
    highlight.FillTransparency = 0.72
    highlight.OutlineColor = Color3.fromRGB(255, 181, 76)
    highlight.OutlineTransparency = 0.08
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    CollectionService:AddTag(character, self._runtimeIds.PlayerDownedTag)

    self._prompts[interactionId] = prompt
    self._targets[interactionId] = player
    self._visuals[player] = {
        character = character,
        highlight = highlight,
        interactionId = interactionId,
        label = label,
        prompt = prompt,
    }
end

function PlayerSurvivalService._updateVisual(
    self: PlayerSurvivalService,
    player: Player,
    now: number
)
    local visual = self._visuals[player]
    local state = self._states[player]
    if visual == nil or state == nil then
        return
    end
    local snapshot = self._survivalState.snapshot(state, now)
    visual.label.Text = string.format(
        "✚ %s DOWN\n%02ds · REVIVE",
        string.upper(playerLabel(player)),
        snapshot.timeRemaining
    )
end

function PlayerSurvivalService._bindPlayer(self: PlayerSurvivalService, player: Player)
    if self._states[player] ~= nil then
        return
    end
    self._states[player] = self._survivalState.create(workspace:GetServerTimeNow())

    local function characterAdded(character: Model)
        local now = workspace:GetServerTimeNow()
        local previousState = self._states[player]
        local returningCharacter = self._spawned[player] == true
        self._spawned[player] = true
        local resetFromDowned = previousState ~= nil and previousState.status == "downed"
        self:_cancelChannel(player, "target_character_reset")
        for target, channel in self._channels do
            if channel.reviver == player then
                self:_cancelChannel(target, "reviver_character_reset")
            end
        end
        self:_clearVisual(player)
        if returningCharacter then
            self._states[player] = self._survivalState.respawn(previousState, now)
        elseif resetFromDowned then
            self._states[player] = self._survivalState.safeRetreat(previousState, now)
        else
            self._states[player] = self._survivalState.create(now)
        end
        task.spawn(function()
            local activeHumanoid = character:WaitForChild("Humanoid", 8)
            if
                activeHumanoid ~= nil
                and activeHumanoid:IsA("Humanoid")
                and player.Parent ~= nil
            then
                activeHumanoid.BreakJointsOnDeath = false
                self:_syncPlayer(player)
                if returningCharacter or resetFromDowned then
                    local retreatMessage = nil
                    if player:GetAttribute("LastLightInExpedition") == true then
                        retreatMessage = self:_recordExpeditionFailure(player)
                        self._worldService:exitBramblewake(player)
                    end
                    self._analyticsService:playerRecovered(
                        player,
                        if resetFromDowned
                            then "character_reset_safe_retreat"
                            else "character_respawn_safe_retreat"
                    )
                    self:_notify(player, retreatMessage or "SAFE RETREAT — CHARACTER RESET")
                end
                self:_notify(nil, nil)
            end
        end)
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character ~= nil then
        characterAdded(player.Character)
    else
        self:_syncPlayer(player)
    end
end

function PlayerSurvivalService.Start(self: PlayerSurvivalService)
    Players.PlayerAdded:Connect(function(player: Player)
        self:_bindPlayer(player)
    end)
    Players.PlayerRemoving:Connect(function(player: Player)
        self:_cancelChannel(player, "target_left")
        self:_clearVisual(player)
        self._states[player] = nil
        self._spawned[player] = nil
        for target, channel in self._channels do
            if channel.reviver == player then
                self:_cancelChannel(target, "reviver_left")
            end
        end
        task.defer(function()
            self:_attemptPartyRecovery()
        end)
    end)
    for _, player in Players:GetPlayers() do
        self:_bindPlayer(player)
    end

    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.1 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
end

function PlayerSurvivalService.canAct(self: PlayerSurvivalService, player: Player): boolean
    local state = self._states[player]
    return state ~= nil and self._survivalState.canAct(state)
end

function PlayerSurvivalService.damage(
    self: PlayerSurvivalService,
    player: Player,
    amount: number,
    source: string
): any
    if not self._featureFlags:isEnabled("player_survival_enabled") then
        return {
            applied = false,
            reason = "survival_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    local now = workspace:GetServerTimeNow()
    local mitigatedAmount, equipmentReduction = self:_equipmentDamage(player, amount)
    local nextState, result = self._survivalState.damage(state, mitigatedAmount, now)
    if not result.applied then
        return result
    end

    self._states[player] = nextState
    result.rawDamage = amount
    result.equipmentReduction = equipmentReduction
    self:_syncPlayer(player)
    if result.downed then
        self:_createVisual(player)
        self._analyticsService:playerDowned(player, string.sub(source, 1, 48))
        self:_notify(player, "DOWNED — CRAWL TOWARD LIGHT")
        self:_attemptPartyRecovery()
    else
        self:_notify(nil, nil)
    end
    return result
end

function PlayerSurvivalService._attemptPartyRecovery(self: PlayerSurvivalService)
    local provider = self._partyRecoveryProvider
    if provider == nil or self._partyRecoveryPending then
        return
    end

    local eligible: { Player } = {}
    local downed = 0
    for player, state in self._states do
        if
            player.Parent ~= nil
            and player:GetAttribute("LastLightTutorialSurvivalReady") == true
            and player:GetAttribute("LastLightInExpedition") ~= true
        then
            table.insert(eligible, player)
            if state.status == "downed" then
                downed += 1
            end
        end
    end
    if #eligible < 1 or downed ~= #eligible then
        return
    end

    self._partyRecoveryPending = true
    local result = provider(#eligible, downed)
    if type(result) ~= "table" or result.accepted ~= true then
        self._partyRecoveryPending = false
        return
    end

    local channelTargets: { Player } = {}
    for target in self._channels do
        table.insert(channelTargets, target)
    end
    for _, target in channelTargets do
        self:_cancelChannel(target, "town_guard_last_stand")
    end
    local now = workspace:GetServerTimeNow()
    local recovered = {}
    for _, player in eligible do
        local state = self._states[player]
        if state ~= nil and state.status == "downed" then
            local nextState, recovery = self._survivalState.revive(state, now, {
                health = result.recoveryHealth,
                wardSeconds = result.recoveryWardSeconds,
            })
            if recovery.applied then
                self._states[player] = nextState
                self:_clearVisual(player)
                self:_syncPlayer(player)
                player:SetAttribute("LastLightGuardRecoveryNight", result.nightNumber)
                table.insert(recovered, player)
                self._analyticsService:playerRecovered(player, "town_guard_last_stand")
            end
        end
    end
    self._worldService:showTownGuardRecovery(recovered, result)
    self:_notify(
        nil,
        string.format(
            "THE NIGHT WATCH ANSWERS — %d TRAVELER%s RALLIED · LANTERN -%d",
            #recovered,
            if #recovered == 1 then "" else "S",
            result.lanternSpent or result.lanternCost or 0
        )
    )
    self._partyRecoveryPending = false
end

function PlayerSurvivalService.canHealInRadius(
    self: PlayerSurvivalService,
    source: Player,
    radius: number
): (boolean, string)
    if not self:canAct(source) then
        return false, "YOU CANNOT HEAL WHILE DOWNED"
    end
    local sourceRoot = rootPart(source)
    if sourceRoot == nil then
        return false, "YOUR CHARACTER IS STILL LOADING"
    end
    for player, state in self._states do
        local targetRoot = rootPart(player)
        if
            state.status == "active"
            and state.health < state.maxHealth
            and targetRoot ~= nil
            and (sourceRoot.Position - targetRoot.Position).Magnitude <= radius
        then
            return true, "GUIDING PULSE READY"
        end
    end
    return false, "NO INJURED TRAVELER IS WITHIN THE PULSE"
end

function PlayerSurvivalService.healInRadius(
    self: PlayerSurvivalService,
    source: Player,
    amount: number,
    radius: number
): any
    local canHeal, reason = self:canHealInRadius(source, radius)
    if not canHeal then
        return {
            affected = 0,
            healed = 0,
            reason = reason,
        }
    end

    local sourceRoot = assert(rootPart(source), "healing source root disappeared")
    local affected = 0
    local totalHealed = 0
    for player, state in self._states do
        local targetRoot = rootPart(player)
        if
            targetRoot ~= nil
            and (sourceRoot.Position - targetRoot.Position).Magnitude <= radius
        then
            local nextState, result = self._survivalState.heal(state, amount)
            if result.applied then
                self._states[player] = nextState
                affected += 1
                totalHealed += result.healed or 0
                self:_syncPlayer(player)
            end
        end
    end
    self:_notify(nil, nil)
    return {
        affected = affected,
        healed = totalHealed,
        reason = "healed",
    }
end

function PlayerSurvivalService.interaction(
    self: PlayerSurvivalService,
    interactionId: string
): ProximityPrompt?
    return self._prompts[interactionId]
end

function PlayerSurvivalService._canReach(
    self: PlayerSurvivalService,
    reviver: Player,
    target: Player
): boolean
    local reviverRoot = rootPart(reviver)
    local targetRoot = rootPart(target)
    local reviverCharacter = reviver.Character
    local targetCharacter = target.Character
    if
        reviverRoot == nil
        or targetRoot == nil
        or reviverCharacter == nil
        or targetCharacter == nil
        or (reviverRoot.Position - targetRoot.Position).Magnitude > self._config.ReviveDistance
    then
        return false
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { reviverCharacter }
    local result =
        workspace:Raycast(reviverRoot.Position, targetRoot.Position - reviverRoot.Position, params)
    return result == nil or result.Instance:IsDescendantOf(targetCharacter)
end

function PlayerSurvivalService.beginRevive(
    self: PlayerSurvivalService,
    reviver: Player,
    interactionId: string
): any
    local target = self._targets[interactionId]
    local prompt = self._prompts[interactionId]
    if target == nil or prompt == nil or not prompt.Enabled then
        return {
            accepted = false,
            message = "THAT RESCUE MARK IS NO LONGER ACTIVE",
            reason = "unknown_revive",
        }
    end
    if target == reviver then
        return {
            accepted = false,
            message = "AN ALLY MUST COMPLETE THE REVIVE",
            reason = "self_revive",
        }
    end
    if not self:canAct(reviver) then
        return {
            accepted = false,
            message = "YOU CANNOT REVIVE WHILE DOWNED",
            reason = "reviver_downed",
        }
    end
    local targetState = self._states[target]
    if targetState == nil or targetState.status ~= "downed" then
        return {
            accepted = false,
            message = "THAT ALLY IS ALREADY SAFE",
            reason = "target_not_downed",
        }
    end
    if not self:_canReach(reviver, target) then
        return {
            accepted = false,
            message = "MOVE CLOSER WITH A CLEAR PATH",
            reason = "revive_out_of_range",
        }
    end

    local existing = self._channels[target]
    if existing ~= nil then
        return {
            accepted = existing.reviver == reviver,
            message = if existing.reviver == reviver
                then "REVIVE IN PROGRESS — STAY CLOSE"
                else "ANOTHER ALLY IS REVIVING THEM",
            reason = "revive_in_progress",
        }
    end

    local reviverState = assert(self._states[reviver], "reviver survival state is missing")
    local now = workspace:GetServerTimeNow()
    local tuning = self:_reviveTuning(reviver)
    local channel = {
        target = target,
        reviver = reviver,
        tuning = tuning,
        flow = self._reviveFlow.create(
            target.UserId,
            reviver.UserId,
            reviverState.revision,
            now,
            tuning.duration
        ),
    }
    self._channels[target] = channel
    prompt.ActionText = if tuning.specialized then tuning.rescueTitle else "REVIVING"
    target:SetAttribute("LastLightReviveEndsAt", channel.flow.endsAt)
    target:SetAttribute("LastLightReviverUserId", reviver.UserId)
    target:SetAttribute("LastLightReviveProfessionId", tuning.professionId)
    target:SetAttribute("LastLightReviveHealth", tuning.health)
    target:SetAttribute("LastLightReviveWardSeconds", tuning.wardSeconds)
    self:_notify(nil, nil)
    return {
        accepted = true,
        message = string.format(
            "%s — %s — STAY CLOSE",
            tuning.rescueTitle,
            string.upper(playerLabel(target))
        ),
        reason = "revive_started",
    }
end

function PlayerSurvivalService._cancelChannel(
    self: PlayerSurvivalService,
    target: Player,
    reason: string
)
    local channel = self._channels[target]
    if channel == nil then
        return
    end
    self._channels[target] = nil
    target:SetAttribute("LastLightReviveEndsAt", nil)
    target:SetAttribute("LastLightReviverUserId", nil)
    target:SetAttribute("LastLightReviveProfessionId", nil)
    target:SetAttribute("LastLightReviveHealth", nil)
    target:SetAttribute("LastLightReviveWardSeconds", nil)
    local visual = self._visuals[target]
    if visual ~= nil then
        visual.prompt.ActionText = "REVIVE"
    end
    self._logger:info("player_revive_cancelled", {
        reason = reason,
        reviver = channel.reviver.UserId,
        target = target.UserId,
    })
    self:_notify(channel.reviver, "REVIVE INTERRUPTED")
end

function PlayerSurvivalService._completeRevive(
    self: PlayerSurvivalService,
    target: Player,
    channel: ReviveChannel,
    now: number
)
    local state = self._states[target]
    if state == nil then
        self:_cancelChannel(target, "target_left")
        return
    end
    local nextState, result = self._survivalState.revive(state, now, {
        health = channel.tuning.health,
        wardSeconds = channel.tuning.wardSeconds,
    })
    if not result.applied then
        self:_cancelChannel(target, result.reason)
        return
    end

    self._channels[target] = nil
    self._states[target] = nextState
    self:_clearVisual(target)
    self:_syncPlayer(target)
    self._analyticsService:playerRevived(
        target,
        channel.reviver,
        math.max(0, now - channel.flow.startedAt)
    )
    self:_notify(
        target,
        string.format(
            "BACK ON YOUR FEET — %d HEALTH · %.1fs LIGHT WARD",
            result.health,
            channel.tuning.wardSeconds
        )
    )
    self:_notify(channel.reviver, channel.tuning.rescueTitle .. " COMPLETE")
end

function PlayerSurvivalService._recover(self: PlayerSurvivalService, player: Player, now: number)
    local state = self._states[player]
    if state == nil then
        return
    end
    local nextState, result = self._survivalState.recover(state, now)
    if not result.applied then
        return
    end

    self._channels[player] = nil
    self._states[player] = nextState
    self:_clearVisual(player)
    self:_syncPlayer(player)
    local retreatMessage = nil
    if player:GetAttribute("LastLightInExpedition") == true then
        retreatMessage = self:_recordExpeditionFailure(player)
        self._worldService:exitBramblewake(player)
    else
        local character = player.Character
        if character ~= nil then
            character:PivotTo(self._worldService:spawnCFrame())
        end
    end
    self._analyticsService:playerRecovered(player, "bleedout_safe_retreat")
    self:_notify(player, retreatMessage or "SAFE RETREAT — UNBANKED POUCH RETAINED")
end

function PlayerSurvivalService._step(self: PlayerSurvivalService, now: number)
    for player, state in self._states do
        local activeHumanoid = humanoid(player)
        if activeHumanoid ~= nil then
            local expectedHealth = math.max(1, state.health)
            if activeHumanoid.Health ~= expectedHealth then
                activeHumanoid.Health = expectedHealth
            end
        end
        if state.status == "downed" then
            self:_updateVisual(player, now)
            if type(state.bleedoutAt) == "number" and now >= state.bleedoutAt then
                self:_recover(player, now)
            end
        end
    end

    for target, channel in self._channels do
        local reviverState = self._states[channel.reviver]
        local targetState = self._states[target]
        local decision = self._reviveFlow.evaluate(channel.flow, now, {
            reachable = reviverState ~= nil
                and targetState ~= nil
                and self:_canReach(channel.reviver, target),
            reviverCanAct = reviverState ~= nil and self._survivalState.canAct(reviverState),
            reviverPresent = channel.reviver.Parent ~= nil and reviverState ~= nil,
            reviverRevision = if reviverState == nil then -1 else reviverState.revision,
            targetDowned = targetState ~= nil and targetState.status == "downed",
            targetPresent = target.Parent ~= nil and targetState ~= nil,
        })
        if decision.status == "cancel" then
            self:_cancelChannel(target, decision.reason)
        elseif decision.status == "complete" then
            self:_completeRevive(target, channel, now)
        end
    end
end

local function directionLabel(viewerRoot: BasePart, targetRoot: BasePart): string
    local offset = targetRoot.Position - viewerRoot.Position
    if offset.Magnitude < 0.01 then
        return "HERE"
    end
    local direction = offset.Unit
    local forward = viewerRoot.CFrame.LookVector:Dot(direction)
    local right = viewerRoot.CFrame.RightVector:Dot(direction)
    if math.abs(forward) >= math.abs(right) then
        return if forward >= 0 then "AHEAD" else "BEHIND"
    end
    return if right >= 0 then "RIGHT" else "LEFT"
end

function PlayerSurvivalService.snapshot(self: PlayerSurvivalService, viewer: Player): any
    local now = workspace:GetServerTimeNow()
    local state = self._states[viewer]
    local selfSnapshot = if state == nil
        then self._survivalState.snapshot(self._survivalState.create(now), now)
        else self._survivalState.snapshot(state, now)
    local viewerRoot = rootPart(viewer)

    local downedCount = 0
    local priorityAlly = nil
    local priorityTime = math.huge
    local priorityDistance = math.huge
    for player, candidateState in self._states do
        if player ~= viewer and candidateState.status == "downed" then
            downedCount += 1
            local candidateRoot = rootPart(player)
            local timeRemaining = self._survivalState.snapshot(candidateState, now).timeRemaining
            local distance = if viewerRoot == nil or candidateRoot == nil
                then math.huge
                else (viewerRoot.Position - candidateRoot.Position).Magnitude
            if
                timeRemaining < priorityTime
                or (timeRemaining == priorityTime and distance < priorityDistance)
            then
                priorityAlly = player
                priorityTime = timeRemaining
                priorityDistance = distance
            end
        end
    end

    local ally = nil
    if priorityAlly ~= nil then
        local allyState = self._states[priorityAlly]
        local allyRoot = rootPart(priorityAlly)
        local channel = self._channels[priorityAlly]
        ally = {
            bleedoutAt = allyState.bleedoutAt,
            direction = if viewerRoot == nil or allyRoot == nil
                then "UNKNOWN"
                else directionLabel(viewerRoot, allyRoot),
            distance = if priorityDistance == math.huge
                then nil
                else math.floor(priorityDistance + 0.5),
            displayName = playerLabel(priorityAlly),
            inReviveRange = priorityDistance <= self._config.ReviveDistance,
            reviveEndsAt = if channel == nil then nil else channel.flow.endsAt,
            userId = priorityAlly.UserId,
        }
    end

    local nearestActive = nil
    local nearestActiveDistance = math.huge
    if selfSnapshot.downed and viewerRoot ~= nil then
        for player, candidateState in self._states do
            if player ~= viewer and self._survivalState.canAct(candidateState) then
                local candidateRoot = rootPart(player)
                if candidateRoot ~= nil then
                    local distance = (viewerRoot.Position - candidateRoot.Position).Magnitude
                    if distance < nearestActiveDistance then
                        nearestActive = player
                        nearestActiveDistance = distance
                    end
                end
            end
        end
    end

    local nearestAlly = nil
    if nearestActive ~= nil then
        local nearestRoot = rootPart(nearestActive)
        nearestAlly = {
            direction = if nearestRoot == nil
                then "UNKNOWN"
                else directionLabel(viewerRoot :: BasePart, nearestRoot),
            distance = math.floor(nearestActiveDistance + 0.5),
            displayName = playerLabel(nearestActive),
        }
    end

    selfSnapshot.nearestAlly = nearestAlly
    selfSnapshot.reviveEndsAt = viewer:GetAttribute("LastLightReviveEndsAt")
    return {
        ally = ally,
        downedCount = downedCount,
        enabled = self._featureFlags:isEnabled("player_survival_enabled"),
        self = selfSnapshot,
    }
end

return table.freeze(PlayerSurvivalService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">ProfessionService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local ProfessionService = {}
ProfessionService.__index = ProfessionService
ProfessionService.Name = "ProfessionService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type ProfessionService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _catalog: any,
        _professionState: any,
        _professionMastery: any,
        _professionRescue: any,
        _featureFlags: any,
        _profileService: any,
        _worldService: any,
        _survivalService: any,
        _analyticsService: any,
        _states: { [Player]: any },
        _enemyService: any,
        _switchProvider: ((Player) -> (boolean, string?))?,
        _onChanged: ((Player, string?) -> ())?,
    },
    ProfessionService
))

function ProfessionService.new(
    logger: Logger,
    catalog: any,
    professionState: any,
    professionMastery: any,
    professionRescue: any,
    featureFlags: any,
    profileService: any,
    worldService: any,
    survivalService: any,
    analyticsService: any
): ProfessionService
    return setmetatable({
        Name = ProfessionService.Name,
        _logger = logger,
        _catalog = catalog,
        _professionState = professionState,
        _professionMastery = professionMastery,
        _professionRescue = professionRescue,
        _featureFlags = featureFlags,
        _profileService = profileService,
        _worldService = worldService,
        _survivalService = survivalService,
        _analyticsService = analyticsService,
        _states = {},
        _enemyService = nil,
        _switchProvider = nil,
        _onChanged = nil,
    }, ProfessionService)
end

function ProfessionService.Init(self: ProfessionService, _context: any)
    self._profileService:onLoaded(function(player: Player, profile: any)
        self:_profileLoaded(player, profile)
    end)
end

function ProfessionService.Start(self: ProfessionService)
    Players.PlayerRemoving:Connect(function(player: Player)
        self._states[player] = nil
    end)

    for _, player in Players:GetPlayers() do
        local profile = self._profileService:get(player)
        if profile ~= nil then
            self:_profileLoaded(player, profile)
        end
    end
end

function ProfessionService.setEnemyService(self: ProfessionService, enemyService: any)
    self._enemyService = enemyService
end

function ProfessionService.setSwitchProvider(
    self: ProfessionService,
    provider: (Player) -> (boolean, string?)
)
    self._switchProvider = provider
end

function ProfessionService.setChangedHandler(
    self: ProfessionService,
    callback: (Player, string?) -> ()
)
    self._onChanged = callback
end

function ProfessionService._notify(self: ProfessionService, player: Player, message: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(player, message)
    end
end

function ProfessionService._syncPlayer(self: ProfessionService, player: Player)
    local state = self._states[player]
    if state == nil then
        return
    end
    local snapshot = self._professionState.snapshot(state, workspace:GetServerTimeNow())
    player:SetAttribute("LastLightProfessionId", snapshot.selectedId)
    player:SetAttribute("LastLightProfessionReadyAt", snapshot.cooldownReadyAt)
    player:SetAttribute("LastLightProfessionActiveUntil", snapshot.activeUntil)
end

function ProfessionService._profileLoaded(self: ProfessionService, player: Player, profile: any)
    if self._states[player] ~= nil then
        return
    end
    local selectedId = if type(profile.profession) == "table"
        then profile.profession.selectedId
        else nil
    self._states[player] = self._professionState.create(selectedId, workspace:GetServerTimeNow())
    self:_syncPlayer(player)
end

function ProfessionService._switchAvailability(
    self: ProfessionService,
    player: Player
): (boolean, string?)
    if not self._survivalService:canAct(player) then
        return false, "YOU CANNOT SWITCH PROFESSION WHILE DOWNED"
    end
    local provider = self._switchProvider
    if provider == nil then
        return false, "PROFESSION SWITCHING IS STILL LOADING"
    end
    return provider(player)
end

function ProfessionService.select(
    self: ProfessionService,
    player: Player,
    professionId: string
): any
    if not self._featureFlags:isEnabled("profession_kits_enabled") then
        return {
            accepted = false,
            message = "PROFESSIONS ARE TEMPORARILY UNAVAILABLE",
            reason = "feature_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            accepted = false,
            message = "YOUR PROFESSION LOADOUT IS STILL LOADING",
            reason = "player_loading",
        }
    end

    local canSwitch, unavailableMessage = self:_switchAvailability(player)
    local now = workspace:GetServerTimeNow()
    local nextState, result = self._professionState.select(state, professionId, now, canSwitch)
    if not result.accepted then
        local message = unavailableMessage
        if result.reason == "unknown_profession" then
            message = "THAT PROFESSION DOES NOT EXIST"
        end
        self._analyticsService:professionSelected(player, professionId, false, result.reason)
        return {
            accepted = false,
            message = message or "PROFESSION SWITCHING IS UNAVAILABLE",
            reason = result.reason,
        }
    end

    self._states[player] = nextState
    self:_syncPlayer(player)
    local definition = self._catalog.get(professionId)
    if result.changed then
        self._profileService:setProfession(player, professionId)
        self._analyticsService:professionSelected(player, professionId, true, nil)
        self._logger:info("profession_selected", {
            player = player.UserId,
            profession = professionId,
        })
    end
    local message = if result.changed
        then string.format("%s READY — %s", definition.displayName, definition.abilityName)
        else string.format("%s IS ALREADY EQUIPPED", definition.displayName)
    self:_notify(player, message)
    return {
        accepted = true,
        changed = result.changed,
        message = message,
        reason = result.reason,
    }
end

function ProfessionService.selectSpecialization(
    self: ProfessionService,
    player: Player,
    specializationId: string
): any
    local professionId = self._professionMastery.specializationProfession(specializationId)
    local analyticsProfessionId = professionId or "unknown_profession"
    local function reject(message: string, reason: string): any
        self._analyticsService:professionSpecializationSelected(
            player,
            analyticsProfessionId,
            specializationId,
            false,
            reason
        )
        return {
            accepted = false,
            message = message,
            reason = reason,
        }
    end

    if not self._featureFlags:isEnabled("profession_kits_enabled") then
        return reject("PROFESSIONS ARE TEMPORARILY UNAVAILABLE", "feature_disabled")
    end
    local state = self._states[player]
    if state == nil then
        return reject("YOUR PROFESSION MASTERY IS STILL LOADING", "player_loading")
    end
    local snapshot = self._professionState.snapshot(state, workspace:GetServerTimeNow())
    if professionId == nil then
        return reject("THAT MASTERY PATH DOES NOT EXIST", "invalid_specialization")
    end
    if snapshot.selectedId ~= professionId then
        return reject(
            "EQUIP THE MATCHING PROFESSION BEFORE CHOOSING THIS PATH",
            "profession_mismatch"
        )
    end
    local canSwitch, unavailableMessage = self:_switchAvailability(player)
    if not canSwitch then
        return reject(
            unavailableMessage or "MASTERY PATHS CAN ONLY CHANGE IN SAFE DAYLIGHT",
            "switch_unavailable"
        )
    end
    local result =
        self._profileService:selectProfessionSpecialization(player, professionId, specializationId)
    local definition = self._professionMastery.specializationDefinition(specializationId)
    if not result.applied then
        local message = if result.duplicate
            then string.format("%s IS ALREADY YOUR MASTERY PATH", definition.name)
            elseif result.reason == "specialization_locked" then "REACH MASTERY RANK 10 FIRST"
            elseif
                result.reason == "profile_unavailable"
            then "YOUR PROFILE IS STILL LOADING OR READ-ONLY — TRY AGAIN"
            else "THAT MASTERY PATH CANNOT BE CHOSEN"
        local accepted = result.duplicate == true
        self._analyticsService:professionSpecializationSelected(
            player,
            professionId,
            specializationId,
            accepted,
            result.reason
        )
        return {
            accepted = accepted,
            changed = false,
            message = message,
            reason = result.reason,
        }
    end
    self._analyticsService:professionSpecializationSelected(
        player,
        professionId,
        specializationId,
        true,
        nil
    )
    self._logger:info("profession_specialization_selected", {
        player = player.UserId,
        profession = professionId,
        specialization = specializationId,
    })
    local message = string.format("%s PATH CHOSEN — %s", definition.name, definition.description)
    self:_notify(player, message)
    return {
        accepted = true,
        changed = true,
        message = message,
        reason = "selected",
    }
end

function ProfessionService._abilityPreflight(
    self: ProfessionService,
    player: Player,
    definition: any,
    tuning: any
): (boolean, string)
    local effectRadius = definition.effectRadius + tuning.effectRadiusBonus
    local enemyService = self._enemyService
    if definition.id == self._catalog.Ids.Scout then
        if enemyService == nil then
            return false, "THREAT TRACKING IS STILL LOADING"
        end
        return enemyService:canMarkNearest(player, effectRadius)
    elseif definition.id == self._catalog.Ids.Warden then
        if enemyService == nil or not enemyService:combatActive() then
            return false, "LANTERN GUARD NEEDS AN ACTIVE THREAT"
        end
        return true, "LANTERN GUARD READY"
    elseif definition.id == self._catalog.Ids.Engineer then
        if enemyService == nil then
            return false, "LANTERN REPAIRS ARE STILL LOADING"
        end
        return enemyService:canRepairLantern(player, effectRadius)
    elseif definition.id == self._catalog.Ids.Medic then
        return self._survivalService:canHealInRadius(player, effectRadius)
    end
    return true, "LANTERN GUARD READY"
end

function ProfessionService._applyAbility(
    self: ProfessionService,
    player: Player,
    definition: any,
    tuning: any
): (string, number)
    local effectAmount = definition.effectAmount + tuning.effectAmountBonus
    local effectRadius = definition.effectRadius + tuning.effectRadiusBonus
    local activeSeconds = if definition.id == self._catalog.Ids.Scout
            or definition.id == self._catalog.Ids.Warden
        then definition.activeSeconds + tuning.activeSecondsBonus
        else definition.activeSeconds
    if definition.id == self._catalog.Ids.Scout then
        local _, message = self._enemyService:markNearest(player, effectRadius, activeSeconds)
        return message, 1
    elseif definition.id == self._catalog.Ids.Warden then
        return "LANTERN GUARD ACTIVE — ENEMY DAMAGE REDUCED", 1
    elseif definition.id == self._catalog.Ids.Engineer then
        local _, message = self._enemyService:repairLantern(player, effectRadius, effectAmount)
        return message, 1
    end

    local healResult = self._survivalService:healInRadius(player, effectAmount, effectRadius)
    return string.format(
        "GUIDING PULSE — %d TRAVELER%s RESTORED",
        healResult.affected,
        if healResult.affected == 1 then "" else "S"
    ),
        healResult.affected
end

function ProfessionService.useAbility(self: ProfessionService, player: Player): any
    if not self._featureFlags:isEnabled("profession_kits_enabled") then
        return {
            accepted = false,
            message = "PROFESSION ABILITIES ARE TEMPORARILY UNAVAILABLE",
            reason = "feature_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            accepted = false,
            message = "YOUR PROFESSION LOADOUT IS STILL LOADING",
            reason = "player_loading",
        }
    end

    local now = workspace:GetServerTimeNow()
    local decision = self._professionState.canUse(state, now, self._survivalService:canAct(player))
    if not decision.accepted then
        local message = if decision.reason == "profession_required"
            then "CHOOSE A PROFESSION IN EMBERHOLLOW"
            elseif decision.reason == "cooldown" then string.format(
                "ABILITY RECHARGING — %.1fs",
                decision.remaining or 0
            )
            else "YOU CANNOT USE AN ABILITY RIGHT NOW"
        self._analyticsService:professionAbility(
            player,
            state.selectedId or "none",
            false,
            decision.reason,
            0
        )
        return {
            accepted = false,
            message = message,
            reason = decision.reason,
        }
    end

    local definition = decision.definition
    local masteryState = self._profileService:masterySnapshot(player)
    local tuning = self._professionMastery.tuning(masteryState, definition.id)
    local validTarget, preflightMessage = self:_abilityPreflight(player, definition, tuning)
    if not validTarget then
        self._analyticsService:professionAbility(player, definition.id, false, "invalid_target", 0)
        return {
            accepted = false,
            message = preflightMessage,
            reason = "invalid_target",
        }
    end

    local cooldownSeconds = math.max(1, definition.cooldownSeconds - tuning.cooldownReduction)
    local activeSeconds = if definition.id == self._catalog.Ids.Scout
            or definition.id == self._catalog.Ids.Warden
        then definition.activeSeconds + tuning.activeSecondsBonus
        else definition.activeSeconds
    local nextState =
        self._professionState.commitAbility(state, now, cooldownSeconds, activeSeconds)
    self._states[player] = nextState
    self:_syncPlayer(player)
    local message, affected = self:_applyAbility(player, definition, tuning)
    self._worldService:showProfessionAbility(
        player,
        definition.id,
        definition.effectRadius + tuning.effectRadiusBonus,
        activeSeconds
    )
    local masteryResult = self._profileService:awardMastery(player, definition.id, 10)
    if masteryResult.leveledUp then
        message = string.format(
            "%s · %s RANK %d — %s",
            message,
            definition.displayName,
            masteryResult.level,
            masteryResult.rankName
        )
        if masteryResult.specializationUnlocked then
            message ..= " · SPECIALIZATIONS UNLOCKED"
        end
        self._analyticsService:professionMasteryRank(
            player,
            definition.id,
            masteryResult.level,
            masteryResult.rankName
        )
    end
    self._analyticsService:professionAbility(player, definition.id, true, nil, affected)
    self:_notify(player, message)
    return {
        accepted = true,
        affected = affected,
        message = message,
        reason = "used",
    }
end

function ProfessionService.mitigateIncomingDamage(
    self: ProfessionService,
    player: Player,
    amount: number,
    now: number
): (number, boolean)
    local state = self._states[player]
    if state == nil or not self._professionState.mitigatesDamage(state, now) then
        return amount, false
    end
    local masteryState = self._profileService:masterySnapshot(player)
    local tuning = self._professionMastery.tuning(masteryState, self._catalog.Ids.Warden)
    local definition = self._catalog.get(self._catalog.Ids.Warden)
    local damageReduction =
        math.clamp((definition.effectAmount + tuning.effectAmountBonus) / 100, 0, 0.8)
    return math.max(1, math.ceil(amount * (1 - damageReduction))), true
end

function ProfessionService.rescueTuning(
    self: ProfessionService,
    player: Player,
    baseDuration: number,
    baseHealth: number,
    baseWardSeconds: number
): any
    local state = self._states[player]
    local now = workspace:GetServerTimeNow()
    local profession = if state == nil
        then self._professionState.snapshot(self._professionState.create(nil, now), now)
        else self._professionState.snapshot(state, now)
    local mastery = self._professionMastery.tuning(
        self._profileService:masterySnapshot(player),
        profession.selectedId
    )
    return self._professionRescue.resolve(
        profession.selectedId,
        mastery.level,
        baseDuration,
        baseHealth,
        baseWardSeconds,
        mastery
    )
end

function ProfessionService.snapshot(self: ProfessionService, player: Player): any
    local now = workspace:GetServerTimeNow()
    local state = self._states[player]
    local snapshot = if state == nil
        then self._professionState.snapshot(self._professionState.create(nil, now), now)
        else self._professionState.snapshot(state, now)
    local switchable, unavailableMessage = self:_switchAvailability(player)
    snapshot.enabled = self._featureFlags:isEnabled("profession_kits_enabled")
    snapshot.switchable = switchable
    snapshot.switchUnavailableMessage = unavailableMessage
    snapshot.mastery = self._professionMastery.tuning(
        self._profileService:masterySnapshot(player),
        snapshot.selectedId
    )
    return snapshot
end

return table.freeze(ProfessionService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">ProfileService</string>
            <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local ProfileService = {}
ProfileService.__index = ProfileService
ProfileService.Name = "ProfileService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type ProfileService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _persistent: boolean,
        _profiles: { [Player]: any },
        _writable: { [Player]: boolean },
        _dirty: { [Player]: boolean },
        _saving: { [Player]: boolean },
        _loading: { [Player]: boolean },
        _loadedEvent: BindableEvent,
        _equipmentChangedEvent: BindableEvent,
        _saveSchema: any,
        _store: GlobalDataStore?,
    },
    ProfileService
))

function ProfileService.new(logger: Logger, persistent: boolean): ProfileService
    return setmetatable({
        Name = ProfileService.Name,
        _logger = logger,
        _persistent = persistent,
        _profiles = {},
        _writable = {},
        _dirty = {},
        _saving = {},
        _loading = {},
        _loadedEvent = Instance.new("BindableEvent"),
        _equipmentChangedEvent = Instance.new("BindableEvent"),
        _saveSchema = nil,
        _store = nil,
    }, ProfileService)
end

function ProfileService.Init(self: ProfileService, context: any)
    self._saveSchema = context.saveSchema
    if self._persistent then
        self._store = DataStoreService:GetDataStore("LastLightProfile_v1")
    end
end

function ProfileService._load(self: ProfileService, player: Player)
    if self._loading[player] or self._profiles[player] ~= nil then
        return
    end
    self._loading[player] = true

    local now = os.time()
    local profile = self._saveSchema.default(now)
    local source = "fallback"
    local writable = not self._persistent

    if self._persistent and self._store ~= nil then
        local finished = false
        local ok = false
        local result: any = nil

        task.spawn(function()
            ok, result = pcall(function()
                return (self._store :: GlobalDataStore):GetAsync(
                    string.format("player_%d", player.UserId)
                )
            end)
            finished = true
        end)

        local deadline = os.clock() + 6
        while not finished and os.clock() < deadline and player.Parent ~= nil do
            task.wait(0.1)
        end

        if finished and ok then
            profile = self._saveSchema.normalize(result, now)
            source = result == nil and "new" or "datastore"
            writable = true
        elseif finished then
            source = "read_only"
            self._logger:warn("profile_load_failed", {
                player = player.UserId,
                reason = tostring(result),
            })
        else
            source = "read_only"
            self._logger:warn("profile_load_timed_out", { player = player.UserId })
        end
    else
        source = "session"
    end

    if player.Parent == nil then
        self._loading[player] = nil
        return
    end

    self._profiles[player] = profile
    self._writable[player] = writable
    self._loading[player] = nil
    self._loadedEvent:Fire(player, profile)
    self._logger:info("profile_loaded", {
        player = player.UserId,
        source = source,
        stage = profile.tutorial.stage,
    })
end

function ProfileService.Start(self: ProfileService)
    Players.PlayerAdded:Connect(function(player: Player)
        task.spawn(function()
            self:_load(player)
        end)
    end)

    Players.PlayerRemoving:Connect(function(player: Player)
        self:save(player)
        self._profiles[player] = nil
        self._writable[player] = nil
        self._dirty[player] = nil
        self._saving[player] = nil
        self._loading[player] = nil
    end)

    for _, player in Players:GetPlayers() do
        task.spawn(function()
            self:_load(player)
        end)
    end

    if self._persistent then
        task.spawn(function()
            while true do
                task.wait(10)
                for player in self._dirty do
                    if player.Parent ~= nil then
                        task.spawn(function()
                            self:save(player)
                        end)
                    end
                end
            end
        end)
    end

    game:BindToClose(function()
        local remaining = 0
        for player in self._profiles do
            remaining += 1
            task.spawn(function()
                self:save(player)
                remaining -= 1
            end)
        end

        local deadline = os.clock() + 7
        while remaining > 0 and os.clock() < deadline do
            task.wait(0.1)
        end
    end)
end

function ProfileService.onLoaded(
    self: ProfileService,
    callback: (Player, any) -> ()
): RBXScriptConnection
    return self._loadedEvent.Event:Connect(callback)
end

function ProfileService.onEquipmentChanged(
    self: ProfileService,
    callback: (Player, any) -> ()
): RBXScriptConnection
    return self._equipmentChangedEvent.Event:Connect(callback)
end

function ProfileService.get(self: ProfileService, player: Player): any
    return self._profiles[player]
end

function ProfileService.isLoaded(self: ProfileService, player: Player): boolean
    return self._profiles[player] ~= nil
end

function ProfileService.isWritable(self: ProfileService, player: Player): boolean
    return self._profiles[player] ~= nil
        and (not self._persistent or self._writable[player] == true)
end

function ProfileService.setTutorial(
    self: ProfileService,
    player: Player,
    stage: string,
    selectedTool: string?
): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end

    self._profiles[player] = self._saveSchema.withTutorial(profile, stage, selectedTool, os.time())
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return true
end

function ProfileService.setProfession(
    self: ProfileService,
    player: Player,
    professionId: string
): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end

    self._profiles[player] = self._saveSchema.withProfession(profile, professionId, os.time())
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return true
end

function ProfileService.awardMastery(
    self: ProfileService,
    player: Player,
    professionId: string,
    amount: number
): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { applied = false, reason = "profile_unavailable" }
    end
    local nextProfile, result =
        self._saveSchema.withMasteryAward(profile, professionId, amount, os.time())
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    return result
end

function ProfileService.masterySnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.masterySnapshot(profile)
end

function ProfileService.selectProfessionSpecialization(
    self: ProfileService,
    player: Player,
    professionId: string,
    specializationId: string
): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { applied = false, reason = "profile_unavailable" }
    end
    local nextProfile, result = self._saveSchema.withProfessionSpecialization(
        profile,
        professionId,
        specializationId,
        os.time()
    )
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    return result
end

function ProfileService.setNightNumber(
    self: ProfileService,
    player: Player,
    nightNumber: number
): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end

    self._profiles[player] = self._saveSchema.withNightNumber(profile, nightNumber, os.time())
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return true
end

function ProfileService.setTownCondition(
    self: ProfileService,
    player: Player,
    condition: any
): boolean
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return false
    end
    local nextProfile = self._saveSchema.withTownCondition(profile, condition, os.time())
    if nextProfile == profile then
        return true
    end
    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    return true
end

function ProfileService.townCondition(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return { integrity = 100, damageLevel = 0, repairsRemaining = 0 }
    end
    return self._saveSchema.townCondition(profile)
end

function ProfileService.nightNumber(self: ProfileService, player: Player): number
    local profile = self._profiles[player]
    if profile == nil then
        return 1
    end
    return self._saveSchema.nightNumber(profile)
end

function ProfileService.craftItem(self: ProfileService, player: Player, recipeId: string): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            reason = "profile_read_only",
        }
    end

    local nextProfile, result = self._saveSchema.withCraftedItem(profile, recipeId, os.time())
    if not result.applied then
        return {
            accepted = false,
            reason = result.reason,
        }
    end

    self._profiles[player] = nextProfile
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return {
        accepted = true,
        itemId = result.itemId,
    }
end

function ProfileService.useGearItem(self: ProfileService, player: Player, itemId: string): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            reason = "profile_read_only",
        }
    end

    local nextProfile, result = self._saveSchema.withUsedGearItem(profile, itemId, os.time())
    if not result.applied then
        return {
            accepted = false,
            reason = result.reason,
        }
    end

    self._profiles[player] = nextProfile
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return {
        accepted = true,
        itemId = result.itemId,
    }
end

function ProfileService.equipItem(self: ProfileService, player: Player, itemId: string): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { accepted = false, reason = "profile_unavailable" }
    end
    local nextProfile, result = self._saveSchema.withEquippedItem(profile, itemId, os.time())
    if not result.applied then
        return { accepted = false, reason = result.reason }
    end
    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    self._equipmentChangedEvent:Fire(player, self._saveSchema.equippedSnapshot(nextProfile))
    return { accepted = true, itemId = result.itemId, slot = result.slot }
end

function ProfileService.unequipItem(self: ProfileService, player: Player, slot: string): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { accepted = false, reason = "profile_unavailable" }
    end
    local nextProfile, result = self._saveSchema.withUnequippedItem(profile, slot, os.time())
    if not result.applied then
        return { accepted = false, reason = result.reason }
    end
    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    self._equipmentChangedEvent:Fire(player, self._saveSchema.equippedSnapshot(nextProfile))
    return { accepted = true, slot = slot }
end

function ProfileService.equippedSnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.equippedSnapshot(profile)
end

function ProfileService.equipmentStats(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return { damageReduction = 0, staminaRegenMultiplier = 1 }
    end
    return self._saveSchema.equipmentStats(profile)
end

function ProfileService.townConsequence(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return { tier = 0, title = "EMBERHOLLOW AWAKENS", detail = "" }
    end
    return self._saveSchema.townConsequence(profile)
end

-- Safe to call after any action, whether or not it moved a quest signal:
-- returns an empty list and touches nothing when there's nothing newly
-- claimable.
function ProfileService.checkQuests(self: ProfileService, player: Player): { any }
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return {}
    end

    local nextProfile, claimedResults = self._saveSchema.checkAndClaimQuests(profile, os.time())
    if #claimedResults == 0 then
        return claimedResults
    end

    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    return claimedResults
end

function ProfileService.questSnapshot(self: ProfileService, player: Player): { any }
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.questSnapshot(profile)
end

function ProfileService.gearSnapshot(self: ProfileService, player: Player): { [string]: number }
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.gearSnapshot(profile)
end

function ProfileService.grantUnbankedExpeditionReward(
    self: ProfileService,
    player: Player,
    transactionId: string,
    manifestHash: string,
    reward: any
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            durable = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            durable = false,
            reason = "profile_read_only",
        }
    end

    local nextProfile, result = self._saveSchema.withUnbankedExpeditionReward(
        profile,
        transactionId,
        manifestHash,
        reward,
        os.time()
    )
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    elseif not result.duplicate then
        return {
            accepted = false,
            durable = false,
            reason = result.reason,
        }
    end

    local durable = not self._persistent
    if self._persistent and result.applied then
        task.spawn(function()
            self:save(player)
        end)
    elseif self._persistent and result.duplicate then
        durable = self._dirty[player] ~= true
    end
    return {
        accepted = true,
        applied = result.applied == true,
        durable = durable,
        reason = if durable then nil else "save_queued",
    }
end

function ProfileService.settleExpedition(
    self: ProfileService,
    player: Player,
    runId: string,
    manifestHash: string,
    sessionRewards: { any }
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            reason = "profile_read_only",
        }
    end

    local workingProfile = profile
    local sessionTransactionIds = {}
    for _, sessionReward in sessionRewards do
        local nextProfile, result = self._saveSchema.withUnbankedExpeditionReward(
            workingProfile,
            sessionReward.transactionId,
            sessionReward.manifestHash,
            {
                amount = sessionReward.amount,
                materialId = sessionReward.materialId,
            },
            os.time()
        )
        if not result.applied and not result.duplicate then
            return {
                accepted = false,
                reason = result.reason,
            }
        end
        workingProfile = nextProfile
        table.insert(sessionTransactionIds, sessionReward.transactionId)
    end

    local pending = self._saveSchema.expeditionPending(workingProfile)
    local settlementId = nil
    local settlementRecord = nil
    if pending.count > 0 then
        settlementId =
            self._saveSchema.expeditionSettlementId(runId, player.UserId, pending.fingerprint)
        local nextProfile, result = self._saveSchema.withExpeditionSettlement(
            workingProfile,
            settlementId,
            manifestHash,
            os.time()
        )
        if not result.applied and not result.duplicate then
            return {
                accepted = false,
                reason = result.reason,
            }
        end
        workingProfile = nextProfile
        settlementRecord = result.record
    elseif #sessionTransactionIds > 0 then
        settlementId, settlementRecord = self._saveSchema.findExpeditionSettlementForRewards(
            workingProfile,
            sessionTransactionIds
        )
    end

    if workingProfile ~= profile then
        self._profiles[player] = workingProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    if settlementId == nil then
        return {
            accepted = true,
            empty = true,
            inventory = table.clone(workingProfile.inventory.materials),
            sessionTransactionIds = sessionTransactionIds,
        }
    end

    local saved = if self._persistent then self:save(player) else true
    local activeProfile = self._profiles[player]
    local durable = saved
        and activeProfile ~= nil
        and self._saveSchema.hasExpeditionSettlement(activeProfile, settlementId)
    return {
        accepted = durable,
        durable = durable,
        inventory = if activeProfile == nil
            then {}
            else table.clone(activeProfile.inventory.materials),
        materials = if settlementRecord == nil then {} else table.clone(settlementRecord.materials),
        reason = if durable then nil else "save_pending",
        settlementId = settlementId,
        sessionTransactionIds = sessionTransactionIds,
    }
end

function ProfileService.inventorySnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            banked = {},
            cachedTransactionIds = {},
            pending = {},
            pendingRewards = {},
            recovery = nil,
        }
    end
    local pending = self._saveSchema.expeditionPending(profile)
    return {
        banked = table.clone(profile.inventory.materials),
        cachedTransactionIds = self._saveSchema.expeditionCachedTransactionIds(profile),
        pending = pending.materials,
        pendingRewards = pending.rewards,
        recovery = self._saveSchema.expeditionRecovery(profile),
    }
end

function ProfileService.cacheExpeditionFailure(
    self: ProfileService,
    player: Player,
    runId: string,
    manifestHash: string,
    sessionRewards: { any }
): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { accepted = false, reason = "profile_unavailable" }
    end
    local workingProfile = profile
    for _, sessionReward in sessionRewards do
        local nextProfile, result = self._saveSchema.withUnbankedExpeditionReward(
            workingProfile,
            sessionReward.transactionId,
            sessionReward.manifestHash,
            { amount = sessionReward.amount, materialId = sessionReward.materialId },
            os.time()
        )
        if not result.applied and not result.duplicate then
            return { accepted = false, reason = result.reason }
        end
        workingProfile = nextProfile
    end

    local pending = self._saveSchema.expeditionPending(workingProfile)
    if pending.count < 2 then
        if workingProfile ~= profile then
            self._profiles[player] = workingProfile
            if self._persistent then
                self._dirty[player] = true
            end
        end
        local durable = if self._persistent and self._dirty[player] == true
            then self:save(player)
            else true
        return {
            accepted = durable,
            cached = false,
            durable = durable,
            reason = if durable then "pouch_retained" else "save_pending",
        }
    end
    local baseCacheId =
        self._saveSchema.expeditionRecoveryCacheId(runId, player.UserId, pending.fingerprint)
    local cacheId = baseCacheId
    local suffix = 1
    while
        workingProfile.inventory.recoveryCaches[cacheId] ~= nil
        and workingProfile.inventory.recoveryCaches[cacheId].status == "recovered"
    do
        suffix += 1
        cacheId = string.format("%s:%d", baseCacheId, suffix)
    end
    local nextProfile, result = self._saveSchema.withExpeditionFailureCache(
        workingProfile,
        cacheId,
        manifestHash,
        os.time()
    )
    if not result.applied and not result.duplicate then
        return { accepted = false, reason = result.reason }
    end
    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    local durable = if self._persistent then self:save(player) else true
    return {
        accepted = durable,
        cacheId = cacheId,
        cached = true,
        durable = durable,
        materials = result.materials or {},
        reason = if durable then "cached" else "save_pending",
        retained = result.retained or 0,
        transactionIds = result.transactionIds or {},
    }
end

function ProfileService.recoveryCache(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    return if profile == nil then nil else self._saveSchema.expeditionRecovery(profile)
end

function ProfileService.recoverExpeditionCache(
    self: ProfileService,
    player: Player,
    cacheId: string
): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { accepted = false, reason = "profile_unavailable" }
    end
    local nextProfile, result =
        self._saveSchema.withRecoveredExpeditionCache(profile, cacheId, os.time())
    if not result.applied then
        if result.duplicate then
            local durable = if self._persistent and self._dirty[player] == true
                then self:save(player)
                else true
            return {
                accepted = durable,
                cacheId = cacheId,
                durable = durable,
                materials = result.materials or {},
                reason = if durable then "recovered" else "save_pending",
            }
        end
        return { accepted = false, reason = result.reason }
    end
    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    local durable = if self._persistent then self:save(player) else true
    return {
        accepted = durable,
        cacheId = cacheId,
        durable = durable,
        materials = result.materials or {},
        reason = if durable then "recovered" else "save_pending",
    }
end

function ProfileService.completeChapterOne(
    self: ProfileService,
    player: Player,
    transactionId: string,
    decision: string,
    wardenOutcome: string
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            durable = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            durable = false,
            reason = "profile_read_only",
        }
    end
    local nextProfile, result = self._saveSchema.withChapterOneResolution(
        profile,
        transactionId,
        decision,
        wardenOutcome,
        os.time()
    )
    if not result.applied and not result.duplicate then
        return {
            accepted = false,
            durable = true,
            reason = result.reason,
        }
    end
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    local durable = not self._persistent
    if self._persistent and result.applied then
        local saved = self:save(player)
        local activeProfile = self._profiles[player]
        local chapter = if activeProfile == nil
            then nil
            else self._saveSchema.chapterOne(activeProfile)
        durable = saved
            and chapter ~= nil
            and chapter.status == "complete"
            and chapter.transactionId == transactionId
    elseif self._persistent and result.duplicate then
        local saved = if self._dirty[player] == true then self:save(player) else true
        local activeProfile = self._profiles[player]
        local chapter = if activeProfile == nil
            then nil
            else self._saveSchema.chapterOne(activeProfile)
        durable = saved
            and self._dirty[player] ~= true
            and chapter ~= nil
            and chapter.status == "complete"
            and chapter.transactionId == transactionId
    end
    return {
        accepted = true,
        applied = result.applied == true,
        durable = durable,
        reason = if durable then result.reason else "save_pending",
        story = result.record,
    }
end

function ProfileService.chapterOneSnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return nil
    end
    return self._saveSchema.chapterOne(profile)
end

function ProfileService.save(self: ProfileService, player: Player): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end
    if not self._persistent then
        return true
    end
    if self._store == nil or self._writable[player] ~= true then
        self._logger:warn("profile_save_skipped_read_only", {
            player = player.UserId,
        })
        return false
    end
    if self._saving[player] then
        return false
    end
    self._saving[player] = true

    local retainedNewer = false
    local newerProfile: any = nil
    local ok, message = pcall(function()
        (self._store :: GlobalDataStore):UpdateAsync(
            string.format("player_%d", player.UserId),
            function(current: any)
                if current ~= nil then
                    local normalized = self._saveSchema.normalize(current, os.time())
                    if normalized.revision > profile.revision then
                        retainedNewer = true
                        newerProfile = normalized
                        return current
                    end
                end
                return profile
            end
        )
    end)
    self._saving[player] = nil

    if not ok then
        self._logger:warn("profile_save_failed", {
            player = player.UserId,
            reason = tostring(message),
        })
        return false
    end

    if retainedNewer and newerProfile ~= nil then
        local activeProfile = self._profiles[player]
        if activeProfile ~= nil and activeProfile.revision <= newerProfile.revision then
            self._profiles[player] = newerProfile
            self._dirty[player] = nil
        end
        self._logger:warn("profile_save_retained_newer_revision", {
            player = player.UserId,
            attemptedRevision = profile.revision,
            storedRevision = newerProfile.revision,
        })
        return true
    end

    local activeProfile = self._profiles[player]
    if activeProfile ~= nil and activeProfile.revision == profile.revision then
        self._dirty[player] = nil
    end
    self._logger:info("profile_saved", {
        player = player.UserId,
        revision = profile.revision,
        stage = profile.tutorial.stage,
    })
    return true
end

return table.freeze(ProfileService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">TownNightService</string>
            <string name="Source"><![CDATA[--!strict

local TownNightService = {}
TownNightService.__index = TownNightService
TownNightService.Name = "TownNightService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type TownNightService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _enemyService: any,
        _townNightSchedule: any,
        _townNightIncident: any,
        _townCondition: any,
        _townGuardLastStand: any,
        _analyticsService: any,
        _condition: any,
        _lastStandState: any,
        _daySeconds: number,
        _duskSeconds: number,
        _nightSeconds: number,
        _blackoutInterval: number,
        _enabled: boolean,
        _started: boolean,
        _nightNumber: number,
        _activeNightNumber: number,
        _phase: string,
        _phaseEndsAt: number,
        _onChanged: ((string?) -> ())?,
        _onNightCompleted: ((number, number, any) -> ())?,
        _incident: any,
    },
    TownNightService
))

function TownNightService.new(
    logger: Logger,
    config: any,
    worldService: any,
    enemyService: any,
    townNightSchedule: any,
    townNightIncident: any,
    townCondition: any,
    townGuardLastStand: any,
    analyticsService: any,
    featureFlags: any
): TownNightService
    return setmetatable({
        Name = TownNightService.Name,
        _logger = logger,
        _worldService = worldService,
        _enemyService = enemyService,
        _townNightSchedule = townNightSchedule,
        _townNightIncident = townNightIncident,
        _townCondition = townCondition,
        _townGuardLastStand = townGuardLastStand,
        _analyticsService = analyticsService,
        _condition = townCondition.default(),
        _lastStandState = townGuardLastStand.default(),
        _daySeconds = config.NormalDaySeconds,
        _duskSeconds = config.DuskSeconds,
        _nightSeconds = config.NormalNightSeconds,
        _blackoutInterval = config.BlackoutInterval,
        _enabled = featureFlags:isEnabled("town_night_cycle_enabled"),
        _started = false,
        _nightNumber = 1,
        _activeNightNumber = 0,
        _phase = "dormant",
        _phaseEndsAt = 0,
        _onChanged = nil,
        _onNightCompleted = nil,
        _incident = nil,
    }, TownNightService)
end

function TownNightService.Init(_self: TownNightService, _context: any) end

function TownNightService.Start(_self: TownNightService) end

function TownNightService.setChangedHandler(self: TownNightService, callback: (string?) -> ())
    self._onChanged = callback
end

-- Fires once per completed night with the next night number every connected
-- profile should record, the ending lantern health, and the reconciled town
-- condition. Persistence stays owned by whoever is holding each profile.
function TownNightService.setNightCompletedHandler(
    self: TownNightService,
    callback: (number, number, any) -> ()
)
    self._onNightCompleted = callback
end

function TownNightService._notify(self: TownNightService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function TownNightService._expireIncident(
    self: TownNightService,
    nightNumber: number,
    incidentId: string
)
    local incident = self._incident
    if
        incident == nil
        or incident.nightNumber ~= nightNumber
        or incident.definition.id ~= incidentId
        or incident.status ~= "active"
    then
        return
    end
    local nextIncident, result =
        self._townNightIncident.expire(incident, workspace:GetServerTimeNow())
    if not result.applied then
        return
    end
    self._incident = nextIncident
    self._worldService:clearTownIncident()
    local pressure =
        self._enemyService:applyLanternPressure(result.lanternPenalty, incident.definition.id)
    self:_notify(
        string.format(
            "%s FAILED — %d SITE%s LOST · FIRST LANTERN -%d",
            incident.definition.title,
            result.unresolved,
            if result.unresolved == 1 then "" else "S",
            pressure.damage or 0
        )
    )
    self._logger:info("town_incident_failed", {
        damage = pressure.damage or 0,
        incident = incident.definition.id,
        night = nightNumber,
        unresolved = result.unresolved,
    })
end

function TownNightService._startIncident(self: TownNightService, nightNumber: number, theme: string)
    self._worldService:clearTownIncident()
    local now = workspace:GetServerTimeNow()
    local incident = self._townNightIncident.create(theme, nightNumber, now)
    self._incident = incident
    self._worldService:startTownIncident(incident.definition, incident.endsAt)
    self:_notify(incident.definition.title .. " — " .. incident.definition.instruction)
    self._logger:info("town_incident_started", {
        incident = incident.definition.id,
        night = nightNumber,
        required = #incident.definition.sites,
    })
    task.delay(incident.definition.duration + 0.05, function()
        self:_expireIncident(nightNumber, incident.definition.id)
    end)
end

function TownNightService.resolveIncident(
    self: TownNightService,
    player: Player,
    prompt: ProximityPrompt
): any
    local incident = self._incident
    if self._phase ~= "night" or incident == nil or incident.status ~= "active" then
        return {
            accepted = false,
            message = "THAT NIGHT INCIDENT IS NO LONGER ACTIVE",
            reason = "incident_inactive",
        }
    end
    local siteId = prompt:GetAttribute("Payload")
    local nextIncident, result =
        self._townNightIncident.interact(incident, siteId, workspace:GetServerTimeNow())
    if not result.accepted then
        if result.reason == "incident_expired" then
            self:_expireIncident(incident.nightNumber, incident.definition.id)
        end
        return {
            accepted = false,
            message = if result.reason == "site_resolved"
                then "THAT SITE IS ALREADY SECURE"
                else "THE INCIDENT WINDOW HAS CLOSED",
            reason = result.reason,
        }
    end

    self._incident = nextIncident
    self._worldService:resolveTownIncidentSite(result.siteId, nextIncident.resolvedCount)
    self._logger:info("town_incident_site_resolved", {
        incident = incident.definition.id,
        player = player.UserId,
        remaining = result.remaining,
        site = result.siteId,
    })
    if result.completed then
        self:_notify(incident.definition.title .. " SECURED — THE WATCH HOLDS")
        task.delay(1.5, function()
            if self._incident == nextIncident then
                self._worldService:clearTownIncident()
            end
        end)
        return {
            accepted = true,
            completed = true,
            message = incident.definition.title .. " SECURED",
            reason = "incident_complete",
        }
    end
    return {
        accepted = true,
        completed = false,
        message = string.format(
            "%s SECURED — %d SITE%s REMAIN",
            string.upper(tostring(result.siteId)),
            result.remaining,
            if result.remaining == 1 then "" else "S"
        ),
        reason = "site_resolved",
    }
end

local function waitUntilTime(target: number)
    while workspace:GetServerTimeNow() < target do
        task.wait(0.15)
    end
end

-- Called once for every player in this server session known to be past
-- First Light — either a fresh player who just finished it, or a returning
-- player whose saved profile already had it complete. `nightNumber` is that
-- player's own persisted record; the town resumes from the highest one seen
-- rather than always restarting at night one, so nobody's progress from a
-- prior session is understated. Safe to call repeatedly and from either
-- path: only the first call actually starts the loop, but every call still
-- raises the count if the caller's record is higher (this only affects
-- nights that haven't started their wave schedule yet — see _runCycle).
-- Disabling the kill switch leaves the tutorial's authored First Night,
-- Bramblewake expeditions, and manual Blackout entry untouched — only this
-- repeating town day/dusk/night loop stops advancing.
function TownNightService.ensureStarted(
    self: TownNightService,
    nightNumber: number,
    condition: any?
)
    self._nightNumber = math.max(self._nightNumber, math.floor(nightNumber))
    if condition ~= nil then
        self._condition = self._townCondition.merge(self._condition, condition)
        self._worldService:setTownCondition(self:conditionSnapshot())
    end
    if not self._enabled or self._started then
        return
    end
    self._started = true
    task.spawn(function()
        self:_runCycle()
    end)
end

function TownNightService._runCycle(self: TownNightService)
    while true do
        self._phase = "day"
        self._activeNightNumber = 0
        self._phaseEndsAt = workspace:GetServerTimeNow() + self._daySeconds
        self._worldService:setDusk(false)
        self._worldService:setTownRepairEnabled(true)
        self:_notify(nil)
        self._logger:info("town_day_started", { night = self._nightNumber })
        waitUntilTime(self._phaseEndsAt)

        self._phase = "dusk"
        self._phaseEndsAt = workspace:GetServerTimeNow() + self._duskSeconds
        self._worldService:setDusk(true)
        self._worldService:setTownRepairEnabled(false)
        self:_notify(
            string.format(
                "DUSK FALLS — %s NIGHT %d APPROACHES",
                self._townNightSchedule.theme(self._nightNumber),
                self._nightNumber
            )
        )
        waitUntilTime(self._phaseEndsAt)

        self._phase = "night"
        self._incident = nil
        local nightStartedAt = workspace:GetServerTimeNow()
        self._phaseEndsAt = nightStartedAt + self._nightSeconds
        -- Frozen for the rest of this night: a higher number from a veteran
        -- who joins mid-night (ensureStarted always raises self._nightNumber
        -- to the max seen) must not retroactively change the wave schedule,
        -- toasts, or completion bookkeeping already committed to for this
        -- specific night — only self._nightNumber (read again below, after
        -- this night ends) picks it up, for the *next* night onward.
        local activeNight = self._nightNumber
        self._activeNightNumber = activeNight
        local blackoutDue = self:_isBlackoutDue(activeNight)
        local theme = self._townNightSchedule.theme(activeNight)
        local themeProfile = self._townNightSchedule.profile(activeNight)
        self._worldService:setNight(true, theme)
        self._enemyService:startNight(themeProfile)
        self:_notify(
            if blackoutDue
                then string.format(
                    "%s NIGHT %d — THE BLACKOUT LOOMS IN BRAMBLEWAKE",
                    theme,
                    activeNight
                )
                else string.format(
                    "%s NIGHT %d — %s",
                    theme,
                    activeNight,
                    themeProfile.instruction
                )
        )
        self._logger:info("town_night_started", {
            blackoutDue = blackoutDue,
            night = activeNight,
        })

        for _, beat in self._townNightSchedule.beats(self._nightSeconds, activeNight) do
            waitUntilTime(nightStartedAt + beat.at)
            if beat.kind == "spawn" then
                self._worldService:signalNightWave(beat.enemyId, beat.wave, theme)
                self._enemyService:spawn(beat.enemyId)
            elseif beat.kind == "breach" then
                self._worldService:setTownBreach(true, theme)
                self._enemyService:setBreach()
            elseif beat.kind == "incident" then
                self:_startIncident(activeNight, theme)
            elseif beat.kind == "warning" and beat.at > 0 then
                -- The schedule's opening warning beat always lands at at=0,
                -- immediately after the arrival toast above (which already
                -- carries the seventh-night Blackout telegraph on the nights
                -- that matter) — publishing it too would replace that toast
                -- before a player could read it.
                self:_notify("THE FOREST GOES QUIET")
            end
        end

        waitUntilTime(self._phaseEndsAt)
        local endingIncident = self._incident
        if endingIncident ~= nil and endingIncident.status == "active" then
            self:_expireIncident(activeNight, endingIncident.definition.id)
        end
        self._worldService:clearTownIncident()
        local endingLanternHealth = self._enemyService:lanternHealth()
        local nextCondition, damageResult =
            self._townCondition.afterNight(self._condition, endingLanternHealth, activeNight)
        self._condition = nextCondition
        self._enemyService:stopNight()
        self._activeNightNumber = 0
        self._worldService:setTownBreach(false, theme)
        self._worldService:setNight(false)
        local conditionSnapshot = self:conditionSnapshot()
        self._worldService:setTownCondition(conditionSnapshot)
        local damage = tonumber(damageResult.damage) or 0
        local dawnToast = if damage > 0
            then string.format(
                "DAWN BREAKS — TOWN INTEGRITY %d%% · %d REPAIR%s NEEDED",
                conditionSnapshot.integrity,
                conditionSnapshot.repairsRemaining,
                if conditionSnapshot.repairsRemaining == 1 then "" else "S"
            )
            elseif conditionSnapshot.repairsRemaining > 0 then string.format(
                "DAWN BREAKS — NIGHT %d HELD CLEAN · TOWN INTEGRITY %d%%",
                activeNight,
                conditionSnapshot.integrity
            )
            else string.format("DAWN BREAKS — NIGHT %d HELD CLEAN", activeNight)
        self:_notify(dawnToast)
        self._logger:info("town_night_completed", {
            damage = damage,
            endingLanternHealth = endingLanternHealth,
            integrity = conditionSnapshot.integrity,
            night = activeNight,
        })
        -- Adopt whichever is higher: the honest next night after the one
        -- that just actually ran, or a veteran's still-pending higher seed
        -- from ensureStarted. Either way this can only advance.
        self._nightNumber = math.max(self._nightNumber, activeNight + 1)
        local onNightCompleted = self._onNightCompleted
        if onNightCompleted ~= nil then
            onNightCompleted(activeNight + 1, endingLanternHealth, self:conditionSnapshot())
        end
        task.wait(0)
    end
end

function TownNightService.conditionSnapshot(self: TownNightService): any
    return self._townCondition.snapshot(self._condition)
end

function TownNightService.attemptLastStand(
    self: TownNightService,
    eligiblePlayers: number,
    downedPlayers: number
): any
    local activeNight = if self._activeNightNumber > 0
        then self._activeNightNumber
        else self._nightNumber
    local nextState, result = self._townGuardLastStand.attempt(self._lastStandState, {
        phase = self._phase,
        nightNumber = activeNight,
        lanternHealth = self._enemyService:lanternHealth(),
        eligiblePlayers = eligiblePlayers,
        downedPlayers = downedPlayers,
    })
    self._lastStandState = nextState
    if not result.accepted then
        self._analyticsService:townGuardLastStand(
            false,
            result.reason,
            eligiblePlayers,
            activeNight,
            self._enemyService:lanternHealth()
        )
        return result
    end

    local lantern =
        self._enemyService:spendLanternStrength(result.lanternCost, "town_guard_last_stand")
    result.lanternHealth = lantern.health
    result.lanternSpent = lantern.spent
    self._analyticsService:townGuardLastStand(
        true,
        result.reason,
        eligiblePlayers,
        activeNight,
        lantern.health
    )
    self._logger:info("town_guard_last_stand", {
        lanternHealth = lantern.health,
        night = activeNight,
        partySize = eligiblePlayers,
    })
    return result
end

function TownNightService.repairTown(self: TownNightService): any
    if self._phase ~= "day" then
        return { accepted = false, message = "TOWN REPAIRS WAIT FOR DAYLIGHT", reason = "not_day" }
    end
    local nextCondition, result = self._townCondition.repair(self._condition)
    if not result.applied then
        return {
            accepted = false,
            message = "EMBERHOLLOW IS ALREADY FULLY REPAIRED",
            reason = result.reason,
        }
    end
    self._condition = nextCondition
    self._worldService:setTownCondition(self:conditionSnapshot())
    local snapshot = self:conditionSnapshot()
    return {
        accepted = true,
        condition = snapshot,
        message = string.format(
            "TOWN REPAIR +%d · INTEGRITY %d%%",
            result.restored,
            snapshot.integrity
        ),
        reason = result.reason,
    }
end

function TownNightService._isBlackoutDue(self: TownNightService, nightNumber: number?): boolean
    return (nightNumber or self._nightNumber) % self._blackoutInterval == 0
end

function TownNightService.isNightActive(self: TownNightService): boolean
    return self._phase == "night"
end

function TownNightService.snapshot(self: TownNightService): any
    return {
        blackoutDue = self:_isBlackoutDue(),
        blackoutInterval = self._blackoutInterval,
        enemyCount = self._enemyService:activeCount(),
        lanternHealth = self._enemyService:lanternHealth(),
        townCondition = self:conditionSnapshot(),
        nightActive = self:isNightActive(),
        nightNumber = self._nightNumber,
        theme = self._townNightSchedule.theme(self._nightNumber),
        phase = self._phase,
        phaseEndsAt = self._phaseEndsAt,
        incident = self._townNightIncident.snapshot(self._incident),
    }
end

return table.freeze(TownNightService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local TutorialService = {}
TutorialService.__index = TutorialService
TutorialService.Name = "TutorialService"

-- Mirrors the earliest stage the authored First Night can target a player
-- (TutorialFlow only reaches "survive" once a player has a barricade, a
-- tool, and the First Lantern prepared). EnemyService reads this attribute
-- so the recurring town night cycle can't target a player still gathering,
-- choosing a tool, or building, the same way the one-time first night never
-- could before it existed.
local function isCombatEligibleStage(stage: string): boolean
    return stage == "survive" or stage == "reveal" or stage == "complete"
end

type Session = {
    stage: string,
    resources: number,
    selectedTool: string?,
    compactHud: boolean,
    toast: string?,
    toastRevision: number,
}

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type TutorialService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _runtimeIds: any,
        _tutorialFlow: any,
        _rateLimiter: any,
        _networkService: any,
        _profileService: any,
        _worldService: any,
        _enemyService: any,
        _survivalService: any,
        _combatService: any,
        _professionService: any,
        _phaseService: any,
        _townNightService: any,
        _expeditionService: any,
        _oldGrowthService: any,
        _wardenStagService: any,
        _blackoutService: any,
        _analyticsService: any,
        _craftingCatalog: any,
        _equipmentCatalog: any,
        _residentDialogue: any,
        _sessions: { [Player]: Session },
        _expeditionModuleIndex: { [Player]: number },
        _expeditionEventRevision: { [Player]: number },
        _expeditionEventSecond: { [Player]: number },
        _limiter: any,
    },
    TutorialService
))

function TutorialService.new(
    logger: Logger,
    config: any,
    runtimeIds: any,
    tutorialFlow: any,
    rateLimiter: any,
    networkService: any,
    profileService: any,
    worldService: any,
    enemyService: any,
    survivalService: any,
    combatService: any,
    professionService: any,
    phaseService: any,
    townNightService: any,
    expeditionService: any,
    oldGrowthService: any,
    wardenStagService: any,
    blackoutService: any,
    analyticsService: any,
    craftingCatalog: any,
    equipmentCatalog: any,
    residentDialogue: any
): TutorialService
    return setmetatable({
        Name = TutorialService.Name,
        _logger = logger,
        _config = config,
        _runtimeIds = runtimeIds,
        _tutorialFlow = tutorialFlow,
        _rateLimiter = rateLimiter,
        _networkService = networkService,
        _profileService = profileService,
        _worldService = worldService,
        _enemyService = enemyService,
        _survivalService = survivalService,
        _combatService = combatService,
        _professionService = professionService,
        _phaseService = phaseService,
        _townNightService = townNightService,
        _expeditionService = expeditionService,
        _oldGrowthService = oldGrowthService,
        _wardenStagService = wardenStagService,
        _blackoutService = blackoutService,
        _analyticsService = analyticsService,
        _craftingCatalog = craftingCatalog,
        _equipmentCatalog = equipmentCatalog,
        _residentDialogue = residentDialogue,
        _sessions = {},
        _expeditionModuleIndex = {},
        _expeditionEventRevision = {},
        _expeditionEventSecond = {},
        _limiter = rateLimiter.new(config.ActionRatePerSecond, config.ActionRatePerSecond * 2),
    }, TutorialService)
end

function TutorialService.Init(self: TutorialService, _context: any)
    self._profileService:onLoaded(function(player: Player, profile: any)
        self:_profileLoaded(player, profile)
    end)

    self._networkService:setActionHandler(function(player: Player, payload: any)
        self:_handleAction(player, payload)
    end)
    self._networkService:setSnapshotProvider(function(player: Player)
        return self:snapshot(player)
    end)
    self._phaseService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for player, session in self._sessions do
                session.toast = toast
                session.toastRevision += 1
                self:_publish(player)
            end
        else
            self:_publishAll()
        end
    end)
    self._phaseService:setCompleteHandler(function()
        self:_nightComplete()
    end)
    self._townNightService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for _, session in self._sessions do
                if session.stage == "complete" then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._townNightService:setNightCompletedHandler(
        function(nightNumber: number, endingLanternHealth: number, condition: any)
            for player in self._sessions do
                self._profileService:setNightNumber(player, nightNumber)
                self._profileService:setTownCondition(player, condition)
                local questSuffix = self:_questToastSuffix(player)
                if questSuffix ~= nil then
                    self:_setToast(player, questSuffix)
                end
            end
            self._analyticsService:townNightConsequence(
                nightNumber - 1,
                endingLanternHealth,
                condition.integrity,
                condition.damageLevel
            )
            self:_publishAll()
        end
    )
    self._enemyService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for _, session in self._sessions do
                if session.stage == "survive" then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._oldGrowthService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for player, session in self._sessions do
                if self._oldGrowthService:snapshot(player) ~= nil then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._wardenStagService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for player, session in self._sessions do
                if self._wardenStagService:snapshot(player) ~= nil then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._blackoutService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for player, session in self._sessions do
                if self._blackoutService:snapshot(player) ~= nil then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._survivalService:setChangedHandler(function(player: Player?, toast: string?)
        if player ~= nil and toast ~= nil then
            self:_setToast(player, toast)
        end
        self:_publishAll()
    end)
    self._combatService:setChangedHandler(function(player: Player, toast: string?)
        if toast ~= nil then
            self:_setToast(player, toast)
        end
        self:_publish(player)
    end)
    self._professionService:setChangedHandler(function(player: Player, toast: string?)
        if toast ~= nil then
            self:_setToast(player, toast)
        end
        self:_publishAll()
    end)
end

function TutorialService.Start(self: TutorialService)
    Players.PlayerRemoving:Connect(function(player: Player)
        self._sessions[player] = nil
        self._expeditionModuleIndex[player] = nil
        self._expeditionEventRevision[player] = nil
        self._expeditionEventSecond[player] = nil
        self._limiter:clear(tostring(player.UserId))
        self._analyticsService:clear(player)
    end)

    for _, player in Players:GetPlayers() do
        local profile = self._profileService:get(player)
        if profile ~= nil then
            self:_profileLoaded(player, profile)
        end
    end

    local expeditionAccumulator = 0
    RunService.Heartbeat:Connect(function(deltaTime: number)
        expeditionAccumulator += deltaTime
        if expeditionAccumulator < 0.5 then
            return
        end
        expeditionAccumulator = 0

        for player in self._sessions do
            local expedition = self._expeditionService:snapshot(player)
            local moduleIndex = if expedition.active then expedition.moduleIndex else 0
            local eventRevision = if expedition.active then expedition.eventRevision or 0 else 0
            local eventSecond = if expedition.active
                    and expedition.event ~= nil
                    and expedition.event.status == "active"
                then expedition.event.timeRemaining or 0
                else -1
            if
                self._expeditionModuleIndex[player] ~= moduleIndex
                or self._expeditionEventRevision[player] ~= eventRevision
                or self._expeditionEventSecond[player] ~= eventSecond
            then
                self._expeditionModuleIndex[player] = moduleIndex
                self._expeditionEventRevision[player] = eventRevision
                self._expeditionEventSecond[player] = eventSecond
                self:_publish(player)
            end
        end
    end)

    self._networkService:setWorldReady(true)
end

function TutorialService._profileLoaded(self: TutorialService, player: Player, profile: any)
    if self._sessions[player] ~= nil then
        return
    end

    local stage = profile.tutorial.stage
    player:SetAttribute("LastLightTutorialSurvivalReady", isCombatEligibleStage(stage))
    local session: Session = {
        stage = stage,
        resources = if stage == "gather"
            then 0
            elseif stage == "choose_tool" or stage == "build" then 3
            else 0,
        selectedTool = profile.tutorial.selectedTool,
        compactHud = false,
        toast = if not self._profileService:isWritable(player)
            then "PROFILE OFFLINE — PROGRESS WILL NOT SAVE"
            elseif stage == "complete" then "WELCOME BACK TO EMBERHOLLOW"
            else "FOLLOW THE LANTERN TRAIL",
        toastRevision = 1,
    }
    self._sessions[player] = session
    self._worldService:setTownConsequence(self._profileService:townConsequence(player))

    if stage == "prepare" or stage == "survive" or stage == "reveal" or stage == "complete" then
        self._worldService:buildBarricade(false)
    end
    if stage == "survive" then
        if self._phaseService:hasCompletedFirstNight() then
            self:_advanceSurvivorToReveal(player, session)
        else
            self._phaseService:ensureFirstNight()
        end
    elseif stage == "reveal" or stage == "complete" then
        self._worldService:setBeaconVisible(true)
        self._townNightService:ensureStarted(
            profile.town.nightNumber,
            self._profileService:townCondition(player)
        )
    end

    local currentStage = session.stage
    local definition = self._tutorialFlow.definition(currentStage)
    self._analyticsService:stage(player, definition.index, currentStage)
    self:_publish(player)
end

function TutorialService._setToast(self: TutorialService, player: Player, message: string)
    local session = self._sessions[player]
    if session == nil then
        return
    end
    session.toast = message
    session.toastRevision += 1
end

-- Quests have no quest board or accept step: this opportunistically claims
-- anything newly satisfiable and returns a toast fragment to fold into
-- whatever toast the caller was already about to show (a single session
-- only ever carries one pending toast, so the caller must combine rather
-- than set two in a row and lose the first).
function TutorialService._questToastSuffix(self: TutorialService, player: Player): string?
    local claimed = self._profileService:checkQuests(player)
    if #claimed == 0 then
        return nil
    end
    local parts = {}
    for _, quest in claimed do
        self._analyticsService:questClaimed(player, quest.questId)
        table.insert(parts, string.format("QUEST COMPLETE: %s", quest.displayName))
    end
    return table.concat(parts, " · ")
end

function TutorialService._advance(
    self: TutorialService,
    player: Player,
    actionId: string
): (boolean, string?)
    local session = self._sessions[player]
    if session == nil then
        return false, "Your profile is still loading."
    end

    local nextStage, reason = self._tutorialFlow.advance(session.stage, actionId)
    if nextStage == nil then
        return false, reason
    end

    session.stage = nextStage
    player:SetAttribute("LastLightTutorialSurvivalReady", isCombatEligibleStage(nextStage))
    self._profileService:setTutorial(player, nextStage, session.selectedTool)
    local definition = self._tutorialFlow.definition(nextStage)
    self._analyticsService:stage(player, definition.index, nextStage)

    return true, nil
end

function TutorialService._interact(self: TutorialService, player: Player, interactionId: string)
    local revivePrompt = self._survivalService:interaction(interactionId)
    if revivePrompt ~= nil then
        local result = self._survivalService:beginRevive(player, interactionId)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if not self._survivalService:canAct(player) then
        self:_setToast(player, "YOU CANNOT INTERACT WHILE DOWNED")
        self:_publishAll()
        return
    end

    local prompt = self._worldService:interaction(interactionId)
    if prompt == nil or not prompt.Enabled or not self._worldService:isInRange(player, prompt) then
        self:_setToast(player, "MOVE CLOSER TO THE MARKED OBJECT")
        self:_publish(player)
        return
    end

    local actionId = prompt:GetAttribute("ActionId")
    if type(actionId) ~= "string" then
        return
    end

    local session = self._sessions[player]
    if session == nil then
        return
    end

    if actionId == self._runtimeIds.Actions.ExpeditionEvent then
        local result = self._expeditionService:interact(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.OldGrowthFire then
        local result = self._oldGrowthService:interact(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.WardenStagChoice then
        local result = self._wardenStagService:interact(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.BramblewakeBlackout then
        local result = self._blackoutService:interact(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.Extract then
        local result = self._expeditionService:extract(player)
        local toast = result.message
        if result.accepted then
            local questSuffix = self:_questToastSuffix(player)
            if questSuffix ~= nil then
                toast = toast .. " · " .. questSuffix
            end
        end
        self:_setToast(player, toast)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.CraftItem then
        if session.stage ~= "complete" then
            self:_setToast(player, "FINISH FIRST LIGHT TO CRAFT")
            self:_publish(player)
            return
        end
        local recipeId = prompt:GetAttribute("Payload")
        if type(recipeId) ~= "string" then
            return
        end
        local result = self._profileService:craftItem(player, recipeId)
        self._analyticsService:crafted(player, recipeId, result.accepted, result.reason)
        local toast: string
        if result.accepted then
            toast = string.format("CRAFTED %s", prompt.ObjectText)
            local questSuffix = self:_questToastSuffix(player)
            if questSuffix ~= nil then
                toast = toast .. " · " .. questSuffix
            end
        elseif result.reason == "insufficient_materials" then
            toast = "NOT ENOUGH MATERIALS"
        else
            toast = "CRAFTING UNAVAILABLE"
        end
        self:_setToast(player, toast)
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.OpenFieldBook then
        self:_setToast(player, "FIELD BOOK UPDATED — CHECK RECIPES, QUESTS, AND MASTERY")
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.SelectProfessionSpecialization then
        local specializationId = prompt:GetAttribute("Payload")
        if type(specializationId) ~= "string" then
            return
        end
        local result = self._professionService:selectSpecialization(player, specializationId)
        self:_setToast(player, result.message)
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.TalkResident then
        local residentId = prompt:GetAttribute("Payload")
        local response = self._residentDialogue.respond(
            residentId,
            self._profileService:questSnapshot(player),
            self._profileService:townConsequence(player)
        )
        if response == nil then
            self:_setToast(player, "THE RESIDENT IS BUSY WITH THE NIGHT WATCH")
        else
            self:_setToast(player, response.message)
            self._analyticsService:residentTalked(
                player,
                tostring(residentId),
                response.questId,
                response.state
            )
        end
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.RepairTown then
        if player:GetAttribute("LastLightInExpedition") == true then
            self:_setToast(player, "RETURN THROUGH WAYHOME BEFORE REPAIRING TOWN")
            self:_publish(player)
            return
        end
        local result = self._townNightService:repairTown()
        if result.accepted then
            for sessionPlayer in self._sessions do
                self._profileService:setTownCondition(sessionPlayer, result.condition)
            end
            self._analyticsService:townRepaired(
                player,
                result.condition.integrity,
                result.condition.repairsRemaining
            )
        end
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.ResolveTownIncident then
        local result = self._townNightService:resolveIncident(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.RecoverExpeditionCache then
        local result = self._expeditionService:recoverCache(player, prompt)
        self:_setToast(player, result.message)
        self:_publish(player)
        return
    end

    if actionId == self._runtimeIds.Actions.Build and session.resources < 3 then
        self:_setToast(player, "YOU NEED 3 HEARTWOOD")
        self:_publish(player)
        return
    end

    if actionId == self._runtimeIds.Actions.Reveal and session.stage == "complete" then
        if self._expeditionService:enter(player) then
            local blackoutResult = self._blackoutService:participantEntered(player)
            self:_setToast(player, blackoutResult.message or "ENTERING BRAMBLEWAKE")
            self._analyticsService:expeditionStarted(
                player,
                self._expeditionService:snapshot(player)
            )
        else
            self:_setToast(player, "BRAMBLEWAKE IS STILL FORMING")
        end
        self:_publish(player)
        return
    end

    local ok, reason = self:_advance(player, actionId)
    if not ok then
        local expected = self._tutorialFlow.definition(session.stage).objective
        self:_setToast(player, "CURRENT OBJECTIVE: " .. expected)
        self._logger:warn("tutorial_action_rejected", {
            action = actionId,
            player = player.UserId,
            reason = reason,
            stage = session.stage,
        })
        self:_publish(player)
        return
    end

    if actionId == self._runtimeIds.Actions.Rescue then
        self._worldService:moveMara(Vector3.new(2, 1.1, -38))
        self:_setToast(player, "MARA IS SAFE")
    elseif actionId == self._runtimeIds.Actions.Gather then
        session.resources = 3
        self:_setToast(player, "+3 HEARTWOOD")
    elseif actionId == self._runtimeIds.Actions.ChooseTool then
        local selectedTool = prompt:GetAttribute("Payload")
        if type(selectedTool) == "string" then
            session.selectedTool = selectedTool
            self._profileService:setTutorial(player, session.stage, selectedTool)
            self:_setToast(player, string.upper(selectedTool) .. " SELECTED")
        end
    elseif actionId == self._runtimeIds.Actions.Build then
        session.resources -= 3
        self._worldService:buildBarricade(true)
        self:_setToast(player, "BARRICADE COMPLETE")
    elseif actionId == self._runtimeIds.Actions.Prepare then
        self:_setToast(player, "THE FIRST LANTERN BURNS")
        self._phaseService:startFirstNight()
    elseif actionId == self._runtimeIds.Actions.Reveal then
        if self._expeditionService:enter(player) then
            local blackoutResult = self._blackoutService:participantEntered(player)
            self:_setToast(player, blackoutResult.message or "BRAMBLEWAKE REMEMBERS YOU")
            self._analyticsService:expeditionStarted(
                player,
                self._expeditionService:snapshot(player)
            )
        else
            self:_setToast(player, "FIRST LIGHT COMPLETE")
        end
        self._analyticsService:complete(player)
    end

    self:_publishAll()
end

function TutorialService._advanceSurvivorToReveal(
    self: TutorialService,
    player: Player,
    session: Session
): boolean
    if session.stage ~= "survive" then
        return false
    end

    local nextStage = self._tutorialFlow.advanceSystem(session.stage)
    if nextStage == nil then
        return false
    end

    session.stage = nextStage
    session.toast = "DAWN BREAKS — FOLLOW THE BEACON"
    session.toastRevision += 1
    self._profileService:setTutorial(player, nextStage, session.selectedTool)
    local definition = self._tutorialFlow.definition(nextStage)
    self._analyticsService:stage(player, definition.index, nextStage)
    return true
end

function TutorialService._nightComplete(self: TutorialService)
    for player, session in self._sessions do
        self:_advanceSurvivorToReveal(player, session)
        self._townNightService:ensureStarted(
            self._profileService:nightNumber(player),
            self._profileService:townCondition(player)
        )
    end
    self:_publishAll()
end

-- Consumable one-time buffs, not equipment: each craftable item is checked
-- for its own effect's preconditions before the item is spent, so a player
-- never loses one to a no-op (already full stamina, or unable to act).
function TutorialService._useGear(self: TutorialService, player: Player, itemId: string)
    local session = self._sessions[player]
    if session == nil or session.stage ~= "complete" then
        self._analyticsService:usedGear(player, itemId, false, "tutorial_incomplete")
        self:_setToast(player, "FINISH FIRST LIGHT TO USE GEAR")
        self:_publish(player)
        return
    end
    if not self._survivalService:canAct(player) then
        self._analyticsService:usedGear(player, itemId, false, "player_downed")
        self:_setToast(player, "YOU CANNOT USE GEAR WHILE DOWNED")
        self:_publish(player)
        return
    end
    if itemId == "gear_meadow_satchel" then
        -- Uses the same freshly-advanced stamina restoreStamina itself
        -- computes below, not the possibly-stale snapshot() value, so this
        -- check can't pass on stale data only for the real restore to find
        -- stamina already full after the item has been consumed.
        local staminaNow = self._combatService:peekStamina(player)
        if staminaNow == nil or staminaNow >= self._config.MaxStamina then
            self._analyticsService:usedGear(player, itemId, false, "stamina_full")
            self:_setToast(player, "STAMINA ALREADY FULL")
            self:_publish(player)
            return
        end
    elseif itemId ~= "gear_amber_charm" then
        self._analyticsService:usedGear(player, itemId, false, "unknown_item")
        return
    end

    local result = self._profileService:useGearItem(player, itemId)
    self._analyticsService:usedGear(player, itemId, result.accepted, result.reason)
    if not result.accepted then
        self:_setToast(player, "YOU DON'T HAVE THAT ITEM")
        self:_publish(player)
        return
    end

    if itemId == "gear_amber_charm" then
        self._combatService:applyShield(player, 5, 0.6)
        self:_setToast(player, "AMBER CHARM — SHIELDED")
    else
        local staminaResult = self._combatService:restoreStamina(player, 50)
        self:_setToast(
            player,
            if staminaResult.applied
                then "MEADOW SATCHEL — STAMINA RESTORED"
                else "MEADOW SATCHEL USED"
        )
    end
    self:_publish(player)
end

function TutorialService._handleAction(self: TutorialService, player: Player, payload: any)
    if type(payload) ~= "table" or payload.schemaVersion ~= 1 then
        return
    end
    local kind = payload.kind
    if type(kind) ~= "string" or #kind > 32 then
        return
    end

    local allowedFields: { [string]: boolean } = {
        schemaVersion = true,
        kind = true,
    }
    if kind == self._runtimeIds.Actions.Interact then
        allowedFields.interactionId = true
    elseif kind == self._runtimeIds.Actions.SelectProfession then
        allowedFields.professionId = true
    elseif
        kind == self._runtimeIds.Actions.UseGear
        or kind == self._runtimeIds.Actions.EquipGear
    then
        allowedFields.itemId = true
    elseif
        kind == self._runtimeIds.Actions.Sprint
        or kind == self._runtimeIds.Actions.CompactHud
    then
        allowedFields.enabled = true
    end
    for key in payload do
        if type(key) ~= "string" or allowedFields[key] ~= true then
            return
        end
    end
    if
        not self._limiter:allow(
            tostring(player.UserId),
            os.clock(),
            if kind == self._runtimeIds.Actions.UseTool
                    or kind == self._runtimeIds.Actions.ProfessionAbility
                then 2
                else 1
        )
    then
        return
    end

    if kind == self._runtimeIds.Actions.Interact then
        local interactionId = payload.interactionId
        if type(interactionId) == "string" and #interactionId <= 64 then
            self:_interact(player, interactionId)
        end
    elseif kind == self._runtimeIds.Actions.UseTool then
        local session = self._sessions[player]
        if
            session ~= nil
            and self._survivalService:canAct(player)
            and (session.stage == "survive" or player:GetAttribute("LastLightInExpedition") == true)
        then
            local _, message = self._enemyService:damageNearest(player)
            self:_setToast(player, message)
            self:_publishAll()
        end
    elseif kind == self._runtimeIds.Actions.Sprint and type(payload.enabled) == "boolean" then
        self._combatService:setSprint(player, payload.enabled)
    elseif kind == self._runtimeIds.Actions.Dodge then
        self._combatService:dodge(player)
    elseif kind == self._runtimeIds.Actions.ProfessionAbility then
        local result = self._professionService:useAbility(player)
        if not result.accepted then
            self:_setToast(player, result.message)
            self:_publish(player)
        end
    elseif kind == self._runtimeIds.Actions.SelectProfession then
        local professionId = payload.professionId
        if type(professionId) == "string" and #professionId <= 32 then
            local result = self._professionService:select(player, professionId)
            if not result.accepted then
                self:_setToast(player, result.message)
                self:_publish(player)
            end
        end
    elseif kind == self._runtimeIds.Actions.UseGear then
        local itemId = payload.itemId
        if type(itemId) == "string" and #itemId <= 32 then
            self:_useGear(player, itemId)
        end
    elseif kind == self._runtimeIds.Actions.EquipGear then
        local itemId = payload.itemId
        if type(itemId) == "string" and #itemId <= 32 then
            local result = self._profileService:equipItem(player, itemId)
            self:_setToast(
                player,
                if result.accepted then "EQUIPPED " .. string.upper(itemId) else "CANNOT EQUIP ITEM"
            )
            self:_publish(player)
        end
    elseif kind == self._runtimeIds.Actions.CompactHud and type(payload.enabled) == "boolean" then
        local session = self._sessions[player]
        if session ~= nil then
            session.compactHud = payload.enabled
            self:_publish(player)
        end
    end
end

function TutorialService.snapshot(self: TutorialService, player: Player): any
    local session = self._sessions[player]
    if session == nil then
        return {
            schemaVersion = 1,
            status = "loading",
            worldReady = self._networkService:isWorldReady(),
        }
    end

    local definition = self._tutorialFlow.definition(session.stage)
    local progress, total = self._tutorialFlow.progress(session.stage)
    local objective = definition.objective
    local detail = definition.detail
    local mara = definition.mara
    local trailName = "FIRST LIGHT"
    local expedition = self._expeditionService:snapshot(player)
    if expedition.active then
        trailName = "BRAMBLEWAKE"
        progress = expedition.moduleIndex
        total = expedition.moduleTotal
        objective = if expedition.moduleIndex == expedition.moduleTotal
            then "BANK REWARDS AT THE WAYHOME GATE"
            else "FOLLOW THE FOXFIRE TRAIL"
        local discovery = expedition.pointOfInterestName or expedition.eventName
        detail = if discovery == nil
            then expedition.moduleName
            else string.format("%s · %s", expedition.moduleName, discovery)
        mara = "The roots remember every traveler. Keep to the amber path."
        local event = expedition.event
        if event ~= nil then
            if event.status == "dormant" then
                objective = event.objective
                detail = string.format("%s · 0/%d", event.displayName, event.total)
                mara = event.detail
            elseif event.status == "active" then
                objective = event.objective
                detail = string.format(
                    "%s · %d/%d · %ds",
                    event.displayName,
                    event.progress,
                    event.total,
                    event.timeRemaining or 0
                )
                mara = event.detail
            elseif event.status == "completed" then
                objective = "EVENT COMPLETE — FOLLOW THE FOXFIRE TRAIL"
                detail = event.completionMessage
                mara = "Shared expedition rewards are safe for this server run."
            elseif event.status == "failed" then
                objective = "EVENT ENDED — FOLLOW THE AMBER PATH"
                detail = event.failureMessage
                mara = event.failureResolution
            end
        end
    end
    local phase = if self._phaseService:hasCompletedFirstNight()
        then self._townNightService:snapshot()
        else self._phaseService:snapshot()
    local survival = self._survivalService:snapshot(player)
    local blackout = self._blackoutService:snapshot(player)
    if blackout ~= nil then
        trailName = "BRAMBLEWAKE BLACKOUT"
        progress = blackout.stage
        total = blackout.stageCount
        objective = blackout.instruction
        detail = if blackout.status == "relay"
            then string.format(
                "%s · NEXT %s · %d/%d",
                if blackout.carryingFire then "CARRY ROOTFIRE" else "TAKE ROOTFIRE",
                tostring(blackout.nextNodeLabel or "ROOT"),
                blackout.deliveredNodes,
                blackout.relayRequired
            )
            elseif
                blackout.status == "old_growth"
            then "STAGE 2/4 · ROOTED WALLS HOLD UNTIL OLD GROWTH FALLS"
            elseif blackout.status == "warden" then "STAGE 3/4 · THE WARDEN REMEMBERS EVERY ANTLER"
            elseif
                blackout.status == "resolution"
            then "STAGE 4/4 · FARMLAND, WILD REGROWTH, OR SHARED AGROFOREST"
            elseif blackout.status == "complete" then string.format(
                "%s · %s",
                string.upper(tostring(blackout.decision)),
                string.upper(tostring(blackout.wardenOutcome))
            )
            else "THE BLACKOUT HAS NOT BEGUN"
        mara = if blackout.status == "relay"
            then if blackout.carryingFire
                then "Follow the green NEXT ROOT marker and deliver before the flame fades."
                else "Take rootfire from the Blackout Lantern, then follow the green NEXT ROOT marker."
            elseif
                blackout.status == "resolution"
            then "Every active traveler votes. A tie becomes the shared agroforest."
            elseif
                blackout.status == "complete"
            then "The Greenward will remember this choice when the town grows."
            else "Keep the living path open. The Blackout clock never erases earned progress."
    end
    local elite = self._oldGrowthService:snapshot(player)
    if elite ~= nil and (blackout == nil or blackout.status == "old_growth") then
        if elite.active then
            objective = elite.instruction
            detail = string.format(
                "OLD GROWTH · PHASE %d/3 · %d/%d",
                elite.phase,
                elite.health,
                elite.maxHealth
            )
            mara = if elite.shielded
                then "The shield drinks force. Carry lantern fire from the ember to its heart."
                else "The amber heart is exposed. Strike, then clear the roots when they rise."
        elseif elite.complete then
            objective = "OLD GROWTH CLEANSED — CONTINUE TO WAYHOME"
            detail = if elite.rewardEligible
                then "+3 AMBER SAP UNBANKED"
                else "THE OLDEST ROOTS HAVE RELEASED THE TRAIL"
            mara = if elite.rewardEligible
                then "The oldest roots have released their Amber Sap."
                else "The oldest roots were cleansed before you arrived."
        end
    end
    local boss = self._wardenStagService:snapshot(player)
    if boss ~= nil and (blackout == nil or blackout.status == "warden") then
        if blackout == nil then
            trailName = "WARDEN'S SEAL"
        end
        progress = boss.phase
        total = 3
        if boss.active then
            objective = boss.instruction
            detail = if boss.exposed
                then string.format(
                    "WARDEN STAG · PHASE %d/3 · %d/%d",
                    boss.phase,
                    boss.health,
                    boss.maxHealth
                )
                else string.format(
                    "LIVING ROOTS · %d/%d · ANTLERS BROKEN %d/2",
                    boss.cleansedNodes,
                    boss.rootNodesRequired,
                    boss.antlersBroken
                )
            mara = if boss.exposed
                then "Its memory heart is open. Strike before the roots close again."
                else "Cleanse living roots to preserve the forest. Breaking antlers is faster, but permanent."
        elseif boss.complete then
            objective = boss.instruction
            detail = if boss.rewardEligible
                then "+5 AMBER SAP UNBANKED"
                else "THE WARDEN'S CHOICE WAS SETTLED BEFORE YOU ARRIVED"
            mara = if boss.outcome == "preserved"
                then "The Warden remembers mercy. A future forest path remains possible."
                else "The forest remembers what was broken. The chapter can continue, but changed."
        elseif boss.status == "locked" then
            objective = boss.instruction
            detail = "THE MEMORY SEAL REMAINS ROOTED"
            mara = "The oldest growth guards the way to the Warden."
        end
    end
    return {
        schemaVersion = 1,
        status = "ready",
        worldReady = true,
        stage = session.stage,
        tutorialComplete = session.stage == "complete",
        objective = objective,
        detail = detail,
        mara = mara,
        trailName = trailName,
        progress = progress,
        progressTotal = total,
        resources = session.resources,
        selectedTool = session.selectedTool,
        compactHud = session.compactHud,
        toast = session.toast,
        toastRevision = session.toastRevision,
        phase = phase.phase,
        phaseEndsAt = phase.phaseEndsAt,
        nightActive = phase.nightActive,
        lanternHealth = phase.lanternHealth,
        enemyCount = phase.enemyCount,
        nightNumber = phase.nightNumber,
        blackoutDue = phase.blackoutDue,
        expeditionActive = expedition.active,
        expeditionSeed = expedition.seed,
        expeditionManifestHash = expedition.manifestHash,
        expeditionModuleId = expedition.moduleId,
        expeditionPointOfInterestId = expedition.poiId,
        expeditionEventId = expedition.eventId,
        expeditionEventStatus = if expedition.event == nil then nil else expedition.event.status,
        expeditionEventProgress = if expedition.event == nil
            then nil
            else expedition.event.progress,
        expeditionEventProgressTotal = if expedition.event == nil
            then nil
            else expedition.event.total,
        unbankedExpeditionRewards = expedition.unbankedRewards,
        bankedMaterials = expedition.bankedMaterials,
        gear = self._profileService:gearSnapshot(player),
        equipped = self._profileService:equippedSnapshot(player),
        equipmentStats = self._profileService:equipmentStats(player),
        mastery = self._profileService:masterySnapshot(player),
        townConsequence = self._profileService:townConsequence(player),
        townCondition = self._townNightService:conditionSnapshot(),
        recipes = self._craftingCatalog:list(),
        equipmentCatalog = self._equipmentCatalog.list(),
        quests = self._profileService:questSnapshot(player),
        combat = self._combatService:snapshot(player),
        profession = self._professionService:snapshot(player),
        elite = elite,
        boss = boss,
        blackout = blackout,
        threat = self._enemyService:threatSnapshot(player),
        survival = survival,
    }
end

function TutorialService._publish(self: TutorialService, player: Player)
    self._networkService:send(player, self:snapshot(player))
end

function TutorialService._publishAll(self: TutorialService)
    for player in self._sessions do
        self:_publish(player)
    end
end

return table.freeze(TutorialService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">WardenStagService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local WardenStagService = {}
WardenStagService.__index = WardenStagService
WardenStagService.Name = "WardenStagService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type AttackVisual = {
    label: TextLabel,
    marker: Part,
}

type Attack = {
    areaCFrame: CFrame,
    definition: any,
    flow: any,
    target: Player,
    visual: AttackVisual,
}

export type WardenStagService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _expeditionService: any,
        _survivalService: any,
        _combatService: any,
        _professionService: any,
        _oldGrowthService: any,
        _encounter: any,
        _enemyAttackFlow: any,
        _enemyCombatRules: any,
        _builder: any,
        _analyticsService: any,
        _featureFlags: any,
        _state: any,
        _arena: any,
        _model: Model?,
        _attack: Attack?,
        _attackIndex: number,
        _lastAttackAt: number,
        _markedUntil: number,
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
        _unlockGate: (() -> boolean)?,
    },
    WardenStagService
))

local ACTIVATION_RADIUS = 27
local ENCOUNTER_RADIUS = 56
local STRIKE_RANGE = 15

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function weakPoint(model: Model): BasePart?
    local heart = model:FindFirstChild("MemoryHeart")
    return if heart ~= nil
            and heart:IsA("BasePart")
            and heart:GetAttribute("WeakPoint") == true
        then heart
        else nil
end

function WardenStagService.new(
    logger: Logger,
    worldService: any,
    expeditionService: any,
    survivalService: any,
    combatService: any,
    professionService: any,
    oldGrowthService: any,
    encounter: any,
    enemyAttackFlow: any,
    enemyCombatRules: any,
    builder: any,
    analyticsService: any,
    featureFlags: any
): WardenStagService
    return setmetatable({
        Name = WardenStagService.Name,
        _logger = logger,
        _worldService = worldService,
        _expeditionService = expeditionService,
        _survivalService = survivalService,
        _combatService = combatService,
        _professionService = professionService,
        _oldGrowthService = oldGrowthService,
        _encounter = encounter,
        _enemyAttackFlow = enemyAttackFlow,
        _enemyCombatRules = enemyCombatRules,
        _builder = builder,
        _analyticsService = analyticsService,
        _featureFlags = featureFlags,
        _state = nil,
        _arena = nil,
        _model = nil,
        _attack = nil,
        _attackIndex = 0,
        _lastAttackAt = 0,
        _markedUntil = 0,
        _onChanged = nil,
        _heartbeat = nil,
        _unlockGate = nil,
    }, WardenStagService)
end

function WardenStagService.setUnlockGate(self: WardenStagService, gate: (() -> boolean)?)
    self._unlockGate = gate
end

function WardenStagService.Init(self: WardenStagService, _context: any)
    local manifest = assert(self._expeditionService:manifest(), "expedition manifest unavailable")
    self._arena = assert(self._worldService:wardenStagArena(), "Warden Stag arena unavailable")
    self._state = self._encounter.create(
        self._expeditionService:runId(),
        manifest.hash,
        self._featureFlags:isEnabled("warden_stag_boss_enabled")
    )
    self._worldService:setWardenStagPresentation(self._state)
end

function WardenStagService.Start(self: WardenStagService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.05 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
    self._logger:info("warden_stag_ready", {
        boss = self._encounter.Id,
        enabled = self._state.status ~= "disabled",
        manifest = self._state.manifestHash,
    })
end

function WardenStagService.setChangedHandler(self: WardenStagService, callback: (string?) -> ())
    self._onChanged = callback
end

function WardenStagService._notify(self: WardenStagService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function WardenStagService._inArena(
    self: WardenStagService,
    player: Player,
    radius: number
): boolean
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return false
    end
    local root = rootPart(player)
    return root ~= nil and (root.Position - self._arena.center).Magnitude <= radius
end

function WardenStagService._spawnModel(self: WardenStagService, target: Player)
    if self._model ~= nil and self._model.Parent ~= nil then
        return
    end
    local targetRoot = rootPart(target)
    local lookAt = if targetRoot == nil
        then self._arena.center + Vector3.new(0, 0, -10)
        else targetRoot.Position
    local model = self._builder.build(self._arena.center, lookAt, self._encounter.MaxHealth)
    model.Parent = self._arena.model
    self._model = model
    self:_syncModel()
end

function WardenStagService._syncModel(self: WardenStagService)
    if self._model == nil then
        return
    end
    self._builder.setState(
        self._model,
        self._state.health,
        self._state.status,
        workspace:GetServerTimeNow() < self._markedUntil,
        self._state.brokenAntlers,
        self._state.outcome
    )
end

function WardenStagService._clearAttack(self: WardenStagService)
    local attack = self._attack
    if attack == nil then
        return
    end
    if attack.visual.marker.Parent ~= nil then
        attack.visual.marker:Destroy()
    end
    self._attack = nil
end

function WardenStagService._groundPosition(self: WardenStagService, targetRoot: BasePart): Vector3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { targetRoot.Parent :: Model }
    if self._model ~= nil then
        table.insert(excluded, self._model)
    end
    params.FilterDescendantsInstances = excluded
    local result = workspace:Raycast(
        targetRoot.Position + Vector3.new(0, 3, 0),
        Vector3.new(0, -18, 0),
        params
    )
    return if result == nil
        then targetRoot.Position - Vector3.new(0, 2.8, 0)
        else result.Position + Vector3.new(0, 0.14, 0)
end

function WardenStagService._attackArea(
    self: WardenStagService,
    definition: any,
    targetRoot: BasePart
): CFrame
    local ground = self:_groundPosition(targetRoot)
    if definition.shape == "circle" or self._model == nil or self._model.PrimaryPart == nil then
        return CFrame.new(ground)
    end
    local origin = self._model.PrimaryPart.Position
    local direction =
        Vector3.new(targetRoot.Position.X - origin.X, 0, targetRoot.Position.Z - origin.Z)
    if direction.Magnitude < 0.01 then
        direction = Vector3.new(0, 0, -1)
    end
    direction = direction.Unit
    local center = Vector3.new(origin.X, ground.Y, origin.Z) + direction * definition.length * 0.5
    return CFrame.lookAt(center, center + direction)
end

function WardenStagService._createAttackVisual(
    self: WardenStagService,
    definition: any,
    areaCFrame: CFrame
): AttackVisual
    local marker = Instance.new("Part")
    marker.Name = "WardenStagAttackWarning"
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.CastShadow = false
    marker.Color = if definition.shape == "lane"
        then Color3.fromRGB(105, 200, 148)
        else Color3.fromRGB(255, 157, 91)
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.48
    if definition.shape == "lane" then
        marker.Size = Vector3.new(definition.width, 0.2, definition.length)
        marker.CFrame = areaCFrame
    else
        marker.Shape = Enum.PartType.Cylinder
        marker.Size = Vector3.new(0.2, definition.radius * 2, definition.radius * 2)
        marker.CFrame = areaCFrame * CFrame.Angles(0, 0, math.rad(90))
    end
    marker.Parent = self._arena.model

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "WardenStagAttackLabel"
    billboard.Adornee = marker
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 120
    billboard.Size = UDim2.fromOffset(300, 72)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.5, 0)
    billboard.Parent = marker

    local label = Instance.new("TextLabel")
    label.Name = "Warning"
    label.BackgroundColor3 = Color3.fromRGB(23, 36, 29)
    label.BackgroundTransparency = 0.06
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = definition.attackName .. "\n" .. definition.instruction
    label.TextColor3 = Color3.fromRGB(248, 233, 198)
    label.TextScaled = true
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local outline = Instance.new("UIStroke")
    outline.Color = marker.Color
    outline.Thickness = 2
    outline.Transparency = 0.08
    outline.Parent = label
    return {
        label = label,
        marker = marker,
    }
end

function WardenStagService._startAttack(self: WardenStagService, target: Player, now: number)
    local targetRoot = rootPart(target)
    if targetRoot == nil then
        return
    end
    self._attackIndex += 1
    local definition = self._encounter.attack(self._attackIndex, self._state.phase)
    local areaCFrame = self:_attackArea(definition, targetRoot)
    self._attack = {
        areaCFrame = areaCFrame,
        definition = definition,
        flow = self._enemyAttackFlow.create(target.UserId, now, definition.windup),
        target = target,
        visual = self:_createAttackVisual(definition, areaCFrame),
    }
    self._lastAttackAt = now
    self._analyticsService:bossAttackTelegraphed(
        target,
        self._encounter.Id,
        definition.attackId,
        definition.shape,
        definition.windup
    )
    self:_notify(nil)
end

function WardenStagService._clearPath(self: WardenStagService, target: Player): boolean
    local model = self._model
    local root = rootPart(target)
    local character = target.Character
    if model == nil or model.PrimaryPart == nil or root == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { model }
    local result = workspace:Raycast(
        model.PrimaryPart.Position,
        root.Position - model.PrimaryPart.Position,
        params
    )
    return result == nil or result.Instance:IsDescendantOf(character)
end

function WardenStagService._insideAttack(
    self: WardenStagService,
    attack: Attack,
    targetRoot: BasePart
): boolean
    local localPosition = attack.areaCFrame:PointToObjectSpace(targetRoot.Position)
    return self._enemyCombatRules.contains(
        attack.definition.shape,
        localPosition.X,
        localPosition.Z,
        attack.definition.radius,
        attack.definition.width,
        attack.definition.length
    )
end

function WardenStagService._stepAttack(self: WardenStagService, now: number)
    local attack = self._attack
    if attack == nil then
        return
    end
    local targetRoot = rootPart(attack.target)
    local resolving = now >= attack.flow.endsAt
    local decision = self._enemyAttackFlow.evaluate(attack.flow, now, {
        clearPath = not resolving or self:_clearPath(attack.target),
        inImpactArea = not resolving
            or (targetRoot ~= nil and self:_insideAttack(attack, targetRoot)),
        targetCanAct = self._survivalService:canAct(attack.target),
        targetPresent = attack.target.Parent ~= nil and attack.target:GetAttribute(
            "LastLightInExpedition"
        ) == true and targetRoot ~= nil,
    })
    if decision.status == "pending" then
        attack.visual.label.Text = string.format(
            "%s\n%s · %.1fs",
            attack.definition.attackName,
            attack.definition.instruction,
            math.max(0, decision.remaining or 0)
        )
        return
    end

    local target = attack.target
    local definition = attack.definition
    self:_clearAttack()
    if decision.status == "cancel" or decision.status == "miss" then
        self._analyticsService:bossAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            decision.reason or decision.status
        )
        self:_notify(nil)
        return
    end
    if self._combatService:avoidsDamage(target, now) then
        self._analyticsService:bossAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            "dodged"
        )
        self:_notify(nil)
        return
    end

    local damage, guarded =
        self._professionService:mitigateIncomingDamage(target, definition.damage, now)
    damage = self._combatService:mitigateShieldedDamage(target, damage, now)
    local result = self._survivalService:damage(target, damage, self._encounter.Id)
    if result.applied and definition.rootedDuration ~= nil then
        self._combatService:applyRooted(
            target,
            definition.rootedDuration,
            definition.rootedMultiplier
        )
    end
    self._analyticsService:bossAttackResult(
        target,
        self._encounter.Id,
        definition.attackId,
        if result.applied then (if guarded then "guarded_hit" else "hit") else "blocked"
    )
    if result.downed then
        self:_notify("ALLY DOWN — " .. definition.attackName)
    elseif guarded and result.applied then
        self:_notify("LANTERN GUARD ABSORBS " .. definition.attackName)
    else
        self:_notify(nil)
    end
end

function WardenStagService._playersInArena(self: WardenStagService): { Player }
    local players = {}
    for _, player in Players:GetPlayers() do
        if self:_inArena(player, ENCOUNTER_RADIUS) and self._survivalService:canAct(player) then
            table.insert(players, player)
        end
    end
    return players
end

function WardenStagService._nearestPlayer(self: WardenStagService, players: { Player }): Player?
    local anchor = self._arena.center
    if self._model ~= nil and self._model.PrimaryPart ~= nil then
        anchor = self._model.PrimaryPart.Position
    end
    local nearest: Player? = nil
    local nearestDistance = math.huge
    for _, player in players do
        local root = rootPart(player)
        if root ~= nil then
            local distance = (root.Position - anchor).Magnitude
            if distance < nearestDistance then
                nearest = player
                nearestDistance = distance
            end
        end
    end
    return nearest
end

function WardenStagService._step(self: WardenStagService, now: number)
    if
        self._state.status == "locked"
        and self._oldGrowthService:isComplete()
        and (self._unlockGate == nil or (self._unlockGate :: () -> boolean)())
    then
        local nextState, result = self._encounter.unlock(self._state)
        if result.accepted then
            self._state = nextState
            self._worldService:setWardenStagPresentation(self._state)
            self:_notify("THE WARDEN'S SEAL OPENS BEYOND OLD GROWTH")
        end
    end
    if self._state.status == "dormant" then
        for _, player in Players:GetPlayers() do
            if
                self:_inArena(player, ACTIVATION_RADIUS) and self._survivalService:canAct(player)
            then
                local nextState, result = self._encounter.activate(self._state, player.UserId)
                if result.accepted then
                    self._state = nextState
                    self:_spawnModel(player)
                    self._lastAttackAt = now
                    self._worldService:setWardenStagPresentation(self._state)
                    self._analyticsService:bossStarted(
                        player,
                        self._encounter.Id,
                        self._state.manifestHash
                    )
                    self._analyticsService:bossPhase(
                        player,
                        self._encounter.Id,
                        self._state.phase,
                        "cleansing_started",
                        self._state.antlersBroken
                    )
                    self:_notify("WARDEN STAG AWAKENS — CLEANSE THE LIVING ROOTS")
                end
                break
            end
        end
        return
    end
    if not self:combatActive() then
        return
    end

    local players = self:_playersInArena()
    for _, player in players do
        self._state = self._encounter.join(self._state, player.UserId)
    end
    if self._model == nil or self._model.Parent == nil then
        local target = self:_nearestPlayer(players)
        if target ~= nil then
            self:_spawnModel(target)
        end
    end
    if self._markedUntil > 0 and now >= self._markedUntil then
        self._markedUntil = 0
        self:_syncModel()
        self:_notify(nil)
    end
    if self._attack ~= nil then
        self:_stepAttack(now)
        return
    end
    local target = self:_nearestPlayer(players)
    if target == nil then
        return
    end
    local tuning = self._encounter.Tuning
    local cooldown = if self._state.status == "cleansing"
        then tuning.cleansingAttackCooldownSeconds
        else tuning.attackCooldownSeconds
    if now < self._markedUntil then
        cooldown *= tuning.markedAttackCooldownMultiplier
    end
    if now - self._lastAttackAt >= cooldown then
        self:_startAttack(target, now)
    end
end

function WardenStagService.interact(
    self: WardenStagService,
    player: Player,
    prompt: ProximityPrompt
): any
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return {
            accepted = false,
            message = "ENTER THE WARDEN'S SEAL WHILE ACTIVE",
            reason = "player_unavailable",
        }
    end
    local target = prompt.Parent
    local interaction = if target == nil then nil else target:GetAttribute("BossInteraction")
    local nextState, result
    if interaction == "cleanse_root" then
        nextState, result = self._encounter.cleanseRoot(
            self._state,
            player.UserId,
            tostring(target:GetAttribute("BossNodeId"))
        )
    elseif interaction == "break_antler" then
        nextState, result = self._encounter.breakAntler(
            self._state,
            player.UserId,
            tostring(target:GetAttribute("BossAntlerId"))
        )
    else
        return {
            accepted = false,
            message = "THAT WARDEN INTERACTION IS INVALID",
            reason = "invalid_interaction",
        }
    end
    if not result.accepted then
        result.message = if result.reason == "already_cleansed"
            then "THAT LIVING ROOT IS ALREADY CLEAN"
            elseif
                result.reason == "antler_already_broken"
                or result.reason == "phase_antler_already_broken"
            then "THAT ANTLER SHORTCUT IS NO LONGER AVAILABLE"
            elseif
                self._state.status == "vulnerable"
            then "THE MEMORY HEART IS EXPOSED — STRIKE NOW"
            else "THE WARDEN IS NOT CALLING FOR THAT CHOICE"
        return result
    end

    self._state = nextState
    self._worldService:setWardenStagPresentation(self._state)
    self:_syncModel()
    if result.reason == "antler_broken" then
        result.message = "ANTLER BROKEN — THE FOREST WILL REMEMBER THIS HARM"
        self._analyticsService:bossPhase(
            player,
            self._encounter.Id,
            self._state.phase,
            "antler_shortcut",
            self._state.antlersBroken
        )
    elseif result.exposed then
        result.message = "LIVING ROOTS CLEANSED — MEMORY HEART EXPOSED"
        self._analyticsService:bossPhase(
            player,
            self._encounter.Id,
            self._state.phase,
            "heart_exposed",
            self._state.antlersBroken
        )
    else
        result.message =
            string.format("LIVING ROOT CLEANSED — %d / %d", result.cleansed, result.required)
    end
    self:_notify(result.message)
    return result
end

function WardenStagService._lineOfSight(
    _self: WardenStagService,
    player: Player,
    model: Model
): boolean
    local root = rootPart(player)
    local heart = weakPoint(model)
    local character = player.Character
    if root == nil or heart == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    local result = workspace:Raycast(root.Position, heart.Position - root.Position, params)
    return result ~= nil and result.Instance == heart
end

function WardenStagService.damageNearest(self: WardenStagService, player: Player): (boolean, string)
    if self._state.status ~= "vulnerable" and self._state.status ~= "cleansing" then
        return false, "No Warden Stag threat is active."
    end
    if self._state.status == "cleansing" then
        return false, "CLEANSE LIVING ROOTS OR ACCEPT THE ANTLER CONSEQUENCE"
    end
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return false, "Enter the Warden's Seal to strike."
    end
    local model = self._model
    local root = rootPart(player)
    local heart = if model == nil then nil else weakPoint(model)
    if model == nil or root == nil or heart == nil then
        return false, "The Warden Stag is still taking shape."
    end
    if (root.Position - heart.Position).Magnitude > STRIKE_RANGE then
        return false, "Move closer to the memory heart."
    end
    if not self:_lineOfSight(player, model) then
        return false, "The memory heart is hidden behind the Warden."
    end

    local tuning = self._encounter.Tuning
    local amount = if workspace:GetServerTimeNow() < self._markedUntil
        then tuning.markedStrikeDamage
        else tuning.strikeDamage
    local nextState, result = self._encounter.strike(self._state, player.UserId, amount)
    if not result.accepted then
        return false, "The Warden Stag cannot be struck right now."
    end
    self._state = nextState
    self._worldService:setWardenStagPresentation(self._state)
    self:_syncModel()
    if result.completed then
        self:_clearAttack()
        for participantId in self._state.participants do
            local userId = tonumber(participantId)
            if userId ~= nil then
                self._expeditionService:grantEncounterReward(
                    userId,
                    self._encounter.Id,
                    self._encounter.rewardTransactionId(self._state, userId),
                    self._encounter.Reward
                )
            end
        end
        self._analyticsService:bossResult(
            player,
            self._encounter.Id,
            self._state.manifestHash,
            self._state.outcome,
            self._state.antlersBroken,
            self:_participantCount()
        )
        local message = if self._state.outcome == "preserved"
            then "WARDEN STAG CALMED — FOREST ALLY PRESERVED · +5 AMBER SAP"
            elseif
                self._state.outcome == "harmed"
            then "WARDEN STAG DEFEATED — FOREST HARMED · +5 AMBER SAP"
            else "WARDEN STAG DEFEATED — FOREST SCARRED · +5 AMBER SAP"
        self:_notify(message)
        return true, message
    end
    if result.phaseFinished then
        self._analyticsService:bossPhase(
            player,
            self._encounter.Id,
            self._state.phase,
            "cleansing_started",
            self._state.antlersBroken
        )
        self:_notify(string.format("PHASE %d/3 — CLEANSE THE LIVING ROOTS", self._state.phase))
        return true, "The memory heart closes. Cleanse the next root pattern."
    end
    self:_notify(
        string.format("HIT — WARDEN STAG %d / %d", self._state.health, self._encounter.MaxHealth)
    )
    return true, "Your tool strikes the exposed memory heart."
end

function WardenStagService._participantCount(self: WardenStagService): number
    local count = 0
    for _ in self._state.participants do
        count += 1
    end
    return count
end

function WardenStagService.canMarkNearest(
    self: WardenStagService,
    player: Player,
    range: number
): (boolean, string)
    local model = self._model
    local root = rootPart(player)
    if
        not self:combatActive()
        or model == nil
        or model.PrimaryPart == nil
        or root == nil
        or not self:_inArena(player, ENCOUNTER_RADIUS)
        or not self._survivalService:canAct(player)
    then
        return false, "NO BOSS THREAT CAN BE MARKED"
    end
    if (root.Position - model.PrimaryPart.Position).Magnitude > range then
        return false, "MOVE CLOSER TO MARK THE WARDEN STAG"
    end
    return true, "FOXFIRE MARK READY"
end

function WardenStagService.markNearest(
    self: WardenStagService,
    player: Player,
    range: number,
    duration: number
): (boolean, string)
    local allowed, reason = self:canMarkNearest(player, range)
    if not allowed then
        return false, reason
    end
    self._markedUntil = workspace:GetServerTimeNow() + duration
    self:_syncModel()
    local message = "FOXFIRE MARK — WARDEN STAG TELEGRAPHS SLOWED"
    self:_notify(message)
    return true, message
end

function WardenStagService.threatSnapshot(self: WardenStagService, viewer: Player): any
    local attack = self._attack
    if attack == nil or attack.target ~= viewer then
        return nil
    end
    return {
        attackId = attack.definition.attackId,
        displayName = attack.definition.attackName,
        enemyId = self._encounter.Id,
        enemyName = "WARDEN STAG",
        instruction = attack.definition.instruction,
        resolvesAt = attack.flow.endsAt,
        shape = attack.definition.shape,
    }
end

function WardenStagService.snapshot(self: WardenStagService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return nil
    end
    if not self:_inArena(player, ENCOUNTER_RADIUS + 20) then
        return nil
    end
    return self._encounter.snapshot(self._state, player.UserId)
end

function WardenStagService.combatActive(self: WardenStagService): boolean
    return self._state.status == "cleansing" or self._state.status == "vulnerable"
end

function WardenStagService.isComplete(self: WardenStagService): boolean
    return self._state.status == "complete"
end

function WardenStagService.outcome(self: WardenStagService): string?
    return self._state.outcome
end

function WardenStagService.enabled(self: WardenStagService): boolean
    return self._state.status ~= "disabled"
end

return table.freeze(WardenStagService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local BramblewakeBuilder = require(script.Parent.Parent.World.BramblewakeBuilder)
local FoliageBuilder = require(script.Parent.Parent.World.FoliageBuilder)
local MeshTemplateLoader = require(script.Parent.Parent.World.MeshTemplateLoader)
local TerrainBuilder = require(script.Parent.Parent.World.TerrainBuilder)

local WorldService = {}
WorldService.__index = WorldService
WorldService.Name = "WorldService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type WorldService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _extractionPayoff: any,
        _townProgression: any,
        _professionAbilityVisuals: any,
        _runtimeIds: any,
        _world: Model?,
        _interactions: { [string]: ProximityPrompt },
        _spawn: SpawnLocation?,
        _mara: Model?,
        _lantern: BasePart?,
        _lanternVisualHealth: number,
        _beacon: BasePart?,
        _barricadeBuilt: boolean,
        _dusk: boolean,
        _duskSignals: { BasePart },
        _nightDefenseSignals: { BasePart },
        _nightThemeDressing: Model?,
        _breachActive: boolean,
        _night: boolean,
        _blackoutLightingActive: boolean,
        _expeditionEntry: CFrame?,
        _expeditionManifest: any,
        _expeditionModuleCenters: { any },
        _eventSockets: { [string]: BasePart },
        _eventTargets: { [string]: { [string]: BasePart } },
        _eventsEnabled: boolean,
        _oldGrowthArena: any,
        _wardenStagArena: any,
        _blackoutArena: any,
        _characterRoots: { [Player]: BasePart? },
        _townConsequence: any,
        _townCondition: any,
        _townResidents: { [string]: any },
        _townIncidentModel: Model?,
        _engineerBraceModel: Model?,
        _meshTemplateLoader: MeshTemplateLoader.MeshTemplateLoader,
        _meshPlacements: { MeshPlacement },
    },
    WorldService
))

local DAY_AMBIENT = Color3.fromRGB(50, 63, 58)
local NIGHT_AMBIENT = Color3.fromRGB(13, 18, 33)
local AMBER = Color3.fromRGB(255, 181, 76)
local FOXFIRE = Color3.fromRGB(94, 206, 176)
local CREAM = Color3.fromRGB(244, 230, 197)
-- GREEN lived here for the old pine() canopy. That generator is gone; the same
-- value now reaches the forest as FOLIAGE_TONE.needle below.
local DARK_GREEN = Color3.fromRGB(18, 42, 32)
local BARK = Color3.fromRGB(62, 39, 30)
local WET_BARK = Color3.fromRGB(36, 26, 24)
local MOSS = Color3.fromRGB(58, 91, 54)
local WET_EARTH = Color3.fromRGB(67, 55, 39)
local HEARTWOOD_CENTER = Vector3.new(38, 0, -48)
local TOOL_YARD_CENTER = Vector3.new(-42, 0, -68)
local BARRICADE_CENTER = Vector3.new(-44, 0, -92)
-- Shared palette for the generated forest. Kept next to the existing colour
-- anchors so the treeline and the town read as the same world.
local FOLIAGE_TONE: FoliageBuilder.Tone = {
    bark = Color3.fromRGB(62, 39, 30),
    barkWet = Color3.fromRGB(36, 26, 24),
    needle = Color3.fromRGB(42, 77, 51),
    needleDeep = Color3.fromRGB(18, 42, 32),
    leaf = Color3.fromRGB(58, 91, 54),
    leafPale = Color3.fromRGB(112, 128, 79),
    moss = Color3.fromRGB(58, 91, 54),
    stone = Color3.fromRGB(75, 83, 79),
    stoneWarm = Color3.fromRGB(88, 84, 74),
}

type MeshPlacement = {
    assetId: string,
    fallbackKind: string,
    position: Vector3,
    scale: number,
    yaw: number,
    seed: number,
    swayTag: string?,
    parent: Instance?,
    fallbackInstance: Instance?,
}

local WAYHOME_DELIVERY_LIFETIME = 180
local WAYHOME_DELIVERY_ORIGINS = table.freeze({
    Vector3.new(-27, 0, -13),
    Vector3.new(-18, 0, -13),
    Vector3.new(-9, 0, -13),
    Vector3.new(9, 0, -13),
    Vector3.new(18, 0, -13),
    Vector3.new(27, 0, -13),
    Vector3.new(-27, 0, -21),
    Vector3.new(27, 0, -21),
})

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    if not instance.CanCollide then
        instance.CanQuery = false
    end
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function labelSign(parent: Instance, at: CFrame, text: string)
    local board =
        part(parent, "TrailSign", Vector3.new(8, 3, 0.6), at, BARK, Enum.Material.WoodPlanks)
    local surface = Instance.new("SurfaceGui")
    surface.Face = Enum.NormalId.Front
    surface.LightInfluence = 0.5
    surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surface.PixelsPerStud = 32
    surface.Parent = board

    local textLabel = Instance.new("TextLabel")
    textLabel.BackgroundTransparency = 1
    textLabel.Size = UDim2.fromScale(1, 1)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Text = text
    textLabel.TextColor3 = CREAM
    textLabel.TextScaled = true
    textLabel.Parent = surface
end

local function buildEmberhollowSanctuary(parent: Instance): { Instance }
    local courtyard = Vector3.new(0, 0, -112)
    local courtyardPatch = part(
        parent,
        "EmberhollowCourtyard",
        Vector3.new(92, 0.3, 62),
        CFrame.new(courtyard + Vector3.new(0, 0.18, 1)),
        Color3.fromRGB(53, 59, 45),
        Enum.Material.Ground,
        false
    )
    courtyardPatch.Transparency = 0.08

    -- This assembly follows the proven 65-part construction grammar from the
    -- supplied Place6 reference: raised foundation, segmented walls around real
    -- openings, four cross rafters, opposing roof wedges, framed windows, stairs,
    -- an open door, and a full-height stone chimney. Last Light owns the palette,
    -- props, dimensions, names, and lighting treatment.
    local function cabin(center: Vector3, yaw: number, name: string, accent: Color3): Instance
        local scale = 0.72
        center += Vector3.new(0, 2.2, 0)
        local cabinFrame = CFrame.new(center) * CFrame.Angles(0, yaw, 0)
        local cabinFolder = Instance.new("Folder")
        cabinFolder.Name = name
        cabinFolder.Parent = parent

        local shell = Instance.new("Folder")
        shell.Name = "ProceduralCabinShell"
        shell.Parent = cabinFolder

        local wallColor = if name == "MARA'S SHELTER"
            then Color3.fromRGB(69, 85, 66)
            else Color3.fromRGB(91, 63, 44)
        local trimColor = if name == "MARA'S SHELTER"
            then Color3.fromRGB(109, 126, 90)
            else Color3.fromRGB(137, 99, 61)
        local roofColor = Color3.fromRGB(48, 54, 49)
        local stoneColor = Color3.fromRGB(82, 84, 79)

        local function scaledSize(x: number, y: number, z: number): Vector3
            return Vector3.new(x * scale, y * scale, z * scale)
        end
        local function referenceCFrame(x: number, y: number, z: number): CFrame
            return cabinFrame * CFrame.new(x * scale, (y + 7.5) * scale + 0.25, z * scale)
        end
        local function cabinCFrame(x: number, y: number, z: number): CFrame
            return cabinFrame * CFrame.new(x, y, z)
        end
        local function referencePart(
            target: Instance,
            partName: string,
            dimensions: Vector3,
            x: number,
            y: number,
            z: number,
            color: Color3,
            material: Enum.Material,
            collidable: boolean?
        ): Part
            local created = part(
                target,
                partName,
                scaledSize(dimensions.X, dimensions.Y, dimensions.Z),
                referenceCFrame(x, y, z),
                color,
                material,
                collidable
            )
            if collidable == false then
                created.CanQuery = false
            end
            return created
        end

        referencePart(
            shell,
            "CabinFoundation",
            Vector3.new(36, 3, 24),
            0,
            -9.5,
            0,
            Color3.fromRGB(72, 76, 73),
            Enum.Material.Cobblestone
        )
        referencePart(
            shell,
            "CabinFloor",
            Vector3.new(34, 1, 22),
            0,
            -7.5,
            0,
            trimColor,
            Enum.Material.WoodPlanks
        )

        local wallPieces = {
            { 9, 9, 1, -13.5, -3.5, -11.5 },
            { 7, 5, 1, 0.5, -1.5, -11.5 },
            { 7, 5, 1, 14.5, -1.5, -11.5 },
            { 21, 4, 1, 7.5, -6, -11.5 },
            { 36, 6, 1, 0, 4, -11.5 },
            { 23, 8, 1, 6.5, -4, 11.5 },
            { 5, 8, 1, -15.5, -4, 11.5 },
            { 36, 7, 1, 0, 3.5, 11.5 },
        }
        for _, spec in wallPieces do
            referencePart(
                shell,
                "CabinWallPanel",
                Vector3.new(spec[1], spec[2], spec[3]),
                spec[4],
                spec[5],
                spec[6],
                wallColor,
                Enum.Material.WoodPlanks
            )
        end
        for side = -1, 1, 2 do
            for _, spec in
                {
                    { 1, 4, 22, -6, 0 },
                    { 1, 6, 22, 4, 0 },
                    { 1, 5, 7, -1.5, -7.5 },
                    { 1, 5, 8, -1.5, 7 },
                }
            do
                referencePart(
                    shell,
                    "CabinSideWallPanel",
                    Vector3.new(spec[1], spec[2], spec[3]),
                    side * 17.5,
                    spec[4],
                    spec[5],
                    wallColor,
                    Enum.Material.WoodPlanks
                )
            end
        end

        for _, z in { -7.5, -2.5, 2.5, 7.5 } do
            referencePart(
                shell,
                "CabinInteriorRafter",
                Vector3.new(34, 1, 1),
                0,
                6.5,
                z,
                WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
        for roofSide = -1, 1, 2 do
            local roof = referencePart(
                shell,
                "CabinRoof",
                Vector3.new(36, 6, 12),
                0,
                10,
                roofSide * 6,
                roofColor,
                Enum.Material.Slate
            )
            roof.Shape = Enum.PartType.Wedge
            if roofSide > 0 then
                roof.CFrame *= CFrame.Angles(0, math.pi, 0)
            end
            roof.CastShadow = true
        end
        referencePart(
            shell,
            "CabinRidgeBeam",
            Vector3.new(36.5, 0.8, 0.8),
            0,
            13,
            0,
            WET_BARK,
            Enum.Material.Wood,
            false
        )

        local function buildWindow(x: number, z: number, frontFacing: boolean)
            local window = referencePart(
                cabinFolder,
                "CabinWindowGlass",
                if frontFacing then Vector3.new(6.6, 4.6, 0.2) else Vector3.new(0.2, 4.6, 6.6),
                x,
                -1.5,
                z,
                Color3.fromRGB(118, 156, 157),
                Enum.Material.Glass,
                false
            )
            window.Transparency = 0.48
            if frontFacing then
                for frameY = -3.9, 0.9, 4.8 do
                    referencePart(
                        cabinFolder,
                        "CabinWindowFrame",
                        Vector3.new(7, 0.28, 0.72),
                        x,
                        frameY,
                        z - 0.1,
                        trimColor,
                        Enum.Material.Wood,
                        false
                    )
                end
                referencePart(
                    cabinFolder,
                    "CabinWindowMullion",
                    Vector3.new(0.28, 4.6, 0.72),
                    x,
                    -1.5,
                    z - 0.1,
                    trimColor,
                    Enum.Material.Wood,
                    false
                )
            else
                for frameY = -3.9, 0.9, 4.8 do
                    referencePart(
                        cabinFolder,
                        "CabinWindowFrame",
                        Vector3.new(0.72, 0.28, 7),
                        x,
                        frameY,
                        z,
                        trimColor,
                        Enum.Material.Wood,
                        false
                    )
                end
                referencePart(
                    cabinFolder,
                    "CabinWindowMullion",
                    Vector3.new(0.72, 4.6, 0.28),
                    x,
                    -1.5,
                    z,
                    trimColor,
                    Enum.Material.Wood,
                    false
                )
            end
        end
        buildWindow(7.5, -11.6, true)
        buildWindow(-17.6, -0.5, false)
        buildWindow(17.6, -0.5, false)

        for doorX in { -9.2, -3.2 } do
            referencePart(
                cabinFolder,
                "CabinDoorFrame",
                Vector3.new(0.65, 8.5, 0.7),
                doorX,
                -3,
                -11.7,
                trimColor,
                Enum.Material.Wood,
                false
            )
        end
        referencePart(
            cabinFolder,
            "CabinDoorHeader",
            Vector3.new(6.7, 0.65, 0.7),
            -6.2,
            1.25,
            -11.7,
            trimColor,
            Enum.Material.Wood,
            false
        )
        local hinge = referenceCFrame(-9.0, -3, -11.8)
        local openDoor = part(
            cabinFolder,
            "CabinOpenDoor",
            scaledSize(5.2, 8, 0.6),
            hinge * CFrame.Angles(0, math.rad(68), 0) * CFrame.new(2.6 * scale, 0, 0),
            trimColor,
            Enum.Material.WoodPlanks,
            false
        )
        openDoor.CanQuery = false
        part(
            cabinFolder,
            "CabinDoorBrace",
            scaledSize(4.4, 0.45, 0.24),
            openDoor.CFrame * CFrame.Angles(0, 0, math.rad(28)),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
        local handle = part(
            cabinFolder,
            "CabinDoorHandle",
            scaledSize(0.45, 0.45, 0.45),
            openDoor.CFrame * CFrame.new(1.7 * scale, -0.7 * scale, -0.5 * scale),
            Color3.fromRGB(111, 114, 108),
            Enum.Material.Metal,
            false
        )
        handle.Shape = Enum.PartType.Ball

        for stepIndex = 1, 4 do
            referencePart(
                shell,
                "CabinStep",
                Vector3.new(6, 1, 1 + stepIndex),
                -6,
                -7.5 - stepIndex,
                -12.5 - stepIndex * 0.5,
                Color3.fromRGB(88, 91, 86),
                Enum.Material.Cobblestone
            )
        end

        local fireplace = Instance.new("Model")
        fireplace.Name = "CabinFireplace"
        fireplace.Parent = cabinFolder
        local fireplaceParts = {
            { "CabinHearth", 8, 2, 2, -9, -6, 10 },
            { "CabinHearthSide", 1, 7, 1, -12.5, -4.5, 11.5 },
            { "CabinHearthSide", 1, 7, 1, -5.5, -4.5, 11.5 },
            { "CabinHearthLintel", 8, 1, 2, -9, -0.5, 11 },
            { "CabinChimneyBack", 8, 11, 1, -9, -5.5, 14.5 },
            { "CabinChimneySide", 1, 11, 2, -12.5, -5.5, 13 },
            { "CabinChimneySide", 1, 11, 2, -5.5, -5.5, 13 },
            { "CabinChimneyStack", 4, 12, 1, -9, 6, 12.5 },
            { "CabinChimneyStack", 4, 12, 1, -9, 6, 14.5 },
            { "CabinChimneyStack", 1, 12, 1, -10.5, 6, 13.5 },
            { "CabinChimneyStack", 1, 12, 1, -7.5, 6, 13.5 },
            { "CabinChimneyCap", 5, 0.7, 2.2, -9, 12.2, 13.5 },
        }
        for _, spec in fireplaceParts do
            referencePart(
                fireplace,
                spec[1],
                Vector3.new(spec[2], spec[3], spec[4]),
                spec[5],
                spec[6],
                spec[7],
                stoneColor,
                Enum.Material.Cobblestone,
                false
            )
        end
        referencePart(
            fireplace,
            "CabinAshBed",
            Vector3.new(6, 0.5, 3),
            -9,
            -5.5,
            12.5,
            Color3.fromRGB(45, 47, 46),
            Enum.Material.Slate,
            false
        )
        referencePart(
            fireplace,
            "CabinBurningWood",
            Vector3.new(4, 0.65, 0.7),
            -9,
            -4.7,
            12.5,
            WET_BARK,
            Enum.Material.Wood,
            false
        )
        local hearthFire = referencePart(
            fireplace,
            "CabinHearthFire",
            Vector3.new(1.25, 1.45, 1.05),
            -9,
            -3.7,
            12.2,
            accent,
            Enum.Material.Neon,
            false
        )
        hearthFire.Shape = Enum.PartType.Ball
        hearthFire.Transparency = 0.22
        local hearthLight = Instance.new("PointLight")
        hearthLight.Color = accent
        hearthLight.Brightness = 0.45
        hearthLight.Range = 8
        hearthLight.Shadows = true
        hearthLight.Parent = hearthFire
        CollectionService:AddTag(hearthFire, "LastLightAmbientLight")

        local windowLight = Instance.new("PointLight")
        windowLight.Color = accent
        windowLight.Brightness = 0.22
        windowLight.Range = 10
        windowLight.Shadows = false
        local lightAnchor = part(
            cabinFolder,
            "CabinLight",
            Vector3.new(0.2, 0.2, 0.2),
            cabinCFrame(0, 5.4, 2.8),
            accent,
            Enum.Material.Glass,
            false
        )
        lightAnchor.Transparency = 1
        windowLight.Parent = lightAnchor
        local sign = part(
            cabinFolder,
            "CabinSign",
            Vector3.new(6.4, 1.25, 0.35),
            referenceCFrame(6, 3.3, -12.1),
            WET_BARK,
            Enum.Material.WoodPlanks,
            false
        )
        sign.CanQuery = false
        local surface = Instance.new("SurfaceGui")
        surface.Face = Enum.NormalId.Front
        surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        surface.PixelsPerStud = 28
        surface.Parent = sign
        local signText = Instance.new("TextLabel")
        signText.BackgroundTransparency = 1
        signText.Size = UDim2.fromScale(1, 1)
        signText.Font = Enum.Font.GothamBold
        signText.Text = string.upper(name)
        signText.TextColor3 = accent
        signText.TextScaled = true
        signText.Parent = surface

        if name == "MARA'S SHELTER" then
            local cot = part(
                cabinFolder,
                "MaraCot",
                Vector3.new(5.2, 0.55, 2.7),
                cabinCFrame(4.2, 1.0, 3.5),
                Color3.fromRGB(96, 112, 83),
                Enum.Material.Fabric,
                false
            )
            cot.CanQuery = false
            local tableTop = part(
                cabinFolder,
                "MaraWorkTable",
                Vector3.new(4.2, 0.45, 2.5),
                cabinCFrame(4.5, 2.15, -3.2),
                Color3.fromRGB(89, 64, 43),
                Enum.Material.WoodPlanks,
                false
            )
            tableTop.CanQuery = false
            for jarIndex = -1, 1 do
                local jar = part(
                    cabinFolder,
                    "MemoryJar",
                    Vector3.new(0.7, 1.05, 0.7),
                    cabinCFrame(4.5 + jarIndex * 1.1, 2.9, -3.2),
                    if jarIndex == 0 then FOXFIRE else AMBER,
                    Enum.Material.Glass,
                    false
                )
                jar.Shape = Enum.PartType.Cylinder
                jar.Transparency = 0.22
                jar.CanQuery = false
            end
        else
            for bedIndex = -1, 1, 2 do
                local bedroll = part(
                    cabinFolder,
                    "WayfarerBedroll",
                    Vector3.new(4.8, 0.45, 2.3),
                    cabinCFrame(3.5 + bedIndex * 3.6, 0.95, 3.8),
                    if bedIndex < 0
                        then Color3.fromRGB(127, 91, 58)
                        else Color3.fromRGB(72, 104, 82),
                    Enum.Material.Fabric,
                    false
                )
                bedroll.CanQuery = false
            end
            local trunk = part(
                cabinFolder,
                "WayfarerTrunk",
                Vector3.new(4.4, 2.3, 2.5),
                cabinCFrame(5.2, 1.2, -3.6),
                Color3.fromRGB(88, 61, 39),
                Enum.Material.WoodPlanks,
                false
            )
            trunk.CanQuery = false
        end

        local rug = part(
            cabinFolder,
            "CabinWovenRug",
            Vector3.new(6.4, 0.12, 3.4),
            cabinCFrame(2.5, 0.68, -0.1),
            if name == "MARA'S SHELTER"
                then Color3.fromRGB(70, 112, 102)
                else Color3.fromRGB(132, 88, 54),
            Enum.Material.Fabric,
            false
        )
        rug.CanQuery = false

        local shelf = part(
            cabinFolder,
            "CabinSupplyShelf",
            Vector3.new(4.8, 0.35, 1.15),
            cabinCFrame(4.5, 5.15, 7.5),
            Color3.fromRGB(92, 65, 43),
            Enum.Material.WoodPlanks,
            false
        )
        shelf.CanQuery = false
        for supplyIndex = -1, 1 do
            local supply = part(
                cabinFolder,
                if name == "MARA'S SHELTER" then "MaraHerbBundle" else "WayfarerSupply",
                Vector3.new(0.85, 1.05 + math.abs(supplyIndex) * 0.2, 0.75),
                shelf.CFrame + Vector3.new(supplyIndex * 1.35, 0.7, 0),
                if supplyIndex == 0 then accent else Color3.fromRGB(121, 96, 58),
                if name == "MARA'S SHELTER" then Enum.Material.Grass else Enum.Material.Fabric,
                false
            )
            supply.CanQuery = false
        end

        local stoolSeat = part(
            cabinFolder,
            "CabinStoolSeat",
            Vector3.new(2.1, 0.35, 2.1),
            cabinCFrame(5.2, 1.9, 0.3),
            Color3.fromRGB(91, 64, 42),
            Enum.Material.WoodPlanks,
            false
        )
        stoolSeat.CanQuery = false
        for legX = -1, 1, 2 do
            for legZ = -1, 1, 2 do
                part(
                    cabinFolder,
                    "CabinStoolLeg",
                    Vector3.new(0.28, 1.8, 0.28),
                    stoolSeat.CFrame * CFrame.new(legX * 0.72, -1.0, legZ * 0.72),
                    WET_BARK,
                    Enum.Material.Wood,
                    false
                )
            end
        end

        local woodpile = Instance.new("Model")
        woodpile.Name = "CabinWoodpile"
        woodpile.Parent = cabinFolder
        for logIndex = 1, 5 do
            local row = math.floor((logIndex - 1) / 3)
            part(
                woodpile,
                "SplitFirewood",
                Vector3.new(2.8, 0.65, 0.72),
                cabinCFrame(-14.5, -1.45 + row * 0.62, 2.5 + ((logIndex - 1) % 3) * 0.78)
                    * CFrame.Angles(0, math.rad(4 * logIndex), math.rad((logIndex % 2) * 5)),
                if logIndex % 2 == 0 then BARK else WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
        local physicalParts = 0
        for _, descendant in cabinFolder:GetDescendants() do
            if descendant:IsA("BasePart") then
                physicalParts += 1
            end
        end
        cabinFolder:SetAttribute("ConstructionPattern", "place6_reference_adapted")
        cabinFolder:SetAttribute("PhysicalPartCount", physicalParts)
        cabinFolder:SetAttribute("FacesMainStreet", true)
        cabinFolder:SetAttribute("TownYawDegrees", math.deg(yaw))
        return shell
    end

    local shells = {
        cabin(Vector3.new(-36, 0, -112), math.rad(-90), "WAYFARER CABIN", AMBER),
        cabin(Vector3.new(36, 0, -112), math.rad(90), "MARA'S SHELTER", FOXFIRE),
    }

    local commons = Instance.new("Model")
    commons.Name = "EmberhollowCampCommons"
    commons.Parent = parent
    local commonsCenter = Vector3.new(70, 0, -132)
    local commonsTable = part(
        commons,
        "CampCommonsTable",
        Vector3.new(10.5, 0.55, 3.6),
        CFrame.new(commonsCenter + Vector3.new(0, 2.5, 0)),
        Color3.fromRGB(96, 67, 44),
        Enum.Material.WoodPlanks,
        false
    )
    commonsTable.CanQuery = false
    for side = -1, 1, 2 do
        part(
            commons,
            "CampCommonsBench",
            Vector3.new(10, 0.48, 1.25),
            CFrame.new(commonsCenter + Vector3.new(0, 1.4, side * 3.2)),
            Color3.fromRGB(84, 60, 42),
            Enum.Material.WoodPlanks,
            false
        )
    end
    for legX = -1, 1, 2 do
        for legZ = -1, 1, 2 do
            part(
                commons,
                "CampCommonsTableLeg",
                Vector3.new(0.48, 2.2, 0.48),
                commonsTable.CFrame * CFrame.new(legX * 4.2, -1.28, legZ * 1.15),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
    end
    for supplyIndex = 1, 5 do
        local supply = part(
            commons,
            "CampMealSupply",
            Vector3.new(0.9, 0.7 + (supplyIndex % 2) * 0.35, 0.9),
            commonsTable.CFrame
                * CFrame.new(-3.4 + supplyIndex * 1.4, 0.72, (supplyIndex % 2 - 0.5) * 1.1),
            if supplyIndex % 3 == 0
                then AMBER
                elseif supplyIndex % 2 == 0 then Color3.fromRGB(124, 141, 77)
                else Color3.fromRGB(132, 94, 60),
            if supplyIndex % 3 == 0 then Enum.Material.Glass else Enum.Material.Fabric,
            false
        )
        supply.CanQuery = false
    end

    local townStreet = part(
        parent,
        "TownMainStreet",
        Vector3.new(16, 0.52, 116),
        CFrame.new(0, 0.48, -116),
        Color3.fromRGB(76, 55, 37),
        Enum.Material.Ground,
        false
    )
    townStreet.CanQuery = false
    local streetWear = part(
        parent,
        "TownMainStreetWear",
        Vector3.new(6.5, 0.14, 114),
        CFrame.new(0, 0.82, -116),
        Color3.fromRGB(112, 82, 49),
        Enum.Material.Mud,
        false
    )
    streetWear.CanQuery = false
    local square = part(
        parent,
        "FirstLanternTownSquare",
        Vector3.new(35, 0.56, 35),
        CFrame.new(courtyard + Vector3.new(0, 0.52, 0)),
        Color3.fromRGB(83, 64, 44),
        Enum.Material.Ground,
        false
    )
    square.CanQuery = false
    for _, pathSpec in
        {
            { Vector3.new(-10, 0.84, -113), Vector3.new(-27.5, 0.84, -116.5) },
            { Vector3.new(10, 0.84, -111), Vector3.new(27.5, 0.84, -107.5) },
        }
    do
        local start = pathSpec[1]
        local finish = pathSpec[2]
        local delta = finish - start
        local entryPath = part(
            parent,
            "CabinEntryPath",
            Vector3.new(6.5, 0.18, delta.Magnitude + 1),
            CFrame.lookAt((start + finish) / 2, finish),
            Color3.fromRGB(101, 76, 48),
            Enum.Material.Mud,
            false
        )
        entryPath.CanQuery = false
    end

    for index = 1, 16 do
        local angle = (index / 16) * math.pi * 2
        local xDirection = math.cos(angle)
        local zDirection = math.sin(angle)
        -- Leave four obvious gates: north/south for the main street and
        -- east/west for the cabin paths. These stones are visual edging, not
        -- player collision.
        if math.abs(xDirection) > 0.28 and math.abs(zDirection) > 0.28 then
            local stone = part(
                parent,
                "TownSquareEdgeStone",
                Vector3.new(2.4, 0.75, 1.6),
                CFrame.new(courtyard + Vector3.new(xDirection * 16.3, 0.86, zDirection * 16.3))
                    * CFrame.Angles(0.08, angle, 0.12),
                Color3.fromRGB(78, 82, 74),
                Enum.Material.Slate,
                false
            )
            stone.Shape = Enum.PartType.Ball
        end
    end
    for side = -1, 1, 2 do
        local benchZ = if side < 0 then -100 else -124
        local bench = part(
            parent,
            "LanternBench",
            Vector3.new(7, 0.7, 1.6),
            CFrame.new(side * 19.5, 1.2, benchZ) * CFrame.Angles(0, math.rad(90), 0),
            Color3.fromRGB(91, 65, 45),
            Enum.Material.WoodPlanks
        )
        bench.CanQuery = false
        for leg = -1, 1, 2 do
            local support = part(
                parent,
                "LanternBenchLeg",
                Vector3.new(0.45, 1.2, 1.1),
                CFrame.new(side * 19.5, 0.6, benchZ + leg * 2.1),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
            support.CanQuery = false
        end
    end
    labelSign(
        parent,
        CFrame.new(0, 3.2, -95) * CFrame.Angles(0, math.pi, 0),
        "EMBERHOLLOW · SAFE CAMP"
    )
    return shells
end

local function lantern(
    parent: Instance,
    at: Vector3,
    scale: number,
    ambientLightTag: string?
): Model
    local model = Instance.new("Model")
    model.Name = "ProceduralLanternPost"
    model.Parent = parent
    local post = part(
        model,
        "LanternPost",
        Vector3.new(0.8 * scale, 7 * scale, 0.8 * scale),
        CFrame.new(at + Vector3.new(0, 3.5 * scale, 0)),
        BARK,
        Enum.Material.Wood
    )
    local glow = part(
        model,
        "LanternGlow",
        Vector3.new(2.1 * scale, 2.7 * scale, 2.1 * scale),
        CFrame.new(at + Vector3.new(0, 6.2 * scale, 0)),
        AMBER,
        Enum.Material.Neon,
        false
    )
    glow.Shape = Enum.PartType.Ball
    glow.Transparency = 0.12
    local light = Instance.new("PointLight")
    light.Color = AMBER
    light.Brightness = 2.4
    light.Range = 24 * scale
    -- Keep the sanctuary's key lantern as the only strong shadow source. The
    -- route lights are guidance, not a second sun, which keeps mobile scenes
    -- readable and avoids a wall of competing shadows.
    light.Shadows = false
    light.Parent = glow
    if ambientLightTag ~= nil then
        CollectionService:AddTag(glow, ambientLightTag)
    end
    model.PrimaryPart = post
    return model
end

local function groundPatch(
    parent: Instance,
    position: Vector3,
    size: Vector3,
    color: Color3,
    material: Enum.Material
)
    local patch = part(
        parent,
        "WetGroundPatch",
        size,
        CFrame.new(position + Vector3.new(0, 0.18, 0)) * CFrame.Angles(0, position.X * 0.017, 0),
        color,
        material,
        false
    )
    patch.Transparency = 0.08
    patch.CanQuery = false
    return patch
end

local function mistSheet(
    parent: Instance,
    name: string,
    position: Vector3,
    size: Vector3,
    color: Color3,
    transparency: number
)
    local mist = part(parent, name, size, CFrame.new(position), color, Enum.Material.Glass, false)
    mist.Transparency = transparency
    mist.CastShadow = false
    mist.CanQuery = false
    return mist
end

local function emberDrift(
    parent: Instance,
    position: Vector3,
    color: Color3,
    count: number,
    spread: number,
    ambientTag: string?
)
    local random = Random.new(math.floor(position.X * 17 + position.Z * 31))
    for _ = 1, count do
        local mote = part(
            parent,
            "FloatingMote",
            Vector3.new(0.16, 0.16, 0.16),
            CFrame.new(
                position
                    + Vector3.new(
                        random:NextNumber(-spread, spread),
                        random:NextNumber(1.5, 8),
                        random:NextNumber(-spread, spread)
                    )
            ),
            color,
            Enum.Material.Neon,
            false
        )
        mote.Shape = Enum.PartType.Ball
        mote.Transparency = random:NextNumber(0.1, 0.35)
        mote.CanQuery = false
        if ambientTag ~= nil then
            CollectionService:AddTag(mote, ambientTag)
        end
    end
end

local function addFillLight(
    parent: Instance,
    position: Vector3,
    color: Color3,
    brightness: number,
    range: number
)
    local source = part(
        parent,
        "HiddenAtmosphereLight",
        Vector3.new(0.4, 0.4, 0.4),
        CFrame.new(position),
        color,
        Enum.Material.Neon,
        false
    )
    source.Transparency = 1
    source.CanQuery = false
    local light = Instance.new("PointLight")
    light.Color = color
    light.Brightness = brightness
    light.Range = range
    light.Shadows = false
    light.Parent = source
end

local function addBillboard(
    partInstance: BasePart,
    title: string,
    accent: Color3,
    maxDistance: number?
)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "WorldLabel"
    billboard.Adornee = partInstance
    billboard.AlwaysOnTop = false
    billboard.LightInfluence = 0.35
    billboard.Size = UDim2.fromOffset(165, 38)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.6, 0)
    billboard.MaxDistance = maxDistance or 20
    billboard.Parent = partInstance

    local text = Instance.new("TextLabel")
    text.BackgroundColor3 = Color3.fromRGB(16, 25, 23)
    text.BackgroundTransparency = 0.18
    text.BorderSizePixel = 0
    text.Size = UDim2.fromScale(1, 1)
    text.Font = Enum.Font.GothamBold
    text.Text = title
    text.TextColor3 = accent
    text.TextScaled = false
    text.TextSize = 12
    text.TextWrapped = true
    text.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = text
end

local function _addObjectIcon(partInstance: BasePart, kind: string, accent: Color3)
    local existing = partInstance:FindFirstChild("ObjectIcon")
    if existing ~= nil then
        existing:Destroy()
    end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ObjectIcon"
    billboard.Adornee = partInstance
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.Size = UDim2.fromOffset(44, 44)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 5.8, 0)
    billboard.MaxDistance = 72
    billboard.Parent = partInstance

    local glyph = Instance.new("TextLabel")
    glyph.Name = "IconGlyph"
    glyph.BackgroundColor3 = Color3.fromRGB(10, 21, 19)
    glyph.BackgroundTransparency = 0.05
    glyph.BorderSizePixel = 0
    glyph.Size = UDim2.fromScale(1, 1)
    glyph.Font = Enum.Font.GothamBold
    glyph.Text = if kind == "axe"
        then "⚒"
        elseif kind == "hammer" then "✚"
        elseif kind == "torch" or kind == "lantern" then "✦"
        elseif kind == "heartwood" then "◉"
        elseif kind == "barricade" then "▰"
        elseif kind == "satchel" then "▣"
        elseif kind == "charm" then "◆"
        elseif kind == "hood" then "⌂"
        elseif kind == "boots" then "≋"
        else "✦"
    glyph.TextColor3 = accent
    glyph.TextScaled = true
    glyph.ZIndex = 10
    glyph.Parent = billboard
    local glyphCorner = Instance.new("UICorner")
    glyphCorner.CornerRadius = UDim.new(0, 10)
    glyphCorner.Parent = glyph

    local viewport = Instance.new("ViewportFrame")
    viewport.Name = "IconViewport"
    viewport.Size = UDim2.fromScale(1, 1)
    viewport.BackgroundColor3 = Color3.fromRGB(15, 27, 24)
    viewport.BackgroundTransparency = 0.08
    viewport.BorderSizePixel = 0
    viewport.Ambient = Color3.fromRGB(210, 224, 212)
    viewport.LightColor = Color3.fromRGB(255, 214, 146)
    viewport.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = viewport

    local worldModel = Instance.new("WorldModel")
    worldModel.Parent = viewport
    local camera = Instance.new("Camera")
    camera.CFrame = CFrame.new(0, 0.2, 6) * CFrame.Angles(0, math.rad(16), 0)
    camera.FieldOfView = 28
    camera.Parent = viewport
    viewport.CurrentCamera = camera

    local function iconPart(
        name: string,
        size: Vector3,
        position: Vector3,
        color: Color3,
        material: Enum.Material,
        shape: Enum.PartType?
    )
        local icon = Instance.new("Part")
        icon.Name = name
        icon.Anchored = true
        icon.CanCollide = false
        icon.CanQuery = false
        icon.Size = size
        icon.Position = position
        icon.Color = color
        icon.Material = material
        icon.Shape = shape or Enum.PartType.Block
        icon.Parent = worldModel
        return icon
    end

    if kind == "heartwood" then
        iconPart(
            "Trunk",
            Vector3.new(1.5, 2.5, 1.5),
            Vector3.new(0, -0.5, 0),
            BARK,
            Enum.Material.Wood,
            Enum.PartType.Cylinder
        )
        iconPart(
            "Core",
            Vector3.new(1.2, 1.2, 1.2),
            Vector3.new(0, 0.65, 0),
            accent,
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
    elseif kind == "axe" then
        iconPart(
            "Handle",
            Vector3.new(0.25, 2.8, 0.25),
            Vector3.new(0, -0.1, 0),
            BARK,
            Enum.Material.Wood
        )
        iconPart(
            "Blade",
            Vector3.new(1.25, 0.9, 0.22),
            Vector3.new(0.35, 0.85, 0),
            accent,
            Enum.Material.Metal
        )
    elseif kind == "hammer" then
        iconPart(
            "Handle",
            Vector3.new(0.25, 2.6, 0.25),
            Vector3.new(0, -0.1, 0),
            BARK,
            Enum.Material.Wood
        )
        iconPart(
            "Head",
            Vector3.new(1.6, 0.55, 0.55),
            Vector3.new(0, 0.95, 0),
            accent,
            Enum.Material.Metal
        )
    elseif kind == "torch" or kind == "lantern" then
        iconPart(
            "Handle",
            Vector3.new(0.28, 2.1, 0.28),
            Vector3.new(0, -0.45, 0),
            BARK,
            Enum.Material.Wood
        )
        iconPart(
            "Flame",
            Vector3.new(1.2, 1.5, 1.2),
            Vector3.new(0, 0.75, 0),
            accent,
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
    elseif kind == "satchel" then
        iconPart(
            "Bag",
            Vector3.new(2.1, 1.6, 1.2),
            Vector3.new(0, -0.15, 0),
            accent,
            Enum.Material.Fabric
        )
        iconPart(
            "Strap",
            Vector3.new(0.22, 2.2, 0.2),
            Vector3.new(0, 0.15, 0.65),
            BARK,
            Enum.Material.Wood
        )
    elseif kind == "charm" then
        iconPart(
            "Gem",
            Vector3.new(1.35, 1.35, 1.35),
            Vector3.new(0, 0, 0),
            accent,
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
        iconPart(
            "Ring",
            Vector3.new(0.22, 1.9, 1.9),
            Vector3.new(0, 0, 0),
            FOXFIRE,
            Enum.Material.Metal,
            Enum.PartType.Cylinder
        )
    elseif kind == "hood" then
        iconPart(
            "Hood",
            Vector3.new(2.2, 1.7, 1.7),
            Vector3.new(0, 0.1, 0),
            accent,
            Enum.Material.Fabric
        )
        iconPart(
            "Rim",
            Vector3.new(2.5, 0.25, 1.8),
            Vector3.new(0, -0.75, -0.1),
            DARK_GREEN,
            Enum.Material.Wood
        )
    elseif kind == "boots" then
        iconPart(
            "LeftBoot",
            Vector3.new(0.8, 1.45, 1.6),
            Vector3.new(-0.55, -0.2, 0),
            accent,
            Enum.Material.Fabric
        )
        iconPart(
            "RightBoot",
            Vector3.new(0.8, 1.45, 1.6),
            Vector3.new(0.55, -0.2, 0),
            accent,
            Enum.Material.Fabric
        )
    else
        iconPart(
            "Marker",
            Vector3.new(1.4, 1.4, 1.4),
            Vector3.new(0, 0, 0),
            accent,
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
    end
end

function WorldService.new(
    logger: Logger,
    extractionPayoff: any,
    townProgression: any,
    professionAbilityVisuals: any
): WorldService
    return setmetatable({
        Name = WorldService.Name,
        _logger = logger,
        _extractionPayoff = extractionPayoff,
        _townProgression = townProgression,
        _professionAbilityVisuals = professionAbilityVisuals,
        _runtimeIds = nil,
        _world = nil,
        _interactions = {},
        _spawn = nil,
        _mara = nil,
        _lantern = nil,
        _lanternVisualHealth = 100,
        _beacon = nil,
        _barricadeBuilt = false,
        _dusk = false,
        _duskSignals = {},
        _nightDefenseSignals = {},
        _nightThemeDressing = nil,
        _breachActive = false,
        _night = false,
        _blackoutLightingActive = false,
        _expeditionEntry = nil,
        _expeditionManifest = nil,
        _expeditionModuleCenters = {},
        _eventSockets = {},
        _eventTargets = {},
        _eventsEnabled = true,
        _oldGrowthArena = nil,
        _wardenStagArena = nil,
        _blackoutArena = nil,
        _characterRoots = {},
        _townConsequence = nil,
        _townCondition = { integrity = 100, damageLevel = 0, repairsRemaining = 0 },
        _townResidents = {},
        _townIncidentModel = nil,
        _engineerBraceModel = nil,
        _meshTemplateLoader = MeshTemplateLoader.new(logger),
        _meshPlacements = {},
    }, WorldService)
end

function WorldService._registerInteraction(
    self: WorldService,
    target: BasePart,
    interactionId: string,
    actionId: string,
    actionText: string,
    objectText: string,
    payload: string?,
    holdDuration: number?
)
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = interactionId
    prompt.ActionText = actionText
    prompt.ObjectText = objectText
    prompt.HoldDuration = holdDuration or 0
    prompt.MaxActivationDistance = 12
    prompt.RequiresLineOfSight = false
    prompt.Style = Enum.ProximityPromptStyle.Custom
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
    prompt:SetAttribute("InteractionId", interactionId)
    prompt:SetAttribute("ActionId", actionId)
    if payload ~= nil then
        prompt:SetAttribute("Payload", payload)
    end
    prompt.Parent = target
    CollectionService:AddTag(prompt, self._runtimeIds.InteractionTag)
    self._interactions[interactionId] = prompt
end

function WorldService._configureLighting(_self: WorldService)
    Lighting.ClockTime = 6.65
    Lighting.Brightness = 2.05
    Lighting.Ambient = DAY_AMBIENT
    Lighting.OutdoorAmbient = Color3.fromRGB(72, 91, 84)
    Lighting.EnvironmentDiffuseScale = 0.72
    Lighting.EnvironmentSpecularScale = 0.48
    Lighting.GlobalShadows = true
    Lighting.ExposureCompensation = -0.18
    pcall(function()
        Lighting.ShadowSoftness = 0.42
        Lighting.GeographicLatitude = 51
    end)
    for _, name in
        {
            "LastLightAtmosphere",
            "LastLightBloom",
            "LastLightRays",
            "LastLightTone",
            "LastLightDepth",
        }
    do
        local existing = Lighting:FindFirstChild(name)
        if existing ~= nil then
            existing:Destroy()
        end
    end
    local existingClouds = Workspace.Terrain:FindFirstChild("LastLightClouds")
    if existingClouds ~= nil then
        existingClouds:Destroy()
    end

    -- Distant terrain peaks (TerrainBuilder reaches WORLD_EXTENT = 1450 studs)
    -- were reported washing out to a pale white smear instead of reading as a
    -- ridgeline. Atmosphere applies aerial perspective: with Haze and Glare
    -- above 0, the distant hue transitions from Atmosphere.Color toward
    -- Atmosphere.Decay as fog accumulates with distance. There is no sightline
    -- in the supplied Place6 reference (a small enclosed camp) anywhere near
    -- 1450 studs to have exposed this: its own Atmosphere -- Density 0.225,
    -- Haze 1, Color (199, 199, 199) -- is close to Roblox's stock defaults and
    -- was never tested at range either.
    --
    -- Some fade-to-fog at that distance is correct and even desirable -- it is
    -- what makes far terrain read as *distant*. The bug is the fade targets:
    -- Color (166, 185, 174) and Decay (43, 63, 61) both sat pale/washed rather
    -- than a readable rock tone, so anything far enough to have faded toward
    -- them read as near-white. Both are now a darker, more saturated
    -- slate-blue, which keeps the same falloff behavior but fades distant
    -- peaks toward a moody ridgeline silhouette instead of a blown-out white
    -- one -- consistent with the style formula's "slate blue-gray stone" and
    -- "moon cyan: distance" anchors. Density and Haze are also both eased back
    -- so full fade happens further out, giving mid-distance terrain more room
    -- to read as rock before it starts blending away.
    --
    -- These daytime values are duplicated in _applyTownLighting's `else`
    -- branch, which re-runs this same Atmosphere on every day/dusk transition
    -- and overwrites whatever is set here. Change both together or the fix
    -- reverts the moment a day/night cycle turns over.
    local atmosphere = Instance.new("Atmosphere")
    atmosphere.Name = "LastLightAtmosphere"
    atmosphere.Color = Color3.fromRGB(74, 89, 98)
    atmosphere.Decay = Color3.fromRGB(38, 52, 58)
    atmosphere.Density = 0.24
    atmosphere.Offset = 0.08
    atmosphere.Glare = 0.15
    atmosphere.Haze = 1.0
    atmosphere.Parent = Lighting

    local bloom = Instance.new("BloomEffect")
    bloom.Name = "LastLightBloom"
    bloom.Intensity = 0.34
    bloom.Size = 46
    bloom.Threshold = 0.82
    bloom.Parent = Lighting

    local rays = Instance.new("SunRaysEffect")
    rays.Name = "LastLightRays"
    rays.Intensity = 0.14
    rays.Spread = 0.72
    rays.Parent = Lighting

    local tone = Instance.new("ColorCorrectionEffect")
    tone.Name = "LastLightTone"
    tone.Brightness = -0.03
    tone.Contrast = 0.24
    tone.Saturation = -0.04
    tone.TintColor = Color3.fromRGB(232, 238, 224)
    tone.Parent = Lighting

    local depth = Instance.new("DepthOfFieldEffect")
    depth.Name = "LastLightDepth"
    depth.FarIntensity = 0.28
    depth.FocusDistance = 95
    depth.InFocusRadius = 70
    depth.NearIntensity = 0.04
    depth.Parent = Lighting

    local clouds = Instance.new("Clouds")
    clouds.Name = "LastLightClouds"
    clouds.Color = Color3.fromRGB(118, 137, 132)
    clouds.Cover = 0.68
    clouds.Density = 0.58
    clouds.Parent = Workspace.Terrain
end

--[[
    Depth bands for the generated forest: near framing, regional mid-ground,
    distant silhouette. Density falls with distance because far trees only
    contribute silhouette, and spending parts on them is what pushes a mobile
    device over budget.
]]
local FOREST_BANDS = table.freeze({
    table.freeze({ inner = 64, outer = 168, count = 74, minScale = 0.85, maxScale = 1.5 }),
    table.freeze({ inner = 168, outer = 340, count = 86, minScale = 1.1, maxScale = 1.9 }),
    table.freeze({ inner = 340, outer = 620, count = 64, minScale = 1.5, maxScale = 2.6 }),
})

-- Trees are never planted inside this corridor around the walkable route.
local ROUTE_HALF_WIDTH = 26

--[[
    Authored structures the forest must not grow into, as {x, z, radius}.

    A corridor test alone is not enough: it only protects the walkable route,
    so band 1 (radius 64-168) could still drop a collidable trunk through the
    workshop roof, onto a mastery dais, or across a crafting bench, all of
    which sit outside the corridor. Radii are sized for a canopy rather than a
    trunk, because the visible problem is a tree overhanging a building, not
    just its base intersecting one.
]]
local FOLIAGE_KEEP_OUT = table.freeze({
    table.freeze({ x = -36, z = -112, radius = 30 }), -- Wayfarer cabin lot
    table.freeze({ x = 36, z = -112, radius = 30 }), -- Mara's shelter lot
    table.freeze({ x = 0, z = -112, radius = 36 }), -- lantern square
    table.freeze({ x = -42, z = -142, radius = 32 }), -- western workshop district
    table.freeze({ x = 42, z = -142, radius = 32 }), -- eastern workshop district
    table.freeze({ x = -78, z = -76, radius = 22 }), -- Scout mastery clearing
    table.freeze({ x = 78, z = -76, radius = 22 }), -- Warden mastery clearing
    table.freeze({ x = -78, z = -168, radius = 22 }), -- Engineer mastery clearing
    table.freeze({ x = 78, z = -168, radius = 22 }), -- Medic mastery clearing
    table.freeze({ x = -70, z = -128, radius = 25 }), -- Wayfarer inn
    table.freeze({ x = 72, z = -100, radius = 24 }), -- Greenward garden
    table.freeze({ x = 70, z = -132, radius = 18 }), -- camp commons
    table.freeze({ x = -20, z = -132, radius = 10 }), -- field-book archive
    table.freeze({ x = 38, z = -48, radius = 12 }), -- Heartwood gathering lot
    table.freeze({ x = -42, z = -68, radius = 18 }), -- starter-tool yard
    table.freeze({ x = -44, z = -92, radius = 16 }), -- barricade work lot
    table.freeze({ x = 0, z = -143, radius = 26 }), -- night watch posts
    table.freeze({ x = 78, z = -42, radius = 22 }), -- authored root arch landmark
    table.freeze({ x = -78, z = -44, radius = 24 }), -- hollow lantern shrine landmark
})

--[[
    True when a position is clear of the route corridor and every authored
    structure, so foliage may be planted there.
]]
local function isFoliagePlantable(x: number, z: number): boolean
    if math.abs(x) <= ROUTE_HALF_WIDTH and z <= 20 and z >= -200 then
        return false
    end

    for _, keepOut in FOLIAGE_KEEP_OUT do
        local dx = x - keepOut.x
        local dz = z - keepOut.z
        if dx * dx + dz * dz < keepOut.radius * keepOut.radius then
            return false
        end
    end

    return true
end

--[[
    Plants one depth band of the forest.

    Each band owns a Random seeded from its own index rather than sharing one
    sequential generator. That is what lets band 1 be planted before the world
    is ready and bands 2-3 afterwards without changing what either produces: a
    shared generator would make every tree depend on how much of the rest of
    the build had already consumed from it, so deferring a band would silently
    reshape the whole forest -- and the firefly loop draws from the same
    generator, so it would have reshaped it differently depending on timing.
]]
local function plantForestBand(
    forest: Instance,
    bandIndex: number,
    swayTag: string?,
    meshPlacements: { MeshPlacement }?
)
    local band = FOREST_BANDS[bandIndex]
    local random = Random.new(1847 + bandIndex * 7919)
    local treeSeed = 4100 + bandIndex * 1000

    for _ = 1, band.count do
        local angle = random:NextNumber(0, math.pi * 2)
        local radius = random:NextNumber(band.inner, band.outer)
        local x = math.cos(angle) * radius
        local z = math.sin(angle) * radius - 70

        if isFoliagePlantable(x, z) then
            -- Sit the trunk on the real surface. Bands 2 and 3 reach 340 and
            -- 620 studs, well past the flat bowl, where the ground rises by up
            -- to ~90 studs; planting at a hardcoded y = 0 buried exactly the
            -- depth layers this scatter exists to create.
            local position = Vector3.new(x, TerrainBuilder.surfaceHeight(x, z), z)
            treeSeed += 1
            local scale = random:NextNumber(band.minScale, band.maxScale)
            local roll = random:NextNumber()

            if roll < 0.62 then
                if bandIndex == 1 and meshPlacements ~= nil and treeSeed % 3 == 0 then
                    table.insert(meshPlacements, {
                        assetId = if treeSeed % 2 == 0
                            then "mesh_conifer_hero_a"
                            else "mesh_conifer_hero_b",
                        fallbackKind = "conifer",
                        position = position,
                        scale = scale,
                        yaw = random:NextNumber(0, math.pi * 2),
                        seed = treeSeed,
                        swayTag = swayTag,
                    })
                else
                    FoliageBuilder.conifer(forest, position, scale, FOLIAGE_TONE, treeSeed, swayTag)
                end
            elseif roll < 0.9 then
                if bandIndex == 1 and meshPlacements ~= nil and treeSeed % 3 == 0 then
                    table.insert(meshPlacements, {
                        assetId = "mesh_broadleaf_hero_a",
                        fallbackKind = "broadleaf",
                        position = position,
                        scale = scale,
                        yaw = random:NextNumber(0, math.pi * 2),
                        seed = treeSeed,
                        swayTag = swayTag,
                    })
                else
                    FoliageBuilder.broadleaf(
                        forest,
                        position,
                        scale,
                        FOLIAGE_TONE,
                        treeSeed,
                        swayTag
                    )
                end
            else
                FoliageBuilder.snag(forest, position, scale, FOLIAGE_TONE, treeSeed)
            end

            -- Ground detail only in the near band, where the camera can
            -- actually resolve it.
            if bandIndex == 1 then
                if treeSeed % 3 == 0 then
                    local boulderPosition = position
                        + Vector3.new(random:NextNumber(-12, 12), 0, random:NextNumber(-12, 12))
                    local boulderScale = random:NextNumber(0.7, 1.5)
                    if meshPlacements ~= nil and treeSeed % 2 == 0 then
                        table.insert(meshPlacements, {
                            assetId = "mesh_boulder_cluster_a",
                            fallbackKind = "boulders",
                            position = boulderPosition,
                            scale = boulderScale,
                            yaw = random:NextNumber(0, math.pi * 2),
                            seed = treeSeed,
                            swayTag = nil,
                        })
                    else
                        FoliageBuilder.boulders(
                            forest,
                            boulderPosition,
                            boulderScale,
                            FOLIAGE_TONE,
                            treeSeed
                        )
                    end
                end
                if treeSeed % 4 == 0 then
                    local fernPosition = position
                        + Vector3.new(random:NextNumber(-9, 9), 0, random:NextNumber(-9, 9))
                    local fernScale = random:NextNumber(0.8, 1.5)
                    if meshPlacements ~= nil and treeSeed % 8 == 0 then
                        table.insert(meshPlacements, {
                            assetId = "mesh_fern_cluster_a",
                            fallbackKind = "undergrowth",
                            position = fernPosition,
                            scale = fernScale,
                            yaw = random:NextNumber(0, math.pi * 2),
                            seed = treeSeed,
                            swayTag = swayTag,
                        })
                    else
                        FoliageBuilder.undergrowth(
                            forest,
                            fernPosition,
                            fernScale,
                            FOLIAGE_TONE,
                            treeSeed,
                            swayTag
                        )
                    end
                end
                if treeSeed % 11 == 0 then
                    local deadfallPosition = position
                        + Vector3.new(random:NextNumber(-10, 10), 0, random:NextNumber(-10, 10))
                    local deadfallScale = random:NextNumber(0.7, 1.3)
                    if meshPlacements ~= nil then
                        table.insert(meshPlacements, {
                            assetId = "mesh_deadfall_a",
                            fallbackKind = "deadfall",
                            position = deadfallPosition,
                            scale = deadfallScale,
                            yaw = random:NextNumber(0, math.pi * 2),
                            seed = treeSeed,
                            swayTag = nil,
                        })
                    else
                        FoliageBuilder.deadfall(
                            forest,
                            deadfallPosition,
                            deadfallScale,
                            FOLIAGE_TONE,
                            treeSeed
                        )
                    end
                end
            end
        end
    end
end

function WorldService._buildEnvironment(_self: WorldService, world: Model)
    local geometry = Instance.new("Folder")
    geometry.Name = "Environment"
    geometry.Parent = world

    -- Real sculpted Terrain instead of a 320 x 6 x 340 Part. The valley floor
    -- every authored coordinate below sits on stays flat at y = 0; all relief
    -- happens outside it. See TerrainBuilder for why that split matters.
    --
    -- Core only: this runs before ArrivalSpawn exists and before the world is
    -- marked ready, so it covers the ground a player can stand on and stops
    -- there. The horizon is filled in by _buildDistantScenery once joining is
    -- unblocked.
    TerrainBuilder.buildCore()

    groundPatch(
        geometry,
        Vector3.new(0, 0, -70),
        Vector3.new(96, 0.28, 180),
        Color3.fromRGB(43, 63, 45),
        Enum.Material.LeafyGrass
    )
    mistSheet(
        geometry,
        "LowMorningMist",
        Vector3.new(0, 2.3, -86),
        Vector3.new(190, 1.4, 250),
        Color3.fromRGB(132, 158, 151),
        0.82
    )

    local route = {
        Vector3.new(0, 0.42, 0),
        Vector3.new(-3, 0.42, -28),
        Vector3.new(20, 0.42, -48),
        Vector3.new(0, 0.42, -68),
        Vector3.new(-20, 0.42, -88),
        Vector3.new(0, 0.42, -112),
        Vector3.new(0, 0.42, -148),
    }

    for segment = 1, #route - 1 do
        local start = route[segment]
        local finish = route[segment + 1]
        local delta = finish - start
        local distance = delta.Magnitude
        local midpoint = (start + finish) / 2
        local roadFrame = CFrame.lookAt(midpoint, finish)
        local trail = part(
            geometry,
            "EmberhollowRoad",
            Vector3.new(19, 0.5, distance + 4),
            roadFrame,
            Color3.fromRGB(48, 34, 24),
            Enum.Material.Ground
        )
        trail.Reflectance = 0.02
        local wornCenter = part(
            geometry,
            "EmberhollowRoadWear",
            Vector3.new(7.5, 0.12, distance + 2),
            roadFrame * CFrame.new(0, 0.31, 0),
            Color3.fromRGB(132, 94, 54),
            Enum.Material.Mud,
            false
        )
        wornCenter.CanQuery = false

        for rutSide = -1, 1, 2 do
            local rut = part(
                geometry,
                "RoadRut",
                Vector3.new(0.62, 0.08, distance + 1),
                roadFrame * CFrame.new(rutSide * 2.45, 0.39, 0),
                Color3.fromRGB(71, 48, 31),
                Enum.Material.Mud,
                false
            )
            rut.CanQuery = false
        end

        for chevronSide = -1, 1, 2 do
            local chevron = part(
                geometry,
                "RoadChevron",
                Vector3.new(3.2, 0.12, 0.58),
                roadFrame
                    * CFrame.new(chevronSide * 1.05, 0.43, 0)
                    * CFrame.Angles(0, math.rad(chevronSide * 34), 0),
                Color3.fromRGB(151, 107, 59),
                Enum.Material.WoodPlanks,
                false
            )
            chevron.CanQuery = false
        end

        local markerCount = math.max(2, math.floor(distance / 8))
        for marker = 0, markerCount do
            local along = -distance * 0.5 + distance * marker / markerCount
            for side = -1, 1, 2 do
                local edgeStone = part(
                    geometry,
                    "RoadEdgeStone",
                    Vector3.new(1.4, 0.45, 2.6),
                    roadFrame
                        * CFrame.new(side * 8.6, 0.34, along)
                        * CFrame.Angles(0, math.rad(side * (marker % 2) * 7), 0),
                    if marker % 3 == 0
                        then Color3.fromRGB(107, 101, 86)
                        else Color3.fromRGB(75, 83, 79),
                    Enum.Material.Slate,
                    false
                )
                edgeStone.CanQuery = false
            end
        end
    end

    local function tutorialSpur(start: Vector3, finish: Vector3)
        local delta = finish - start
        local spur = part(
            geometry,
            "TutorialSpurPath",
            Vector3.new(6, 0.16, delta.Magnitude + 1),
            CFrame.lookAt((start + finish) / 2, finish),
            Color3.fromRGB(105, 75, 44),
            Enum.Material.Mud,
            false
        )
        spur.CanQuery = false
    end
    tutorialSpur(Vector3.new(28, 0.76, -48), Vector3.new(34, 0.76, -48))
    tutorialSpur(Vector3.new(-8, 0.76, -68), Vector3.new(-38, 0.76, -68))
    tutorialSpur(Vector3.new(-27, 0.76, -89), Vector3.new(-39, 0.76, -92))

    -- The forest. Previously 92 identical conifers packed into a 54-154 stud
    -- ring, which is why the valley read as a yard with a hedge around it: the
    -- treeline sat almost on top of the route and there was nothing past it.
    --
    -- Now the scatter runs to 620 studs in three depth bands, which is the
    -- layering the art direction asks every background to have -- near framing,
    -- regional mid-ground, distant silhouette. StreamingTargetRadius is 1024,
    -- so the far band streams in and out rather than loading at join.
    local forest = Instance.new("Folder")
    forest.Name = "Forest"
    forest.Parent = geometry

    local random = Random.new(1847)
    local swayTag = _self._runtimeIds.AmbientSwayTag

    _self._meshPlacements = {
        {
            assetId = "mesh_root_arch_a",
            fallbackKind = "root_arch",
            position = Vector3.new(78, TerrainBuilder.surfaceHeight(78, -42), -42),
            scale = 1,
            yaw = math.rad(-28),
            seed = 9147,
            swayTag = nil,
        },
        {
            assetId = "mesh_hollow_lantern_shrine_a",
            fallbackKind = "hollow_shrine",
            position = Vector3.new(-78, TerrainBuilder.surfaceHeight(-78, -44), -44),
            scale = 1,
            yaw = math.rad(22),
            seed = 9148,
            swayTag = nil,
        },
    }

    -- Only the near band is planted here. Bands 2 and 3 are scenery beyond the
    -- immediate clearing and are planted after the world is marked ready; see
    -- _buildDistantScenery.
    plantForestBand(forest, 1, swayTag, _self._meshPlacements)

    for _ = 1, 34 do
        local glow = part(
            geometry,
            "Firefly",
            Vector3.new(0.18, 0.18, 0.18),
            CFrame.new(
                random:NextNumber(-52, 52),
                random:NextNumber(2, 12),
                random:NextNumber(-142, -8)
            ),
            if random:NextInteger(1, 4) == 1 then FOXFIRE else AMBER,
            Enum.Material.Neon,
            false
        )
        glow.Shape = Enum.PartType.Ball
        glow.Transparency = random:NextNumber(0.02, 0.28)
        glow.CanQuery = false
        CollectionService:AddTag(glow, _self._runtimeIds.AmbientMoteTag)
    end

    -- Near-field ground detail just outside the route, where the camera is
    -- close enough for it to register.
    for index = 1, 24 do
        local angle = (index / 24) * math.pi * 2
        local radius = 48 + (index % 4) * 8
        local x = math.cos(angle) * radius
        local z = math.sin(angle) * radius - 70

        -- Same keep-out test the tree bands use. This ring sits at radius
        -- 48-72, so without it indices land directly on the lantern trail.
        if isFoliagePlantable(x, z) then
            local position = Vector3.new(x, TerrainBuilder.surfaceHeight(x, z), z)
            FoliageBuilder.boulders(
                forest,
                position,
                0.6 + (index % 5) * 0.16,
                FOLIAGE_TONE,
                8300 + index
            )
            if index % 2 == 0 then
                FoliageBuilder.undergrowth(
                    forest,
                    position + Vector3.new(3, 0, -2),
                    0.9,
                    FOLIAGE_TONE,
                    8400 + index,
                    _self._runtimeIds.AmbientSwayTag
                )
            end
        end
    end

    addFillLight(geometry, Vector3.new(-46, 12, -96), Color3.fromRGB(54, 103, 95), 0.85, 78)
    addFillLight(geometry, Vector3.new(38, 10, -28), Color3.fromRGB(255, 177, 88), 0.45, 54)
    emberDrift(geometry, Vector3.new(0, 0, -112), AMBER, 16, 28, _self._runtimeIds.AmbientMoteTag)

    local lanternSpecs = {
        { position = Vector3.new(7, 0, -9), scale = 0.68, yaw = math.rad(-18) },
        { position = Vector3.new(-10, 0, -28), scale = 0.62, yaw = math.rad(14) },
        { position = Vector3.new(24, 0, -42), scale = 0.62, yaw = math.rad(-12) },
        { position = Vector3.new(-8, 0, -66), scale = 0.62, yaw = math.rad(14) },
        { position = Vector3.new(-27, 0, -87), scale = 0.62, yaw = math.rad(-12) },
        { position = Vector3.new(8, 0, -103), scale = 0.62, yaw = math.rad(14) },
    }
    for index, spec in lanternSpecs do
        local placeholder =
            lantern(geometry, spec.position, spec.scale, _self._runtimeIds.AmbientLightTag)
        table.insert(_self._meshPlacements, {
            assetId = "mesh_lantern_post_a",
            fallbackKind = "placeholder",
            position = spec.position,
            scale = spec.scale,
            yaw = spec.yaw,
            seed = 9200 + index,
            swayTag = nil,
            parent = geometry,
            fallbackInstance = placeholder,
        })
    end
    labelSign(geometry, CFrame.new(7, 3, -14) * CFrame.Angles(0, math.pi, 0), "FOLLOW THE LANTERNS")
    buildEmberhollowSanctuary(geometry)

    local warningFolder = Instance.new("Folder")
    warningFolder.Name = "DuskTreelineWarnings"
    warningFolder.Parent = geometry
    local warningCenters = {
        Vector3.new(-44, 3.1, -133),
        Vector3.new(46, 3.4, -121),
        Vector3.new(0, 3.2, -174),
    }
    for warningIndex, center in warningCenters do
        local body = part(
            warningFolder,
            "DuskThreatSilhouette",
            Vector3.new(5.2, 6.4, 3.3),
            CFrame.new(center) * CFrame.Angles(0, math.rad((warningIndex - 2) * 18), 0),
            Color3.fromRGB(24, 27, 28),
            Enum.Material.Slate,
            false
        )
        body.Shape = Enum.PartType.Ball
        body.CastShadow = false
        body.Transparency = 1
        body:SetAttribute("DuskTransparency", 0.08)
        table.insert(_self._duskSignals, body)
        for side = -1, 1, 2 do
            local shoulder = part(
                warningFolder,
                "DuskThreatRoot",
                Vector3.new(0.8, 5.4, 0.8),
                CFrame.new(center + Vector3.new(side * 2.7, 0.2, 0))
                    * CFrame.Angles(0, 0, math.rad(side * 30)),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
            shoulder.CastShadow = false
            shoulder.Transparency = 1
            shoulder:SetAttribute("DuskTransparency", 0.12)
            table.insert(_self._duskSignals, shoulder)

            local eye = part(
                warningFolder,
                "DuskThreatEye",
                Vector3.new(0.38, 0.38, 0.22),
                CFrame.new(center + Vector3.new(side * 0.72, 0.65, -1.65)),
                Color3.fromRGB(255, 137, 82),
                Enum.Material.Neon,
                false
            )
            eye.Shape = Enum.PartType.Ball
            eye.CastShadow = false
            eye.Transparency = 1
            eye:SetAttribute("DuskTransparency", 0.04)
            table.insert(_self._duskSignals, eye)
        end
    end

    local defenseRoute = Instance.new("Folder")
    defenseRoute.Name = "NightDefenseRoute"
    defenseRoute.Parent = geometry
    for markerIndex = 1, 7 do
        local marker = part(
            defenseRoute,
            "DefenseTrailMarker",
            Vector3.new(5.8, 0.18, 1.1),
            CFrame.new(if markerIndex % 2 == 0 then 4.6 else -4.6, 0.3, -151 + markerIndex * 5),
            AMBER,
            Enum.Material.Glass,
            false
        )
        marker.Transparency = 1
        marker.CastShadow = false
        marker:SetAttribute("SignalRole", "trail")
        table.insert(_self._nightDefenseSignals, marker)
    end
    for side = -1, 1, 2 do
        local towerCenter = Vector3.new(side * 10.5, 0, -143)
        for postSide = -1, 1, 2 do
            part(
                defenseRoute,
                "WatchPost",
                Vector3.new(0.85, 8.5, 0.85),
                CFrame.new(towerCenter + Vector3.new(postSide * 2.2, 4.25, 0)),
                WET_BARK,
                Enum.Material.Wood
            )
        end
        part(
            defenseRoute,
            "WatchPlatform",
            Vector3.new(6.2, 0.65, 5.2),
            CFrame.new(towerCenter + Vector3.new(0, 7.1, 0)),
            Color3.fromRGB(83, 61, 43),
            Enum.Material.WoodPlanks
        )
        local brazier = part(
            defenseRoute,
            "WatchSignalFire",
            Vector3.new(1.55, 2.2, 1.55),
            CFrame.new(towerCenter + Vector3.new(0, 8.8, 0)),
            AMBER,
            Enum.Material.Neon,
            false
        )
        brazier.Shape = Enum.PartType.Ball
        brazier.Transparency = 1
        brazier.CastShadow = false
        brazier:SetAttribute("SignalRole", "fire")
        local signalLight = Instance.new("PointLight")
        signalLight.Name = "WatchSignalLight"
        signalLight.Color = AMBER
        signalLight.Brightness = 0
        signalLight.Range = 24
        signalLight.Shadows = false
        signalLight.Parent = brazier
        table.insert(_self._nightDefenseSignals, brazier)
    end
    local warningBoard = part(
        defenseRoute,
        "NightWatchBoard",
        Vector3.new(13, 2.8, 0.55),
        CFrame.new(0, 4.6, -146.8),
        BARK,
        Enum.Material.WoodPlanks,
        false
    )
    addBillboard(warningBoard, "NIGHT WATCH · HOLD THE LANTERN ROAD", CREAM)
end

-- Rebuilds the same placement from inexpensive geometry when an authored model
-- cannot load. The choice is stable and never leaves a hole in the route art.
local function buildMeshFallback(parent: Instance, placement: MeshPlacement)
    if placement.fallbackKind == "conifer" then
        FoliageBuilder.conifer(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed,
            placement.swayTag
        )
    elseif placement.fallbackKind == "broadleaf" then
        FoliageBuilder.broadleaf(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed,
            placement.swayTag
        )
    elseif placement.fallbackKind == "boulders" then
        FoliageBuilder.boulders(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed
        )
    elseif placement.fallbackKind == "undergrowth" then
        FoliageBuilder.undergrowth(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed,
            placement.swayTag
        )
    elseif placement.fallbackKind == "deadfall" then
        FoliageBuilder.deadfall(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed
        )
    elseif placement.fallbackKind == "root_arch" then
        FoliageBuilder.rootArch(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.yaw
        )
    elseif placement.fallbackKind == "hollow_shrine" then
        FoliageBuilder.rootArch(
            parent,
            placement.position,
            placement.scale * 1.1,
            FOLIAGE_TONE,
            placement.yaw
        )
    end
end

local function hideProceduralPlaceholder(placeholder: Instance)
    local instances = placeholder:GetDescendants()
    table.insert(instances, placeholder)
    for _, instance in instances do
        if instance:IsA("BasePart") then
            instance.Transparency = 1
            instance.CastShadow = false
        end
    end
    placeholder:SetAttribute("ReplacedByAuthoredMesh", true)
end

-- Authored art is optional streaming dressing. Loading begins only after the
-- spawn and interactions are ready, and a failed private asset immediately
-- takes the procedural path above.
function WorldService._placeAuthoredMeshes(
    self: WorldService,
    placements: { MeshPlacement },
    defaultParent: Instance,
    attributeTarget: Instance,
    readyEvent: string
)
    local queued = table.clone(placements)
    task.spawn(function()
        local authored = 0
        local fallbacks = 0
        for index, placement in queued do
            local placementParent = placement.parent or defaultParent
            if attributeTarget.Parent == nil or placementParent.Parent == nil then
                return
            end
            local placed, result = pcall(
                self._meshTemplateLoader.place,
                self._meshTemplateLoader,
                placement.assetId,
                placementParent,
                CFrame.new(placement.position) * CFrame.Angles(0, placement.yaw, 0),
                placement.scale
            )
            local model = if placed then result else nil
            if not placed then
                self._logger:info("mesh_placement_failed", {
                    assetId = placement.assetId,
                    error = tostring(result),
                })
            end
            if model == nil then
                if placement.fallbackInstance == nil then
                    buildMeshFallback(placementParent, placement)
                end
                fallbacks += 1
            else
                if placement.fallbackInstance ~= nil then
                    hideProceduralPlaceholder(placement.fallbackInstance)
                end
                authored += 1
            end
            if index % 5 == 0 then
                task.wait()
            end
        end

        attributeTarget:SetAttribute("AuthoredMeshCount", authored)
        attributeTarget:SetAttribute("AuthoredMeshFallbackCount", fallbacks)
        self._logger:info(readyEvent, {
            authored = authored,
            fallbacks = fallbacks,
            placements = #queued,
        })
    end)
end

function WorldService._buildMeshDressing(self: WorldService)
    local world = self._world
    if world == nil then
        return
    end
    local geometry = world:FindFirstChild("Environment")
    local forest = if geometry ~= nil then geometry:FindFirstChild("Forest") else nil
    if forest == nil then
        return
    end
    self:_placeAuthoredMeshes(self._meshPlacements, forest, world, "mesh_dressing_ready")
end

--[[
    Fills in the horizon after joining is unblocked.

    Everything here is optional scenery: terrain past CORE_RADIUS, and the two
    outer forest bands. None of it is ground a player can stand on and none of
    it gates the tutorial, so it must not sit between a joining player and a
    playable world. AGENTS.md is explicit that joining never blocks on the
    whole world loading, and Config.BootstrapTimeoutSeconds is only 8 -- the
    first version of this change generated the entire 121 x 121 hill grid, the
    peak ring, and all 4,000-plus forest parts before ArrivalSpawn even
    existed.

    Yields between grid rows and between bands so the work lands across many
    frames instead of one long hitch. Failures are contained: scenery breaking
    out here must not take down a world that is already ready and playable.
]]
function WorldService._buildDistantScenery(self: WorldService)
    local world = self._world
    if world == nil then
        return
    end

    local geometry = world:FindFirstChild("Environment")
    local forest = if geometry ~= nil then geometry:FindFirstChild("Forest") else nil
    local swayTag = self._runtimeIds.AmbientSwayTag

    task.spawn(function()
        local ok, err = pcall(function()
            TerrainBuilder.buildDistant(nil, nil, function()
                task.wait()
            end)

            for bandIndex = 2, 3 do
                -- The world can be torn down and rebuilt while this runs.
                if forest == nil or forest.Parent == nil then
                    return
                end
                plantForestBand(forest, bandIndex, swayTag)
                task.wait()
            end
        end)

        if not ok then
            self._logger:info("distant_scenery_failed", { error = tostring(err) })
            return
        end
        self._logger:info("distant_scenery_ready", {})
    end)
end

