function CraftingCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function CraftingCatalog.get(id: string): Recipe?
    return DEFINITIONS[id]
end

function CraftingCatalog.list(): { Recipe }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

function CraftingCatalog.isKnownOutputItem(itemId: any): boolean
    if type(itemId) ~= "string" then
        return false
    end
    for _, id in ORDER do
        if DEFINITIONS[id].outputItemId == itemId then
            return true
        end
    end
    return false
end

CraftingCatalog.Ids = table.freeze({
    MeadowSatchel = "recipe_meadow_satchel",
    AmberCharm = "recipe_amber_charm",
    IronrootHood = "recipe_ironroot_hood",
    BrambleBoots = "recipe_bramble_boots",
    ThornwoodBow = "recipe_thornwood_bow",
    HeartwoodMaul = "recipe_heartwood_maul",
    BriarLance = "recipe_briar_lance",
    FoxfireSling = "recipe_foxfire_sling",
    AmberEdge = "recipe_amber_edge",
    WardenCudgel = "recipe_warden_cudgel",
})

return table.freeze(CraftingCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">DefenseLanes</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The town's authored approach lanes and the snare plots that guard them.
    Pure numbers only, like everything in the shared layer: lanes are yaw
    rotations of the night spawn point around the First Lantern, plots are
    fixed points along each lane, and the trap's rules are constants -- so
    the Lune suite pins lane selection, geometry, and trigger boundaries
    without a world.

    The GDD's defense loop asks for three to five authored lanes per town
    layout. This town gets three. The first wave of every night always
    walks the Meadow Gate -- the straight approach players have faced since
    the first night, bit-identical to the pre-lane behavior -- and later
    waves rotate through the flanks deterministically, so a night's layout
    is knowable at nightfall and two runs of the same night match.
]]

local DefenseLanes = {}

export type Lane = {
    id: string,
    displayName: string,
    yaw: number,
}

local LANES: { Lane } = table.freeze({
    table.freeze({ id = "lane_meadow_gate", displayName = "MEADOW GATE", yaw = 0 }),
    table.freeze({ id = "lane_east_hollow", displayName = "EAST HOLLOW", yaw = math.rad(52) }),
    table.freeze({ id = "lane_west_break", displayName = "WEST BREAK", yaw = math.rad(-52) }),
}) :: { Lane }

-- How far from the lantern a lane's snare plot sits: inside the enemy's
-- walk, outside the commons, close enough to reach during dusk.
local PLOT_DISTANCE = 46

DefenseLanes.Trap = table.freeze({
    armCost = table.freeze({ material_meadow_fiber = 2, material_heartwood = 1 }),
    charges = 2,
    triggerRadius = 9,
    snareSeconds = 3.5,
})

function DefenseLanes.list(): { Lane }
    return LANES
end

function DefenseLanes.get(laneId: any): Lane?
    for _, lane in LANES do
        if lane.id == laneId then
            return lane
        end
    end
    return nil
end

--[[
    Which lane a wave walks. Wave 1 is always the Meadow Gate; later waves
    step through the lanes from a night-dependent start, so consecutive
    waves change direction and different nights lead with different flanks.
]]
function DefenseLanes.laneForWave(night: number, wave: number): Lane
    if wave <= 1 then
        return LANES[1]
    end
    return LANES[(night + wave) % #LANES + 1]
end

-- Rotate (x, z) about (cx, cz) by a lane's yaw. Yaw 0 is the identity, so
-- the Meadow Gate reproduces the authored spawn point exactly.
function DefenseLanes.rotatedPoint(
    lane: Lane,
    x: number,
    z: number,
    cx: number,
    cz: number
): (number, number)
    if lane.yaw == 0 then
        return x, z
    end
    local dx = x - cx
    local dz = z - cz
    local cos = math.cos(lane.yaw)
    local sin = math.sin(lane.yaw)
    return cx + dx * cos - dz * sin, cz + dx * sin + dz * cos
end

-- Where a lane's snare plot sits: PLOT_DISTANCE from the lantern along the
-- lane's rotated spawn direction.
function DefenseLanes.plotPoint(
    lane: Lane,
    spawnX: number,
    spawnZ: number,
    cx: number,
    cz: number
): (number, number)
    local rx, rz = DefenseLanes.rotatedPoint(lane, spawnX, spawnZ, cx, cz)
    local dx = rx - cx
    local dz = rz - cz
    local distance = math.sqrt(dx * dx + dz * dz)
    if distance < 1 then
        return cx, cz + PLOT_DISTANCE
    end
    local scale = PLOT_DISTANCE / distance
    return cx + dx * scale, cz + dz * scale
end

function DefenseLanes.trapTriggers(
    enemyX: number,
    enemyZ: number,
    plotX: number,
    plotZ: number
): boolean
    local dx = enemyX - plotX
    local dz = enemyZ - plotZ
    return dx * dx + dz * dz <= DefenseLanes.Trap.triggerRadius ^ 2
end

return table.freeze(DefenseLanes)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">DrownedCallerEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Drowned Caller -- the Fen's second elite.

    It summons through reflected pools. Four of them stand around the
    marsh, and while one still holds a reflection the Caller can reach
    through it: every call brings something up out of the water, and the
    calls come faster the longer the pools are left alone. Breaking a
    reflection is the whole fight -- silt one pool and the Caller loses a
    door and takes the pain of it.

    Where the Many-Face is read-and-time, the Caller is a race against its
    own arithmetic: leave the pools and the summons compound; break them
    and the fight quiets, but every break costs you the walk to it while
    something new is already climbing out. Its damage does not come from
    the Caller at all, which is the point -- it never attacks you directly
    until the last pool goes dark.

    Same contract as every elite: profession-independent, solo-passable,
    one reward per participant per run through a deterministic
    transaction id, disable-able, every mutation server-called.
]]

local DrownedCallerEncounter = {}

export type Status = "disabled" | "dormant" | "calling" | "exposed" | "complete"

export type State = {
    health: number,
    manifestHash: string,
    participants: { [string]: boolean },
    pools: { [string]: boolean },
    revision: number,
    runId: string,
    status: Status,
    summoned: number,
}

local MAX_HEALTH = 280
local POOL_IDS = table.freeze({
    "pool_north",
    "pool_east",
    "pool_south",
    "pool_west",
})
-- Every pool silted takes this much out of the Caller directly: breaking
-- its doors is damage, so a player who only ever silts pools still wins.
local SILT_DAMAGE = 45
-- Base seconds between summons, and how much each silted pool buys back.
local BASE_CALL_SECONDS = 8
local CALL_RELIEF_SECONDS = 2.5
-- How much faster it calls per creature already standing: the compounding
-- the fight is actually about.
local CROWD_PRESSURE_SECONDS = 0.9
local MIN_CALL_SECONDS = 3

local DROWNING_HAND = table.freeze({
    attackId = "drowned_caller_hand",
    attackName = "DROWNING HAND",
    damage = 26,
    instruction = "STEP OFF THE WET GROUND",
    radius = 10,
    shape = "circle",
    windup = 1.45,
})

local UNDERTOW = table.freeze({
    attackId = "drowned_caller_undertow",
    attackName = "UNDERTOW",
    damage = 30,
    instruction = "GET CLEAR OF THE PULL",
    length = 28,
    shape = "lane",
    width = 9,
    windup = 1.6,
})

DrownedCallerEncounter.Id = "elite_drowned_caller"
DrownedCallerEncounter.MaxHealth = MAX_HEALTH
DrownedCallerEncounter.PoolIds = POOL_IDS
DrownedCallerEncounter.SiltDamage = SILT_DAMAGE
DrownedCallerEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_witchlight_pollen",
})
DrownedCallerEncounter.Tuning = table.freeze({
    baseCallSeconds = BASE_CALL_SECONDS,
    callReliefSeconds = CALL_RELIEF_SECONDS,
    crowdPressureSeconds = CROWD_PRESSURE_SECONDS,
    exposedAttackCooldownSeconds = 3.2,
    minCallSeconds = MIN_CALL_SECONDS,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.participants = table.clone(state.participants)
    nextState.pools = table.clone(state.pools)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

local function isPool(poolId: any): boolean
    for _, id in POOL_IDS do
        if id == poolId then
            return true
        end
    end
    return false
end

local function poolsSilted(state: State): number
    local count = 0
    for _, id in POOL_IDS do
        if state.pools[id] then
            count += 1
        end
    end
    return count
end

function DrownedCallerEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Drowned Caller run ID is required")
    assert(manifestHash ~= "", "Drowned Caller manifest hash is required")
    return {
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        participants = {},
        pools = {},
        revision = 0,
        runId = runId,
        status = if enabled then "dormant" else "disabled",
        summoned = 0,
    }
end

function DrownedCallerEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "calling"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function DrownedCallerEncounter.join(state: State, userId: number): State
    if state.status ~= "calling" and state.status ~= "exposed" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    Silt one reflected pool. Pools stay silted, each break wounds the
    Caller directly, and the last one leaves it standing in the open with
    nothing left to reach through.
]]
function DrownedCallerEncounter.siltPool(state: State, userId: number, poolId: any): (State, any)
    if state.status ~= "calling" and state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end
    if not isPool(poolId) then
        return state, { accepted = false, reason = "unknown_pool" }
    end
    if state.pools[poolId] then
        return state, { accepted = false, reason = "already_silted" }
    end
    local nextState = cloneState(state)
    nextState.pools[poolId] = true
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - SILT_DAMAGE)
    local silted = poolsSilted(nextState)
    local lastDoor = silted >= #POOL_IDS
    if nextState.health <= 0 then
        nextState.status = "complete"
    elseif lastDoor then
        nextState.status = "exposed"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            exposed = nextState.status == "exposed",
            health = nextState.health,
            reason = if nextState.status == "complete"
                then "completed"
                elseif lastDoor then "last_door_closed"
                else "pool_silted",
            remaining = #POOL_IDS - silted,
            silted = silted,
        }
end

-- One summon. The service calls this when the cadence says so; the count
-- is what makes the next one come sooner.
function DrownedCallerEncounter.summon(state: State): (State, any)
    if state.status ~= "calling" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.summoned += 1
    nextState.revision += 1
    return nextState, { accepted = true, reason = "summoned", summoned = nextState.summoned }
end

-- One creature answered for. Relieves the pressure its presence added.
function DrownedCallerEncounter.summonDefeated(state: State): State
    if state.summoned <= 0 then
        return state
    end
    local nextState = cloneState(state)
    nextState.summoned -= 1
    nextState.revision += 1
    return nextState
end

--[[
    The arithmetic the fight is about: leaving the pools and leaving the
    summoned standing both make the next call sooner, and silting buys it
    back. Floored so it can never reach zero and lock a player out.
]]
function DrownedCallerEncounter.callCooldown(state: State): number
    local seconds = BASE_CALL_SECONDS
        + poolsSilted(state) * CALL_RELIEF_SECONDS
        - state.summoned * CROWD_PRESSURE_SECONDS
    return math.max(MIN_CALL_SECONDS, seconds)
end

function DrownedCallerEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Drowned Caller strike amount is invalid")
    if state.status ~= "exposed" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - amount)
    if nextState.health <= 0 then
        nextState.status = "complete"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            reason = if nextState.status == "complete" then "completed" else "damaged",
        }
end

function DrownedCallerEncounter.attack(attackIndex: number, siltedCount: number): any
    if siltedCount >= 2 and attackIndex % 2 == 0 then
        return UNDERTOW
    end
    return DROWNING_HAND
end

function DrownedCallerEncounter.snapshot(state: State, userId: number): any
    local silted = poolsSilted(state)
    local instruction = if state.status == "calling"
        then string.format("SILT THE REFLECTED POOLS — %d OF %d", silted, #POOL_IDS)
        elseif state.status == "exposed" then "NOTHING LEFT TO REACH THROUGH — STRIKE IT"
        elseif state.status == "complete" then "THE CALLING IS ENDED"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE BELL MARSH"
    return {
        active = state.status == "calling" or state.status == "exposed",
        callCooldown = DrownedCallerEncounter.callCooldown(state),
        complete = state.status == "complete",
        displayName = "DROWNED CALLER",
        enabled = state.status ~= "disabled",
        exposed = state.status == "exposed",
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, math.floor(silted / 2) + 1),
        poolsSilted = silted,
        poolTotal = #POOL_IDS,
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        status = state.status,
        summoned = state.summoned,
    }
end

function DrownedCallerEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        DrownedCallerEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(DrownedCallerEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">EnemyAttackFlow</string>
          <string name="Source"><![CDATA[--!strict

local EnemyAttackFlow = {}

export type Channel = {
    endsAt: number,
    startedAt: number,
    targetUserId: number,
}
export type Conditions = {
    clearPath: boolean,
    inImpactArea: boolean,
    targetCanAct: boolean,
    targetPresent: boolean,
}
export type DecisionStatus = "cancel" | "miss" | "pending" | "resolve"
export type Decision = {
    reason: string?,
    remaining: number?,
    status: DecisionStatus,
}

local function finiteNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeNonNegative(value: any): boolean
    return finiteNumber(value) and value >= 0 and value == math.floor(value)
end

function EnemyAttackFlow.create(targetUserId: number, now: number, windup: number): Channel
    assert(wholeNonNegative(targetUserId), "attack target user ID is invalid")
    assert(finiteNumber(now), "attack start time is invalid")
    assert(finiteNumber(windup) and windup > 0, "attack windup is invalid")
    return table.freeze({
        endsAt = now + windup,
        startedAt = now,
        targetUserId = targetUserId,
    })
end

function EnemyAttackFlow.evaluate(channel: Channel, now: number, conditions: Conditions): Decision
    assert(finiteNumber(now), "attack evaluation time is invalid")
    if conditions.targetPresent ~= true then
        return {
            reason = "target_left",
            status = "cancel",
        }
    end
    if conditions.targetCanAct ~= true then
        return {
            reason = "target_cannot_act",
            status = "cancel",
        }
    end
    if now < channel.endsAt then
        return {
            remaining = channel.endsAt - now,
            status = "pending",
        }
    end
    if conditions.inImpactArea ~= true then
        return {
            reason = "target_evaded_area",
            status = "miss",
        }
    end
    if conditions.clearPath ~= true then
        return {
            reason = "target_reached_cover",
            status = "miss",
        }
    end
    return {
        status = "resolve",
    }
end

return table.freeze(EnemyAttackFlow)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">EnemyCatalog</string>
          <string name="Source"><![CDATA[--!strict

--[[
    One roster for the night systems, assembled from the regional ones.

    EnemyService took the Bramblewake catalog directly for as long as
    there was only one region. Now that the Delve exists, it takes this
    instead: the same get/require/order/all surface, backed by every
    region's roster, plus orderFor(regionId) when a caller genuinely
    means "this region's enemies" rather than "any enemy".

    Ids carry their own meaning across regions -- there is exactly one
    enemy_rail_hound -- so a merged lookup can never be ambiguous, and the
    default order stays Bramblewake's exact sequence so every existing
    schedule and spec keeps its behavior.
]]

local BramblewakeEnemies = require("./BramblewakeEnemies")
local IronrootEnemies = require("./IronrootEnemies")
local MireglassEnemies = require("./MireglassEnemies")
local TempestEnemies = require("./TempestEnemies")
local CinderfallEnemies = require("./CinderfallEnemies")
local FrostmereEnemies = require("./FrostmereEnemies")

local EnemyCatalog = {}

export type EnemyDefinition = BramblewakeEnemies.EnemyDefinition

local ROSTERS: { { regionId: string, roster: any } } = {
    { regionId = "region_bramblewake", roster = BramblewakeEnemies },
    { regionId = "region_ironroot", roster = IronrootEnemies },
    { regionId = "region_mireglass", roster = MireglassEnemies },
    { regionId = "region_tempest", roster = TempestEnemies },
    { regionId = "region_frostmere", roster = FrostmereEnemies },
    { regionId = "region_cinderfall", roster = CinderfallEnemies },
}

local ROSTER_BY_REGION: { [string]: any } = {}
local ORDER: { string } = {}
local REGION_BY_ENEMY: { [string]: string } = {}
for _, entry in ROSTERS do
    ROSTER_BY_REGION[entry.regionId] = entry.roster
    for _, enemyId in entry.roster.order() do
        assert(
            REGION_BY_ENEMY[enemyId] == nil,
            string.format("enemy ID %q is claimed by two regions", enemyId)
        )
        REGION_BY_ENEMY[enemyId] = entry.regionId
        table.insert(ORDER, enemyId)
    end
end
table.freeze(ORDER)

function EnemyCatalog.get(enemyId: string): EnemyDefinition?
    local regionId = REGION_BY_ENEMY[enemyId]
    if regionId == nil then
        return nil
    end
    return ROSTER_BY_REGION[regionId].get(enemyId)
end

function EnemyCatalog.require(enemyId: string): EnemyDefinition
    local definition = EnemyCatalog.get(enemyId)
    assert(definition ~= nil, string.format("unknown enemy ID %q", enemyId))
    return definition
end

function EnemyCatalog.regionOf(enemyId: string): string?
    return REGION_BY_ENEMY[enemyId]
end

-- Every enemy, regions in declaration order. Bramblewake's six come
-- first, in their original sequence.
function EnemyCatalog.order(): { string }
    return table.clone(ORDER)
end

function EnemyCatalog.orderFor(regionId: string): { string }
    local roster = ROSTER_BY_REGION[regionId]
    return if roster == nil then {} else roster.order()
end

function EnemyCatalog.all(): { EnemyDefinition }
    local result: { EnemyDefinition } = {}
    for _, enemyId in ORDER do
        table.insert(result, EnemyCatalog.require(enemyId))
    end
    return result
end

return table.freeze(EnemyCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">EnemyCombatRules</string>
          <string name="Source"><![CDATA[--!strict

local EnemyCombatRules = {}

function EnemyCombatRules.contains(
    shape: string,
    localX: number,
    localZ: number,
    radius: number?,
    width: number?,
    length: number?
): boolean
    if shape == "circle" then
        local resolvedRadius = math.max(0, radius or 0)
        return localX * localX + localZ * localZ <= resolvedRadius * resolvedRadius
    end
    if shape == "lane" then
        local halfWidth = math.max(0, width or 0) * 0.5
        local halfLength = math.max(0, length or 0) * 0.5
        return math.abs(localX) <= halfWidth and math.abs(localZ) <= halfLength
    end
    return false
end

--[[
    The status/reaction layer rides the same resolution: statuses that are
    already in the game interact when a strike lands, instead of living in
    parallel. A STILLED enemy is bound open -- the strike counts as a clean
    flank whatever the real facing, which is what finally beats a
    front-shielded Briarback without circling it. A SNARED enemy cannot
    slip the blow (x1.2). A DROWSY striker swings soft (x0.85) -- the
    counterplay the Alchemist's tonic exists for. Multipliers stack and
    clamp to 0.6..1.6 so no combination silences an enemy or a player.
]]
export type StrikeReactions = {
    stilled: boolean?,
    snared: boolean?,
    drowsyStriker: boolean?,
}

function EnemyCombatRules.strikeDamage(
    definition: any,
    facingDot: number,
    reactions: StrikeReactions?
): (number, string, string?)
    local stilled = reactions ~= nil and reactions.stilled == true
    local snared = reactions ~= nil and reactions.snared == true
    local drowsy = reactions ~= nil and reactions.drowsyStriker == true

    local damage: number
    local result: string
    if definition.frontShield == true then
        if facingDot >= 0.25 and not stilled then
            damage, result = math.max(0, definition.frontalStrikeDamage or 0), "shielded"
        else
            damage, result =
                math.max(0, definition.flankStrikeDamage or definition.strikeDamage), "flanked"
        end
    else
        damage, result = math.max(0, definition.strikeDamage or 0), "hit"
        if stilled then
            result = "flanked"
        end
    end

    local multiplier = 1
    local label: string? = nil
    if stilled then
        multiplier *= 1.25
        label = "BOUND OPEN — A CLEAN FLANK"
    elseif snared then
        multiplier *= 1.2
        label = "EXPOSED — THE SNARE HELD IT"
    end
    if drowsy then
        multiplier *= 0.85
        if label == nil then
            label = "DROWSY SWING"
        end
    end
    damage = math.floor(damage * math.clamp(multiplier, 0.6, 1.6) + 0.5)
    return damage, result, label
end

return table.freeze(EnemyCombatRules)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">EnemyMotion</string>
          <string name="Source"><![CDATA[--!strict

local EnemyMotion = {}

export type Pose = {
    height: number,
    pitch: number,
    roll: number,
}

local HOVERING = table.freeze({
    hollow_crow = true,
})

local function profile(modelKey: string): (number, number)
    if HOVERING[modelKey] then
        return 0.52, 2.45
    elseif modelKey == "zombie" then
        -- Slow, heavy, uneven: a shamble rather than a stride.
        return 0.16, 3.1
    elseif modelKey == "bark_ram" then
        return 0.13, 7.2
    elseif modelKey == "briarback" then
        return 0.11, 5.4
    elseif modelKey == "snapvine" then
        return 0.08, 1.8
    end
    return 0.15, 6.2
end

function EnemyMotion.pose(
    elapsed: number,
    modelKey: string,
    state: string,
    attackProgress: number?
): Pose
    local amplitude, frequency = profile(modelKey)
    local wave = elapsed * frequency
    local hovering = HOVERING[modelKey] == true
    local height = if hovering
        then math.sin(wave) * amplitude
        elseif state == "moving" then math.abs(math.sin(wave)) * amplitude
        else math.sin(wave * 0.42) * amplitude * 0.28
    local pitch = if state == "moving" then math.sin(wave) * math.rad(1.8) else 0
    local roll = if hovering
        then math.sin(wave * 0.63) * math.rad(3.2)
        else math.sin(wave * 0.5) * math.rad(1.1)

    if state == "attacking" then
        local progress = math.clamp(attackProgress or 0, 0, 1)
        local anticipation = math.sin(progress * math.pi * 0.5)
        height += if hovering then anticipation * 0.26 else -anticipation * 0.08
        pitch -= anticipation * math.rad(if modelKey == "bark_ram" then 13 else 8)
        roll *= 1 - anticipation * 0.7
    end

    return {
        height = height,
        pitch = pitch,
        roll = roll,
    }
end

return table.freeze(EnemyMotion)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">EngineerBrace</string>
          <string name="Source"><![CDATA[--!strict

local EngineerBrace = {}

export type State = {
    activeUntil: number,
    capacity: number,
    maxCapacity: number,
    ownerUserId: number,
    revision: number,
}

local MAX_DURATION = 30
local MAX_CAPACITY = 40

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function EngineerBrace.default(): State
    return {
        activeUntil = 0,
        capacity = 0,
        maxCapacity = 0,
        ownerUserId = 0,
        revision = 0,
    }
end

function EngineerBrace.normalize(value: any): State
    local result = EngineerBrace.default()
    if type(value) ~= "table" then
        return result
    end
    if finite(value.activeUntil) and value.activeUntil >= 0 then
        result.activeUntil = value.activeUntil
    end
    if finite(value.maxCapacity) and value.maxCapacity >= 0 then
        result.maxCapacity = math.clamp(math.floor(value.maxCapacity), 0, MAX_CAPACITY)
    end
    if finite(value.capacity) and value.capacity >= 0 then
        result.capacity = math.clamp(math.floor(value.capacity), 0, result.maxCapacity)
    end
    if finite(value.ownerUserId) and value.ownerUserId >= 0 then
        result.ownerUserId = math.floor(value.ownerUserId)
    end
    if finite(value.revision) and value.revision >= 0 then
        result.revision = math.floor(value.revision)
    end
    return result
end

function EngineerBrace.deploy(
    state: State,
    now: number,
    duration: number,
    capacity: number,
    ownerUserId: number
): (State, any)
    local current = EngineerBrace.normalize(state)
    if
        not finite(now)
        or not finite(duration)
        or not finite(capacity)
        or not finite(ownerUserId)
        or duration <= 0
        or capacity <= 0
        or ownerUserId < 1
    then
        return current, { applied = false, reason = "invalid_deployment" }
    end

    local boundedDuration = math.clamp(duration, 1, MAX_DURATION)
    local boundedCapacity = math.clamp(math.floor(capacity), 1, MAX_CAPACITY)
    local nextState = {
        activeUntil = now + boundedDuration,
        capacity = boundedCapacity,
        maxCapacity = boundedCapacity,
        ownerUserId = math.floor(ownerUserId),
        revision = current.revision + 1,
    }
    return nextState,
        {
            applied = true,
            activeUntil = nextState.activeUntil,
            capacity = nextState.capacity,
            duration = boundedDuration,
            ownerUserId = nextState.ownerUserId,
            reason = "deployed",
            revision = nextState.revision,
        }
end

function EngineerBrace.absorb(state: State, amount: number, now: number): (State, any)
    local current = EngineerBrace.normalize(state)
    if not finite(amount) or not finite(now) or amount <= 0 then
        return current, { applied = false, reason = "invalid_pressure" }
    end
    local boundedAmount = math.clamp(math.ceil(amount), 1, 100)
    if current.capacity <= 0 then
        return current,
            {
                absorbed = 0,
                applied = false,
                reason = "brace_empty",
                remaining = boundedAmount,
            }
    end
    if now >= current.activeUntil then
        local expired = table.clone(current)
        expired.capacity = 0
        return expired,
            {
                absorbed = 0,
                applied = false,
                reason = "brace_expired",
                remaining = boundedAmount,
            }
    end

    local absorbed = math.min(current.capacity, boundedAmount)
    local nextState = table.clone(current)
    nextState.capacity -= absorbed
    return nextState,
        {
            absorbed = absorbed,
            applied = absorbed > 0,
            exhausted = nextState.capacity <= 0,
            ownerUserId = current.ownerUserId,
            reason = if nextState.capacity <= 0 then "brace_exhausted" else "pressure_absorbed",
            remaining = boundedAmount - absorbed,
            revision = current.revision,
        }
end

function EngineerBrace.snapshot(state: State, now: number): any
    local current = EngineerBrace.normalize(state)
    local active = finite(now) and now < current.activeUntil and current.capacity > 0
    return {
        active = active,
        activeUntil = current.activeUntil,
        capacity = if active then current.capacity else 0,
        maxCapacity = current.maxCapacity,
        ownerUserId = current.ownerUserId,
        remainingSeconds = if active then math.max(0, current.activeUntil - now) else 0,
        revision = current.revision,
    }
end

EngineerBrace.MaxCapacity = MAX_CAPACITY
EngineerBrace.MaxDuration = MAX_DURATION

return table.freeze(EngineerBrace)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Entitlements</string>
          <string name="Source"><![CDATA[--!strict

--[[
    What a player owns, how a receipt becomes that, and the two ways a grant
    can be lost if nobody is careful.

    This module is pure on purpose, and the purpose is not tidiness. Roblox's
    `ProcessReceipt` cannot be exercised in Studio -- the round trip needs a
    real purchase on a real account -- so everything that *decides* anything
    about a purchase has to be testable without it. What is left for the
    platform is the call itself.

    Three rules hold the whole thing up.

    **The purchase id is the idempotency key, and a duplicate is a success.**
    Roblox retries `ProcessReceipt` until it is told the grant is durable. A
    retry of a purchase already recorded must answer "granted" rather than
    grant again -- answering "not yet" would retry forever, and granting again
    would hand out two of something bought once. So `apply` reports both what
    it did and whether the receipt may be acknowledged, and those are different
    answers.

    **An unknown product is never consumed.** A receipt naming a product this
    build has never heard of resolves to nothing, and reporting that as a
    successful grant would tell the platform to stop retrying a purchase the
    player has paid for and not received. It is refused instead, so the receipt
    stays pending until a build that knows the product handles it. This is the
    one case where doing nothing is much better than doing something.

    **A grant that arrives while the profile is away goes in the mailbox.** A
    receipt can land in a server where the player's profile is not loaded, or
    is loaded and locked by another server. Writing entitlements into a profile
    that is not ours is how two servers overwrite one save; refusing outright
    would drop the purchase. The mailbox is a third place -- neither the
    profile nor the platform -- that holds the receipt until a load can drain
    it. It lives outside the profile by construction, because its entire reason
    for existing is the moments when the profile does not.
]]

export type State = {
    -- What is owned, as a set. A set rather than a list because ownership is
    -- a membership question and a list would let the same id appear twice.
    entitlements: { [string]: boolean },
    -- Every purchase id already applied, with when. The ledger that makes a
    -- retry idempotent.
    processed: { [string]: number },
    -- What is worn, per cosmetic slot. Gameplay branches on this and never on
    -- `entitlements` -- what is equipped is a profile field like every other,
    -- and what is owned is a question only the commerce seam is allowed to ask.
    equipped: { [string]: string },
}

export type Receipt = {
    purchaseId: string,
    productId: string,
    at: number,
}

export type Result = {
    applied: boolean,
    -- Whether the platform may stop retrying. True for a fresh grant AND for a
    -- duplicate, false for anything this build could not resolve.
    acknowledge: boolean,
    reason: string,
    granted: { string },
}

local Entitlements = {}

local MAX_ID_LENGTH = 64
-- A mailbox is a holding pen, not a queue with a future. If a player has this
-- many unclaimed receipts something is wrong upstream, and growing without
-- bound would eventually fail the write that is meant to protect them.
local MAX_MAILBOX = 32

local function validId(value: any): boolean
    return type(value) == "string" and #value > 0 and #value <= MAX_ID_LENGTH
end

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Entitlements.default(): State
    return {
        entitlements = {},
        processed = {},
        equipped = {},
    }
end

--[[
    Bound whatever came back off a save.

    Every id is length-checked and every timestamp is a real number, because
    this is storage and storage is the door a forged profile comes through. An
    equipped cosmetic that the catalog no longer knows is dropped rather than
    kept: a slot pointing at nothing is a slot the appearance code has to guard
    forever, and a cosmetic removed from the catalog is removed.
]]
function Entitlements.normalize(value: any, isKnownCosmetic: ((string) -> boolean)?): State
    local state = Entitlements.default()
    if type(value) ~= "table" then
        return state
    end

    if type(value.entitlements) == "table" then
        for cosmeticId, owned in value.entitlements do
            if
                validId(cosmeticId)
                and owned == true
                and (isKnownCosmetic == nil or isKnownCosmetic(cosmeticId))
            then
                state.entitlements[cosmeticId] = true
            end
        end
    end
    if type(value.processed) == "table" then
        for purchaseId, at in value.processed do
            if validId(purchaseId) and finite(at) and at >= 0 then
                state.processed[purchaseId] = at
            end
        end
    end
    if type(value.equipped) == "table" then
        for slot, cosmeticId in value.equipped do
            --[[
                Worn implies owned, on the way back in as well as on the way
                through `equip`. A slot pointing at something this profile does
                not own is a free cosmetic for anyone who can write a save
                field, and it is also the state a refund leaves behind -- both
                arrive here, and both are dropped rather than drawn.
            ]]
            if
                validId(slot)
                and validId(cosmeticId)
                and state.entitlements[cosmeticId] == true
                and (isKnownCosmetic == nil or isKnownCosmetic(cosmeticId))
            then
                state.equipped[slot] = cosmeticId
            end
        end
    end
    return state
end

function Entitlements.owns(state: any, cosmeticId: any): boolean
    if type(state) ~= "table" or type(state.entitlements) ~= "table" then
        return false
    end
    return type(cosmeticId) == "string" and state.entitlements[cosmeticId] == true
end

function Entitlements.equippedIn(state: any, slot: any): string?
    if type(state) ~= "table" or type(state.equipped) ~= "table" then
        return nil
    end
    if type(slot) ~= "string" then
        return nil
    end
    return state.equipped[slot]
end

--[[
    Apply one receipt.

    `resolve` turns a product id into the cosmetic ids it grants; the catalog
    supplies it rather than being required here, so this module knows what a
    grant *is* without knowing what is for sale.
]]
function Entitlements.apply(
    state: any,
    receipt: any,
    resolve: (string) -> { string }
): (State, Result)
    local current = Entitlements.normalize(state)
    if
        type(receipt) ~= "table"
        or not validId(receipt.purchaseId)
        or not validId(receipt.productId)
    then
        return current,
            {
                applied = false,
                acknowledge = false,
                reason = "malformed_receipt",
                granted = {},
            }
    end

    if current.processed[receipt.purchaseId] ~= nil then
        -- Already ours. The platform is retrying because it never heard us the
        -- first time, and the honest answer is yes, we have it.
        return current,
            {
                applied = false,
                acknowledge = true,
                reason = "duplicate",
                granted = {},
            }
    end

    local granted = resolve(receipt.productId)
    if type(granted) ~= "table" or #granted == 0 then
        return current,
            {
                applied = false,
                acknowledge = false,
                reason = "unknown_product",
                granted = {},
            }
    end

    local at = if finite(receipt.at) and receipt.at >= 0 then receipt.at else 0
    local next: State = {
        entitlements = table.clone(current.entitlements),
        processed = table.clone(current.processed),
        equipped = table.clone(current.equipped),
    }
    local applied: { string } = {}
    for _, cosmeticId in granted do
        if validId(cosmeticId) then
            next.entitlements[cosmeticId] = true
            table.insert(applied, cosmeticId)
        end
    end
    if #applied == 0 then
        return current,
            {
                applied = false,
                acknowledge = false,
                reason = "unknown_product",
                granted = {},
            }
    end
    next.processed[receipt.purchaseId] = at
    return next,
        {
            applied = true,
            acknowledge = true,
            reason = "granted",
            granted = applied,
        }
end

--[[
    Wear one. Refused for a cosmetic that is not owned, and that refusal is the
    only place ownership is ever asked about outside the commerce seam -- which
    is what keeps gameplay branching on what is equipped rather than on what is
    owned.

    Unequipping is `nil`, and it is always allowed: a player who has stopped
    owning something (a refund, a removed product) must be able to take it off.
]]
function Entitlements.equip(
    state: any,
    slot: any,
    cosmeticId: any,
    slotOf: ((string) -> string?)?
): (State, Result)
    local current = Entitlements.normalize(state)
    if not validId(slot) then
        return current,
            { applied = false, acknowledge = false, reason = "unknown_slot", granted = {} }
    end
    if cosmeticId == nil then
        if current.equipped[slot] == nil then
            return current,
                { applied = false, acknowledge = false, reason = "nothing_worn", granted = {} }
        end
        local next: State = {
            entitlements = table.clone(current.entitlements),
            processed = table.clone(current.processed),
            equipped = table.clone(current.equipped),
        }
        next.equipped[slot] = nil
        return next, { applied = true, acknowledge = false, reason = "removed", granted = {} }
    end
    if not Entitlements.owns(current, cosmeticId) then
        return current, { applied = false, acknowledge = false, reason = "not_owned", granted = {} }
    end
    --[[
        A cosmetic goes in its own slot and no other. Without this an outfit
        could be worn as a lantern shell -- owned, so the ownership check
        passes -- and the appearance code would be asked to hang a coat on a
        lamp. The catalog answers where each one belongs; passing the resolver
        rather than requiring the catalog keeps this module ignorant of what is
        for sale, which is what lets the spec drive it with a stub.
    ]]
    if slotOf ~= nil and slotOf(cosmeticId) ~= slot then
        return current,
            { applied = false, acknowledge = false, reason = "wrong_slot", granted = {} }
    end
    if current.equipped[slot] == cosmeticId then
        return current,
            { applied = false, acknowledge = false, reason = "already_worn", granted = {} }
    end
    local next: State = {
        entitlements = table.clone(current.entitlements),
        processed = table.clone(current.processed),
        equipped = table.clone(current.equipped),
    }
    next.equipped[slot] = cosmeticId
    return next, { applied = true, acknowledge = false, reason = "equipped", granted = {} }
end

--[[
    The mailbox: receipts held for a profile that was not available.

    A plain list, because it is written by a server that may not be the one
    that drains it and the simplest durable shape is the one least able to go
    wrong. Enqueuing a purchase id already held is a no-op for the same reason
    applying one already processed is: the platform retries.
]]
function Entitlements.emptyMailbox(): { Receipt }
    return {}
end

function Entitlements.normalizeMailbox(value: any): { Receipt }
    local mailbox: { Receipt } = {}
    if type(value) ~= "table" then
        return mailbox
    end
    local seen: { [string]: boolean } = {}
    for _, entry in value do
        if
            type(entry) == "table"
            and validId(entry.purchaseId)
            and validId(entry.productId)
            and not seen[entry.purchaseId]
            and #mailbox < MAX_MAILBOX
        then
            seen[entry.purchaseId] = true
            table.insert(mailbox, {
                purchaseId = entry.purchaseId,
                productId = entry.productId,
                at = if finite(entry.at) and entry.at >= 0 then entry.at else 0,
            })
        end
    end
    return mailbox
end

function Entitlements.enqueue(mailbox: any, receipt: any): ({ Receipt }, boolean)
    local current = Entitlements.normalizeMailbox(mailbox)
    if
        type(receipt) ~= "table"
        or not validId(receipt.purchaseId)
        or not validId(receipt.productId)
    then
        return current, false
    end
    for _, held in current do
        if held.purchaseId == receipt.purchaseId then
            return current, false
        end
    end
    if #current >= MAX_MAILBOX then
        return current, false
    end
    local next = table.clone(current)
    table.insert(next, {
        purchaseId = receipt.purchaseId,
        productId = receipt.productId,
        at = if finite(receipt.at) and receipt.at >= 0 then receipt.at else 0,
    })
    return next, true
end

--[[
    Drain the mailbox into a profile's commerce state.

    A receipt this build cannot resolve stays in the mailbox rather than being
    dropped, for the same reason `apply` refuses to acknowledge it: the product
    may exist in the next build, and a purchase quietly discarded is a support
    ticket nobody can answer.
]]
function Entitlements.drain(
    state: any,
    mailbox: any,
    resolve: (string) -> { string }
): (State, { Receipt }, { string })
    local current = Entitlements.normalize(state)
    local held = Entitlements.normalizeMailbox(mailbox)
    local remaining: { Receipt } = {}
    local granted: { string } = {}
    for _, receipt in held do
        local next, result = Entitlements.apply(current, receipt, resolve)
        current = next
        if result.acknowledge then
            for _, cosmeticId in result.granted do
                table.insert(granted, cosmeticId)
            end
        else
            table.insert(remaining, receipt)
        end
    end
    return current, remaining, granted
end

--[[
    The whole decision a receipt handler makes, in one pure place.

    `ProcessReceipt` runs on a server that may or may not be holding the
    buyer's profile, and the branch it takes decides whether a purchase is
    delivered, held or lost. Keeping that branch here rather than inside the
    service is what makes it testable at all: the platform call cannot be
    exercised in Studio, so the decision must be exercisable without it.

    `profileState` is the buyer's commerce state if this server holds their
    profile and may write it, and nil otherwise. The three verdicts map onto
    what the platform is told:

      * `granted`  -- the grant is ours, durably, once the caller's write
                      lands. The platform may stop retrying.
      * `held`     -- we could not write the profile, so the receipt went to
                      the mailbox instead. Also durable, also acknowledged: a
                      mailbox entry is a promise a later load will keep.
      * `retry`    -- nothing could be done with this receipt in this build.
                      The platform must call again.

    The distinction between `held` and `retry` is the one that costs money if
    it is wrong. Holding an unknown product would tell the platform to stop
    retrying a purchase this build cannot deliver; retrying a receipt we could
    have banked leaves a player waiting on a coincidence.
]]
function Entitlements.route(
    profileState: any,
    mailbox: any,
    receipt: any,
    resolve: (string) -> { string }
): (State?, { Receipt }, string)
    local heldMailbox = Entitlements.normalizeMailbox(mailbox)
    if
        type(receipt) ~= "table"
        or not validId(receipt.purchaseId)
        or not validId(receipt.productId)
    then
        return nil, heldMailbox, "retry"
    end

    -- Nothing is held or granted for a product this build cannot resolve, in
    -- either branch. A mailbox full of receipts nobody can ever apply is a
    -- support queue with no answer at the end of it.
    local granted = resolve(receipt.productId)
    if type(granted) ~= "table" or #granted == 0 then
        return nil, heldMailbox, "retry"
    end

    if profileState ~= nil then
        local next, result = Entitlements.apply(profileState, receipt, resolve)
        if result.acknowledge then
            -- Includes the duplicate case, which is the platform retrying a
            -- grant we already have. Returning the state either way lets the
            -- caller write once and not think about which it was.
            return next, heldMailbox, "granted"
        end
        return nil, heldMailbox, "retry"
    end

    -- Already waiting is already durable. A retry into a mailbox that holds
    -- the purchase id is the same answer as the first time.
    for _, alreadyHeld in heldMailbox do
        if alreadyHeld.purchaseId == receipt.purchaseId then
            return nil, heldMailbox, "held"
        end
    end
    local nextMailbox, accepted = Entitlements.enqueue(heldMailbox, receipt)
    if not accepted then
        return nil, heldMailbox, "retry"
    end
    return nil, nextMailbox, "held"
end

return table.freeze(Entitlements)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Environment</string>
          <string name="Source"><![CDATA[--!strict

local Environment = {}

export type Name = "local" | "test" | "staging" | "production"

export type ResolveInput = {
    isStudio: boolean,
    placeId: number,
    requested: string?,
    productionPlaceIds: { number },
}

local validNames: { [string]: boolean } = {
    ["local"] = true,
    test = true,
    staging = true,
    production = true,
}

local function contains(values: { number }, target: number): boolean
    for _, value in values do
        if value == target then
            return true
        end
    end

    return false
end

function Environment.isValid(value: string): boolean
    return validNames[value] == true
end

function Environment.resolve(input: ResolveInput): (Name?, string?)
    local requested = input.requested
    if requested ~= nil and not Environment.isValid(requested) then
        return nil, string.format("unknown environment %q", requested)
    end

    if input.isStudio then
        if requested == "test" then
            return "test", nil
        end

        if requested == nil or requested == "local" then
            return "local", nil
        end

        return nil, "staging and production environments cannot run in Roblox Studio"
    end

    local isProductionPlace = contains(input.productionPlaceIds, input.placeId)
    if isProductionPlace then
        if requested ~= nil and requested ~= "production" then
            return nil, "a production place cannot boot with a non-production environment"
        end

        return "production", nil
    end

    if requested == "production" then
        return nil, "production requires the current place ID in ProductionPlaceIds"
    end

    if requested == "local" or requested == "test" then
        return nil, "local and test environments require Roblox Studio"
    end

    return "staging", nil
end

return table.freeze(Environment)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Epilogue</string>
          <string name="Source"><![CDATA[--!strict

--[[
    What the game says when it is over.

    The obvious way to write an epilogue is to branch on the ending: three
    endings, three paragraphs, done. That would waste six chapters. A
    player who spared every memory in the Crown and one who erased them
    all should not read the same closing text merely because they both put
    the lantern out, and the whole design of this game's decisions -- made
    with the hands, in the middle of something, never in a menu -- only
    pays off if the ending remembers them.

    So this reads the entire story: every resolved chapter's outcome, what
    happened in the Hollow's scenes, and the ending. Each contributes a
    line, in chapter order, and the ending supplies the last word. A save
    that has resolved nothing still gets a coherent epilogue, because a
    player can reach the Hollow's mouth without having closed a chapter
    behind them and the game must not go blank at them.

    Every chapter outcome the catalog can record has a line here, and the
    spec walks the catalog rather than a list kept in this file, so a new
    outcome cannot ship without one.
]]

local ChapterCatalog = require("./ChapterCatalog")
local HollowFinale = require("./Content/Definitions/HollowFinale")
local ResidentRoster = require("./ResidentRoster")

local Epilogue = {}

export type Resolution = {
    -- The ending's own name, or nil for a story that never reached the seat.
    ending: string?,
    title: string,
    -- One line per resolved chapter, in chapter order, then the Hollow's.
    lines: { string },
    -- What the town is called afterwards, for the world sign.
    townState: string,
}

--[[
    A line per outcome, in the voice of the town rather than the game.
    Keyed by chapter and outcome because two chapters can record the same
    word -- the Witch and the Titan both end on "broken" -- and they do
    not mean the same thing.
]]
local OUTCOME_LINES: { [string]: { [string]: string } } = {
    chapter_one = {
        preserved = "The forest kept its old paths, and people still walk them.",
        scarred = "The forest grew back crooked, and the road through it is harder than it was.",
        harmed = "Nothing has come out of the wood since. Nobody says that is a relief.",
    },
    chapter_two = {
        cleared = "The Delve's air runs clean, and there is iron coming up again.",
        fouled = "The Delve is worked in short shifts now, and nobody goes deep.",
        mixed = "Half the Delve breathes. The other half is bricked up and marked.",
    },
    chapter_three = {
        sealed = "The Fen is quiet, and the light in it stays where it is put.",
        bound = "The Fen is watched. What is under it is held rather than gone.",
        broken = "The Fen went dark all at once, and the water has not settled since.",
    },
    chapter_four = {
        navigable = "The harbour takes boats again. Two came in this spring.",
        scoured = "The channel silted where the tide dropped, and only small craft use it.",
        broken = "There is no harbour mouth any more, only a bay with a bad memory.",
    },
    chapter_five = {
        sheltered = "There is still something living in the Vale, and it keeps to itself.",
        thinned = "The Vale is emptier every year, but it is not empty.",
        silenced = "Nothing calls in the Vale now. The quiet up there is total.",
    },
    chapter_six = {
        remembered = "Every true face in the Crown is still standing, and people go to read them.",
        recast = "Some of the Crown's dead are still named. The rest are rubble nobody sorts.",
        erased = "The Crown is clean stone. There is no record left of who was in it.",
    },
    chapter_seven = {
        lantern_kept = "The lantern road still runs, and there is always somebody below it.",
        lantern_out = "There is no lantern road. The nights are only nights now.",
        lantern_shared = "Everyone carries a piece of it. No road, and nothing at the bottom.",
    },
}

local ENDING_TITLES: { [string]: string } = {
    ending_kept = "THE LANTERN KEPT",
    ending_ended = "THE LANTERN PUT OUT",
    ending_shared = "THE LANTERN SHARED",
}

local TOWN_STATES: { [string]: string } = {
    ending_kept = "emberhollow_tended",
    ending_ended = "emberhollow_dark",
    ending_shared = "emberhollow_scattered",
}

local POST_LINES: { [string]: string } = {
    post_gate = "The gate went first, and the copy of this town burned from the road in.",
    post_road = "It came up the road, past the posts nobody could spare, into the middle.",
    post_hearth = "It reached the hearth. In a town that was never lived in, that still mattered.",
}

Epilogue.OutcomeLines = OUTCOME_LINES
Epilogue.EndingTitles = ENDING_TITLES

local function chapterOutcome(story: any, definition: any): string?
    if definition.id == "chapter_one" then
        local record = if type(story) == "table" then story.chapterOne else nil
        if type(record) == "table" and record.status == "complete" then
            return record.wardenOutcome
        end
        return nil
    end
    local chapters = if type(story) == "table" then story.chapters else nil
    local record = if type(chapters) == "table" then chapters[definition.id] else nil
    if type(record) == "table" and record.status == "complete" then
        return record.outcome
    end
    return nil
end

--[[
    Read a whole save and say what became of it. Takes the story block
    rather than the profile so anything that has a story -- a live
    profile, a restored backup, an admin inspection -- can ask.
]]
function Epilogue.resolve(story: any): Resolution
    local lines: { string } = {}
    for _, definition in ChapterCatalog.list() do
        local outcome = chapterOutcome(story, definition)
        if outcome ~= nil then
            local byChapter = OUTCOME_LINES[definition.id]
            local line = if byChapter ~= nil then byChapter[outcome] else nil
            if line ~= nil then
                table.insert(lines, line)
            end
        end
    end

    local finale = if type(story) == "table" then story.finale else nil
    local ending: string? = nil
    if type(finale) == "table" and finale.status == "complete" then
        ending = finale.ending
        local postLine = POST_LINES[tostring(finale.abandonedPost)]
        if postLine ~= nil then
            table.insert(lines, postLine)
        end
        if type(finale.rescued) == "string" then
            local rescued = ResidentRoster.get(finale.rescued)
            local left = if type(finale.leftBehind) == "string"
                then ResidentRoster.get(finale.leftBehind)
                else nil
            if rescued ~= nil and left ~= nil then
                table.insert(
                    lines,
                    string.format(
                        "%s came back up. %s did not, and everybody knows which.",
                        (rescued :: any).displayName,
                        (left :: any).displayName
                    )
                )
            elseif rescued ~= nil then
                table.insert(
                    lines,
                    string.format("%s came back up with you.", (rescued :: any).displayName)
                )
            end
        else
            table.insert(lines, "Nobody came back up with you. There was light for one.")
        end
    end

    if #lines == 0 then
        table.insert(lines, "Emberhollow is still standing, and its story is not written yet.")
    end

    return {
        ending = ending,
        lines = lines,
        title = if ending ~= nil then ENDING_TITLES[ending] else "THE STORY SO FAR",
        townState = if ending ~= nil then TOWN_STATES[ending] else "emberhollow_lit",
    }
end

--[[
    The world state each ending produces, which is also chapter seven's
    outcome. Kept here beside the lines that describe it so the two cannot
    drift; SaveSchema writes the same mapping when it records the finale,
    and the spec pins that they agree.
]]
local ENDING_OUTCOMES: { [string]: string } = {
    ending_kept = "lantern_kept",
    ending_ended = "lantern_out",
    ending_shared = "lantern_shared",
}

Epilogue.EndingOutcomes = ENDING_OUTCOMES

-- The Hollow's own definition names its endings; this is the check that
-- nothing here has drifted from it.
function Epilogue.knowsEnding(endingId: any): boolean
    if type(endingId) ~= "string" then
        return false
    end
    local outcome = ENDING_OUTCOMES[endingId]
    if
        outcome == nil
        or ENDING_TITLES[endingId] == nil
        or TOWN_STATES[endingId] == nil
        or OUTCOME_LINES.chapter_seven[outcome] == nil
    then
        return false
    end
    for _, definition in HollowFinale.Endings do
        if definition.id == endingId then
            return true
        end
    end
    return false
end

return table.freeze(Epilogue)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Equipment</string>
          <string name="Source"><![CDATA[--!strict

local Equipment = {}

export type Equipped = { [string]: string? }

type Definition = {
    slot: string,
    displayName: string,
    description: string,
    damageReduction: number,
    staminaRegenMultiplier: number,
    --[[
        Weapon-slot statistics. The family (`kind`) decides the moveset the
        way the roadmap asks: a ranged family declares `strikeRange` (the
        strike resolves at distance and the client draws a shot), a reaching
        melee family declares `meleeReach` (extended arm, no projectile), and
        an on-hit family carries its rider (stamina refund to the striker, or
        a snare on the struck enemy). The server reads all of these -- a
        client never submits range, damage, or an effect.
    ]]
    kind: string?,
    strikeRange: number?,
    meleeReach: number?,
    strikeDamageMultiplier: number?,
    onHitStaminaRefund: number?,
    onHitSnareSeconds: number?,
}

local DEFINITIONS: { [string]: Definition } = {
    gear_ironroot_hood = table.freeze({
        slot = "head",
        displayName = "IRONROOT HOOD",
        description = "Softens incoming damage by 5%.",
        damageReduction = 0.05,
        staminaRegenMultiplier = 1,
    }),
    gear_bramble_boots = table.freeze({
        slot = "feet",
        displayName = "BRAMBLE BOOTS",
        description = "Recover stamina 10% faster.",
        damageReduction = 0,
        staminaRegenMultiplier = 1.1,
    }),
    gear_thornwood_bow = table.freeze({
        slot = "weapon",
        displayName = "THORNWOOD BOW",
        description = "Strike from 30 studs. Arrows hit for 80% of a close blow.",
        damageReduction = 0,
        staminaRegenMultiplier = 1,
        kind = "bow",
        strikeRange = 30,
        strikeDamageMultiplier = 0.8,
    }),
    --[[
        The other five weapon families. Every number stays inside the bounds
        combat already clamps (damage multiplier 0.5-1.5 at the strike,
        damage reduction capped at 0.25 in stats), so no family can silence
        an enemy's mechanics or stack into an economy problem. Identities
        trade against each other: the maul is the damage ceiling with no
        reach, the lance buys reach with no rider, the sling trades the
        bow's range and damage for a snare, the edge sustains its wielder,
        and the cudgel is the one weapon that also guards.
    ]]
    gear_heartwood_maul = table.freeze({
        slot = "weapon",
        displayName = "HEARTWOOD MAUL",
        description = "Slow heavy blows land 45% harder up close.",
        damageReduction = 0,
        staminaRegenMultiplier = 1,
        kind = "maul",
        strikeDamageMultiplier = 1.45,
    }),
    gear_briar_lance = table.freeze({
        slot = "weapon",
        displayName = "BRIAR LANCE",
        description = "Full-strength strikes from 14 studs of reach.",
        damageReduction = 0,
        staminaRegenMultiplier = 1,
        kind = "lance",
        meleeReach = 14,
        strikeDamageMultiplier = 1,
    }),
    gear_foxfire_sling = table.freeze({
        slot = "weapon",
        displayName = "FOXFIRE SLING",
        description = "Stones from 22 studs hit for 70% and briefly snare the threat.",
        damageReduction = 0,
        staminaRegenMultiplier = 1,
        kind = "sling",
        strikeRange = 22,
        strikeDamageMultiplier = 0.7,
        onHitSnareSeconds = 2.5,
    }),
    gear_amber_edge = table.freeze({
        slot = "weapon",
        displayName = "AMBER EDGE",
        description = "Clean cuts hit 10% harder and return 6 stamina.",
        damageReduction = 0,
        staminaRegenMultiplier = 1,
        kind = "edge",
        strikeDamageMultiplier = 1.1,
        onHitStaminaRefund = 6,
    }),
    gear_warden_cudgel = table.freeze({
        slot = "weapon",
        displayName = "WARDEN CUDGEL",
        description = "A guard's weapon: 5% harder blows, 4% softer hits taken.",
        damageReduction = 0.04,
        staminaRegenMultiplier = 1,
        kind = "cudgel",
        strikeDamageMultiplier = 1.05,
    }),

    --[[
        Bramblewake's other eight. The starting region shipped with a hood
        and boots and nothing else, because its kit predates the slot
        system -- the census recorded that gap, and this closes it. The
        numbers are the gentlest in the game on purpose: this is the gear
        a player crafts before they understand the light/heavy choice, so
        it introduces the two lines without punishing either.
    ]]
