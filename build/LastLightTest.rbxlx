        hoverOrigin,
        Color3.fromRGB(31, 35, 42),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        CFrame.Angles(math.rad(-12), 0, 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "CrowWing",
            Vector3.new(7.8, 0.65, 3.4),
            hoverOrigin + Vector3.new(side * 4.2, 0.25, 0.5),
            Color3.fromRGB(42, 47, 55),
            Enum.Material.Slate,
            nil,
            CFrame.Angles(0, math.rad(side * 10), math.rad(side * 12))
        )
        addEye(
            model,
            hoverOrigin + Vector3.new(side * 0.72, 0.65, -2.12),
            Color3.fromRGB(126, 211, 194)
        )
    end
    part(
        model,
        "CrowBeak",
        Vector3.new(1.5, 1.1, 3.3),
        hoverOrigin + Vector3.new(0, 0.1, -3.35),
        Color3.fromRGB(183, 154, 83),
        Enum.Material.Wood,
        nil,
        CFrame.Angles(math.rad(-12), 0, 0)
    )
    part(
        model,
        "StolenSpark",
        Vector3.new(1.1, 1.1, 1.1),
        hoverOrigin + Vector3.new(0, -2.2, 0.2),
        Color3.fromRGB(255, 203, 97),
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    return core
end

local function snapvine(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "SnapvineRoot",
        Vector3.new(4.6, 2.2, 4.6),
        origin,
        Color3.fromRGB(59, 46, 35),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "VineStem",
        Vector3.new(6.5, 1.8, 1.8),
        origin + Vector3.new(0, 3.6, 0),
        Color3.fromRGB(57, 91, 53),
        Enum.Material.Grass,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, 0, math.rad(90))
    )
    for side = -1, 1, 2 do
        part(
            model,
            "SnapJaw",
            Vector3.new(5.5, 1.5, 4.2),
            origin + Vector3.new(0, 6.2 + side * 0.9, -0.9),
            if side < 0 then Color3.fromRGB(73, 111, 62) else Color3.fromRGB(91, 126, 65),
            Enum.Material.Grass,
            nil,
            CFrame.Angles(math.rad(side * 15), 0, 0)
        )
        addEye(model, origin + Vector3.new(side * 1.2, 6.4, -3), Color3.fromRGB(255, 116, 82))
        for index = 1, 2 do
            part(
                model,
                "JawThorn",
                Vector3.new(0.55, 1.5, 0.55),
                origin + Vector3.new(side * index * 1.25, 6.1, -3.15),
                Color3.fromRGB(221, 205, 151),
                Enum.Material.Wood,
                nil,
                CFrame.Angles(math.rad(70), 0, math.rad(side * 15))
            )
        end
    end
    return core
end

local function barkRam(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BarkRamCore",
        Vector3.new(7.5, 5.8, 8.4),
        origin + Vector3.new(0, 0.5, 0),
        Color3.fromRGB(65, 49, 38),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "RamBrow",
        Vector3.new(6.2, 3.6, 3),
        origin + Vector3.new(0, 1.5, -4.1),
        Color3.fromRGB(54, 70, 50),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        part(
            model,
            "RamHorn",
            Vector3.new(6.2, 1.5, 1.5),
            origin + Vector3.new(side * 3.2, 2.2, -5.1),
            Color3.fromRGB(219, 195, 139),
            Enum.Material.Wood,
            Enum.PartType.Cylinder,
            CFrame.Angles(0, math.rad(90), math.rad(side * 13))
        )
        for front = -1, 1, 2 do
            part(
                model,
                "RamLeg",
                Vector3.new(1.7, 4.2, 1.7),
                origin + Vector3.new(side * 2.45, -2.6, front * 2.35),
                Color3.fromRGB(57, 43, 34),
                Enum.Material.Wood,
                nil,
                CFrame.Angles(0, 0, math.rad(side * 4))
            )
        end
        addEye(model, origin + Vector3.new(side * 1.15, 1.8, -5.38), Color3.fromRGB(255, 152, 91))
    end
    part(
        model,
        "MossBack",
        Vector3.new(6.5, 1.5, 6),
        origin + Vector3.new(0, 3.5, 0.6),
        Color3.fromRGB(62, 91, 55),
        Enum.Material.Grass,
        Enum.PartType.Ball,
        nil
    )
    return core
end

--[[
    The Delve's six. Their silhouettes are deliberately unlike the
    forest's rounded, mossy masses: plated, angular, rail-borne and
    lit from inside. Readability at night comes from a hot interior
    color -- ember, slag, whitedamp green -- rather than from bulk.
]]
local IRON_PLATE = Color3.fromRGB(88, 84, 82)
local IRON_DARK = Color3.fromRGB(54, 50, 49)
local EMBER = Color3.fromRGB(255, 126, 48)
local SLAG = Color3.fromRGB(255, 168, 66)
local WHITEDAMP = Color3.fromRGB(158, 226, 138)
local ECHO_BLUE = Color3.fromRGB(126, 176, 214)

local function cinderMite(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "MiteShell",
        Vector3.new(3.2, 2.2, 3.8),
        origin,
        IRON_DARK,
        Enum.Material.Metal,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "EmberVent",
        Vector3.new(1.9, 0.9, 2.4),
        origin + Vector3.new(0, 1.2, 0.3),
        EMBER,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        for pair = -1, 1, 2 do
            part(
                model,
                "MiteLeg",
                Vector3.new(0.32, 2.2, 0.32),
                origin + Vector3.new(side * 1.5, -1, pair * 1.1),
                IRON_PLATE,
                Enum.Material.Metal,
                nil,
                CFrame.Angles(0, 0, math.rad(side * 24))
            )
        end
        addEye(model, origin + Vector3.new(side * 0.6, 0.5, -1.85), EMBER)
    end
    return core
end

local function railHound(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "HoundChassis",
        Vector3.new(2.6, 2.4, 6.4),
        origin,
        IRON_PLATE,
        Enum.Material.DiamondPlate,
        nil,
        nil
    )
    part(
        model,
        "HoundSnout",
        Vector3.new(1.8, 1.6, 2.2),
        origin + Vector3.new(0, 0.2, -4),
        IRON_DARK,
        Enum.Material.Metal,
        nil,
        nil
    )
    part(
        model,
        "SparkTrail",
        Vector3.new(1.2, 0.5, 3.4),
        origin + Vector3.new(0, -1.2, 2.6),
        EMBER,
        Enum.Material.Neon,
        nil,
        nil
    )
    --[[
        A cylinder's axis runs along its Size.X, and Y/Z are its diameters.
        These wheels were sized as though the axis were Y and then turned
        a quarter turn on top of it, which buried them inside the chassis:
        seen in Studio the hound was a floating plank with an ember streak.
        The axle now runs left to right, which is the only way a wheel on
        a rail can run, and four short legs put a creature under it.
    ]]
    for side = -1, 1, 2 do
        for pair = -1, 1, 2 do
            part(
                model,
                "HoundWheel",
                Vector3.new(0.5, 1.6, 1.6),
                origin + Vector3.new(side * 1.5, -1.3, pair * 2),
                IRON_DARK,
                Enum.Material.Metal,
                Enum.PartType.Cylinder,
                nil
            )
            part(
                model,
                "HoundLeg",
                Vector3.new(0.4, 1.6, 0.4),
                origin + Vector3.new(side * 1.05, -1, pair * 2),
                IRON_PLATE,
                Enum.Material.Metal,
                nil,
                CFrame.Angles(0, 0, math.rad(side * 14))
            )
        end
        addEye(model, origin + Vector3.new(side * 0.5, 0.7, -4.9), EMBER)
    end
    return core
end

local function slagSpitter(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "SpitterBase",
        Vector3.new(4.4, 3.6, 4.4),
        origin,
        IRON_DARK,
        Enum.Material.Slate,
        nil,
        nil
    )
    part(
        model,
        "SpitterMouth",
        Vector3.new(2.4, 2.4, 2.4),
        origin + Vector3.new(0, 2.4, -1.6),
        SLAG,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        part(
            model,
            "SpitterRib",
            Vector3.new(0.7, 4.6, 0.7),
            origin + Vector3.new(side * 2.2, 0.8, 0.6),
            IRON_PLATE,
            Enum.Material.Metal,
            nil,
            CFrame.Angles(math.rad(12), 0, math.rad(side * -10))
        )
    end
    -- Same cylinder-axis error as the hound's wheels, and far louder: in
    -- Studio this pool stood as a glowing bar straight up through the
    -- spitter. Thickness belongs on the axis (X), width on the diameters.
    part(
        model,
        "SlagPool",
        Vector3.new(0.4, 5.6, 5.6),
        origin + Vector3.new(0, -1.9, 0),
        SLAG,
        Enum.Material.Neon,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, 0, math.rad(90))
    )
    return core
end

local function shiftEcho(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "EchoTorso",
        Vector3.new(2.4, 3.4, 1.6),
        origin + Vector3.new(0, 0.6, 0),
        ECHO_BLUE,
        Enum.Material.Glass,
        nil,
        nil
    )
    core.Transparency = 0.35
    local head = part(
        model,
        "EchoHead",
        Vector3.new(1.3, 1.4, 1.3),
        origin + Vector3.new(0, 3, 0),
        ECHO_BLUE,
        Enum.Material.Glass,
        nil,
        nil
    )
    head.Transparency = 0.35
    part(
        model,
        "EchoLamp",
        Vector3.new(0.7, 0.9, 0.7),
        origin + Vector3.new(1.4, 1.6, -0.6),
        WHITEDAMP,
        Enum.Material.Neon,
        nil,
        nil
    )
    for side = -1, 1, 2 do
        local arm = part(
            model,
            "EchoArm",
            Vector3.new(0.6, 2.8, 0.6),
            origin + Vector3.new(side * 1.5, 0.8, -0.4),
            ECHO_BLUE,
            Enum.Material.Glass,
            nil,
            CFrame.Angles(math.rad(side * 34), 0, 0)
        )
        arm.Transparency = 0.45
        addEye(model, origin + Vector3.new(side * 0.35, 3.1, -0.72), WHITEDAMP)
    end
    return core
end

local function crankGuard(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "GuardFrame",
        Vector3.new(5.2, 4.6, 3.6),
        origin + Vector3.new(0, 0.6, 0),
        IRON_PLATE,
        Enum.Material.DiamondPlate,
        nil,
        nil
    )
    part(
        model,
        "FrontPlate",
        Vector3.new(6.4, 5.2, 0.9),
        origin + Vector3.new(0, 0.9, -2.4),
        IRON_DARK,
        Enum.Material.Metal,
        nil,
        CFrame.Angles(math.rad(-6), 0, 0)
    )
    -- The exposed mechanism: the reason a flank strike lands for five
    -- times what the plate allows, and it must read from behind.
    part(
        model,
        "ExposedMechanism",
        Vector3.new(1, 2.6, 2.6),
        origin + Vector3.new(0, 1, 2.1),
        EMBER,
        Enum.Material.Neon,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, math.rad(90), 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "GuardLeg",
            Vector3.new(1.3, 3.2, 1.3),
            origin + Vector3.new(side * 2, -2.2, 0.4),
            IRON_DARK,
            Enum.Material.Metal,
            nil,
            nil
        )
        addEye(model, origin + Vector3.new(side * 1, 2.2, -2.9), EMBER)
    end
    return core
end

local function gasBloomer(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BloomerBulb",
        Vector3.new(4.2, 4.2, 4.2),
        origin + Vector3.new(0, 0.8, 0),
        Color3.fromRGB(72, 88, 64),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        nil
    )
    --[[
        Petals lean up and out from the bulb. Pitching each one before its
        yaw made all five settle into the same plane, so in Studio the
        bloom read as a flat saucer hanging over a shrub. Yaw first, then
        pitch, and the flower opens.
    ]]
    for index = 0, 4 do
        local angle = index * math.pi * 0.4
        part(
            model,
            "BloomPetal",
            Vector3.new(1.6, 0.4, 2.8),
            origin + Vector3.new(math.cos(angle) * 1.5, 3.1, math.sin(angle) * 1.5),
            WHITEDAMP,
            Enum.Material.Neon,
            nil,
            CFrame.Angles(0, -angle, 0) * CFrame.Angles(math.rad(-52), 0, 0)
        )
    end
    local haze = part(
        model,
        "Whitedamp",
        Vector3.new(7.5, 2.6, 7.5),
        origin + Vector3.new(0, -0.6, 0),
        WHITEDAMP,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    haze.Transparency = 0.72
    addEye(model, origin + Vector3.new(0, 1.4, -2.1), EMBER)
    return core
end

--[[
    The Fen's six. Where the Delve reads by heat, the Fen reads by water:
    pale glass, wet reed, and cold witchlight. Several of them are
    deliberately half-hidden shapes -- a heron that is mostly stillness, a
    lurker that is mostly reeds -- so the outline highlight is doing more
    work here than the geometry, which is the point of the place.
]]
local REED_GREEN = Color3.fromRGB(74, 96, 66)
local BOG_DARK = Color3.fromRGB(46, 54, 48)
local MIRROR_PALE = Color3.fromRGB(186, 206, 210)
local WITCHLIGHT = Color3.fromRGB(146, 214, 226)
local LEECH_RED = Color3.fromRGB(120, 52, 58)

local function reedLurker(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "LurkerBody",
        Vector3.new(3.6, 2.4, 6),
        origin,
        BOG_DARK,
        Enum.Material.Slate,
        nil,
        nil
    )
    for index = -2, 2 do
        part(
            model,
            "ReedFrond",
            Vector3.new(0.24, 5.5, 0.24),
            origin + Vector3.new(index * 0.9, 2.4, index * 0.5),
            REED_GREEN,
            Enum.Material.Grass,
            nil,
            CFrame.Angles(math.rad(index * 7), 0, math.rad(index * 9))
        )
    end
    for side = -1, 1, 2 do
        addEye(model, origin + Vector3.new(side * 0.7, 1.3, -2.7), WITCHLIGHT)
    end
    return core
end

local function mirrorling(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "MirrorTorso",
        Vector3.new(2.6, 4, 1.4),
        origin + Vector3.new(0, 0.8, 0),
        MIRROR_PALE,
        Enum.Material.Glass,
        nil,
        nil
    )
    core.Reflectance = 0.55
    local head = part(
        model,
        "MirrorHead",
        Vector3.new(1.4, 1.5, 1.4),
        origin + Vector3.new(0, 3.5, 0),
        MIRROR_PALE,
        Enum.Material.Glass,
        Enum.PartType.Ball,
        nil
    )
    head.Reflectance = 0.55
    for side = -1, 1, 2 do
        local arm = part(
            model,
            "MirrorArm",
            Vector3.new(0.6, 3, 0.6),
            origin + Vector3.new(side * 1.7, 0.9, 0),
            MIRROR_PALE,
            Enum.Material.Glass,
            nil,
            CFrame.Angles(0, 0, math.rad(side * 10))
        )
        arm.Reflectance = 0.4
        addEye(model, origin + Vector3.new(side * 0.36, 3.6, -0.76), WITCHLIGHT)
    end
    return core
end

local function mireLeech(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "LeechBody",
        Vector3.new(1.8, 1.6, 5.2),
        origin,
        LEECH_RED,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    core.Transparency = 0.25
    for index = -1, 1 do
        part(
            model,
            "LeechSegment",
            Vector3.new(1.5, 1.4, 1.4),
            origin + Vector3.new(0, 0.1, index * 1.5),
            BOG_DARK,
            Enum.Material.Slate,
            Enum.PartType.Ball,
            nil
        )
    end
    part(
        model,
        "LeechMouth",
        Vector3.new(0.7, 1.1, 1.1),
        origin + Vector3.new(0, 0, -2.7),
        LEECH_RED,
        Enum.Material.Neon,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, math.rad(90), 0)
    )
    return core
end

local function falseFriend(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "FriendTorso",
        Vector3.new(2.4, 3.6, 1.5),
        origin + Vector3.new(0, 0.8, 0),
        Color3.fromRGB(96, 84, 72),
        Enum.Material.Fabric,
        nil,
        nil
    )
    part(
        model,
        "FriendHead",
        Vector3.new(1.3, 1.4, 1.3),
        origin + Vector3.new(0, 3.2, 0),
        Color3.fromRGB(150, 148, 132),
        Enum.Material.SmoothPlastic,
        nil,
        nil
    )
    -- The tell: it carries a lantern that gives no light, and its hands
    -- are on backwards. Readability by wrongness, not by glow.
    local lantern = part(
        model,
        "DeadLantern",
        Vector3.new(0.8, 1, 0.8),
        origin + Vector3.new(1.6, 1.8, -0.6),
        Color3.fromRGB(58, 62, 56),
        Enum.Material.Metal,
        nil,
        nil
    )
    lantern.Reflectance = 0.1
    for side = -1, 1, 2 do
        part(
            model,
            "BackwardHand",
            Vector3.new(0.6, 0.6, 0.9),
            origin + Vector3.new(side * 1.5, 0.7, 0.5),
            Color3.fromRGB(150, 148, 132),
            Enum.Material.SmoothPlastic,
            nil,
            CFrame.Angles(0, math.rad(180), 0)
        )
        addEye(model, origin + Vector3.new(side * 0.34, 3.3, -0.72), WITCHLIGHT)
    end
    return core
end

local function glassHeron(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "HeronBody",
        Vector3.new(1.8, 2.2, 3.4),
        origin + Vector3.new(0, 3.2, 0),
        MIRROR_PALE,
        Enum.Material.Glass,
        Enum.PartType.Ball,
        nil
    )
    core.Reflectance = 0.4
    part(
        model,
        "HeronNeck",
        Vector3.new(0.5, 3.4, 0.5),
        origin + Vector3.new(0, 5.2, -0.8),
        MIRROR_PALE,
        Enum.Material.Glass,
        nil,
        CFrame.Angles(math.rad(14), 0, 0)
    )
    part(
        model,
        "HeronBeak",
        Vector3.new(0.32, 0.32, 3.4),
        origin + Vector3.new(0, 6.6, -2.6),
        WITCHLIGHT,
        Enum.Material.Neon,
        nil,
        CFrame.Angles(math.rad(-8), 0, 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "HeronLeg",
            Vector3.new(0.3, 4.4, 0.3),
            origin + Vector3.new(side * 0.5, 0.9, 0.2),
            BOG_DARK,
            Enum.Material.Slate,
            nil,
            nil
        )
        addEye(model, origin + Vector3.new(side * 0.32, 6.5, -1.6), WITCHLIGHT)
    end
    return core
end

local function bogBell(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BellBody",
        Vector3.new(4.4, 4.4, 4.4),
        origin + Vector3.new(0, 3.4, 0),
        Color3.fromRGB(104, 96, 74),
        Enum.Material.Metal,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "BellPost",
        Vector3.new(0.7, 6.4, 0.7),
        origin + Vector3.new(0, 3.2, 1.6),
        BOG_DARK,
        Enum.Material.Wood,
        nil,
        nil
    )
    part(
        model,
        "BellClapper",
        Vector3.new(0.9, 1.6, 0.9),
        origin + Vector3.new(0, 1.4, 0),
        WITCHLIGHT,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    -- Marks burned into the ground the bell summons through. Sized on the
    -- wrong cylinder axis they stood up as four floating bars around it.
    for index = 0, 3 do
        local angle = index * math.pi * 0.5
        part(
            model,
            "SummonMark",
            Vector3.new(0.2, 1.6, 1.6),
            origin + Vector3.new(math.cos(angle) * 4, 0.1, math.sin(angle) * 4),
            WITCHLIGHT,
            Enum.Material.Neon,
            Enum.PartType.Cylinder,
            CFrame.Angles(0, 0, math.rad(90))
        )
    end
    return core
end

function BramblewakeEnemyBuilder.build(definition: any, origin: Vector3, target: Vector3): Model
    local model = Instance.new("Model")
    model.Name = definition.displayName:gsub("%s+", "")
    model:SetAttribute("EnemyId", definition.id)
    model:SetAttribute("EnemyDisplayName", definition.displayName)
    model:SetAttribute("EnemyHealth", definition.health)
    model:SetAttribute("EnemyMaxHealth", definition.health)

    local core: Part
    if definition.modelKey == "briarback" then
        core = briarback(model, origin)
    elseif definition.modelKey == "zombie" then
        core = zombie(model, origin)
    elseif definition.modelKey == "hollow_crow" then
        core = hollowCrow(model, origin)
    elseif definition.modelKey == "snapvine" then
        core = snapvine(model, origin)
    elseif definition.modelKey == "bark_ram" then
        core = barkRam(model, origin)
    elseif definition.modelKey == "cinder_mite" then
        core = cinderMite(model, origin)
    elseif definition.modelKey == "rail_hound" then
        core = railHound(model, origin)
    elseif definition.modelKey == "slag_spitter" then
        core = slagSpitter(model, origin)
    elseif definition.modelKey == "shift_echo" then
        core = shiftEcho(model, origin)
    elseif definition.modelKey == "crank_guard" then
        core = crankGuard(model, origin)
    elseif definition.modelKey == "gas_bloomer" then
        core = gasBloomer(model, origin)
    elseif definition.modelKey == "reed_lurker" then
        core = reedLurker(model, origin)
    elseif definition.modelKey == "mirrorling" then
        core = mirrorling(model, origin)
    elseif definition.modelKey == "mire_leech" then
        core = mireLeech(model, origin)
    elseif definition.modelKey == "false_friend" then
        core = falseFriend(model, origin)
    elseif definition.modelKey == "glass_heron" then
        core = glassHeron(model, origin)
    elseif definition.modelKey == "bog_bell" then
        core = bogBell(model, origin)
    else
        core = rootling(model, origin)
    end
    model.PrimaryPart = core

    local highlight = Instance.new("Highlight")
    -- The outline is the enemy's readability, not decoration: at night, a dark
    -- creature against dark forest was disappearing entirely. A fully opaque
    -- rim and a little more body tint make the silhouette legible without
    -- lighting the world or showing enemies through terrain -- Occluded is
    -- kept deliberately so nothing is visible through geometry.
    highlight.Name = "ThreatOutline"
    -- Enough to find them in the dark, not so much that they become
    -- featureless cut-outs. A fully opaque rim over a heavy fill turned every
    -- creature into a black silhouette with a white edge, which lost the
    -- shapes the enemy roster relies on for readability.
    highlight.FillColor = Color3.fromRGB(104, 42, 38)
    highlight.FillTransparency = 0.82
    highlight.OutlineColor = Color3.fromRGB(255, 178, 132)
    highlight.OutlineTransparency = 0.3
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = model

    --[[
        Tap the creature to hit it.

        Combat used to require finding a STRIKE button while a telegraph was
        winding up. Putting the control on the enemy itself makes attacking
        the same gesture as everything else in the game, and it aims: the
        server still resolves range and damage, so this only decides which
        creature the player meant.
    ]]
    -- Parented to the model, not the core: a ClickDetector on a Model fires
    -- for a tap on ANY descendant BasePart, not just the (often small,
    -- moving) core. A fast flier like the crow reads several studs wider
    -- than its core across wings and beak; without this, every one of those
    -- taps silently missed.
    --[[
        A tap target big enough to actually hit on a phone.

        A ClickDetector only fires when the tap ray lands on a part that
        answers raycasts, and once the authored mesh loads there is almost
        nothing left that does: MeshTemplateLoader.sanitize clears CanQuery on
        every part of a loaded model (measured: 0 of 1 queryable on the
        rootling), and placeEnemyVisual clears it on every fallback part but
        the core. So the creature a player can SEE answers no taps at all, and
        the only thing that does is one invisible box roughly the size of the
        body -- which on a phone sits behind the threat banner and the lantern
        rail. The result was a night defense that could not be fought.

        This is the same generous invisible volume every other interaction in
        the game already uses, sized past the silhouette so a thumb aimed at
        the creature lands. It is CanCollide = false so it never changes
        movement or the fight's geometry, and the server still resolves range,
        facing, cover, and damage -- a tap only says which creature was meant.
    ]]
    local strikeVolume = Instance.new("Part")
    strikeVolume.Name = "StrikeVolume"
    strikeVolume.Size = Vector3.new(
        math.max(9, core.Size.X + 5),
        math.max(10, core.Size.Y + 4),
        math.max(9, core.Size.Z + 5)
    )
    strikeVolume.CFrame = CFrame.new(core.Position)
    strikeVolume.Anchored = true
    strikeVolume.CanCollide = false
    strikeVolume.CanTouch = false
    strikeVolume.CanQuery = true
    strikeVolume.CastShadow = false
    strikeVolume.Transparency = 1
    strikeVolume.Massless = true
    strikeVolume:SetAttribute("EnemyStrikeVolume", true)
    strikeVolume.Parent = model

    local click = Instance.new("ClickDetector")
    click.Name = "StrikeClick"
    click.MaxActivationDistance = 42
    click.CursorIcon = ""
    click.Parent = model

    local flatTarget = Vector3.new(target.X, core.Position.Y, target.Z)
    if (flatTarget - core.Position).Magnitude > 0.01 then
        model:PivotTo(CFrame.lookAt(core.Position, flatTarget))
    end
    return model
end

return table.freeze(BramblewakeEnemyBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="157">
          <Properties>
            <string name="Name">CinderfallBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Cinderfall Crown's geometry.

    The Vale is drawn by absence -- a hearth that is out says more than an
    empty room. The Crown is drawn by presence: every module carries
    something that is still in the middle of doing what it was doing when
    the fire arrived. A parade still on its route, a crowd still facing
    the stage, a kiln still firing a cast that nobody is coming back for.

    So the load-bearing shape here is the figure. Casts stand everywhere,
    and the builder makes two kinds on purpose: performing ones, which
    face the stage and are posed, and authentic ones, which face wherever
    they happened to be facing and are not. A player learns that
    difference by walking past a hundred of them, and the Ash Regent's
    fight is the exam.

    Its palette inverts the Vale's on purpose. Frostmere's warm light was
    safety; here the lit things are the ones still producing false work
    and the cold ones are where the truth got to stop, so the kilns glow
    and the honest rooms are grey.
]]

local CinderfallBuilder = {}

local ASH = Color3.fromRGB(148, 142, 134)
local DARK_ASH = Color3.fromRGB(96, 92, 88)
local SOOT = Color3.fromRGB(52, 48, 46)
local CAST = Color3.fromRGB(176, 168, 156)
local TRUE_CAST = Color3.fromRGB(122, 118, 112)
local GLASS = Color3.fromRGB(180, 196, 206)
local MEMORY_GLASS = Color3.fromRGB(206, 168, 214)
local KILN_BRICK = Color3.fromRGB(128, 74, 54)
local FIRE = Color3.fromRGB(255, 148, 62)
local CINDERSTEEL = Color3.fromRGB(112, 104, 96)
local SILK = Color3.fromRGB(214, 190, 158)
local COLD_WATER = Color3.fromRGB(78, 106, 116)
local CROWN_GOLD = Color3.fromRGB(214, 172, 88)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function glow(
    parent: Instance,
    name: string,
    position: Vector3,
    size: number,
    color: Color3,
    brightness: number
)
    local orb = part(
        parent,
        name,
        Vector3.new(size, size, size),
        CFrame.new(position),
        color,
        Enum.Material.Neon,
        false
    )
    orb.Shape = Enum.PartType.Ball
    orb.CanQuery = false
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = size * 9
    light.Brightness = brightness
    light.Shadows = false
    light.Parent = orb
end

local function crownGround(parent: Instance, center: Vector3)
    part(parent, "CrownGround", Vector3.new(40, 1, 40), CFrame.new(center), ASH, Enum.Material.Sand)
    for index = -1, 1 do
        local drift = part(
            parent,
            "AshDrift",
            Vector3.new(28 - index * 4, 1.6, 8),
            CFrame.new(center + Vector3.new(index * 6, 0.9, index * 11))
                * CFrame.Angles(0, math.rad(index * 8), 0),
            DARK_ASH,
            Enum.Material.Sand,
            false
        )
        drift.CanQuery = false
    end
end

--[[
    The region in one primitive. A performing cast is posed and faces the
    stage; an authentic one is not posed and faces wherever the person was
    actually looking. Casts also carry a mold seam down one side, which is
    the tell the events ask a player to find, so it is drawn rather than
    described.
]]
local function figure(parent: Instance, center: Vector3, yaw: number, performing: boolean)
    local base = CFrame.new(center) * CFrame.Angles(0, math.rad(yaw), 0)
    local color = if performing then CAST else TRUE_CAST
    part(
        parent,
        if performing then "CastFigure" else "TrueFigure",
        Vector3.new(1.9, 4.4, 1.2),
        base * CFrame.new(0, 3, 0),
        color,
        Enum.Material.Sandstone
    )
    part(
        parent,
        "FigureHead",
        Vector3.new(1.1, 1.2, 1.1),
        base * CFrame.new(0, 5.7, 0),
        color,
        Enum.Material.Sandstone,
        false
    )
    -- the arms say which kind it is: raised in the gesture it was cast
    -- mid-way through, or down, doing nothing, because nobody posed it
    for side = -1, 1, 2 do
        local pitch = if performing then math.rad(-55) else math.rad(-6)
        part(
            parent,
            "FigureArm",
            Vector3.new(0.5, 2.4, 0.5),
            base * CFrame.new(side * 1.2, 4, 0) * CFrame.Angles(pitch, 0, math.rad(side * 8)),
            color,
            Enum.Material.Sandstone,
            false
        )
    end
    if performing then
        local seam = part(
            parent,
            "MoldSeam",
            Vector3.new(0.14, 4.6, 0.14),
            base * CFrame.new(0.98, 3, 0),
            SOOT,
            Enum.Material.SmoothPlastic,
            false
        )
        seam.CanQuery = false
    end
end

-- A row of figures facing one way, which is how the Crown says "crowd".
local function crowd(parent: Instance, center: Vector3, yaw: number, count: number)
    for index = 0, count - 1 do
        figure(
            parent,
            center + Vector3.new((index - (count - 1) * 0.5) * 3.4, 0, (index % 2) * 1.6),
            yaw,
            true
        )
    end
end

-- A kiln, lit or cold. Lit ones are still making casts.
local function kiln(parent: Instance, center: Vector3, lit: boolean)
    part(
        parent,
        "KilnBody",
        Vector3.new(9, 10, 9),
        CFrame.new(center + Vector3.new(0, 5, 0)),
        KILN_BRICK,
        Enum.Material.Brick
    )
    part(
        parent,
        "KilnStack",
        Vector3.new(2.6, 8, 2.6),
        CFrame.new(center + Vector3.new(0, 13, 0)),
        KILN_BRICK,
        Enum.Material.Brick
    )
    local mouth = part(
        parent,
        "KilnMouth",
        Vector3.new(4, 4.4, 1),
        CFrame.new(center + Vector3.new(0, 3, -4.4)),
        if lit then FIRE else Color3.fromRGB(20, 20, 22),
        if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic,
        false
    )
    mouth.CanQuery = false
    if lit then
        glow(parent, "KilnFire", center + Vector3.new(0, 3, -5.5), 2, FIRE, 3)
    end
end

-- Glass the heat made, in sheets and shards. Memory glass is the pink
-- one, and it is the only colour in the region that is not ash or fire.
local function glassField(parent: Instance, center: Vector3, radius: number, memory: boolean)
    for index = 0, 6 do
        local angle = index * 0.92
        local shard = part(
            parent,
            if memory then "MemoryGlass" else "GlassShard",
            Vector3.new(1.4, 4 + (index % 3), 1.4),
            CFrame.new(
                center
                    + Vector3.new(math.cos(angle) * radius * 0.5, 2, math.sin(angle) * radius * 0.5)
            ) * CFrame.Angles(math.rad(index * 4), angle, math.rad(index * 3)),
            if memory then MEMORY_GLASS else GLASS,
            Enum.Material.Glass
        )
        shard.Transparency = 0.35
    end
    if memory then
        glow(parent, "MemoryShine", center + Vector3.new(0, 3, 0), 1.6, MEMORY_GLASS, 1.4)
    end
end

-- Colonnade: the city's one repeated piece of architecture, and the only
-- reliable cover in a district with no walls left.
local function colonnade(parent: Instance, center: Vector3, length: number, roofed: boolean)
    local bays = math.max(3, math.floor(length / 7))
    for index = 0, bays - 1 do
        local z = -length * 0.5 + index * (length / bays) + (length / bays) * 0.5
        -- A cylinder's axis is its Size.X, so a standing column is
        -- height-on-X and then rolled ninety degrees upright.
        local column = part(
            parent,
            "AshColumn",
            Vector3.new(12, 2.2, 2.2),
            CFrame.new(center + Vector3.new(0, 6, z)) * CFrame.Angles(0, 0, math.rad(90)),
            ASH,
            Enum.Material.Sandstone
        )
        column.Shape = Enum.PartType.Cylinder
    end
    if roofed then
        part(
            parent,
            "ColonnadeEntablature",
            Vector3.new(4, 1.6, length),
            CFrame.new(center + Vector3.new(0, 12.8, 0)),
            DARK_ASH,
            Enum.Material.Sandstone
        )
    end
end

-- Seating, tiered, still full. The Crown's crowd is scenery and threat at
-- the same time, which is why it is drawn at real scale.
local function stands(parent: Instance, center: Vector3, rows: number, yaw: number)
    local base = CFrame.new(center) * CFrame.Angles(0, math.rad(yaw), 0)
    for index = 0, rows - 1 do
        part(
            parent,
            "StandRow",
            Vector3.new(30 - index * 2, 2.2, 5),
            base * CFrame.new(0, 1.1 + index * 2.2, index * 5.4),
            DARK_ASH,
            Enum.Material.Slate
        )
    end
    for index = 0, rows - 1 do
        crowd(parent, center + Vector3.new(0, 2.2 + index * 2.2, index * 5.4 - 1.6), yaw + 180, 4)
    end
end

-- Cold running water. The only thing in the Crown that is not doing
-- anything, which makes it the only place a party can stop.
local function coolingRun(parent: Instance, center: Vector3, length: number)
    local water = part(
        parent,
        "ChannelWater",
        Vector3.new(6, 1, length),
        CFrame.new(center + Vector3.new(0, 0.6, 0)),
        COLD_WATER,
        Enum.Material.Water,
        false
    )
    water.Transparency = 0.25
    water.CanQuery = false
    for side = -1, 1, 2 do
        part(
            parent,
            "ChannelWall",
            Vector3.new(1.6, 3, length),
            CFrame.new(center + Vector3.new(side * 3.8, 1.2, 0)),
            CINDERSTEEL,
            Enum.Material.Metal
        )
    end
end

-- Stage boards, raised. Wherever these are, something is still being
-- performed on them.
local function stage(parent: Instance, center: Vector3, width: number, depth: number)
    part(
        parent,
        "StageBoards",
        Vector3.new(width, 1.2, depth),
        CFrame.new(center + Vector3.new(0, 2.4, 0)),
        Color3.fromRGB(86, 66, 50),
        Enum.Material.WoodPlanks
    )
    for side = -1, 1, 2 do
        part(
            parent,
            "StageWing",
            Vector3.new(1.4, 11, depth),
            CFrame.new(center + Vector3.new(side * width * 0.5, 5.5, 0)),
            SOOT,
            Enum.Material.Fabric
        )
    end
end

-- Silk on frames, ash-coloured, the district's one soft surface.
local function silkFrame(parent: Instance, center: Vector3)
    for side = -1, 1, 2 do
        part(
            parent,
            "LoomPost",
            Vector3.new(0.8, 8, 0.8),
            CFrame.new(center + Vector3.new(side * 4.5, 4, 0)),
            CINDERSTEEL,
            Enum.Material.Metal
        )
    end
    local cloth = part(
        parent,
        "AshSilk",
        Vector3.new(9, 5.4, 0.4),
        CFrame.new(center + Vector3.new(0, 4.6, 0)),
        SILK,
        Enum.Material.Fabric,
        false
    )
    cloth.Transparency = 0.15
    cloth.CanQuery = false
end

-- A processional marker: the only signage in the Crown, and repainted
-- more recently than anything else here.
local function marker(parent: Instance, center: Vector3, yaw: number)
    part(
        parent,
        "MarkerPost",
        Vector3.new(1.4, 9, 1.4),
        CFrame.new(center + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, math.rad(yaw), 0),
        CINDERSTEEL,
        Enum.Material.Metal
    )
    part(
        parent,
        "MarkerCrown",
        Vector3.new(3.2, 1.6, 3.2),
        CFrame.new(center + Vector3.new(0, 9.6, 0)) * CFrame.Angles(0, math.rad(yaw), 0),
        CROWN_GOLD,
        Enum.Material.Metal,
        false
    )
end

--[[
    Draw one Cinderfall module. Returns false for a key this builder has
    no case for, so the coverage spec can tell the difference between a
    module that draws nothing and a module nobody wrote.
]]
function CinderfallBuilder.buildModuleVisual(
    parent: Instance,
    visual: string,
    center: Vector3
): boolean
    if visual == "crown_gate" then
        crownGround(parent, center)
        -- Arrival: two colonnades, a marker, and the first pair of casts
        -- a party sees -- one performing, one not, side by side, before
        -- anything is asking them to tell the difference.
        colonnade(parent, center + Vector3.new(-8, 0, 0), 28, true)
        colonnade(parent, center + Vector3.new(8, 0, 0), 28, true)
        figure(parent, center + Vector3.new(-3, 0, 10), 180, true)
        figure(parent, center + Vector3.new(3, 0, 10), 44, false)
        marker(parent, center + Vector3.new(0, 0, 15), 180)
        return true
    elseif visual == "ash_road" then
        crownGround(parent, center)
        part(
            parent,
            "RoadBed",
            Vector3.new(12, 0.6, 36),
            CFrame.new(center + Vector3.new(0, 1.1, 0)),
            DARK_ASH,
            Enum.Material.Slate
        )
        marker(parent, center + Vector3.new(-7, 0, -12), 0)
        marker(parent, center + Vector3.new(7, 0, 12), 180)
        return true
    elseif visual == "kiln_row" then
        crownGround(parent, center)
        kiln(parent, center + Vector3.new(-11, 0, 0), true)
        kiln(parent, center + Vector3.new(0, 0, 6), true)
        kiln(parent, center + Vector3.new(11, 0, 0), false)
        return true
    elseif visual == "glass_orchard" then
        crownGround(parent, center)
        -- Trees the heat glassed where they stood, with the fruit still
        -- on them. The first time the Crown lies about what is safe.
        for row = -1, 1 do
            for column = -1, 1 do
                local trunk = part(
                    parent,
                    "GlassTrunk",
                    Vector3.new(1.6, 9, 1.6),
                    CFrame.new(center + Vector3.new(column * 11, 4.5, row * 11)),
                    GLASS,
                    Enum.Material.Glass
                )
                trunk.Transparency = 0.3
                local crownTop = part(
                    parent,
                    "GlassCanopy",
                    Vector3.new(7, 4, 7),
                    CFrame.new(center + Vector3.new(column * 11, 10, row * 11)),
                    GLASS,
                    Enum.Material.Glass,
                    false
                )
                crownTop.Transparency = 0.45
                crownTop.Shape = Enum.PartType.Ball
                crownTop.CanQuery = false
            end
        end
        return true
    elseif visual == "silk_looms" then
        crownGround(parent, center)
        silkFrame(parent, center + Vector3.new(-9, 0, -4))
        silkFrame(parent, center + Vector3.new(2, 0, 6))
        silkFrame(parent, center + Vector3.new(12, 0, -6))
        figure(parent, center + Vector3.new(6, 0, -2), 20, false)
        return true
    elseif visual == "pearl_beds" then
        crownGround(parent, center)
        -- Kiln pearls form where glass dripped and cooled slowly. The
        -- beds are worth stopping at and directly under a kiln stack.
        for index = 0, 5 do
            local pearl = part(
                parent,
                "KilnPearl",
                Vector3.new(2.2, 2.2, 2.2),
                CFrame.new(center + Vector3.new((index % 3 - 1) * 7, 1.6, (index // 3) * 8 - 4)),
                Color3.fromRGB(226, 214, 196),
                Enum.Material.Glass,
                false
            )
            pearl.Shape = Enum.PartType.Ball
        end
        kiln(parent, center + Vector3.new(0, 0, -14), false)
        return true
    elseif visual == "coal_terraces" then
        crownGround(parent, center)
        for index = 0, 3 do
            part(
                parent,
                "CoalTerrace",
                Vector3.new(30 - index * 4, 2.4, 7),
                CFrame.new(center + Vector3.new(0, 1.4 + index * 2.4, -12 + index * 6)),
                SOOT,
                Enum.Material.Slate
            )
        end
        glow(parent, "TerraceEmber", center + Vector3.new(0, 3, -6), 1.4, FIRE, 1.4)
        return true
    elseif visual == "slag_gardens" then
        crownGround(parent, center)
        glassField(parent, center + Vector3.new(-8, 0, 4), 16, false)
        glassField(parent, center + Vector3.new(9, 0, -6), 14, false)
        figure(parent, center + Vector3.new(0, 0, -12), 96, false)
        return true
    elseif visual == "foundry_yards" then
        crownGround(parent, center)
        kiln(parent, center + Vector3.new(-12, 0, -6), true)
        for index = -1, 1 do
            part(
                parent,
                "IngotStack",
                Vector3.new(6, 2.4, 4),
                CFrame.new(center + Vector3.new(index * 8, 1.8, 8))
                    * CFrame.Angles(0, math.rad(index * 12), 0),
                CINDERSTEEL,
                Enum.Material.Metal
            )
        end
        crowd(parent, center + Vector3.new(8, 0, -4), 200, 3)
        return true
    elseif visual == "parade_route" then
        crownGround(parent, center)
        -- The procession is still walking it. Nothing here attacks; it
        -- simply does not stop.
        part(
            parent,
            "ProcessionWay",
            Vector3.new(14, 0.6, 38),
            CFrame.new(center + Vector3.new(0, 1.1, 0)),
            DARK_ASH,
            Enum.Material.Slate
        )
        for index = -2, 2 do
            figure(parent, center + Vector3.new((index % 2) * 4 - 2, 0, index * 7), 0, true)
        end
        colonnade(parent, center + Vector3.new(-12, 0, 0), 34, false)
        return true
    elseif visual == "cooling_channel" then
        crownGround(parent, center)
        coolingRun(parent, center, 36)
        kiln(parent, center + Vector3.new(-13, 0, -8), true)
        kiln(parent, center + Vector3.new(13, 0, 8), true)
        return true
    elseif visual == "collapsed_tiers" then
        crownGround(parent, center)
        for index = 0, 3 do
            part(
                parent,
                "FallenTier",
                Vector3.new(22 - index * 3, 2.4, 6),
                CFrame.new(center + Vector3.new(index * 2 - 3, 1.6 + index * 1.4, -8 + index * 5))
                    * CFrame.Angles(math.rad(index * 6), math.rad(index * 9), math.rad(index * 4)),
                DARK_ASH,
                Enum.Material.Slate
            )
        end
        figure(parent, center + Vector3.new(9, 0, 10), 130, false)
        return true
    elseif visual == "ash_colonnade" then
        crownGround(parent, center)
        colonnade(parent, center + Vector3.new(-7, 0, 0), 34, true)
        colonnade(parent, center + Vector3.new(7, 0, 0), 34, true)
        return true
    elseif visual == "stage_bridges" then
        crownGround(parent, center)
        -- Scenery bridges between the upper tiers, built to be walked on
        -- once a night by people who knew where the boards were.
        for side = -1, 1, 2 do
            part(
                parent,
                "BridgeSpan",
                Vector3.new(5, 0.7, 30),
                CFrame.new(center + Vector3.new(side * 8, 9, 0))
                    * CFrame.Angles(0, 0, math.rad(side * 2)),
                Color3.fromRGB(86, 66, 50),
                Enum.Material.WoodPlanks
            )
            part(
                parent,
                "BridgePier",
                Vector3.new(2.4, 9, 2.4),
                CFrame.new(center + Vector3.new(side * 8, 4.5, -14)),
                ASH,
                Enum.Material.Sandstone
            )
        end
        return true
    elseif visual == "procession_stair" then
        crownGround(parent, center)
        for index = 0, 6 do
            part(
                parent,
                "ProcessionStep",
                Vector3.new(16 - index, 1.4, 4),
                CFrame.new(center + Vector3.new(0, 1 + index * 1.4, -11 + index * 3.2)),
                ASH,
                Enum.Material.Sandstone
            )
        end
        marker(parent, center + Vector3.new(-9, 0, 12), 180)
        figure(parent, center + Vector3.new(6, 0, 12), 12, false)
        return true
    elseif visual == "applause_court" then
        crownGround(parent, center)
        -- The applause starts when anyone walks in. Everything that hunts
        -- by sound in this district is listening to it.
        stands(parent, center + Vector3.new(0, 0, -14), 3, 0)
        stage(parent, center + Vector3.new(0, 0, 8), 22, 12)
        return true
    elseif visual == "knight_gallery" then
        crownGround(parent, center)
        colonnade(parent, center + Vector3.new(-9, 0, 0), 30, true)
        colonnade(parent, center + Vector3.new(9, 0, 0), 30, true)
        glassField(parent, center, 18, false)
        return true
    elseif visual == "worm_kilns" then
        crownGround(parent, center)
        kiln(parent, center + Vector3.new(-10, 0, -8), true)
        kiln(parent, center + Vector3.new(10, 0, -8), true)
        kiln(parent, center + Vector3.new(0, 0, 10), true)
        -- the ground between them, gone through
        for index = -1, 1 do
            local bore = part(
                parent,
                "WormBore",
                Vector3.new(5, 1.4, 5),
                CFrame.new(center + Vector3.new(index * 8, 0.9, index * 3)),
                Color3.fromRGB(18, 18, 20),
                Enum.Material.Slate,
                false
            )
            bore.CanQuery = false
        end
        return true
    elseif visual == "giant_plaza" then
        crownGround(parent, center)
        part(
            parent,
            "PlazaFloor",
            Vector3.new(34, 0.6, 34),
            CFrame.new(center + Vector3.new(0, 1.1, 0)),
            ASH,
            Enum.Material.Sandstone
        )
        -- room for something very large to walk a line through a party
        colonnade(parent, center + Vector3.new(-15, 0, 0), 30, false)
        colonnade(parent, center + Vector3.new(15, 0, 0), 30, false)
        crowd(parent, center + Vector3.new(0, 0, -14), 0, 5)
        return true
    elseif visual == "citizen_quarter" then
        crownGround(parent, center)
        -- Shopfronts, some with rooms behind them and some without. The
        -- false citizens work here because there is so much to mend.
        for index = -1, 1 do
            part(
                parent,
                "Shopfront",
                Vector3.new(10, 9, 1.2),
                CFrame.new(center + Vector3.new(index * 12, 4.5, -8)),
                ASH,
                Enum.Material.Sandstone
            )
            if index ~= 0 then
                part(
                    parent,
                    "ShopBackRoom",
                    Vector3.new(10, 9, 9),
                    CFrame.new(center + Vector3.new(index * 12, 4.5, -13)),
                    DARK_ASH,
                    Enum.Material.Sandstone
                )
            end
        end
        figure(parent, center + Vector3.new(0, 0, 6), 0, true)
        return true
    elseif visual == "ash_lane" then
        crownGround(parent, center)
        for side = -1, 1, 2 do
            part(
                parent,
                "LaneWall",
                Vector3.new(3, 8, 34),
                CFrame.new(center + Vector3.new(side * 10, 4, 0)),
                DARK_ASH,
                Enum.Material.Sandstone
            )
        end
        return true
    elseif visual == "warm_arcade" then
        crownGround(parent, center)
        colonnade(parent, center + Vector3.new(0, 0, -6), 26, true)
        kiln(parent, center + Vector3.new(-12, 0, 8), true)
        glow(parent, "ArcadeGlow", center + Vector3.new(0, 6, 0), 1.8, FIRE, 2)
        return true
    elseif visual == "crown_arch" then
        crownGround(parent, center)
        for side = -1, 1, 2 do
            part(
                parent,
                "ArchPier",
                Vector3.new(4, 16, 4),
                CFrame.new(center + Vector3.new(side * 10, 8, 0)),
                ASH,
                Enum.Material.Sandstone
            )
        end
        part(
            parent,
            "ArchSpan",
            Vector3.new(24, 3.4, 5),
            CFrame.new(center + Vector3.new(0, 17, 0)),
            ASH,
            Enum.Material.Sandstone
        )
        part(
            parent,
            "ArchCrown",
            Vector3.new(5, 3, 5),
            CFrame.new(center + Vector3.new(0, 20, 0)),
            CROWN_GOLD,
            Enum.Material.Metal,
            false
        )
        return true
    elseif visual == "cold_kiln" then
        crownGround(parent, center)
        -- A kiln that went out during the firing. Everything it holds is
        -- half-made and therefore honest.
        kiln(parent, center, false)
        figure(parent, center + Vector3.new(-6, 0, 6), 70, false)
        figure(parent, center + Vector3.new(6, 0, 7), 250, false)
        return true
    elseif visual == "regents_box" then
        crownGround(parent, center)
        part(
            parent,
            "BoxFloor",
            Vector3.new(20, 1, 14),
            CFrame.new(center + Vector3.new(0, 5.5, 0)),
            DARK_ASH,
            Enum.Material.Slate
        )
        for side = -1, 1, 2 do
            part(
                parent,
                "BoxPier",
                Vector3.new(3, 6, 3),
                CFrame.new(center + Vector3.new(side * 8, 3, 0)),
                ASH,
                Enum.Material.Sandstone
            )
        end
        -- the chair is empty, and clean, in a box thick with ash
        part(
            parent,
            "RegentChair",
            Vector3.new(3.2, 5, 3),
            CFrame.new(center + Vector3.new(0, 8.5, 3)),
            CROWN_GOLD,
            Enum.Material.Metal
        )
        crowd(parent, center + Vector3.new(0, 6, -4), 180, 3)
        return true
    elseif visual == "sculptors_hall" then
        crownGround(parent, center)
        colonnade(parent, center + Vector3.new(-9, 0, 0), 28, true)
        colonnade(parent, center + Vector3.new(9, 0, 0), 28, true)
        -- half-finished work, which is the only honest work in the Crown
        for index = -1, 1 do
            part(
                parent,
                "UnfinishedBlock",
                Vector3.new(3, 5 + index, 3),
                CFrame.new(center + Vector3.new(index * 7, 2.6, 4))
                    * CFrame.Angles(0, math.rad(index * 24), 0),
                TRUE_CAST,
                Enum.Material.Sandstone
            )
        end
        figure(parent, center + Vector3.new(0, 0, -8), 26, false)
        return true
    elseif visual == "memory_vault" then
        crownGround(parent, center)
        for side = -1, 1, 2 do
            part(
                parent,
                "VaultWall",
                Vector3.new(1.6, 12, 26),
                CFrame.new(center + Vector3.new(side * 10, 6, 0)),
                CINDERSTEEL,
                Enum.Material.Metal
            )
        end
        part(
            parent,
            "VaultRoof",
            Vector3.new(22, 1.4, 26),
            CFrame.new(center + Vector3.new(0, 12.4, 0)),
            CINDERSTEEL,
            Enum.Material.Metal
        )
        glassField(parent, center, 14, true)
        return true
    elseif visual == "statue_line" then
        crownGround(parent, center)
        -- The puzzle room: a row of casts, one of which is not one. The
        -- Regent's fight, taught without the Regent.
        for index = -2, 2 do
            figure(
                parent,
                center + Vector3.new(index * 6, 0, 0),
                if index == 1 then 118 else 180,
                index ~= 1
            )
        end
        part(
            parent,
            "LinePlinth",
            Vector3.new(34, 1.4, 6),
            CFrame.new(center + Vector3.new(0, 1.2, 0)),
            ASH,
            Enum.Material.Sandstone
        )
        return true
    elseif visual == "kiln_locks" then
        crownGround(parent, center)
        kiln(parent, center + Vector3.new(-10, 0, -6), true)
        kiln(parent, center + Vector3.new(10, 0, -6), false)
        coolingRun(parent, center + Vector3.new(0, 0, 8), 24)
        for index = -1, 1 do
            part(
                parent,
                "ChannelGate",
                Vector3.new(7, 5, 1.2),
                CFrame.new(center + Vector3.new(index * 9, 3, 8)),
                CINDERSTEEL,
                Enum.Material.DiamondPlate
            )
        end
        return true
    elseif visual == "regent_approach" then
        crownGround(parent, center)
        -- The landmark: the stands, the stage, the Regent's own box, and
        -- the five statues its fight is fought among -- standing in the
        -- world before anything is wired to them.
        stands(parent, center + Vector3.new(0, 0, -18), 4, 0)
        stage(parent, center + Vector3.new(0, 0, 6), 26, 14)
        part(
            parent,
            "RegentBoxFloor",
            Vector3.new(18, 1, 12),
            CFrame.new(center + Vector3.new(0, 9, 18)),
            DARK_ASH,
            Enum.Material.Slate
        )
        part(
            parent,
            "RegentSeat",
            Vector3.new(3.4, 5.4, 3.2),
            CFrame.new(center + Vector3.new(0, 12, 20)),
            CROWN_GOLD,
            Enum.Material.Metal
        )
        for index = -2, 2 do
            figure(parent, center + Vector3.new(index * 7, 0, 6), 180, index % 2 == 0)
        end
        marker(parent, center + Vector3.new(-15, 0, -4), 90)
        return true
    end
    return false
end

return table.freeze(CinderfallBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="158">
          <Properties>
            <string name="Name">FoliageBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Organic tree, rock, and undergrowth silhouettes for the Bramblewake valley.

    WHY THIS EXISTS

    The valley's trees were a box trunk plus six axis-aligned wedge slabs, and
    its rocks were single spheres. Both read as exactly what they are. The art
    direction asks for "strong silhouettes ... over raw part count", and the
    fastest way to break a box silhouette is not more parts -- it is rotation,
    taper, and asymmetry on the parts already being spent.

    So every generator here spends a similar part budget to the shapes it
    replaces and buys silhouette with it instead of volume:

      * trunks taper and lean, in segments, rather than being one prism;
      * canopies are rotated, offset, non-uniformly scaled masses, so no two
        read as the same object and none present a flat face to the camera;
      * rocks are clustered, part-buried, unevenly scaled boulders;
      * species differ in shape language, not just colour, so the treeline has
        variety at silhouette distance where colour has already washed out.

    Everything is seeded. Two servers, and a Studio build against a live one,
    generate an identical forest.

    PROCEDURAL FALLBACKS

    Measured authored MeshParts now replace selected core/near placements. The
    functions in this module remain important: distant bands use them for a
    cheap silhouette budget, and every authored placement falls back here if a
    private asset is unavailable. Joining never waits on optional art.
]]

local CollectionService = game:GetService("CollectionService")

local FoliageBuilder = {}

export type Tone = {
    bark: Color3,
    barkWet: Color3,
    needle: Color3,
    needleDeep: Color3,
    leaf: Color3,
    leafPale: Color3,
    moss: Color3,
    stone: Color3,
    stoneWarm: Color3,
}

local function newPart(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide
    instance.CanTouch = canCollide
    if not canCollide then
        instance.CanQuery = false
    end
    -- Shadows follow collision, which here is the same line as "structure vs.
    -- decoration": trunks, logs, and the lead boulder cast, while canopy
    -- masses, ferns, moss, and splinters do not. The forest is ~4,200 parts and
    -- the overwhelming majority are decoration, so casting from all of them
    -- would spend the whole shadow budget on foliage that only ever produces
    -- noise -- exactly the "disable shadows on minor parts according to art
    -- budget" rule in the technical architecture. The trunks still ground every
    -- tree, which is the shadow that actually reads.
    instance.CastShadow = canCollide
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

--[[
    Creates a cylinder of `length` and `diameter` whose long axis runs along
    `orientation`'s *up* direction.

    This exists because a Roblox cylinder's circular faces point along its
    LOCAL X axis, so `Size.X` is the length and `Size.Y`/`Size.Z` are the
    diameters -- the opposite of the intuitive (diameter, height, diameter)
    ordering every other upright part uses. Getting this wrong does not error
    or look obviously broken in code; it silently produces a disc that is one
    diameter long and several studs wide in the wrong direction, which is
    exactly what shipped in the first version of this file and in the
    generator it replaced.

    Callers pass a CFrame oriented the way they want the cylinder to *point*
    (its up axis becomes the cylinder's length), and this applies the axis
    swap. One place to be wrong instead of five.
]]
local function cylinderPart(
    parent: Instance,
    name: string,
    length: number,
    diameter: number,
    orientation: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean
): Part
    local instance = newPart(
        parent,
        name,
        Vector3.new(length, diameter, diameter),
        orientation * CFrame.Angles(0, 0, math.rad(90)),
        color,
        material,
        canCollide
    )
    instance.Shape = Enum.PartType.Cylinder
    return instance
end

--[[
    Creates a cylinder spanning two points.

    Defining a cylinder by its endpoints removes the axis reasoning entirely,
    which matters most for the near-horizontal pieces: deriving "which roll and
    yaw make the length point that way" by hand is what produced the disc-shaped
    trunks in the first place, and it also silently decouples a piece from the
    positions computed around it. With endpoints, the geometry and the things
    placed against it read from the same two vectors.

    CFrame.lookAt's LookVector is the span direction, and rotating 90 degrees
    about Y brings the cylinder's local X onto it.
]]
local function cylinderBetween(
    parent: Instance,
    name: string,
    fromPoint: Vector3,
    toPoint: Vector3,
    diameter: number,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean
): Part?
    local span = toPoint - fromPoint
    local length = span.Magnitude
    if length < 0.05 then
        -- CFrame.lookAt is undefined for coincident points, and a zero-length
        -- cylinder is not worth an instance.
        return nil
    end

    local instance = newPart(
        parent,
        name,
        Vector3.new(length, diameter, diameter),
        CFrame.lookAt(fromPoint + span * 0.5, toPoint) * CFrame.Angles(0, math.rad(90), 0),
        color,
        material,
        canCollide
    )
    instance.Shape = Enum.PartType.Cylinder
    return instance
end

--[[
    A leaning, tapering trunk built from stacked segments.

    Each segment is narrower and slightly more offset than the one below, which
    is what separates a tree from a pole. The lean is derived from position so a
    stand of trees leans coherently, as though the same weather shaped it,
    rather than each one tilting at random.
]]
local function trunk(
    parent: Instance,
    base: Vector3,
    height: number,
    radius: number,
    lean: number,
    tone: Tone
): Vector3
    local segments = 4
    local top = base
    local drift = Vector3.new(math.cos(lean), 0, math.sin(lean))

    for index = 1, segments do
        local fraction = (index - 1) / segments
        local nextFraction = index / segments
        local segmentHeight = height / segments
        local segmentRadius = radius * (1 - fraction * 0.52)
        local offset = drift * (height * 0.05 * nextFraction * nextFraction)
        local center = base + Vector3.new(0, height * fraction + segmentHeight / 2, 0) + offset

        -- Upright, with a small tilt that grows toward the crown so the trunk
        -- curves rather than hinging.
        cylinderPart(
            parent,
            "TreeTrunk",
            segmentHeight * 1.04,
            segmentRadius * 2,
            CFrame.new(center)
                * CFrame.Angles(0, lean, 0)
                * CFrame.Angles(0, 0, math.sin(lean) * 0.06 * nextFraction),
            if index == 1 then tone.barkWet else tone.bark,
            Enum.Material.Wood,
            index <= 2
        )

        top = center + Vector3.new(0, segmentHeight / 2, 0) + offset
    end

    -- Root flare: a wider, part-buried base stops the trunk from looking like
    -- it was pushed into the ground.
    local flare = newPart(
        parent,
        "TreeRootFlare",
        Vector3.new(radius * 3.1, radius * 2.1, radius * 3.1),
        CFrame.new(base + Vector3.new(0, radius * 0.35, 0)),
        tone.barkWet,
        Enum.Material.Wood,
        false
    )
    flare.Shape = Enum.PartType.Ball

    return top
end

--[[
    A conifer: stacked, rotated, non-uniform canopy masses.

    The old version used two axis-aligned wedges per layer, so every tree
    presented the same flat triangle to the camera. Rotating each layer off the
    axis and varying its scale means the silhouette changes as the player moves
    around it, which is the property that reads as "a tree" at distance.
]]
function FoliageBuilder.conifer(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number,
    swayTag: string?
)
    local random = Random.new(seed)
    local height = 26 * scale
    local lean = position.X * 0.004 + random:NextNumber(-0.14, 0.14)
    local top = trunk(parent, position, height, 1.5 * scale, lean, tone)

    local layers = 5
    for index = 1, layers do
        local fraction = (index - 1) / layers
        local layerY = height * (0.32 + fraction * 0.72)
        local spread = (10.5 - index * 1.35) * scale * random:NextNumber(0.88, 1.12)
        local thickness = (5.4 - index * 0.55) * scale

        -- Three masses per layer at uneven angles: no flat face, no repeat.
        for wedgeIndex = 1, 3 do
            local angle = (wedgeIndex / 3) * math.pi * 2
                + fraction * 1.9
                + random:NextNumber(-0.25, 0.25)
            local reach = spread * random:NextNumber(0.42, 0.6)
            local center = position
                + Vector3.new(
                    math.cos(angle) * reach + math.cos(lean) * layerY * 0.05,
                    layerY,
                    math.sin(angle) * reach + math.sin(lean) * layerY * 0.05
                )

            local needle = newPart(
                parent,
                "ConiferCanopy",
                Vector3.new(
                    spread * random:NextNumber(0.72, 0.95),
                    thickness * random:NextNumber(0.85, 1.15),
                    spread * random:NextNumber(0.72, 0.95)
                ),
                CFrame.new(center)
                    * CFrame.Angles(
                        random:NextNumber(-0.22, 0.22),
                        angle,
                        random:NextNumber(-0.22, 0.22)
                    ),
                if index >= layers - 1 then tone.needle else tone.needleDeep,
                Enum.Material.Grass,
                false
            )
            needle.Shape = Enum.PartType.Ball

            if swayTag ~= nil and index >= layers - 1 and wedgeIndex == 1 then
                CollectionService:AddTag(needle, swayTag)
            end
        end
    end

    -- A crown tip so the tree resolves to a point instead of a dome.
    local tip = newPart(
        parent,
        "ConiferCrown",
        Vector3.new(2.6 * scale, 6.5 * scale, 2.6 * scale),
        CFrame.new(top + Vector3.new(0, height * 0.16, 0)),
        tone.needle,
        Enum.Material.Grass,
        false
    )
    tip.Shape = Enum.PartType.Ball
    if swayTag ~= nil then
        CollectionService:AddTag(tip, swayTag)
    end
end

--[[
    A broadleaf: a shorter, heavier canopy on a forking trunk.

    Present so the treeline is not one repeated species. Difference is in shape
    language -- wide clustered crown, visible limbs -- not just a colour swap,
    because colour is the first thing distance and night lighting remove.
]]
function FoliageBuilder.broadleaf(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number,
    swayTag: string?
)
    local random = Random.new(seed)
    local height = 19 * scale
    local lean = random:NextNumber(-0.2, 0.2)
    local top = trunk(parent, position, height, 1.8 * scale, lean, tone)

    -- Limbs, so the canopy has something to sit on.
    for limbIndex = 1, 3 do
        local angle = (limbIndex / 3) * math.pi * 2 + random:NextNumber(-0.4, 0.4)
        -- Angled outward and up from the trunk top. The 52-degree roll leans
        -- the limb away from vertical; cylinderPart handles the axis swap.
        cylinderPart(
            parent,
            "BroadleafLimb",
            8 * scale,
            1.05 * scale,
            CFrame.new(
                top
                    + Vector3.new(
                        math.cos(angle) * 2.6 * scale,
                        2.2 * scale,
                        math.sin(angle) * 2.6 * scale
                    )
            ) * CFrame.Angles(0, angle, math.rad(52)),
            tone.bark,
            Enum.Material.Wood,
            false
        )
    end

    for cluster = 1, 6 do
        local angle = (cluster / 6) * math.pi * 2 + random:NextNumber(-0.3, 0.3)
        local reach = random:NextNumber(3.4, 6.6) * scale
        local blobSize = random:NextNumber(7.5, 11.5) * scale
        local center = top
            + Vector3.new(
                math.cos(angle) * reach,
                random:NextNumber(3.2, 6.4) * scale,
                math.sin(angle) * reach
            )

        local leaves = newPart(
            parent,
            "BroadleafCanopy",
            Vector3.new(blobSize, blobSize * random:NextNumber(0.62, 0.82), blobSize),
            CFrame.new(center)
                * CFrame.Angles(random:NextNumber(-0.3, 0.3), angle, random:NextNumber(-0.3, 0.3)),
            if cluster % 3 == 0 then tone.leafPale else tone.leaf,
            Enum.Material.LeafyGrass,
            false
        )
        leaves.Shape = Enum.PartType.Ball

        if swayTag ~= nil and cluster % 3 == 1 then
            CollectionService:AddTag(leaves, swayTag)
        end
    end
end

--[[
    A dead snag: bare, broken, leaning.

    Cheap silhouette variety and the shape language the art direction assigns to
    the Long Night -- "broken repetition, inverted familiar shapes". A treeline
    of nothing but healthy trees has no story in it.
]]
function FoliageBuilder.snag(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number
)
    local random = Random.new(seed)
    local height = random:NextNumber(13, 21) * scale
    local lean = random:NextNumber(-0.34, 0.34)
    local top = trunk(parent, position, height, 1.25 * scale, lean, tone)

    for _ = 1, random:NextInteger(2, 4) do
        local angle = random:NextNumber(0, math.pi * 2)
        local length = random:NextNumber(3.5, 7) * scale
        cylinderPart(
            parent,
            "SnagBranch",
            length,
            0.55 * scale,
            CFrame.new(
                top
                    + Vector3.new(
                        math.cos(angle) * length * 0.32,
                        -random:NextNumber(0.5, 4) * scale,
                        math.sin(angle) * length * 0.32
                    )
            ) * CFrame.Angles(0, angle, math.rad(random:NextNumber(38, 74))),
            tone.barkWet,
            Enum.Material.Wood,
            false
        )
    end
end

--[[
    A boulder cluster: several unevenly scaled, part-buried, rotated masses.

    One sphere reads as a ball. Three overlapping spheres of different sizes,
    each sunk into the ground at a different depth, read as rock -- the buried
    contact is what sells it, because a rock resting exactly on a surface looks
    dropped.
]]
function FoliageBuilder.boulders(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number
)
    local random = Random.new(seed)
    local count = random:NextInteger(2, 4)

    for index = 1, count do
        local offset = Vector3.new(
            random:NextNumber(-3.4, 3.4) * scale,
            0,
            random:NextNumber(-3.4, 3.4) * scale
        )
        local size = random:NextNumber(2.6, 6.4) * scale
        -- Sink each boulder a different amount so the cluster has contact with
        -- the ground instead of sitting on it.
        local sink = random:NextNumber(0.22, 0.48)

        local stone = newPart(
            parent,
            "Boulder",
            Vector3.new(
                size * random:NextNumber(1, 1.5),
                size * random:NextNumber(0.62, 0.95),
                size
            ),
            CFrame.new(position + offset + Vector3.new(0, size * (0.5 - sink), 0))
                * CFrame.Angles(
                    random:NextNumber(-0.3, 0.3),
                    random:NextNumber(0, math.pi * 2),
                    random:NextNumber(-0.3, 0.3)
                ),
            if index == 1 then tone.stone else tone.stoneWarm,
            Enum.Material.Rock,
            index == 1
        )
        stone.Shape = Enum.PartType.Ball

        if index == count and random:NextNumber() < 0.6 then
            local cap = newPart(
                parent,
                "BoulderMoss",
                Vector3.new(size * 0.92, size * 0.34, size * 0.86),
                CFrame.new(position + offset + Vector3.new(0, size * (0.72 - sink), 0))
                    * CFrame.Angles(0, random:NextNumber(0, math.pi), 0),
                tone.moss,
                Enum.Material.Grass,
                false
            )
            cap.Shape = Enum.PartType.Ball
        end
    end
end

--[[
    A fallen log with a torn end and a couple of shelf fungi.

    Horizontal mass among vertical trunks; the treeline needs both or it reads
    as a fence.
]]
function FoliageBuilder.deadfall(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number
)
    local random = Random.new(seed)
    local angle = random:NextNumber(0, math.pi * 2)
    local length = random:NextNumber(12, 20) * scale
    local radius = random:NextNumber(1.1, 1.8) * scale

    -- Both ends are computed once and reused, so the log, its splinters, and
    -- its fungi cannot drift apart.
    local heading = Vector3.new(math.cos(angle), 0, math.sin(angle))
    local center = position + Vector3.new(0, radius * 0.78, 0)
    local tailEnd = center - heading * (length * 0.5)
    local headEnd = center + heading * (length * 0.5)

    cylinderBetween(
        parent,
        "FallenLog",
        tailEnd,
        headEnd,
        radius * 2,
        tone.barkWet,
        Enum.Material.Wood,
        true
    )

    -- Splintered end, so the log looks broken rather than sawn. Each shard
    -- fans out from the real end point.
    for splinter = 1, 3 do
        local fan = (splinter - 2) * 0.5
        local outward = Vector3.new(math.cos(angle + fan), 0, math.sin(angle + fan))
        local shardLength = radius * random:NextNumber(1.4, 2.6)
        cylinderBetween(
            parent,
            "LogSplinter",
            headEnd,
            headEnd
                + outward * shardLength
                + Vector3.new(0, random:NextNumber(-0.4, 0.9) * radius, 0),
            radius * 0.42,
            tone.bark,
            Enum.Material.Wood,
            false
        )
    end

    for shelf = 1, random:NextInteger(1, 3) do
        -- Positioned along the same axis the log was built from, so a shelf
        -- always lands on the log rather than beside it.
        local along = random:NextNumber(0.18, 0.82)
        local seat = tailEnd:Lerp(headEnd, along) + Vector3.new(0, radius * 0.72, 0)
        local fungus = newPart(
            parent,
            "ShelfFungus",
            Vector3.new(radius * 1.9, radius * 0.3, radius * 1.35),
            CFrame.new(seat) * CFrame.Angles(0, angle + shelf, math.rad(random:NextNumber(-14, 14))),
            tone.leafPale,
            Enum.Material.Fabric,
            false
        )
        fungus.Shape = Enum.PartType.Ball
    end
end

--[[
    Low undergrowth: ferns splayed from a common root.

    Kept cheap and non-colliding. Placed only where the route is not, so it
    never blocks navigation or the mobile camera.
]]
function FoliageBuilder.undergrowth(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    seed: number,
    swayTag: string?
)
    local random = Random.new(seed)
    local fronds = random:NextInteger(5, 8)

    for index = 1, fronds do
        local angle = (index / fronds) * math.pi * 2 + random:NextNumber(-0.2, 0.2)
        local length = random:NextNumber(2.4, 4.2) * scale
        local frond = newPart(
            parent,
            "FernFrond",
            Vector3.new(0.42 * scale, 0.16 * scale, length),
            CFrame.new(
                position
                    + Vector3.new(
                        math.cos(angle) * length * 0.34,
                        random:NextNumber(0.4, 0.9) * scale,
                        math.sin(angle) * length * 0.34
                    )
            ) * CFrame.Angles(math.rad(random:NextNumber(16, 34)), angle, 0),
            if index % 2 == 0 then tone.moss else tone.leaf,
            Enum.Material.Grass,
            false
        )

        if swayTag ~= nil and index == 1 then
            CollectionService:AddTag(frond, swayTag)
        end
    end
end

-- A recognizable route landmark used only if the authored PBR root arch is
-- unavailable. Its opening remains clear and every piece is non-colliding.
function FoliageBuilder.rootArch(
    parent: Instance,
    position: Vector3,
    scale: number,
    tone: Tone,
    yaw: number
)
    local right = Vector3.new(math.cos(yaw), 0, math.sin(yaw))
    local forward = Vector3.new(-math.sin(yaw), 0, math.cos(yaw))
    local halfWidth = 9.4 * scale
    local height = 13.2 * scale

    for side = -1, 1, 2 do
        local base = position + right * (halfWidth * side)
        local points = {
            base,
            base
                + right * (-side * 1.2 * scale)
                + forward * (side * 0.2 * scale)
                + Vector3.new(0, height * 0.3, 0),
            base
                + right * (-side * 3.6 * scale)
                + forward * (-side * 0.1 * scale)
                + Vector3.new(0, height * 0.67, 0),
            position + right * (side * 2.2 * scale) + Vector3.new(0, height * 0.94, 0),
            position + Vector3.new(0, height, 0),
        }
        for index = 1, #points - 1 do
            cylinderBetween(
                parent,
                "RootArch",
                points[index],
                points[index + 1],
                (2.2 - index * 0.26) * scale,
                if index == 1 then tone.barkWet else tone.bark,
                Enum.Material.Wood,
                false
            )
        end

        for rootIndex = 1, 3 do
            local spread = (rootIndex - 2) * 0.55
            cylinderBetween(
                parent,
                "RootArchFlare",
                base + Vector3.new(0, 0.45 * scale, 0),
                base
                    + right * (side * (2.1 + rootIndex * 0.45) * scale)
                    + forward * (spread * 3.1 * scale)
                    + Vector3.new(0, 0.08 * scale, 0),
                0.56 * scale,
                tone.barkWet,
                Enum.Material.Wood,
                false
            )
        end
    end

    for mossIndex = 1, 5 do
        local offset = (mossIndex - 3) * 1.15 * scale
        local moss = newPart(
            parent,
            "RootArchMoss",
            Vector3.new(2.8, 0.7, 1.8) * scale,
            CFrame.new(position + right * offset + Vector3.new(0, height + 0.2 * scale, 0))
                * CFrame.Angles(0, yaw + mossIndex * 0.41, 0),
            tone.moss,
            Enum.Material.Grass,
            false
        )
        moss.Shape = Enum.PartType.Ball
    end
end

return table.freeze(FoliageBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="159">
          <Properties>
            <string name="Name">FrostmereBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Frostmere Vale's geometry.

    The Delve reads as underground because every module carries a roof.
    The Fen reads as drowned because every module carries water it wants
    you to mistrust. The Reach reads as exposed because every module
    carries something built against weather that the weather is beating.

    The Vale reads as cold, and cold is drawn by its absence. Every
    module here carries a hearth -- and most of the hearths are out. A
    banked fire, a bed of ember moss, a stove someone left burning: those
    are the shapes a player learns to look for, and the reason a room
    with a dead hearth in it is more frightening than an empty one. The
    valley is not dangerous because it is outdoors. It is dangerous
    because being indoors stopped meaning anything.

    Its second rule is quiet, and quiet is drawn by things that would
    make noise if you touched them: bell ropes, hanging chains, loose
    slate, thin ice. The Vale is full of them on purpose.
]]

local FrostmereBuilder = {}

local SNOW = Color3.fromRGB(226, 232, 238)
local SHADOW_SNOW = Color3.fromRGB(178, 190, 204)
local ICE = Color3.fromRGB(168, 202, 216)
local DEEP_ICE = Color3.fromRGB(96, 138, 160)
local ABBEY_STONE = Color3.fromRGB(126, 128, 130)
local DARK_STONE = Color3.fromRGB(72, 76, 82)
local TIMBER = Color3.fromRGB(102, 82, 62)
local DARK_TIMBER = Color3.fromRGB(64, 50, 38)
local WOOL = Color3.fromRGB(214, 206, 188)
local EMBER = Color3.fromRGB(238, 128, 54)
local FIRE = Color3.fromRGB(255, 176, 88)
local AURORA = Color3.fromRGB(126, 236, 198)
local IRON = Color3.fromRGB(94, 96, 100)
local PINE = Color3.fromRGB(46, 66, 56)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function glow(
    parent: Instance,
    name: string,
    position: Vector3,
    size: number,
    color: Color3,
    brightness: number
)
    local orb = part(
        parent,
        name,
        Vector3.new(size, size, size),
        CFrame.new(position),
        color,
        Enum.Material.Neon,
        false
    )
    orb.Shape = Enum.PartType.Ball
    orb.CanQuery = false
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = size * 9
    light.Brightness = brightness
    light.Shadows = false
    light.Parent = orb
end

-- Snow underfoot, with the drifts that say which way the wind runs here.
local function valeGround(parent: Instance, center: Vector3)
    part(parent, "ValeGround", Vector3.new(40, 1, 40), CFrame.new(center), SNOW, Enum.Material.Snow)
    for index = -1, 1 do
        local drift = part(
            parent,
            "Drift",
            Vector3.new(30 - index * 4, 2.4 + index, 7),
            CFrame.new(center + Vector3.new(index * 5, 1.2, index * 12))
                * CFrame.Angles(0, math.rad(index * 6), 0),
            SHADOW_SNOW,
            Enum.Material.Snow,
            false
        )
        drift.CanQuery = false
    end
end

--[[
    The region's one load-bearing shape. Lit, it is the only reason a
    module is survivable; cold, it is the clearest bad news the Vale can
    give a player without a line of text. Both are drawn, because a hearth
    that is simply absent reads as decoration and a hearth that is out
    reads as a place somebody died.
]]
local function hearth(parent: Instance, center: Vector3, lit: boolean)
    for index = 0, 5 do
        part(
            parent,
            "HearthStone",
            Vector3.new(1.8, 1.4, 1.2),
            CFrame.new(center + Vector3.new(0, 0.9, 0))
                * CFrame.Angles(0, math.rad(index * 60), 0)
                * CFrame.new(0, 0, 2.6),
            ABBEY_STONE,
            Enum.Material.Slate
        )
    end
    for index = -1, 1 do
        part(
            parent,
            "HearthLog",
            Vector3.new(0.7, 0.7, 3.4),
            CFrame.new(center + Vector3.new(index * 0.7, 1.1, 0))
                * CFrame.Angles(0, math.rad(index * 40), 0),
            if lit then DARK_TIMBER else Color3.fromRGB(48, 44, 42),
            Enum.Material.Wood,
            false
        )
    end
    if lit then
        glow(parent, "HearthFire", center + Vector3.new(0, 1.8, 0), 2.2, FIRE, 3)
    else
        local ash = part(
            parent,
            "HearthAsh",
            Vector3.new(3.2, 0.3, 3.2),
            CFrame.new(center + Vector3.new(0, 0.9, 0)),
            Color3.fromRGB(108, 104, 100),
            Enum.Material.Sand,
            false
        )
        ash.CanQuery = false
    end
end

-- Ember moss: the Vale's growing fire, and the only warmth here that
-- nobody had to light.
local function emberMoss(parent: Instance, center: Vector3, radius: number)
    for index = 0, 6 do
        local angle = index * 0.9
        local patch = part(
            parent,
            "EmberMoss",
            Vector3.new(radius * 0.5, 0.4, radius * 0.4),
            CFrame.new(
                center
                    + Vector3.new(
                        math.cos(angle) * radius * 0.5,
                        0.8,
                        math.sin(angle) * radius * 0.5
                    )
            ) * CFrame.Angles(0, angle, 0),
            EMBER,
            Enum.Material.Neon,
            false
        )
        patch.Transparency = 0.35
        patch.CanQuery = false
    end
    glow(parent, "MossGlow", center + Vector3.new(0, 1.2, 0), 1.6, EMBER, 1.6)
end

-- Abbey masonry: a run of wall with arches cut through it. The valley's
-- one building material and the reason its ruins are still standing.
local function abbeyWall(parent: Instance, center: Vector3, length: number, arches: boolean)
    local bays = math.max(2, math.floor(length / 8))
    for index = 0, bays - 1 do
        local z = -length * 0.5 + index * (length / bays) + (length / bays) * 0.5
        part(
            parent,
            "AbbeyPier",
            Vector3.new(2.4, 11, 2.4),
            CFrame.new(center + Vector3.new(0, 5.5, z)),
            ABBEY_STONE,
            Enum.Material.Slate
        )
        if arches and index < bays - 1 then
            part(
                parent,
                "AbbeyArchTop",
                Vector3.new(1.8, 2.2, length / bays),
                CFrame.new(center + Vector3.new(0, 10.4, z + (length / bays) * 0.5)),
                ABBEY_STONE,
                Enum.Material.Slate
            )
        end
    end
    part(
        parent,
        "AbbeyFooting",
        Vector3.new(3.4, 1.6, length),
        CFrame.new(center + Vector3.new(0, 0.8, 0)),
        DARK_STONE,
        Enum.Material.Slate
    )
end

--[[
    A bell in a frame. The rope is what makes it a tool rather than an
    ornament -- a bell with its rope cut is the Vale telling a player that
    somebody here wanted silence badly enough to take the option away.
]]
local function abbeyBell(parent: Instance, center: Vector3, roped: boolean)
    for side = -1, 1, 2 do
        part(
            parent,
            "BellPost",
            Vector3.new(0.9, 9, 0.9),
            CFrame.new(center + Vector3.new(side * 2.4, 4.5, 0)),
            TIMBER,
            Enum.Material.Wood
        )
    end
    part(
        parent,
        "BellBeam",
        Vector3.new(6, 0.9, 0.9),
        CFrame.new(center + Vector3.new(0, 9.2, 0)),
        TIMBER,
        Enum.Material.Wood
    )
    -- the bell itself: a cylinder hung mouth-down, so its axis (Size.X)
    -- points at the sky
    local bell = part(
        parent,
        "AbbeyBell",
        Vector3.new(3.4, 3, 3),
        CFrame.new(center + Vector3.new(0, 6.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
        Color3.fromRGB(148, 124, 78),
        Enum.Material.Metal
    )
    bell.Shape = Enum.PartType.Cylinder
    if roped then
        part(
            parent,
            "BellRope",
            Vector3.new(0.25, 5.2, 0.25),
            CFrame.new(center + Vector3.new(0, 2.5, 0)),
            Color3.fromRGB(158, 142, 106),
            Enum.Material.Fabric,
            false
        )
    end
end

-- Ice a party can see the floor through, which is the point: thin ice is
-- only a decision if the player can tell it is thin.
local function iceSheet(parent: Instance, center: Vector3, size: number, thin: boolean)
    local sheet = part(
        parent,
        if thin then "ThinIce" else "IceSheet",
        Vector3.new(size, 0.8, size * 0.9),
        CFrame.new(center + Vector3.new(0, 0.6, 0)),
        if thin then ICE else DEEP_ICE,
        Enum.Material.Ice
    )
    sheet.Transparency = if thin then 0.55 else 0.25
    if thin then
        for index = -2, 2 do
            local crack = part(
                parent,
                "IceCrack",
                Vector3.new(size * 0.75, 0.2, 0.35),
                CFrame.new(center + Vector3.new(index * 2.2, 1.05, index * 1.4))
                    * CFrame.Angles(0, math.rad(index * 22), 0),
                Color3.fromRGB(238, 248, 252),
                Enum.Material.Ice,
                false
            )
            crack.CanQuery = false
        end
    end
end

-- A timber shelter, walls and a roof, open on one side. Warming huts,
-- sheds, blinds -- the Vale's smallest promise.
local function shelter(parent: Instance, center: Vector3, width: number, warm: boolean)
    part(
        parent,
        "ShelterFloor",
        Vector3.new(width, 0.8, width * 0.8),
        CFrame.new(center + Vector3.new(0, 1, 0)),
        TIMBER,
        Enum.Material.Wood
    )
    for side = -1, 1, 2 do
        part(
            parent,
            "ShelterWall",
            Vector3.new(0.6, 7, width * 0.8),
            CFrame.new(center + Vector3.new(side * width * 0.5, 4.5, 0)),
            DARK_TIMBER,
            Enum.Material.Wood
        )
    end
    part(
        parent,
        "ShelterBack",
        Vector3.new(width, 7, 0.6),
        CFrame.new(center + Vector3.new(0, 4.5, -width * 0.4)),
        DARK_TIMBER,
        Enum.Material.Wood
    )
    local roof = part(
        parent,
        "ShelterRoof",
        Vector3.new(width + 2, 0.7, width),
        CFrame.new(center + Vector3.new(0, 8.2, 0)) * CFrame.Angles(math.rad(-9), 0, 0),
        TIMBER,
        Enum.Material.Wood
    )
    part(
        parent,
        "RoofSnow",
        Vector3.new(width + 2, 0.7, width),
        roof.CFrame * CFrame.new(0, 0.7, 0),
        SNOW,
        Enum.Material.Snow,
        false
    )
    if warm then
        hearth(parent, center + Vector3.new(0, 1, width * 0.15), true)
    else
        hearth(parent, center + Vector3.new(0, 1, width * 0.15), false)
    end
end

-- Wool on a rack, frozen stiff. The valley's one soft material and its
-- only export.
local function woolRack(parent: Instance, center: Vector3)
    for side = -1, 1, 2 do
        part(
            parent,
            "RackPost",
            Vector3.new(0.7, 6, 0.7),
            CFrame.new(center + Vector3.new(side * 4, 3, 0)),
            DARK_TIMBER,
            Enum.Material.Wood
        )
    end
    part(
        parent,
        "RackBar",
        Vector3.new(9, 0.5, 0.5),
        CFrame.new(center + Vector3.new(0, 6, 0)),
        DARK_TIMBER,
        Enum.Material.Wood
    )
    for index = -1, 1 do
        local fleece = part(
            parent,
            "Fleece",
            Vector3.new(2.6, 3.4, 0.8),
            CFrame.new(center + Vector3.new(index * 3, 4, 0))
                * CFrame.Angles(0, 0, math.rad(index * 4)),
            WOOL,
            Enum.Material.Fabric,
            false
        )
        fleece.CanQuery = false
    end
end

-- A frozen pine. Sparse on purpose: a forest would hide the sightlines
-- the whole region is built on.
local function frozenPine(parent: Instance, center: Vector3, scale: number)
    part(
        parent,
        "PineTrunk",
        Vector3.new(1.2 * scale, 10 * scale, 1.2 * scale),
        CFrame.new(center + Vector3.new(0, 5 * scale, 0)),
        DARK_TIMBER,
        Enum.Material.Wood
    )
    for index = 0, 2 do
        local bough = part(
            parent,
            "PineBough",
            Vector3.new(8 * scale - index * 2, 0.8, 8 * scale - index * 2),
            CFrame.new(center + Vector3.new(0, (5 + index * 2.4) * scale, 0)),
            PINE,
            Enum.Material.Grass,
            false
        )
        bough.CanQuery = false
        local cap = part(
            parent,
            "BoughSnow",
            Vector3.new(8 * scale - index * 2, 0.5, 8 * scale - index * 2),
            bough.CFrame * CFrame.new(0, 0.6, 0),
            SNOW,
            Enum.Material.Snow,
            false
        )
        cap.CanQuery = false
    end
end

-- Light over the ridge. Cold light, and the only thing in the valley that
-- moves without making a sound.
local function auroraRibbon(parent: Instance, center: Vector3, height: number)
    for index = -2, 2 do
        local ribbon = part(
            parent,
            "AuroraRibbon",
            Vector3.new(26, 0.5, 4),
            CFrame.new(center + Vector3.new(index * 3, height + index * 1.6, index * 4))
                * CFrame.Angles(math.rad(index * 5), math.rad(index * 9), math.rad(6)),
            AURORA,
            Enum.Material.Neon,
            false
        )
        ribbon.Transparency = 0.62
        ribbon.CanQuery = false
        ribbon.CastShadow = false
    end
end

-- Prints in the snow, running one way. The Vale's only tracking surface
-- and the third verb of its boss fight.
local function snowTracks(parent: Instance, center: Vector3, yaw: number, count: number)
    for index = 0, count - 1 do
        local step = part(
            parent,
            "SnowTrack",
            Vector3.new(1.6, 0.3, 2.4),
            CFrame.new(center)
                * CFrame.Angles(0, math.rad(yaw), 0)
                * CFrame.new(if index % 2 == 0 then -0.9 else 0.9, 0.7, index * 3.2),
            SHADOW_SNOW,
            Enum.Material.Snow,
            false
        )
        step.CanQuery = false
    end
end

-- Stacked stone, deliberately placed. Cairns are how anybody found their
-- way here before the aurora was the only landmark left.
local function cairn(parent: Instance, center: Vector3)
    for index = 0, 3 do
        part(
            parent,
            "CairnStone",
            Vector3.new(3 - index * 0.5, 1.1, 2.6 - index * 0.4),
            CFrame.new(center + Vector3.new(0, 1 + index * 1.1, 0))
                * CFrame.Angles(0, math.rad(index * 27), 0),
            ABBEY_STONE,
            Enum.Material.Slate
        )
    end
end

-- A rope run between two posts, sagging in the middle.
local function ropeSpan(parent: Instance, center: Vector3, length: number, height: number)
    for side = -1, 1, 2 do
        part(
            parent,
            "SpanPost",
            Vector3.new(1.1, height + 3, 1.1),
            CFrame.new(center + Vector3.new(0, (height + 3) * 0.5, side * length * 0.5)),
            DARK_TIMBER,
            Enum.Material.Wood
        )
    end
    for index = -2, 2 do
        local sag = height - (2 - math.abs(index)) * 0.8
        local line = part(
            parent,
            "SpanRope",
            Vector3.new(0.3, 0.3, length * 0.24),
            CFrame.new(center + Vector3.new(0, sag, index * length * 0.22))
                * CFrame.Angles(math.rad(index * 6), 0, 0),
            Color3.fromRGB(158, 142, 106),
            Enum.Material.Fabric,
            false
        )
        line.CanQuery = false
    end
end

--[[
    Draw one Frostmere module. Returns false for a key this builder has no
    case for, so the coverage spec can tell the difference between a
    module that draws nothing and a module nobody wrote.
]]
function FrostmereBuilder.buildModuleVisual(
    parent: Instance,
    visual: string,
    center: Vector3
): boolean
    if visual == "abbey_gate" then
        valeGround(parent, center)
        -- Arrival: the first thing a party sees is a lit hearth inside a
        -- doorway, which is the whole region's promise and its lie.
        abbeyWall(parent, center + Vector3.new(-7, 0, 0), 30, true)
        abbeyWall(parent, center + Vector3.new(7, 0, 0), 30, true)
        part(
            parent,
            "GateLintel",
            Vector3.new(18, 2.6, 4),
            CFrame.new(center + Vector3.new(0, 11.6, 0)),
            ABBEY_STONE,
            Enum.Material.Slate
        )
        hearth(parent, center + Vector3.new(0, 0, 10), true)
        cairn(parent, center + Vector3.new(-13, 0, 14))
        return true
    elseif visual == "warm_road" then
        valeGround(parent, center)
        -- Extraction. Hearths every few paces, all of them burning: the
        -- one stretch of the Vale that was kept.
        for index = -1, 1 do
            hearth(parent, center + Vector3.new(index * 11, 0, 0), true)
        end
        part(
            parent,
            "RoadBed",
            Vector3.new(34, 0.6, 8),
            CFrame.new(center + Vector3.new(0, 1.1, -7)),
            DARK_STONE,
            Enum.Material.Slate
        )
        cairn(parent, center + Vector3.new(15, 0, -7))
        return true
    elseif visual == "ember_beds" then
        valeGround(parent, center)
        emberMoss(parent, center + Vector3.new(-8, 0, 4), 12)
        emberMoss(parent, center + Vector3.new(7, 0, -6), 14)
        emberMoss(parent, center + Vector3.new(10, 0, 9), 9)
        frozenPine(parent, center + Vector3.new(-14, 0, -10), 0.8)
        return true
    elseif visual == "thaw_quarry" then
        valeGround(parent, center)
        -- Cut faces of ice, worked and abandoned. The risk is that
        -- everything worth taking is at the bottom of a hole.
        for index = -1, 1 do
            local face = part(
                parent,
                "QuarryFace",
                Vector3.new(12, 9 - index * 2, 3),
                CFrame.new(center + Vector3.new(index * 12, 4.5, -6))
                    * CFrame.Angles(0, math.rad(index * 10), 0),
                DEEP_ICE,
                Enum.Material.Ice
            )
            face.Transparency = 0.2
        end
        iceSheet(parent, center + Vector3.new(0, 0, 8), 20, false)
        hearth(parent, center + Vector3.new(-12, 0, 12), false)
        return true
    elseif visual == "wool_sheds" then
        valeGround(parent, center)
        shelter(parent, center + Vector3.new(-9, 0, 0), 14, true)
        woolRack(parent, center + Vector3.new(8, 0, -4))
        woolRack(parent, center + Vector3.new(11, 0, 8))
        return true
    elseif visual == "salt_pans_frozen" then
        valeGround(parent, center)
        for index = -1, 1 do
            local pan = part(
                parent,
                "FrozenSaltPan",
                Vector3.new(13, 1, 10),
                CFrame.new(center + Vector3.new(index * 15, 0.9, index * 3)),
                Color3.fromRGB(206, 214, 220),
                Enum.Material.Ice
            )
            pan.Transparency = 0.15
        end
        -- salt that took the aurora's colour, which nobody has explained
        glow(parent, "SaltShine", center + Vector3.new(0, 2, 0), 1.4, AURORA, 1.2)
        return true
    elseif visual == "ice_cellars" then
        valeGround(parent, center)
        for index = -1, 1 do
            part(
                parent,
                "CellarMouth",
                Vector3.new(7, 6, 5),
                CFrame.new(center + Vector3.new(index * 11, 3, -8)),
                DARK_STONE,
                Enum.Material.Slate
            )
            local dark = part(
                parent,
                "CellarDark",
                Vector3.new(5, 4.4, 1),
                CFrame.new(center + Vector3.new(index * 11, 2.6, -5.4)),
                Color3.fromRGB(16, 18, 22),
                Enum.Material.SmoothPlastic,
                false
            )
            dark.CanQuery = false
        end
        hearth(parent, center + Vector3.new(0, 0, 8), false)
        return true
    elseif visual == "moss_hollow" then
        valeGround(parent, center)
        -- A bowl out of the wind with moss growing in it: the closest
        -- thing to safety the Vale gives away for free.
        for index = 0, 5 do
            part(
                parent,
                "HollowRim",
                Vector3.new(9, 4, 5),
                CFrame.new(center + Vector3.new(0, 2, 0))
                    * CFrame.Angles(0, math.rad(index * 60), 0)
                    * CFrame.new(0, 0, 13),
                SHADOW_SNOW,
                Enum.Material.Snow
            )
        end
        emberMoss(parent, center, 16)
        return true
    elseif visual == "frozen_orchard" then
        valeGround(parent, center)
        for row = -1, 1 do
            for column = -1, 1 do
                frozenPine(
                    parent,
                    center + Vector3.new(column * 11, 0, row * 11),
                    0.7 + ((row + column) % 2) * 0.15
                )
            end
        end
        hearth(parent, center + Vector3.new(0, 0, 16), false)
        return true
    elseif visual == "thin_ice_crossing" then
        valeGround(parent, center)
        iceSheet(parent, center, 30, true)
        cairn(parent, center + Vector3.new(-16, 0, -14))
        cairn(parent, center + Vector3.new(16, 0, 14))
        return true
    elseif visual == "drift_pass" then
        valeGround(parent, center)
        -- Walls of driven snow with one line through them, which is the
        -- Vale's version of a corridor.
        for side = -1, 1, 2 do
            for index = -1, 1 do
                part(
                    parent,
                    "PassDrift",
                    Vector3.new(9, 10 + index * 2, 13),
                    CFrame.new(center + Vector3.new(side * 11, 5, index * 13))
                        * CFrame.Angles(0, math.rad(side * 5), math.rad(side * -4)),
                    SHADOW_SNOW,
                    Enum.Material.Snow
                )
            end
        end
        snowTracks(parent, center + Vector3.new(0, 0, -14), 0, 6)
        return true
    elseif visual == "rope_bridge_gorge" then
        valeGround(parent, center)
        local gorge = part(
            parent,
            "GorgeDark",
            Vector3.new(40, 6, 12),
            CFrame.new(center + Vector3.new(0, -2.5, 0)),
            Color3.fromRGB(20, 24, 30),
            Enum.Material.Slate
        )
        gorge.CanQuery = false
        part(
            parent,
            "BridgePlanks",
            Vector3.new(4, 0.5, 26),
            CFrame.new(center + Vector3.new(0, 1.2, 0)),
            TIMBER,
            Enum.Material.Wood
        )
        ropeSpan(parent, center + Vector3.new(-2.4, 0, 0), 26, 5)
        ropeSpan(parent, center + Vector3.new(2.4, 0, 0), 26, 5)
        return true
    elseif visual == "cloister_walk" then
        valeGround(parent, center)
        abbeyWall(parent, center + Vector3.new(-8, 0, 0), 34, true)
        abbeyWall(parent, center + Vector3.new(8, 0, 0), 34, true)
        part(
            parent,
            "CloisterVault",
            Vector3.new(19, 1.2, 34),
            CFrame.new(center + Vector3.new(0, 11.4, 0)),
            ABBEY_STONE,
            Enum.Material.Slate
        )
        for index = -1, 1 do
            hearth(parent, center + Vector3.new(0, 0, index * 12), index == 0)
        end
        return true
    elseif visual == "whiteout_flat" then
        valeGround(parent, center)
        -- Nothing to see, which is the hazard. One cairn, placed far
        -- enough out that a party has to commit to reaching it.
        for index = -2, 2 do
            local haze = part(
                parent,
                "Whiteout",
                Vector3.new(38, 9, 8),
                CFrame.new(center + Vector3.new(0, 5 + index, index * 8)),
                SNOW,
                Enum.Material.Snow,
                false
            )
            haze.Transparency = 0.82
            haze.CanQuery = false
            haze.CastShadow = false
        end
        cairn(parent, center + Vector3.new(0, 0, 15))
        return true
    elseif visual == "bell_stair" then
        valeGround(parent, center)
        for index = 0, 6 do
            part(
                parent,
                "BellStep",
                Vector3.new(10, 1.4, 4),
                CFrame.new(center + Vector3.new(0, 1 + index * 1.4, -12 + index * 3.4)),
                ABBEY_STONE,
                Enum.Material.Slate
            )
        end
        abbeyBell(parent, center + Vector3.new(0, 10, 12), true)
        return true
    elseif visual == "hush_den" then
        valeGround(parent, center)
        -- Where the pups are kept, and the reason a chapter-V party has
        -- something to decide about the Howler at all.
        part(
            parent,
            "DenMouth",
            Vector3.new(11, 7, 8),
            CFrame.new(center + Vector3.new(0, 3.5, -6)) * CFrame.Angles(0, math.rad(8), 0),
            DARK_STONE,
            Enum.Material.Rock
        )
        local dark = part(
            parent,
            "DenDark",
            Vector3.new(7, 5, 1),
            CFrame.new(center + Vector3.new(0, 3, -2.2)),
            Color3.fromRGB(14, 16, 20),
            Enum.Material.SmoothPlastic,
            false
        )
        dark.CanQuery = false
        emberMoss(parent, center + Vector3.new(0, 0, 4), 8)
        snowTracks(parent, center + Vector3.new(4, 0, 6), 190, 5)
        return true
    elseif visual == "rime_shelf" then
        valeGround(parent, center)
        -- The rime shells fight here, and the fire is the reason a party
        -- can win: the shelf is built around one hearth that still burns.
        iceSheet(parent, center + Vector3.new(-10, 0, -6), 18, false)
        iceSheet(parent, center + Vector3.new(11, 0, 7), 16, false)
        hearth(parent, center, true)
        for index = -1, 1 do
            part(
                parent,
                "RimeSpur",
                Vector3.new(2.2, 7, 2.2),
                CFrame.new(center + Vector3.new(index * 9, 3.5, -12))
                    * CFrame.Angles(math.rad(index * 8), 0, math.rad(index * 6)),
                ICE,
                Enum.Material.Ice
            )
        end
        return true
    elseif visual == "moth_belfry" then
        valeGround(parent, center)
        abbeyWall(parent, center + Vector3.new(-6, 0, 0), 22, false)
        abbeyWall(parent, center + Vector3.new(6, 0, 0), 22, false)
        -- Three bells and none of them roped: the belfry is where the Vale
        -- explains what the bell moths do without saying it.
        abbeyBell(parent, center + Vector3.new(0, 3, -7), false)
        abbeyBell(parent, center + Vector3.new(0, 3, 0), false)
        abbeyBell(parent, center + Vector3.new(0, 3, 7), false)
        return true
    elseif visual == "snowbound_field" then
        valeGround(parent, center)
        -- Trails under the snow that stop, which is the only warning the
        -- snowbound give.
        for index = -1, 1 do
            snowTracks(parent, center + Vector3.new(index * 12, 0, -14), index * 14, 4)
            local mound = part(
                parent,
                "BuriedMound",
                Vector3.new(6, 1.8, 8),
                CFrame.new(center + Vector3.new(index * 12, 1.3, 0))
                    * CFrame.Angles(0, math.rad(index * 12), 0),
                SHADOW_SNOW,
                Enum.Material.Snow,
                false
            )
            mound.CanQuery = false
        end
        hearth(parent, center + Vector3.new(0, 0, 14), false)
        return true
    elseif visual == "borer_undercroft" then
        valeGround(parent, center)
        abbeyWall(parent, center + Vector3.new(0, 0, -10), 26, true)
        -- Floor the borers have been through. Holes with nothing under
        -- them, which is a threat a player understands immediately.
        for index = -1, 1 do
            local bore = part(
                parent,
                "BoreHole",
                Vector3.new(6, 1.4, 6),
                CFrame.new(center + Vector3.new(index * 10, 0.9, index * 5)),
                Color3.fromRGB(16, 18, 22),
                Enum.Material.Slate,
                false
            )
            bore.CanQuery = false
        end
        part(
            parent,
            "FallenPier",
            Vector3.new(2.4, 12, 2.4),
            CFrame.new(center + Vector3.new(6, 2, 8)) * CFrame.Angles(0, 0, math.rad(74)),
            ABBEY_STONE,
            Enum.Material.Slate
        )
        return true
    elseif visual == "snow_lane" then
        valeGround(parent, center)
        for side = -1, 1, 2 do
            part(
                parent,
                "LaneWall",
                Vector3.new(4, 5, 34),
                CFrame.new(center + Vector3.new(side * 10, 2.5, 0)),
                SHADOW_SNOW,
                Enum.Material.Snow
            )
        end
        hearth(parent, center + Vector3.new(0, 0, 12), true)
        return true
    elseif visual == "warming_hut" then
        valeGround(parent, center)
        shelter(parent, center, 16, true)
        woolRack(parent, center + Vector3.new(12, 0, 8))
        return true
    elseif visual == "abbey_arch" then
        valeGround(parent, center)
        abbeyWall(parent, center + Vector3.new(-9, 0, 0), 26, true)
        abbeyWall(parent, center + Vector3.new(9, 0, 0), 26, true)
        part(
            parent,
            "ArchSpan",
            Vector3.new(22, 2.2, 6),
            CFrame.new(center + Vector3.new(0, 11.4, 0)),
            ABBEY_STONE,
            Enum.Material.Slate
        )
        auroraRibbon(parent, center, 26)
        return true
    elseif visual == "wind_break" then
        valeGround(parent, center)
        -- Boards nailed across two piers, against a wind that has been
        -- taking them down for a decade.
        for index = -1, 1 do
            part(
                parent,
                "BreakBoard",
                Vector3.new(24, 3.4, 0.7),
                CFrame.new(center + Vector3.new(0, 3 + index * 3.6, -8))
                    * CFrame.Angles(0, 0, math.rad(index * 2)),
                DARK_TIMBER,
                Enum.Material.Wood
            )
        end
        for side = -1, 1, 2 do
            part(
                parent,
                "BreakPost",
                Vector3.new(1.4, 12, 1.4),
                CFrame.new(center + Vector3.new(side * 12, 6, -8)),
                TIMBER,
                Enum.Material.Wood
            )
        end
        hearth(parent, center + Vector3.new(0, 0, 2), true)
        return true
    elseif visual == "abbot_study" then
        valeGround(parent, center)
        shelter(parent, center, 18, false)
        -- A desk, a dead fire and the letters that name the Vale's
        -- resident. Story rooms here are cold on purpose.
        part(
            parent,
            "StudyDesk",
            Vector3.new(7, 0.6, 3.4),
            CFrame.new(center + Vector3.new(-3, 3.6, -3)),
            DARK_TIMBER,
            Enum.Material.Wood
        )
        for index = -1, 1 do
            local letter = part(
                parent,
                "Letter",
                Vector3.new(1.4, 0.1, 1),
                CFrame.new(center + Vector3.new(-3 + index * 1.6, 4, -3))
                    * CFrame.Angles(0, math.rad(index * 20), 0),
                Color3.fromRGB(224, 216, 196),
                Enum.Material.SmoothPlastic,
                false
            )
            letter.CanQuery = false
        end
        return true
    elseif visual == "refectory" then
        valeGround(parent, center)
        abbeyWall(parent, center + Vector3.new(-10, 0, 0), 28, false)
        abbeyWall(parent, center + Vector3.new(10, 0, 0), 28, false)
        part(
            parent,
            "RefectoryRoof",
            Vector3.new(23, 1.2, 28),
            CFrame.new(center + Vector3.new(0, 11.4, 0)),
            ABBEY_STONE,
            Enum.Material.Slate
        )
        for index = -1, 1 do
            part(
                parent,
                "LongTable",
                Vector3.new(5, 0.7, 18),
                CFrame.new(center + Vector3.new(index * 7, 3.4, 0)),
                TIMBER,
                Enum.Material.Wood
            )
        end
        hearth(parent, center + Vector3.new(0, 0, -12), true)
        return true
    elseif visual == "aurora_shrine" then
        valeGround(parent, center)
        for index = 0, 5 do
            part(
                parent,
                "ShrineStone",
                Vector3.new(2.4, 9 - (index % 3) * 1.6, 2.4),
                CFrame.new(center + Vector3.new(0, 4.5, 0))
                    * CFrame.Angles(0, math.rad(index * 60), 0)
                    * CFrame.new(0, 0, 11),
                ABBEY_STONE,
                Enum.Material.Slate
            )
        end
        glow(parent, "ShrineLight", center + Vector3.new(0, 3, 0), 2.6, AURORA, 2.4)
        auroraRibbon(parent, center, 22)
        return true
    elseif visual == "bell_ropes" then
        valeGround(parent, center)
        -- The puzzle room: bells that can be rung and bells that cannot,
        -- which is the Abbey Silence's fight taught in a quiet place.
        abbeyBell(parent, center + Vector3.new(-9, 0, -5), true)
        abbeyBell(parent, center + Vector3.new(0, 0, 6), false)
        abbeyBell(parent, center + Vector3.new(9, 0, -5), true)
        part(
            parent,
            "RopeFloor",
            Vector3.new(28, 0.6, 24),
            CFrame.new(center + Vector3.new(0, 1.1, 0)),
            ABBEY_STONE,
            Enum.Material.Slate
        )
        return true
    elseif visual == "hearth_locks" then
        valeGround(parent, center)
        -- Four hearths, one lit. The Aurora Hart's fight, taught without
        -- the Hart.
        hearth(parent, center + Vector3.new(0, 0, -11), true)
        hearth(parent, center + Vector3.new(11, 0, 0), false)
        hearth(parent, center + Vector3.new(0, 0, 11), false)
        hearth(parent, center + Vector3.new(-11, 0, 0), false)
        for index = 0, 3 do
            part(
                parent,
                "LockRail",
                Vector3.new(0.6, 1.6, 15),
                CFrame.new(center + Vector3.new(0, 1.6, 0))
                    * CFrame.Angles(0, math.rad(45 + index * 90), 0)
                    * CFrame.new(0, 0, 7.5),
                IRON,
                Enum.Material.Metal
            )
        end
        return true
    elseif visual == "howler_approach" then
        valeGround(parent, center)
        -- The landmark: the bowl the White Howler is fought in, with its
        -- three verbs standing in the world before anything is wired to
        -- them. Things that make noise, hearths to spend, and the aurora
        -- over the ridge that is the only way to follow it.
        for index = 0, 7 do
            part(
                parent,
                "BowlRidge",
                Vector3.new(11, 9 + (index % 3) * 2, 6),
                CFrame.new(center + Vector3.new(0, 4.5, 0))
                    * CFrame.Angles(0, math.rad(index * 45), 0)
                    * CFrame.new(0, 0, 19),
                SHADOW_SNOW,
                Enum.Material.Snow
            )
        end
        abbeyBell(parent, center + Vector3.new(-13, 0, -9), true)
        hearth(parent, center + Vector3.new(0, 0, -6), true)
        hearth(parent, center + Vector3.new(0, 0, 8), false)
        snowTracks(parent, center + Vector3.new(9, 0, -12), 205, 6)
        auroraRibbon(parent, center, 30)
        cairn(parent, center + Vector3.new(14, 0, 12))
        return true
    end
    return false
end

return table.freeze(FrostmereBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="160">
          <Properties>
            <string name="Name">IronrootBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    The Ironroot Delve's geometry.

    Bramblewake's builder is a forest: arches, ferns, root tangles, wet
    earth. None of that is the Delve, and dressing a mine in the forest's
    vocabulary is exactly the reskin the milestone's exit gate forbids. So
    the Delve gets its own primitives -- shoring timber, rail, plate,
    ore-shot rock, coalglass, lamp posts -- and its own palette, and every
    module visual is assembled from those.

    What makes a place read as underground when the sky is still there:
    ceilings. Every module here carries a low shored roof on posts, which
    frames the view, throws the module into shadow, and gives the eye a
    horizon at head height instead of at the mountains. The Delve's own
    light comes from lamps and coalglass rather than from the sun.

    This is the first half of the Delve's geometry: the shared vocabulary
    and the arrival, extraction, resource, traversal and landmark shapes.
    Its combat, connector, story and puzzle rooms follow in the next wave,
    and until every visual key in the catalog has a case here the region
    stays disabled in Regions.luau -- RegionAccess refuses it, and
    ExpeditionService's boot assert refuses it louder.
]]

local IronrootBuilder = {}

local ROCK = Color3.fromRGB(62, 58, 56)
local DARK_ROCK = Color3.fromRGB(38, 36, 35)
local ORE_ROCK = Color3.fromRGB(84, 72, 60)
local TIMBER = Color3.fromRGB(96, 68, 42)
local DARK_TIMBER = Color3.fromRGB(62, 44, 28)
local IRON = Color3.fromRGB(92, 88, 86)
local RAIL = Color3.fromRGB(112, 104, 96)
local COALGLASS = Color3.fromRGB(255, 168, 66)
local FUNGUS = Color3.fromRGB(150, 226, 176)
local LAMP = Color3.fromRGB(255, 206, 128)
local SPOIL = Color3.fromRGB(52, 46, 42)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function glow(
    parent: Instance,
    name: string,
    position: Vector3,
    size: number,
    color: Color3,
    brightness: number
): Part
    local orb = part(
        parent,
        name,
        Vector3.new(size, size, size),
        CFrame.new(position),
        color,
        Enum.Material.Neon,
        false
    )
    orb.Shape = Enum.PartType.Ball
    orb.CanQuery = false
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = size * 6
    light.Brightness = brightness
    light.Shadows = false
    light.Parent = orb
    return orb
end

--[[
    A shored bay: two post pairs and a roof beam. This is the Delve's
    single most repeated shape and the reason its modules read as
    interior -- the roof cuts the sky out of the frame at head height.
]]
local function shoring(parent: Instance, center: Vector3, width: number, depth: number)
    for side = -1, 1, 2 do
        for run = -1, 1, 2 do
            part(
                parent,
                "ShoringPost",
                Vector3.new(1.6, 13, 1.6),
                CFrame.new(center + Vector3.new(side * width * 0.5, 6.5, run * depth * 0.5)),
                TIMBER,
                Enum.Material.Wood
            )
        end
        part(
            parent,
            "ShoringCap",
            Vector3.new(2, 1.4, depth + 2),
            CFrame.new(center + Vector3.new(side * width * 0.5, 13.4, 0)),
            DARK_TIMBER,
            Enum.Material.Wood,
            false
        )
    end
    local roof = part(
        parent,
        "ShoringRoof",
        Vector3.new(width + 3, 1.8, depth + 3),
        CFrame.new(center + Vector3.new(0, 14.4, 0)),
        DARK_ROCK,
        Enum.Material.Slate,
        false
    )
    roof.CanQuery = false
end

-- Rough cut rock, for walls and spoil heaps: three slabs at angles so no
-- two faces of the Delve look machined.
local function rockFace(parent: Instance, center: Vector3, size: Vector3, seed: number)
    for index = 0, 2 do
        local drift = (seed + index * 37) % 11 - 5
        part(
            parent,
            "CutRock",
            size + Vector3.new(index * 1.2, index * 0.8, index * 0.9),
            CFrame.new(center + Vector3.new(drift * 0.4, index * 1.1, drift * 0.3))
                * CFrame.Angles(0, math.rad(drift * 4), math.rad(drift * 1.5)),
            if index == 1 then ORE_ROCK else ROCK,
            Enum.Material.Rock
        )
    end
end

-- Rail: two lines and their sleepers, running along Z through a module.
local function railLine(parent: Instance, center: Vector3, length: number)
    for side = -1, 1, 2 do
        part(
            parent,
            "Rail",
            Vector3.new(0.5, 0.5, length),
            CFrame.new(center + Vector3.new(side * 1.6, 0.55, 0)),
            RAIL,
            Enum.Material.Metal,
            false
        )
    end
    local sleepers = math.max(2, math.floor(length / 5))
    for index = 0, sleepers do
        part(
            parent,
            "Sleeper",
            Vector3.new(5.4, 0.4, 1.1),
            CFrame.new(center + Vector3.new(0, 0.3, -length * 0.5 + index * (length / sleepers))),
            DARK_TIMBER,
            Enum.Material.Wood,
            false
        )
    end
end

local function lampPost(parent: Instance, position: Vector3)
    part(
        parent,
        "LampPost",
        Vector3.new(0.5, 7, 0.5),
        CFrame.new(position + Vector3.new(0, 3.5, 0)),
        IRON,
        Enum.Material.Metal
    )
    part(
        parent,
        "LampHood",
        Vector3.new(1.8, 0.6, 1.8),
        CFrame.new(position + Vector3.new(0, 7.2, 0)),
        IRON,
        Enum.Material.Metal,
        false
    )
    glow(parent, "LampFlame", position + Vector3.new(0, 6.6, 0), 1.1, LAMP, 2.2)
end

local function oreCart(parent: Instance, position: Vector3, facing: number)
    local body = part(
        parent,
        "OreCartBody",
        Vector3.new(4.4, 2.6, 6),
        CFrame.new(position + Vector3.new(0, 2.2, 0)) * CFrame.Angles(0, facing, 0),
        IRON,
        Enum.Material.DiamondPlate
    )
    part(
        parent,
        "OreCartLoad",
        Vector3.new(3.8, 1, 5.2),
        body.CFrame * CFrame.new(0, 1.6, 0),
        ORE_ROCK,
        Enum.Material.Rock,
        false
    )
    for side = -1, 1, 2 do
        for run = -1, 1, 2 do
            -- A cylinder's axis is its Size.X, so the axle runs across the
            -- cart. Getting this backwards buries a wheel in its own body,
            -- which is exactly what happened to the Rail Hound.
            local wheel = part(
                parent,
                "OreCartWheel",
                Vector3.new(0.6, 2, 2),
                body.CFrame * CFrame.new(side * 2.3, -1.4, run * 1.9),
                DARK_ROCK,
                Enum.Material.Metal,
                false
            )
            wheel.Shape = Enum.PartType.Cylinder
        end
    end
end

local function fungusPatch(parent: Instance, center: Vector3, seed: number)
    for index = 0, 4 do
        local angle = index * math.pi * 0.4 + seed * 0.1
        local at = center + Vector3.new(math.cos(angle) * 3.2, 0, math.sin(angle) * 3.2)
        part(
            parent,
            "FungusStalk",
            Vector3.new(0.3, 1.4, 0.3),
            CFrame.new(at + Vector3.new(0, 0.7, 0)),
            Color3.fromRGB(96, 110, 92),
            Enum.Material.Slate,
            false
        )
        glow(parent, "FungusCap", at + Vector3.new(0, 1.6, 0), 1.3, FUNGUS, 1.1)
    end
end

local function spoilHeap(parent: Instance, center: Vector3, scale: number)
    for index = 0, 2 do
        local heap = part(
            parent,
            "SpoilHeap",
            Vector3.new(7 * scale - index, 2.4 * scale - index * 0.4, 6 * scale - index),
            CFrame.new(center + Vector3.new(index * 0.6, index * 1.1, index * 0.4)),
            SPOIL,
            Enum.Material.Ground,
            false
        )
        heap.Shape = Enum.PartType.Ball
    end
end

local function coalglassSeam(parent: Instance, center: Vector3, height: number)
    part(
        parent,
        "SeamRock",
        Vector3.new(3.4, height, 2.2),
        CFrame.new(center + Vector3.new(0, height * 0.5, 0)) * CFrame.Angles(0, 0, math.rad(6)),
        DARK_ROCK,
        Enum.Material.Rock
    )
    for index = 0, 3 do
        glow(
            parent,
            "Coalglass",
            center + Vector3.new(0, 1.6 + index * (height / 5), -1.1),
            0.9,
            COALGLASS,
            1.4
        )
    end
end

-- A pipe run: the Delve's plumbing, and the Maw's feed lines in miniature.
local function pipeRun(parent: Instance, center: Vector3, length: number, height: number)
    local pipe = part(
        parent,
        "Pipe",
        Vector3.new(length, 1.4, 1.4),
        CFrame.new(center + Vector3.new(0, height, 0)),
        IRON,
        Enum.Material.Metal,
        false
    )
    pipe.Shape = Enum.PartType.Cylinder
    for side = -1, 1, 2 do
        part(
            parent,
            "PipeBracket",
            Vector3.new(0.8, height, 0.8),
            CFrame.new(center + Vector3.new(side * length * 0.4, height * 0.5, 0)),
            IRON,
            Enum.Material.Metal,
            false
        )
    end
end

-- Standing water, which the Delve has wherever the pumps stopped.
local function floodPool(parent: Instance, center: Vector3, size: number)
    local water = part(
        parent,
        "FloodPool",
        Vector3.new(size, 0.6, size * 0.8),
        CFrame.new(center + Vector3.new(0, 0.5, 0)),
        Color3.fromRGB(46, 62, 66),
        Enum.Material.Glass,
        false
    )
    water.Transparency = 0.45
    water.Reflectance = 0.35
    water.CanQuery = false
end

-- Scaffolding: a laddered climb, the Delve's vertical traversal.
local function scaffold(parent: Instance, center: Vector3, levels: number)
    for level = 0, levels - 1 do
        part(
            parent,
            "ScaffoldDeck",
            Vector3.new(10, 0.6, 5),
            CFrame.new(center + Vector3.new(0, 4 + level * 5, level % 2 * 4 - 2)),
            TIMBER,
            Enum.Material.Wood
        )
        for side = -1, 1, 2 do
            part(
                parent,
                "ScaffoldLeg",
                Vector3.new(0.7, 5, 0.7),
                CFrame.new(center + Vector3.new(side * 4.6, 1.7 + level * 5, level % 2 * 4 - 2)),
                DARK_TIMBER,
                Enum.Material.Wood
            )
        end
        for rung = 0, 3 do
            part(
                parent,
                "LadderRung",
                Vector3.new(2.4, 0.3, 0.3),
                CFrame.new(
                    center + Vector3.new(0, 4.8 + level * 5 + rung * 1.1, level % 2 * 4 + 0.8)
                ),
                DARK_TIMBER,
                Enum.Material.Wood,
                false
            )
        end
    end
end

-- Machinery: the thing that is still running when nobody asked it to.
local function machine(parent: Instance, center: Vector3, scale: number)
    part(
        parent,
        "MachineBed",
        Vector3.new(7 * scale, 3 * scale, 5 * scale),
        CFrame.new(center + Vector3.new(0, 1.6 * scale, 0)),
        IRON,
        Enum.Material.DiamondPlate
    )
    local flywheel = part(
        parent,
        "MachineFlywheel",
        Vector3.new(1.1, 5.4 * scale, 5.4 * scale),
        CFrame.new(center + Vector3.new(3.6 * scale, 3.4 * scale, 0)),
        DARK_ROCK,
        Enum.Material.Metal,
        false
    )
    flywheel.Shape = Enum.PartType.Cylinder
    glow(
        parent,
        "MachineFirebox",
        center + Vector3.new(-2.4 * scale, 1.8 * scale, 0),
        1.5,
        COALGLASS,
        1.8
    )
    pipeRun(parent, center + Vector3.new(0, 0, -3.4 * scale), 12 * scale, 5 * scale)
end

-- A collapse: fallen roof rock with light finding its way through.
local function collapse(parent: Instance, center: Vector3, seed: number)
    for index = 0, 4 do
        local drift = (seed + index * 23) % 9 - 4
        part(
            parent,
            "FallenRock",
            Vector3.new(5 - index * 0.5, 4 - index * 0.4, 5 - index * 0.6),
            CFrame.new(center + Vector3.new(drift * 1.6, 1.6 + index * 1.4, drift * 0.9))
                * CFrame.Angles(math.rad(drift * 6), math.rad(drift * 9), math.rad(drift * 5)),
            if index % 2 == 0 then ROCK else DARK_ROCK,
            Enum.Material.Rock
        )
    end
end

-- A worked doorway with an air door hung in it.
local function airDoor(parent: Instance, center: Vector3)
    for side = -1, 1, 2 do
        part(
            parent,
            "DoorJamb",
            Vector3.new(1.4, 11, 2),
            CFrame.new(center + Vector3.new(side * 5, 5.5, 0)),
            TIMBER,
            Enum.Material.Wood
        )
    end
    part(
        parent,
        "DoorHead",
        Vector3.new(11, 1.4, 2),
        CFrame.new(center + Vector3.new(0, 11.4, 0)),
        DARK_TIMBER,
        Enum.Material.Wood,
        false
    )
    local leaf = part(
        parent,
        "AirDoorLeaf",
        Vector3.new(8.6, 9.6, 0.5),
        CFrame.new(center + Vector3.new(-1.4, 5.2, 0.4)) * CFrame.Angles(0, math.rad(28), 0),
        Color3.fromRGB(112, 96, 76),
        Enum.Material.Fabric,
        false
    )
    leaf.Transparency = 0.15
end

-- A tally or notice board: where the Delve wrote things down.
local function noticeBoard(parent: Instance, center: Vector3)
    part(
        parent,
        "BoardPost",
        Vector3.new(0.6, 5, 0.6),
        CFrame.new(center + Vector3.new(0, 2.5, 0)),
        DARK_TIMBER,
        Enum.Material.Wood
    )
    local board = part(
        parent,
        "BoardFace",
        Vector3.new(5.4, 3.4, 0.4),
        CFrame.new(center + Vector3.new(0, 5.4, 0)) * CFrame.Angles(math.rad(-8), 0, 0),
        TIMBER,
        Enum.Material.Wood,
        false
    )
    for index = 0, 3 do
        part(
            parent,
            "TallyMark",
            Vector3.new(0.9, 0.2, 0.1),
            board.CFrame * CFrame.new(-1.6 + index * 1.1, 0.6, 0.25),
            Color3.fromRGB(224, 214, 196),
            Enum.Material.SmoothPlastic,
            false
        )
    end
end

--[[
    Every module's floor: worked rock rather than grass, with a spoil edge
    so the ground reads as cut rather than grown.
]]
local function delveFloor(parent: Instance, center: Vector3)
    local floor = part(
        parent,
        "DelveFloor",
        Vector3.new(56, 1, 56),
        CFrame.new(center + Vector3.new(0, 0.2, 0)),
        DARK_ROCK,
        Enum.Material.Rock,
        false
    )
    floor.CanQuery = false
    for side = -1, 1, 2 do
        rockFace(parent, center + Vector3.new(side * 26, 0, 0), Vector3.new(5, 12, 40), 17 + side)
    end
end

--[[
    Assemble one module's visual. Unknown keys return false so the caller
    can tell the difference between "built" and "not authored yet" -- the
    Delve ships disabled until this returns true for every key its catalog
    declares, and a spec counts them.
]]
function IronrootBuilder.buildModuleVisual(
    parent: Instance,
    visual: string,
    center: Vector3
): boolean
    if visual == "delve_gate" then
        delveFloor(parent, center)
        shoring(parent, center, 22, 16)
        railLine(parent, center, 46)
        lampPost(parent, center + Vector3.new(-11, 0, 10))
        lampPost(parent, center + Vector3.new(11, 0, 10))
        part(
            parent,
            "GateLintel",
            Vector3.new(26, 2.4, 3),
            CFrame.new(center + Vector3.new(0, 15.6, -8)),
            DARK_TIMBER,
            Enum.Material.Wood,
            false
        )
        return true
    elseif visual == "daylight_shaft" then
        delveFloor(parent, center)
        shoring(parent, center, 20, 14)
        railLine(parent, center, 40)
        -- The way out: a shaft of real light, which is the only place in
        -- the Delve the sky is allowed to reach the floor.
        local shaft = part(
            parent,
            "DaylightShaft",
            Vector3.new(9, 30, 9),
            CFrame.new(center + Vector3.new(0, 15, -4)),
            Color3.fromRGB(255, 244, 214),
            Enum.Material.Neon,
            false
        )
        shaft.Transparency = 0.82
        shaft.CanQuery = false
        glow(parent, "ShaftMouth", center + Vector3.new(0, 2.4, -4), 3.2, LAMP, 3)
        lampPost(parent, center + Vector3.new(-9, 0, 8))
        return true
    elseif visual == "ore_gallery" then
        delveFloor(parent, center)
        shoring(parent, center, 26, 20)
        railLine(parent, center, 44)
        oreCart(parent, center + Vector3.new(0, 0, 9), 0)
        rockFace(parent, center + Vector3.new(-14, 0, -12), Vector3.new(8, 9, 7), 41)
        spoilHeap(parent, center + Vector3.new(13, 0, -10), 1.1)
        lampPost(parent, center + Vector3.new(-12, 0, 4))
        return true
    elseif visual == "coalglass_seam" then
        delveFloor(parent, center)
        shoring(parent, center, 24, 18)
        coalglassSeam(parent, center + Vector3.new(-10, 0, -6), 11)
        coalglassSeam(parent, center + Vector3.new(9, 0, -9), 8)
        spoilHeap(parent, center + Vector3.new(6, 0, 8), 0.9)
        return true
    elseif visual == "fungus_terrace" then
        delveFloor(parent, center)
        shoring(parent, center, 26, 22)
        for index = -1, 1 do
            part(
                parent,
                "Terrace",
                Vector3.new(20, 1.6, 7),
                CFrame.new(center + Vector3.new(0, 1 + (index + 1) * 1.7, index * 8)),
                ROCK,
                Enum.Material.Rock
            )
            fungusPatch(
                parent,
                center + Vector3.new(index * 6, 2.6 + (index + 1) * 1.7, index * 8),
                index + 3
            )
        end
        return true
    elseif visual == "main_incline" then
        delveFloor(parent, center)
        shoring(parent, center, 20, 24)
        -- The grade itself: a ramp the rails climb, which is the Delve's
        -- traversal identity in one shape.
        local ramp = part(
            parent,
            "InclineRamp",
            Vector3.new(16, 2, 34),
            CFrame.new(center + Vector3.new(0, 3.4, 0)) * CFrame.Angles(math.rad(-9), 0, 0),
            ROCK,
            Enum.Material.Rock
        )
        railLine(parent, ramp.Position + Vector3.new(0, 1.2, 0), 30)
        lampPost(parent, center + Vector3.new(-9, 0, -12))
        lampPost(parent, center + Vector3.new(9, 0, 12))
        return true
    elseif visual == "rail_walk" then
        delveFloor(parent, center)
        shoring(parent, center, 18, 26)
        railLine(parent, center, 50)
        oreCart(parent, center + Vector3.new(0, 0, -14), 0)
        for offset = -1, 1, 2 do
            lampPost(parent, center + Vector3.new(offset * 8, 0, offset * 11))
        end
        return true
    elseif visual == "dark_stretch" then
        delveFloor(parent, center)
        shoring(parent, center, 16, 28)
        -- One lamp, far off, and coalglass close enough to walk by. The
        -- unlit stretch is the Delve's answer to Bramblewake's fog.
        coalglassSeam(parent, center + Vector3.new(-7, 0, 6), 6)
        lampPost(parent, center + Vector3.new(6, 0, -16))
        return true
    elseif visual == "bellows_approach" then
        delveFloor(parent, center)
        shoring(parent, center, 30, 24)
        railLine(parent, center, 46)
        -- The Maw's own feed lines converge here, and its heat shows in
        -- the rock before the chamber does.
        for side = -1, 1, 2 do
            coalglassSeam(parent, center + Vector3.new(side * 13, 0, -8), 13)
            oreCart(parent, center + Vector3.new(side * 9, 0, 12), 0)
        end
        glow(parent, "BellowsHeat", center + Vector3.new(0, 3, -18), 5.5, COALGLASS, 3.5)
        return true
    elseif visual == "oil_works" then
        delveFloor(parent, center)
        shoring(parent, center, 26, 20)
        machine(parent, center + Vector3.new(-6, 0, -4), 1.1)
        pipeRun(parent, center + Vector3.new(4, 0, 6), 22, 6)
        for index = -1, 1 do
            part(
                parent,
                "OilDrum",
                Vector3.new(2.6, 3.4, 2.6),
                CFrame.new(center + Vector3.new(9 + index * 3, 1.9, -8)),
                Color3.fromRGB(74, 66, 52),
                Enum.Material.Metal
            )
        end
        return true
    elseif visual == "echo_vault" then
        delveFloor(parent, center)
        shoring(parent, center, 24, 24)
        -- A ring of crystal that hums a half-second late; the vault is
        -- lit by its own answer rather than by any lamp.
        for index = 0, 7 do
            local angle = index * math.pi * 0.25
            local at = center + Vector3.new(math.cos(angle) * 9, 0, math.sin(angle) * 9)
            part(
                parent,
                "EchoCrystal",
                Vector3.new(1.2, 5.5 - (index % 3), 1.2),
                CFrame.new(at + Vector3.new(0, 2.8, 0))
                    * CFrame.Angles(math.rad(index * 5), angle, 0),
                Color3.fromRGB(126, 176, 214),
                Enum.Material.Glass
            )
            glow(
                parent,
                "EchoLight",
                at + Vector3.new(0, 5.6, 0),
                0.9,
                Color3.fromRGB(126, 176, 214),
                1.1
            )
        end
        return true
    elseif visual == "flooded_stope" then
        delveFloor(parent, center)
        shoring(parent, center, 28, 22)
        floodPool(parent, center + Vector3.new(0, 0, 2), 30)
        spoilHeap(parent, center + Vector3.new(-12, 0, -9), 1)
        rockFace(parent, center + Vector3.new(12, 0, -10), Vector3.new(7, 10, 8), 29)
        lampPost(parent, center + Vector3.new(-11, 0, 11))
        return true
    elseif visual == "abandoned_face" then
        delveFloor(parent, center)
        shoring(parent, center, 22, 18)
        rockFace(parent, center + Vector3.new(0, 0, -12), Vector3.new(16, 12, 6), 53)
        -- Tools left where the shift stopped.
        for index = -1, 1 do
            part(
                parent,
                "AbandonedPick",
                Vector3.new(0.4, 0.4, 4),
                CFrame.new(center + Vector3.new(index * 3, 0.6, 2))
                    * CFrame.Angles(0, math.rad(index * 34), math.rad(78)),
                DARK_TIMBER,
                Enum.Material.Wood,
                false
            )
        end
        oreCart(parent, center + Vector3.new(8, 0, 8), math.rad(20))
        return true
    elseif visual == "scaffold_climb" then
        delveFloor(parent, center)
        shoring(parent, center, 24, 22)
        scaffold(parent, center + Vector3.new(-4, 0, 0), 3)
        scaffold(parent, center + Vector3.new(9, 0, -6), 2)
        lampPost(parent, center + Vector3.new(10, 0, 9))
        return true
    elseif visual == "collapse_scramble" then
        delveFloor(parent, center)
        shoring(parent, center, 26, 20)
        collapse(parent, center + Vector3.new(-3, 0, -3), 61)
        collapse(parent, center + Vector3.new(8, 0, 7), 17)
        glow(parent, "CollapseChink", center + Vector3.new(-3, 12, -3), 2.2, LAMP, 1.6)
        return true
    elseif visual == "winch_crossing" then
        delveFloor(parent, center)
        shoring(parent, center, 24, 26)
        machine(parent, center + Vector3.new(-9, 0, 8), 0.8)
        -- The cable itself, strung across the gap it carries carts over.
        part(
            parent,
            "WinchCable",
            Vector3.new(0.3, 0.3, 34),
            CFrame.new(center + Vector3.new(0, 9.5, 0)),
            RAIL,
            Enum.Material.Metal,
            false
        )
        oreCart(parent, center + Vector3.new(0, 5.5, 2), 0)
        return true
    elseif visual == "mite_nest" then
        delveFloor(parent, center)
        shoring(parent, center, 24, 22)
        spoilHeap(parent, center + Vector3.new(-6, 0, -4), 1.3)
        spoilHeap(parent, center + Vector3.new(7, 0, 5), 1)
        for index = 0, 5 do
            local angle = index * math.pi / 3
            glow(
                parent,
                "MiteEmber",
                center + Vector3.new(math.cos(angle) * 7, 0.9, math.sin(angle) * 7),
                0.7,
                COALGLASS,
                0.9
            )
        end
        return true
    elseif visual == "slag_channel" then
        delveFloor(parent, center)
        shoring(parent, center, 22, 26)
        -- The channel: a molten line the fight has to be fought across.
        local channel = part(
            parent,
            "SlagChannel",
            Vector3.new(6, 0.8, 40),
            CFrame.new(center + Vector3.new(0, 0.7, 0)),
            COALGLASS,
            Enum.Material.Neon,
            false
        )
        channel.CanQuery = false
        for side = -1, 1, 2 do
            part(
                parent,
                "ChannelLip",
                Vector3.new(2.4, 1.6, 40),
                CFrame.new(center + Vector3.new(side * 4.2, 1, 0)),
                DARK_ROCK,
                Enum.Material.Rock
            )
        end
        glow(parent, "SlagHeat", center + Vector3.new(0, 3, 0), 4, COALGLASS, 2.6)
        return true
    elseif visual == "guard_round" then
        delveFloor(parent, center)
        shoring(parent, center, 26, 26)
        machine(parent, center + Vector3.new(0, 0, -9), 1)
        railLine(parent, center, 40)
        for side = -1, 1, 2 do
            part(
                parent,
                "GuardPlate",
                Vector3.new(1.2, 8, 9),
                CFrame.new(center + Vector3.new(side * 11, 4, 4)),
                IRON,
                Enum.Material.DiamondPlate
            )
        end
        return true
    elseif visual == "gas_pocket" then
        delveFloor(parent, center)
        shoring(parent, center, 22, 20)
        local haze = part(
            parent,
            "Whitedamp",
            Vector3.new(24, 7, 20),
            CFrame.new(center + Vector3.new(0, 3.6, 0)),
            FUNGUS,
            Enum.Material.Neon,
            false
        )
        haze.Transparency = 0.86
        haze.CanQuery = false
        fungusPatch(parent, center + Vector3.new(-7, 0, 5), 9)
        fungusPatch(parent, center + Vector3.new(8, 0, -6), 4)
        return true
    elseif visual == "echo_gallery" then
        delveFloor(parent, center)
        shoring(parent, center, 28, 22)
        for index = -1, 1 do
            part(
                parent,
                "GalleryPillar",
                Vector3.new(3.4, 12, 3.4),
                CFrame.new(center + Vector3.new(index * 9, 6, -4)),
                ROCK,
                Enum.Material.Rock
            )
            glow(
                parent,
                "EchoLight",
                center + Vector3.new(index * 9, 11, -4),
                1,
                Color3.fromRGB(126, 176, 214),
                1.2
            )
        end
        railLine(parent, center + Vector3.new(0, 0, 8), 30)
        return true
    elseif visual == "shored_drift" then
        delveFloor(parent, center)
        shoring(parent, center, 16, 30)
        railLine(parent, center, 44)
        lampPost(parent, center + Vector3.new(-6, 0, 0))
        return true
    elseif visual == "junction_round" then
        delveFloor(parent, center)
        shoring(parent, center, 26, 26)
        railLine(parent, center, 40)
        railLine(parent, center + Vector3.new(0, 0, 0), 6)
        -- The switch stand that gives a junction its name.
        part(
            parent,
            "SwitchStand",
            Vector3.new(0.6, 4, 0.6),
            CFrame.new(center + Vector3.new(5, 2, 0)),
            IRON,
            Enum.Material.Metal
        )
        glow(parent, "SwitchLamp", center + Vector3.new(5, 4.4, 0), 0.9, LAMP, 1.4)
        lampPost(parent, center + Vector3.new(-9, 0, 9))
        return true
    elseif visual == "rail_siding" then
        delveFloor(parent, center)
        shoring(parent, center, 24, 24)
        railLine(parent, center + Vector3.new(-5, 0, 0), 38)
        railLine(parent, center + Vector3.new(6, 0, 0), 26)
        oreCart(parent, center + Vector3.new(6, 0, -6), 0)
        oreCart(parent, center + Vector3.new(6, 0, 3), 0)
        return true
    elseif visual == "air_door" then
        delveFloor(parent, center)
        shoring(parent, center, 18, 22)
        airDoor(parent, center)
        railLine(parent, center, 36)
        return true
    elseif visual == "foreman_office" then
        delveFloor(parent, center)
        shoring(parent, center, 22, 20)
        -- A room inside the rock: three walls, a desk, and the board that
        -- ran the shift.
        for side = -1, 1, 2 do
            part(
                parent,
                "OfficeWall",
                Vector3.new(0.8, 9, 14),
                CFrame.new(center + Vector3.new(side * 7, 4.5, 0)),
                TIMBER,
                Enum.Material.Wood
            )
        end
        part(
            parent,
            "OfficeBack",
            Vector3.new(14, 9, 0.8),
            CFrame.new(center + Vector3.new(0, 4.5, -7)),
            TIMBER,
            Enum.Material.Wood
        )
        part(
            parent,
            "OfficeDesk",
            Vector3.new(6, 0.6, 3),
            CFrame.new(center + Vector3.new(0, 3, -4)),
            DARK_TIMBER,
            Enum.Material.Wood
        )
        noticeBoard(parent, center + Vector3.new(4, 0, 4))
        lampPost(parent, center + Vector3.new(-5, 0, 5))
        return true
    elseif visual == "miners_rest" then
        delveFloor(parent, center)
        shoring(parent, center, 24, 20)
        for index = -1, 1 do
            part(
                parent,
                "RestBench",
                Vector3.new(7, 0.6, 2),
                CFrame.new(center + Vector3.new(index * 8, 1.6, -5)),
                TIMBER,
                Enum.Material.Wood
            )
            part(
                parent,
                "LunchPail",
                Vector3.new(1.1, 1.2, 1.1),
                CFrame.new(center + Vector3.new(index * 8 + 1.4, 2.5, -5)),
                IRON,
                Enum.Material.Metal,
                false
            )
        end
        glow(parent, "RestFire", center + Vector3.new(0, 1.4, 4), 2.4, COALGLASS, 2.4)
        lampPost(parent, center + Vector3.new(9, 0, 7))
        return true
    elseif visual == "memorial_drift" then
        delveFloor(parent, center)
        shoring(parent, center, 20, 22)
        -- Lamps set in a row for the ones who did not come up, and the
        -- names cut into the rock behind them.
        rockFace(parent, center + Vector3.new(0, 0, -9), Vector3.new(16, 10, 4), 7)
        for index = -2, 2 do
            glow(parent, "MemorialLamp", center + Vector3.new(index * 3.4, 1.6, -5), 1.1, LAMP, 1.5)
            part(
                parent,
                "MemorialStone",
                Vector3.new(1.6, 2.4, 0.8),
                CFrame.new(center + Vector3.new(index * 3.4, 1.2, -6.4)),
                ROCK,
                Enum.Material.Slate
            )
        end
        return true
    elseif visual == "signal_room" then
        delveFloor(parent, center)
        shoring(parent, center, 22, 20)
        machine(parent, center + Vector3.new(-7, 0, -5), 0.7)
        noticeBoard(parent, center + Vector3.new(6, 0, -5))
        -- The signal board itself: three levers, which is what the
        -- Foreman Echo's fight is fought with.
        for index = -1, 1 do
            part(
                parent,
                "SignalLever",
                Vector3.new(0.5, 3.4, 0.5),
                CFrame.new(center + Vector3.new(index * 2.6, 2.6, 4))
                    * CFrame.Angles(math.rad(index * 18), 0, 0),
                IRON,
                Enum.Material.Metal
            )
            glow(
                parent,
                "SignalLamp",
                center + Vector3.new(index * 2.6, 4.6, 4),
                0.7,
                COALGLASS,
                1.1
            )
        end
        return true
    elseif visual == "flood_locks" then
        delveFloor(parent, center)
        shoring(parent, center, 26, 22)
        floodPool(parent, center + Vector3.new(0, 0, 7), 24)
        -- Two lock gates and their wheels, which is the puzzle's shape.
        for side = -1, 1, 2 do
            part(
                parent,
                "LockGate",
                Vector3.new(9, 7, 1),
                CFrame.new(center + Vector3.new(side * 7, 3.5, -3)),
                IRON,
                Enum.Material.DiamondPlate
            )
            local wheel = part(
                parent,
                "LockWheel",
                Vector3.new(0.8, 3, 3),
                CFrame.new(center + Vector3.new(side * 7, 8, -3)),
                RAIL,
                Enum.Material.Metal,
                false
            )
            wheel.Shape = Enum.PartType.Cylinder
        end
        pipeRun(parent, center + Vector3.new(0, 0, -8), 20, 7)
        return true
    end
    return false
end

IronrootBuilder.Primitives = table.freeze({
    shoring = shoring,
    railLine = railLine,
    lampPost = lampPost,
    oreCart = oreCart,
    fungusPatch = fungusPatch,
    spoilHeap = spoilHeap,
    coalglassSeam = coalglassSeam,
    rockFace = rockFace,
    delveFloor = delveFloor,
})

return table.freeze(IronrootBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="161">
          <Properties>
            <string name="Name">MeshAssetRegistry</string>
            <string name="Source"><![CDATA[--!strict

-- Roblox model assets created from the measured GLBs in assets/meshes.
-- Stable IDs are source-facing; numeric IDs may only change through the
-- manifest/upload pipeline and a matching review of this registry.

local MeshAssetRegistry = {}

export type Entry = {
    id: string,
    assetId: number,
    targetLongestDimension: number,
    maxTriangles: number,
    maxMaterialSlots: number,
    placementBand: string,
    pbr: boolean,
    preserveSourceMaterials: boolean,
    creatorStore: boolean,
    -- Yaw, in degrees, that the source model is stored at in the place it was
    -- taken from. Creator Store models are frequently saved rotated off-axis,
    -- which does two things at once: every placement comes out turned by that
    -- angle no matter what yaw the call site asks for, and the axis-aligned
    -- bounding box the loader normalizes against is inflated by the rotation,
    -- so targetLongestDimension silently stops meaning the asset's real
    -- longest dimension. The loader cancels this once at template load, so
    -- call sites can specify the yaw they actually want.
    sourceYawDegrees: number?,
    -- Strip Decals and Textures off the source model at template load.
    --
    -- Creator Store props sometimes ship with signage baked on as a decal
    -- rather than modelled. That art was authored for whatever game the asset
    -- came from, and it arrives already saying something -- in a readable
    -- modern typeface -- that this world never agreed to. Set this when the
    -- geometry is worth keeping and the printing on it is not.
    stripDecals: boolean?,
    -- Recolor and re-material matching source parts at template load. A part
    -- matches a rule when its authored color is within 4 per channel of
    -- `match` (0-255 channels). A rule without `color` keeps the part's color
    -- and changes only the material.
    --
    -- Creator Store props arrive palette-locked to whatever game they were
    -- built for -- a fairground-red canopy on otherwise sound market-stall
    -- geometry, for example. When the shape is worth keeping and only the
    -- finish is off-standard, restyling here is cheaper and safer than
    -- re-sourcing the asset, and it happens once per template rather than
    -- once per placement.
    restyleParts: { { match: { number }, color: { number }?, material: string? } }?,
}

local ENTRIES: { Entry } = {
    {
        id = "mesh_conifer_hero_a",
        assetId = 97306204840235,
        targetLongestDimension = 27,
        maxTriangles = 7500,
