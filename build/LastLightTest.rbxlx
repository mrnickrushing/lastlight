            "torso",
            "Block",
            { 2.15, 0.3, 1.15 },
            { 0, -0.72, 0 },
            { 0, 0, 0 },
            { 58, 46, 36 },
            "Leather"
        ),
    },
    hands = {
        part(
            "CuffRight",
            "RightHand",
            "Block",
            { 1.1, 0.62, 1.1 },
            { 0, 0.34, 0 },
            { 0, 0, 0 },
            { 96, 82, 66 },
            "Leather"
        ),
        part(
            "CuffLeft",
            "leftHand",
            "Block",
            { 1.1, 0.62, 1.1 },
            { 0, 0.34, 0 },
            { 0, 0, 0 },
            { 96, 82, 66 },
            "Leather"
        ),
        part(
            "StrapRight",
            "RightHand",
            "Block",
            { 1.16, 0.16, 1.16 },
            { 0, 0.06, 0 },
            { 0, 0, 0 },
            { 62, 52, 42 },
            "Fabric"
        ),
        part(
            "StrapLeft",
            "leftHand",
            "Block",
            { 1.16, 0.16, 1.16 },
            { 0, 0.06, 0 },
            { 0, 0, 0 },
