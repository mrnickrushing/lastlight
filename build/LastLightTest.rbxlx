    FixedMiddleIds = table.freeze({
        "module_tr_jetty_span",
        "module_tr_salvage_flats",
        "module_tr_breakwater_run",
        "module_tr_imp_reef",
        "module_tr_saltworks",
        "module_tr_signal_chain_room",
        "module_tr_rigging_climb",
        "module_tr_harbourmaster_office",
        "module_tr_wreck_yard",
        "module_tr_titan_approach",
    }),
    Modules = table.freeze(modules),
    PointsOfInterest = table.freeze(pointsOfInterest),
    Events = table.freeze(events),
})
]]></string>
