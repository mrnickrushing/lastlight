        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">NetworkService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkService = {}
NetworkService.__index = NetworkService
NetworkService.Name = "NetworkService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type NetworkService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _folder: Folder?,
        _actionRequest: RemoteEvent?,
        _stateChanged: RemoteEvent?,
        _getState: RemoteFunction?,
        _actionHandler: ((Player, any) -> ())?,
        _snapshotProvider: ((Player) -> any)?,
        _snapshotCache: { [Player]: { at: number, value: any } },
        _lastActionAt: { [Player]: number },
        _lastStateAt: { [Player]: number },
    },
    NetworkService
))

function NetworkService.new(logger: Logger): NetworkService
    return setmetatable({
        Name = NetworkService.Name,
        _logger = logger,
        _folder = nil,
        _actionRequest = nil,
        _stateChanged = nil,
        _getState = nil,
        _actionHandler = nil,
        _snapshotProvider = nil,
        _snapshotCache = {},
        _lastActionAt = {},
        _lastStateAt = {},
    }, NetworkService)
end

local function isValidActionPayload(payload: any): boolean
    if type(payload) ~= "table" or payload.schemaVersion ~= 1 then
        return false
    end

    local kind = payload.kind
    if type(kind) ~= "string" or #kind == 0 or #kind > 32 then
        return false
    end

    local fieldCount = 0
    for key, value in payload do
        fieldCount += 1
        if fieldCount > 6 or type(key) ~= "string" then
            return false
        end
        local valueType = type(value)
        if valueType == "string" then
            if #value > 128 then
                return false
            end
        elseif valueType == "number" then
            if value ~= value or value == math.huge or value == -math.huge then
                return false
            end
        elseif valueType ~= "boolean" and valueType ~= "number" then
            return false
        end
    end
    return true
end

local function makeRemote(className: string, name: string, parent: Instance): Instance
    local remote = Instance.new(className)
    remote.Name = name
    remote.Parent = parent
    return remote
end

function NetworkService.Init(self: NetworkService, context: any)
    local runtimeIds = context.runtimeIds
    local existing = ReplicatedStorage:FindFirstChild(runtimeIds.FolderName)
    if existing ~= nil then
        existing:Destroy()
    end

    local folder = Instance.new("Folder")
    folder.Name = runtimeIds.FolderName
    folder:SetAttribute("SchemaVersion", 1)
    folder:SetAttribute("WorldReady", false)
    folder.Parent = ReplicatedStorage

    self._folder = folder
    self._actionRequest =
        makeRemote("RemoteEvent", runtimeIds.Remotes.ActionRequest, folder) :: RemoteEvent
    self._stateChanged =
        makeRemote("RemoteEvent", runtimeIds.Remotes.StateChanged, folder) :: RemoteEvent
    self._getState =
        makeRemote("RemoteFunction", runtimeIds.Remotes.GetState, folder) :: RemoteFunction
end

function NetworkService.Start(self: NetworkService)
    local actionRequest = assert(self._actionRequest, "action remote unavailable")
    local getState = assert(self._getState, "state function unavailable")

    actionRequest.OnServerEvent:Connect(function(player: Player, payload: any)
        if type(payload) ~= "table" then
            return
        end
        if not isValidActionPayload(payload) then
            return
        end
        local now = os.clock()
        local lastActionAt = self._lastActionAt[player]
        if lastActionAt ~= nil and os.clock() - lastActionAt < 0.05 then
            return
        end
        self._lastActionAt[player] = now
        local handler = self._actionHandler
        if handler ~= nil then
            handler(player, payload)
        end
    end)

    getState.OnServerInvoke = function(player: Player)
        if typeof(player) ~= "Instance" or not player:IsA("Player") then
            return nil
        end
        local lastStateAt = self._lastStateAt[player]
        if lastStateAt ~= nil and os.clock() - lastStateAt < 0.1 then
            return nil
        end
        self._lastStateAt[player] = os.clock()
        local provider = self._snapshotProvider
        if provider == nil then
            return nil
        end
        local now = os.clock()
        local cached = self._snapshotCache[player]
        if cached ~= nil and now - cached.at < 0.2 then
            return cached.value
        end

        local snapshot = provider(player)
        self._snapshotCache[player] = {
            at = now,
            value = snapshot,
        }
        return snapshot
    end
    Players.PlayerRemoving:Connect(function(player: Player)
        self._snapshotCache[player] = nil
        self._lastActionAt[player] = nil
        self._lastStateAt[player] = nil
    end)

    self._logger:info("network_started", { schemaVersion = 1 })
end

function NetworkService.setActionHandler(self: NetworkService, handler: (Player, any) -> ())
    self._actionHandler = handler
end

function NetworkService.setSnapshotProvider(self: NetworkService, provider: (Player) -> any)
    self._snapshotProvider = provider
end

function NetworkService.send(self: NetworkService, player: Player, snapshot: any)
    local stateChanged = self._stateChanged
    if stateChanged ~= nil and player.Parent ~= nil then
        self._snapshotCache[player] = {
            at = os.clock(),
            value = snapshot,
        }
        stateChanged:FireClient(player, snapshot)
    end
end

function NetworkService.broadcast(self: NetworkService, snapshotProvider: (Player) -> any)
    for _, player in Players:GetPlayers() do
        self:send(player, snapshotProvider(player))
    end
end

function NetworkService.setWorldReady(self: NetworkService, ready: boolean)
    local folder = self._folder
    if folder ~= nil then
        folder:SetAttribute("WorldReady", ready)
    end
end

function NetworkService.isWorldReady(self: NetworkService): boolean
    local folder = self._folder
    return folder ~= nil and folder:GetAttribute("WorldReady") == true
end

function NetworkService.folder(self: NetworkService): Folder
    return assert(self._folder, "network service has not initialized")
end

return table.freeze(NetworkService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">OldGrowthService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local OldGrowthService = {}
OldGrowthService.__index = OldGrowthService
OldGrowthService.Name = "OldGrowthService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type AttackVisual = {
    label: TextLabel,
    marker: Part,
}

type Attack = {
    areaCFrame: CFrame,
    definition: any,
    flow: any,
    target: Player,
    visual: AttackVisual,
}

export type OldGrowthService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _expeditionService: any,
        _survivalService: any,
        _combatService: any,
        _professionService: any,
        _encounter: any,
        _enemyAttackFlow: any,
        _enemyCombatRules: any,
        _builder: any,
        _analyticsService: any,
        _featureFlags: any,
        _state: any,
        _arena: any,
        _model: Model?,
        _attack: Attack?,
        _attackIndex: number,
        _lastAttackAt: number,
        _markedUntil: number,
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
        _activationGate: (() -> boolean)?,
    },
    OldGrowthService
))

local ACTIVATION_RADIUS = 28
local ENCOUNTER_RADIUS = 58
local STRIKE_RANGE = 14

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function weakPoint(model: Model): BasePart?
    local heart = model:FindFirstChild("AmberHeart")
    return if heart ~= nil
            and heart:IsA("BasePart")
            and heart:GetAttribute("WeakPoint") == true
        then heart
        else nil
end

function OldGrowthService.new(
    logger: Logger,
    worldService: any,
    expeditionService: any,
    survivalService: any,
    combatService: any,
    professionService: any,
    encounter: any,
    enemyAttackFlow: any,
    enemyCombatRules: any,
    builder: any,
    analyticsService: any,
    featureFlags: any
): OldGrowthService
    return setmetatable({
        Name = OldGrowthService.Name,
        _logger = logger,
        _worldService = worldService,
        _expeditionService = expeditionService,
        _survivalService = survivalService,
        _combatService = combatService,
        _professionService = professionService,
        _encounter = encounter,
        _enemyAttackFlow = enemyAttackFlow,
        _enemyCombatRules = enemyCombatRules,
        _builder = builder,
        _analyticsService = analyticsService,
        _featureFlags = featureFlags,
        _state = nil,
        _arena = nil,
        _model = nil,
        _attack = nil,
        _attackIndex = 0,
        _lastAttackAt = 0,
        _markedUntil = 0,
        _onChanged = nil,
        _heartbeat = nil,
        _activationGate = nil,
    }, OldGrowthService)
end

function OldGrowthService.setActivationGate(self: OldGrowthService, gate: (() -> boolean)?)
    self._activationGate = gate
end

function OldGrowthService.Init(self: OldGrowthService, _context: any)
    local manifest = assert(self._expeditionService:manifest(), "expedition manifest unavailable")
    self._arena = assert(self._worldService:oldGrowthArena(), "Old Growth arena unavailable")
    self._state = self._encounter.create(
        self._expeditionService:runId(),
        manifest.hash,
        self._featureFlags:isEnabled("old_growth_elite_enabled")
    )
    self._worldService:setOldGrowthPresentation(self._state.status)
end

function OldGrowthService.Start(self: OldGrowthService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.05 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
    self._logger:info("old_growth_ready", {
        enabled = self._state.status ~= "disabled",
        elite = self._encounter.Id,
        manifest = self._state.manifestHash,
    })
end

function OldGrowthService.setChangedHandler(self: OldGrowthService, callback: (string?) -> ())
    self._onChanged = callback
end

function OldGrowthService._notify(self: OldGrowthService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function OldGrowthService._inArena(self: OldGrowthService, player: Player, radius: number): boolean
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return false
    end
    local root = rootPart(player)
    return root ~= nil and (root.Position - self._arena.center).Magnitude <= radius
end

function OldGrowthService._spawnModel(self: OldGrowthService, target: Player)
    if self._model ~= nil and self._model.Parent ~= nil then
        return
    end
    local targetRoot = rootPart(target)
    local lookAt = if targetRoot == nil
        then self._arena.center + Vector3.new(0, 0, -10)
        else targetRoot.Position
    local model = self._builder.build(self._arena.center, lookAt, self._encounter.MaxHealth)
    model.Parent =
        assert(self._arena.fireSource.Parent, "Old Growth arena lost its streamed module")
    self._model = model
    self._builder.setState(model, self._state.health, false, false)
end

function OldGrowthService._clearAttack(self: OldGrowthService)
    local attack = self._attack
    if attack == nil then
        return
    end
    if attack.visual.marker.Parent ~= nil then
        attack.visual.marker:Destroy()
    end
    self._attack = nil
end

function OldGrowthService._groundPosition(self: OldGrowthService, targetRoot: BasePart): Vector3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { targetRoot.Parent :: Model }
    if self._model ~= nil then
        table.insert(excluded, self._model)
    end
    params.FilterDescendantsInstances = excluded
    local result = workspace:Raycast(
        targetRoot.Position + Vector3.new(0, 3, 0),
        Vector3.new(0, -18, 0),
        params
    )
    return if result == nil
        then targetRoot.Position - Vector3.new(0, 2.8, 0)
        else result.Position + Vector3.new(0, 0.14, 0)
end

function OldGrowthService._attackArea(
    self: OldGrowthService,
    definition: any,
    targetRoot: BasePart
): CFrame
    local ground = self:_groundPosition(targetRoot)
    if definition.shape == "circle" or self._model == nil or self._model.PrimaryPart == nil then
        return CFrame.new(ground)
    end
    local origin = self._model.PrimaryPart.Position
    local direction =
        Vector3.new(targetRoot.Position.X - origin.X, 0, targetRoot.Position.Z - origin.Z)
    if direction.Magnitude < 0.01 then
        direction = Vector3.new(0, 0, -1)
    end
    direction = direction.Unit
    local center = Vector3.new(origin.X, ground.Y, origin.Z) + direction * definition.length * 0.5
    return CFrame.lookAt(center, center + direction)
end

function OldGrowthService._createAttackVisual(
    _self: OldGrowthService,
    definition: any,
    areaCFrame: CFrame
): AttackVisual
    local marker = Instance.new("Part")
    marker.Name = "OldGrowthAttackWarning"
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.CastShadow = false
    marker.Color = if definition.shape == "lane"
        then Color3.fromRGB(101, 187, 112)
        else Color3.fromRGB(255, 148, 82)
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.5
    if definition.shape == "lane" then
        marker.Size = Vector3.new(definition.width, 0.2, definition.length)
        marker.CFrame = areaCFrame
    else
        marker.Shape = Enum.PartType.Cylinder
        marker.Size = Vector3.new(0.2, definition.radius * 2, definition.radius * 2)
        marker.CFrame = areaCFrame * CFrame.Angles(0, 0, math.rad(90))
    end
    marker.Parent = workspace

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "OldGrowthAttackLabel"
    billboard.Adornee = marker
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 120
    billboard.Size = UDim2.fromOffset(270, 68)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.4, 0)
    billboard.Parent = marker

    local label = Instance.new("TextLabel")
    label.Name = "Warning"
    label.BackgroundColor3 = Color3.fromRGB(26, 38, 29)
    label.BackgroundTransparency = 0.08
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = definition.attackName .. "\n" .. definition.instruction
    label.TextColor3 = Color3.fromRGB(248, 233, 198)
    label.TextScaled = true
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local stroke = Instance.new("UIStroke")
    stroke.Color = marker.Color
    stroke.Thickness = 2
    stroke.Transparency = 0.08
    stroke.Parent = label
    return {
        label = label,
        marker = marker,
    }
end

function OldGrowthService._startAttack(self: OldGrowthService, target: Player, now: number)
    local targetRoot = rootPart(target)
    if targetRoot == nil then
        return
    end
    self._attackIndex += 1
    local definition = self._encounter.attack(self._attackIndex, self._state.shieldIndex)
    local areaCFrame = self:_attackArea(definition, targetRoot)
    self._attack = {
        areaCFrame = areaCFrame,
        definition = definition,
        flow = self._enemyAttackFlow.create(target.UserId, now, definition.windup),
        target = target,
        visual = self:_createAttackVisual(definition, areaCFrame),
    }
    self._lastAttackAt = now
    self._analyticsService:eliteAttackTelegraphed(
        target,
        self._encounter.Id,
        definition.attackId,
        definition.shape,
        definition.windup
    )
    self:_notify(nil)
end

function OldGrowthService._clearPath(self: OldGrowthService, target: Player): boolean
    local model = self._model
    local root = rootPart(target)
    local character = target.Character
    if model == nil or model.PrimaryPart == nil or root == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { model }
    local result = workspace:Raycast(
        model.PrimaryPart.Position,
        root.Position - model.PrimaryPart.Position,
        params
    )
    return result == nil or result.Instance:IsDescendantOf(character)
end

function OldGrowthService._insideAttack(
    self: OldGrowthService,
    attack: Attack,
    targetRoot: BasePart
): boolean
    local localPosition = attack.areaCFrame:PointToObjectSpace(targetRoot.Position)
    return self._enemyCombatRules.contains(
        attack.definition.shape,
        localPosition.X,
        localPosition.Z,
        attack.definition.radius,
        attack.definition.width,
        attack.definition.length
    )
end

function OldGrowthService._stepAttack(self: OldGrowthService, now: number)
    local attack = self._attack
    if attack == nil then
        return
    end
    local targetRoot = rootPart(attack.target)
    local resolving = now >= attack.flow.endsAt
    local decision = self._enemyAttackFlow.evaluate(attack.flow, now, {
        clearPath = not resolving or self:_clearPath(attack.target),
        inImpactArea = not resolving
            or (targetRoot ~= nil and self:_insideAttack(attack, targetRoot)),
        targetCanAct = self._survivalService:canAct(attack.target),
        targetPresent = attack.target.Parent ~= nil and attack.target:GetAttribute(
            "LastLightInExpedition"
        ) == true and targetRoot ~= nil,
    })
    if decision.status == "pending" then
        attack.visual.label.Text = string.format(
            "%s\n%s · %.1fs",
            attack.definition.attackName,
            attack.definition.instruction,
            math.max(0, decision.remaining or 0)
        )
        return
    end

    local target = attack.target
    local definition = attack.definition
    self:_clearAttack()
    if decision.status == "cancel" or decision.status == "miss" then
        self._analyticsService:eliteAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            decision.reason or decision.status
        )
        self:_notify(nil)
        return
    end
    if self._combatService:avoidsDamage(target, now) then
        self._analyticsService:eliteAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            "dodged"
        )
        self:_notify(nil)
        return
    end

    local damage, guarded =
        self._professionService:mitigateIncomingDamage(target, definition.damage, now)
    damage = self._combatService:mitigateShieldedDamage(target, damage, now)
    local result = self._survivalService:damage(target, damage, self._encounter.Id)
    if result.applied and definition.attackId == "old_growth_root_lane" then
        self._combatService:applyRooted(
            target,
            definition.rootedDuration,
            definition.rootedMultiplier
        )
    end
    self._analyticsService:eliteAttackResult(
        target,
        self._encounter.Id,
        definition.attackId,
        if result.applied then (if guarded then "guarded_hit" else "hit") else "blocked"
    )
    if result.downed then
        self:_notify("ALLY DOWN — " .. definition.attackName)
    elseif guarded and result.applied then
        self:_notify("LANTERN GUARD ABSORBS " .. definition.attackName)
    else
        self:_notify(nil)
    end
end

function OldGrowthService._syncCarrierVisuals(self: OldGrowthService, now: number)
    for _, player in Players:GetPlayers() do
        local snapshot = self._encounter.snapshot(self._state, player.UserId, now)
        player:SetAttribute("LastLightCarryingOldGrowthFire", snapshot.carryingFire)
        player:SetAttribute("LastLightOldGrowthFireExpiresAt", snapshot.fireExpiresAt)
        local root = rootPart(player)
        if root ~= nil then
            local light = root:FindFirstChild("OldGrowthCarryLight")
            if snapshot.carryingFire and light == nil then
                local pointLight = Instance.new("PointLight")
                pointLight.Name = "OldGrowthCarryLight"
                pointLight.Color = Color3.fromRGB(255, 181, 76)
                pointLight.Brightness = 2.2
                pointLight.Range = 18
                pointLight.Shadows = false
                pointLight.Parent = root
            elseif not snapshot.carryingFire and light ~= nil then
                light:Destroy()
            end
        end
    end
end

function OldGrowthService._playersInArena(self: OldGrowthService): { Player }
    local players = {}
    for _, player in Players:GetPlayers() do
        if self:_inArena(player, ENCOUNTER_RADIUS) and self._survivalService:canAct(player) then
            table.insert(players, player)
        end
    end
    return players
end

function OldGrowthService._nearestPlayer(self: OldGrowthService, players: { Player }): Player?
    local anchor = self._arena.center
    if self._model ~= nil and self._model.PrimaryPart ~= nil then
        anchor = self._model.PrimaryPart.Position
    end
    local nearest: Player? = nil
    local nearestDistance = math.huge
    for _, player in players do
        local root = rootPart(player)
        if root ~= nil then
            local distance = (root.Position - anchor).Magnitude
            if distance < nearestDistance then
                nearest = player
                nearestDistance = distance
            end
        end
    end
    return nearest
end

function OldGrowthService._step(self: OldGrowthService, now: number)
    local previousRevision = self._state.revision
    self._state = self._encounter.expire(self._state, now)
    if self._state.revision ~= previousRevision then
        self:_syncCarrierVisuals(now)
        self:_notify("LANTERN FIRE FADED — TAKE ANOTHER FLAME")
    end

    if
        self._state.status == "dormant"
        and (self._activationGate == nil or (self._activationGate :: () -> boolean)())
    then
        for _, player in Players:GetPlayers() do
            if
                self:_inArena(player, ACTIVATION_RADIUS) and self._survivalService:canAct(player)
            then
                local nextState, result = self._encounter.activate(self._state, player.UserId)
                if result.accepted then
                    self._state = nextState
                    self:_spawnModel(player)
                    self._lastAttackAt = now
                    self._worldService:setOldGrowthPresentation(self._state.status)
                    self._analyticsService:eliteStarted(
                        player,
                        self._encounter.Id,
                        self._state.manifestHash
                    )
                    self:_notify("OLD GROWTH AWAKENS — STRIKE THE AMBER HEART")
                end
                break
            end
        end
        return
    end
    if self._state.status ~= "vulnerable" and self._state.status ~= "shielded" then
        return
    end

    local players = self:_playersInArena()
    for _, player in players do
        self._state = self._encounter.join(self._state, player.UserId)
    end
    if self._model == nil or self._model.Parent == nil then
        local target = self:_nearestPlayer(players)
        if target ~= nil then
            self:_spawnModel(target)
        end
    end
    if self._markedUntil > 0 and now >= self._markedUntil then
        self._markedUntil = 0
        if self._model ~= nil then
            self._builder.setState(
                self._model,
                self._state.health,
                self._state.status == "shielded",
                false
            )
        end
        self:_notify(nil)
    end
    if self._attack ~= nil then
        self:_stepAttack(now)
        return
    end
    local target = self:_nearestPlayer(players)
    if target == nil then
        return
    end
    local tuning = self._encounter.Tuning
    local cooldown = if self._state.status == "shielded"
        then tuning.shieldedAttackCooldownSeconds
        else tuning.attackCooldownSeconds
    if now < self._markedUntil then
        cooldown *= tuning.markedAttackCooldownMultiplier
    end
    if now - self._lastAttackAt >= cooldown then
        self:_startAttack(target, now)
    end
end

function OldGrowthService.interact(
    self: OldGrowthService,
    player: Player,
    prompt: ProximityPrompt
): any
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return {
            accepted = false,
            message = "ENTER THE OLD GROWTH ARENA WHILE ACTIVE",
            reason = "player_unavailable",
        }
    end
    local promptParent = prompt.Parent
    local interaction = if promptParent == nil
        then nil
        else promptParent:GetAttribute("EliteInteraction")
    local now = workspace:GetServerTimeNow()
    local nextState, result
    if interaction == "fire_source" then
        nextState, result = self._encounter.takeFire(self._state, player.UserId, now)
    elseif interaction == "root_heart" then
        nextState, result = self._encounter.burnHeart(self._state, player.UserId, now)
    else
        return {
            accepted = false,
            message = "THAT ELITE INTERACTION IS INVALID",
            reason = "invalid_interaction",
        }
    end
    if not result.accepted then
        result.message = if result.reason == "fire_required"
            then "TAKE LANTERN FIRE BEFORE TOUCHING THE ROOT HEART"
            elseif result.reason == "fire_claimed" then "AN ALLY ALREADY CARRIES THE FIRE"
            else "THE ROOT SHIELD IS NOT CALLING FOR FIRE"
        return result
    end

    self._state = nextState
    self._worldService:setOldGrowthPresentation(self._state.status)
    self:_syncCarrierVisuals(now)
    if result.reason == "fire_taken" then
        result.message = "LANTERN FIRE HELD — REACH THE ROOT HEART"
        self:_notify(result.message)
    else
        result.message = "ROOT SHIELD BURNED — AMBER HEART EXPOSED"
        if self._model ~= nil then
            self._builder.setState(self._model, self._state.health, false, now < self._markedUntil)
        end
        self._analyticsService:elitePhase(
            player,
            self._encounter.Id,
            self._state.shieldIndex + 1,
            "shield_burned"
        )
        self:_notify(result.message)
    end
    return result
end

function OldGrowthService._lineOfSight(
    _self: OldGrowthService,
    player: Player,
    model: Model
): boolean
    local root = rootPart(player)
    local heart = weakPoint(model)
    local character = player.Character
    if root == nil or heart == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    local result = workspace:Raycast(root.Position, heart.Position - root.Position, params)
    return result ~= nil and result.Instance == heart
end

function OldGrowthService.damageNearest(self: OldGrowthService, player: Player): (boolean, string)
    if self._state.status ~= "vulnerable" and self._state.status ~= "shielded" then
        return false, "No elite threat is active."
    end
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return false, "Enter the Old Growth arena to strike."
    end
    local model = self._model
    local root = rootPart(player)
    local heart = if model == nil then nil else weakPoint(model)
    if model == nil or root == nil or heart == nil then
        return false, "Old Growth is still taking shape."
    end
    if (root.Position - heart.Position).Magnitude > STRIKE_RANGE then
        return false, "Move closer to the amber heart."
    end
    if not self:_lineOfSight(player, model) then
        return false, "The amber heart is behind the trunk."
    end

    local tuning = self._encounter.Tuning
    local amount = if workspace:GetServerTimeNow() < self._markedUntil
        then tuning.markedStrikeDamage
        else tuning.strikeDamage
    local nextState, result = self._encounter.strike(self._state, player.UserId, amount)
    if not result.accepted then
        if result.reason == "shielded" then
            return false, "ROOT SHIELD — MOVE LANTERN FIRE TO THE HEART"
        end
        return false, "Old Growth cannot be struck right now."
    end
    self._state = nextState
    self._builder.setState(
        model,
        self._state.health,
        self._state.status == "shielded",
        workspace:GetServerTimeNow() < self._markedUntil
    )
    self._worldService:setOldGrowthPresentation(self._state.status)
    if result.completed then
        self:_clearAttack()
        for participantId in self._state.participants do
            local userId = tonumber(participantId)
            if userId ~= nil then
                self._expeditionService:grantEncounterReward(
                    userId,
                    self._encounter.Id,
                    self._encounter.rewardTransactionId(self._state, userId),
                    self._encounter.Reward
                )
            end
        end
        self:_syncCarrierVisuals(workspace:GetServerTimeNow())
        self._analyticsService:eliteCompleted(
            player,
            self._encounter.Id,
            self._state.manifestHash,
            self._state.shieldIndex,
            self:_participantCount()
        )
        self:_notify("OLD GROWTH CLEANSED — +3 AMBER SAP UNBANKED")
        return true, "Old Growth cleansed. Amber Sap added to the expedition pouch."
    end
    if result.shieldStarted then
        self._analyticsService:elitePhase(
            player,
            self._encounter.Id,
            self._state.shieldIndex,
            "shield_started"
        )
        self:_notify("ROOT SHIELD — TAKE LANTERN FIRE TO THE HEART")
        return true, "A root shield closes around the amber heart."
    end
    self:_notify(
        string.format("HIT — OLD GROWTH %d / %d", self._state.health, self._encounter.MaxHealth)
    )
    return true, "Your tool strikes the amber heart."
end

function OldGrowthService._participantCount(self: OldGrowthService): number
    local count = 0
    for _ in self._state.participants do
        count += 1
    end
    return count
end

function OldGrowthService.canMarkNearest(
    self: OldGrowthService,
    player: Player,
    range: number
): (boolean, string)
    local model = self._model
    local root = rootPart(player)
    if
        not self:combatActive()
        or model == nil
        or model.PrimaryPart == nil
        or root == nil
        or not self:_inArena(player, ENCOUNTER_RADIUS)
        or not self._survivalService:canAct(player)
    then
        return false, "NO ELITE THREAT CAN BE MARKED"
    end
    if (root.Position - model.PrimaryPart.Position).Magnitude > range then
        return false, "MOVE CLOSER TO MARK OLD GROWTH"
    end
    if not self:_lineOfSight(player, model) then
        return false, "OLD GROWTH IS HIDDEN BY THE TRUNK"
    end
    return true, "FOXFIRE MARK READY"
end

function OldGrowthService.markNearest(
    self: OldGrowthService,
    player: Player,
    range: number,
    duration: number
): (boolean, string)
    local allowed, reason = self:canMarkNearest(player, range)
    if not allowed then
        return false, reason
    end
    self._markedUntil = workspace:GetServerTimeNow() + duration
    if self._model ~= nil then
        self._builder.setState(
            self._model,
            self._state.health,
            self._state.status == "shielded",
            true
        )
    end
    local message = "FOXFIRE MARK — OLD GROWTH TELEGRAPHS SLOWED"
    self:_notify(message)
    return true, message
end

function OldGrowthService.threatSnapshot(self: OldGrowthService, viewer: Player): any
    local attack = self._attack
    if attack == nil or attack.target ~= viewer then
        return nil
    end
    return {
        attackId = attack.definition.attackId,
        displayName = attack.definition.attackName,
        enemyId = self._encounter.Id,
        enemyName = "OLD GROWTH",
        instruction = attack.definition.instruction,
        resolvesAt = attack.flow.endsAt,
        shape = attack.definition.shape,
    }
end

function OldGrowthService.snapshot(self: OldGrowthService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return nil
    end
    local snapshot =
        self._encounter.snapshot(self._state, player.UserId, workspace:GetServerTimeNow())
    if not self:_inArena(player, ENCOUNTER_RADIUS + 18) and not snapshot.carryingFire then
        return nil
    end
    return snapshot
end

function OldGrowthService.combatActive(self: OldGrowthService): boolean
    return self._state.status == "vulnerable" or self._state.status == "shielded"
end

function OldGrowthService.isComplete(self: OldGrowthService): boolean
    return self._state.status == "complete"
end

function OldGrowthService.enabled(self: OldGrowthService): boolean
    return self._state.status ~= "disabled"
end

return table.freeze(OldGrowthService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">PhaseService</string>
            <string name="Source"><![CDATA[--!strict

local PhaseService = {}
PhaseService.__index = PhaseService
PhaseService.Name = "PhaseService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type PhaseService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _enemyService: any,
        _nightSchedule: any,
        _duskSeconds: number,
        _nightSeconds: number,
        _phase: string,
        _phaseEndsAt: number,
        _active: boolean,
        _generation: number,
        _onChanged: ((string?) -> ())?,
        _onComplete: (() -> ())?,
    },
    PhaseService
))

function PhaseService.new(
    logger: Logger,
    worldService: any,
    enemyService: any,
    nightSchedule: any,
    duskSeconds: number,
    nightSeconds: number
): PhaseService
    return setmetatable({
        Name = PhaseService.Name,
        _logger = logger,
        _worldService = worldService,
        _enemyService = enemyService,
        _nightSchedule = nightSchedule,
        _duskSeconds = duskSeconds,
        _nightSeconds = nightSeconds,
        _phase = "day",
        _phaseEndsAt = 0,
        _active = false,
        _generation = 0,
        _onChanged = nil,
        _onComplete = nil,
    }, PhaseService)
end

function PhaseService.Init(_self: PhaseService, _context: any) end

function PhaseService.Start(_self: PhaseService) end

function PhaseService.setChangedHandler(self: PhaseService, callback: (string?) -> ())
    self._onChanged = callback
end

function PhaseService.setCompleteHandler(self: PhaseService, callback: () -> ())
    self._onComplete = callback
end

function PhaseService._notify(self: PhaseService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

local function waitUntil(target: number, generation: number, service: PhaseService): boolean
    while workspace:GetServerTimeNow() < target do
        if service._generation ~= generation or not service._active then
            return false
        end
        task.wait(0.15)
    end
    return service._generation == generation and service._active
end

function PhaseService.startFirstNight(self: PhaseService): boolean
    if self._active then
        return false
    end

    self._active = true
    self._generation += 1
    local generation = self._generation
    self._phase = "dusk"
    self._phaseEndsAt = workspace:GetServerTimeNow() + self._duskSeconds
    self._worldService:setDusk(true)
    self:_notify("DUSK FALLS — PREPARE THE LIGHT")
    self._logger:info("first_night_dusk_started", { duration = self._duskSeconds })

    task.spawn(function()
        if not waitUntil(self._phaseEndsAt, generation, self) then
            return
        end

        self._phase = "night"
        local nightStartedAt = workspace:GetServerTimeNow()
        self._phaseEndsAt = nightStartedAt + self._nightSeconds
        self._worldService:setNight(true)
        self._enemyService:startNight()
        self:_notify("NIGHT HAS ARRIVED")
        self._logger:info("first_night_started", { duration = self._nightSeconds })

        for _, beat in self._nightSchedule.beats(self._nightSeconds) do
            if not waitUntil(nightStartedAt + beat.at, generation, self) then
                return
            end
            if beat.kind == "spawn" then
                self._enemyService:spawn(beat.enemyId)
            elseif beat.kind == "breach" then
                self._enemyService:setBreach()
            elseif beat.kind == "warning" then
                self:_notify("THE FOREST GOES QUIET")
            end
        end

        if not waitUntil(self._phaseEndsAt, generation, self) then
            return
        end
        self:_finishFirstNight()
    end)

    return true
end

function PhaseService.ensureFirstNight(self: PhaseService)
    if not self._active and self._phase ~= "reveal" then
        self:startFirstNight()
    end
end

function PhaseService._finishFirstNight(self: PhaseService)
    self._active = false
    self._phase = "reveal"
    self._phaseEndsAt = 0
    self._enemyService:stopNight()
    self._worldService:setNight(false)
    self._worldService:setBeaconVisible(true)
    self:_notify("DAWN BREAKS — A MEMORY CALLS")
    self._logger:info("first_night_completed")

    local callback = self._onComplete
    if callback ~= nil then
        callback()
    end
end

function PhaseService.snapshot(self: PhaseService): any
    return {
        phase = self._phase,
        phaseEndsAt = self._phaseEndsAt,
        nightActive = self._active and self._phase == "night",
        lanternHealth = self._enemyService:lanternHealth(),
        enemyCount = self._enemyService:activeCount(),
    }
end

function PhaseService.isNightActive(self: PhaseService): boolean
    return self._active and self._phase == "night"
end

function PhaseService.hasCompletedFirstNight(self: PhaseService): boolean
    return self._phase == "reveal"
end

return table.freeze(PhaseService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">PlayerCombatService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PlayerCombatService = {}
PlayerCombatService.__index = PlayerCombatService
PlayerCombatService.Name = "PlayerCombatService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type PlayerCombatService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _combatState: any,
        _statusEffectState: any,
        _featureFlags: any,
        _survivalService: any,
        _analyticsService: any,
        _states: { [Player]: any },
        _statusStates: { [Player]: any },
        _lastPublishedStamina: { [Player]: number },
        _lastPublishedDrowsy: { [Player]: boolean },
        _lastPublishedRooted: { [Player]: boolean },
        _lastRejectionAt: { [Player]: number },
        _nextPublishAt: { [Player]: number },
        _onChanged: ((Player, string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
    },
    PlayerCombatService
))

local function humanoid(player: Player): Humanoid?
    local character = player.Character
    return if character == nil then nil else character:FindFirstChildOfClass("Humanoid")
end

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

function PlayerCombatService.new(
    logger: Logger,
    config: any,
    combatState: any,
    statusEffectState: any,
    featureFlags: any,
    survivalService: any,
    analyticsService: any
): PlayerCombatService
    return setmetatable({
        Name = PlayerCombatService.Name,
        _logger = logger,
        _config = config,
        _combatState = combatState,
        _statusEffectState = statusEffectState,
        _featureFlags = featureFlags,
        _survivalService = survivalService,
        _analyticsService = analyticsService,
        _states = {},
        _statusStates = {},
        _lastPublishedStamina = {},
        _lastPublishedDrowsy = {},
        _lastPublishedRooted = {},
        _lastRejectionAt = {},
        _nextPublishAt = {},
        _onChanged = nil,
        _heartbeat = nil,
    }, PlayerCombatService)
end

function PlayerCombatService.Init(_self: PlayerCombatService, _context: any) end

function PlayerCombatService.setChangedHandler(
    self: PlayerCombatService,
    callback: (Player, string?) -> ()
)
    self._onChanged = callback
end

function PlayerCombatService._notify(self: PlayerCombatService, player: Player, message: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(player, message)
    end
end

function PlayerCombatService._syncPlayer(self: PlayerCombatService, player: Player)
    local state = self._states[player]
    if state == nil then
        return
    end
    local now = workspace:GetServerTimeNow()
    local snapshot = self._combatState.snapshot(state, now)
    local statusState = self._statusStates[player] or self._statusEffectState.create()
    local status = self._statusEffectState.snapshot(statusState, now)
    local dodgeActive = self._featureFlags:isEnabled("combat_mobility_enabled")
        and snapshot.dodgeActive
    player:SetAttribute("LastLightStamina", snapshot.stamina)
    player:SetAttribute("LastLightMaxStamina", snapshot.maxStamina)
    player:SetAttribute("LastLightSprinting", snapshot.sprinting)
    player:SetAttribute("LastLightDodging", dodgeActive)
    player:SetAttribute("LastLightDodgeActiveUntil", snapshot.dodgeActiveUntil)
    player:SetAttribute("LastLightDodgeReadyAt", snapshot.dodgeReadyAt)
    player:SetAttribute("LastLightDrowsy", status.drowsy)
    player:SetAttribute("LastLightDrowsyUntil", status.drowsyUntil)
    player:SetAttribute("LastLightRooted", status.rooted)
    player:SetAttribute("LastLightRootedUntil", status.rootedUntil)
    player:SetAttribute("LastLightShielded", status.shielded)
    player:SetAttribute("LastLightShieldUntil", status.shieldUntil)

    local activeHumanoid = humanoid(player)
    if activeHumanoid ~= nil then
        activeHumanoid.WalkSpeed = if not self._survivalService:canAct(player)
            then self._config.DownedWalkSpeed
            elseif snapshot.sprinting then self._config.SprintWalkSpeed * status.movementMultiplier
            else self._config.BaseWalkSpeed * status.movementMultiplier
    end
end

function PlayerCombatService._markPublished(self: PlayerCombatService, player: Player, now: number)
    local state = self._states[player]
    if state == nil then
        return
    end
    local snapshot = self._combatState.snapshot(state, now)
    self._lastPublishedStamina[player] = snapshot.stamina
    self._nextPublishAt[player] = now + 0.25
end

function PlayerCombatService._bindPlayer(self: PlayerCombatService, player: Player)
    if self._states[player] ~= nil then
        return
    end
    local now = workspace:GetServerTimeNow()
    self._states[player] = self._combatState.create(now)
    self._statusStates[player] = self._statusEffectState.create()
    self._lastPublishedStamina[player] = self._config.MaxStamina
    self._lastPublishedDrowsy[player] = false
    self._lastPublishedRooted[player] = false
    self._nextPublishAt[player] = now

    player.CharacterAdded:Connect(function(character: Model)
        local resetAt = workspace:GetServerTimeNow()
        self._states[player] = self._combatState.create(resetAt)
        self._statusStates[player] = self._statusEffectState.create()
        self._lastPublishedStamina[player] = self._config.MaxStamina
        self._lastPublishedDrowsy[player] = false
        self._lastPublishedRooted[player] = false
        self._nextPublishAt[player] = resetAt
        task.spawn(function()
            local activeHumanoid = character:WaitForChild("Humanoid", 8)
            if
                activeHumanoid ~= nil
                and activeHumanoid:IsA("Humanoid")
                and player.Parent ~= nil
            then
                self:_syncPlayer(player)
                self:_notify(player, nil)
            end
        end)
    end)
    self:_syncPlayer(player)
end

function PlayerCombatService.Start(self: PlayerCombatService)
    Players.PlayerAdded:Connect(function(player: Player)
        self:_bindPlayer(player)
    end)
    Players.PlayerRemoving:Connect(function(player: Player)
        self._states[player] = nil
        self._statusStates[player] = nil
        self._lastPublishedStamina[player] = nil
        self._lastPublishedDrowsy[player] = nil
        self._lastPublishedRooted[player] = nil
        self._lastRejectionAt[player] = nil
        self._nextPublishAt[player] = nil
    end)
    for _, player in Players:GetPlayers() do
        self:_bindPlayer(player)
    end

    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.1 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
end

function PlayerCombatService._step(self: PlayerCombatService, now: number)
    local enabled = self._featureFlags:isEnabled("combat_mobility_enabled")
    for player, state in self._states do
        local nextState =
            self._combatState.advance(state, now, enabled and self._survivalService:canAct(player))
        self._states[player] = nextState

        local snapshot = self._combatState.snapshot(nextState, now)
        local statusState = self._statusStates[player] or self._statusEffectState.create()
        local status = self._statusEffectState.snapshot(statusState, now)
        local lastStamina = self._lastPublishedStamina[player]
        local nextPublishAt = self._nextPublishAt[player] or now
        local resourcePublish = lastStamina ~= snapshot.stamina and now >= nextPublishAt
        local sprintChanged = state.sprinting ~= nextState.sprinting
        local dodgeChanged = player:GetAttribute("LastLightDodging")
            ~= (enabled and snapshot.dodgeActive)
        local drowsyChanged = self._lastPublishedDrowsy[player] ~= status.drowsy
        local rootedChanged = self._lastPublishedRooted[player] ~= status.rooted
        if resourcePublish or sprintChanged or dodgeChanged or drowsyChanged or rootedChanged then
            self:_syncPlayer(player)
        end
        if drowsyChanged then
            self._lastPublishedDrowsy[player] = status.drowsy
            self:_notify(
                player,
                if status.drowsy then "DROWSY — KEEP MOVING" else "DROWSINESS CLEARED"
            )
        end
        if rootedChanged then
            self._lastPublishedRooted[player] = status.rooted
            self:_notify(
                player,
                if status.rooted then "ROOTED — KEEP MOVING" else "ROOTS RELEASED"
            )
        end
        if resourcePublish then
            self:_markPublished(player, now)
            self:_notify(player, nil)
        end
    end
end

function PlayerCombatService.applyRooted(
    self: PlayerCombatService,
    player: Player,
    duration: number,
    multiplier: number
): boolean
    local state = self._states[player]
    local statusState = self._statusStates[player]
    if state == nil or statusState == nil or not self._survivalService:canAct(player) then
        return false
    end
    local now = workspace:GetServerTimeNow()
    local nextState, _result = self._combatState.setSprint(state, false, now, true)
    self._states[player] = nextState
    self._statusStates[player] =
        self._statusEffectState.applyRooted(statusState, now, duration, multiplier)
    self._lastPublishedRooted[player] = true
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    self:_notify(player, "ROOTED — MOVEMENT SLOWED")
    return true
end

function PlayerCombatService.applyDrowsy(
    self: PlayerCombatService,
    player: Player,
    duration: number,
    multiplier: number
): boolean
    local state = self._states[player]
    local statusState = self._statusStates[player]
    if state == nil or statusState == nil or not self._survivalService:canAct(player) then
        return false
    end
    local now = workspace:GetServerTimeNow()
    local nextState, _result = self._combatState.setSprint(state, false, now, true)
    self._states[player] = nextState
    self._statusStates[player] =
        self._statusEffectState.applyDrowsy(statusState, now, duration, multiplier)
    self._lastPublishedDrowsy[player] = true
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    self:_notify(player, "DROWSY — MOVEMENT SLOWED")
    return true
end

function PlayerCombatService.applyShield(
    self: PlayerCombatService,
    player: Player,
    duration: number,
    multiplier: number
): boolean
    local statusState = self._statusStates[player]
    if statusState == nil or not self._survivalService:canAct(player) then
        return false
    end
    local now = workspace:GetServerTimeNow()
    self._statusStates[player] =
        self._statusEffectState.applyShield(statusState, now, duration, multiplier)
    self:_syncPlayer(player)
    return true
end

-- snapshot() reads the stored stamina as of the last periodic advance (up
-- to ~0.1s stale, see PlayerCombatService._step), while restoreStamina
-- advances fresh before mutating. A caller that gates on snapshot()'s
-- value and only later calls restoreStamina can see stamina go from
-- "not full" to "full" in that gap — this advances (without persisting)
-- so a precondition check sees exactly what restoreStamina is about to see.
function PlayerCombatService.peekStamina(self: PlayerCombatService, player: Player): number?
    local state = self._states[player]
    if state == nil then
        return nil
    end
    local now = workspace:GetServerTimeNow()
    local advanced = self._combatState.advance(state, now, self._survivalService:canAct(player))
    return self._combatState.snapshot(advanced, now).stamina
end

function PlayerCombatService.restoreStamina(
    self: PlayerCombatService,
    player: Player,
    amount: number
): any
    local state = self._states[player]
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    local now = workspace:GetServerTimeNow()
    local nextState, result =
        self._combatState.restoreStamina(state, now, amount, self._survivalService:canAct(player))
    self._states[player] = nextState
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    if result.applied then
        self:_notify(player, nil)
    end
    return result
end

-- Independent of ProfessionService.mitigateIncomingDamage (Warden's guard):
-- the two are checked separately at each damage call site so an item-granted
-- shield stacks with a profession's own mitigation instead of overriding it.
function PlayerCombatService.mitigateShieldedDamage(
    self: PlayerCombatService,
    player: Player,
    amount: number,
    now: number
): (number, boolean)
    local statusState = self._statusStates[player]
    if statusState == nil then
        return amount, false
    end
    local status = self._statusEffectState.snapshot(statusState, now)
    if not status.shielded then
        return amount, false
    end
    return math.max(1, math.ceil(amount * status.damageMultiplier)), true
end

function PlayerCombatService.setSprint(
    self: PlayerCombatService,
    player: Player,
    enabled: boolean
): any
    if not self._featureFlags:isEnabled("combat_mobility_enabled") then
        return {
            applied = false,
            reason = "combat_mobility_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    local now = workspace:GetServerTimeNow()
    local nextState, result =
        self._combatState.setSprint(state, enabled, now, self._survivalService:canAct(player))
    self._states[player] = nextState
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    self._analyticsService:combatAction(
        player,
        "sprint",
        result.applied,
        result.reason,
        result.stamina
    )
    if result.applied then
        self:_notify(player, nil)
    elseif enabled and result.reason == "insufficient_stamina" then
        self:_notify(player, "STAMINA LOW — RELEASE RUN TO RECOVER")
    end
    return result
end

function PlayerCombatService.dodge(self: PlayerCombatService, player: Player): any
    if not self._featureFlags:isEnabled("combat_mobility_enabled") then
        return {
            applied = false,
            reason = "combat_mobility_disabled",
        }
    end
    local state = self._states[player]
    local activeHumanoid = humanoid(player)
    local root = rootPart(player)
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    if activeHumanoid == nil or root == nil or activeHumanoid.Health <= 0 then
        return {
            applied = false,
            reason = "character_unavailable",
        }
    end

    local now = workspace:GetServerTimeNow()
    local nextState, result =
        self._combatState.dodge(state, now, self._survivalService:canAct(player))
    self._states[player] = nextState
    if result.applied then
        local direction = activeHumanoid.MoveDirection
        if direction.Magnitude < 0.1 then
            direction = root.CFrame.LookVector
        end
        direction = Vector3.new(direction.X, 0, direction.Z)
        if direction.Magnitude > 0.01 then
            direction = direction.Unit
            local velocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(
                direction.X * self._config.DodgeSpeed,
                velocity.Y,
                direction.Z * self._config.DodgeSpeed
            )
        end
    end
    self:_syncPlayer(player)
    self:_markPublished(player, now)
    local reportResult = result.applied
        or now - (self._lastRejectionAt[player] or -math.huge) >= 0.75
    if reportResult then
        self._analyticsService:combatAction(
            player,
            "dodge",
            result.applied,
            result.reason,
            result.stamina
        )
    end
    if result.applied then
        self:_notify(player, nil)
    elseif reportResult then
        self._lastRejectionAt[player] = now
        if result.reason == "insufficient_stamina" then
            self:_notify(player, "STAMINA LOW — DODGE NEEDS 35")
        elseif result.reason == "dodge_cooldown" then
            self:_notify(player, "DODGE RECHARGING")
        end
    end
    return result
end

function PlayerCombatService.avoidsDamage(
    self: PlayerCombatService,
    player: Player,
    now: number
): boolean
    local state = self._states[player]
    return self._featureFlags:isEnabled("combat_mobility_enabled")
        and state ~= nil
        and self._combatState.avoidsDamage(state, now)
end

function PlayerCombatService.snapshot(self: PlayerCombatService, player: Player): any
    local now = workspace:GetServerTimeNow()
    local state = self._states[player]
    local snapshot = if state == nil
        then self._combatState.snapshot(self._combatState.create(now), now)
        else self._combatState.snapshot(state, now)
    local statusState = self._statusStates[player] or self._statusEffectState.create()
    local status = self._statusEffectState.snapshot(statusState, now)
    snapshot.enabled = self._featureFlags:isEnabled("combat_mobility_enabled")
    if not snapshot.enabled then
        snapshot.dodgeActive = false
    end
    snapshot.drowsy = status.drowsy
    snapshot.drowsyUntil = status.drowsyUntil
    snapshot.rooted = status.rooted
    snapshot.rootedUntil = status.rootedUntil
    snapshot.movementMultiplier = status.movementMultiplier
    snapshot.shielded = status.shielded
    snapshot.shieldUntil = status.shieldUntil
    return snapshot
end

return table.freeze(PlayerCombatService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">PlayerSurvivalService</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PlayerSurvivalService = {}
PlayerSurvivalService.__index = PlayerSurvivalService
PlayerSurvivalService.Name = "PlayerSurvivalService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type ReviveChannel = {
    target: Player,
    reviver: Player,
    flow: any,
}

type DownedVisual = {
    character: Model,
    highlight: Highlight,
    interactionId: string,
    label: TextLabel,
    prompt: ProximityPrompt,
}

export type PlayerSurvivalService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _runtimeIds: any,
        _reviveFlow: any,
        _survivalState: any,
        _featureFlags: any,
        _worldService: any,
        _analyticsService: any,
        _states: { [Player]: any },
        _spawned: { [Player]: boolean },
        _channels: { [Player]: ReviveChannel },
        _prompts: { [string]: ProximityPrompt },
        _targets: { [string]: Player },
        _visuals: { [Player]: DownedVisual },
        _onChanged: ((Player?, string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
    },
    PlayerSurvivalService
))

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function humanoid(player: Player): Humanoid?
    local character = player.Character
    return if character == nil then nil else character:FindFirstChildOfClass("Humanoid")
end

local function playerLabel(player: Player): string
    return string.sub(player.DisplayName, 1, 20)
end

function PlayerSurvivalService.new(
    logger: Logger,
    config: any,
    runtimeIds: any,
    reviveFlow: any,
    survivalState: any,
    featureFlags: any,
    worldService: any,
    analyticsService: any
): PlayerSurvivalService
    return setmetatable({
        Name = PlayerSurvivalService.Name,
        _logger = logger,
        _config = config,
        _runtimeIds = runtimeIds,
        _reviveFlow = reviveFlow,
        _survivalState = survivalState,
        _featureFlags = featureFlags,
        _worldService = worldService,
        _analyticsService = analyticsService,
        _states = {},
        _spawned = {},
        _channels = {},
        _prompts = {},
        _targets = {},
        _visuals = {},
        _onChanged = nil,
        _heartbeat = nil,
    }, PlayerSurvivalService)
end

function PlayerSurvivalService.Init(_self: PlayerSurvivalService, _context: any) end

function PlayerSurvivalService.setChangedHandler(
    self: PlayerSurvivalService,
    callback: (Player?, string?) -> ()
)
    self._onChanged = callback
end

function PlayerSurvivalService._notify(
    self: PlayerSurvivalService,
    player: Player?,
    message: string?
)
    local callback = self._onChanged
    if callback ~= nil then
        callback(player, message)
    end
end

function PlayerSurvivalService._syncPlayer(self: PlayerSurvivalService, player: Player)
    local state = self._states[player]
    if state == nil then
        return
    end
    local snapshot = self._survivalState.snapshot(state, workspace:GetServerTimeNow())
    player:SetAttribute("LastLightHealth", snapshot.health)
    player:SetAttribute("LastLightMaxHealth", snapshot.maxHealth)
    player:SetAttribute("LastLightDowned", snapshot.downed)
    player:SetAttribute("LastLightBleedoutAt", snapshot.bleedoutAt)

    local activeHumanoid = humanoid(player)
    if activeHumanoid ~= nil then
        activeHumanoid.MaxHealth = snapshot.maxHealth
        activeHumanoid.Health = math.max(1, snapshot.health)
        activeHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        activeHumanoid.WalkSpeed = if snapshot.downed
            then self._config.DownedWalkSpeed
            else self._config.BaseWalkSpeed
        activeHumanoid.JumpHeight = if snapshot.downed then 0 else self._config.BaseJumpHeight
        activeHumanoid.JumpPower = if snapshot.downed then 0 else self._config.BaseJumpPower
    end
end

function PlayerSurvivalService._clearVisual(self: PlayerSurvivalService, player: Player)
    local visual = self._visuals[player]
    if visual == nil then
        local character = player.Character
        if
            character ~= nil
            and CollectionService:HasTag(character, self._runtimeIds.PlayerDownedTag)
        then
            CollectionService:RemoveTag(character, self._runtimeIds.PlayerDownedTag)
        end
        return
    end
    self._prompts[visual.interactionId] = nil
    self._targets[visual.interactionId] = nil
    if visual.prompt.Parent ~= nil then
        visual.prompt:Destroy()
    end
    if visual.highlight.Parent ~= nil then
        visual.highlight:Destroy()
    end
    if CollectionService:HasTag(visual.character, self._runtimeIds.PlayerDownedTag) then
        CollectionService:RemoveTag(visual.character, self._runtimeIds.PlayerDownedTag)
    end
    self._visuals[player] = nil
    player:SetAttribute("LastLightReviveEndsAt", nil)
    player:SetAttribute("LastLightReviverUserId", nil)
end

function PlayerSurvivalService._createVisual(self: PlayerSurvivalService, player: Player)
    self:_clearVisual(player)
    local targetRoot = rootPart(player)
    local character = player.Character
    local state = self._states[player]
    if targetRoot == nil or character == nil or state == nil then
        return
    end

    local interactionId = string.format("revive:%d:%d", player.UserId, state.revision)
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = "LastLightRevivePrompt"
    prompt.ActionText = "REVIVE"
    prompt.ObjectText = playerLabel(player)
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = self._config.ReviveDistance
    prompt.RequiresLineOfSight = true
    prompt.Style = Enum.ProximityPromptStyle.Custom
    prompt:SetAttribute("ActionId", self._runtimeIds.Actions.Revive)
    prompt:SetAttribute("InteractionId", interactionId)
    prompt:SetAttribute("TargetUserId", player.UserId)
    prompt.Parent = targetRoot
    CollectionService:AddTag(prompt, self._runtimeIds.InteractionTag)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DownedMarker"
    billboard.Adornee = targetRoot
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 120
    billboard.Size = UDim2.fromOffset(210, 58)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 4.8, 0)
    billboard.Parent = prompt

    local label = Instance.new("TextLabel")
    label.Name = "DownedLabel"
    label.BackgroundColor3 = Color3.fromRGB(47, 20, 18)
    label.BackgroundTransparency = 0.08
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.TextColor3 = Color3.fromRGB(255, 230, 194)
    label.TextScaled = true
    label.TextStrokeTransparency = 0.72
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 181, 76)
    stroke.Thickness = 2
    stroke.Transparency = 0.12
    stroke.Parent = label

    local highlight = Instance.new("Highlight")
    highlight.Name = "DownedOutline"
    highlight.FillColor = Color3.fromRGB(165, 55, 47)
    highlight.FillTransparency = 0.72
    highlight.OutlineColor = Color3.fromRGB(255, 181, 76)
    highlight.OutlineTransparency = 0.08
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    CollectionService:AddTag(character, self._runtimeIds.PlayerDownedTag)

    self._prompts[interactionId] = prompt
    self._targets[interactionId] = player
    self._visuals[player] = {
        character = character,
        highlight = highlight,
        interactionId = interactionId,
        label = label,
        prompt = prompt,
    }
end

function PlayerSurvivalService._updateVisual(
    self: PlayerSurvivalService,
    player: Player,
    now: number
)
    local visual = self._visuals[player]
    local state = self._states[player]
    if visual == nil or state == nil then
        return
    end
    local snapshot = self._survivalState.snapshot(state, now)
    visual.label.Text = string.format(
        "✚ %s DOWN\n%02ds · REVIVE",
        string.upper(playerLabel(player)),
        snapshot.timeRemaining
    )
end

function PlayerSurvivalService._bindPlayer(self: PlayerSurvivalService, player: Player)
    if self._states[player] ~= nil then
        return
    end
    self._states[player] = self._survivalState.create(workspace:GetServerTimeNow())

    local function characterAdded(character: Model)
        local now = workspace:GetServerTimeNow()
        local previousState = self._states[player]
        local returningCharacter = self._spawned[player] == true
        self._spawned[player] = true
        local resetFromDowned = previousState ~= nil and previousState.status == "downed"
        self:_cancelChannel(player, "target_character_reset")
        for target, channel in self._channels do
            if channel.reviver == player then
                self:_cancelChannel(target, "reviver_character_reset")
            end
        end
        self:_clearVisual(player)
        if returningCharacter then
            self._states[player] = self._survivalState.respawn(previousState, now)
        elseif resetFromDowned then
            self._states[player] = self._survivalState.safeRetreat(previousState, now)
        else
            self._states[player] = self._survivalState.create(now)
        end
        task.spawn(function()
            local activeHumanoid = character:WaitForChild("Humanoid", 8)
            if
                activeHumanoid ~= nil
                and activeHumanoid:IsA("Humanoid")
                and player.Parent ~= nil
            then
                activeHumanoid.BreakJointsOnDeath = false
                self:_syncPlayer(player)
                if returningCharacter or resetFromDowned then
                    if player:GetAttribute("LastLightInExpedition") == true then
                        self._worldService:exitBramblewake(player)
                    end
                    self._analyticsService:playerRecovered(
                        player,
                        if resetFromDowned
                            then "character_reset_safe_retreat"
                            else "character_respawn_safe_retreat"
                    )
                    self:_notify(player, "SAFE RETREAT — CHARACTER RESET")
                end
                self:_notify(nil, nil)
            end
        end)
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character ~= nil then
        characterAdded(player.Character)
    else
        self:_syncPlayer(player)
    end
end

function PlayerSurvivalService.Start(self: PlayerSurvivalService)
    Players.PlayerAdded:Connect(function(player: Player)
        self:_bindPlayer(player)
    end)
    Players.PlayerRemoving:Connect(function(player: Player)
        self:_cancelChannel(player, "target_left")
        self:_clearVisual(player)
        self._states[player] = nil
        self._spawned[player] = nil
        for target, channel in self._channels do
            if channel.reviver == player then
                self:_cancelChannel(target, "reviver_left")
            end
        end
    end)
    for _, player in Players:GetPlayers() do
        self:_bindPlayer(player)
    end

    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.1 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
end

function PlayerSurvivalService.canAct(self: PlayerSurvivalService, player: Player): boolean
    local state = self._states[player]
    return state ~= nil and self._survivalState.canAct(state)
end

function PlayerSurvivalService.damage(
    self: PlayerSurvivalService,
    player: Player,
    amount: number,
    source: string
): any
    if not self._featureFlags:isEnabled("player_survival_enabled") then
        return {
            applied = false,
            reason = "survival_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            applied = false,
            reason = "player_loading",
        }
    end
    local now = workspace:GetServerTimeNow()
    local nextState, result = self._survivalState.damage(state, amount, now)
    if not result.applied then
        return result
    end

    self._states[player] = nextState
    self:_syncPlayer(player)
    if result.downed then
        self:_createVisual(player)
        self._analyticsService:playerDowned(player, string.sub(source, 1, 48))
        self:_notify(player, "DOWNED — CRAWL TOWARD LIGHT")
    else
        self:_notify(nil, nil)
    end
    return result
end

function PlayerSurvivalService.canHealInRadius(
    self: PlayerSurvivalService,
    source: Player,
    radius: number
): (boolean, string)
    if not self:canAct(source) then
        return false, "YOU CANNOT HEAL WHILE DOWNED"
    end
    local sourceRoot = rootPart(source)
    if sourceRoot == nil then
        return false, "YOUR CHARACTER IS STILL LOADING"
    end
    for player, state in self._states do
        local targetRoot = rootPart(player)
        if
            state.status == "active"
            and state.health < state.maxHealth
            and targetRoot ~= nil
            and (sourceRoot.Position - targetRoot.Position).Magnitude <= radius
        then
            return true, "GUIDING PULSE READY"
        end
    end
    return false, "NO INJURED TRAVELER IS WITHIN THE PULSE"
end

function PlayerSurvivalService.healInRadius(
    self: PlayerSurvivalService,
    source: Player,
    amount: number,
    radius: number
): any
    local canHeal, reason = self:canHealInRadius(source, radius)
    if not canHeal then
        return {
            affected = 0,
            healed = 0,
            reason = reason,
        }
    end

    local sourceRoot = assert(rootPart(source), "healing source root disappeared")
    local affected = 0
    local totalHealed = 0
    for player, state in self._states do
        local targetRoot = rootPart(player)
        if
            targetRoot ~= nil
            and (sourceRoot.Position - targetRoot.Position).Magnitude <= radius
        then
            local nextState, result = self._survivalState.heal(state, amount)
            if result.applied then
                self._states[player] = nextState
                affected += 1
                totalHealed += result.healed or 0
                self:_syncPlayer(player)
            end
        end
    end
    self:_notify(nil, nil)
    return {
        affected = affected,
        healed = totalHealed,
        reason = "healed",
    }
end

function PlayerSurvivalService.interaction(
    self: PlayerSurvivalService,
    interactionId: string
): ProximityPrompt?
    return self._prompts[interactionId]
end

function PlayerSurvivalService._canReach(
    self: PlayerSurvivalService,
    reviver: Player,
    target: Player
): boolean
    local reviverRoot = rootPart(reviver)
    local targetRoot = rootPart(target)
    local reviverCharacter = reviver.Character
    local targetCharacter = target.Character
    if
        reviverRoot == nil
        or targetRoot == nil
        or reviverCharacter == nil
        or targetCharacter == nil
        or (reviverRoot.Position - targetRoot.Position).Magnitude > self._config.ReviveDistance
    then
        return false
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { reviverCharacter }
    local result =
        workspace:Raycast(reviverRoot.Position, targetRoot.Position - reviverRoot.Position, params)
    return result == nil or result.Instance:IsDescendantOf(targetCharacter)
end

function PlayerSurvivalService.beginRevive(
    self: PlayerSurvivalService,
    reviver: Player,
    interactionId: string
): any
    local target = self._targets[interactionId]
    local prompt = self._prompts[interactionId]
    if target == nil or prompt == nil or not prompt.Enabled then
        return {
            accepted = false,
            message = "THAT RESCUE MARK IS NO LONGER ACTIVE",
            reason = "unknown_revive",
        }
    end
    if target == reviver then
        return {
            accepted = false,
            message = "AN ALLY MUST COMPLETE THE REVIVE",
            reason = "self_revive",
        }
    end
    if not self:canAct(reviver) then
        return {
            accepted = false,
            message = "YOU CANNOT REVIVE WHILE DOWNED",
            reason = "reviver_downed",
        }
    end
    local targetState = self._states[target]
    if targetState == nil or targetState.status ~= "downed" then
        return {
            accepted = false,
            message = "THAT ALLY IS ALREADY SAFE",
            reason = "target_not_downed",
        }
    end
    if not self:_canReach(reviver, target) then
        return {
            accepted = false,
            message = "MOVE CLOSER WITH A CLEAR PATH",
            reason = "revive_out_of_range",
        }
    end

    local existing = self._channels[target]
    if existing ~= nil then
        return {
            accepted = existing.reviver == reviver,
            message = if existing.reviver == reviver
                then "REVIVE IN PROGRESS — STAY CLOSE"
                else "ANOTHER ALLY IS REVIVING THEM",
            reason = "revive_in_progress",
        }
    end

    local reviverState = assert(self._states[reviver], "reviver survival state is missing")
    local now = workspace:GetServerTimeNow()
    local channel = {
        target = target,
        reviver = reviver,
        flow = self._reviveFlow.create(
            target.UserId,
            reviver.UserId,
            reviverState.revision,
            now,
            self._config.ReviveChannelSeconds
        ),
    }
    self._channels[target] = channel
    prompt.ActionText = "REVIVING"
    target:SetAttribute("LastLightReviveEndsAt", channel.flow.endsAt)
    target:SetAttribute("LastLightReviverUserId", reviver.UserId)
    self:_notify(nil, nil)
    return {
        accepted = true,
        message = "REVIVING " .. string.upper(playerLabel(target)) .. " — STAY CLOSE",
        reason = "revive_started",
    }
end

function PlayerSurvivalService._cancelChannel(
    self: PlayerSurvivalService,
    target: Player,
    reason: string
)
    local channel = self._channels[target]
    if channel == nil then
        return
    end
    self._channels[target] = nil
    target:SetAttribute("LastLightReviveEndsAt", nil)
    target:SetAttribute("LastLightReviverUserId", nil)
    local visual = self._visuals[target]
    if visual ~= nil then
        visual.prompt.ActionText = "REVIVE"
    end
    self._logger:info("player_revive_cancelled", {
        reason = reason,
        reviver = channel.reviver.UserId,
        target = target.UserId,
    })
    self:_notify(channel.reviver, "REVIVE INTERRUPTED")
end

function PlayerSurvivalService._completeRevive(
    self: PlayerSurvivalService,
    target: Player,
    channel: ReviveChannel,
    now: number
)
    local state = self._states[target]
    if state == nil then
        self:_cancelChannel(target, "target_left")
        return
    end
    local nextState, result = self._survivalState.revive(state, now)
    if not result.applied then
        self:_cancelChannel(target, result.reason)
        return
    end

    self._channels[target] = nil
    self._states[target] = nextState
    self:_clearVisual(target)
    self:_syncPlayer(target)
    self._analyticsService:playerRevived(
        target,
        channel.reviver,
        math.max(0, now - channel.flow.startedAt)
    )
    self:_notify(target, "BACK ON YOUR FEET — BRIEF LIGHT WARD ACTIVE")
    self:_notify(channel.reviver, "ALLY REVIVED")
end

function PlayerSurvivalService._recover(self: PlayerSurvivalService, player: Player, now: number)
    local state = self._states[player]
    if state == nil then
        return
    end
    local nextState, result = self._survivalState.recover(state, now)
    if not result.applied then
        return
    end

    self._channels[player] = nil
    self._states[player] = nextState
    self:_clearVisual(player)
    self:_syncPlayer(player)
    if player:GetAttribute("LastLightInExpedition") == true then
        self._worldService:exitBramblewake(player)
    else
        local character = player.Character
        if character ~= nil then
            character:PivotTo(self._worldService:spawnCFrame())
        end
    end
    self._analyticsService:playerRecovered(player, "bleedout_safe_retreat")
    self:_notify(player, "SAFE RETREAT — UNBANKED POUCH RETAINED")
end

function PlayerSurvivalService._step(self: PlayerSurvivalService, now: number)
    for player, state in self._states do
        local activeHumanoid = humanoid(player)
        if activeHumanoid ~= nil then
            local expectedHealth = math.max(1, state.health)
            if activeHumanoid.Health ~= expectedHealth then
                activeHumanoid.Health = expectedHealth
            end
        end
        if state.status == "downed" then
            self:_updateVisual(player, now)
            if type(state.bleedoutAt) == "number" and now >= state.bleedoutAt then
                self:_recover(player, now)
            end
        end
    end

    for target, channel in self._channels do
        local reviverState = self._states[channel.reviver]
        local targetState = self._states[target]
        local decision = self._reviveFlow.evaluate(channel.flow, now, {
            reachable = reviverState ~= nil
                and targetState ~= nil
                and self:_canReach(channel.reviver, target),
            reviverCanAct = reviverState ~= nil and self._survivalState.canAct(reviverState),
            reviverPresent = channel.reviver.Parent ~= nil and reviverState ~= nil,
            reviverRevision = if reviverState == nil then -1 else reviverState.revision,
            targetDowned = targetState ~= nil and targetState.status == "downed",
            targetPresent = target.Parent ~= nil and targetState ~= nil,
        })
        if decision.status == "cancel" then
            self:_cancelChannel(target, decision.reason)
        elseif decision.status == "complete" then
            self:_completeRevive(target, channel, now)
        end
    end
end

local function directionLabel(viewerRoot: BasePart, targetRoot: BasePart): string
    local offset = targetRoot.Position - viewerRoot.Position
    if offset.Magnitude < 0.01 then
        return "HERE"
    end
    local direction = offset.Unit
    local forward = viewerRoot.CFrame.LookVector:Dot(direction)
    local right = viewerRoot.CFrame.RightVector:Dot(direction)
    if math.abs(forward) >= math.abs(right) then
        return if forward >= 0 then "AHEAD" else "BEHIND"
    end
    return if right >= 0 then "RIGHT" else "LEFT"
end

function PlayerSurvivalService.snapshot(self: PlayerSurvivalService, viewer: Player): any
    local now = workspace:GetServerTimeNow()
    local state = self._states[viewer]
    local selfSnapshot = if state == nil
        then self._survivalState.snapshot(self._survivalState.create(now), now)
        else self._survivalState.snapshot(state, now)
    local viewerRoot = rootPart(viewer)

    local downedCount = 0
    local priorityAlly = nil
    local priorityTime = math.huge
    local priorityDistance = math.huge
    for player, candidateState in self._states do
        if player ~= viewer and candidateState.status == "downed" then
            downedCount += 1
            local candidateRoot = rootPart(player)
            local timeRemaining = self._survivalState.snapshot(candidateState, now).timeRemaining
            local distance = if viewerRoot == nil or candidateRoot == nil
                then math.huge
                else (viewerRoot.Position - candidateRoot.Position).Magnitude
            if
                timeRemaining < priorityTime
                or (timeRemaining == priorityTime and distance < priorityDistance)
            then
                priorityAlly = player
                priorityTime = timeRemaining
                priorityDistance = distance
            end
        end
    end

    local ally = nil
    if priorityAlly ~= nil then
        local allyState = self._states[priorityAlly]
        local allyRoot = rootPart(priorityAlly)
        local channel = self._channels[priorityAlly]
        ally = {
            bleedoutAt = allyState.bleedoutAt,
            direction = if viewerRoot == nil or allyRoot == nil
                then "UNKNOWN"
                else directionLabel(viewerRoot, allyRoot),
            distance = if priorityDistance == math.huge
                then nil
                else math.floor(priorityDistance + 0.5),
            displayName = playerLabel(priorityAlly),
            inReviveRange = priorityDistance <= self._config.ReviveDistance,
            reviveEndsAt = if channel == nil then nil else channel.flow.endsAt,
            userId = priorityAlly.UserId,
        }
    end

    local nearestActive = nil
    local nearestActiveDistance = math.huge
    if selfSnapshot.downed and viewerRoot ~= nil then
        for player, candidateState in self._states do
            if player ~= viewer and self._survivalState.canAct(candidateState) then
                local candidateRoot = rootPart(player)
                if candidateRoot ~= nil then
                    local distance = (viewerRoot.Position - candidateRoot.Position).Magnitude
                    if distance < nearestActiveDistance then
                        nearestActive = player
                        nearestActiveDistance = distance
                    end
                end
            end
        end
    end

    local nearestAlly = nil
    if nearestActive ~= nil then
        local nearestRoot = rootPart(nearestActive)
        nearestAlly = {
            direction = if nearestRoot == nil
                then "UNKNOWN"
                else directionLabel(viewerRoot :: BasePart, nearestRoot),
            distance = math.floor(nearestActiveDistance + 0.5),
            displayName = playerLabel(nearestActive),
        }
    end

    selfSnapshot.nearestAlly = nearestAlly
    selfSnapshot.reviveEndsAt = viewer:GetAttribute("LastLightReviveEndsAt")
    return {
        ally = ally,
        downedCount = downedCount,
        enabled = self._featureFlags:isEnabled("player_survival_enabled"),
        self = selfSnapshot,
    }
end

return table.freeze(PlayerSurvivalService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">ProfessionService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local ProfessionService = {}
ProfessionService.__index = ProfessionService
ProfessionService.Name = "ProfessionService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type ProfessionService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _catalog: any,
        _professionState: any,
        _featureFlags: any,
        _profileService: any,
        _survivalService: any,
        _analyticsService: any,
        _states: { [Player]: any },
        _enemyService: any,
        _switchProvider: ((Player) -> (boolean, string?))?,
        _onChanged: ((Player, string?) -> ())?,
    },
    ProfessionService
))

function ProfessionService.new(
    logger: Logger,
    catalog: any,
    professionState: any,
    featureFlags: any,
    profileService: any,
    survivalService: any,
    analyticsService: any
): ProfessionService
    return setmetatable({
        Name = ProfessionService.Name,
        _logger = logger,
        _catalog = catalog,
        _professionState = professionState,
        _featureFlags = featureFlags,
        _profileService = profileService,
        _survivalService = survivalService,
        _analyticsService = analyticsService,
        _states = {},
        _enemyService = nil,
        _switchProvider = nil,
        _onChanged = nil,
    }, ProfessionService)
end

function ProfessionService.Init(self: ProfessionService, _context: any)
    self._profileService:onLoaded(function(player: Player, profile: any)
        self:_profileLoaded(player, profile)
    end)
end

function ProfessionService.Start(self: ProfessionService)
    Players.PlayerRemoving:Connect(function(player: Player)
        self._states[player] = nil
    end)

    for _, player in Players:GetPlayers() do
        local profile = self._profileService:get(player)
        if profile ~= nil then
            self:_profileLoaded(player, profile)
        end
    end
end

function ProfessionService.setEnemyService(self: ProfessionService, enemyService: any)
    self._enemyService = enemyService
end

function ProfessionService.setSwitchProvider(
    self: ProfessionService,
    provider: (Player) -> (boolean, string?)
)
    self._switchProvider = provider
end

function ProfessionService.setChangedHandler(
    self: ProfessionService,
    callback: (Player, string?) -> ()
)
    self._onChanged = callback
end

function ProfessionService._notify(self: ProfessionService, player: Player, message: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(player, message)
    end
end

function ProfessionService._syncPlayer(self: ProfessionService, player: Player)
    local state = self._states[player]
    if state == nil then
        return
    end
    local snapshot = self._professionState.snapshot(state, workspace:GetServerTimeNow())
    player:SetAttribute("LastLightProfessionId", snapshot.selectedId)
    player:SetAttribute("LastLightProfessionReadyAt", snapshot.cooldownReadyAt)
    player:SetAttribute("LastLightProfessionActiveUntil", snapshot.activeUntil)
end

function ProfessionService._profileLoaded(self: ProfessionService, player: Player, profile: any)
    if self._states[player] ~= nil then
        return
    end
    local selectedId = if type(profile.profession) == "table"
        then profile.profession.selectedId
        else nil
    self._states[player] = self._professionState.create(selectedId, workspace:GetServerTimeNow())
    self:_syncPlayer(player)
end

function ProfessionService._switchAvailability(
    self: ProfessionService,
    player: Player
): (boolean, string?)
    if not self._survivalService:canAct(player) then
        return false, "YOU CANNOT SWITCH PROFESSION WHILE DOWNED"
    end
    local provider = self._switchProvider
    if provider == nil then
        return false, "PROFESSION SWITCHING IS STILL LOADING"
    end
    return provider(player)
end

function ProfessionService.select(
    self: ProfessionService,
    player: Player,
    professionId: string
): any
    if not self._featureFlags:isEnabled("profession_kits_enabled") then
        return {
            accepted = false,
            message = "PROFESSIONS ARE TEMPORARILY UNAVAILABLE",
            reason = "feature_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            accepted = false,
            message = "YOUR PROFESSION LOADOUT IS STILL LOADING",
            reason = "player_loading",
        }
    end

    local canSwitch, unavailableMessage = self:_switchAvailability(player)
    local now = workspace:GetServerTimeNow()
    local nextState, result = self._professionState.select(state, professionId, now, canSwitch)
    if not result.accepted then
        local message = unavailableMessage
        if result.reason == "unknown_profession" then
            message = "THAT PROFESSION DOES NOT EXIST"
        end
        self._analyticsService:professionSelected(player, professionId, false, result.reason)
        return {
            accepted = false,
            message = message or "PROFESSION SWITCHING IS UNAVAILABLE",
            reason = result.reason,
        }
    end

    self._states[player] = nextState
    self:_syncPlayer(player)
    local definition = self._catalog.get(professionId)
    if result.changed then
        self._profileService:setProfession(player, professionId)
        self._analyticsService:professionSelected(player, professionId, true, nil)
        self._logger:info("profession_selected", {
            player = player.UserId,
            profession = professionId,
        })
    end
    local message = if result.changed
        then string.format("%s READY — %s", definition.displayName, definition.abilityName)
        else string.format("%s IS ALREADY EQUIPPED", definition.displayName)
    self:_notify(player, message)
    return {
        accepted = true,
        changed = result.changed,
        message = message,
        reason = result.reason,
    }
end

function ProfessionService._abilityPreflight(
    self: ProfessionService,
    player: Player,
    definition: any
): (boolean, string)
    local enemyService = self._enemyService
    if definition.id == self._catalog.Ids.Scout then
        if enemyService == nil then
            return false, "THREAT TRACKING IS STILL LOADING"
        end
        return enemyService:canMarkNearest(player, definition.effectRadius)
    elseif definition.id == self._catalog.Ids.Warden then
        if enemyService == nil or not enemyService:combatActive() then
            return false, "LANTERN GUARD NEEDS AN ACTIVE THREAT"
        end
        return true, "LANTERN GUARD READY"
    elseif definition.id == self._catalog.Ids.Engineer then
        if enemyService == nil then
            return false, "LANTERN REPAIRS ARE STILL LOADING"
        end
        return enemyService:canRepairLantern(player, definition.effectRadius)
    elseif definition.id == self._catalog.Ids.Medic then
        return self._survivalService:canHealInRadius(player, definition.effectRadius)
    end
    return true, "LANTERN GUARD READY"
end

function ProfessionService._applyAbility(
    self: ProfessionService,
    player: Player,
    definition: any
): (string, number)
    if definition.id == self._catalog.Ids.Scout then
        local _, message = self._enemyService:markNearest(
            player,
            definition.effectRadius,
            definition.activeSeconds
        )
        return message, 1
    elseif definition.id == self._catalog.Ids.Warden then
        return "LANTERN GUARD ACTIVE — ENEMY DAMAGE REDUCED", 1
    elseif definition.id == self._catalog.Ids.Engineer then
        local _, message = self._enemyService:repairLantern(
            player,
            definition.effectRadius,
            definition.effectAmount
        )
        return message, 1
    end

    local healResult =
        self._survivalService:healInRadius(player, definition.effectAmount, definition.effectRadius)
    return string.format(
        "GUIDING PULSE — %d TRAVELER%s RESTORED",
        healResult.affected,
        if healResult.affected == 1 then "" else "S"
    ),
        healResult.affected
end

function ProfessionService.useAbility(self: ProfessionService, player: Player): any
    if not self._featureFlags:isEnabled("profession_kits_enabled") then
        return {
            accepted = false,
            message = "PROFESSION ABILITIES ARE TEMPORARILY UNAVAILABLE",
            reason = "feature_disabled",
        }
    end
    local state = self._states[player]
    if state == nil then
        return {
            accepted = false,
            message = "YOUR PROFESSION LOADOUT IS STILL LOADING",
            reason = "player_loading",
        }
    end

    local now = workspace:GetServerTimeNow()
    local decision = self._professionState.canUse(state, now, self._survivalService:canAct(player))
    if not decision.accepted then
        local message = if decision.reason == "profession_required"
            then "CHOOSE A PROFESSION IN EMBERHOLLOW"
            elseif decision.reason == "cooldown" then string.format(
                "ABILITY RECHARGING — %.1fs",
                decision.remaining or 0
            )
            else "YOU CANNOT USE AN ABILITY RIGHT NOW"
        self._analyticsService:professionAbility(
            player,
            state.selectedId or "none",
            false,
            decision.reason,
            0
        )
        return {
            accepted = false,
            message = message,
            reason = decision.reason,
        }
    end

    local definition = decision.definition
    local validTarget, preflightMessage = self:_abilityPreflight(player, definition)
    if not validTarget then
        self._analyticsService:professionAbility(player, definition.id, false, "invalid_target", 0)
        return {
            accepted = false,
            message = preflightMessage,
            reason = "invalid_target",
        }
    end

    local nextState = self._professionState.commitAbility(state, now)
    self._states[player] = nextState
    self:_syncPlayer(player)
    local message, affected = self:_applyAbility(player, definition)
    self._analyticsService:professionAbility(player, definition.id, true, nil, affected)
    self:_notify(player, message)
    return {
        accepted = true,
        affected = affected,
        message = message,
        reason = "used",
    }
end

function ProfessionService.mitigateIncomingDamage(
    self: ProfessionService,
    player: Player,
    amount: number,
    now: number
): (number, boolean)
    local state = self._states[player]
    if state == nil or not self._professionState.mitigatesDamage(state, now) then
        return amount, false
    end
    return math.max(1, math.ceil(amount * 0.4)), true
end

function ProfessionService.snapshot(self: ProfessionService, player: Player): any
    local now = workspace:GetServerTimeNow()
    local state = self._states[player]
    local snapshot = if state == nil
        then self._professionState.snapshot(self._professionState.create(nil, now), now)
        else self._professionState.snapshot(state, now)
    local switchable, unavailableMessage = self:_switchAvailability(player)
    snapshot.enabled = self._featureFlags:isEnabled("profession_kits_enabled")
    snapshot.switchable = switchable
    snapshot.switchUnavailableMessage = unavailableMessage
    return snapshot
end

return table.freeze(ProfessionService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">ProfileService</string>
            <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local ProfileService = {}
ProfileService.__index = ProfileService
ProfileService.Name = "ProfileService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type ProfileService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _persistent: boolean,
        _profiles: { [Player]: any },
        _writable: { [Player]: boolean },
        _dirty: { [Player]: boolean },
        _saving: { [Player]: boolean },
        _loading: { [Player]: boolean },
        _loadedEvent: BindableEvent,
        _saveSchema: any,
        _store: GlobalDataStore?,
    },
    ProfileService
))

function ProfileService.new(logger: Logger, persistent: boolean): ProfileService
    return setmetatable({
        Name = ProfileService.Name,
        _logger = logger,
        _persistent = persistent,
        _profiles = {},
        _writable = {},
        _dirty = {},
        _saving = {},
        _loading = {},
        _loadedEvent = Instance.new("BindableEvent"),
        _saveSchema = nil,
        _store = nil,
    }, ProfileService)
end

function ProfileService.Init(self: ProfileService, context: any)
    self._saveSchema = context.saveSchema
    if self._persistent then
        self._store = DataStoreService:GetDataStore("LastLightProfile_v1")
    end
end

function ProfileService._load(self: ProfileService, player: Player)
    if self._loading[player] or self._profiles[player] ~= nil then
        return
    end
    self._loading[player] = true

    local now = os.time()
    local profile = self._saveSchema.default(now)
    local source = "fallback"
    local writable = not self._persistent

    if self._persistent and self._store ~= nil then
        local finished = false
        local ok = false
        local result: any = nil

        task.spawn(function()
            ok, result = pcall(function()
                return (self._store :: GlobalDataStore):GetAsync(
                    string.format("player_%d", player.UserId)
                )
            end)
            finished = true
        end)

        local deadline = os.clock() + 6
        while not finished and os.clock() < deadline and player.Parent ~= nil do
            task.wait(0.1)
        end

        if finished and ok then
            profile = self._saveSchema.normalize(result, now)
            source = result == nil and "new" or "datastore"
            writable = true
        elseif finished then
            source = "read_only"
            self._logger:warn("profile_load_failed", {
                player = player.UserId,
                reason = tostring(result),
            })
        else
            source = "read_only"
            self._logger:warn("profile_load_timed_out", { player = player.UserId })
        end
    else
        source = "session"
    end

    if player.Parent == nil then
        self._loading[player] = nil
        return
    end

    self._profiles[player] = profile
    self._writable[player] = writable
    self._loading[player] = nil
    self._loadedEvent:Fire(player, profile)
    self._logger:info("profile_loaded", {
        player = player.UserId,
        source = source,
        stage = profile.tutorial.stage,
    })
end

function ProfileService.Start(self: ProfileService)
    Players.PlayerAdded:Connect(function(player: Player)
        task.spawn(function()
            self:_load(player)
        end)
    end)

    Players.PlayerRemoving:Connect(function(player: Player)
        self:save(player)
        self._profiles[player] = nil
        self._writable[player] = nil
        self._dirty[player] = nil
        self._saving[player] = nil
        self._loading[player] = nil
    end)

    for _, player in Players:GetPlayers() do
        task.spawn(function()
            self:_load(player)
        end)
    end

    if self._persistent then
        task.spawn(function()
            while true do
                task.wait(10)
                for player in self._dirty do
                    if player.Parent ~= nil then
                        task.spawn(function()
                            self:save(player)
                        end)
                    end
                end
            end
        end)
    end

    game:BindToClose(function()
        local remaining = 0
        for player in self._profiles do
            remaining += 1
            task.spawn(function()
                self:save(player)
                remaining -= 1
            end)
        end

        local deadline = os.clock() + 7
        while remaining > 0 and os.clock() < deadline do
            task.wait(0.1)
        end
    end)
end

function ProfileService.onLoaded(
    self: ProfileService,
    callback: (Player, any) -> ()
): RBXScriptConnection
    return self._loadedEvent.Event:Connect(callback)
end

function ProfileService.get(self: ProfileService, player: Player): any
    return self._profiles[player]
end

function ProfileService.isLoaded(self: ProfileService, player: Player): boolean
    return self._profiles[player] ~= nil
end

function ProfileService.isWritable(self: ProfileService, player: Player): boolean
    return self._profiles[player] ~= nil
        and (not self._persistent or self._writable[player] == true)
end

function ProfileService.setTutorial(
    self: ProfileService,
    player: Player,
    stage: string,
    selectedTool: string?
): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end

    self._profiles[player] = self._saveSchema.withTutorial(profile, stage, selectedTool, os.time())
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return true
end

function ProfileService.setProfession(
    self: ProfileService,
    player: Player,
    professionId: string
): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end

    self._profiles[player] = self._saveSchema.withProfession(profile, professionId, os.time())
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return true
end

function ProfileService.awardMastery(
    self: ProfileService,
    player: Player,
    professionId: string,
    amount: number
): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { applied = false, reason = "profile_unavailable" }
    end
    local nextProfile, result =
        self._saveSchema.withMasteryAward(profile, professionId, amount, os.time())
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    return result
end

function ProfileService.masterySnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.masterySnapshot(profile)
end

function ProfileService.setNightNumber(
    self: ProfileService,
    player: Player,
    nightNumber: number
): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end

    self._profiles[player] = self._saveSchema.withNightNumber(profile, nightNumber, os.time())
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return true
end

function ProfileService.nightNumber(self: ProfileService, player: Player): number
    local profile = self._profiles[player]
    if profile == nil then
        return 1
    end
    return self._saveSchema.nightNumber(profile)
end

function ProfileService.craftItem(self: ProfileService, player: Player, recipeId: string): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            reason = "profile_read_only",
        }
    end

    local nextProfile, result = self._saveSchema.withCraftedItem(profile, recipeId, os.time())
    if not result.applied then
        return {
            accepted = false,
            reason = result.reason,
        }
    end

    self._profiles[player] = nextProfile
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return {
        accepted = true,
        itemId = result.itemId,
    }
end

function ProfileService.useGearItem(self: ProfileService, player: Player, itemId: string): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            reason = "profile_read_only",
        }
    end

    local nextProfile, result = self._saveSchema.withUsedGearItem(profile, itemId, os.time())
    if not result.applied then
        return {
            accepted = false,
            reason = result.reason,
        }
    end

    self._profiles[player] = nextProfile
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return {
        accepted = true,
        itemId = result.itemId,
    }
end

function ProfileService.equipItem(self: ProfileService, player: Player, itemId: string): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { accepted = false, reason = "profile_unavailable" }
    end
    local nextProfile, result = self._saveSchema.withEquippedItem(profile, itemId, os.time())
    if not result.applied then
        return { accepted = false, reason = result.reason }
    end
    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    return { accepted = true, itemId = result.itemId, slot = result.slot }
end

function ProfileService.unequipItem(self: ProfileService, player: Player, slot: string): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { accepted = false, reason = "profile_unavailable" }
    end
    local nextProfile, result = self._saveSchema.withUnequippedItem(profile, slot, os.time())
    if not result.applied then
        return { accepted = false, reason = result.reason }
    end
    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    return { accepted = true, slot = slot }
end

function ProfileService.equippedSnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.equippedSnapshot(profile)
end

function ProfileService.equipmentStats(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return { damageReduction = 0, staminaRegenMultiplier = 1 }
    end
    return self._saveSchema.equipmentStats(profile)
end

function ProfileService.townConsequence(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return { tier = 0, title = "EMBERHOLLOW AWAKENS", detail = "" }
    end
    return self._saveSchema.townConsequence(profile)
end

-- Safe to call after any action, whether or not it moved a quest signal:
-- returns an empty list and touches nothing when there's nothing newly
-- claimable.
function ProfileService.checkQuests(self: ProfileService, player: Player): { any }
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return {}
    end

    local nextProfile, claimedResults = self._saveSchema.checkAndClaimQuests(profile, os.time())
    if #claimedResults == 0 then
        return claimedResults
    end

    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    return claimedResults
end

function ProfileService.questSnapshot(self: ProfileService, player: Player): { any }
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.questSnapshot(profile)
end

function ProfileService.gearSnapshot(self: ProfileService, player: Player): { [string]: number }
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.gearSnapshot(profile)
end

function ProfileService.grantUnbankedExpeditionReward(
    self: ProfileService,
    player: Player,
    transactionId: string,
    manifestHash: string,
    reward: any
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            durable = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            durable = false,
            reason = "profile_read_only",
        }
    end

    local nextProfile, result = self._saveSchema.withUnbankedExpeditionReward(
        profile,
        transactionId,
        manifestHash,
        reward,
        os.time()
    )
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    elseif not result.duplicate then
        return {
            accepted = false,
            durable = false,
            reason = result.reason,
        }
    end

    local durable = not self._persistent
    if self._persistent and result.applied then
        task.spawn(function()
            self:save(player)
        end)
    elseif self._persistent and result.duplicate then
        durable = self._dirty[player] ~= true
    end
    return {
        accepted = true,
        applied = result.applied == true,
        durable = durable,
        reason = if durable then nil else "save_queued",
    }
end

function ProfileService.settleExpedition(
    self: ProfileService,
    player: Player,
    runId: string,
    manifestHash: string,
    sessionRewards: { any }
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            reason = "profile_read_only",
        }
    end

    local workingProfile = profile
    local sessionTransactionIds = {}
    for _, sessionReward in sessionRewards do
        local nextProfile, result = self._saveSchema.withUnbankedExpeditionReward(
            workingProfile,
            sessionReward.transactionId,
            sessionReward.manifestHash,
            {
                amount = sessionReward.amount,
                materialId = sessionReward.materialId,
            },
            os.time()
        )
        if not result.applied and not result.duplicate then
            return {
                accepted = false,
                reason = result.reason,
            }
        end
        workingProfile = nextProfile
        table.insert(sessionTransactionIds, sessionReward.transactionId)
    end

    local pending = self._saveSchema.expeditionPending(workingProfile)
    local settlementId = nil
    local settlementRecord = nil
    if pending.count > 0 then
        settlementId =
            self._saveSchema.expeditionSettlementId(runId, player.UserId, pending.fingerprint)
        local nextProfile, result = self._saveSchema.withExpeditionSettlement(
            workingProfile,
            settlementId,
            manifestHash,
            os.time()
        )
        if not result.applied and not result.duplicate then
            return {
                accepted = false,
                reason = result.reason,
            }
        end
        workingProfile = nextProfile
        settlementRecord = result.record
    elseif #sessionTransactionIds > 0 then
        settlementId, settlementRecord = self._saveSchema.findExpeditionSettlementForRewards(
            workingProfile,
            sessionTransactionIds
        )
    end

    if workingProfile ~= profile then
        self._profiles[player] = workingProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    if settlementId == nil then
        return {
            accepted = true,
            empty = true,
            inventory = table.clone(workingProfile.inventory.materials),
            sessionTransactionIds = sessionTransactionIds,
        }
    end

    local saved = if self._persistent then self:save(player) else true
    local activeProfile = self._profiles[player]
    local durable = saved
        and activeProfile ~= nil
        and self._saveSchema.hasExpeditionSettlement(activeProfile, settlementId)
    return {
        accepted = durable,
        durable = durable,
        inventory = if activeProfile == nil
            then {}
            else table.clone(activeProfile.inventory.materials),
        materials = if settlementRecord == nil then {} else table.clone(settlementRecord.materials),
        reason = if durable then nil else "save_pending",
        settlementId = settlementId,
        sessionTransactionIds = sessionTransactionIds,
    }
end

function ProfileService.inventorySnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            banked = {},
            pending = {},
            pendingRewards = {},
        }
    end
    local pending = self._saveSchema.expeditionPending(profile)
    return {
        banked = table.clone(profile.inventory.materials),
        pending = pending.materials,
        pendingRewards = pending.rewards,
    }
end

function ProfileService.completeChapterOne(
    self: ProfileService,
    player: Player,
    transactionId: string,
    decision: string,
    wardenOutcome: string
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            durable = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            durable = false,
            reason = "profile_read_only",
        }
    end
    local nextProfile, result = self._saveSchema.withChapterOneResolution(
        profile,
        transactionId,
        decision,
        wardenOutcome,
        os.time()
    )
    if not result.applied and not result.duplicate then
        return {
            accepted = false,
            durable = true,
            reason = result.reason,
        }
    end
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    local durable = not self._persistent
    if self._persistent and result.applied then
        local saved = self:save(player)
        local activeProfile = self._profiles[player]
        local chapter = if activeProfile == nil
            then nil
            else self._saveSchema.chapterOne(activeProfile)
        durable = saved
            and chapter ~= nil
            and chapter.status == "complete"
            and chapter.transactionId == transactionId
    elseif self._persistent and result.duplicate then
        local saved = if self._dirty[player] == true then self:save(player) else true
        local activeProfile = self._profiles[player]
        local chapter = if activeProfile == nil
            then nil
            else self._saveSchema.chapterOne(activeProfile)
        durable = saved
            and self._dirty[player] ~= true
            and chapter ~= nil
            and chapter.status == "complete"
            and chapter.transactionId == transactionId
    end
    return {
        accepted = true,
        applied = result.applied == true,
        durable = durable,
        reason = if durable then result.reason else "save_pending",
        story = result.record,
    }
end

function ProfileService.chapterOneSnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return nil
    end
    return self._saveSchema.chapterOne(profile)
end

function ProfileService.save(self: ProfileService, player: Player): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end
    if not self._persistent then
        return true
    end
    if self._store == nil or self._writable[player] ~= true then
        self._logger:warn("profile_save_skipped_read_only", {
            player = player.UserId,
        })
        return false
    end
    if self._saving[player] then
        return false
    end
    self._saving[player] = true

    local retainedNewer = false
    local newerProfile: any = nil
    local ok, message = pcall(function()
        (self._store :: GlobalDataStore):UpdateAsync(
            string.format("player_%d", player.UserId),
            function(current: any)
                if current ~= nil then
                    local normalized = self._saveSchema.normalize(current, os.time())
                    if normalized.revision > profile.revision then
                        retainedNewer = true
                        newerProfile = normalized
                        return current
                    end
                end
                return profile
            end
        )
    end)
    self._saving[player] = nil

    if not ok then
        self._logger:warn("profile_save_failed", {
            player = player.UserId,
            reason = tostring(message),
        })
        return false
    end

    if retainedNewer and newerProfile ~= nil then
        local activeProfile = self._profiles[player]
        if activeProfile ~= nil and activeProfile.revision <= newerProfile.revision then
            self._profiles[player] = newerProfile
            self._dirty[player] = nil
        end
        self._logger:warn("profile_save_retained_newer_revision", {
            player = player.UserId,
            attemptedRevision = profile.revision,
            storedRevision = newerProfile.revision,
        })
        return true
    end

    local activeProfile = self._profiles[player]
    if activeProfile ~= nil and activeProfile.revision == profile.revision then
        self._dirty[player] = nil
    end
    self._logger:info("profile_saved", {
        player = player.UserId,
        revision = profile.revision,
        stage = profile.tutorial.stage,
    })
    return true
end

return table.freeze(ProfileService)
]]></string>
          </Properties>
