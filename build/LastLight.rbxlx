        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">MeshMaterialPlan</string>
            <string name="Source"><![CDATA[--!strict

-- Roblox's GLB importer preserves the mesh groups used by the authored kit,
-- but model thumbnails and runtime loads otherwise fall back to gray
-- SmoothPlastic. Keep the material decision data-only so it can be validated
-- outside Studio; MeshTemplateLoader owns the actual Enum.Material mapping.

local MeshMaterialPlan = {}

export type Style = {
    material: string,
    color: { number },
}

local STYLES: { [string]: Style } = {
    bark_dark = { material = "Wood", color = { 36, 26, 24 } },
    bark_mid = { material = "Wood", color = { 62, 39, 30 } },
    bark_cut = { material = "WoodPlanks", color = { 121, 83, 52 } },
    pine_dark = { material = "LeafyGrass", color = { 18, 42, 32 } },
    pine_mid = { material = "LeafyGrass", color = { 42, 77, 51 } },
    leaf_dark = { material = "LeafyGrass", color = { 31, 68, 41 } },
    leaf_mid = { material = "LeafyGrass", color = { 58, 91, 54 } },
    moss = { material = "Grass", color = { 72, 104, 55 } },
    stone_dark = { material = "Slate", color = { 43, 52, 60 } },
    stone = { material = "Slate", color = { 75, 83, 89 } },
    fungus = { material = "Ground", color = { 135, 60, 29 } },
    foxfire = { material = "Neon", color = { 94, 206, 176 } },
    lantern_amber = { material = "Neon", color = { 255, 181, 76 } },
    iron = { material = "Metal", color = { 42, 46, 52 } },
    meadow = { material = "Grass", color = { 131, 93, 24 } },
}

-- Longest-first prevents `stone` and `bark` families from swallowing their
-- more specific dark/cut variants.
local ORDER = table.freeze({
    "lantern_amber",
    "stone_dark",
    "bark_dark",
    "bark_mid",
    "bark_cut",
    "pine_dark",
    "pine_mid",
    "leaf_dark",
    "leaf_mid",
    "foxfire",
    "fungus",
    "meadow",
    "stone",
    "moss",
    "iron",
})

function MeshMaterialPlan.groupForPart(partName: string): string?
    local normalized = string.lower(partName)
    -- The stable asset ID may itself contain a cue name (for example,
    -- `mesh_foxfire_windmill_tower_a`). Imported part names put the authored
    -- material group after `__`; match that segment so the asset prefix cannot
    -- turn ordinary iron or moss into Neon.
    local materialSegment = string.match(normalized, ".*__(.+)$") or normalized
    for _, group in ORDER do
        if string.find(materialSegment, group, 1, true) ~= nil then
            return group
        end
    end
    return nil
end

function MeshMaterialPlan.styleForPart(partName: string): Style?
    local group = MeshMaterialPlan.groupForPart(partName)
    if group == nil then
        return nil
    end
    return STYLES[group]
end

function MeshMaterialPlan.groups(): { string }
    return table.clone(ORDER)
end

return table.freeze(MeshMaterialPlan)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">MeshTemplateLoader</string>
            <string name="Source"><![CDATA[--!strict

local AssetService = game:GetService("AssetService")
local InsertService = game:GetService("InsertService")

local MeshAssetRegistry = require(script.Parent.MeshAssetRegistry)
local MeshMaterialPlan = require(script.Parent.MeshMaterialPlan)

local MeshTemplateLoader = {}
MeshTemplateLoader.__index = MeshTemplateLoader

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type MeshTemplateLoader = typeof(setmetatable(
    {} :: {
        _logger: Logger,
        _templates: { [string]: Model },
        _templateScale: { [string]: number },
        _failed: { [string]: boolean },
        _permanentFailure: { [string]: boolean },
    },
    MeshTemplateLoader
))

type RestyleRule = { match: { number }, color: { number }?, material: string? }

local function matchesRestyleColor(color: Color3, match: { number }): boolean
    return math.abs(color.R * 255 - match[1]) <= 4
        and math.abs(color.G * 255 - match[2]) <= 4
        and math.abs(color.B * 255 - match[3]) <= 4
end

local function sanitize(
    model: Model,
    stripDecals: boolean,
    restyleParts: { RestyleRule }?
): (number, number)
    local meshParts = 0
    local baseParts = 0
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("BasePart") then
            baseParts += 1
            descendant.Anchored = true
            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false
            descendant.CastShadow = true
            descendant.Massless = true
            if restyleParts ~= nil then
                for _, rule in restyleParts do
                    if matchesRestyleColor(descendant.Color, rule.match) then
                        if rule.color ~= nil and descendant:IsA("UnionOperation") then
                            descendant.UsePartColor = true
                        end
                        if rule.color ~= nil then
                            descendant.Color =
                                Color3.fromRGB(rule.color[1], rule.color[2], rule.color[3])
                        end
                        if rule.material ~= nil then
                            descendant.Material = (Enum.Material :: any)[rule.material]
                        end
                        break
                    end
                end
            end
            if descendant:IsA("MeshPart") then
                meshParts += 1
            end
        elseif
            descendant:IsA("LuaSourceContainer")
            or descendant:IsA("ProximityPrompt")
            or descendant:IsA("ClickDetector")
            or descendant:IsA("DragDetector")
            or descendant:IsA("LayerCollector")
            or descendant:IsA("GuiObject")
            or descendant:IsA("Camera")
            or descendant:IsA("ValueBase")
            or descendant:IsA("Constraint")
            or descendant:IsA("JointInstance")
            or descendant:IsA("Humanoid")
            or descendant:IsA("AnimationController")
            or descendant:IsA("Sound")
            or descendant:IsA("PostEffect")
            or descendant:IsA("BodyMover")
            or (stripDecals and (descendant:IsA("Decal") or descendant:IsA("Texture")))
        then
            descendant:Destroy()
        end
    end
    return meshParts, baseParts
end

local MAX_LOAD_ATTEMPTS = 3

local function longestDimension(size: Vector3): number
    return math.max(size.X, size.Y, size.Z)
end

local ROBLOX_MATERIALS = table.freeze({
    Grass = Enum.Material.Grass,
    Ground = Enum.Material.Ground,
    LeafyGrass = Enum.Material.LeafyGrass,
    Metal = Enum.Material.Metal,
    Neon = Enum.Material.Neon,
    Slate = Enum.Material.Slate,
    Wood = Enum.Material.Wood,
    WoodPlanks = Enum.Material.WoodPlanks,
})

local function applyBuiltInMaterials(
    model: Model,
    customPbr: boolean,
    preserveSourceMaterials: boolean
): (number, number)
    if customPbr or preserveSourceMaterials then
        return 0, 0
    end

    local styled = 0
    local unstyled = 0
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("MeshPart") then
            local style = MeshMaterialPlan.styleForPart(descendant.Name)
            if style == nil then
                unstyled += 1
            else
                local material = ROBLOX_MATERIALS[style.material]
                local color = style.color
                assert(material ~= nil, "unknown built-in mesh material " .. style.material)
                descendant.Material = material
                descendant.MaterialVariant = ""
                descendant.Color = Color3.fromRGB(color[1], color[2], color[3])
                for _, child in descendant:GetChildren() do
                    if child:IsA("SurfaceAppearance") then
                        child:Destroy()
                    end
                end
                styled += 1
            end
        end
    end
    return styled, unstyled
end

local function applyProfileScale(model: Model, profileScale: Vector3)
    if profileScale == Vector3.one then
        return
    end

    local pivot = model:GetPivot()
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("BasePart") then
            local relative = pivot:ToObjectSpace(descendant.CFrame)
            descendant.Size *= profileScale
            descendant.CFrame = pivot
                * CFrame.new(relative.Position * profileScale)
                * relative.Rotation
        end
    end
end

function MeshTemplateLoader.new(logger: Logger): MeshTemplateLoader
    return setmetatable({
        _logger = logger,
        _templates = {},
        _templateScale = {},
        _failed = {},
        _permanentFailure = {},
    }, MeshTemplateLoader)
end

function MeshTemplateLoader._load(self: MeshTemplateLoader, stableId: string): Model?
    local cached = self._templates[stableId]
    if cached ~= nil then
        return cached
    end
    if self._failed[stableId] then
        return nil
    end

    local entry = MeshAssetRegistry.get(stableId)
    if entry == nil then
        self._failed[stableId] = true
        self._permanentFailure[stableId] = true
        self._logger:info("mesh_asset_unknown", { assetId = stableId })
        return nil
    end
    if entry.placementBand == "retired_visual_failure" then
        self._failed[stableId] = true
        self._permanentFailure[stableId] = true
        self._logger:info("mesh_asset_retired", { assetId = stableId })
        return nil
    end

    --[[
        Retry a failed fetch before condemning the asset for the session.

        One blip used to cost the whole run. A failure here sets
        self._failed[stableId], which is checked before every later placement
        of the same asset -- so a single transient error does not lose one
        prop, it silently drops every instance of that asset in the world and
        leaves procedural fallbacks in their place. Observed repeatedly under
        Wine: the same IDs that fail one boot load cleanly the next, reporting
        "User is not authorized to access Asset" for an asset the account
        plainly can access. That is throttling or CDN flakiness, not a
        permission fact.

        Three attempts with a widening pause. Bounded on purpose: a genuinely
        unavailable asset still gets condemned quickly rather than being
        retried once per placement, and the cost is paid once per asset at
        template load, not per instance.
    ]]
    local ok, loaded
    local attempts = 0
    repeat
        attempts += 1
        if entry.creatorStore then
            ok, loaded = pcall(AssetService.LoadAssetAsync, AssetService, entry.assetId)
        else
            ok, loaded = pcall(InsertService.LoadAsset, InsertService, entry.assetId)
        end
        local usable = ok and typeof(loaded) == "Instance" and loaded:IsA("Model")
        if usable then
            break
        end
        if ok and typeof(loaded) == "Instance" then
            loaded:Destroy()
        end
        self._logger:info("mesh_asset_load_retry", {
            assetId = stableId,
            robloxAssetId = entry.assetId,
            attempt = attempts,
            error = if ok then "LoadAsset returned a non-Model" else tostring(loaded),
        })
        if attempts < MAX_LOAD_ATTEMPTS then
            task.wait(attempts * 0.75)
        end
    until attempts >= MAX_LOAD_ATTEMPTS
    if not ok or typeof(loaded) ~= "Instance" or not loaded:IsA("Model") then
        if ok and typeof(loaded) == "Instance" then
            loaded:Destroy()
        end
        self._failed[stableId] = true
        self._logger:info("mesh_asset_load_failed", {
            assetId = stableId,
            robloxAssetId = entry.assetId,
            attempts = attempts,
            error = if ok then "LoadAsset returned a non-Model" else tostring(loaded),
        })
        return nil
    end

    loaded.Name = "Template_" .. stableId
    local meshPartCount, basePartCount =
        sanitize(loaded, entry.stripDecals == true, entry.restyleParts)
    local styledParts, unstyledParts =
        applyBuiltInMaterials(loaded, entry.pbr, entry.preserveSourceMaterials)
    -- Cancel the source model's stored rotation BEFORE measuring anything. A
    -- model saved off-axis inflates its own axis-aligned bounding box -- the
    -- bed reads 13.85 x 15.97 as stored but is really 8.04 x 14.28 -- so
    -- normalizing against the inflated box quietly shrinks the asset while
    -- targetLongestDimension still looks honoured. Correcting here rather than
    -- at each call site also makes placement yaw mean what it says everywhere
    -- the asset is used, instead of every caller carrying the same offset.
    local sourceYaw = entry.sourceYawDegrees
    if sourceYaw ~= nil and sourceYaw ~= 0 then
        -- Post-multiply so the yaw is cancelled about the model's own pivot.
        -- Pre-multiplying rotates about the world origin instead, which also
        -- drags the model's position -- harmless while the pivot rotation is
        -- identity, but wrong the moment a source model ships with a
        -- PrimaryPart carrying its own rotation, which Creator Store models do.
        loaded:PivotTo(loaded:GetPivot() * CFrame.Angles(0, -math.rad(sourceYaw), 0))
    end
    local _, nativeSize = loaded:GetBoundingBox()
    local nativeLongest = longestDimension(nativeSize)
    local normalizationScale = MeshAssetRegistry.scaleFor(stableId, nativeLongest)
    if basePartCount == 0 or normalizationScale == nil then
        loaded:Destroy()
        self._failed[stableId] = true
        self._logger:info("mesh_asset_invalid", {
            assetId = stableId,
            meshParts = meshPartCount,
            baseParts = basePartCount,
            nativeLongestDimension = nativeLongest,
        })
        return nil
    end

    local desiredScale = loaded:GetScale() * normalizationScale
    loaded:ScaleTo(desiredScale)
    local boundsCFrame, boundsSize = loaded:GetBoundingBox()
    loaded.WorldPivot = CFrame.new(boundsCFrame.Position - Vector3.new(0, boundsSize.Y * 0.5, 0))
    loaded:PivotTo(CFrame.new())
    loaded:SetAttribute("SourceMaterialsPreserved", entry.preserveSourceMaterials)
    loaded.Parent = nil

    self._templates[stableId] = loaded
    self._templateScale[stableId] = desiredScale
    self._logger:info("mesh_asset_ready", {
        assetId = stableId,
        robloxAssetId = entry.assetId,
        meshParts = meshPartCount,
        baseParts = basePartCount,
        styledParts = styledParts,
        unstyledParts = unstyledParts,
        preserveSourceMaterials = entry.preserveSourceMaterials,
        nativeLongestDimension = nativeLongest,
        targetLongestDimension = entry.targetLongestDimension,
    })
    return loaded
end

function MeshTemplateLoader.place(
    self: MeshTemplateLoader,
    stableId: string,
    parent: Instance,
    at: CFrame,
    placementScale: number,
    profileScale: Vector3?
): Model?
    local template = self:_load(stableId)
    local templateScale = self._templateScale[stableId]
    if template == nil or templateScale == nil or placementScale <= 0 then
        return nil
    end

    local clone = template:Clone()
    clone.Name = "Authored_" .. stableId
    clone:ScaleTo(templateScale * placementScale)
    local resolvedProfileScale = profileScale or Vector3.one
    applyProfileScale(clone, resolvedProfileScale)
    clone:PivotTo(at)
    clone:SetAttribute("MeshAssetId", stableId)
    clone:SetAttribute("PlacementScale", placementScale)
    clone:SetAttribute("ProfileScale", resolvedProfileScale)
    clone.Parent = parent
    return clone
end

--[[
    Give condemned assets another chance.

    A load failure marks an asset failed for the whole session, which is the
    right call per placement -- but boot loads sixty assets in a burst, and
    the platform sometimes answers a burst with throttling errors dressed as
    permission errors (see the retry comment in _load). One bad boot minute
    left all eleven town-ring buildings as dark fallback shells for the whole
    server lifetime. This clears only the transient failures, so a later
    recovery pass can try again; unknown and retired assets stay condemned.

    Returns the asset ids that were forgiven.
]]
function MeshTemplateLoader.forgetTransientFailures(self: MeshTemplateLoader): { string }
    local forgiven = {}
    for stableId in self._failed do
        if not self._permanentFailure[stableId] then
            table.insert(forgiven, stableId)
        end
    end
    for _, stableId in forgiven do
        self._failed[stableId] = nil
    end
    return forgiven
end

return table.freeze(MeshTemplateLoader)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">MireglassBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Mireglass Fen's geometry.

    The Delve reads as underground because every module carries a roof.
    The Fen reads as drowned because every module carries water, and the
    water is the thing you cannot trust: it is glassy enough to mirror
    the sky, so a player looking at the ground is often looking at a
    reflection of what is above it. That is the region's whole idea, and
    it is built rather than described -- reed mats that float, boardwalks
    that stop, stilts that have walked in the mud, and mirror flats that
    reflect a path which is not there.

    Its palette is the opposite of the Delve's: no ember, no iron, no
    lamp. Pale glass, wet green, bog brown, and witchlight, which is the
    only light in the Fen that anything made on purpose.
]]

local MireglassBuilder = {}

local WATER = Color3.fromRGB(46, 66, 68)
local DEEP_WATER = Color3.fromRGB(28, 44, 48)
local REED = Color3.fromRGB(96, 118, 72)
local DRY_REED = Color3.fromRGB(140, 132, 84)
local BOG = Color3.fromRGB(58, 52, 40)
local PLANK = Color3.fromRGB(104, 88, 66)
local DARK_PLANK = Color3.fromRGB(68, 56, 42)
local MIREGLASS = Color3.fromRGB(186, 206, 210)
local WITCHLIGHT = Color3.fromRGB(146, 214, 226)
local BOG_IRON = Color3.fromRGB(96, 74, 58)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function glow(
    parent: Instance,
    name: string,
    position: Vector3,
    size: number,
    color: Color3,
    brightness: number
): Part
    local orb = part(
        parent,
        name,
        Vector3.new(size, size, size),
        CFrame.new(position),
        color,
        Enum.Material.Neon,
        false
    )
    orb.Shape = Enum.PartType.Ball
    orb.CanQuery = false
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = size * 7
    light.Brightness = brightness
    light.Shadows = false
    light.Parent = orb
    return light.Parent :: Part
end

--[[
    The sheet of water a module stands in. Reflectance is the point: this
    is what makes the Fen's ground a claim rather than a fact.
]]
local function fenWater(parent: Instance, center: Vector3, size: number, mirrored: boolean)
    local water = part(
        parent,
        "FenWater",
        Vector3.new(size, 0.8, size),
        CFrame.new(center + Vector3.new(0, 0.4, 0)),
        if mirrored then WATER else DEEP_WATER,
        Enum.Material.Glass,
        false
    )
    water.Transparency = if mirrored then 0.25 else 0.4
    water.Reflectance = if mirrored then 0.75 else 0.3
    water.CanQuery = false
end

local function reedStand(parent: Instance, center: Vector3, count: number, seed: number)
    for index = 0, count - 1 do
        local drift = (seed + index * 29) % 13 - 6
        local at = center + Vector3.new(drift * 0.9, 0, ((index % 5) - 2) * 1.4)
        part(
            parent,
            "Reed",
            Vector3.new(0.22, 5.5 + (index % 4), 0.22),
            CFrame.new(at + Vector3.new(0, 2.8, 0))
                * CFrame.Angles(math.rad(drift * 1.6), 0, math.rad(drift * 2.2)),
            if index % 3 == 0 then DRY_REED else REED,
            Enum.Material.Grass,
            false
        )
    end
end

-- A plank walk: the Fen's only honest ground, and it always runs out.
local function boardwalk(parent: Instance, center: Vector3, length: number, stopShort: boolean)
    local run = if stopShort then length * 0.6 else length
    part(
        parent,
        "Boardwalk",
        Vector3.new(6, 0.5, run),
        CFrame.new(center + Vector3.new(0, 1.4, -(length - run) * 0.5)),
        PLANK,
        Enum.Material.Wood
    )
    local posts = math.max(2, math.floor(run / 6))
    for index = 0, posts do
        for side = -1, 1, 2 do
            part(
                parent,
                "WalkPost",
                Vector3.new(0.6, 3, 0.6),
                CFrame.new(
                    center
                        + Vector3.new(
                            side * 2.4,
                            0,
                            -(length - run) * 0.5 - run * 0.5 + index * (run / posts)
                        )
                ),
                DARK_PLANK,
                Enum.Material.Wood
            )
        end
    end
end

-- A house on stilts, leaning the way the mud took it.
local function stiltHouse(parent: Instance, center: Vector3, lean: number)
    local body = part(
        parent,
        "StiltHouse",
        Vector3.new(11, 8, 9),
        CFrame.new(center + Vector3.new(0, 7.5, 0)) * CFrame.Angles(0, 0, math.rad(lean)),
        PLANK,
        Enum.Material.Wood
    )
    part(
        parent,
        "StiltRoof",
        Vector3.new(13, 1.2, 11),
        body.CFrame * CFrame.new(0, 4.4, 0),
        DARK_PLANK,
        Enum.Material.Wood,
        false
    )
    for side = -1, 1, 2 do
        for run = -1, 1, 2 do
            part(
                parent,
                "Stilt",
                Vector3.new(0.9, 8, 0.9),
                CFrame.new(center + Vector3.new(side * 4, 3.6, run * 3.4))
                    * CFrame.Angles(0, 0, math.rad(lean * 0.6)),
                DARK_PLANK,
                Enum.Material.Wood
            )
        end
    end
end

-- Mireglass itself: sheets of the stuff standing where the bog cooled.
local function glassSheet(parent: Instance, center: Vector3, height: number, tilt: number)
    local sheet = part(
        parent,
        "MireglassSheet",
        Vector3.new(6, height, 0.6),
        CFrame.new(center + Vector3.new(0, height * 0.5, 0)) * CFrame.Angles(0, tilt, math.rad(4)),
        MIREGLASS,
        Enum.Material.Glass
    )
    sheet.Transparency = 0.35
    sheet.Reflectance = 0.6
end

local function witchLantern(parent: Instance, position: Vector3)
    part(
        parent,
        "LanternPole",
        Vector3.new(0.4, 6, 0.4),
        CFrame.new(position + Vector3.new(0, 3, 0)),
        DARK_PLANK,
        Enum.Material.Wood
    )
    glow(parent, "Witchlight", position + Vector3.new(0, 6.2, 0), 1.2, WITCHLIGHT, 1.8)
end

local function puntBoat(parent: Instance, position: Vector3, facing: number, upturned: boolean)
    local hull = part(
        parent,
        "PuntHull",
        Vector3.new(3.6, 1.4, 11),
        CFrame.new(position + Vector3.new(0, 1.2, 0))
            * CFrame.Angles(if upturned then math.rad(180) else 0, facing, 0),
        PLANK,
        Enum.Material.Wood
    )
    part(
        parent,
        "PuntPole",
        Vector3.new(0.3, 0.3, 12),
        hull.CFrame * CFrame.new(1.6, 1.2, 0) * CFrame.Angles(math.rad(72), 0, 0),
        DARK_PLANK,
        Enum.Material.Wood,
        false
    )
end

-- A reed mat: floating ground that may or may not hold.
local function reedMat(parent: Instance, center: Vector3, size: number)
    local mat = part(
        parent,
        "ReedMat",
        Vector3.new(size, 0.5, size * 0.8),
        CFrame.new(center + Vector3.new(0, 0.9, 0)),
        REED,
        Enum.Material.Grass
    )
    mat.Transparency = 0.05
    for index = -1, 1 do
        part(
            parent,
            "MatFringe",
            Vector3.new(size * 0.9, 0.3, 1.2),
            CFrame.new(center + Vector3.new(index * 1.2, 0.7, index * size * 0.35)),
            DRY_REED,
            Enum.Material.Grass,
            false
        )
    end
end

local function bogIronPit(parent: Instance, center: Vector3)
    local pit = part(
        parent,
        "BogPit",
        Vector3.new(9, 1.2, 9),
        CFrame.new(center + Vector3.new(0, 0.6, 0)),
        BOG,
        Enum.Material.Ground
    )
    pit.Transparency = 0.05
    for index = 0, 3 do
        local angle = index * math.pi * 0.5
        part(
            parent,
            "BogIronLump",
            Vector3.new(1.8, 1.4, 1.8),
            CFrame.new(center + Vector3.new(math.cos(angle) * 2.6, 1.3, math.sin(angle) * 2.6)),
            BOG_IRON,
            Enum.Material.Metal,
            false
        )
    end
end

--[[
    The Fen's floor: wet ground with standing water over most of it, and
    a bank of bog at the edges so the module has a shape.
]]
local function fenGround(parent: Instance, center: Vector3)
    local ground = part(
        parent,
        "FenGround",
        Vector3.new(56, 1, 56),
        CFrame.new(center + Vector3.new(0, 0.2, 0)),
        BOG,
        Enum.Material.Ground,
        false
    )
    ground.CanQuery = false
    for side = -1, 1, 2 do
        part(
            parent,
            "FenBank",
            Vector3.new(6, 2.4, 46),
            CFrame.new(center + Vector3.new(side * 25, 1.2, 0))
                * CFrame.Angles(0, 0, math.rad(side * 3)),
            BOG,
            Enum.Material.Ground
        )
    end
end

--[[
    Assemble one module's visual. Same contract as the Delve's builder:
    an unknown key returns false, and the region cannot open until every
    key its catalog declares has a case here.
]]
function MireglassBuilder.buildModuleVisual(
    parent: Instance,
    visual: string,
    center: Vector3
): boolean
    if visual == "ferry_landing" then
        fenGround(parent, center)
        fenWater(parent, center + Vector3.new(0, 0, -10), 34, true)
        boardwalk(parent, center + Vector3.new(0, 0, 6), 26, false)
        puntBoat(parent, center + Vector3.new(-7, 0, -10), math.rad(12), false)
        witchLantern(parent, center + Vector3.new(6, 0, 2))
        return true
    elseif visual == "dry_causeway" then
        fenGround(parent, center)
        -- The way out is the one raised road the water never took.
        part(
            parent,
            "Causeway",
            Vector3.new(12, 3, 50),
            CFrame.new(center + Vector3.new(0, 1.6, 0)),
            BOG,
            Enum.Material.Ground
        )
        fenWater(parent, center + Vector3.new(-18, 0, 0), 18, true)
        fenWater(parent, center + Vector3.new(18, 0, 0), 18, true)
        witchLantern(parent, center + Vector3.new(0, 3, -14))
        return true
    elseif visual == "reed_harvest" then
        fenGround(parent, center)
        fenWater(parent, center, 40, false)
        for index = -1, 1 do
            reedStand(parent, center + Vector3.new(index * 9, 0, index * 5), 14, 11 + index)
        end
        boardwalk(parent, center + Vector3.new(0, 0, 12), 20, false)
        return true
    elseif visual == "bog_iron_pits" then
        fenGround(parent, center)
        bogIronPit(parent, center + Vector3.new(-8, 0, -4))
        bogIronPit(parent, center + Vector3.new(7, 0, 6))
        fenWater(parent, center + Vector3.new(0, 0, 14), 22, false)
        reedStand(parent, center + Vector3.new(12, 0, -10), 8, 5)
        return true
    elseif visual == "pollen_hollow" then
        fenGround(parent, center)
        fenWater(parent, center, 30, false)
        for index = 0, 5 do
            local angle = index * math.pi / 3
            glow(
                parent,
                "WitchlightPollen",
                center + Vector3.new(math.cos(angle) * 8, 3 + (index % 3), math.sin(angle) * 8),
                1.4,
                WITCHLIGHT,
                1.2
            )
        end
        reedStand(parent, center + Vector3.new(0, 0, -12), 12, 23)
        return true
    elseif visual == "eel_weirs" then
        fenGround(parent, center)
        fenWater(parent, center, 44, false)
        for index = -1, 1 do
            part(
                parent,
                "WeirGate",
                Vector3.new(14, 4, 0.8),
                CFrame.new(center + Vector3.new(0, 2, index * 12)),
                DARK_PLANK,
                Enum.Material.Wood
            )
        end
        boardwalk(parent, center + Vector3.new(9, 0, 0), 34, false)
        return true
    elseif visual == "herb_shallows" then
        fenGround(parent, center)
        fenWater(parent, center, 38, true)
        for index = 0, 7 do
            local angle = index * math.pi * 0.25
            part(
                parent,
                "BlackwaterHerb",
                Vector3.new(1.6, 0.4, 1.6),
                CFrame.new(center + Vector3.new(math.cos(angle) * 9, 1, math.sin(angle) * 9)),
                Color3.fromRGB(44, 62, 44),
                Enum.Material.Grass,
                false
            )
        end
        reedMat(parent, center + Vector3.new(0, 0, 10), 9)
        return true
    elseif visual == "glass_flats" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        for index = -2, 2 do
            glassSheet(
                parent,
                center + Vector3.new(index * 7, 0, index % 2 * 6 - 3),
                7 + index,
                math.rad(index * 22)
            )
        end
        return true
    elseif visual == "drowned_orchard" then
        fenGround(parent, center)
        fenWater(parent, center, 42, true)
        for index = -1, 1 do
            for run = -1, 1 do
                part(
                    parent,
                    "DrownedTree",
                    Vector3.new(1.4, 12, 1.4),
                    CFrame.new(center + Vector3.new(index * 9, 5.5, run * 9))
                        * CFrame.Angles(math.rad(index * 4), 0, math.rad(run * 5)),
                    DARK_PLANK,
                    Enum.Material.Wood
                )
            end
        end
        return true
    elseif visual == "reed_mat_crossing" then
        fenGround(parent, center)
        fenWater(parent, center, 46, false)
        for index = -2, 2 do
            reedMat(parent, center + Vector3.new(index * 8, 0, index % 2 * 5), 8)
        end
        return true
    elseif visual == "stepping_stones" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        for index = -3, 3 do
            part(
                parent,
                "SteppingStone",
                Vector3.new(3.4, 1.6, 3.4),
                CFrame.new(center + Vector3.new(index * 5.5, 1.1, (index % 2) * 4 - 2))
                    * CFrame.Angles(0, math.rad(index * 14), 0),
                Color3.fromRGB(76, 78, 74),
                Enum.Material.Slate
            )
        end
        return true
    elseif visual == "mirror_ford" then
        fenGround(parent, center)
        fenWater(parent, center, 50, true)
        -- The ford's trick: a line of glass that shows a crossing which
        -- is one step to the left of the real one.
        for index = -2, 2 do
            glassSheet(parent, center + Vector3.new(index * 6, 0, 4), 6, math.rad(90))
        end
        for index = -2, 2 do
            part(
                parent,
                "FordStone",
                Vector3.new(3, 1.4, 3),
                CFrame.new(center + Vector3.new(index * 6 - 3, 1, -4)),
                Color3.fromRGB(76, 78, 74),
                Enum.Material.Slate
            )
        end
        return true
    elseif visual == "sunken_boardwalk" then
        fenGround(parent, center)
        fenWater(parent, center, 44, false)
        boardwalk(parent, center, 44, false)
        boardwalk(parent, center + Vector3.new(11, -1.2, 4), 30, true)
        return true
    elseif visual == "leaning_house_row" then
        fenGround(parent, center)
        fenWater(parent, center, 44, true)
        stiltHouse(parent, center + Vector3.new(-11, 0, -6), 7)
        stiltHouse(parent, center + Vector3.new(2, 0, 4), -5)
        stiltHouse(parent, center + Vector3.new(13, 0, -8), 11)
        boardwalk(parent, center + Vector3.new(0, 0, 12), 34, false)
        return true
    elseif visual == "fog_bank" then
        fenGround(parent, center)
        fenWater(parent, center, 46, false)
        for index = -1, 1 do
            local fog = part(
                parent,
                "FogBank",
                Vector3.new(30, 9, 14),
                CFrame.new(center + Vector3.new(index * 6, 5, index * 9)),
                Color3.fromRGB(196, 206, 202),
                Enum.Material.Neon,
                false
            )
            fog.Transparency = 0.88
            fog.CanQuery = false
        end
        reedStand(parent, center + Vector3.new(-12, 0, 8), 10, 31)
        return true
    elseif visual == "lurker_shallows" then
        fenGround(parent, center)
        fenWater(parent, center, 46, false)
        reedStand(parent, center + Vector3.new(-8, 0, -6), 16, 3)
        reedStand(parent, center + Vector3.new(9, 0, 7), 16, 19)
        reedMat(parent, center + Vector3.new(0, 0, 0), 10)
        return true
    elseif visual == "mirror_court" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        -- Three mirrors around a floor, which is the Many-Face's fight.
        for index = 0, 2 do
            local angle = index * math.pi * (2 / 3)
            glassSheet(
                parent,
                center + Vector3.new(math.cos(angle) * 12, 0, math.sin(angle) * 12),
                9,
                angle + math.pi * 0.5
            )
            witchLantern(parent, center + Vector3.new(math.cos(angle) * 8, 0, math.sin(angle) * 8))
        end
        return true
    elseif visual == "leech_pools" then
        fenGround(parent, center)
        for index = -1, 1 do
            fenWater(parent, center + Vector3.new(index * 12, 0, index % 2 * 8 - 4), 14, false)
        end
        reedStand(parent, center + Vector3.new(0, 0, 12), 10, 43)
        return true
    elseif visual == "heron_reach" then
        fenGround(parent, center)
        fenWater(parent, center, 48, true)
        -- Open water and long sightlines: the heron's exact line needs
        -- somewhere to be drawn.
        boardwalk(parent, center + Vector3.new(-14, 0, 0), 40, false)
        reedStand(parent, center + Vector3.new(14, 0, -8), 8, 7)
        return true
    elseif visual == "bell_marsh" then
        fenGround(parent, center)
        fenWater(parent, center, 46, false)
        -- Four reflected pools around a bell post: the Drowned Caller's
        -- doors, standing where the fight will need them.
        for index = 0, 3 do
            local angle = index * math.pi * 0.5
            fenWater(
                parent,
                center + Vector3.new(math.cos(angle) * 13, 0, math.sin(angle) * 13),
                10,
                true
            )
            witchLantern(parent, center + Vector3.new(math.cos(angle) * 9, 0, math.sin(angle) * 9))
        end
        part(
            parent,
            "BellPost",
            Vector3.new(0.8, 10, 0.8),
            CFrame.new(center + Vector3.new(0, 5, 0)),
            DARK_PLANK,
            Enum.Material.Wood
        )
        return true
    elseif visual == "low_dyke" then
        fenGround(parent, center)
        part(
            parent,
            "Dyke",
            Vector3.new(10, 2.6, 48),
            CFrame.new(center + Vector3.new(0, 1.5, 0)),
            BOG,
            Enum.Material.Ground
        )
        fenWater(parent, center + Vector3.new(-16, 0, 0), 16, false)
        fenWater(parent, center + Vector3.new(16, 0, 0), 16, true)
        return true
    elseif visual == "punt_channel" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        puntBoat(parent, center + Vector3.new(-4, 0, 2), 0, false)
        puntBoat(parent, center + Vector3.new(8, 0, -6), math.rad(24), true)
        boardwalk(parent, center + Vector3.new(-13, 0, 0), 34, false)
        return true
    elseif visual == "willow_gate" then
        fenGround(parent, center)
        fenWater(parent, center + Vector3.new(0, 0, 8), 26, true)
        for side = -1, 1, 2 do
            part(
                parent,
                "WillowTrunk",
                Vector3.new(2.6, 14, 2.6),
                CFrame.new(center + Vector3.new(side * 7, 7, -6))
                    * CFrame.Angles(0, 0, math.rad(side * -8)),
                DARK_PLANK,
                Enum.Material.Wood
            )
            for index = 0, 4 do
                part(
                    parent,
                    "WillowFrond",
                    Vector3.new(0.3, 7, 0.3),
                    CFrame.new(center + Vector3.new(side * (5 + index), 9, -6 + index)),
                    REED,
                    Enum.Material.Grass,
                    false
                )
            end
        end
        return true
    elseif visual == "stilt_junction" then
        fenGround(parent, center)
        fenWater(parent, center, 44, true)
        boardwalk(parent, center, 40, false)
        boardwalk(parent, center + Vector3.new(0, 0, 0), 22, false)
        stiltHouse(parent, center + Vector3.new(-12, 0, 8), 4)
        witchLantern(parent, center + Vector3.new(6, 1.4, 0))
        return true
    elseif visual == "ferryman_shack" then
        fenGround(parent, center)
        fenWater(parent, center + Vector3.new(0, 0, -10), 28, true)
        stiltHouse(parent, center + Vector3.new(0, 0, 4), 3)
        boardwalk(parent, center + Vector3.new(0, 0, -8), 22, false)
        puntBoat(parent, center + Vector3.new(-8, 0, -12), math.rad(-14), false)
        witchLantern(parent, center + Vector3.new(7, 0, -4))
        return true
    elseif visual == "wake_platform" then
        fenGround(parent, center)
        fenWater(parent, center, 40, true)
        part(
            parent,
            "WakePlatform",
            Vector3.new(16, 1, 16),
            CFrame.new(center + Vector3.new(0, 1.6, 0)),
            PLANK,
            Enum.Material.Wood
        )
        for index = 0, 5 do
            local angle = index * math.pi / 3
            witchLantern(
                parent,
                center + Vector3.new(math.cos(angle) * 6.5, 1.6, math.sin(angle) * 6.5)
            )
        end
        return true
    elseif visual == "sunken_chapel" then
        fenGround(parent, center)
        fenWater(parent, center, 44, true)
        -- A chapel the water took to the windows.
        part(
            parent,
            "ChapelWall",
            Vector3.new(16, 9, 0.9),
            CFrame.new(center + Vector3.new(0, 4, -7)),
            Color3.fromRGB(88, 88, 82),
            Enum.Material.Slate
        )
        for side = -1, 1, 2 do
            part(
                parent,
                "ChapelSide",
                Vector3.new(0.9, 9, 14),
                CFrame.new(center + Vector3.new(side * 8, 4, 0)),
                Color3.fromRGB(88, 88, 82),
                Enum.Material.Slate
            )
            glassSheet(parent, center + Vector3.new(side * 7.4, 3.5, -2), 4, math.rad(90))
        end
        witchLantern(parent, center + Vector3.new(0, 1, 4))
        return true
    elseif visual == "reflection_locks" then
        fenGround(parent, center)
        fenWater(parent, center, 46, true)
        -- Three mirrors and three stones: the puzzle is telling which is
        -- which, so both have to be legible from the same standing spot.
        for index = -1, 1 do
            glassSheet(parent, center + Vector3.new(index * 9, 0, -6), 8, math.rad(90))
            part(
                parent,
                "LockStone",
                Vector3.new(3, 2, 3),
                CFrame.new(center + Vector3.new(index * 9, 1.4, 6)),
                Color3.fromRGB(76, 78, 74),
                Enum.Material.Slate
            )
        end
        return true
    elseif visual == "tide_gates" then
        fenGround(parent, center)
        fenWater(parent, center + Vector3.new(0, 0, 12), 26, false)
        fenWater(parent, center + Vector3.new(0, 0, -12), 26, true)
        for side = -1, 1, 2 do
            part(
                parent,
                "TideGate",
                Vector3.new(11, 8, 1.2),
                CFrame.new(center + Vector3.new(side * 7, 4, 0)),
                DARK_PLANK,
                Enum.Material.Wood
            )
            local wheel = part(
                parent,
                "TideWheel",
                Vector3.new(0.8, 3.2, 3.2),
                CFrame.new(center + Vector3.new(side * 7, 9, 0)),
                BOG_IRON,
                Enum.Material.Metal,
                false
            )
            wheel.Shape = Enum.PartType.Cylinder
        end
        return true
    elseif visual == "witch_approach" then
        fenGround(parent, center)
        fenWater(parent, center, 50, true)
        -- Her ring of lights, hanging at head height, with the boardwalk
        -- running into it and stopping.
        for index = 0, 7 do
            local angle = index * math.pi * 0.25
            witchLantern(
                parent,
                center + Vector3.new(math.cos(angle) * 15, 2.5, math.sin(angle) * 15)
            )
        end
        boardwalk(parent, center + Vector3.new(0, 0, 14), 30, true)
        glassSheet(parent, center + Vector3.new(0, 0, -12), 11, 0)
        return true
    end
    return false
end

MireglassBuilder.Primitives = table.freeze({
    fenWater = fenWater,
    reedStand = reedStand,
    boardwalk = boardwalk,
    stiltHouse = stiltHouse,
    glassSheet = glassSheet,
    witchLantern = witchLantern,
    puntBoat = puntBoat,
    reedMat = reedMat,
    bogIronPit = bogIronPit,
    fenGround = fenGround,
})

return table.freeze(MireglassBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">OldGrowthBuilder</string>
            <string name="Source"><![CDATA[--!strict

local OldGrowthBuilder = {}

local function part(
    parent: Model,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?
): Part
    local item = Instance.new("Part")
    item.Name = name
    item.Size = size
    item.CFrame = cframe
    item.Color = color
    item.Material = material
    item.Shape = shape or Enum.PartType.Block
    item.Anchored = true
    item.CanCollide = false
    item.CanTouch = false
    item.CastShadow = true
    item.TopSurface = Enum.SurfaceType.Smooth
    item.BottomSurface = Enum.SurfaceType.Smooth
    item.Parent = parent
    return item
end

function OldGrowthBuilder.build(origin: Vector3, target: Vector3, maxHealth: number): Model
    local model = Instance.new("Model")
    model.Name = "OldGrowthElite"
    model:SetAttribute("EliteId", "elite_old_growth")
    model:SetAttribute("EliteDisplayName", "Old Growth")
    model:SetAttribute("EliteHealth", maxHealth)
    model:SetAttribute("EliteMaxHealth", maxHealth)
    model:SetAttribute("EliteShielded", false)

    local core = part(
        model,
        "AncientTrunk",
        Vector3.new(10, 18, 10),
        CFrame.new(origin + Vector3.new(0, 9, 0)),
        Color3.fromRGB(57, 39, 31),
        Enum.Material.Wood,
        Enum.PartType.Ball
    )
    model.PrimaryPart = core

    part(
        model,
        "BarkCrown",
        Vector3.new(13, 7, 9),
        CFrame.new(origin + Vector3.new(0, 19, 0)),
        Color3.fromRGB(45, 72, 48),
        Enum.Material.Grass,
        Enum.PartType.Ball
    )
    for index = 1, 5 do
        local angle = (index / 5) * math.pi * 2
        part(
            model,
            "CanopyMass",
            Vector3.new(8, 6, 8),
            CFrame.new(
                origin + Vector3.new(math.cos(angle) * 7, 20 + (index % 2) * 3, math.sin(angle) * 7)
            ),
            if index % 2 == 0 then Color3.fromRGB(58, 91, 55) else Color3.fromRGB(38, 68, 48),
            Enum.Material.Grass,
            Enum.PartType.Ball
        )
    end

    for side = -1, 1, 2 do
        part(
            model,
            "CathedralArm",
            Vector3.new(3, 15, 3),
            CFrame.new(origin + Vector3.new(side * 7, 11, 0))
                * CFrame.Angles(0, 0, math.rad(side * 35)),
            Color3.fromRGB(70, 48, 34),
            Enum.Material.Wood,
            nil
        )
        part(
            model,
            "RootFoot",
            Vector3.new(3.2, 3.2, 13),
            CFrame.new(origin + Vector3.new(side * 4.5, 1.4, 3))
                * CFrame.Angles(0, math.rad(side * 18), 0),
            Color3.fromRGB(68, 45, 32),
            Enum.Material.Wood,
            nil
        )
        part(
            model,
            "OldEye",
            Vector3.new(0.9, 0.9, 0.45),
            CFrame.new(origin + Vector3.new(side * 1.7, 11.5, -5)),
            Color3.fromRGB(112, 214, 174),
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
    end

    local heart = part(
        model,
        "AmberHeart",
        Vector3.new(3.8, 5.4, 1.5),
        CFrame.new(origin + Vector3.new(0, 7.5, -5.15)),
        Color3.fromRGB(255, 187, 76),
        Enum.Material.Neon,
        Enum.PartType.Ball
    )
    heart:SetAttribute("WeakPoint", true)
    -- The heart is the strike target and sits in the authored mesh's hollow
    -- chest by design. Without this flag the enemy-visual pass blanks it and
    -- clears its CanQuery when the mesh loads, which makes the encounter
    -- uncompletable: the line-of-sight ray can never hit a query-off part.
    heart:SetAttribute("KeepVisibleOnReplacement", true)

    local highlight = Instance.new("Highlight")
    highlight.Name = "EliteOutline"
    highlight.FillColor = Color3.fromRGB(55, 83, 57)
    highlight.FillTransparency = 0.82
    highlight.OutlineColor = Color3.fromRGB(255, 187, 76)
    highlight.OutlineTransparency = 0.12
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = model

    local flatTarget = Vector3.new(target.X, core.Position.Y, target.Z)
    if (flatTarget - core.Position).Magnitude > 0.01 then
        model:PivotTo(CFrame.lookAt(core.Position, flatTarget))
    end
    return model
end

function OldGrowthBuilder.setState(model: Model, health: number, shielded: boolean, marked: boolean)
    model:SetAttribute("EliteHealth", math.max(0, health))
    model:SetAttribute("EliteShielded", shielded)
    model:SetAttribute("LastLightMarked", marked)
    local heart = model:FindFirstChild("AmberHeart")
    if heart ~= nil and heart:IsA("BasePart") then
        heart.Color = if shielded
            then Color3.fromRGB(92, 118, 91)
            elseif marked then Color3.fromRGB(255, 222, 112)
            else Color3.fromRGB(255, 187, 76)
        heart.Material = if shielded then Enum.Material.SmoothPlastic else Enum.Material.Neon
        heart.Transparency = if shielded then 0.34 else 0
    end
    local highlight = model:FindFirstChild("EliteOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        highlight.OutlineColor = if shielded
            then Color3.fromRGB(112, 155, 119)
            elseif marked then Color3.fromRGB(255, 222, 112)
            else Color3.fromRGB(255, 187, 76)
        highlight.FillTransparency = if marked then 0.62 else 0.82
    end
    if model:GetAttribute("EnemyVisualReady") == true then
        local authored = model:FindFirstChild("AuthoredEnemyVisual")
        for _, descendant in model:GetDescendants() do
            if
                descendant:IsA("BasePart")
                and (authored == nil or not descendant:IsDescendantOf(authored))
            then
                descendant.Transparency = 1
                descendant.CastShadow = false
            end
        end
    end
end

return table.freeze(OldGrowthBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">RegionBuilders</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Which builder draws which region, and what a region still owes before
    it can be walked.

    Bramblewake's builder does everything: module visuals, points of
    interest, event sockets, resource nodes, the elite arena, the boss
    annex, the Blackout layer, mesh dressing, wayfinding. The Delve's and
    the Fen's builders currently do one of those things -- module visuals
    -- and pretending otherwise is how a region ships as an empty grid
    with a name.

    So this registry records both halves: the builder, and the honest
    list of what that region has yet to grow. `readiness` is the answer
    to "could a party walk this today", and nothing but a builder gaining
    the missing pieces should ever change it.
]]

local BramblewakeBuilder = require(script.Parent.BramblewakeBuilder)
local IronrootBuilder = require(script.Parent.IronrootBuilder)
local MireglassBuilder = require(script.Parent.MireglassBuilder)

local RegionBuilders = {}

export type Readiness = {
    regionId: string,
    walkable: boolean,
    -- What the region still owes, in the order it will be built.
    missing: { string },
}

local ENTRIES: { [string]: any } = {
    region_bramblewake = {
        builder = BramblewakeBuilder,
        walkable = true,
        missing = {},
    },
    region_ironroot = {
        builder = IronrootBuilder,
        walkable = false,
        -- Mesh dressing is an art pass: authored assets, not wiring.
        -- Everything a party needs to walk the region is built.
        missing = {
            "authored mesh dressing",
        },
    },
    region_mireglass = {
        builder = MireglassBuilder,
        walkable = false,
        -- Mesh dressing is an art pass: authored assets, not wiring.
        -- Everything a party needs to walk the region is built.
        missing = {
            "authored mesh dressing",
        },
    },
}

function RegionBuilders.get(regionId: any): any
    return if type(regionId) == "string" then (ENTRIES[regionId] or {}).builder else nil
end

function RegionBuilders.readiness(regionId: any): Readiness
    local entry = if type(regionId) == "string" then ENTRIES[regionId] else nil
    if entry == nil then
        return { regionId = tostring(regionId), walkable = false, missing = { "unknown region" } }
    end
    return {
        regionId = regionId :: string,
        walkable = entry.walkable == true,
        missing = table.clone(entry.missing),
    }
end

function RegionBuilders.ids(): { string }
    local ids: { string } = {}
    for regionId in ENTRIES do
        table.insert(ids, regionId)
    end
    table.sort(ids)
    return ids
end

--[[
    Draw one region's modules from a manifest.

    This is the shared half of expedition assembly: a model per placement,
    the attributes the world and its tests read, the streaming cell, and
    the region's own visual for the module. It is deliberately not the
    whole of Bramblewake's builder -- that one also plants POIs, events,
    nodes and arenas, and each of those is its own wave for a new region.

    Returns the module models it made, so a caller can keep building on
    top of them, and the count of visuals the region's builder actually
    knew how to draw.
]]
function RegionBuilders.buildModules(
    parent: Instance,
    manifest: any,
    generator: any,
    catalog: any,
    origin: Vector3
): (number, number)
    local builder = RegionBuilders.get(manifest.regionId)
    assert(builder ~= nil, "no builder for region " .. tostring(manifest.regionId))
    assert(
        type(builder.buildModuleVisual) == "function",
        tostring(manifest.regionId) .. " has no module visual builder"
    )

    local drawn = 0
    for _, placement in manifest.modules do
        local definition = generator.moduleDefinition(placement.moduleId)
        local center = origin
            + Vector3.new(placement.cellX * catalog.CellSize, 0, placement.cellZ * catalog.CellSize)
        local module = Instance.new("Model")
        module.Name = string.format("Module_%02d", placement.index)
        module:SetAttribute("ContentId", placement.moduleId)
        module:SetAttribute("DisplayName", definition.displayName)
        module:SetAttribute("SequenceIndex", placement.index)
        module:SetAttribute("CellX", placement.cellX)
        module:SetAttribute("CellZ", placement.cellZ)
        module.Parent = parent
        if builder.buildModuleVisual(module, definition.visual, center) then
            drawn += 1
        end
    end
    return #manifest.modules, drawn
end

--[[
    Resource nodes for a region that has none yet.

    Bramblewake grows its own inside its builder, tangled with mesh
    dressing and ambient light tags. A new region needs the same contract
    -- an anchor part, an interaction id, the material it pays, the words
    the prompt says -- without inheriting the forest's dressing, so this
    plants them from the region's own material list and hands the
    descriptors back for the caller to register as prompts.

    Two per module from the second module on, which is the cadence
    Bramblewake settled on: the arrival module stays clean so a party's
    first look at a region is the region and not a shopping list.
]]
function RegionBuilders.buildResourceNodes(
    modules: { Instance },
    manifest: any,
    catalog: any,
    origin: Vector3,
    materials: { { id: string, label: string, color: Color3 } },
    prefix: string
): { any }
    local descriptors = {}
    for index, placement in manifest.modules do
        if index >= 2 and modules[index] ~= nil then
            local center = origin
                + Vector3.new(
                    placement.cellX * catalog.CellSize,
                    0,
                    placement.cellZ * catalog.CellSize
                )
            for slot = 1, 2 do
                local material = materials[((index + slot) % #materials) + 1]
                local side = if slot == 1 then -1 else 1
                local at = center + Vector3.new(side * (15 + (index % 3) * 2), 0, (slot - 1.5) * 18)
                local anchor = Instance.new("Part")
                anchor.Name = material.label .. "Node"
                anchor.Size = Vector3.new(5, 7, 5)
                anchor.CFrame = CFrame.new(at + Vector3.new(0, 3.5, 0))
                anchor.Anchored = true
                anchor.CanCollide = false
                anchor.CanTouch = false
                anchor.Transparency = 1
                anchor.Parent = modules[index]

                -- Small and quiet, for the reason Bramblewake learned the
                -- hard way: a resource cue should be findable when looked
                -- for, never the loudest thing on the screen.
                local cue = Instance.new("Part")
                cue.Name = "ResourceGlow"
                cue.Shape = Enum.PartType.Ball
                cue.Size = Vector3.new(0.7, 0.7, 0.7)
                cue.CFrame = CFrame.new(at + Vector3.new(0, 3.2, 0))
                cue.Color = material.color
                cue.Material = Enum.Material.Neon
                cue.Anchored = true
                cue.CanCollide = false
                cue.CanQuery = false
                cue.CastShadow = false
                cue.Transparency = 0.8
                cue.Parent = modules[index]

                table.insert(descriptors, {
                    target = anchor,
                    interactionId = string.format("node_%s_%d_%d", prefix, index, slot),
                    materialId = material.id,
                    objectText = material.label,
                })
            end
        end
    end
    return descriptors
end

--[[
    The materials each region pays out of its own ground, in the order
    its nodes cycle them. Kept beside the builders because it is a fact
    about the region's world, not about its economy: what a node is made
    of is what the player sees before they harvest it.
]]
RegionBuilders.NodeMaterials = table.freeze({
    region_ironroot = table.freeze({
        table.freeze({
            id = "material_ironroot_ore",
            label = "Ironroot Ore",
            color = Color3.fromRGB(196, 142, 58),
        }),
        table.freeze({
            id = "material_coalglass",
            label = "Coalglass",
            color = Color3.fromRGB(255, 168, 66),
        }),
        table.freeze({
            id = "material_glow_fungus",
            label = "Glow Fungus",
            color = Color3.fromRGB(150, 226, 176),
        }),
    }),
    region_mireglass = table.freeze({
        table.freeze({
            id = "material_mirror_reed",
            label = "Mirror Reed",
            color = Color3.fromRGB(186, 206, 210),
        }),
        table.freeze({
            id = "material_bog_iron",
            label = "Bog Iron",
            color = Color3.fromRGB(146, 118, 92),
        }),
        table.freeze({
            id = "material_witchlight_pollen",
            label = "Witchlight Pollen",
            color = Color3.fromRGB(146, 214, 226),
        }),
    }),
})

local CollectionService = game:GetService("CollectionService")

--[[
    Points of interest and event sockets for a region that has neither.

    Both are anchors with words on them: a POI says what a place is, an
    event socket says what is about to be asked of you and how far along
    it is. Bramblewake dresses them heavily -- cairns, icons, billboards
    tuned over several waves. A new region gets the anchor, the
    attributes, and the tag, which is everything the runtime and the
    tests read; its own dressing is an art pass, not a wiring one, and
    saying so is better than faking it.
]]
local function labelled(parent: Instance, text: string, color: Color3)
    local gui = Instance.new("BillboardGui")
    gui.Name = "Label"
    gui.Size = UDim2.fromOffset(220, 40)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
    gui.AlwaysOnTop = false
    gui.MaxDistance = 140
    gui.Parent = parent
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.Text = string.upper(text)
    label.TextColor3 = color
    label.TextScaled = true
    label.TextStrokeTransparency = 0.4
    label.Parent = gui
end

function RegionBuilders.buildPointsOfInterest(
    modules: { Instance },
    manifest: any,
    generator: any,
    catalog: any,
    origin: Vector3,
    color: Color3
): number
    local placed = 0
    for index, placement in manifest.modules do
        if placement.poiId ~= nil and modules[index] ~= nil then
            local definition = generator.pointOfInterestDefinition(placement.poiId)
            local center = origin
                + Vector3.new(
                    placement.cellX * catalog.CellSize,
                    0,
                    placement.cellZ * catalog.CellSize
                )
            local anchor = Instance.new("Part")
            anchor.Name = "PointOfInterest"
            anchor.Size = Vector3.new(8, 1, 8)
            anchor.CFrame = CFrame.new(center + Vector3.new(-21, 0.5, 18))
            anchor.Anchored = true
            anchor.CanCollide = false
            anchor.CanTouch = false
            anchor.Transparency = 1
            anchor.CastShadow = false
            anchor:SetAttribute("ContentId", definition.id)
            anchor:SetAttribute("DisplayName", definition.displayName)
            anchor:SetAttribute("Detail", definition.detail)
            anchor.Parent = modules[index]
            labelled(anchor, definition.displayName, color)
            placed += 1
        end
    end
    return placed
end

function RegionBuilders.buildEventSockets(
    modules: { Instance },
    manifest: any,
    generator: any,
    catalog: any,
    origin: Vector3,
    runtimeIds: any,
    color: Color3
): { any }
    local sockets = {}
    for index, placement in manifest.modules do
        if placement.eventId ~= nil and modules[index] ~= nil then
            local definition = generator.eventDefinition(placement.eventId)
            local center = origin
                + Vector3.new(
                    placement.cellX * catalog.CellSize,
                    0,
                    placement.cellZ * catalog.CellSize
                )
            local anchor = Instance.new("Part")
            anchor.Name = "EventSocket"
            anchor.Size = Vector3.new(7, 1, 7)
            anchor.CFrame = CFrame.new(center + Vector3.new(22, 0.5, -19))
            anchor.Anchored = true
            anchor.CanCollide = false
            anchor.CanTouch = false
            anchor.Transparency = 1
            anchor.CastShadow = false
            anchor:SetAttribute("ContentId", definition.id)
            anchor:SetAttribute("DisplayName", definition.displayName)
            anchor:SetAttribute("Dormant", true)
            anchor:SetAttribute("Status", "dormant")
            anchor:SetAttribute("Progress", 0)
            anchor:SetAttribute("ProgressTotal", #definition.steps)
            anchor.Parent = modules[index]
            CollectionService:AddTag(anchor, runtimeIds.ExpeditionEventTag)
            labelled(anchor, definition.displayName, color)

            --[[
                One anchor per step, at the offsets the event's own
                definition names. The steps are the event: "turn the three
                latches" is three places a player has to stand, and an
                event whose steps have nowhere to happen is a prompt that
                never appears.
            ]]
            local steps = {}
            for _, step in definition.steps do
                local offset = step.offset or { x = 0, y = 1, z = 0 }
                local stepAnchor = Instance.new("Part")
                stepAnchor.Name = "EventStep"
                stepAnchor.Size = Vector3.new(3, 4, 3)
                stepAnchor.CFrame = CFrame.new(
                    anchor.Position
                        + Vector3.new(
                            tonumber(offset.x) or 0,
                            tonumber(offset.y) or 1,
                            tonumber(offset.z) or 0
                        )
                )
                stepAnchor.Anchored = true
                stepAnchor.CanCollide = false
                stepAnchor.CanTouch = false
                stepAnchor.Transparency = 1
                stepAnchor:SetAttribute("StepId", step.id)
                stepAnchor.Parent = anchor
                table.insert(steps, {
                    target = stepAnchor,
                    stepId = step.id,
                    actionText = step.actionText,
                    objectText = step.objectText,
                })
            end

            table.insert(sockets, {
                target = anchor,
                eventId = definition.id,
                steps = steps,
            })
        end
    end
    return sockets
end

--[[
    An arena for an elite or a boss.

    Every encounter this project has shipped needs the same four things
    from the world: a floor a fight can happen on, a place the creature
    stands, a set of anchors for whatever the fight asks the player to
    interact with (root nodes, levers, mirrors, pools, vent wheels), and
    an edge so the arena reads as a room rather than a clearing.

    The encounter modules already name their own interaction ids --
    ForemanEcho.LeverIds, IronWidow.AnchorIds, BellowsMaw.LineIds and so
    on -- so the arena takes that list rather than inventing its own. If
    an encounter grows a fifth lever, its arena grows a fifth anchor with
    no change here, which is the only way these two stay in agreement.
]]
function RegionBuilders.buildArena(
    parent: Instance,
    center: Vector3,
    options: {
        name: string,
        radius: number,
        floorColor: Color3,
        edgeColor: Color3,
        anchorIds: { string },
        anchorColor: Color3,
    }
): { [string]: BasePart }
    local arena = Instance.new("Model")
    arena.Name = options.name
    arena.Parent = parent

    local floor = Instance.new("Part")
    floor.Name = "ArenaFloor"
    floor.Shape = Enum.PartType.Cylinder
    -- A cylinder's axis is its Size.X, so the disc lies flat only when
    -- the thickness is on X and the rotation stands it up.
    floor.Size = Vector3.new(1.2, options.radius * 2, options.radius * 2)
    floor.CFrame = CFrame.new(center + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90))
    floor.Color = options.floorColor
    floor.Material = Enum.Material.Slate
    floor.Anchored = true
    floor.CanCollide = false
    floor.CanQuery = false
    floor.Parent = arena

    local edges = 12
    for index = 0, edges - 1 do
        local angle = index * (math.pi * 2 / edges)
        local post = Instance.new("Part")
        post.Name = "ArenaEdge"
        post.Size = Vector3.new(2.2, 5.5, 2.2)
        post.CFrame = CFrame.new(
            center
                + Vector3.new(
                    math.cos(angle) * options.radius,
                    2.7,
                    math.sin(angle) * options.radius
                )
        ) * CFrame.Angles(0, angle, math.rad((index % 3) - 1))
        post.Color = options.edgeColor
        post.Material = Enum.Material.Rock
        post.Anchored = true
        post.Parent = arena
    end

    --[[
        One anchor per interaction the encounter names, evenly spaced
        inside the ring so no two are ever in the same place and every one
        is reachable from the middle.
    ]]
    local anchors: { [string]: BasePart } = {}
    local count = #options.anchorIds
    for index, anchorId in options.anchorIds do
        local angle = (index - 1) * (math.pi * 2 / math.max(1, count))
        local anchor = Instance.new("Part")
        anchor.Name = "ArenaAnchor"
        anchor.Size = Vector3.new(3.4, 5, 3.4)
        anchor.CFrame = CFrame.new(
            center
                + Vector3.new(
                    math.cos(angle) * (options.radius * 0.62),
                    2.5,
                    math.sin(angle) * (options.radius * 0.62)
                )
        )
        anchor.Color = options.anchorColor
        anchor.Material = Enum.Material.Neon
        anchor.Anchored = true
        anchor.CanCollide = false
        anchor.Transparency = 0.35
        anchor:SetAttribute("AnchorId", anchorId)
        anchor.Parent = arena
        anchors[anchorId] = anchor
    end
    return anchors
end

--[[
    The arena each new encounter needs, named next to the encounter that
    needs it so the two are read together. Radii come from the fights:
    the Widow's web has to be walked between cuts, so hers is widest; the
    Echo's three levers want a room rather than a field.
]]
RegionBuilders.Arenas = table.freeze({
    elite_foreman_echo = table.freeze({
        name = "ForemanEchoArena",
        regionId = "region_ironroot",
        radius = 26,
    }),
    elite_iron_widow = table.freeze({
        name = "IronWidowArena",
        regionId = "region_ironroot",
        radius = 34,
    }),
    boss_bellows_maw = table.freeze({
        name = "BellowsMawChamber",
        regionId = "region_ironroot",
        radius = 38,
    }),
    elite_many_face = table.freeze({
        name = "ManyFaceCourt",
        regionId = "region_mireglass",
        radius = 28,
    }),
    elite_drowned_caller = table.freeze({
        name = "DrownedCallerMarsh",
        regionId = "region_mireglass",
        radius = 32,
    }),
    boss_lantern_witch = table.freeze({
        name = "LanternWitchRing",
        regionId = "region_mireglass",
        radius = 36,
    }),
})

--[[
    Wayfinding: the trail that tells a party which way the run goes.

    Bramblewake learned this the expensive way. A twelve-module walk with
    no thread through it reads as twelve unrelated clearings, and players
    wander back the way they came -- so it grew a lit trail between module
    centres, and the wandering stopped. A new region needs the same thread
    in its own materials, which is all this is: a line of low markers from
    each module to the next, lit enough to find at night and quiet enough
    to ignore in daylight.
]]
function RegionBuilders.buildWayfinding(
    parent: Instance,
    manifest: any,
    catalog: any,
    origin: Vector3,
    markerColor: Color3,
    glowColor: Color3
): number
    local placed = 0
    for index = 1, #manifest.modules - 1 do
        local here = manifest.modules[index]
        local next = manifest.modules[index + 1]
        local from = origin
            + Vector3.new(here.cellX * catalog.CellSize, 0, here.cellZ * catalog.CellSize)
        local to = origin
            + Vector3.new(next.cellX * catalog.CellSize, 0, next.cellZ * catalog.CellSize)
        local span = to - from
        local steps = 5
        for step = 1, steps do
            local at = from + span * (step / (steps + 1))
            local marker = Instance.new("Part")
            marker.Name = "WayMarker"
            marker.Size = Vector3.new(2.2, 1.4, 2.2)
            marker.CFrame = CFrame.new(at + Vector3.new(0, 0.7, 0))
                * CFrame.Angles(0, math.rad((index * 37 + step * 19) % 360), 0)
            marker.Color = markerColor
            marker.Material = Enum.Material.Slate
            marker.Anchored = true
            marker.CanCollide = false
            marker.Parent = parent

            local cue = Instance.new("Part")
            cue.Name = "WayGlow"
            cue.Shape = Enum.PartType.Ball
            cue.Size = Vector3.new(0.6, 0.6, 0.6)
            cue.CFrame = CFrame.new(at + Vector3.new(0, 1.7, 0))
            cue.Color = glowColor
            cue.Material = Enum.Material.Neon
            cue.Anchored = true
            cue.CanCollide = false
            cue.CanQuery = false
            cue.CastShadow = false
            cue.Transparency = 0.55
            cue.Parent = parent
            placed += 1
        end
    end
    return placed
end

--[[
    The look of each region's trail. Ironroot marks its way with the same
    lamps it works by; the Fen uses witchlight on stone, because a lantern
    in the Fen is exactly the thing a player has learned not to trust.
]]
RegionBuilders.Wayfinding = table.freeze({
    region_ironroot = table.freeze({
        marker = Color3.fromRGB(62, 58, 56),
        glow = Color3.fromRGB(255, 206, 128),
    }),
    region_mireglass = table.freeze({
        marker = Color3.fromRGB(76, 78, 74),
        glow = Color3.fromRGB(146, 214, 226),
    }),
})

return table.freeze(RegionBuilders)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">TerrainBuilder</string>
            <string name="Source"><![CDATA[--!strict

--[[
    Sculpted Bramblewake terrain for the arrival valley.

    WHY THIS EXISTS

    The arrival world used to stand on a single 320 x 6 x 340 Part called
    "Ground". A flat rectangle has no horizon, no silhouette, and no sense of
    distance, so a valley that the design documents describe as a fracturing
    wilderness read as a small yard with props on it. No amount of prop detail
    fixes that: the eye reads ground shape and depth layers before it reads
    individual objects.

    Real Terrain fixes four things a Part floor cannot:

      * an actual horizon line, so the world stops ending in mid-air;
      * elevation the camera can look along, which is what produces depth;
      * material blending at the ground plane instead of one flat colour;
      * blended terrain materials instead of one repeated ground texture.

    WHAT IS DELIBERATELY *NOT* SCULPTED

    Every gameplay coordinate in WorldService is a hardcoded Vector3 authored
    against a flat plane at y = 0 -- spawns, interaction prompts, the lantern
    ring, the night defense route, incident sites, enemy spawn points. Sculpting
    under those would drop props into hillsides and leave prompts floating.

    So the playable bowl is filled flat, with its surface exactly at y = 0, and
    all relief happens *outside* it. The valley floor the player walks stays
    byte-for-byte the geometry the systems were authored against; the world
    around it gains hills, ridges, and a far skyline. That split is the whole
    reason this can land without re-authoring 5,000 lines of positions.

    COST

    Terrain is voxel data, not instances, so this adds zero parts to the
    streaming budget. Fills are bulk operations on 4-stud voxels; the whole
    valley is a few hundred FillBlock/FillBall calls rather than a per-voxel
    loop. Generation is deterministic from a fixed seed so two servers build an
    identical valley and a Studio build matches a live one.
]]

local Workspace = game:GetService("Workspace")

local TerrainBuilder = {}

-- The flat region every authored gameplay coordinate lives inside. Relief is
-- only generated outside this rectangle. Widened past the actual play area so
-- the transition to hills never crowds the walkable route.
local BOWL_MIN_X = -190
local BOWL_MAX_X = 190
local BOWL_MIN_Z = -260
local BOWL_MAX_Z = 90

-- Ground surface height. Must stay 0: it is the plane every authored Vector3
-- in WorldService was placed against.
local GROUND_Y = 0

--[[
    How far above a fill's top face Roblox actually renders the walkable
    surface.

    Terrain voxels are 4 studs. A FillBlock whose top face is authored at y = 0
    does not produce a surface at y = 0 -- it produces one at y = 2, half a
    voxel higher. Measured directly in Studio with a control fill far from any
    other geometry: top face at y = 0, raycast surface at y = 2.000, and every
    sample across the real valley floor returns 2.000 as well.

    This module used to report GROUND_Y as the floor's top and be wrong by
    exactly this amount, which is why so much authored content sat two studs
    into the ground: the town square (top face 0.80) was underground and had
    never once rendered, and every character authored to stand at y = 0 stood
    shin-deep in the grass. The road network reads correctly only because it
    was empirically nudged to 2.2-2.5 at some point without the cause being
    understood.

    The comment above stays true -- GROUND_Y is still the plane the authored
    coordinates were written against. What changed is that this module now
    tells callers where the ground actually is.
]]
local VOXEL_SURFACE_RISE = 2

--[[
    The Y every terrain fill is authored against, as opposed to the Y the
    engine then renders the surface at.

    Fills are placed VOXEL_SURFACE_RISE lower than the plane they are meant to
    produce, so the surface Roblox actually renders lands on GROUND_Y -- the
    plane every authored Vector3 in WorldService was written against. Before
    this, the fills were placed AT GROUND_Y and the surface rendered two studs
    above it, so the entire authored world was underground and individual props
    were being lifted one at a time to compensate. The main street still
    carries such a lift (a +1.77 "visual skin"), added when this was diagnosed
    as a road problem rather than a datum problem.

    Reporting is unchanged: groundHeight() and surfaceHeight() still describe
    the authored plane, and now they are telling the truth.
]]
local FILL_Y = GROUND_Y - VOXEL_SURFACE_RISE

-- How deep the solid ground slab runs. Enough that a Blackout crater or a
-- future dug-out cannot punch through into empty space.
local BEDROCK_DEPTH = 90

-- Outer extent of generated terrain. StreamingTargetRadius is 1024, so terrain
-- past roughly 1200 studs is only ever seen as a horizon silhouette; beyond
-- this the sky takes over.
local WORLD_EXTENT = 1450

local VOXEL = 4

local DEFAULT_SEED = 20260801

-- The Bramblewake expedition is built around x = 1600 (BramblewakeBuilder's
-- ORIGIN) as its own streamed area. No generated terrain may reach past this
-- line, or hills and peaks grow through the expedition modules. The hill grid
-- already stops at WORLD_EXTENT = 1450; this bounds the peak ring too, whose
-- radius would otherwise carry it further out than its centre suggests.
local BRAMBLEWAKE_KEEP_OUT_X = 1400

export type Palette = {
    valley: Enum.Material,
    meadow: Enum.Material,
    slope: Enum.Material,
    ridge: Enum.Material,
    peak: Enum.Material,
    shore: Enum.Material,
}

local DEFAULT_PALETTE: Palette = {
    valley = Enum.Material.Grass,
    meadow = Enum.Material.LeafyGrass,
    slope = Enum.Material.Ground,
    ridge = Enum.Material.Rock,
    peak = Enum.Material.Slate,
    shore = Enum.Material.Sand,
}

-- Rounds a span up to a whole number of voxels. Terrain snaps fills to its own
-- 4-stud grid, and unrounded sizes leave single-voxel seams between adjacent
-- fills that read as cracks in the ground from a low camera.
local function toVoxelSpan(value: number): number
    return math.max(VOXEL, math.ceil(value / VOXEL) * VOXEL)
end

local function isInsideBowl(x: number, z: number, margin: number): boolean
    return x > BOWL_MIN_X - margin
        and x < BOWL_MAX_X + margin
        and z > BOWL_MIN_Z - margin
        and z < BOWL_MAX_Z + margin
end

--[[
    Two-octave value noise in [-1, 1], seeded so every server sculpts the same
    valley.

    math.noise is Perlin and already deterministic for a given input, so the
    seed only has to offset the sample position. Two octaves is enough for a
    natural ridgeline; more detail is invisible once terrain smoothing and
    grass decoration land on top of it.
]]
local function terrainNoise(seed: number, x: number, z: number, scale: number): number
    local base = math.noise(x / scale + seed, z / scale + seed, seed * 0.37)
    local detail = math.noise(x / (scale * 0.42) - seed, z / (scale * 0.42) + seed, seed * 0.11)
    return math.clamp(base + detail * 0.38, -1, 1)
end

--[[
    Fills the flat valley floor that all authored gameplay geometry sits on.

    Filled as one block rather than per-column so the walkable surface is
    guaranteed level -- noise anywhere in here would tilt props and prompts.
]]
local function fillValleyFloor(terrain: Terrain, palette: Palette)
    local width = toVoxelSpan(BOWL_MAX_X - BOWL_MIN_X)
    local depth = toVoxelSpan(BOWL_MAX_Z - BOWL_MIN_Z)
    local centerX = (BOWL_MIN_X + BOWL_MAX_X) / 2
    local centerZ = (BOWL_MIN_Z + BOWL_MAX_Z) / 2

    -- Centre from the SAME rounded span that is passed as the size. Deriving
    -- the centre from the raw BEDROCK_DEPTH while filling the voxel-rounded
    -- span puts the floor half a voxel out: 90 rounds up to 92, so the surface
    -- landed at GROUND_Y + 1 instead of GROUND_Y. Every road is only ~0.9
    -- studs thick, so that one stud buried the entire road network -- main
    -- street, arrival route, and district roads -- under the grass. The
    -- surrounding column fill below already derives its centre this way, which
    -- is why the hills sat correctly while the valley floor did not.
    local depthSpan = toVoxelSpan(BEDROCK_DEPTH)

    terrain:FillBlock(
        CFrame.new(centerX, FILL_Y - depthSpan / 2, centerZ),
        Vector3.new(width, depthSpan, depth),
        palette.valley
    )
end

--[[
    Rolling ground outside the bowl, rising with distance so the valley reads as
    sheltered and the skyline closes the world off.

    Columns are sampled on a coarse grid and filled as blocks. A finer grid
    would cost proportionally more fills for detail that terrain smoothing and
    the tree line hide anyway.

    `minRadius`/`maxRadius` select an annulus by distance from the bowl centre,
    which is what lets the near ground be generated before a player can join
    and the horizon be generated after. Splitting by radius rather than by grid
    index guarantees the two passes tile exactly: no cell is filled twice, and
    no cell between them is missed.

    `onProgress` is called once per grid row so a deferred caller can yield.
    Yielding inside the row loop instead of per cell keeps the number of
    scheduler round-trips proportional to the grid edge, not its area.
]]
--[[
    The height of the ground surface at a world position.

    This is the single source of truth for the terrain's shape. Both the fill
    loop and anything placed *on* the terrain must read it, or they disagree:
    foliage was originally planted at a hardcoded y = 0 while the ground
    outside the bowl rose by up to ~90 studs, which buried the mid and far
    tree bands -- the exact depth layers this module exists to create.

    Inside the bowl this is always GROUND_Y, which is the flat-floor guarantee
    every authored gameplay coordinate depends on.
]]
local function surfaceHeightAt(x: number, z: number, seed: number): number
    if isInsideBowl(x, z, 0) then
        return GROUND_Y
    end

    local bowlCenterX = (BOWL_MIN_X + BOWL_MAX_X) / 2
    local bowlCenterZ = (BOWL_MIN_Z + BOWL_MAX_Z) / 2
    local dx = x - bowlCenterX
    local dz = z - bowlCenterZ
    local distance = math.sqrt(dx * dx + dz * dz)

    -- Ramp relief in with distance from the valley so the ground leaves the
    -- flat bowl gradually instead of at a wall.
    local ramp = math.clamp((distance - 230) / 620, 0, 1)
    local rise = terrainNoise(seed, x, z, 320) * 58 + 34
    return GROUND_Y + math.max(0, rise * ramp * ramp)
end

--[[
    Surface height for callers outside this module, using the same seed the
    world was built with. Foliage placement uses this so trunks sit on the
    ground rather than inside it.
]]
function TerrainBuilder.surfaceHeight(x: number, z: number, seed: number?): number
    return surfaceHeightAt(x, z, seed or DEFAULT_SEED)
end

local function fillHillAnnulus(
    terrain: Terrain,
    seed: number,
    palette: Palette,
    minRadius: number,
    maxRadius: number,
    onProgress: (() -> ())?
)
    local step = 24
    local bowlCenterX = (BOWL_MIN_X + BOWL_MAX_X) / 2
    local bowlCenterZ = (BOWL_MIN_Z + BOWL_MAX_Z) / 2

    for x = -WORLD_EXTENT, WORLD_EXTENT, step do
        if onProgress ~= nil then
            onProgress()
        end
        for z = -WORLD_EXTENT, WORLD_EXTENT, step do
            if not isInsideBowl(x, z, 0) then
                local dx = x - bowlCenterX
                local dz = z - bowlCenterZ
                local distance = math.sqrt(dx * dx + dz * dz)

                if distance < minRadius or distance >= maxRadius then
                    continue
                end

                -- Stop the grid short of the Bramblewake expedition. Bounding
                -- only the peak ring was not enough: ExpeditionGenerator's
                -- ROUTES[2] walks to cellX = -2, putting a module centre at
                -- x = 1456 whose 72-stud cell reaches x = 1420, while this
                -- grid fills all the way to WORLD_EXTENT = 1450. That 30-stud
                -- overlap would grow hills through the first modules.
                if x >= BRAMBLEWAKE_KEEP_OUT_X then
                    continue
                end

                -- Same function foliage placement reads, so a tree can never
                -- disagree with the ground it stands on.
                local height = surfaceHeightAt(x, z, seed) - GROUND_Y

                -- Every cell outside the bowl is filled, including the ones
                -- with no relief at all. Skipping flat cells left a void ring
                -- between the bowl's rectangular edge and where the distance
                -- ramp starts producing height -- a cell just past x = 190 is
                -- outside the bowl but still under the 230-stud ramp, so it
                -- got no terrain and no floor. Players walking off the bowl
                -- edge fell through it into fall recovery, and removing the
                -- old DistantCliff ring took away the fence that had been
                -- accidentally hiding the gap.
                local material = palette.slope
                if height > 96 then
                    material = palette.peak
                elseif height > 46 then
                    material = palette.ridge
                elseif height < 1 then
                    -- Flat skirt immediately outside the bowl reads as the
                    -- same meadow, not as a different biome starting at a
                    -- straight line.
                    material = palette.valley
                end

                local columnHeight = toVoxelSpan(height + BEDROCK_DEPTH)
                terrain:FillBlock(
                    CFrame.new(x, FILL_Y + height - columnHeight / 2, z),
                    Vector3.new(toVoxelSpan(step), columnHeight, toVoxelSpan(step)),
                    material
                )
            end
        end
    end
end

--[[
    Distant peaks that close the horizon.

    Placed as overlapping balls rather than blocks: a ball reads as a rounded
    massif once smoothed, and at this distance silhouette is the only property
    that survives. This is the "distant silhouette" depth layer the art
    direction asks every background to have.
]]
local function fillHorizonPeaks(terrain: Terrain, seed: number, palette: Palette)
    local random = Random.new(seed)
    local peakCount = 26

    for index = 1, peakCount do
        local angle = (index / peakCount) * math.pi * 2 + random:NextNumber(-0.06, 0.06)
        local distance = random:NextNumber(1020, 1330)
        local x = math.cos(angle) * distance
        local z = math.sin(angle) * distance - 70
        local radius = random:NextNumber(110, 210)
        local height = random:NextNumber(150, 320)

        -- The Bramblewake expedition is authored as a separate streamed area
        -- around x = 1600. A peak at distance 1330 with radius 210 reaches
        -- x = 1540, close enough to push a mountain through the first
        -- expedition modules. Skipping peaks that reach into it keeps the two
        -- areas from fighting over the same space.
        if x + radius > BRAMBLEWAKE_KEEP_OUT_X then
            continue
        end

        -- Two stacked balls give a shoulder and a cap, which reads as a
        -- mountain rather than a dome.
        terrain:FillBall(Vector3.new(x, FILL_Y + height * 0.15, z), radius, palette.ridge)
        terrain:FillBall(Vector3.new(x, FILL_Y + height * 0.55, z), radius * 0.62, palette.peak)
    end
end

--[[
    A stream running past the east edge of the valley into a pond.

    Water is the cheapest large-scale visual interest terrain offers: it moves,
    it reflects the sky and the lanterns, and it gives the flat bowl a readable
    boundary on one side. Kept outside the bowl so it can never flood a spawn
    or an interaction, and carved before it is filled so the banks read as cut
    earth rather than a puddle sitting on grass.
]]
local function fillStream(terrain: Terrain, palette: Palette)
    local points = {
        Vector3.new(232, FILL_Y, 60),
        Vector3.new(252, FILL_Y, -20),
        Vector3.new(268, FILL_Y, -104),
        Vector3.new(296, FILL_Y, -186),
        Vector3.new(342, FILL_Y, -252),
    }

    local channelDepth = 16
    local waterDepth = 8
    local waterSurfaceY = FILL_Y - 2

    for index = 1, #points - 1 do
        local from = points[index]
        local to = points[index + 1]
        local delta = to - from
        local center = from + delta * 0.5
        local width = toVoxelSpan(28 + math.sin(index * 1.7) * 4)
        local length = toVoxelSpan(delta.Magnitude + width)
        local horizontalTarget = Vector3.new(to.X, FILL_Y, to.Z)
        local orientation = CFrame.lookAt(Vector3.new(center.X, FILL_Y, center.Z), horizontalTarget)

        -- Repaint two flat bank strips before carving. Their top face remains
        -- exactly at ground level; unlike a sphere, they cannot create dunes.
        for side = -1, 1, 2 do
            terrain:FillBlock(
                orientation * CFrame.new(side * (width * 0.5 + 5), -4, 0),
                Vector3.new(10, 8, length),
                palette.shore
            )
        end

        -- Both channel and water are blocks aligned along the stream segment.
        -- The water top is a single flat plane below the banks. Overlapping
        -- segment ends hide the joints without the above-ground domes produced
        -- by FillBall water.
        terrain:FillBlock(
            orientation * CFrame.new(0, -2, 0),
            Vector3.new(width + 8, channelDepth, length),
            Enum.Material.Air
        )
        terrain:FillBlock(
            orientation * CFrame.new(0, waterSurfaceY - waterDepth * 0.5, 0),
            Vector3.new(width, waterDepth, length),
            Enum.Material.Water
        )
    end

    -- A flat octagonal pond assembled from voxel-aligned rows. Every row shares
    -- the same water height, so the lake reads as a surface instead of a bubble.
    local pondCenter = Vector3.new(362, FILL_Y, -286)
    local pondWidths = { 64, 96, 112, 120, 112, 96, 64 }
    terrain:FillBlock(
        CFrame.new(pondCenter + Vector3.new(0, -4, 0)),
        Vector3.new(136, 8, 128),
        palette.shore
    )
    for rowIndex, rowWidth in pondWidths do
        local zOffset = (rowIndex - 4) * 16
        terrain:FillBlock(
            CFrame.new(pondCenter + Vector3.new(0, -2, zOffset)),
            Vector3.new(rowWidth + 12, channelDepth, 20),
            Enum.Material.Air
        )
        terrain:FillBlock(
            CFrame.new(pondCenter + Vector3.new(0, waterSurfaceY - waterDepth * 0.5, zOffset)),
            Vector3.new(rowWidth, waterDepth, 20),
            Enum.Material.Water
        )
    end
end

-- How deep a surface material patch reaches. Only needs to cover the topmost
-- voxel layer that is actually visible; deeper is wasted writes.
local SURFACE_PATCH_DEPTH = 8

--[[
    Meadow and worn-earth colour variation across the valley floor.

    Every patch is a block whose TOP FACE sits exactly at GROUND_Y and whose
    body runs downward, and it is only ever yaw-rotated. Both properties are
    load-bearing:

      * The bowl is already solid from GROUND_Y down to bedrock, so a fill
        entirely at or below GROUND_Y replaces the material of existing voxels
        without changing occupancy. The walkable surface stays exactly flat.
      * Yaw keeps the top face horizontal at a fixed height. Pitch or roll
        would tip a corner up through the surface.

    The first version used FillBall centred at GROUND_Y - 0.55 * radius, which
    put the top of every ball 0.45 * radius ABOVE the ground -- up to a 19.8
    stud solid mound, in the middle of the area this module promises is flat,
    potentially burying the spawn and authored props. FillBall adds terrain; it
    does not merely repaint it. A ball cannot repaint a flat surface at all:
    any ball whose top is at or below the surface only touches it at a single
    tangent point, so a block is the right primitive here, not a rounder one.
]]
local function paintValleyVariation(terrain: Terrain, seed: number, palette: Palette)
    local random = Random.new(seed + 991)

    for _ = 1, 46 do
        local x = random:NextNumber(BOWL_MIN_X + 20, BOWL_MAX_X - 20)
        local z = random:NextNumber(BOWL_MIN_Z + 20, BOWL_MAX_Z - 20)
        local width = toVoxelSpan(random:NextNumber(26, 78))
        local depth = toVoxelSpan(random:NextNumber(26, 78))
        local material = if random:NextNumber() < 0.62 then palette.meadow else palette.slope

        terrain:FillBlock(
            CFrame.new(x, FILL_Y - SURFACE_PATCH_DEPTH / 2, z)
                * CFrame.Angles(0, random:NextNumber(0, math.pi), 0),
            Vector3.new(width, SURFACE_PATCH_DEPTH, depth),
            material
        )
    end
end

--[[
    Where the join-blocking core pass stops and the deferred pass begins.

    Everything a player can reach, fall off, or see close up in their first
    moments is inside this radius; past it the ground is scenery. Comfortably
    beyond the 620-stud tree line so the transition is never the first thing
    in view.
]]
local CORE_RADIUS = 760

local function applyWaterStyle(terrain: Terrain)
    terrain.WaterColor = Color3.fromRGB(44, 92, 104)
    terrain.WaterReflectance = 0.28
    terrain.WaterTransparency = 0.62
    terrain.WaterWaveSize = 0.08
    terrain.WaterWaveSpeed = 8
end

--[[
    Sculpts everything a joining player needs: the flat valley floor, the
    ground immediately around it, the stream, and surface variation.

    This runs before the spawn exists and before the world is marked ready, so
    it is deliberately the smaller half of the work. Config.BootstrapTimeoutSeconds
    is 8, and AGENTS.md is explicit that joining must never block on the whole
    world loading -- the first version generated the entire 121 x 121 hill grid
    and the horizon here, which is optional scenery no one can reach.

    Safe to call more than once: every fill is deterministic for a given seed,
    so re-running writes identical voxels.
]]
function TerrainBuilder.buildCore(seed: number?, palette: Palette?)
    local terrain = Workspace.Terrain
    local resolvedSeed = seed or DEFAULT_SEED
    local resolvedPalette = palette or DEFAULT_PALETTE

    fillValleyFloor(terrain, resolvedPalette)
    fillHillAnnulus(terrain, resolvedSeed, resolvedPalette, 0, CORE_RADIUS, nil)
    fillStream(terrain, resolvedPalette)
    paintValleyVariation(terrain, resolvedSeed, resolvedPalette)
    applyWaterStyle(terrain)
end

--[[
    Sculpts the horizon: the far hills and the peak ring.

    Meant to be called after the world is marked ready. `onProgress` fires once
    per grid row so the caller can yield between rows and keep the server
    responsive while this fills in behind the tree line.

    Everything here is past CORE_RADIUS, so it can only ever add scenery a
    player is looking at from a distance -- never ground they are standing on.
]]
function TerrainBuilder.buildDistant(seed: number?, palette: Palette?, onProgress: (() -> ())?)
    local terrain = Workspace.Terrain
    local resolvedSeed = seed or DEFAULT_SEED
    local resolvedPalette = palette or DEFAULT_PALETTE

    fillHillAnnulus(terrain, resolvedSeed, resolvedPalette, CORE_RADIUS, math.huge, onProgress)
    fillHorizonPeaks(terrain, resolvedSeed, resolvedPalette)
end

-- Exposed so world code and tests can reason about the flat region without
-- duplicating the numbers.
function TerrainBuilder.bowlBounds(): (number, number, number, number)
    return BOWL_MIN_X, BOWL_MAX_X, BOWL_MIN_Z, BOWL_MAX_Z
end

function TerrainBuilder.isInsidePlayableBowl(x: number, z: number): boolean
    return isInsideBowl(x, z, 0)
end

function TerrainBuilder.groundHeight(): number
    return GROUND_Y
end

--[[
    The world-space Y of the valley floor's top face, derived the same way
    fillValleyFloor derives it.

    Exposed so a test can prove the filled surface and `surfaceHeight` agree.
    They silently disagreed once: the fill centred on the raw BEDROCK_DEPTH
    while sizing the voxel-rounded span, so the floor rendered one stud above
    the height every authored coordinate was placed against, and the entire
    road network -- none of it thicker than about 0.9 studs -- was buried under
    the grass with nothing in the logs to say so.
]]
function TerrainBuilder.valleyFloorTop(): number
    return FILL_Y
        + toVoxelSpan(BEDROCK_DEPTH) / 2
        - toVoxelSpan(BEDROCK_DEPTH) / 2
        + VOXEL_SURFACE_RISE
end

-- The surface a character or prop must stand on to look like it is standing on
-- the valley floor rather than buried in it. Now simply the authored plane,
-- because the fills were corrected to render there.
function TerrainBuilder.standingSurface(): number
    return GROUND_Y
end

return table.freeze(TerrainBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">WardenStagBuilder</string>
            <string name="Source"><![CDATA[--!strict

local WardenStagBuilder = {}

local function part(
    parent: Model,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?
): Part
    local item = Instance.new("Part")
    item.Name = name
    item.Size = size
    item.CFrame = cframe
    item.Color = color
    item.Material = material
    item.Shape = shape or Enum.PartType.Block
    item.Anchored = true
    item.CanCollide = false
    item.CanTouch = false
    item.CastShadow = true
    item.TopSurface = Enum.SurfaceType.Smooth
    item.BottomSurface = Enum.SurfaceType.Smooth
    item.Parent = parent
    return item
end

local function antlerBranch(model: Model, origin: Vector3, side: number, branchIndex: number): Part
    return part(
        model,
        if side < 0 then "AntlerLeft" else "AntlerRight",
        Vector3.new(1.15, 7 + branchIndex * 1.4, 1.15),
        CFrame.new(
            origin
                + Vector3.new(
                    side * (3.2 + branchIndex * 1.6),
                    3 + branchIndex * 2.1,
                    branchIndex * 0.35
                )
        ) * CFrame.Angles(0, 0, math.rad(side * (24 + branchIndex * 8))),
        Color3.fromRGB(212, 207, 178),
        Enum.Material.SmoothPlastic,
        nil
    )
end

function WardenStagBuilder.build(origin: Vector3, target: Vector3, maxHealth: number): Model
    local model = Instance.new("Model")
    model.Name = "WardenStagBoss"
    model:SetAttribute("BossId", "boss_warden_stag")
    model:SetAttribute("BossDisplayName", "Warden Stag")
    model:SetAttribute("BossHealth", maxHealth)
    model:SetAttribute("BossMaxHealth", maxHealth)
    model:SetAttribute("BossStatus", "cleansing")
    model:SetAttribute("BossOutcome", "")

    local body = part(
        model,
        "AncientBody",
        Vector3.new(11, 8, 18),
        CFrame.new(origin + Vector3.new(0, 10, 0)),
        Color3.fromRGB(66, 48, 37),
        Enum.Material.Wood,
        Enum.PartType.Ball
    )
    model.PrimaryPart = body
    part(
        model,
        "MossMantle",
        Vector3.new(11.5, 3.8, 13),
        CFrame.new(origin + Vector3.new(0, 13, 1.5)),
        Color3.fromRGB(48, 83, 57),
        Enum.Material.Grass,
        Enum.PartType.Ball
    )
    local head = part(
        model,
        "WardenHead",
        Vector3.new(6.5, 7, 7.5),
        CFrame.new(origin + Vector3.new(0, 15.5, -9)),
        Color3.fromRGB(72, 52, 40),
        Enum.Material.Wood,
        Enum.PartType.Ball
    )
    for side = -1, 1, 2 do
        for branchIndex = 1, 3 do
            antlerBranch(model, head.Position + Vector3.new(0, 3, 0), side, branchIndex)
        end
        part(
            model,
            "MemoryEye",
            Vector3.new(0.85, 0.85, 0.45),
            CFrame.new(head.Position + Vector3.new(side * 1.5, 0.8, -3.4)),
            Color3.fromRGB(112, 220, 179),
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
        for legIndex = -1, 1, 2 do
            part(
                model,
                "RootLeg",
                Vector3.new(2.4, 10, 2.4),
                CFrame.new(origin + Vector3.new(side * 3.7, 4.5, legIndex * 5.5))
                    * CFrame.Angles(math.rad(legIndex * 6), 0, math.rad(side * 5)),
                Color3.fromRGB(57, 40, 32),
                Enum.Material.Wood,
                nil
            )
        end
    end

    local heart = part(
        model,
        "MemoryHeart",
        Vector3.new(4.5, 5.8, 1.8),
        CFrame.new(origin + Vector3.new(0, 11, -8.5)),
        Color3.fromRGB(255, 190, 85),
        Enum.Material.Neon,
        Enum.PartType.Ball
    )
    heart:SetAttribute("WeakPoint", true)
    -- Same contract as the Old Growth heart: the weak point lives inside the
    -- authored mesh's cavity and must survive the enemy-visual blanking pass,
    -- or the boss cannot be struck at all.
    heart:SetAttribute("KeepVisibleOnReplacement", true)

    local highlight = Instance.new("Highlight")
    highlight.Name = "BossOutline"
    highlight.FillColor = Color3.fromRGB(48, 82, 56)
    highlight.FillTransparency = 0.84
    highlight.OutlineColor = Color3.fromRGB(255, 190, 85)
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = model

    local flatTarget = Vector3.new(target.X, body.Position.Y, target.Z)
    if (flatTarget - body.Position).Magnitude > 0.01 then
        model:PivotTo(CFrame.lookAt(body.Position, flatTarget))
    end
    return model
end

function WardenStagBuilder.setState(
    model: Model,
    health: number,
    status: string,
    marked: boolean,
    brokenAntlers: { [string]: boolean },
    outcome: string?
)
    model:SetAttribute("BossHealth", math.max(0, health))
    model:SetAttribute("BossStatus", status)
    model:SetAttribute("BossOutcome", outcome or "")
    model:SetAttribute("LastLightMarked", marked)
    local exposed = status == "vulnerable"
    local complete = status == "complete"
    local heart = model:FindFirstChild("MemoryHeart")
    if heart ~= nil and heart:IsA("BasePart") then
        heart.Color = if complete
            then Color3.fromRGB(112, 220, 179)
            elseif exposed then Color3.fromRGB(255, 190, 85)
            else Color3.fromRGB(92, 117, 96)
        heart.Material = if exposed or complete
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        heart.Transparency = if exposed or complete then 0 else 0.38
    end
    local highlight = model:FindFirstChild("BossOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        highlight.OutlineColor = if complete
            then Color3.fromRGB(112, 220, 179)
            elseif marked then Color3.fromRGB(255, 226, 124)
            elseif exposed then Color3.fromRGB(255, 190, 85)
            else Color3.fromRGB(112, 155, 119)
        highlight.FillTransparency = if marked then 0.62 else 0.84
    end
    for _, descendant in model:GetChildren() do
        if descendant:IsA("BasePart") then
            if descendant.Name == "AntlerLeft" then
                descendant.Transparency = if brokenAntlers.antler_left then 0.78 else 0
            elseif descendant.Name == "AntlerRight" then
                descendant.Transparency = if brokenAntlers.antler_right then 0.78 else 0
            end
        end
    end
    if model:GetAttribute("EnemyVisualReady") == true then
        local authored = model:FindFirstChild("AuthoredEnemyVisual")
        local hiddenAuthoredAntlerParts = 0
        if authored ~= nil and authored:IsA("Model") then
            local _, authoredBounds = authored:GetBoundingBox()
            local authoredPivot = authored:GetPivot()
            for _, descendant in authored:GetDescendants() do
                if descendant:IsA("BasePart") then
                    local relativePosition = authoredPivot:PointToObjectSpace(descendant.Position)
                    local sourceTransparency = descendant:GetAttribute("WardenSourceTransparency")
                    if type(sourceTransparency) ~= "number" then
                        sourceTransparency = descendant.Transparency
                        descendant:SetAttribute("WardenSourceTransparency", sourceTransparency)
                    end
                    local upperSilhouette = relativePosition.Y > authoredBounds.Y * 0.5
                        and descendant.Size.Y
                            > math.max(descendant.Size.X, descendant.Size.Z) * 1.35
                    local brokenSide = (brokenAntlers.antler_left and relativePosition.Z < 0)
                        or (brokenAntlers.antler_right and relativePosition.Z > 0)
                    if upperSilhouette and brokenSide then
                        descendant.Transparency = 1
                        descendant.CastShadow = false
                        hiddenAuthoredAntlerParts += 1
                    else
                        descendant.Transparency = sourceTransparency
                    end
                end
            end
        end
        model:SetAttribute("AuthoredBrokenAntlerParts", hiddenAuthoredAntlerParts)
        for _, descendant in model:GetDescendants() do
            if
                descendant:IsA("BasePart")
                and (authored == nil or not descendant:IsDescendantOf(authored))
            then
                descendant.Transparency = 1
                descendant.CastShadow = false
            end
        end
    end
end

return table.freeze(WardenStagBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">WorldArtRegistry</string>
            <string name="Source"><![CDATA[--!strict

-- Data-only cloud art mapping. Keep this synchronized with
-- assets/images/manifest.json so pure Luau tests can validate every atlas cell
-- without Roblox engine types.

local WorldArtRegistry = {}

export type Panel = {
    assetId: number,
    offsetX: number,
    offsetY: number,
    width: number,
    height: number,
}

local ASSET_ID = 83727643922166
local CELL_WIDTH = 627
local CELL_HEIGHT = 418

local PANELS: { [string]: Panel } = table.freeze({
    evacuation_route = {
        assetId = ASSET_ID,
        offsetX = 0,
        offsetY = 0,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    lantern_maintenance = {
        assetId = ASSET_ID,
        offsetX = CELL_WIDTH,
        offsetY = 0,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    supply_inventory = {
        assetId = ASSET_ID,
        offsetX = 0,
        offsetY = CELL_HEIGHT,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    bramble_hazard = {
        assetId = ASSET_ID,
        offsetX = CELL_WIDTH,
        offsetY = CELL_HEIGHT,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    field_botany = {
        assetId = ASSET_ID,
        offsetX = 0,
        offsetY = CELL_HEIGHT * 2,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
    community_watch = {
        assetId = ASSET_ID,
        offsetX = CELL_WIDTH,
        offsetY = CELL_HEIGHT * 2,
        width = CELL_WIDTH,
        height = CELL_HEIGHT,
    },
})

local ORDER = table.freeze({
    "evacuation_route",
    "lantern_maintenance",
    "supply_inventory",
    "bramble_hazard",
    "field_botany",
    "community_watch",
})

function WorldArtRegistry.noticePanel(panelId: string): Panel?
    return PANELS[panelId]
end

function WorldArtRegistry.noticePanelIds(): { string }
    return table.clone(ORDER)
end

return table.freeze(WorldArtRegistry)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">WorldSignBuilder</string>
            <string name="Source"><![CDATA[--!strict

local WorldArtRegistry = require(script.Parent.WorldArtRegistry)

local WorldSignBuilder = {}

local BARK = Color3.fromRGB(62, 39, 30)
local WET_BARK = Color3.fromRGB(36, 26, 24)
local PARCHMENT = Color3.fromRGB(210, 190, 146)
local IRON = Color3.fromRGB(50, 54, 58)
local WAX = Color3.fromRGB(142, 71, 49)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = false
    instance.CanTouch = false
    instance.CanQuery = false
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

-- Both the shadow and the face copy must be laid out identically. TextScaled
-- sizes glyphs to fill whatever box the label ends up with, so giving only one
-- of them padding makes the two copies render at different sizes -- the shadow
-- spills out from behind the letters and the sign reads as doubled, mirrored
-- garbage rather than as a drop shadow. Keep the padding on both.
local function applySignTextPadding(label: TextLabel)
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0.16, 0)
    padding.PaddingBottom = UDim.new(0.16, 0)
    padding.PaddingLeft = UDim.new(0.08, 0)
    padding.PaddingRight = UDim.new(0.08, 0)
    padding.Parent = label
end

-- `singleLine` keeps the whole title on one row. A narrow header plank that
-- lets its title wrap ends up rendering two lines of glyphs a fraction of a
-- stud tall -- unreadable mush spilling over the plank edges, which is
-- exactly what the owner photographed on the notice-board headers.
local function addSurfaceText(board: BasePart, title: string, accent: Color3, singleLine: boolean?)
    local surface = Instance.new("SurfaceGui")
    surface.Name = "PhysicalSignText"
    surface.Face = Enum.NormalId.Front
    surface.LightInfluence = 0.3
    surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surface.PixelsPerStud = 42
    surface.Parent = board

    local shadow = Instance.new("TextLabel")
    shadow.Name = "SignLetterShadow"
    shadow.BackgroundTransparency = 1
    shadow.Position = UDim2.fromOffset(2, 2)
    shadow.Size = UDim2.fromScale(1, 1)
    shadow.Font = Enum.Font.GothamBold
    shadow.Text = title
    shadow.TextColor3 = Color3.fromRGB(19, 17, 15)
    shadow.TextScaled = true
    shadow.TextWrapped = singleLine ~= true
    shadow.Parent = surface
    applySignTextPadding(shadow)

    local label = Instance.new("TextLabel")
    label.Name = "SignLetters"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.Text = title
    label.TextColor3 = accent
    label.TextScaled = true
    label.TextWrapped = singleLine ~= true
    label.Parent = surface
    applySignTextPadding(label)
end

local function addBoardFrame(board: BasePart, style: string): Folder
    local existing = board:FindFirstChild("PhysicalSignDetails")
    if existing ~= nil then
        existing:Destroy()
    end
    local details = Instance.new("Folder")
    details.Name = "PhysicalSignDetails"
    details.Parent = board

    local width = board.Size.X
    local height = board.Size.Y
    local front = -(board.Size.Z * 0.5 + 0.1)
    local railDepth = math.max(0.22, board.Size.Z * 0.48)
    for side = -1, 1, 2 do
        if style ~= "direction" then
            part(
                details,
                "SignFrameSide",
                Vector3.new(0.42, height + 0.7, railDepth),
                board.CFrame * CFrame.new(side * (width * 0.5 + 0.1), 0, front),
                if side < 0 then WET_BARK else BARK,
                Enum.Material.Wood
            )
        end
        part(
            details,
            "SignFrameRail",
            Vector3.new(width + 0.9, 0.38, railDepth),
            board.CFrame
                * CFrame.new(0, side * (height * 0.5 + 0.1), front)
                * CFrame.Angles(0, 0, math.rad(side * 1.5)),
            if side < 0 then BARK else WET_BARK,
            Enum.Material.Wood
        )
    end
    for pinX = -1, 1, 2 do
        local pinRows = if style == "direction" then { 0 } else { -1, 1 }
        for _, pinY in pinRows do
            local pin = part(
                details,
                "SignIronPin",
                Vector3.new(0.2, 0.2, 0.16),
                board.CFrame * CFrame.new(pinX * width * 0.43, pinY * height * 0.38, front - 0.2),
                IRON,
                Enum.Material.Metal
            )
            pin.Shape = Enum.PartType.Ball
        end
    end
    if style == "direction" then
        local arrowColor = Color3.fromRGB(149, 112, 62)
        part(
            details,
            "CarvedDirectionShaft",
            Vector3.new(width * 0.22, 0.18, 0.12),
            board.CFrame * CFrame.new(width * 0.31, -height * 0.28, front - 0.2),
            arrowColor,
            Enum.Material.WoodPlanks
        )
        local head = part(
            details,
            "CarvedDirectionHead",
            Vector3.new(0.48, 0.6, 0.12),
            board.CFrame
                * CFrame.new(width * 0.44, -height * 0.28, front - 0.2)
                * CFrame.Angles(0, math.rad(90), 0),
            arrowColor,
            Enum.Material.WoodPlanks
        )
        head.Shape = Enum.PartType.Wedge
    end
    board:SetAttribute("PhysicalSignStyle", style)
    return details
end

function WorldSignBuilder.dressBoard(board: BasePart, title: string, accent: Color3, style: string?)
    for _, child in board:GetChildren() do
        if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
            child:Destroy()
        end
    end
    addBoardFrame(board, style or "plaque")
    addSurfaceText(board, title, accent)
end

function WorldSignBuilder.createDirectionSign(
    parent: Instance,
    name: string,
    at: CFrame,
    title: string,
    accent: Color3
): Model
    local model = Instance.new("Model")
    model.Name = name
    model:SetAttribute("PhysicalSign", true)
    model.Parent = parent

    local board = part(
        model,
        "DirectionBoard",
        Vector3.new(8, 2.45, 0.52),
        at,
        Color3.fromRGB(83, 57, 38),
        Enum.Material.WoodPlanks
    )
    part(
        model,
        "DirectionPost",
        Vector3.new(0.68, 5.8, 0.68),
        at * CFrame.new(-2.65, -3.7, 0.18) * CFrame.Angles(0, 0, math.rad(-4)),
        WET_BARK,
        Enum.Material.Wood
    )
    part(
        model,
        "DirectionPostBrace",
        Vector3.new(0.4, 3.1, 0.4),
        at * CFrame.new(-3.25, -4.25, 0.3) * CFrame.Angles(0, 0, math.rad(24)),
        BARK,
        Enum.Material.Wood
    )
    WorldSignBuilder.dressBoard(board, title, accent, "direction")
    model.PrimaryPart = board
    return model
end

local function addNoticeArtwork(paper: BasePart, panelId: string)
    local panel = WorldArtRegistry.noticePanel(panelId)
    assert(panel ~= nil, "unknown notice artwork " .. panelId)
    local surface = Instance.new("SurfaceGui")
    surface.Name = "NoticeArtwork"
    surface.Face = Enum.NormalId.Front
    surface.LightInfluence = 0.2
    surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    surface.PixelsPerStud = 96
    surface.Parent = paper

    local image = Instance.new("ImageLabel")
    image.Name = "NoticeImage_" .. panelId
    image.BackgroundTransparency = 1
    image.Size = UDim2.fromScale(1, 1)
    image.Image = "rbxassetid://" .. tostring(panel.assetId)
    image.ImageRectOffset = Vector2.new(panel.offsetX, panel.offsetY)
    image.ImageRectSize = Vector2.new(panel.width, panel.height)
    image.ScaleType = Enum.ScaleType.Stretch
    image.Parent = surface
    paper:SetAttribute("NoticePanelId", panelId)
    paper:SetAttribute("NoticeAssetId", panel.assetId)
end

function WorldSignBuilder.dressNoticeBoard(
    board: BasePart,
    title: string,
    accent: Color3,
    panelIds: { string }
)
    WorldSignBuilder.dressBoard(board, title, accent, "notice")
    local details = board:FindFirstChild("PhysicalSignDetails")
    assert(details ~= nil, "notice board frame missing")

    local titlePlate = part(
        details,
        "NoticeBoardHeader",
        Vector3.new(math.min(board.Size.X * 0.92, 10.6), 1.45, 0.3),
        board.CFrame
            * CFrame.new(0, board.Size.Y * 0.5 + 0.92, -(board.Size.Z * 0.5 + 0.3))
            * CFrame.Angles(0, 0, math.rad(-1.5)),
        WET_BARK,
        Enum.Material.WoodPlanks
    )
    addSurfaceText(titlePlate, title, accent, true)
    -- Both notice boards are also mesh-replacement fallbacks, and the authored
    -- Creator Store board carries no notices of its own -- it is bare wood. So
    -- the header and the pinned art below have to outlive the replacement, or
    -- the board a player walks up to says nothing at all.
    titlePlate:SetAttribute("KeepVisibleOnReplacement", true)

    -- The header owns the wording; the board face holds actual pinned art.
    local boardSurface = board:FindFirstChild("PhysicalSignText")
    if boardSurface ~= nil then
        boardSurface:Destroy()
    end

    local columns = math.min(3, #panelIds)
    local rows = math.ceil(#panelIds / columns)
    local paperWidth = math.min(2.55, (board.Size.X - 1.2) / columns - 0.3)
    local paperHeight = paperWidth / 1.5
    local usableHeight = board.Size.Y - 0.9
    local rowSpacing = math.min(paperHeight + 0.35, usableHeight / rows)
    for index, panelId in panelIds do
        local row = math.floor((index - 1) / columns)
        local column = (index - 1) % columns
        local columnsInRow = math.min(columns, #panelIds - row * columns)
        local x = (column - (columnsInRow - 1) * 0.5) * (paperWidth + 0.35)
        local y = (rows - 1) * rowSpacing * 0.5 - row * rowSpacing - 0.12
        local rotation = math.rad(((index * 7) % 9) - 4)
        local paper = part(
            details,
            if board.Name == "TownBoard" then "TownNotice_" .. panelId else "ArchiveNotice",
            Vector3.new(paperWidth, paperHeight, 0.1),
            board.CFrame
                * CFrame.new(x, y, -(board.Size.Z * 0.5 + 0.22))
                * CFrame.Angles(0, 0, rotation),
            PARCHMENT,
            Enum.Material.Fabric
        )
        paper.CastShadow = false
        paper:SetAttribute("KeepVisibleOnReplacement", true)
        addNoticeArtwork(paper, panelId)

        local pin = part(
            details,
            "NoticeIronPin",
            Vector3.new(0.16, 0.16, 0.13),
            paper.CFrame * CFrame.new(0, paperHeight * 0.38, -0.12),
            IRON,
            Enum.Material.Metal
        )
        pin.Shape = Enum.PartType.Ball
        pin:SetAttribute("KeepVisibleOnReplacement", true)
        if index % 2 == 0 then
            local seal = part(
                details,
                "NoticeWaxSeal",
                Vector3.new(0.32, 0.32, 0.1),
                paper.CFrame * CFrame.new(paperWidth * 0.34, -paperHeight * 0.34, -0.12),
                WAX,
                Enum.Material.SmoothPlastic
            )
            seal.Shape = Enum.PartType.Ball
            seal:SetAttribute("KeepVisibleOnReplacement", true)
        end
    end
    board:SetAttribute("NoticeCount", #panelIds)
    board:SetAttribute("PhysicalNoticeBoard", true)
end

return table.freeze(WorldSignBuilder)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="141">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="142">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="143">
        <Properties>
          <string name="Name">LastLightClient</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local root = ReplicatedStorage:WaitForChild("LastLight", 8)
assert(root ~= nil, "Last Light shared root did not replicate before client bootstrap timeout")

local Config = require(root.Config)
local AmbientMotion = require(root.AmbientMotion)
local ExpeditionContracts = require(root.ExpeditionContracts)
local MusicCatalog = require(root.MusicCatalog)
local SfxCatalog = require(root.SfxCatalog)
local ProfessionCatalog = require(root.ProfessionCatalog)
local RuntimeIds = require(root.RuntimeIds)
local TownNightSchedule = require(root.TownNightSchedule)
local WeatherProfile = require(root.WeatherProfile)
local AmbientController = require(script.Controllers.AmbientController)
local HUDController = require(script.Controllers.HUDController)
local ObjectiveMarkerController = require(script.Controllers.ObjectiveMarkerController)
local TapController = require(script.Controllers.TapController)
local VignetteController = require(script.Controllers.VignetteController)
local InputController = require(script.Controllers.InputController)
local InteractionController = require(script.Controllers.InteractionController)
local MusicController = require(script.Controllers.MusicController)
local SfxController = require(script.Controllers.SfxController)
local PerformanceController = require(script.Controllers.PerformanceController)
local WorldMotionController = require(script.Controllers.WorldMotionController)
local WeatherController = require(script.Controllers.WeatherController)

local runtime =
    ReplicatedStorage:WaitForChild(RuntimeIds.FolderName, Config.BootstrapTimeoutSeconds)
assert(runtime ~= nil, "Last Light runtime did not replicate before client bootstrap timeout")

local actionRequest =
    runtime:WaitForChild(RuntimeIds.Remotes.ActionRequest, Config.BootstrapTimeoutSeconds)
local stateChanged =
    runtime:WaitForChild(RuntimeIds.Remotes.StateChanged, Config.BootstrapTimeoutSeconds)
local getState = runtime:WaitForChild(RuntimeIds.Remotes.GetState, Config.BootstrapTimeoutSeconds)
local performanceReport =
    runtime:WaitForChild(RuntimeIds.Remotes.PerformanceReport, Config.BootstrapTimeoutSeconds)
assert(actionRequest ~= nil and actionRequest:IsA("RemoteEvent"), "missing ActionRequest")
assert(stateChanged ~= nil and stateChanged:IsA("RemoteEvent"), "missing StateChanged")
assert(getState ~= nil and getState:IsA("RemoteFunction"), "missing GetState")
assert(
    performanceReport ~= nil and performanceReport:IsA("RemoteEvent"),
    "missing PerformanceReport"
)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui", Config.BootstrapTimeoutSeconds)
assert(playerGui ~= nil and playerGui:IsA("PlayerGui"), "PlayerGui unavailable")

local hud = HUDController.new(playerGui, ProfessionCatalog.list(), ExpeditionContracts.List)
local vignette = VignetteController.new(playerGui)
local objectiveMarkers = ObjectiveMarkerController.new(playerGui)
local ambient = AmbientController.new(RuntimeIds.AmbientMoteTag)
local worldMotion = WorldMotionController.new(
    RuntimeIds.AmbientMotionTag,
    RuntimeIds.AmbientLightTag,
    RuntimeIds.AmbientSwayTag,
    AmbientMotion
)
local weather = WeatherController.new(WeatherProfile)
local interaction = InteractionController.new(RuntimeIds.InteractionTag, hud)
local music = MusicController.new(MusicCatalog)
local sfx = SfxController.new(SfxCatalog)
PerformanceController.new(performanceReport :: RemoteEvent, Config.PerformanceReportIntervalSeconds)

local function send(kind: string, fields: { [string]: any }?)
    local payload = fields or {}
    payload.schemaVersion = 1
    payload.kind = kind
    actionRequest:FireServer(payload)
end

InputController.new(hud, function()
    local interactionId = interaction:currentInteractionId()
    if interactionId ~= nil then
        sfx:play("tap")
        send(RuntimeIds.Actions.Interact, { interactionId = interactionId })
    end
end, function()
    sfx:play("swing")
    send(RuntimeIds.Actions.UseTool)
end, function(enabled: boolean)
    send(RuntimeIds.Actions.Sprint, { enabled = enabled })
end, function()
    send(RuntimeIds.Actions.Dodge)
end, function()
    send(RuntimeIds.Actions.ProfessionAbility)
end, function()
    hud:setProfessionMenuOpen(true)
end, function()
    send(RuntimeIds.Actions.UseGear, { itemId = "gear_amber_charm" })
end, function()
    send(RuntimeIds.Actions.UseGear, { itemId = "gear_meadow_satchel" })
end)

--[[
    Tapping the world is the interaction model, and it has to work on a
    finger. The server ClickDetectors stay -- they are what a mouse uses and
    they carry the server-side validation -- but touch resolves its own tap
    here and sends the same requests, because Roblox will not reliably turn a
    tap in the camera-drag region of a phone screen into a click.
]]
TapController.new(function()
    -- The swing sounds on the tap itself: feedback that waits for the server
    -- round-trip reads as lag, not as hitting.
    sfx:play("swing")
    send(RuntimeIds.Actions.UseTool)
end, function(interactionId: string)
    sfx:play("tap")
    send(RuntimeIds.Actions.Interact, { interactionId = interactionId })
end)

hud:setCompactHandler(function(enabled: boolean)
    send(RuntimeIds.Actions.CompactHud, { enabled = enabled })
end)

hud:setLobbyDepartHandler(function(partySize: number, contractId: string)
    send(RuntimeIds.Actions.LobbyDepart, { partySize = partySize, contractId = contractId })
end)

hud:setLoadoutHandlers(function(slot: number)
    send(RuntimeIds.Actions.SaveLoadout, { slot = slot })
end, function(slot: number)
    send(RuntimeIds.Actions.ApplyLoadout, { slot = slot })
end)

hud:setProfessionHandler(function(professionId: string)
    send(RuntimeIds.Actions.SelectProfession, { professionId = professionId })
end)

hud:setEquipHandler(function(itemId: string)
    send(RuntimeIds.Actions.EquipGear, { itemId = itemId })
end)

hud:setWhetHandler(function(itemId: string)
    send(RuntimeIds.Actions.RepairGear, { itemId = itemId })
end)

hud:setCompanionHandler(function(mode: string)
    send(RuntimeIds.Actions.CompanionCommand, { mode = mode })
end)

--[[
    Arrival vignettes ride the same state stream the HUD already consumes:
    each one fires on a specific transition, locally, at most once per
    arrival. The focus points are found in the workspace at trigger time so a
    streamed-out or missing landmark simply skips the shot instead of aiming
    a camera at nothing.
]]
local lastNightActive = false
local lastBlackoutStatus: string? = nil
local lastEliteActive = false
local lastBossActive = false

local function focusPart(name: string): Vector3?
    local found = workspace:FindFirstChild(name, true)
    return if found ~= nil and found:IsA("BasePart")
        then found.Position
        elseif found ~= nil and found:IsA("Model") then found:GetPivot().Position
        else nil
end

local function updateVignettes(snapshot: any, suppress: boolean?)
    vignette:setCompact(snapshot.compactHud == true)

    local nightActive = snapshot.nightActive == true
    if suppress then
        -- A reconnect mid-arrival is not an arrival: seed the trackers from
        -- the first snapshot so a player who joins during a night or an
        -- active encounter is not greeted by a stale cinematic.
        lastNightActive = nightActive
        local seedBlackout = snapshot.blackout
        lastBlackoutStatus = if type(seedBlackout) == "table"
            then tostring(seedBlackout.status)
            else nil
        local seedElite = snapshot.elite
        lastEliteActive = type(seedElite) == "table" and seedElite.active == true
        local seedBoss = snapshot.boss
        lastBossActive = type(seedBoss) == "table" and seedBoss.active == true
        return
    end
    if nightActive and not lastNightActive and snapshot.expeditionActive ~= true then
        local nightNumber = tonumber(snapshot.nightNumber) or 0
        local title = "THE FIRST NIGHT"
        local subtitle = "KEEP THE LIGHT ALIVE"
        if nightNumber >= 1 then
            local theme = TownNightSchedule.theme(nightNumber)
            local profile = TownNightSchedule.profile(nightNumber)
            title = string.format("NIGHT %d · %s", nightNumber, theme)
            subtitle = tostring(profile.instruction)
        end
        local focus = focusPart("FirstLantern")
        if focus ~= nil then
            vignette:play({
                title = title,
                subtitle = subtitle,
                focus = focus,
                duration = 5.5,
            })
        end
    end
    lastNightActive = nightActive

    local blackout = snapshot.blackout
    local blackoutStatus = if type(blackout) == "table" then tostring(blackout.status) else nil
    if blackoutStatus == "relay" and lastBlackoutStatus ~= "relay" then
        local focus = focusPart("BlackoutLanternFire")
        if focus ~= nil then
            vignette:play({
                title = "THE BLACKOUT",
                subtitle = "CARRY THE ROOTFIRE",
                focus = focus,
                duration = 5.5,
            })
        end
    end
    lastBlackoutStatus = blackoutStatus

    local elite = snapshot.elite
    local eliteActive = type(elite) == "table" and elite.active == true
    if eliteActive and not lastEliteActive then
        local focus = focusPart("OldGrowthElite")
        if focus ~= nil then
            vignette:play({
                title = "OLD GROWTH",
                subtitle = "STRIKE THE AMBER HEART",
                focus = focus,
                duration = 4.5,
            })
        end
    end
    lastEliteActive = eliteActive

    local boss = snapshot.boss
    local bossActive = type(boss) == "table" and boss.active == true
    if bossActive and not lastBossActive then
        local focus = focusPart("WardenStagBoss")
        if focus ~= nil then
            vignette:play({
                title = "THE WARDEN STAG",
                subtitle = "CLEANSE THE LIVING ROOTS",
                focus = focus,
                duration = 4.5,
            })
        end
    end
    lastBossActive = bossActive
end

stateChanged.OnClientEvent:Connect(function(snapshot: any)
    hud:update(snapshot)
    ambient:setPhase(tostring(snapshot.phase or "day"))
    worldMotion:setPhase(tostring(snapshot.phase or "day"))
    weather:setContext(
        snapshot.expeditionActive == true,
        tostring(snapshot.phase or "day"),
        if type(snapshot.contract) == "table" then snapshot.contract.weather else nil
    )
    music:setSnapshot(snapshot)
    sfx:setSnapshot(snapshot)
    objectiveMarkers:setTargets(
        if snapshot.departed == true then snapshot.objectiveTargets else nil
    )
    updateVignettes(snapshot)
end)

task.spawn(function()
    local ok, snapshot = pcall(function()
        return getState:InvokeServer()
    end)
    if ok and snapshot ~= nil then
        hud:update(snapshot)
        ambient:setPhase(tostring(snapshot.phase or "day"))
        worldMotion:setPhase(tostring(snapshot.phase or "day"))
        weather:setContext(
            snapshot.expeditionActive == true,
            tostring(snapshot.phase or "day"),
            if type(snapshot.contract) == "table" then snapshot.contract.weather else nil
        )
        music:setSnapshot(snapshot)
        -- Seeds the SFX signature only: joining mid-night is not a night falling.
        sfx:setSnapshot(snapshot)
        objectiveMarkers:setTargets(
            if snapshot.departed == true then snapshot.objectiveTargets else nil
        )
        updateVignettes(snapshot, true)
    end
end)

print(string.format("[Last Light] Client boot %s", Config.BuildVersion))
]]></string>
        </Properties>
        <Item class="Folder" referent="144">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="145">
            <Properties>
              <string name="Name">AmbientController</string>
              <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local AmbientController = {}
AmbientController.__index = AmbientController

type MoteState = {
    basePosition: Vector3,
    baseTransparency: number,
    phaseOffset: number,
    visible: boolean,
}

export type AmbientController = typeof(setmetatable(
    {} :: {
        _tag: string,
        _motes: { [BasePart]: MoteState },
        _phase: string,
        _elapsed: number,
        _connection: RBXScriptConnection?,
    },
    AmbientController
))

local ACTIVE_DISTANCE = 125
local UPDATE_INTERVAL = 1 / 24

local function phaseOffsetFor(instance: Instance): number
    local position = if instance:IsA("BasePart") then instance.Position else Vector3.zero
    return math.abs(position.X * 0.071 + position.Y * 0.137 + position.Z * 0.043) % (math.pi * 2)
end

function AmbientController.new(tag: string): AmbientController
    local self = setmetatable({
        _tag = tag,
        _motes = {},
        _phase = "day",
        _elapsed = 0,
        _connection = nil,
    }, AmbientController)

    local function register(instance: Instance)
        if not instance:IsA("BasePart") or self._motes[instance] ~= nil then
            return
        end
        self._motes[instance] = {
            basePosition = instance.Position,
            baseTransparency = instance.Transparency,
            phaseOffset = phaseOffsetFor(instance),
            visible = false,
        }
    end
    local function unregister(instance: Instance)
        if instance:IsA("BasePart") then
            self._motes[instance] = nil
        end
    end

    for _, instance in CollectionService:GetTagged(tag) do
        register(instance)
    end
    CollectionService:GetInstanceAddedSignal(tag):Connect(register)
    CollectionService:GetInstanceRemovedSignal(tag):Connect(unregister)

    local accumulator = 0
    self._connection = RunService.RenderStepped:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < UPDATE_INTERVAL then
            return
        end
        local elapsed = accumulator
        accumulator = 0
        self:_step(elapsed)
    end)
    return self
end

function AmbientController.setPhase(self: AmbientController, phase: string)
    self._phase = string.lower(phase)
end

function AmbientController._step(self: AmbientController, deltaTime: number)
    self._elapsed += deltaTime
    local camera = Workspace.CurrentCamera
    if camera == nil then
        return
    end
    local cameraPosition = camera.CFrame.Position
    local night = self._phase == "night"
    local dusk = self._phase == "dusk"
    local amplitude = if night then 0.92 elseif dusk then 0.68 else 0.42
    local transparencyBias = if night then -0.08 elseif dusk then -0.03 else 0.14

    for mote, state in self._motes do
        if mote.Parent == nil then
            self._motes[mote] = nil
            continue
        end
        local active = (state.basePosition - cameraPosition).Magnitude <= ACTIVE_DISTANCE
        if active then
            local wave = self._elapsed + state.phaseOffset
            mote.Position = state.basePosition
                + Vector3.new(
                    math.sin(wave * 0.83) * amplitude,
                    math.sin(wave * 1.17) * amplitude * 0.45,
                    math.cos(wave * 0.71) * amplitude
                )
            mote.Transparency = math.clamp(
                state.baseTransparency + transparencyBias + math.sin(wave * 1.7) * 0.08,
                0.04,
                0.72
            )
            state.visible = true
        elseif state.visible then
            mote.Position = state.basePosition
            mote.Transparency = math.clamp(state.baseTransparency + transparencyBias, 0.04, 0.72)
            state.visible = false
        end
    end
end

return AmbientController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="146">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")

local HUDController = {}
HUDController.__index = HUDController

local function createItemIcon(parent: Instance, itemId: string, size: number): ViewportFrame
    local viewport = Instance.new("ViewportFrame")
    viewport.Name = "ItemIcon"
    viewport.Size = UDim2.fromOffset(size, size)
    viewport.Position = UDim2.fromOffset(6, 5)
    viewport.BackgroundColor3 = Color3.fromRGB(20, 31, 29)
    viewport.BackgroundTransparency = 0.12
    viewport.BorderSizePixel = 0
    viewport.Ambient = Color3.fromRGB(210, 220, 210)
    viewport.LightColor = Color3.fromRGB(255, 220, 160)
    viewport.ZIndex = parent:IsA("GuiObject") and parent.ZIndex + 1 or 1
    viewport.Parent = parent

    local world = Instance.new("WorldModel")
    world.Parent = viewport
    local camera = Instance.new("Camera")
    camera.CFrame = CFrame.new(0, 0.4, 6) * CFrame.Angles(0, math.rad(18), 0)
    camera.FieldOfView = 28
    camera.Parent = viewport
    viewport.CurrentCamera = camera

    local function shape(name: string, dimensions: Vector3, position: Vector3, color: Color3)
        local object = Instance.new("Part")
        object.Name = name
        object.Anchored = true
        object.CanCollide = false
        object.Size = dimensions
        object.Position = position
        object.Color = color
        object.Material = Enum.Material.SmoothPlastic
        object.Parent = world
        return object
    end

    if itemId == "gear_meadow_satchel" then
        shape(
            "Bag",
            Vector3.new(2.5, 1.8, 1.2),
            Vector3.new(0, 0, 0),
            Color3.fromRGB(133, 176, 108)
        )
        shape(
            "Flap",
            Vector3.new(2.1, 0.25, 1.25),
            Vector3.new(0, 0.95, -0.05),
            Color3.fromRGB(94, 128, 78)
        )
        shape(
            "Strap",
            Vector3.new(0.25, 2.6, 0.25),
            Vector3.new(0, 0.15, 0.7),
            Color3.fromRGB(73, 48, 36)
        )
    elseif itemId == "gear_amber_charm" then
        local gem = shape(
            "Amber",
            Vector3.new(1.4, 1.4, 1.4),
            Vector3.new(0, 0, 0),
            Color3.fromRGB(255, 181, 76)
        )
        gem.Shape = Enum.PartType.Ball
        local ring = shape(
            "Ring",
            Vector3.new(0.28, 2.2, 2.2),
            Vector3.new(0, 0, 0),
            Color3.fromRGB(94, 206, 176)
        )
        ring.Shape = Enum.PartType.Cylinder
        ring.Orientation = Vector3.new(0, 0, 90)
    elseif itemId == "gear_thornwood_bow" then
        shape(
            "Stave",
            Vector3.new(0.35, 2.6, 0.5),
            Vector3.new(0.2, 0, 0),
            Color3.fromRGB(112, 84, 52)
        )
        shape(
            "String",
            Vector3.new(0.12, 2.4, 0.12),
            Vector3.new(-0.45, 0, 0),
            Color3.fromRGB(214, 205, 186)
        )
    elseif itemId == "gear_heartwood_maul" then
        shape(
            "Haft",
            Vector3.new(0.35, 2.8, 0.35),
            Vector3.new(-0.2, -0.2, 0),
            Color3.fromRGB(96, 68, 44)
        )
        shape(
            "Head",
            Vector3.new(1.6, 0.95, 0.95),
            Vector3.new(0.15, 1.15, 0),
            Color3.fromRGB(139, 98, 54)
        )
    elseif itemId == "gear_briar_lance" then
        shape(
            "Shaft",
            Vector3.new(0.28, 3.2, 0.28),
            Vector3.new(0, -0.2, 0),
            Color3.fromRGB(104, 128, 68)
        )
        shape("Tip", Vector3.new(0.5, 0.8, 0.5), Vector3.new(0, 1.7, 0), Color3.fromRGB(74, 96, 46))
    elseif itemId == "gear_foxfire_sling" then
        shape(
            "Strap",
            Vector3.new(0.22, 2.4, 0.22),
            Vector3.new(0.25, 0.2, 0),
            Color3.fromRGB(78, 58, 41)
        )
        local pouch = shape(
            "Pouch",
            Vector3.new(1, 1, 1),
            Vector3.new(-0.45, -0.85, 0),
            Color3.fromRGB(94, 206, 176)
        )
        pouch.Shape = Enum.PartType.Ball
    elseif itemId == "gear_amber_edge" then
        shape(
            "Grip",
            Vector3.new(0.35, 1, 0.35),
            Vector3.new(0, -1.15, 0),
            Color3.fromRGB(73, 54, 38)
        )
        shape(
            "Blade",
            Vector3.new(0.3, 2.3, 0.75),
            Vector3.new(0, 0.55, 0),
            Color3.fromRGB(255, 197, 106)
        )
    elseif itemId == "gear_warden_cudgel" then
        shape(
            "Shaft",
            Vector3.new(0.4, 2.5, 0.4),
            Vector3.new(0, -0.4, 0),
            Color3.fromRGB(91, 62, 40)
        )
        local head = shape(
            "Head",
            Vector3.new(1.05, 1.05, 1.05),
            Vector3.new(0.1, 1.25, 0),
            Color3.fromRGB(112, 151, 119)
        )
        head.Shape = Enum.PartType.Ball
    elseif itemId == "gear_ironroot_hood" then
        shape(
            "Hood",
            Vector3.new(2.4, 1.8, 1.8),
            Vector3.new(0, 0.1, 0),
            Color3.fromRGB(76, 101, 88)
        )
        shape(
            "Rim",
            Vector3.new(2.6, 0.25, 1.9),
            Vector3.new(0, -0.82, -0.1),
            Color3.fromRGB(44, 62, 54)
        )
    else
        shape(
            "BootLeft",
            Vector3.new(0.9, 1.7, 1.8),
            Vector3.new(-0.65, -0.05, 0),
            Color3.fromRGB(142, 112, 84)
        )
        shape(
            "BootRight",
            Vector3.new(0.9, 1.7, 1.8),
            Vector3.new(0.65, -0.05, 0),
            Color3.fromRGB(116, 86, 63)
        )
    end
    return viewport
end

local COLORS = {
    ink = Color3.fromRGB(14, 22, 21),
    panel = Color3.fromRGB(20, 31, 29),
    panelSoft = Color3.fromRGB(28, 43, 39),
    cream = Color3.fromRGB(244, 230, 197),
    muted = Color3.fromRGB(178, 194, 183),
    amber = Color3.fromRGB(255, 181, 76),
    green = Color3.fromRGB(91, 166, 116),
    danger = Color3.fromRGB(220, 86, 71),
    blue = Color3.fromRGB(104, 177, 190),
}

local function corner(parent: Instance, radius: number)
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, radius)
    uiCorner.Parent = parent
end

local function stroke(parent: Instance, color: Color3, transparency: number)
    local uiStroke = Instance.new("UIStroke")
    uiStroke.Color = color
    uiStroke.Transparency = transparency
    uiStroke.Thickness = 1.5
    uiStroke.Parent = parent
end

local function textLabel(
    parent: Instance,
    name: string,
    text: string,
    size: UDim2,
    position: UDim2,
    textSize: number,
    color: Color3,
    alignment: Enum.TextXAlignment?
): TextLabel
    local label = Instance.new("TextLabel")
    label.Name = name
    label.BackgroundTransparency = 1
    label.Size = size
    label.Position = position
    label.Font = Enum.Font.GothamMedium
    label.Text = text
    label.TextColor3 = color
    label.TextSize = textSize
    label.TextWrapped = true
    label.TextXAlignment = alignment or Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = parent
    return label
end

local function actionButton(
    parent: Instance,
    name: string,
    text: string,
    size: number,
    position: UDim2,
    anchor: Vector2
): TextButton
    local button = Instance.new("TextButton")
    button.Name = name
    button.AnchorPoint = anchor
    button.Position = position
    button.Size = UDim2.fromOffset(size, size)
    button.AutoButtonColor = true
    button.BackgroundColor3 = COLORS.panel
    button.BackgroundTransparency = 0.04
    button.Font = Enum.Font.GothamBold
    button.Text = text
    button.TextColor3 = COLORS.cream
    button.TextSize = 18
    button.TextWrapped = true
    button.ZIndex = 10
    button.Parent = parent
    corner(button, math.floor(size / 2))
    stroke(button, COLORS.amber, 0.1)
    return button
end

export type HUDController = typeof(setmetatable(
    {} :: {
        _gui: ScreenGui,
        _actionFrame: Frame,
        _actionLabel: TextLabel,
        _actionFill: Frame,
        _canvas: Frame,
        _scale: UIScale,
        _phaseFrame: Frame,
        _phase: TextLabel,
        _objectiveFrame: Frame,
        _objective: TextLabel,
        _detail: TextLabel,
        _progress: TextLabel,
        _mara: TextLabel,
        _resource: TextLabel,
        _health: TextLabel,
        _staminaFrame: Frame,
        _staminaFill: Frame,
        _staminaText: TextLabel,
        _toast: TextLabel,
        _lanternFrame: Frame,
        _lanternFill: Frame,
        _lanternText: TextLabel,
        _blackoutFrame: Frame,
        _blackoutFill: Frame,
        _blackoutTitle: TextLabel,
        _blackoutDetail: TextLabel,
        _eliteFrame: Frame,
        _eliteFill: Frame,
        _eliteTitle: TextLabel,
        _eliteDetail: TextLabel,
        _allyFrame: Frame,
        _allyTitle: TextLabel,
        _allyDetail: TextLabel,
        _threatFrame: Frame,
        _threatTitle: TextLabel,
        _threatDetail: TextLabel,
        _downedFrame: Frame,
        _downedFill: Frame,
        _downedTimer: TextLabel,
        _downedDetail: TextLabel,
        _downedAlly: TextLabel,
        _primary: TextButton,
        _tool: TextButton,
        _sprint: TextButton,
        _dodge: TextButton,
        _ability: TextButton,
        _companion: TextButton,
        _companionMode: string,
        _onCompanionCommand: ((string) -> ())?,
        _compact: TextButton,
        _professionButton: TextButton,
        _lobbyFrame: Frame,
        _lobbyTitle: TextLabel,
        _lobbyDetail: TextLabel,
        _lobbySizes: Frame,
        _lobbySizeButtons: { TextButton },
        _contractButtons: { [string]: TextButton },
        _selectedContractId: string,
        _onLobbyDepart: ((number) -> ())?,
        _selectedPartySize: number?,
        _progressButton: TextButton,
        _useCharm: TextButton,
        _useSatchel: TextButton,
        _professionOverlay: Frame,
        _professionPanel: Frame,
        _professionCards: { [string]: TextButton },
        _professionOrder: { string },
        _professionClose: TextButton,
        _progressOverlay: Frame,
        _progressText: TextLabel,
        _equipmentButtons: { [string]: TextButton },
        _whetButton: TextButton,
        _whetItemId: string?,
        _onWhet: ((string) -> ())?,
        _currentState: any,
        _interactionLabel: string?,
        _interactionAvailable: boolean,
        _inputMode: string,
        _maraText: string,
        _maraShownAt: number,
        _compactEnabled: boolean,
        _playerDowned: boolean,
        _combatContext: boolean,
        _professionMenuOpen: boolean,
        _professionSwitchable: boolean,
        _lastToastRevision: number,
        _lastPhase: string?,
        _onCompact: ((boolean) -> ())?,
        _onProfessionSelected: ((string) -> ())?,
        _onEquip: ((string) -> ())?,
    },
    HUDController
))

function HUDController.new(
    playerGui: PlayerGui,
    professions: { any },
    contracts: { any }?
): HUDController
    local existing = playerGui:FindFirstChild("LastLightHUD")
    if existing ~= nil then
        existing:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "LastLightHUD"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = false
    gui.DisplayOrder = 20
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function()
        gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
        gui.SafeAreaCompatibility = Enum.SafeAreaCompatibility.FullscreenExtension
    end)
    gui.Parent = playerGui

    --[[
        The canvas is sized in _layout to compensate for its own UIScale.

        A UIScale shrinks its subtree toward the top-left corner, so at 0.78 a
        full-screen canvas only paints the top-left 78% of the screen. Every
        bottom-anchored control -- run, dodge, strike, the primary action --
        was therefore floating roughly a fifth of the way up the screen on a
        phone, over the play area and the player's own character, while
        Roblox's jump button stayed at the true bottom edge. Growing the canvas
        by the inverse of the scale puts its edges back on the screen edges.
    ]]
    local canvas = Instance.new("Frame")
    canvas.Name = "SafeCanvas"
    canvas.BackgroundTransparency = 1
    canvas.Size = UDim2.fromScale(1, 1)
    canvas.Parent = gui

    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = canvas

    local phaseFrame = Instance.new("Frame")
    phaseFrame.Name = "PhaseCapsule"
    phaseFrame.AnchorPoint = Vector2.new(0.5, 0)
    phaseFrame.Position = UDim2.new(0.5, 0, 0, 12)
    phaseFrame.Size = UDim2.fromOffset(206, 46)
    phaseFrame.BackgroundColor3 = COLORS.panel
    phaseFrame.BackgroundTransparency = 0.08
    phaseFrame.Parent = canvas
    corner(phaseFrame, 23)
    stroke(phaseFrame, COLORS.amber, 0.28)
    local phase = textLabel(
        phaseFrame,
        "Phase",
        "DAY · MORNING",
        UDim2.fromScale(1, 1),
        UDim2.fromScale(0, 0),
        17,
        COLORS.cream,
        Enum.TextXAlignment.Center
    )
    phase.Font = Enum.Font.GothamBold

    local objectiveFrame = Instance.new("Frame")
    objectiveFrame.Name = "ObjectiveCard"
    objectiveFrame.Position = UDim2.fromOffset(18, 18)
    objectiveFrame.Size = UDim2.fromOffset(326, 132)
    objectiveFrame.BackgroundColor3 = COLORS.panel
    objectiveFrame.BackgroundTransparency = 0.1
    objectiveFrame.Parent = canvas
    corner(objectiveFrame, 16)
    stroke(objectiveFrame, COLORS.cream, 0.72)

    local progress = textLabel(
        objectiveFrame,
        "Progress",
        "FIRST LIGHT · 1 / 8",
        UDim2.new(1, -28, 0, 24),
        UDim2.fromOffset(14, 8),
        12,
        COLORS.amber
    )
    progress.Font = Enum.Font.GothamBold
    local objective = textLabel(
        objectiveFrame,
        "Objective",
        "FREE MARA",
        UDim2.new(1, -28, 0, 44),
        UDim2.fromOffset(14, 28),
        26,
        COLORS.cream
    )
    objective.Font = Enum.Font.GothamBold
    -- Long objectives were being clipped rather than fitted: the card gave
    -- this line 34 pixels, which holds exactly one line even at the 16-pixel
    -- floor (two 16-pixel lines need ~38 with line spacing), so "TAKE
    -- ROOTFIRE FROM THE BLACKOUT LANTERN" rendered as "TAKE ROOTFIRE FROM
    -- THE". 44 pixels holds two floor-size lines, keeping short objectives at
    -- full size and letting a long one wrap instead of disappearing.
    objective.TextScaled = true
    local objectiveFit = Instance.new("UITextSizeConstraint")
    objectiveFit.MaxTextSize = 26
    objectiveFit.MinTextSize = 16
    objectiveFit.Parent = objective
    local detail = textLabel(
        objectiveFrame,
        "Detail",
        "Follow the lantern path.",
        UDim2.new(1, -28, 0, 42),
        UDim2.fromOffset(14, 76),
        18,
        COLORS.muted
    )
    detail.TextYAlignment = Enum.TextYAlignment.Top

    local mara = textLabel(
        canvas,
        "MaraGuide",
        "Mara: Follow the light.",
        UDim2.fromOffset(430, 48),
        UDim2.new(0.5, 0, 1, -164),
        15,
        COLORS.cream
    )
    mara.BackgroundColor3 = COLORS.ink
    mara.BackgroundTransparency = 0.24
    mara.TextXAlignment = Enum.TextXAlignment.Center
    mara.AnchorPoint = Vector2.new(0.5, 1)
    corner(mara, 12)
    stroke(mara, COLORS.amber, 0.55)

    local resource = textLabel(
