function ProfileService.contributeToConstruction(
    self: ProfileService,
    player: Player,
    buildingId: string
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            reason = "profile_read_only",
        }
    end

    local ceilingStage = self._saveSchema.townConsequence(profile).buildingStages[buildingId] or 0
    local nextProfile, result =
        self._saveSchema.withConstructionContribution(profile, buildingId, ceilingStage, os.time())
    if not result.applied then
        return {
            accepted = false,
            reason = result.reason,
        }
    end

    self._profiles[player] = nextProfile
    if self._persistent and self._writable[player] == true then
        self._dirty[player] = true
    end
    return {
        accepted = true,
        buildingId = result.buildingId,
        stage = result.stage,
    }
end

-- Safe to call after any action, whether or not it moved a quest signal:
-- returns an empty list and touches nothing when there's nothing newly
-- claimable.
function ProfileService.checkQuests(self: ProfileService, player: Player): { any }
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return {}
    end

    local nextProfile, claimedResults = self._saveSchema.checkAndClaimQuests(profile, os.time())
    if #claimedResults == 0 then
        return claimedResults
    end

    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    return claimedResults
end

function ProfileService.questSnapshot(self: ProfileService, player: Player): { any }
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.questSnapshot(profile)
end

function ProfileService.gearSnapshot(self: ProfileService, player: Player): { [string]: number }
    local profile = self._profiles[player]
    if profile == nil then
        return {}
    end
    return self._saveSchema.gearSnapshot(profile)
end

function ProfileService.grantUnbankedExpeditionReward(
    self: ProfileService,
    player: Player,
    transactionId: string,
    manifestHash: string,
    reward: any
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            durable = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            durable = false,
            reason = "profile_read_only",
        }
    end

    local nextProfile, result = self._saveSchema.withUnbankedExpeditionReward(
        profile,
        transactionId,
        manifestHash,
        reward,
        os.time()
    )
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    elseif not result.duplicate then
        return {
            accepted = false,
            durable = false,
            reason = result.reason,
        }
    end

    local durable = not self._persistent
    if self._persistent and result.applied then
        task.spawn(function()
            self:save(player)
        end)
    elseif self._persistent and result.duplicate then
        durable = self._dirty[player] ~= true
    end
    return {
        accepted = true,
        applied = result.applied == true,
        durable = durable,
        reason = if durable then nil else "save_queued",
    }
end

function ProfileService.settleExpedition(
    self: ProfileService,
    player: Player,
    runId: string,
    manifestHash: string,
    sessionRewards: { any }
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            reason = "profile_read_only",
        }
    end

    local workingProfile = profile
    local sessionTransactionIds = {}
    for _, sessionReward in sessionRewards do
        local nextProfile, result = self._saveSchema.withUnbankedExpeditionReward(
            workingProfile,
            sessionReward.transactionId,
            sessionReward.manifestHash,
            {
                amount = sessionReward.amount,
                materialId = sessionReward.materialId,
            },
            os.time()
        )
        if not result.applied and not result.duplicate then
            return {
                accepted = false,
                reason = result.reason,
            }
        end
        workingProfile = nextProfile
        table.insert(sessionTransactionIds, sessionReward.transactionId)
    end

    local pending = self._saveSchema.expeditionPending(workingProfile)
    local settlementId = nil
    local settlementRecord = nil
    if pending.count > 0 then
        settlementId =
            self._saveSchema.expeditionSettlementId(runId, player.UserId, pending.fingerprint)
        local nextProfile, result = self._saveSchema.withExpeditionSettlement(
            workingProfile,
            settlementId,
            manifestHash,
            os.time()
        )
        if not result.applied and not result.duplicate then
            return {
                accepted = false,
                reason = result.reason,
            }
        end
        workingProfile = nextProfile
        settlementRecord = result.record
    elseif #sessionTransactionIds > 0 then
        settlementId, settlementRecord = self._saveSchema.findExpeditionSettlementForRewards(
            workingProfile,
            sessionTransactionIds
        )
    end

    if workingProfile ~= profile then
        self._profiles[player] = workingProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    if settlementId == nil then
        return {
            accepted = true,
            empty = true,
            inventory = table.clone(workingProfile.inventory.materials),
            sessionTransactionIds = sessionTransactionIds,
        }
    end

    local saved = if self._persistent then self:save(player) else true
    local activeProfile = self._profiles[player]
    local durable = saved
        and activeProfile ~= nil
        and self._saveSchema.hasExpeditionSettlement(activeProfile, settlementId)
    return {
        accepted = durable,
        durable = durable,
        inventory = if activeProfile == nil
            then {}
            else table.clone(activeProfile.inventory.materials),
        materials = if settlementRecord == nil then {} else table.clone(settlementRecord.materials),
        overflow = if settlementRecord ~= nil and settlementRecord.overflow ~= nil
            then table.clone(settlementRecord.overflow)
            else nil,
        reason = if durable then nil else "save_pending",
        settlementId = settlementId,
        sessionTransactionIds = sessionTransactionIds,
    }
end

function ProfileService.inventorySnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            banked = {},
            cachedTransactionIds = {},
            pending = {},
            pendingRewards = {},
            recovery = nil,
        }
    end
    local pending = self._saveSchema.expeditionPending(profile)
    return {
        banked = table.clone(profile.inventory.materials),
        cachedTransactionIds = self._saveSchema.expeditionCachedTransactionIds(profile),
        pending = pending.materials,
        pendingRewards = pending.rewards,
        recovery = self._saveSchema.expeditionRecovery(profile),
    }
end

function ProfileService.cacheExpeditionFailure(
    self: ProfileService,
    player: Player,
    runId: string,
    manifestHash: string,
    sessionRewards: { any }
): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { accepted = false, reason = "profile_unavailable" }
    end
    local workingProfile = profile
    for _, sessionReward in sessionRewards do
        local nextProfile, result = self._saveSchema.withUnbankedExpeditionReward(
            workingProfile,
            sessionReward.transactionId,
            sessionReward.manifestHash,
            { amount = sessionReward.amount, materialId = sessionReward.materialId },
            os.time()
        )
        if not result.applied and not result.duplicate then
            return { accepted = false, reason = result.reason }
        end
        workingProfile = nextProfile
    end

    local pending = self._saveSchema.expeditionPending(workingProfile)
    if pending.count < 2 then
        if workingProfile ~= profile then
            self._profiles[player] = workingProfile
            if self._persistent then
                self._dirty[player] = true
            end
        end
        local durable = if self._persistent and self._dirty[player] == true
            then self:save(player)
            else true
        return {
            accepted = durable,
            cached = false,
            durable = durable,
            reason = if durable then "pouch_retained" else "save_pending",
        }
    end
    local baseCacheId =
        self._saveSchema.expeditionRecoveryCacheId(runId, player.UserId, pending.fingerprint)
    local cacheId = baseCacheId
    local suffix = 1
    while
        workingProfile.inventory.recoveryCaches[cacheId] ~= nil
        and workingProfile.inventory.recoveryCaches[cacheId].status == "recovered"
    do
        suffix += 1
        cacheId = string.format("%s:%d", baseCacheId, suffix)
    end
    local nextProfile, result = self._saveSchema.withExpeditionFailureCache(
        workingProfile,
        cacheId,
        manifestHash,
        os.time()
    )
    if not result.applied and not result.duplicate then
        return { accepted = false, reason = result.reason }
    end
    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    local durable = if self._persistent then self:save(player) else true
    return {
        accepted = durable,
        cacheId = cacheId,
        cached = true,
        durable = durable,
        materials = result.materials or {},
        reason = if durable then "cached" else "save_pending",
        retained = result.retained or 0,
        transactionIds = result.transactionIds or {},
    }
end

function ProfileService.recoveryCache(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    return if profile == nil then nil else self._saveSchema.expeditionRecovery(profile)
end

function ProfileService.recoverExpeditionCache(
    self: ProfileService,
    player: Player,
    cacheId: string
): any
    local profile = self._profiles[player]
    if profile == nil or not self:isWritable(player) then
        return { accepted = false, reason = "profile_unavailable" }
    end
    local nextProfile, result =
        self._saveSchema.withRecoveredExpeditionCache(profile, cacheId, os.time())
    if not result.applied then
        if result.duplicate then
            local durable = if self._persistent and self._dirty[player] == true
                then self:save(player)
                else true
            return {
                accepted = durable,
                cacheId = cacheId,
                durable = durable,
                materials = result.materials or {},
                reason = if durable then "recovered" else "save_pending",
            }
        end
        return { accepted = false, reason = result.reason }
    end
    self._profiles[player] = nextProfile
    if self._persistent then
        self._dirty[player] = true
    end
    local durable = if self._persistent then self:save(player) else true
    return {
        accepted = durable,
        cacheId = cacheId,
        durable = durable,
        materials = result.materials or {},
        reason = if durable then "recovered" else "save_pending",
    }
end

function ProfileService.completeChapterOne(
    self: ProfileService,
    player: Player,
    transactionId: string,
    decision: string,
    wardenOutcome: string
): any
    local profile = self._profiles[player]
    if profile == nil then
        return {
            accepted = false,
            durable = false,
            reason = "profile_loading",
        }
    end
    if not self:isWritable(player) then
        return {
            accepted = false,
            durable = false,
            reason = "profile_read_only",
        }
    end
    local nextProfile, result = self._saveSchema.withChapterOneResolution(
        profile,
        transactionId,
        decision,
        wardenOutcome,
        os.time()
    )
    if not result.applied and not result.duplicate then
        return {
            accepted = false,
            durable = true,
            reason = result.reason,
        }
    end
    if result.applied then
        self._profiles[player] = nextProfile
        if self._persistent then
            self._dirty[player] = true
        end
    end
    local durable = not self._persistent
    if self._persistent and result.applied then
        local saved = self:save(player)
        local activeProfile = self._profiles[player]
        local chapter = if activeProfile == nil
            then nil
            else self._saveSchema.chapterOne(activeProfile)
        durable = saved
            and chapter ~= nil
            and chapter.status == "complete"
            and chapter.transactionId == transactionId
    elseif self._persistent and result.duplicate then
        local saved = if self._dirty[player] == true then self:save(player) else true
        local activeProfile = self._profiles[player]
        local chapter = if activeProfile == nil
            then nil
            else self._saveSchema.chapterOne(activeProfile)
        durable = saved
            and self._dirty[player] ~= true
            and chapter ~= nil
            and chapter.status == "complete"
            and chapter.transactionId == transactionId
    end
    return {
        accepted = true,
        applied = result.applied == true,
        durable = durable,
        reason = if durable then result.reason else "save_pending",
        story = result.record,
    }
end

function ProfileService.chapterOneSnapshot(self: ProfileService, player: Player): any
    local profile = self._profiles[player]
    if profile == nil then
        return nil
    end
    return self._saveSchema.chapterOne(profile)
end

function ProfileService.save(self: ProfileService, player: Player): boolean
    local profile = self._profiles[player]
    if profile == nil then
        return false
    end
    if not self._persistent then
        return true
    end
    if self._store == nil or self._writable[player] ~= true then
        self._logger:warn("profile_save_skipped_read_only", {
            player = player.UserId,
        })
        return false
    end
    if self._saving[player] then
        return false
    end
    self._saving[player] = true

    local retainedNewer = false
    local newerProfile: any = nil
    local ok, message = pcall(function()
        (self._store :: GlobalDataStore):UpdateAsync(
            string.format("player_%d", player.UserId),
            function(current: any)
                local normalized = if current == nil
                    then nil
                    else self._saveSchema.normalize(current, os.time())
                local decision = self._profilePersistence.resolveWrite(normalized, profile)
                if decision.action == "retain_stored" then
                    retainedNewer = true
                    newerProfile = normalized
                    return current
                end
                -- The lock rides along with the profile so a crash leaves
                -- behind a heartbeat that stops, which is the only thing a
                -- later session can use to tell dead from merely slow.
                local written = table.clone(profile)
                written.sessionLock = self._profilePersistence.lock(self._jobId, os.time())
                return written
            end
        )
    end)
    self._saving[player] = nil

    if not ok then
        self._logger:warn("profile_save_failed", {
            player = player.UserId,
            reason = tostring(message),
        })
        return false
    end

    if retainedNewer and newerProfile ~= nil then
        local activeProfile = self._profiles[player]
        if activeProfile ~= nil and activeProfile.revision <= newerProfile.revision then
            self._profiles[player] = newerProfile
            self._dirty[player] = nil
        end
        self._logger:warn("profile_save_retained_newer_revision", {
            player = player.UserId,
            attemptedRevision = profile.revision,
            storedRevision = newerProfile.revision,
        })
        return true
    end

    -- The write carried a fresh lock, so the heartbeat is only recorded on the
    -- path that actually reached the store.
    self._lockHeartbeat[player] = os.time()

    -- Ordinary rate-limited copy of a save that has just been written. Spawned
    -- for the same reason as the load-path capture: the autosave beat is the
    -- busiest path in the game and must not wait on a second store.
    task.spawn(function()
        self:_captureBackup(player.UserId, profile, profile.schemaVersion, nil)
    end)

    local activeProfile = self._profiles[player]
    if activeProfile ~= nil and activeProfile.revision == profile.revision then
        self._dirty[player] = nil
    end
    self._logger:info("profile_saved", {
        player = player.UserId,
        revision = profile.revision,
        stage = profile.tutorial.stage,
    })
    return true
end

--[[
    Read-only inspection of any player's save, online or not.

    Reads the DataStore key directly rather than going through a live
    session, which is the entire point: an admin needs to look at a save
    whether or not that player is on this server, or on any server at all.
    It never touches self._profiles, never claims the lock, and cannot be
    reached by anything but AdminService, which is itself gated to the
    roster.

    In non-persistent mode (Studio without ProfileLockStaleAfterSeconds
    wired to a real store) there is nothing durable to read, so this reports
    "not found" rather than reaching for a store that was never opened.
]]
function ProfileService.inspect(self: ProfileService, userId: number): any
    assert(type(userId) == "number" and userId > 0, "inspection target must be a valid user ID")
    local now = os.time()
    local staleAfter = self._config.ProfileLockStaleAfterSeconds

    if not self._persistent or self._store == nil then
        return self._adminInspectionReport.build(nil, now, staleAfter)
    end

    local ok, result = pcall(function()
        return (self._store :: GlobalDataStore):GetAsync(string.format("player_%d", userId))
    end)
    if not ok then
        self._logger:warn("profile_inspection_failed", {
            userId = userId,
            reason = tostring(result),
        })
        error("could not read that profile right now")
    end

    return self._adminInspectionReport.build(result, now, staleAfter)
end

--[[
    Clears a lock, but only one that is already dead.

    This is the one write an offline profile is allowed to receive from an
    admin, and it is deliberately the narrowest write that could exist: it
    can remove a stale sessionLock field and nothing else. It cannot touch
    night number, materials, equipment, or anything a player earned, which is
    what keeps it out of the "repair tool becomes a duplication vector"
    problem inspect's own doc comment warns about.

    Safety is UpdateAsync re-deciding from scratch on the value it is actually
    about to commit over, using the exact same ProfilePersistence.acquireLock
    a real server uses to decide whether it may start playing a profile --
    not a snapshot read beforehand, which could be stale by the time the
    write lands. A throwaway job ID is passed in because this is not claiming
    the lock for a session; a decision of "already_held" would only mean the
    stored jobId happens to collide with that throwaway string, which cannot
    happen. Every other acquireLock outcome -- unlocked, malformed, stale, a
    heartbeat from a broken clock -- means the same thing here: no live
    server is holding this, so the field may go.
]]
function ProfileService.forceUnlock(self: ProfileService, userId: number): any
    assert(type(userId) == "number" and userId > 0, "unlock target must be a valid user ID")

    if not self._persistent or self._store == nil then
        return { applied = false, reason = "not_persistent" }
    end

    local outcome: any = { applied = false, reason = "update_did_not_run" }
    local ok, err = pcall(function()
        (self._store :: GlobalDataStore):UpdateAsync(
            string.format("player_%d", userId),
            function(current: any)
                if current == nil then
                    outcome = { applied = false, reason = "no_save_on_record" }
                    return nil
                end
                local existingLock = if type(current) == "table" then current.sessionLock else nil
                if existingLock == nil then
                    outcome = { applied = false, reason = "already_unlocked" }
                    return nil
                end
                local decision = self._profilePersistence.acquireLock(
                    existingLock,
                    "admin-unlock-check",
                    os.time(),
                    self._config.ProfileLockStaleAfterSeconds
                )
                if not decision.acquired then
                    outcome = { applied = false, reason = "lock_is_active" }
                    return nil
                end
                local updated = table.clone(current)
                updated.sessionLock = nil
                outcome = { applied = true, reason = decision.reason }
                return updated
            end
        )
    end)
    if not ok then
        self._logger:warn("profile_unlock_failed", { userId = userId, reason = tostring(err) })
        error("could not update that profile right now")
    end

    return outcome
end

--[[
    What copies exist for a player, without restoring anything.

    The read half of the repair tooling, and the one an operator should always
    run first: a restore is a deliberate move backwards in a player's progress,
    and the only way to make that judgement is to see how far back the copies go
    and why each was taken.
]]
function ProfileService.backupSummary(self: ProfileService, userId: number): any
    assert(type(userId) == "number" and userId > 0, "backup target must be a valid user ID")

    if not self._persistent or self._backupStore == nil then
        return self._profileBackup.summary(nil)
    end

    local ok, result = pcall(function()
        return (self._backupStore :: GlobalDataStore):GetAsync(string.format("player_%d", userId))
    end)
    if not ok then
        self._logger:warn("profile_backup_read_failed", {
            userId = userId,
            reason = tostring(result),
        })
        error("could not read that player's backups right now")
    end

    return self._profileBackup.summary(result)
end

--[[
    Roll a save back to its most recent copy.

    The safe-repair half of Milestone 4's admin deliverable, and the riskiest
    call in this file, so the constraints are worth stating plainly:

      * **It refuses while a live server holds the profile.** Restoring under a
        session that is still writing would have that session's next autosave
        immediately overwrite the restore -- or worse, land between the read and
        the write. `lock_is_active` here means the same thing it means for
        /unlock: something is genuinely still playing this, and forcing it is
        the exact race the locking system exists to prevent.
      * **The pre-restore profile is itself copied first.** A restore is
        therefore undoable: an operator who rolls back the wrong player, or the
        wrong far, has the state they replaced sitting in the same ring. Without
        this the tool is a one-way door, and a one-way door in a repair tool is
        how a repair becomes an incident.
      * **It never invents progress.** The only thing written is a profile this
        player previously had, at a revision above the live one so the write
        actually lands. Nothing is merged, topped up, or granted.
]]
--[[
    The raw stored profile as JSON, for the export half of the admin
    tooling. Reads the stored bytes, not the in-memory session, because an
    export exists to answer "what is actually in the datastore" -- the same
    question a migration audit asks.
]]
function ProfileService.exportProfile(self: ProfileService, userId: number): any
    assert(type(userId) == "number" and userId > 0, "export target must be a valid user ID")
    if not self._persistent or self._store == nil then
        return { ok = false, reason = "not_persistent" }
    end
    local readOk, stored = pcall(function()
        return (self._store :: GlobalDataStore):GetAsync(string.format("player_%d", userId))
    end)
    if not readOk then
        return { ok = false, reason = "read_failed" }
    end
    if stored == nil then
        return { ok = false, reason = "no_save_on_record" }
    end
    local encodeOk, encoded = pcall(function()
        return game:GetService("HttpService"):JSONEncode(stored)
    end)
    if not encodeOk then
        return { ok = false, reason = "encode_failed" }
    end
    return { ok = true, json = encoded }
end

function ProfileService.restoreLatestBackup(
    self: ProfileService,
    userId: number,
    copyIndex: number?
): any
    assert(type(userId) == "number" and userId > 0, "restore target must be a valid user ID")

    if not self._persistent or self._store == nil or self._backupStore == nil then
        return { applied = false, reason = "not_persistent" }
    end

    local readOk, stored = pcall(function()
        return (self._backupStore :: GlobalDataStore):GetAsync(string.format("player_%d", userId))
    end)
    if not readOk then
        self._logger:warn("profile_backup_read_failed", {
            userId = userId,
            reason = tostring(stored),
        })
        error("could not read that player's backups right now")
    end

    -- An explicit copy index restores history; no index keeps the everyday
    -- newest-copy behaviour. An index with no copy behind it refuses rather
    -- than falling back -- see ProfileBackup.snapshotAt.
    local snapshot = if copyIndex ~= nil
        then self._profileBackup.snapshotAt(stored, copyIndex)
        else self._profileBackup.newest(stored)
    if snapshot == nil then
        return {
            applied = false,
            reason = if copyIndex ~= nil then "no_such_copy" else "no_backup_on_record",
        }
    end

    local outcome: any = { applied = false, reason = "update_did_not_run" }
    local replaced: any = nil
    local ok, err = pcall(function()
        (self._store :: GlobalDataStore):UpdateAsync(
            string.format("player_%d", userId),
            function(current: any)
                if current == nil then
                    outcome = { applied = false, reason = "no_save_on_record" }
                    return nil
                end

                -- Decided against the value actually about to be committed
                -- over, not against a snapshot read beforehand, for the same
                -- reason forceUnlock does it here.
                local existingLock = if type(current) == "table" then current.sessionLock else nil
                if existingLock ~= nil then
                    local decision = self._profilePersistence.acquireLock(
                        existingLock,
                        "admin-restore-check",
                        os.time(),
                        self._config.ProfileLockStaleAfterSeconds
                    )
                    if not decision.acquired then
                        outcome = { applied = false, reason = "lock_is_active" }
                        return nil
                    end
                end

                local storedRevision = if type(current) == "table" then current.revision else nil
                local restored =
                    self._profileBackup.restoredProfile(snapshot, storedRevision, os.time())

                replaced = current
                outcome = {
                    applied = true,
                    reason = snapshot.reason,
                    restoredRevision = restored.revision,
                    fromRevision = storedRevision,
                    capturedAt = snapshot.capturedAt,
                    schemaVersion = snapshot.schemaVersion,
                }
                return restored
            end
        )
    end)
    if not ok then
        self._logger:warn("profile_restore_failed", { userId = userId, reason = tostring(err) })
        error("could not update that profile right now")
    end

    -- Only after the restore has actually committed, so a refused restore does
    -- not spend a slot in the ring on a copy of a profile nothing replaced.
    if outcome.applied and replaced ~= nil then
        self:_captureBackup(userId, replaced, nil, "pre_restore")
    end

    return outcome
end

return table.freeze(ProfileService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">RegionEncounterService</string>
            <string name="Source"><![CDATA[--!strict

--[[
    One service for the six encounters the new regions brought.

    OldGrowthService and WardenStagService are each ~800 lines, and most
    of those lines are the same lines: hold a state table, spawn a model,
    watch who is in the arena, run a telegraph, route a strike, settle a
    reward once. Writing that four more times for the elites and twice
    more for the bosses would be five thousand lines of copy with five
    thousand chances to diverge, and the divergences are exactly where
    the bugs would live.

    So the encounters describe themselves and this drives them. Each one
    already exposes the same shape -- create, activate, join, strike,
    snapshot, rewardTransactionId, Tuning, Reward -- because they were
    written to the Old Growth's contract on purpose. What differs between
    them is the verb in the middle: the Echo's levers, the Widow's
    anchors, the Maw's lines and vents, the Many-Face's mirrors, the
    Caller's pools, the Witch's copies. Those arrive as an interaction
    table, so a fight's own rules stay in its own module and this file
    stays the thing that makes any of them happen in a world.

    Deliberately not here: model geometry (the arena builder owns that),
    telegraph visuals (the enemy attack flow owns those), and anything
    that would let a client assert progress. Every mutation below is
    called by the server in answer to an interaction the world raised.
]]

local RunService = game:GetService("RunService")

local RegionEncounterService = {}
RegionEncounterService.__index = RegionEncounterService
RegionEncounterService.Name = "RegionEncounterService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

--[[
    What an encounter has to tell this service about itself. The verbs
    are optional because no two of these fights ask the same thing: the
    Echo has levers and no windows, the Widow has windows and no levers,
    the Witch has neither and asks a question instead.
]]
export type Definition = {
    id: string,
    regionId: string,
    module: any,
    -- interactionId -> what to do with it, server-side, on a real tap.
    interactions: { [string]: (state: any, player: Player, now: number) -> (any, any) },
    -- Called on the service's tick; returns a new state or nil for "no change".
    tick: ((state: any, now: number) -> any?)?,
}

type Live = {
    definition: Definition,
    state: any,
    anchors: { [string]: BasePart },
}

export type RegionEncounterService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _profileService: any,
        _survivalService: any,
        _featureFlags: any,
        _runId: string,
        _manifestHash: string,
        _live: { [string]: Live },
        _toastHandler: ((Player?, string) -> ())?,
        _heartbeat: RBXScriptConnection?,
    },
    RegionEncounterService
))

function RegionEncounterService.new(
    logger: Logger,
    profileService: any,
    survivalService: any,
    featureFlags: any
): RegionEncounterService
    return setmetatable({
        Name = RegionEncounterService.Name,
        _logger = logger,
        _profileService = profileService,
        _survivalService = survivalService,
        _featureFlags = featureFlags,
        _runId = "",
        _manifestHash = "",
        _live = {},
        _toastHandler = nil,
        _heartbeat = nil,
    }, RegionEncounterService)
end

function RegionEncounterService.Init(_self: RegionEncounterService, _context: any) end

function RegionEncounterService.setToastHandler(
    self: RegionEncounterService,
    handler: (Player?, string) -> ()
)
    self._toastHandler = handler
end

function RegionEncounterService._toast(
    self: RegionEncounterService,
    player: Player?,
    message: string?
)
    local handler = self._toastHandler
    if handler ~= nil and message ~= nil and message ~= "" then
        handler(player, message)
    end
end

--[[
    Bind a region's encounters to a run. Called when a region is built,
    with the manifest hash that makes every reward id in the run unique
    to it -- the same guarantee the Old Growth has had since it shipped,
    and the reason a player cannot farm one elite by rejoining.
]]
function RegionEncounterService.beginRun(
    self: RegionEncounterService,
    runId: string,
    manifestHash: string,
    definitions: { Definition },
    anchorsById: { [string]: { [string]: BasePart } }
)
    assert(runId ~= "", "encounter run id is required")
    assert(manifestHash ~= "", "encounter manifest hash is required")
    self._runId = runId
    self._manifestHash = manifestHash
    self._live = {}
    for _, definition in definitions do
        local enabled = self._featureFlags:isEnabled("region_encounters_enabled")
        self._live[definition.id] = {
            definition = definition,
            state = definition.module.create(runId, manifestHash, enabled),
            anchors = anchorsById[definition.id] or {},
        }
        self._logger:info("region_encounter_ready", {
            encounter = definition.id,
            enabled = enabled,
            region = definition.regionId,
        })
    end
end

function RegionEncounterService.endRun(self: RegionEncounterService)
    self._live = {}
end

--[[
    A player taps something in an arena. The interaction table decides
    what that means to this fight, and the fight's own module decides
    whether it was allowed -- this only carries the answer back out.
]]
function RegionEncounterService.interact(
    self: RegionEncounterService,
    player: Player,
    encounterId: string,
    interactionId: string
): boolean
    local live = self._live[encounterId]
    if live == nil then
        return false
    end
    if not self._survivalService:canAct(player) then
        self:_toast(player, "YOU CANNOT DO THAT WHILE DOWNED")
        return false
    end
    local handler = live.definition.interactions[interactionId]
    if handler == nil then
        return false
    end
    local nextState, result = handler(live.state, player, workspace:GetServerTimeNow())
    if nextState ~= nil then
        live.state = nextState
    end
    if type(result) == "table" then
        self:_toast(player, result.message)
        if result.completed == true then
            self:_settle(player, live)
        end
    end
    return true
end

--[[
    Strike whichever encounter this player is standing in. Returns the
    same (landed, message) shape EnemyService.damageNearest does, because
    the strike path routes through one call site and every encounter that
    answers it has to answer it the same way.
]]
function RegionEncounterService.damageNearest(
    self: RegionEncounterService,
    player: Player,
    encounterId: string,
    amount: number
): (boolean, string)
    local live = self._live[encounterId]
    if live == nil then
        return false, "No encounter is active."
    end
    if not self._survivalService:canAct(player) then
        return false, "You cannot strike while downed."
    end
    local strike = live.definition.module.strike
    local nextState, result =
        strike(live.state, player.UserId, amount, workspace:GetServerTimeNow())
    live.state = nextState
    if type(result) ~= "table" or result.accepted ~= true then
        local snapshot = live.definition.module.snapshot(live.state, player.UserId, 0)
        return false, tostring(snapshot.instruction)
    end
    if result.completed == true then
        self:_settle(player, live)
    end
    return true, tostring(result.reason)
end

--[[
    Pay the encounter out, once per participant per run. The transaction
    id is the encounter's own, which is what makes a rejoin idempotent:
    the ledger has seen that id before and refuses the second grant
    without anyone here having to remember.
]]
function RegionEncounterService._settle(self: RegionEncounterService, player: Player, live: Live)
    local reward = live.definition.module.Reward
    if type(reward) ~= "table" then
        return
    end
    local transactionId = live.definition.module.rewardTransactionId(live.state, player.UserId)
    local result = self._profileService:grantUnbankedExpeditionReward(
        player,
        transactionId,
        self._manifestHash,
        { materialId = reward.materialId, amount = reward.amount }
    )
    self._logger:info("region_encounter_settled", {
        applied = if type(result) == "table" then result.applied else nil,
        encounter = live.definition.id,
        player = player.UserId,
    })
end

function RegionEncounterService.snapshot(
    self: RegionEncounterService,
    player: Player,
    encounterId: string
): any
    local live = self._live[encounterId]
    if live == nil then
        return nil
    end
    return live.definition.module.snapshot(live.state, player.UserId, workspace:GetServerTimeNow())
end

function RegionEncounterService.activeIds(self: RegionEncounterService): { string }
    local ids: { string } = {}
    for encounterId in self._live do
        table.insert(ids, encounterId)
    end
    table.sort(ids)
    return ids
end

function RegionEncounterService.Start(self: RegionEncounterService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.25 then
            return
        end
        accumulator = 0
        local now = workspace:GetServerTimeNow()
        for _, live in self._live do
            local tick = live.definition.tick
            if tick ~= nil then
                local nextState = tick(live.state, now)
                if nextState ~= nil then
                    live.state = nextState
                end
            end
        end
    end)
end

return table.freeze(RegionEncounterService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">TownNightService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local TownNightService = {}
TownNightService.__index = TownNightService
TownNightService.Name = "TownNightService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type TownNightService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _enemyService: any,
        _defenseService: any,
        _defenseLanes: any,
        _townNightSchedule: any,
        _townNightIncident: any,
        _townCondition: any,
        _townPermissions: any,
        _hostUserId: number?,
        _townGuardLastStand: any,
        _analyticsService: any,
        _condition: any,
        _lastStandState: any,
        _daySeconds: number,
        _duskSeconds: number,
        _nightSeconds: number,
        _blackoutInterval: number,
        _enabled: boolean,
        _started: boolean,
        _nightNumber: number,
        _activeNightNumber: number,
        _phase: string,
        _phaseEndsAt: number,
        _onChanged: ((string?) -> ())?,
        _onNightCompleted: ((number, number, any) -> ())?,
        _incident: any,
    },
    TownNightService
))

function TownNightService.new(
    logger: Logger,
    config: any,
    worldService: any,
    enemyService: any,
    townNightSchedule: any,
    townNightIncident: any,
    townCondition: any,
    townPermissions: any,
    townGuardLastStand: any,
    analyticsService: any,
    featureFlags: any
): TownNightService
    return setmetatable({
        Name = TownNightService.Name,
        _logger = logger,
        _worldService = worldService,
        _enemyService = enemyService,
        _defenseService = nil,
        _defenseLanes = nil,
        _townNightSchedule = townNightSchedule,
        _townNightIncident = townNightIncident,
        _townCondition = townCondition,
        _townPermissions = townPermissions,
        _hostUserId = nil,
        _townGuardLastStand = townGuardLastStand,
        _analyticsService = analyticsService,
        _condition = townCondition.default(),
        _lastStandState = townGuardLastStand.default(),
        _daySeconds = config.NormalDaySeconds,
        _duskSeconds = config.DuskSeconds,
        _nightSeconds = config.NormalNightSeconds,
        _blackoutInterval = config.BlackoutInterval,
        _enabled = featureFlags:isEnabled("town_night_cycle_enabled"),
        _started = false,
        _nightNumber = 1,
        _activeNightNumber = 0,
        _phase = "dormant",
        _phaseEndsAt = 0,
        _onChanged = nil,
        _onNightCompleted = nil,
        _incident = nil,
    }, TownNightService)
end

function TownNightService.Init(_self: TownNightService, _context: any) end

function TownNightService.Start(_self: TownNightService) end

function TownNightService.setDefense(self: TownNightService, defenseService: any, defenseLanes: any)
    self._defenseService = defenseService
    self._defenseLanes = defenseLanes
end

function TownNightService.setChangedHandler(self: TownNightService, callback: (string?) -> ())
    self._onChanged = callback
end

-- Fires once per completed night with the next night number every connected
-- profile should record, the ending lantern health, and the reconciled town
-- condition. Persistence stays owned by whoever is holding each profile.
function TownNightService.setNightCompletedHandler(
    self: TownNightService,
    callback: (number, number, any) -> ()
)
    self._onNightCompleted = callback
end

function TownNightService._notify(self: TownNightService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function TownNightService._expireIncident(
    self: TownNightService,
    nightNumber: number,
    incidentId: string
)
    local incident = self._incident
    if
        incident == nil
        or incident.nightNumber ~= nightNumber
        or incident.definition.id ~= incidentId
        or incident.status ~= "active"
    then
        return
    end
    local nextIncident, result =
        self._townNightIncident.expire(incident, workspace:GetServerTimeNow())
    if not result.applied then
        return
    end
    self._incident = nextIncident
    self._worldService:clearTownIncident()
    local pressure =
        self._enemyService:applyLanternPressure(result.lanternPenalty, incident.definition.id)
    self:_notify(
        string.format(
            "%s FAILED — %d SITE%s LOST · FIRST LANTERN -%d",
            incident.definition.title,
            result.unresolved,
            if result.unresolved == 1 then "" else "S",
            pressure.damage or 0
        )
    )
    self._logger:info("town_incident_failed", {
        damage = pressure.damage or 0,
        incident = incident.definition.id,
        night = nightNumber,
        unresolved = result.unresolved,
    })
end

function TownNightService._startIncident(self: TownNightService, nightNumber: number, theme: string)
    self._worldService:clearTownIncident()
    local now = workspace:GetServerTimeNow()
    local incident = self._townNightIncident.create(theme, nightNumber, now)
    self._incident = incident
    self._worldService:startTownIncident(incident.definition, incident.endsAt)
    self:_notify(incident.definition.title .. " — " .. incident.definition.instruction)
    self._logger:info("town_incident_started", {
        incident = incident.definition.id,
        night = nightNumber,
        required = #incident.definition.sites,
    })
    task.delay(incident.definition.duration + 0.05, function()
        self:_expireIncident(nightNumber, incident.definition.id)
    end)
end

function TownNightService.resolveIncident(
    self: TownNightService,
    player: Player,
    prompt: ProximityPrompt
): any
    local incident = self._incident
    if self._phase ~= "night" or incident == nil or incident.status ~= "active" then
        return {
            accepted = false,
            message = "THAT NIGHT INCIDENT IS NO LONGER ACTIVE",
            reason = "incident_inactive",
        }
    end
    local siteId = prompt:GetAttribute("Payload")
    local nextIncident, result =
        self._townNightIncident.interact(incident, siteId, workspace:GetServerTimeNow())
    if not result.accepted then
        if result.reason == "incident_expired" then
            self:_expireIncident(incident.nightNumber, incident.definition.id)
        end
        return {
            accepted = false,
            message = if result.reason == "site_resolved"
                then "THAT SITE IS ALREADY SECURE"
                else "THE INCIDENT WINDOW HAS CLOSED",
            reason = result.reason,
        }
    end

    self._incident = nextIncident
    self._worldService:resolveTownIncidentSite(result.siteId, nextIncident.resolvedCount)
    self._logger:info("town_incident_site_resolved", {
        incident = incident.definition.id,
        player = player.UserId,
        remaining = result.remaining,
        site = result.siteId,
    })
    if result.completed then
        self:_notify(incident.definition.title .. " SECURED — THE WATCH HOLDS")
        task.delay(1.5, function()
            if self._incident == nextIncident then
                self._worldService:clearTownIncident()
            end
        end)
        return {
            accepted = true,
            completed = true,
            message = incident.definition.title .. " SECURED",
            reason = "incident_complete",
        }
    end
    return {
        accepted = true,
        completed = false,
        message = string.format(
            "%s SECURED — %d SITE%s REMAIN",
            string.upper(tostring(result.siteId)),
            result.remaining,
            if result.remaining == 1 then "" else "S"
        ),
        reason = "site_resolved",
    }
end

local function waitUntilTime(target: number)
    while workspace:GetServerTimeNow() < target do
        task.wait(0.15)
    end
end

-- Called once for every player in this server session known to be past
-- First Light — either a fresh player who just finished it, or a returning
-- player whose saved profile already had it complete. `nightNumber` is that
-- player's own persisted record; the town resumes from the highest one seen
-- rather than always restarting at night one, so nobody's progress from a
-- prior session is understated. Safe to call repeatedly and from either
-- path: only the first call actually starts the loop, but every call still
-- raises the count if the caller's record is higher (this only affects
-- nights that haven't started their wave schedule yet — see _runCycle).
-- Disabling the kill switch leaves the tutorial's authored First Night,
-- Bramblewake expeditions, and manual Blackout entry untouched — only this
-- repeating town day/dusk/night loop stops advancing.
function TownNightService.ensureStarted(
    self: TownNightService,
    nightNumber: number,
    condition: any?,
    actorUserId: number?
)
    self._nightNumber = math.max(self._nightNumber, math.floor(nightNumber))

    -- The first player to establish this server's town owns it. Everyone after
    -- them is visiting, and a visit may improve the town or leave it alone --
    -- never break it. Without this a player arriving from a later, wrecked town
    -- replaced an intact one outright, because condition resolves on night
    -- number before it looks at integrity.
    if self._hostUserId == nil and actorUserId ~= nil then
        self._hostUserId = actorUserId
    end

    if condition ~= nil then
        local role = self._townPermissions.roleFor(actorUserId, self._hostUserId)
        self._condition = self._townPermissions.resolveCondition(
            self._condition,
            condition,
            role,
            self._townCondition.merge,
            self._townCondition.averageIntegrity
        )
        self._worldService:setTownCondition(self:conditionSnapshot())
    end
    if not self._enabled or self._started then
        return
    end
    self._started = true
    task.spawn(function()
        self:_runCycle()
    end)
end

function TownNightService._runCycle(self: TownNightService)
    while true do
        self._phase = "day"
        self._activeNightNumber = 0
        self._phaseEndsAt = workspace:GetServerTimeNow() + self._daySeconds
        self._worldService:setDusk(false)
        self._worldService:setTownRepairEnabled(true)
        self:_notify(nil)
        self._logger:info("town_day_started", { night = self._nightNumber })
        waitUntilTime(self._phaseEndsAt)

        self._phase = "dusk"
        self._phaseEndsAt = workspace:GetServerTimeNow() + self._duskSeconds
        self._worldService:setDusk(true)
        self._worldService:setTownRepairEnabled(false)
        self:_notify(
            string.format(
                "DUSK FALLS — %s NIGHT %d APPROACHES",
                self._townNightSchedule.theme(self._nightNumber),
                self._nightNumber
            )
        )
        waitUntilTime(self._phaseEndsAt)

        self._phase = "night"
        self._incident = nil
        local nightStartedAt = workspace:GetServerTimeNow()
        self._phaseEndsAt = nightStartedAt + self._nightSeconds
        -- Frozen for the rest of this night: a higher number from a veteran
        -- who joins mid-night (ensureStarted always raises self._nightNumber
        -- to the max seen) must not retroactively change the wave schedule,
        -- toasts, or completion bookkeeping already committed to for this
        -- specific night — only self._nightNumber (read again below, after
        -- this night ends) picks it up, for the *next* night onward.
        local activeNight = self._nightNumber
        self._activeNightNumber = activeNight
        local blackoutDue = self:_isBlackoutDue(activeNight)
        local theme = self._townNightSchedule.theme(activeNight)
        local themeProfile = self._townNightSchedule.profile(activeNight)
        self._worldService:setNight(true, theme)
        self._enemyService:startNight(themeProfile)
        self:_notify(
            if blackoutDue
                then string.format(
                    "%s NIGHT %d — THE BLACKOUT LOOMS IN BRAMBLEWAKE",
                    theme,
                    activeNight
                )
                else string.format(
                    "%s NIGHT %d — %s",
                    theme,
                    activeNight,
                    themeProfile.instruction
                )
        )
        --[[
            The director's census: defenders who are actually in this fight
            -- past First Light's survival gate and standing in the town, not
            off in Bramblewake. Counted once at nightfall so the night's
            layout stays deterministic even as players come and go; a defender
            who leaves mid-night thins the line, not the schedule.
        ]]
        local partySize = 0
        for _, player in Players:GetPlayers() do
            if
                player:GetAttribute("LastLightTutorialSurvivalReady") == true
                and player:GetAttribute("LastLightInExpedition") ~= true
            then
                partySize += 1
            end
        end
        partySize = math.max(partySize, 1)
        self._logger:info("town_night_started", {
            blackoutDue = blackoutDue,
            night = activeNight,
            partySize = partySize,
            waves = self._townNightSchedule.waveCount(activeNight, partySize),
        })
        if self._defenseService ~= nil then
            self._defenseService:onNightStarted(partySize)
        end

        for _, beat in self._townNightSchedule.beats(self._nightSeconds, activeNight, partySize) do
            waitUntilTime(nightStartedAt + beat.at)
            if beat.kind == "spawn" then
                self._worldService:signalNightWave(beat.enemyId, beat.wave, theme)
                local laneId = if self._defenseLanes ~= nil
                    then self._defenseLanes.laneForWave(activeNight, beat.wave).id
                    else nil
                self._enemyService:spawn(beat.enemyId, laneId)
            elseif beat.kind == "breach" then
                self._worldService:setTownBreach(true, theme)
                self._enemyService:setBreach()
            elseif beat.kind == "incident" then
                self:_startIncident(activeNight, theme)
            elseif beat.kind == "warning" and beat.at > 0 then
                -- The schedule's opening warning beat always lands at at=0,
                -- immediately after the arrival toast above (which already
                -- carries the seventh-night Blackout telegraph on the nights
                -- that matter) — publishing it too would replace that toast
                -- before a player could read it.
                self:_notify("THE FOREST GOES QUIET")
            end
        end

        waitUntilTime(self._phaseEndsAt)
        local endingIncident = self._incident
        if endingIncident ~= nil and endingIncident.status == "active" then
            self:_expireIncident(activeNight, endingIncident.definition.id)
        end
        self._worldService:clearTownIncident()
        local endingLanternHealth = self._enemyService:lanternHealth()
        -- What physically stands to be broken. A building still at stage zero
        -- is a construction site, and damaging one would mean repairing
        -- something nobody has built yet.
        local damageable = self._worldService:damageableBuildingIds()
        local nextCondition, damageResult = self._townCondition.afterNight(
            self._condition,
            endingLanternHealth,
            activeNight,
            damageable
        )
        self._condition = nextCondition
        self._enemyService:stopNight()
        if self._defenseService ~= nil then
            self._defenseService:onNightEnded()
        end
        self._activeNightNumber = 0
        self._worldService:setTownBreach(false, theme)
        self._worldService:setNight(false)
        local conditionSnapshot = self:conditionSnapshot()
        self._worldService:setTownCondition(conditionSnapshot)
        local damage = tonumber(damageResult.damage) or 0
        local dawnToast = if damage > 0
            then string.format(
                "DAWN BREAKS — TOWN INTEGRITY %d%% · %d REPAIR%s NEEDED",
                conditionSnapshot.integrity,
                conditionSnapshot.repairsRemaining,
                if conditionSnapshot.repairsRemaining == 1 then "" else "S"
            )
            elseif conditionSnapshot.repairsRemaining > 0 then string.format(
                "DAWN BREAKS — NIGHT %d HELD CLEAN · TOWN INTEGRITY %d%%",
                activeNight,
                conditionSnapshot.integrity
            )
            else string.format("DAWN BREAKS — NIGHT %d HELD CLEAN", activeNight)
        self:_notify(dawnToast)
        self._logger:info("town_night_completed", {
            damage = damage,
            endingLanternHealth = endingLanternHealth,
            integrity = conditionSnapshot.integrity,
            night = activeNight,
        })
        -- Adopt whichever is higher: the honest next night after the one
        -- that just actually ran, or a veteran's still-pending higher seed
        -- from ensureStarted. Either way this can only advance.
        self._nightNumber = math.max(self._nightNumber, activeNight + 1)
        local onNightCompleted = self._onNightCompleted
        if onNightCompleted ~= nil then
            onNightCompleted(activeNight + 1, endingLanternHealth, self:conditionSnapshot())
        end
        task.wait(0)
    end
end

--[[
    Whose town this server is, and what the asking player is in it. The
    deliberate half of the visit flow: the role has always been enforced,
    but nobody was ever told which side of it they stood on.
]]
function TownNightService.hostInfo(self: TownNightService, actorUserId: number?): any
    local hostUserId = self._hostUserId
    if hostUserId == nil then
        return nil
    end
    return {
        hostUserId = hostUserId,
        role = self._townPermissions.roleFor(actorUserId, hostUserId),
    }
end

function TownNightService.conditionSnapshot(self: TownNightService): any
    -- Scoped to what physically stands, so a migrated profile that marks every
    -- building damaged cannot present repair work on an empty construction lot.
    return self._townCondition.snapshot(self._condition, self._worldService:damageableBuildingIds())
end

function TownNightService.attemptLastStand(
    self: TownNightService,
    eligiblePlayers: number,
    downedPlayers: number
): any
    local activeNight = if self._activeNightNumber > 0
        then self._activeNightNumber
        else self._nightNumber
    local nextState, result = self._townGuardLastStand.attempt(self._lastStandState, {
        phase = self._phase,
        nightNumber = activeNight,
        lanternHealth = self._enemyService:lanternHealth(),
        eligiblePlayers = eligiblePlayers,
        downedPlayers = downedPlayers,
    })
    self._lastStandState = nextState
    if not result.accepted then
        self._analyticsService:townGuardLastStand(
            false,
            result.reason,
            eligiblePlayers,
            activeNight,
            self._enemyService:lanternHealth()
        )
        return result
    end

    local lantern =
        self._enemyService:spendLanternStrength(result.lanternCost, "town_guard_last_stand")
    result.lanternHealth = lantern.health
    result.lanternSpent = lantern.spent
    self._analyticsService:townGuardLastStand(
        true,
        result.reason,
        eligiblePlayers,
        activeNight,
        lantern.health
    )
    self._logger:info("town_guard_last_stand", {
        lanternHealth = lantern.health,
        night = activeNight,
        partySize = eligiblePlayers,
    })
    return result
end

--[[
    Repair one named building.

    `buildingId` comes from the repair prompt's own Payload attribute, baked in
    at world build time -- the same one-object-one-outcome route the crafting
    benches use. The client sends the generic interaction ID and never names a
    building, so a forged payload cannot repair something that was not there.
]]
--[[
    Tomas's dawn boon: one free repair point on the worst-hit standing
    building. Reuses the same condition transaction as a player repair, so
    it can never restore more than a hammer swing would.
]]
function TownNightService.residentRepair(self: TownNightService): any?
    local snapshot = self:conditionSnapshot()
    local worst = nil
    for _, entry in snapshot.damaged or {} do
        if worst == nil or entry.integrity < worst.integrity then
            worst = entry
        end
    end
    if worst == nil then
        return nil
    end
    local nextCondition, result = self._townCondition.repair(self._condition, worst.buildingId)
    if not result.applied then
        return nil
    end
    self._condition = nextCondition
    self._worldService:setTownCondition(self:conditionSnapshot())
    return { buildingId = worst.buildingId, restored = result.restored }
end

function TownNightService.themeForNight(self: TownNightService, nightNumber: number): string
    return tostring(self._townNightSchedule.theme(nightNumber))
end

function TownNightService.repairTown(self: TownNightService, buildingId: any): any
    if self._phase ~= "day" then
        return { accepted = false, message = "TOWN REPAIRS WAIT FOR DAYLIGHT", reason = "not_day" }
    end
    local nextCondition, result = self._townCondition.repair(self._condition, buildingId)
    if not result.applied then
        local message = if result.reason == "unknown_building"
            then "THERE IS NOTHING TO REPAIR HERE"
            else "THIS BUILDING IS ALREADY REPAIRED"
        return { accepted = false, message = message, reason = result.reason }
    end
    self._condition = nextCondition
    self._worldService:setTownCondition(self:conditionSnapshot())
    local snapshot = self:conditionSnapshot()
    return {
        accepted = true,
        condition = snapshot,
        message = string.format(
            "REPAIRED +%d · %d%% · %d LEFT IN TOWN",
            result.restored,
            result.buildingIntegrity,
            snapshot.repairsRemaining
        ),
        reason = result.reason,
    }
end

function TownNightService._isBlackoutDue(self: TownNightService, nightNumber: number?): boolean
    return (nightNumber or self._nightNumber) % self._blackoutInterval == 0
end

function TownNightService.isNightActive(self: TownNightService): boolean
    return self._phase == "night"
end

function TownNightService.snapshot(self: TownNightService): any
    return {
        blackoutDue = self:_isBlackoutDue(),
        blackoutInterval = self._blackoutInterval,
        enemyCount = self._enemyService:activeCount(),
        lanternHealth = self._enemyService:lanternHealth(),
        townCondition = self:conditionSnapshot(),
        nightActive = self:isNightActive(),
        nightNumber = self._nightNumber,
        theme = self._townNightSchedule.theme(self._nightNumber),
        phase = self._phase,
        phaseEndsAt = self._phaseEndsAt,
        incident = self._townNightIncident.snapshot(self._incident),
    }
end

return table.freeze(TownNightService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local TutorialService = {}
TutorialService.__index = TutorialService
TutorialService.Name = "TutorialService"

-- Mirrors the earliest stage the authored First Night can target a player
-- (TutorialFlow only reaches "survive" once a player has a barricade, a
-- tool, and the First Lantern prepared). EnemyService reads this attribute
-- so the recurring town night cycle can't target a player still gathering,
-- choosing a tool, or building, the same way the one-time first night never
-- could before it existed.
local function isCombatEligibleStage(stage: string): boolean
    return stage == "survive" or stage == "reveal" or stage == "complete"
end

type Session = {
    stage: string,
    resources: number,
    selectedTool: string?,
    compactHud: boolean,
    toast: string?,
    toastRevision: number,
}

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type TutorialService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _runtimeIds: any,
        _tutorialFlow: any,
        _rateLimiter: any,
        _actionPayloadContract: any,
        _featureFlags: any,
        _networkService: any,
        _profileService: any,
        _worldService: any,
        _enemyService: any,
        _survivalService: any,
        _combatService: any,
        _professionService: any,
        _phaseService: any,
        _townNightService: any,
        _lobbyService: any,
        _expeditionService: any,
        _oldGrowthService: any,
        _wardenStagService: any,
        _blackoutService: any,
        _analyticsService: any,
        _craftingCatalog: any,
        _equipmentCatalog: any,
        _residentDialogue: any,
        _actionProgress: any,
        _toolCatalog: any,
        _gearWear: any,
        _gearTraits: any,
        _companionService: any,
        _actions: { [Player]: any },
        _sessions: { [Player]: Session },
        _expeditionModuleIndex: { [Player]: number },
        _expeditionEventRevision: { [Player]: number },
        _expeditionEventSecond: { [Player]: number },
        _limiter: any,
    },
    TutorialService
))

function TutorialService.new(
    logger: Logger,
    config: any,
    runtimeIds: any,
    tutorialFlow: any,
    rateLimiter: any,
    featureFlags: any,
    networkService: any,
    profileService: any,
    worldService: any,
    enemyService: any,
    survivalService: any,
    combatService: any,
    professionService: any,
    phaseService: any,
    townNightService: any,
    lobbyService: any,
    expeditionService: any,
    oldGrowthService: any,
    wardenStagService: any,
    blackoutService: any,
    analyticsService: any,
    craftingCatalog: any,
    equipmentCatalog: any,
    residentDialogue: any,
    actionProgress: any,
    toolCatalog: any,
    gearWear: any,
    gearTraits: any
): TutorialService
    return setmetatable({
        Name = TutorialService.Name,
        _logger = logger,
        _config = config,
        _runtimeIds = runtimeIds,
        _tutorialFlow = tutorialFlow,
        _rateLimiter = rateLimiter,
        _actionPayloadContract = nil,
        _featureFlags = featureFlags,
        _networkService = networkService,
        _profileService = profileService,
        _worldService = worldService,
        _enemyService = enemyService,
        _survivalService = survivalService,
        _combatService = combatService,
        _professionService = professionService,
        _phaseService = phaseService,
        _townNightService = townNightService,
        _lobbyService = lobbyService,
        _expeditionService = expeditionService,
        _oldGrowthService = oldGrowthService,
        _wardenStagService = wardenStagService,
        _blackoutService = blackoutService,
        _analyticsService = analyticsService,
        _craftingCatalog = craftingCatalog,
        _equipmentCatalog = equipmentCatalog,
        _residentDialogue = residentDialogue,
        _actionProgress = actionProgress,
        _toolCatalog = toolCatalog,
        _gearWear = gearWear,
        _gearTraits = gearTraits,
        _companionService = nil,
        _actions = {},
        _sessions = {},
        _expeditionModuleIndex = {},
        _expeditionEventRevision = {},
        _expeditionEventSecond = {},
        _limiter = rateLimiter.new(config.ActionRatePerSecond, config.ActionRatePerSecond * 2),
    }, TutorialService)
end

function TutorialService.Init(self: TutorialService, context: any)
    self._actionPayloadContract =
        assert(context.actionPayloadContract, "action payload contract unavailable")

    self._profileService:onLoaded(function(player: Player, profile: any)
        self:_profileLoaded(player, profile)
    end)

    self._networkService:setActionHandler(function(player: Player, payload: any)
        self:_handleAction(player, payload)
    end)
    self._networkService:setSnapshotProvider(function(player: Player)
        return self:snapshot(player)
    end)
    self._phaseService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for player, session in self._sessions do
                session.toast = toast
                session.toastRevision += 1
                self:_publish(player)
            end
        else
            self:_publishAll()
        end
    end)
    self._phaseService:setCompleteHandler(function()
        self:_nightComplete()
    end)
    self._townNightService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for _, session in self._sessions do
                if session.stage == "complete" then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._townNightService:setNightCompletedHandler(
        function(nightNumber: number, endingLanternHealth: number, condition: any)
            -- Resident life resolves on the night that just ran. The context
            -- is identical for every profile on the server, so every player's
            -- town remembers the same night.
            local buildingIntegrity: { [string]: number } = {}
            for _, entry in condition.damaged or {} do
                buildingIntegrity[entry.buildingId] = entry.integrity / 100
            end
            local residentContext = {
                nightNumber = nightNumber - 1,
                buildingIntegrity = buildingIntegrity,
                lanternHitFloor = endingLanternHealth <= 18,
            }
            local sharedReport: any = nil
            for player in self._sessions do
                self._profileService:setNightNumber(player, nightNumber)
                self._profileService:setTownCondition(player, condition)
                local report = self._profileService:applyResidentNight(player, residentContext)
                if sharedReport == nil and report ~= nil then
                    sharedReport = report
                end
                local questSuffix = self:_questToastSuffix(player)
                if questSuffix ~= nil then
                    self:_setToast(player, questSuffix)
                end
            end
            if sharedReport ~= nil then
                for _, residentId in sharedReport.injuries do
                    self._worldService:setResidentInjured(residentId, true)
                    self:_toastAll(
                        string.format(
                            "%s WAS HURT IN THE NIGHT — CHECK ON THEM",
                            string.upper(string.gsub(string.gsub(residentId, "npc_", ""), "_", " "))
                        )
                    )
                end
                for _, residentId in sharedReport.recoveries do
                    self._worldService:setResidentInjured(residentId, false)
                end
                if sharedReport.crisis ~= nil then
                    self:_toastAll(
                        sharedReport.crisis.title .. " — " .. sharedReport.crisis.detail
                    )
                end
            end
            -- Dawn boons from whoever is present; the effects are town-wide
            -- and deterministic, so the first profile speaks for the server.
            for player in self._sessions do
                local boons = self._profileService:residentDawnBoons(player)
                for _, boon in boons do
                    if boon.boon == "dawn_repair" then
                        local repaired = self._townNightService:residentRepair()
                        if repaired ~= nil then
                            self:_toastAll(boon.label)
                        end
                    elseif boon.boon == "night_forewarning" then
                        self:_toastAll(
                            string.format(
                                "%s — NIGHT %d: %s",
                                boon.label,
                                nightNumber,
                                self._townNightService:themeForNight(nightNumber)
                            )
                        )
                    elseif boon.boon == "lantern_reserve" then
                        self._enemyService:grantLanternReserve(6)
                        self:_toastAll(boon.label)
                    end
                end
                break
            end
            self._analyticsService:townNightConsequence(
                nightNumber - 1,
                endingLanternHealth,
                condition.integrity,
                condition.damageLevel
            )
            self:_publishAll()
        end
    )
    self._enemyService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for _, session in self._sessions do
                if session.stage == "survive" then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._oldGrowthService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for player, session in self._sessions do
                if self._oldGrowthService:snapshot(player) ~= nil then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._wardenStagService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for player, session in self._sessions do
                if self._wardenStagService:snapshot(player) ~= nil then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._blackoutService:setChangedHandler(function(toast: string?)
        if toast ~= nil then
            for player, session in self._sessions do
                if self._blackoutService:snapshot(player) ~= nil then
                    session.toast = toast
                    session.toastRevision += 1
                end
            end
        end
        self:_publishAll()
    end)
    self._survivalService:setChangedHandler(function(player: Player?, toast: string?)
        if player ~= nil and toast ~= nil then
            self:_setToast(player, toast)
        end
        self:_publishAll()
    end)
    self._combatService:setChangedHandler(function(player: Player, toast: string?)
        if toast ~= nil then
            self:_setToast(player, toast)
        end
        self:_publish(player)
    end)
    self._professionService:setChangedHandler(function(player: Player, toast: string?)
        if toast ~= nil then
            self:_setToast(player, toast)
        end
        self:_publishAll()
    end)
end

function TutorialService.Start(self: TutorialService)
    Players.PlayerRemoving:Connect(function(player: Player)
        self._sessions[player] = nil
        self._expeditionModuleIndex[player] = nil
        self._expeditionEventRevision[player] = nil
        self._expeditionEventSecond[player] = nil
        self._limiter:clear(tostring(player.UserId))
        self._analyticsService:clear(player)
    end)

    for _, player in Players:GetPlayers() do
        local profile = self._profileService:get(player)
        if profile ~= nil then
            self:_profileLoaded(player, profile)
        end
    end

    -- Timed actions need a finer tick than the expedition poll below, because
    -- the whole point is a bar that visibly fills over a second or two.
    local actionAccumulator = 0
    RunService.Heartbeat:Connect(function(deltaTime: number)
        actionAccumulator += deltaTime
        if actionAccumulator < 0.1 then
            return
        end
        actionAccumulator = 0
        self:_stepActions()
    end)

    local expeditionAccumulator = 0
    RunService.Heartbeat:Connect(function(deltaTime: number)
        expeditionAccumulator += deltaTime
        if expeditionAccumulator < 0.5 then
            return
        end
        expeditionAccumulator = 0

        for player in self._sessions do
            local expedition = self._expeditionService:snapshot(player)
            local moduleIndex = if expedition.active then expedition.moduleIndex else 0
            local eventRevision = if expedition.active then expedition.eventRevision or 0 else 0
            local eventSecond = if expedition.active
                    and expedition.event ~= nil
                    and expedition.event.status == "active"
                then expedition.event.timeRemaining or 0
                else -1
            if
                self._expeditionModuleIndex[player] ~= moduleIndex
                or self._expeditionEventRevision[player] ~= eventRevision
                or self._expeditionEventSecond[player] ~= eventSecond
            then
                self._expeditionModuleIndex[player] = moduleIndex
                self._expeditionEventRevision[player] = eventRevision
                self._expeditionEventSecond[player] = eventSecond
                self:_publish(player)
            end
        end
    end)

    self._networkService:setWorldReady(true)
end

function TutorialService._profileLoaded(self: TutorialService, player: Player, profile: any)
    if self._sessions[player] ~= nil then
        return
    end

    --[[
        Every session starts a fresh run.

        The tutorial stage is still written to the profile, and the flag below
        can restore it, but with tutorial_persistence off a player who leaves
        and comes back begins at the lodge again rather than resuming mid-way
        through a run they have already left. Rejoining to find yourself
        halfway through the first night, holding an axe you do not remember
        picking, reads as the game having lost track rather than as progress.
    ]]
    local stage = if self._featureFlags:isEnabled("tutorial_persistence")
        then profile.tutorial.stage
        else self._tutorialFlow.firstStage()
    player:SetAttribute("LastLightTutorialSurvivalReady", isCombatEligibleStage(stage))
    local session: Session = {
        stage = stage,
        resources = if stage == "gather"
            then 0
            elseif stage == "choose_tool" or stage == "build" then 3
            else 0,
        selectedTool = profile.tutorial.selectedTool,
        compactHud = false,
        toast = if not self._profileService:isWritable(player)
            then "PROFILE OFFLINE — PROGRESS WILL NOT SAVE"
            elseif stage == "complete" then "WELCOME BACK TO EMBERHOLLOW"
            else "FOLLOW THE LANTERN TRAIL",
        toastRevision = 1,
    }
    self:_applyToolAttributes(player, session.selectedTool)
    -- A guest is told they are one, at the door. The permission model has
    -- always protected the host's town; the visit only becomes deliberate
    -- when the visitor knows whose lanterns they are standing under.
    local hostInfo = self._townNightService:hostInfo(player.UserId)
    if hostInfo ~= nil and hostInfo.role == "visitor" then
        local hostPlayer = Players:GetPlayerByUserId(hostInfo.hostUserId)
        local hostName = if hostPlayer ~= nil then hostPlayer.DisplayName else "A FOUNDER"
        session.toast = string.format(
            "YOU ARE A GUEST IN %s'S EMBERHOLLOW — HELP IT GROW",
            string.upper(hostName)
        )
        session.toastRevision += 1
    end
    self._sessions[player] = session
    self._worldService:setTownConsequence(self._profileService:townConsequence(player))
    -- Seeds the server's live construction accumulator from this player's
    -- own profile the same moment their tier ceiling is seeded. Without
    -- this, a fresh server session starts every building back at the
    -- accumulator's empty default until someone happens to fund a stage,
    -- which is exactly the "town collapses back to construction sites"
    -- regression this whole feature exists to avoid on the buildings a
    -- returning player already paid for (or was grandfathered into).
    self._worldService:setTownConstruction(self._profileService:townConstructionState(player))
    self._worldService:setTownDecorations(self._profileService:decorationsSnapshot(player))

    if stage == "prepare" or stage == "survive" or stage == "reveal" or stage == "complete" then
        self._worldService:buildBarricade(false)
    end
    if stage == "survive" then
        if self._phaseService:hasCompletedFirstNight() then
            self:_advanceSurvivorToReveal(player, session)
        else
            self._phaseService:ensureFirstNight()
        end
    elseif stage == "reveal" or stage == "complete" then
        self._worldService:setBeaconVisible(true)
        self._townNightService:ensureStarted(
            profile.town.nightNumber,
            self._profileService:townCondition(player),
            player.UserId
        )
    end

    local currentStage = session.stage
    local definition = self._tutorialFlow.definition(currentStage)
    self._analyticsService:stage(player, definition.index, currentStage)
    self:_publish(player)
end

local function gearShortName(itemId: string): string
    return string.upper((string.gsub((string.gsub(itemId, "^gear_", "")), "_", " ")))
end

--[[
    What a player should see an item called. Equipment and the crafting
    catalog both carry display names; the id is the last resort, and it
    should never actually be reached for real gear.

    Two toasts were reading the raw id out loud -- "EQUIPPED
    GEAR_AMBER_EDGE", which is how the underscore in a database row ends
    up in a player's face. Seen while equipping a freshly crafted edge in
    Studio.
]]
local function gearDisplayName(equipmentCatalog: any, itemId: string): string
    local definition = if equipmentCatalog ~= nil then equipmentCatalog.get(itemId) else nil
    if type(definition) == "table" and type(definition.displayName) == "string" then
        return string.upper(definition.displayName)
    end
    return gearShortName(itemId)
end

--[[
    What the Field Book says about each owned piece of gear: its rolled
    trait and its wear condition, plus which single item most deserves the
    whetstone. Composed server-side so the client stays a renderer -- it
    never learns the wear thresholds, only the words.
]]
function TutorialService._gearCare(self: TutorialService, player: Player): (any, any)
    local wear = self._profileService:gearWearOf(player)
    local care: { [string]: any } = {}
    local seen: { [string]: boolean } = {}
    local worstId: string? = nil
    local worstPoints = -1
    local function consider(itemId: any)
        if type(itemId) ~= "string" or seen[itemId] then
            return
        end
        seen[itemId] = true
        local traitDefinition =
            self._gearTraits.get(self._profileService:gearTraitOf(player, itemId))
        local condition = self._gearWear.condition(wear, itemId)
        if traitDefinition ~= nil or condition ~= "sound" then
            care[itemId] = {
                condition = condition,
                trait = if traitDefinition ~= nil then traitDefinition.displayName else nil,
            }
        end
        if condition ~= "sound" then
            local points = tonumber(wear[itemId]) or 0
            if points > worstPoints then
                worstPoints = points
                worstId = itemId
            end
        end
    end
    for itemId in self._profileService:gearSnapshot(player) do
        consider(itemId)
    end
    for _, itemId in self._profileService:equippedSnapshot(player) do
        consider(itemId)
    end
    local whetTarget = if worstId ~= nil
        then { itemId = worstId, label = "WHET " .. gearShortName(worstId) }
        else nil
    return care, whetTarget
end

-- Public toast entry points for services that live outside the session
-- pipeline (the defense plots' arming and bite feedback arrives here).
function TutorialService.toastEveryone(self: TutorialService, message: string)
    self:_toastAll(message)
end

function TutorialService.toastPlayer(self: TutorialService, player: Player, message: string)
    self:_setToast(player, message)
end

function TutorialService._toastAll(self: TutorialService, message: string)
    for _, session in self._sessions do
        session.toast = message
        session.toastRevision += 1
    end
end

function TutorialService._setToast(self: TutorialService, player: Player, message: string)
    local session = self._sessions[player]
    if session == nil then
        return
    end
    session.toast = message
    session.toastRevision += 1
end

-- Quests have no quest board or accept step: this opportunistically claims
-- anything newly satisfiable and returns a toast fragment to fold into
-- whatever toast the caller was already about to show (a single session
-- only ever carries one pending toast, so the caller must combine rather
-- than set two in a row and lose the first).
function TutorialService._questToastSuffix(self: TutorialService, player: Player): string?
    local claimed = self._profileService:checkQuests(player)
    if #claimed == 0 then
        return nil
    end
    local parts = {}
    for _, quest in claimed do
        self._analyticsService:questClaimed(player, quest.questId)
        table.insert(parts, string.format("QUEST COMPLETE: %s", quest.displayName))
    end
    return table.concat(parts, " · ")
end

function TutorialService._advance(
    self: TutorialService,
    player: Player,
    actionId: string
): (boolean, string?)
    local session = self._sessions[player]
    if session == nil then
        return false, "Your profile is still loading."
    end

    local nextStage, reason = self._tutorialFlow.advance(session.stage, actionId)
    if nextStage == nil then
        return false, reason
    end

    session.stage = nextStage
    player:SetAttribute("LastLightTutorialSurvivalReady", isCombatEligibleStage(nextStage))
    self._profileService:setTutorial(player, nextStage, session.selectedTool)
    local definition = self._tutorialFlow.definition(nextStage)
    self._analyticsService:stage(player, definition.index, nextStage)

    return true, nil
end

--[[
    Timed actions.

    Gathering and building used to resolve the instant the button was pressed,
    which gave the player no sense of having done anything. They now start a
    short server-owned action: the character swings its tool, a progress bar
    runs, and the reward lands only when ActionProgress says the clock is up.
    A client cannot shorten it -- it only ever asks to start one.
]]
function TutorialService._beginTimedAction(
    self: TutorialService,
    player: Player,
    actionId: string,
    interactionId: string
): boolean
    if self._actionProgress.durationFor(actionId) == nil then
        return false
    end
    local now = workspace:GetServerTimeNow()
    local session = self._sessions[player]
    --[[
        Work identity: the hammer hurries every timed action, while the
        pick and sickle hurry only harvests of their own materials -- the
        node's reward decides, so a pick at a brightcap is just a pick.
        Combat identity lives in _strikeContext; this is the other half of
        "the tools actually differ".
    ]]
    local tool = self._toolCatalog.get(if session ~= nil then session.selectedTool else nil)
    local durationMultiplier = 1
    if tool ~= nil then
        if tool.actionDurationMultiplier ~= nil then
            durationMultiplier = tool.actionDurationMultiplier
        elseif
            tool.gatherDurationMultiplier ~= nil
            and actionId == self._runtimeIds.Actions.Gather
            and tool.gatherMaterials ~= nil
        then
            local node = self._worldService:resourceNode(interactionId)
            -- The node record carries materialId directly -- the same shape
            -- the grant site reads -- not nested under a reward table.
            local materialId = if node ~= nil then node.materialId else nil
            if materialId ~= nil and tool.gatherMaterials[materialId] == true then
                durationMultiplier = tool.gatherDurationMultiplier
            end
        end
    end
    local nextState, result = self._actionProgress.begin(
        self._actions[player],
        actionId,
        interactionId,
        now,
        durationMultiplier
    )
    self._actions[player] = nextState
    if not result.accepted then
        if result.reason == "already_working" then
            self:_setToast(player, "ALREADY WORKING")
            self:_publish(player)
        end
        return true
    end
    self._worldService:playToolAction(player, actionId, result.duration, result.swings)
    self:_setToast(player, result.label .. "...")
    self:_publish(player)
    return true
end

-- Cancel a player's action when they can no longer be doing it.
function TutorialService.cancelAction(self: TutorialService, player: Player)
    if self._actions[player] ~= nil then
        self._actions[player] = self._actionProgress.cancel(self._actions[player])
        self:_publish(player)
    end
end

function TutorialService._stepActions(self: TutorialService)
    local now = workspace:GetServerTimeNow()
    for player, state in self._actions do
        local nextState, result = self._actionProgress.tick(state, now)
        self._actions[player] = nextState
        if result.complete then
            self:_interact(player, result.interactionId, true)
        end
    end
end

function TutorialService.actionSnapshot(self: TutorialService, player: Player): any
    return self._actionProgress.snapshot(self._actions[player], workspace:GetServerTimeNow())
end

-- Entry point for tapping a world object. Goes through the same rate limiter
-- and the same validated interaction path as the HUD button, so clicking is
-- another way to ask, not a way around any check.
-- Shared by the tool action and by tapping a creature. Every guard stays on
-- the server: a click only says which enemy the player meant.
-- Admin surface. Kept here because the toast and the session belong to this
-- service; AdminService decides nothing on its own.
function TutorialService.adminToast(self: TutorialService, player: Player, message: string)
    self:_setToast(player, message)
    self:_publish(player)
end

function TutorialService.adminGrantResources(self: TutorialService, player: Player, amount: number)
    local session = self._sessions[player]
    if session == nil then
        return
    end
    session.resources = amount
    self:_publish(player)
end

--[[
    What the striker is holding, resolved server-side.

    The three starter tools finally mean something: the axe hits a quarter
    harder, the torch's swung fire reaches four studs further at a small cost,
    and the hammer keeps its identity at the workbench rather than in combat
    (it swings build and repair work faster). A ranged weapon in the equipment
    slot extends reach to its own range and marks the strike as a shot, which
    is what the client's arrow visual keys off. All numbers live here and in
    Equipment; a client never submits any of them.
]]
--[[
    The endurance families work through per-player attributes, the same
    channel survival already syncs health through: the combat service reads
    them without a service edge existing in either direction, and they
    follow the tool wherever it is set -- selection at the yard, or a
    profile load restoring last session's choice.
]]
--[[
    The survey glass's exploration identity: while it is the held tool and
    the player walks Bramblewake, the objective markers include the nearest
    unharvested resource node, labeled with what it pays. One marker, the
    nearest only -- a surveyor's bearing, not a maphack.
]]
function TutorialService._addSurveyTarget(
    self: TutorialService,
    player: Player,
    add: (BasePart?, string) -> ()
)
    local session = self._sessions[player]
    local tool = self._toolCatalog.get(if session ~= nil then session.selectedTool else nil)
    if tool == nil or tool.surveyRevealsNodes ~= true then
        return
    end
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    if root == nil or not root:IsA("BasePart") then
        return
    end
    local node = self._worldService:nearestResourceNode(root.Position)
    if node ~= nil and node.target ~= nil then
        add(node.target, "SURVEY · " .. string.upper(tostring(node.objectText)))
    end
end

function TutorialService._applyToolAttributes(self: TutorialService, player: Player, toolId: any)
    local definition = self._toolCatalog.get(toolId)
    player:SetAttribute(
        "LastLightToolStaminaRegen",
        if definition ~= nil then definition.staminaRegenMultiplier else nil
    )
    player:SetAttribute(
        "LastLightToolSprintSpeed",
        if definition ~= nil then definition.sprintSpeedMultiplier else nil
    )
end

function TutorialService._strikeContext(self: TutorialService, player: Player): any
    local session = self._sessions[player]
    local context = { rangeBonus = 0, damageMultiplier = 1 }
    -- Tool identity comes from the catalog now that there are eight
    -- families, not a literal per starter tool.
    local tool = self._toolCatalog.get(if session ~= nil then session.selectedTool else nil)
    if tool ~= nil then
        context.rangeBonus = tool.strikeRangeBonus or 0
        context.damageMultiplier = tool.strikeDamageMultiplier or 1
    end
    local weapon = self._profileService:weaponStrikeProfile(player)
    --[[
        Wear gates the weapon, never the hand: a worn blade works at half
        its multiplier bonus and loses its riders, and a failing one is no
        weapon at all -- the strike falls back to bare hands (and the
        starter tool's own identity) until the bench sees it. GearWear owns
        the thresholds; this only multiplies.
    ]]
    local wearEffectiveness = 1
    if weapon ~= nil then
        wearEffectiveness =
            self._gearWear.effectiveness(self._profileService:gearWearOf(player), weapon.itemId)
    end
    if weapon ~= nil and wearEffectiveness <= 0 then
        weapon = nil
    end
    if weapon ~= nil then
        -- The family decides the moveset: ranged families carry strikeRange
        -- and a projectile visual, the lance carries reach without one, and
        -- the rider fields pass through untouched for the strike to apply.
        -- The item's rolled trait shades it: KEEN adds to the damage bonus,
        -- BALANCED to the reach, both before the wear scaling.
        local trait = self._gearTraits.get(self._profileService:gearTraitOf(player, weapon.itemId))
        if trait ~= nil then
            if trait.strikeDamageBonus ~= nil then
                weapon = table.clone(weapon)
                weapon.strikeDamageMultiplier = (weapon.strikeDamageMultiplier or 1)
                    + trait.strikeDamageBonus
            end
            if trait.reachBonus ~= nil then
                weapon = table.clone(weapon)
                if weapon.strikeRange ~= nil then
                    weapon.strikeRange += trait.reachBonus
                else
                    weapon.meleeReach = (weapon.meleeReach or 0) + trait.reachBonus
                end
            end
        end
        context.weaponRange = weapon.strikeRange or weapon.meleeReach
        -- 1 + (bonus * effectiveness): a worn 1.45x maul swings at 1.225x.
        context.damageMultiplier = 1
            + ((weapon.strikeDamageMultiplier or 1) - 1) * wearEffectiveness
        context.ranged = weapon.ranged == true
        context.weaponId = weapon.itemId
        context.weaponKind = weapon.kind
        if wearEffectiveness >= 1 then
            context.onHitStaminaRefund = weapon.onHitStaminaRefund
            context.onHitSnareSeconds = weapon.onHitSnareSeconds
        end
    end
    return context
end

function TutorialService.setCompanionService(self: TutorialService, companionService: any)
    self._companionService = companionService
end

function TutorialService.strike(self: TutorialService, player: Player)
    local session = self._sessions[player]
    --[[
        isCombatEligibleStage, not stage == "survive": the literal meant a
        player who finished the tutorial could never strike a town-night
        enemy again -- swings and taps silently did nothing from the
        "complete" stage onward, in the very nights the repeating cycle
        keeps sending creatures at the lantern. The helper at the top of
        this file has always named the right set; the gate just did not
        use it. Found live: a crafted Amber Edge, a Night 1 Rootling, and
        a strike that refused to land.
    ]]
    if
        session ~= nil
        and self._survivalService:canAct(player)
        and (
            isCombatEligibleStage(session.stage)
            or player:GetAttribute("LastLightInExpedition") == true
        )
    then
        local context = self:_strikeContext(player)
        local landed, message = self._enemyService:damageNearest(player, context)
        if landed and context.weaponId ~= nil then
            local wearTrait =
                self._gearTraits.get(self._profileService:gearTraitOf(player, context.weaponId))
            local wearResult = self._profileService:accrueGearWear(
                player,
                context.weaponId,
                if wearTrait ~= nil then wearTrait.wearPointsOverride else nil
            )
            if
                wearResult.applied
                and wearResult.conditionAfter ~= wearResult.conditionBefore
                and wearResult.conditionAfter ~= "sound"
            then
                message = if wearResult.conditionAfter == "failing"
                    then "YOUR WEAPON FAILS — WHET IT AT ITS BENCH"
                    else "YOUR WEAPON DULLS — HALF STRENGTH UNTIL WHETTED"
            end
        end
        self:_setToast(player, message)
        self:_publishAll()
    end
end

function TutorialService.strikeFromClick(self: TutorialService, player: Player)
    if not self._limiter:allow(tostring(player.UserId), os.clock(), 2) then
        return
    end
    self:strike(player)
end

function TutorialService.interactFromClick(
    self: TutorialService,
    player: Player,
    interactionId: string
)
    if type(interactionId) ~= "string" or #interactionId > 64 then
        return
    end
    if not self._limiter:allow(tostring(player.UserId), os.clock(), 1) then
        return
    end
    self:_interact(player, interactionId)
end

function TutorialService._interact(
    self: TutorialService,
    player: Player,
    interactionId: string,
    skipTimer: boolean?
)
    local revivePrompt = self._survivalService:interaction(interactionId)
    if revivePrompt ~= nil then
        local result = self._survivalService:beginRevive(player, interactionId)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if not self._survivalService:canAct(player) then
        self:_setToast(player, "YOU CANNOT INTERACT WHILE DOWNED")
        self:_publishAll()
        return
    end

    local prompt = self._worldService:interaction(interactionId)
    if prompt == nil or not prompt.Enabled or not self._worldService:isInRange(player, prompt) then
        self:_setToast(player, "MOVE CLOSER TO THE MARKED OBJECT")
        self:_publish(player)
        return
    end

    local actionId = prompt:GetAttribute("ActionId")
    if type(actionId) ~= "string" then
        return
    end

    if actionId == self._runtimeIds.Actions.RecoverMemoryFragment then
        --[[
            Recovering a memory fragment.

            Handled before the tutorial-stage machinery for the same reason
            harvest nodes are: fragments belong to the expedition, not to the
            First Light sequence, and must neither advance it nor be gated by
            it. The client sends only the interaction ID; the server resolves
            which fragment that prompt carries, and the profile transaction is
            idempotent, so a duplicated tap re-reads rather than re-collecting.
        ]]
        local descriptor = self._worldService:memoryFragmentTarget(interactionId)
        if descriptor == nil then
            return
        end
        local result = self._profileService:collectMemoryFragment(player, descriptor.fragmentId)
        if result.accepted and result.fragment ~= nil then
            self:_setToast(
                player,
                string.format("%s — %s", result.fragment.title, result.fragment.body)
            )
            self._analyticsService:memoryFragmentRecovered(player, descriptor.fragmentId)
        elseif result.reason == "already_recovered" and result.fragment ~= nil then
            self:_setToast(
                player,
                string.format("%s — %s", result.fragment.title, result.fragment.body)
            )
        elseif result.reason == "chapter_unresolved" then
            self:_setToast(player, "THIS MEMORY IS NOT YET YOURS TO READ")
        else
            self:_setToast(player, "THE MEMORY SLIPS AWAY — TRY AGAIN")
        end
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.GatherResource then
        --[[
            Harvesting a Bramblewake node.

            Handled before the tutorial-stage machinery below, because these
            nodes belong to the expedition rather than to the First Light
            sequence and must not advance or be gated by it. Uses the same
            timed gather as the town stump -- swing, bar, then the grant --
            and the same idempotent expedition grant path as events and
            encounters, keyed on the node's own ID, so a node pays out exactly
            once per run however many times it is clicked.
        ]]
        local node = self._worldService:resourceNode(interactionId)
        if node == nil then
            self:_setToast(player, "ALREADY HARVESTED")
            self:_publish(player)
            return
        end
        if player:GetAttribute("LastLightInExpedition") ~= true then
            self:_setToast(player, "ONLY OUT IN BRAMBLEWAKE")
            self:_publish(player)
            return
        end
        if
            not skipTimer
            and self:_beginTimedAction(player, self._runtimeIds.Actions.Gather, interactionId)
        then
            return
        end
        -- { materialId = ..., amount = ... }, the ledger's contract -- not a
        -- materials map. The map shape threw "reward contract is invalid" on
        -- every single node harvest, which means no node on any route has
        -- ever actually paid out: the timer ran, the assert fired, the node
        -- survived to be clicked again. Found the first time the full
        -- harvest -> bank -> craft loop was driven end to end.
        local granted = self._expeditionService:grantNodeReward(
            player.UserId,
            interactionId,
            { materialId = node.materialId, amount = 1 }
        )
        if granted then
            self._worldService:markResourceNodeHarvested(interactionId)
            self:_setToast(player, "+1 " .. string.upper(node.objectText))
        end
        self:_publish(player)
        return
    end

    local session = self._sessions[player]
    if session == nil then
        return
    end

    if actionId == self._runtimeIds.Actions.ExpeditionEvent then
        local result = self._expeditionService:interact(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.OldGrowthFire then
        local result = self._oldGrowthService:interact(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.WardenStagChoice then
        local result = self._wardenStagService:interact(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.BramblewakeBlackout then
        local result = self._blackoutService:interact(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.Extract then
        local result = self._expeditionService:extract(player)
        local toast = result.message
        if result.accepted then
            local questSuffix = self:_questToastSuffix(player)
            if questSuffix ~= nil then
                toast = toast .. " · " .. questSuffix
            end
        end
        self:_setToast(player, toast)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.CraftItem then
        if session.stage ~= "complete" then
            self:_setToast(player, "FINISH FIRST LIGHT TO CRAFT")
            self:_publish(player)
            return
        end
        local recipeId = prompt:GetAttribute("Payload")
        if type(recipeId) ~= "string" then
            return
        end
        local result = self._profileService:craftItem(player, recipeId)
        self._analyticsService:crafted(player, recipeId, result.accepted, result.reason)
        local toast: string
        if result.accepted then
            toast = string.format("CRAFTED %s", prompt.ObjectText)
            local questSuffix = self:_questToastSuffix(player)
            if questSuffix ~= nil then
                toast = toast .. " · " .. questSuffix
            end
        elseif result.reason == "insufficient_materials" then
            toast = "NOT ENOUGH MATERIALS"
        else
            toast = "CRAFTING UNAVAILABLE"
        end
        self:_setToast(player, toast)
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.ContributeConstruction then
        local buildingId = prompt:GetAttribute("Payload")
        if type(buildingId) ~= "string" then
            return
        end
        local result = self._profileService:contributeToConstruction(player, buildingId)
        if result.accepted then
            self:_setToast(
                player,
                string.format("%s BUILT TO STAGE %d", prompt.ObjectText, result.stage)
            )
            -- Construction is shared town state, the same reasoning
            -- RepairTown's own _publishAll() call already uses: the stage a
            -- player just funded is visible to everyone in the world, not
            -- only to the player who paid for it.
            self._worldService:setTownConstruction(
                self._profileService:townConstructionState(player)
            )
            self:_publishAll()
            return
        end
        local toast: string
        if result.reason == "tier_not_ready" then
            toast = "SURVIVE MORE NIGHTS BEFORE BUILDING FURTHER"
        elseif result.reason == "already_maxed" then
            toast = "ALREADY FULLY BUILT"
        elseif result.reason == "insufficient_materials" then
            toast = "NOT ENOUGH MATERIALS TO BUILD"
        elseif result.reason == "unknown_building" then
            toast = "THAT BUILDING DOES NOT EXIST"
        else
            toast = "CONSTRUCTION UNAVAILABLE"
        end
        self:_setToast(player, toast)
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.OpenFieldBook then
        self:_setToast(player, "FIELD BOOK UPDATED — CHECK RECIPES, QUESTS, AND MASTERY")
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.SelectProfessionSpecialization then
        local specializationId = prompt:GetAttribute("Payload")
        if type(specializationId) ~= "string" then
            return
        end
        local result = self._professionService:selectSpecialization(player, specializationId)
        self:_setToast(player, result.message)
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.PlaceDecoration then
        local decorationId = prompt:GetAttribute("Payload")
        local result = self._profileService:placeDecoration(player, tostring(decorationId))
        if result.applied then
            self._worldService:setTownDecorations(self._profileService:decorationsSnapshot(player))
            self:_setToast(player, "DECORATION PLACED — THE TOWN WEARS YOUR WORK")
        else
            local message = if result.reason == "decoration_cap"
                then "DECORATION LIMIT REACHED — GROW THE TOWN FOR MORE ROOM"
                elseif result.reason == "insufficient_materials" then "NOT ENOUGH MATERIALS"
                elseif result.reason == "already_placed" then "ALREADY DECORATED"
                else "THAT SPOT CANNOT BE DECORATED"
            self:_setToast(player, message)
        end
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.TalkResident then
        local residentId = prompt:GetAttribute("Payload")
        -- Talking IS checking on someone. Care shortens an injury and builds
        -- the bond; a healthy visit bonds once per night. The dialogue line
        -- still plays underneath, so the moment stays a conversation.
        local care = self._profileService:checkOnResident(player, tostring(residentId))
        if care.accepted and care.healed then
            self:_setToast(
                player,
                string.format(
                    "%s IS BACK ON THEIR FEET — BOND · %d",
                    string.upper(
                        string.gsub(string.gsub(tostring(residentId), "npc_", ""), "_", " ")
                    ),
                    care.bond
                )
            )
            self._worldService:setResidentInjured(tostring(residentId), false)
            self:_publish(player)
            return
        end
        local response = self._residentDialogue.respond(
            residentId,
            self._profileService:questSnapshot(player),
            self._profileService:townConsequence(player)
        )
        if response == nil then
            self:_setToast(player, "THE RESIDENT IS BUSY WITH THE NIGHT WATCH")
        else
            self:_setToast(player, response.message)
            self._analyticsService:residentTalked(
                player,
                tostring(residentId),
                response.questId,
                response.state
            )
        end
        self:_publish(player)
        return
    end
    if actionId == self._runtimeIds.Actions.RepairTown then
        if player:GetAttribute("LastLightInExpedition") == true then
            self:_setToast(player, "RETURN THROUGH WAYHOME BEFORE REPAIRING TOWN")
            self:_publish(player)
            return
        end
        -- Read off the prompt, never off client input: the repair prompt beside
        -- each damaged building carries that building's ID as its baked
        -- Payload, the same route a crafting bench uses for its recipe.
        local buildingId = prompt:GetAttribute("Payload")
        local result = self._townNightService:repairTown(buildingId)
        if result.accepted then
            for sessionPlayer in self._sessions do
                self._profileService:setTownCondition(sessionPlayer, result.condition)
            end
            self._analyticsService:townRepaired(
                player,
                result.condition.integrity,
                result.condition.repairsRemaining
            )
        end
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.ResolveTownIncident then
        local result = self._townNightService:resolveIncident(player, prompt)
        self:_setToast(player, result.message)
        self:_publishAll()
        return
    end
    if actionId == self._runtimeIds.Actions.RecoverExpeditionCache then
        local result = self._expeditionService:recoverCache(player, prompt)
        self:_setToast(player, result.message)
        self:_publish(player)
        return
    end

    if actionId == self._runtimeIds.Actions.Build and session.resources < 3 then
        self:_setToast(player, "YOU NEED 3 HEARTWOOD")
        self:_publish(player)
        return
    end

    if actionId == self._runtimeIds.Actions.Reveal and session.stage == "complete" then
        if self._expeditionService:enter(player) then
            local blackoutResult = self._blackoutService:participantEntered(player)
            self:_setToast(player, blackoutResult.message or "ENTERING BRAMBLEWAKE")
            self._analyticsService:expeditionStarted(
                player,
                self._expeditionService:snapshot(player)
            )
        else
            self:_setToast(player, "BRAMBLEWAKE IS STILL FORMING")
        end
        self:_publish(player)
        return
    end

    --[[
        Gate timed actions here, after the resource and stage guards above but
        before _advance, which mutates. tutorialFlow.advance is pure, so the
        action can be checked for validity without committing to it: an
        invalid interaction still refuses immediately instead of making the
        player swing an axe and only then be told it was the wrong objective.
    ]]
    if not skipTimer and self._actionProgress.durationFor(actionId) ~= nil then
        local timedSession = self._sessions[player]
        local wouldAdvance = if timedSession == nil
            then nil
            else self._tutorialFlow.advance(timedSession.stage, actionId)
        if wouldAdvance ~= nil and self:_beginTimedAction(player, actionId, interactionId) then
            return
        end
    end

    --[[
        Tools stay swappable after First Light, the same freedom professions
        have: eight families are situational -- a pick for a sap run, the
        survey glass for an unfamiliar trail -- and locking the tutorial's
        one-shot choice forever would make seven of them dead content. The
        swap is town-only: not while downed, and not out in Bramblewake
        where the supply crates are a lodge away.
    ]]
    if
        actionId == self._runtimeIds.Actions.ChooseTool
        and session.stage == "complete"
        and self._survivalService:canAct(player)
        and player:GetAttribute("LastLightInExpedition") ~= true
    then
        local selectedTool = prompt:GetAttribute("Payload")
        if self._toolCatalog.isValid(selectedTool) then
            session.selectedTool = selectedTool
            self:_applyToolAttributes(player, selectedTool)
            self._profileService:setTutorial(player, session.stage, selectedTool)
            self:_setToast(player, self._toolCatalog.get(selectedTool).displayName .. " SELECTED")
            self:_publish(player)
            return
        end
    end

    local ok, reason = self:_advance(player, actionId)
    if not ok then
        local expected = self._tutorialFlow.definition(session.stage).objective
        self:_setToast(player, "CURRENT OBJECTIVE: " .. expected)
        self._logger:warn("tutorial_action_rejected", {
            action = actionId,
            player = player.UserId,
            reason = reason,
            stage = session.stage,
        })
        self:_publish(player)
        return
    end

    if actionId == self._runtimeIds.Actions.Rescue then
        self._worldService:freeMara()
        self._worldService:moveMara(Vector3.new(2, 1.1, -38))
        self:_setToast(player, "MARA IS SAFE")
    elseif actionId == self._runtimeIds.Actions.Gather then
        -- Handled by the timed-action path below, which swings the tool and
        -- runs the progress bar before granting anything.
        session.resources = 3
        self:_setToast(player, "+3 HEARTWOOD")
    elseif actionId == self._runtimeIds.Actions.ChooseTool then
        local selectedTool = prompt:GetAttribute("Payload")
        if self._toolCatalog.isValid(selectedTool) then
            session.selectedTool = selectedTool
            self:_applyToolAttributes(player, selectedTool)
            self._profileService:setTutorial(player, session.stage, selectedTool)
            local definition = self._toolCatalog.get(selectedTool)
            self:_setToast(player, definition.displayName .. " SELECTED")
        end
    elseif actionId == self._runtimeIds.Actions.Build then
        session.resources -= 3
        self._worldService:buildBarricade(true)
        self:_setToast(player, "BARRICADE COMPLETE")
    elseif actionId == self._runtimeIds.Actions.Prepare then
        self:_setToast(player, "THE FIRST LANTERN BURNS")
        self._phaseService:startFirstNight()
    elseif actionId == self._runtimeIds.Actions.Reveal then
        if self._expeditionService:enter(player) then
            local blackoutResult = self._blackoutService:participantEntered(player)
            self:_setToast(player, blackoutResult.message or "BRAMBLEWAKE REMEMBERS YOU")
            self._analyticsService:expeditionStarted(
                player,
                self._expeditionService:snapshot(player)
            )
        else
            self:_setToast(player, "FIRST LIGHT COMPLETE")
        end
        self._analyticsService:complete(player)
    end

    self:_publishAll()
end

function TutorialService._advanceSurvivorToReveal(
    self: TutorialService,
    player: Player,
    session: Session
): boolean
    if session.stage ~= "survive" then
        return false
    end

    local nextStage = self._tutorialFlow.advanceSystem(session.stage)
    if nextStage == nil then
        return false
    end

    session.stage = nextStage
    session.toast = "DAWN BREAKS — FOLLOW THE BEACON"
    session.toastRevision += 1
    self._profileService:setTutorial(player, nextStage, session.selectedTool)
    local definition = self._tutorialFlow.definition(nextStage)
    self._analyticsService:stage(player, definition.index, nextStage)
    return true
end

function TutorialService._nightComplete(self: TutorialService)
    for player, session in self._sessions do
        self:_advanceSurvivorToReveal(player, session)
        self._townNightService:ensureStarted(
            self._profileService:nightNumber(player),
            self._profileService:townCondition(player),
            player.UserId
        )
    end
    self:_publishAll()
end

-- Consumable one-time buffs, not equipment: each craftable item is checked
-- for its own effect's preconditions before the item is spent, so a player
-- never loses one to a no-op (already full stamina, or unable to act).
function TutorialService._useGear(self: TutorialService, player: Player, itemId: string)
    local session = self._sessions[player]
    if session == nil or session.stage ~= "complete" then
        self._analyticsService:usedGear(player, itemId, false, "tutorial_incomplete")
        self:_setToast(player, "FINISH FIRST LIGHT TO USE GEAR")
        self:_publish(player)
        return
    end
    if not self._survivalService:canAct(player) then
        self._analyticsService:usedGear(player, itemId, false, "player_downed")
        self:_setToast(player, "YOU CANNOT USE GEAR WHILE DOWNED")
        self:_publish(player)
        return
    end
    if itemId == "gear_meadow_satchel" then
        -- Uses the same freshly-advanced stamina restoreStamina itself
        -- computes below, not the possibly-stale snapshot() value, so this
        -- check can't pass on stale data only for the real restore to find
        -- stamina already full after the item has been consumed.
        local staminaNow = self._combatService:peekStamina(player)
        if staminaNow == nil or staminaNow >= self._config.MaxStamina then
            self._analyticsService:usedGear(player, itemId, false, "stamina_full")
            self:_setToast(player, "STAMINA ALREADY FULL")
            self:_publish(player)
            return
        end
    elseif itemId ~= "gear_amber_charm" then
        self._analyticsService:usedGear(player, itemId, false, "unknown_item")
        return
    end

    local result = self._profileService:useGearItem(player, itemId)
    self._analyticsService:usedGear(player, itemId, result.accepted, result.reason)
    if not result.accepted then
        self:_setToast(player, "YOU DON'T HAVE THAT ITEM")
        self:_publish(player)
        return
    end

    if itemId == "gear_amber_charm" then
        self._combatService:applyShield(player, 5, 0.6)
        self:_setToast(player, "AMBER CHARM — SHIELDED")
    else
        local staminaResult = self._combatService:restoreStamina(player, 50)
        self:_setToast(
            player,
            if staminaResult.applied
                then "MEADOW SATCHEL — STAMINA RESTORED"
                else "MEADOW SATCHEL USED"
        )
    end
    self:_publish(player)
end

function TutorialService._handleAction(self: TutorialService, player: Player, payload: any)
    local contract = self._actionPayloadContract
    if not contract.isValidForKind(self._runtimeIds, payload) then
        return
    end
    local kind = payload.kind
    if
        not self._limiter:allow(
            tostring(player.UserId),
            os.clock(),
            contract.cost(self._runtimeIds, kind)
        )
    then
        return
    end

    if kind == self._runtimeIds.Actions.LobbyDepart then
        -- The client only ever asks. LobbyDeparture re-checks the size, the
        -- server's own ready count, and the capacity before anything starts.
        -- The departing party names its contract before the platform fires.
        -- Resolution is server-side and forgiving: junk becomes the standard
        -- sweep, never extra risk or reward.
        if payload.contractId ~= nil then
            local contractId = payload.contractId
            if type(contractId) == "string" and #contractId <= 40 then
                self._expeditionService:setContract(contractId)
            end
        end
        local result = self._lobbyService:requestDeparture(player, payload.partySize)
        if not result.accepted and result.reason == "invalid_party_size" then
            self:_setToast(player, "CHOOSE A PARTY SIZE FIRST")
        end
        self:_publishAll()
    elseif kind == self._runtimeIds.Actions.Interact then
        local interactionId = payload.interactionId
        if type(interactionId) == "string" and #interactionId <= 64 then
            self:_interact(player, interactionId)
        end
    elseif kind == self._runtimeIds.Actions.UseTool then
        self:strike(player)
    elseif kind == self._runtimeIds.Actions.Sprint and type(payload.enabled) == "boolean" then
        self._combatService:setSprint(player, payload.enabled)
    elseif kind == self._runtimeIds.Actions.Dodge then
        self._combatService:dodge(player)
    elseif kind == self._runtimeIds.Actions.ProfessionAbility then
        local result = self._professionService:useAbility(player)
        if not result.accepted then
            self:_setToast(player, result.message)
            self:_publish(player)
        end
    elseif kind == self._runtimeIds.Actions.SelectProfession then
        local professionId = payload.professionId
        if type(professionId) == "string" and #professionId <= 32 then
            local result = self._professionService:select(player, professionId)
            if not result.accepted then
                self:_setToast(player, result.message)
                self:_publish(player)
            end
        end
    elseif kind == self._runtimeIds.Actions.UseGear then
        local itemId = payload.itemId
        if type(itemId) == "string" and #itemId <= 32 then
            self:_useGear(player, itemId)
        end
    elseif kind == self._runtimeIds.Actions.SaveLoadout then
        local slot = payload.slot
        if type(slot) == "number" then
            local result = self._profileService:saveLoadout(player, slot)
            self:_setToast(
                player,
                if result.applied
                    then string.format("KIT %d SAVED", slot)
                    else "KIT COULD NOT BE SAVED"
            )
            self:_publish(player)
        end
    elseif kind == self._runtimeIds.Actions.ApplyLoadout then
        --[[
            Applying a kit walks the same validated paths its pieces use one
            at a time -- profession selection keeps its own daylight/town
            gates, equipping checks ownership, and the tool swap keeps the
            after-First-Light rule -- so a loadout can never smuggle a state
            change past a gate that a manual tap would have hit.
        ]]
        local slot = payload.slot
        local session2 = self._sessions[player]
        local loadout = if type(slot) == "number"
            then self._profileService:loadoutAt(player, slot)
            else nil
        if loadout == nil then
            self:_setToast(player, "THAT KIT IS EMPTY")
            self:_publish(player)
        elseif
            session2 == nil
            or session2.stage ~= "complete"
            or not self._survivalService:canAct(player)
            or player:GetAttribute("LastLightInExpedition") == true
        then
            self:_setToast(player, "KITS SWAP IN TOWN, ON YOUR FEET")
            self:_publish(player)
        else
            local applied = {}
            if loadout.professionId ~= nil then
                local result = self._professionService:select(player, loadout.professionId)
                if result.accepted then
                    table.insert(applied, "PROFESSION")
                end
            end
            if loadout.weaponItemId ~= nil then
                local result = self._profileService:equipItem(player, loadout.weaponItemId)
                if result.accepted then
                    table.insert(applied, "WEAPON")
                end
            end
            if loadout.toolId ~= nil and self._toolCatalog.isValid(loadout.toolId) then
                session2.selectedTool = loadout.toolId
                self:_applyToolAttributes(player, loadout.toolId)
                self._profileService:setTutorial(player, session2.stage, loadout.toolId)
                table.insert(applied, "TOOL")
            end
            self:_setToast(
                player,
                if #applied > 0
                    then string.format("KIT %d — %s READY", slot, table.concat(applied, " · "))
                    else "KIT COULD NOT BE APPLIED"
            )
            self:_publish(player)
        end
    elseif kind == self._runtimeIds.Actions.CompanionCommand then
        local mode = payload.mode
        if self._companionService ~= nil and type(mode) == "string" and #mode <= 12 then
            local result = self._companionService:command(player, mode)
            self:_setToast(player, result.message)
            self:_publish(player)
        end
    elseif kind == self._runtimeIds.Actions.RepairGear then
        local itemId = payload.itemId
        if type(itemId) == "string" and #itemId <= 32 then
            local result = self._profileService:repairGear(player, itemId)
            self:_setToast(
                player,
                if result.applied
                    then "WHETTED — "
                        .. gearDisplayName(self._equipmentCatalog, itemId)
                        .. " IS SOUND AGAIN"
                    elseif
                        result.reason == "insufficient_materials"
                    then "WHETTING TAKES HALF THE RECIPE'S MATERIALS"
                    elseif result.reason == "not_worn" then "THAT GEAR IS ALREADY SOUND"
                    else "THAT GEAR CANNOT BE WHETTED"
            )
            self:_publish(player)
        end
    elseif kind == self._runtimeIds.Actions.EquipGear then
        local itemId = payload.itemId
        if type(itemId) == "string" and #itemId <= 32 then
            local result = self._profileService:equipItem(player, itemId)
            self:_setToast(
                player,
                if result.accepted
                    then "EQUIPPED " .. gearDisplayName(self._equipmentCatalog, itemId)
                    else "CANNOT EQUIP ITEM"
            )
            self:_publish(player)
        end
    elseif kind == self._runtimeIds.Actions.CompactHud and type(payload.enabled) == "boolean" then
        local session = self._sessions[player]
        if session ~= nil then
            session.compactHud = payload.enabled
            self:_publish(player)
        end
    end
end

-- Push lobby state to every client. The countdown changes once a second and
-- is the same for everyone, so it broadcasts rather than publishing per-player
-- on a timer.
function TutorialService.broadcastLobby(self: TutorialService, toast: string?)
    if toast ~= nil then
        for player, session in self._sessions do
            session.toast = toast
            session.toastRevision += 1
            self:_publish(player)
        end
        return
    end
    self:_publishAll()
end

--[[
    Where the current objective physically is.

    The objective card names what to do; nothing ever said where. "Choose a
    starter tool" and "gather heartwood" both sent a new player wandering,
    which is the owner's report. Positions are resolved from the live
    interaction registry rather than a coordinate table, so a marker cannot
    drift from the thing it points at when a lot moves.
]]
function TutorialService._objectiveTargets(
    self: TutorialService,
    player: Player,
    session: Session
): { any }
    --[[
        In the expedition, the objective is whatever the Blackout wants next.
        The owner's tablet run made the gap concrete: "take rootfire from the
        Blackout Lantern" with no marker on the lantern, in the dark, in an
        unfamiliar forest. Every stage of the chapter now points somewhere --
        the fire source (or any lit root) when hands are empty, the next
        unlit root while carrying, the arenas for the encounters, the
        planters for the vote, and the Wayhome gate once the chapter is done.
    ]]
    if player:GetAttribute("LastLightInExpedition") == true then
        local resolved = {}
        local function add(part: BasePart?, label: string)
            if part ~= nil and part:IsA("BasePart") then
                table.insert(resolved, {
                    interactionId = part.Name,
                    x = part.Position.X,
                    y = part.Position.Y,
                    z = part.Position.Z,
                    label = label,
                })
            end
        end
        local blackout = self._blackoutService:snapshot(player)
        local arena = self._worldService:blackoutArena()
        if blackout ~= nil and arena ~= nil then
            if blackout.status == "relay" then
                self:_addSurveyTarget(player, add)
                if blackout.carryingFire and blackout.nextNodeId ~= nil then
                    add(arena.relayNodes[blackout.nextNodeId], "DELIVER ROOTFIRE")
                else
                    add(arena.fireSource, "TAKE ROOTFIRE")
                    -- deliveredNodeMap, not deliveredNodes: the latter is the
                    -- HUD's lit-count (a number), and iterating it threw
                    -- "attempt to iterate over a number value" on every
                    -- snapshot publish for the whole relay stage.
                    for nodeId, delivered in blackout.deliveredNodeMap or {} do
                        if delivered == true then
                            add(arena.relayNodes[nodeId], "TAKE ROOTFIRE")
                        end
                    end
                end
                return resolved
            elseif blackout.status == "old_growth" then
                local eliteArena = self._worldService:oldGrowthArena()
                if eliteArena ~= nil then
                    add(eliteArena.fireSource, "CLEANSE OLD GROWTH")
                end
                return resolved
            elseif blackout.status == "warden" then
                local bossSeal = self._worldService:wardenSealPart()
                add(bossSeal, "FACE THE WARDEN STAG")
                return resolved
            elseif blackout.status == "resolution" then
                for _, target in arena.decisions do
                    add(target, "CAST YOUR VOTE")
                end
                return resolved
            end
        end
        -- Chapter resolved or Blackout disabled: home is the objective.
        local wayhome = self._worldService:interaction(self._runtimeIds.InteractionIds.Wayhome)
        local holder = if wayhome ~= nil then wayhome.Parent else nil
        if holder ~= nil and holder:IsA("BasePart") then
            add(holder, "WAYHOME GATE")
        end
        self:_addSurveyTarget(player, add)
        return resolved
    end
    local definition = self._tutorialFlow.definition(session.stage)
    local targets = definition.targets
    if targets == nil then
        return {}
    end
    local resolved = {}
    for _, interactionId in targets do
        local prompt = self._worldService:interaction(interactionId)
        local holder = if prompt ~= nil then prompt.Parent else nil
        if holder ~= nil and holder:IsA("BasePart") then
            table.insert(resolved, {
                interactionId = interactionId,
                x = holder.Position.X,
                y = holder.Position.Y,
                z = holder.Position.Z,
                label = definition.objective,
            })
        end
    end
    return resolved
end

function TutorialService.snapshot(self: TutorialService, player: Player): any
    local session = self._sessions[player]
    if session == nil then
        return {
            schemaVersion = 1,
            status = "loading",
            worldReady = self._networkService:isWorldReady(),
        }
    end

    local definition = self._tutorialFlow.definition(session.stage)
    local progress, total = self._tutorialFlow.progress(session.stage)
    local objective = definition.objective
    local detail = definition.detail
    local mara = definition.mara
    local guideSpeaker = "Mara"
    local trailName = "FIRST LIGHT"
    local expedition = self._expeditionService:snapshot(player)
    if expedition.active then
        trailName = "BRAMBLEWAKE"
        progress = expedition.moduleIndex
        total = expedition.moduleTotal
        objective = if expedition.moduleIndex == expedition.moduleTotal
            then "BANK REWARDS AT THE WAYHOME GATE"
            else "FOLLOW THE FOXFIRE TRAIL"
        local discovery = expedition.pointOfInterestName or expedition.eventName
        detail = if discovery == nil
            then expedition.moduleName
            else string.format("%s · %s", expedition.moduleName, discovery)
        -- A landmark gets to speak for itself; the generic line is only for
        -- the stretches of road between them.
        guideSpeaker = "You"
        mara = expedition.pointOfInterestDetail
            or "The roots remember every traveler who walked out. Stay on the amber path and they remember me kindly."
        local event = expedition.event
        if event ~= nil then
            if event.status == "dormant" then
                objective = event.objective
                detail = string.format("%s · 0/%d", event.displayName, event.total)
                mara = event.detail
            elseif event.status == "active" then
                objective = event.objective
                detail = string.format(
                    "%s · %d/%d · %ds",
                    event.displayName,
                    event.progress,
                    event.total,
                    event.timeRemaining or 0
                )
                -- Once the event is running, Mara's line stops describing the
                -- scene and starts saying how to finish it. The flavour still
                -- plays while the event is dormant, which is when a player is
                -- deciding whether to start it rather than trying to solve it.
                mara = event.guidance or event.detail
            elseif event.status == "completed" then
                objective = "EVENT COMPLETE — FOLLOW THE FOXFIRE TRAIL"
                detail = event.completionMessage
                mara = "Shared expedition rewards are safe for this server run."
            elseif event.status == "failed" then
                objective = "EVENT ENDED — FOLLOW THE AMBER PATH"
                detail = event.failureMessage
                mara = event.failureResolution
            end
        end
    end
    local phase = if self._phaseService:hasCompletedFirstNight()
        then self._townNightService:snapshot()
        else self._phaseService:snapshot()
    local survival = self._survivalService:snapshot(player)
    local blackout = self._blackoutService:snapshot(player)
    if blackout ~= nil then
        trailName = "BRAMBLEWAKE BLACKOUT"
        progress = blackout.stage
        total = blackout.stageCount
        objective = blackout.instruction
        detail = if blackout.status == "relay"
            then string.format(
                "%s · NEXT %s · %d/%d",
                if blackout.carryingFire then "CARRY ROOTFIRE" else "TAKE ROOTFIRE",
                tostring(blackout.nextNodeLabel or "ROOT"),
                blackout.deliveredNodes,
                blackout.relayRequired
            )
            elseif
                blackout.status == "old_growth"
            then "STAGE 2/4 · ROOTED WALLS HOLD UNTIL OLD GROWTH FALLS"
            elseif blackout.status == "warden" then "STAGE 3/4 · THE WARDEN REMEMBERS EVERY ANTLER"
            elseif
                blackout.status == "resolution"
            then "STAGE 4/4 · FARMLAND, WILD REGROWTH, OR SHARED AGROFOREST"
            elseif blackout.status == "complete" then string.format(
                -- Decision IDs are snake_case; a raw one leaked into
                -- player-facing copy as "SHARED_AGROFOREST · PRESERVED".
                "%s · %s",
                string.upper(tostring(blackout.decision):gsub("_", " ")),
                string.upper(tostring(blackout.wardenOutcome):gsub("_", " "))
            )
            else "THE BLACKOUT HAS NOT BEGUN"
        --[[
            The traveler talks to themself out here -- the owner asked for
            exactly this: a voice saying what is actually going on and what to
            do next. Mara stayed in Emberhollow, so the expedition's guide
            voice is first person, and each line carries a piece of the
            chapter's story along with the instruction. The marker system says
            WHERE; this says WHY.
        ]]
        guideSpeaker = "You"
        mara = if blackout.status == "relay"
            then if blackout.carryingFire
                then "It burns fast. The marked root, before the flame forgets my hands."
                else "The evacuation's fire still burns in that lantern. The living roots are starving for it — I carry, they wake."
            elseif
                blackout.status == "resolution"
            then "The Greenward is asking what this land becomes. Whatever we plant here, the town inherits."
            elseif
                blackout.status == "complete"
            then "The seal answered me. Whatever I am carrying, it is time to bring it home."
            else "The dark out here is old grief, not weather. Keep moving — nothing I have earned can be taken by the clock."
    end
    local elite = self._oldGrowthService:snapshot(player)
    if elite ~= nil and (blackout == nil or blackout.status == "old_growth") then
        if elite.active then
            objective = elite.instruction
            detail = string.format(
                "OLD GROWTH · PHASE %d/3 · %d/%d",
                elite.phase,
                elite.health,
                elite.maxHealth
            )
            mara = if elite.shielded
                then "Steel means nothing to that shield. Fire does — carry it from the ember to the heart."
                else "There — the amber heart. Strike it, and mind the roots when they rise."
        elseif elite.complete then
            objective = "OLD GROWTH CLEANSED — CONTINUE TO WAYHOME"
            detail = if elite.rewardEligible
                then "+3 AMBER SAP UNBANKED"
                else "THE OLDEST ROOTS HAVE RELEASED THE TRAIL"
            mara = if elite.rewardEligible
                then "The oldest roots have released their Amber Sap."
                else "The oldest roots were cleansed before you arrived."
        end
    end
    local boss = self._wardenStagService:snapshot(player)
    if boss ~= nil and (blackout == nil or blackout.status == "warden") then
        if blackout == nil then
            trailName = "WARDEN'S SEAL"
        end
        progress = boss.phase
        total = 3
        if boss.active then
            objective = boss.instruction
            detail = if boss.exposed
                then string.format(
                    "WARDEN STAG · PHASE %d/3 · %d/%d",
                    boss.phase,
                    boss.health,
                    boss.maxHealth
                )
                else string.format(
                    "LIVING ROOTS · %d/%d · ANTLERS BROKEN %d/2",
                    boss.cleansedNodes,
                    boss.rootNodesRequired,
                    boss.antlersBroken
                )
            mara = if boss.exposed
                then "Its memory heart is open. Strike before the roots close again."
                else "Cleanse living roots to preserve the forest. Breaking antlers is faster, but permanent."
        elseif boss.complete then
            objective = boss.instruction
            detail = if boss.rewardEligible
                then "+5 AMBER SAP UNBANKED"
                else "THE WARDEN'S CHOICE WAS SETTLED BEFORE YOU ARRIVED"
            mara = if boss.outcome == "preserved"
                then "The Warden remembers mercy. A future forest path remains possible."
                else "The forest remembers what was broken. The chapter can continue, but changed."
        elseif boss.status == "locked" then
            objective = boss.instruction
            detail = "THE MEMORY SEAL REMAINS ROOTED"
            mara = "The oldest growth guards the way to the Warden."
        end
    end
    local gearCare, whetTarget = self:_gearCare(player)
    return {
        schemaVersion = 1,
        status = "ready",
        worldReady = true,
        lobby = self._lobbyService:snapshot(),
        action = self:actionSnapshot(player),
        departed = self._lobbyService:isDeparted(player),
        stage = session.stage,
        tutorialComplete = session.stage == "complete",
        objective = objective,
        detail = detail,
        mara = mara,
        trailName = trailName,
        progress = progress,
        progressTotal = total,
        resources = session.resources,
        selectedTool = session.selectedTool,
        compactHud = session.compactHud,
        toast = session.toast,
        toastRevision = session.toastRevision,
        phase = phase.phase,
        phaseEndsAt = phase.phaseEndsAt,
        nightActive = phase.nightActive,
        lanternHealth = phase.lanternHealth,
        enemyCount = phase.enemyCount,
        nightNumber = phase.nightNumber,
        blackoutDue = phase.blackoutDue,
        expeditionActive = expedition.active,
        regionId = if expedition.active then "region_bramblewake" else "region_emberhollow",
        expeditionSeed = expedition.seed,
        expeditionManifestHash = expedition.manifestHash,
        expeditionModuleId = expedition.moduleId,
        expeditionPointOfInterestId = expedition.poiId,
        expeditionEventId = expedition.eventId,
        expeditionEventStatus = if expedition.event == nil then nil else expedition.event.status,
        expeditionEventProgress = if expedition.event == nil
            then nil
            else expedition.event.progress,
        expeditionEventProgressTotal = if expedition.event == nil
            then nil
            else expedition.event.total,
        unbankedExpeditionRewards = expedition.unbankedRewards,
        bankedMaterials = expedition.bankedMaterials,
        gear = self._profileService:gearSnapshot(player),
        companion = if self._companionService ~= nil
            then self._companionService:snapshot(player)
            else nil,
        gearCare = gearCare,
        whetTarget = whetTarget,
        equipped = self._profileService:equippedSnapshot(player),
        equipmentStats = self._profileService:equipmentStats(player),
        mastery = self._profileService:masterySnapshot(player),
        townConsequence = self._profileService:townConsequence(player),
        townCondition = self._townNightService:conditionSnapshot(),
        recipes = self._craftingCatalog:list(),
        equipmentCatalog = self._equipmentCatalog.list(),
        objectiveTargets = self:_objectiveTargets(player, session),
        residentLife = self._profileService:residentLifeSnapshot(player),
        decorations = self._profileService:decorationsSnapshot(player),
        contract = self._expeditionService:contractSnapshot(),
        townHost = (function(): any
            local info = self._townNightService:hostInfo(player.UserId)
            if info == nil then
                return nil
            end
            local hostPlayer = Players:GetPlayerByUserId(info.hostUserId)
            return {
                role = info.role,
                hostName = if hostPlayer ~= nil then hostPlayer.DisplayName else nil,
            }
        end)(),
        guideSpeaker = guideSpeaker,
        quests = self._profileService:questSnapshot(player),
        memoryArchive = self._profileService:memoryFragments(player),
        combat = self._combatService:snapshot(player),
        profession = self._professionService:snapshot(player),
        elite = elite,
        boss = boss,
        blackout = blackout,
        threat = self._enemyService:threatSnapshot(player),
        survival = survival,
    }
end

function TutorialService._publish(self: TutorialService, player: Player)
    self._networkService:send(player, self:snapshot(player))
end

function TutorialService._publishAll(self: TutorialService)
    for player in self._sessions do
        self:_publish(player)
    end
end

return table.freeze(TutorialService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">WardenStagService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local WardenStagService = {}
WardenStagService.__index = WardenStagService
WardenStagService.Name = "WardenStagService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type AttackVisual = {
    label: TextLabel,
    marker: Part,
}

type Attack = {
    areaCFrame: CFrame,
    definition: any,
    flow: any,
    target: Player,
    visual: AttackVisual,
}

export type WardenStagService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _expeditionService: any,
        _survivalService: any,
        _combatService: any,
        _professionService: any,
        _oldGrowthService: any,
        _encounter: any,
        _enemyAttackFlow: any,
        _enemyCombatRules: any,
        _builder: any,
        _analyticsService: any,
        _featureFlags: any,
        _state: any,
        _arena: any,
        _model: Model?,
        _strikeHandler: ((Player) -> ())?,
        _attack: Attack?,
        _attackIndex: number,
        _lastAttackAt: number,
        _markedUntil: number,
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
        _unlockGate: (() -> boolean)?,
    },
    WardenStagService
))

local ACTIVATION_RADIUS = 27
local ENCOUNTER_RADIUS = 56
local STRIKE_RANGE = 15

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function weakPoint(model: Model): BasePart?
    local heart = model:FindFirstChild("MemoryHeart")
    return if heart ~= nil
            and heart:IsA("BasePart")
            and heart:GetAttribute("WeakPoint") == true
        then heart
        else nil
end

function WardenStagService.new(
    logger: Logger,
    worldService: any,
    expeditionService: any,
    survivalService: any,
    combatService: any,
    professionService: any,
    oldGrowthService: any,
    encounter: any,
    enemyAttackFlow: any,
    enemyCombatRules: any,
    builder: any,
    analyticsService: any,
    featureFlags: any
): WardenStagService
    return setmetatable({
        Name = WardenStagService.Name,
        _logger = logger,
        _worldService = worldService,
        _expeditionService = expeditionService,
        _survivalService = survivalService,
        _combatService = combatService,
        _professionService = professionService,
        _oldGrowthService = oldGrowthService,
        _encounter = encounter,
        _enemyAttackFlow = enemyAttackFlow,
        _enemyCombatRules = enemyCombatRules,
        _builder = builder,
        _analyticsService = analyticsService,
        _featureFlags = featureFlags,
        _state = nil,
        _arena = nil,
        _model = nil,
        _strikeHandler = nil,
        _attack = nil,
        _attackIndex = 0,
        _lastAttackAt = 0,
        _markedUntil = 0,
        _onChanged = nil,
        _heartbeat = nil,
        _unlockGate = nil,
    }, WardenStagService)
end

function WardenStagService.setUnlockGate(self: WardenStagService, gate: (() -> boolean)?)
    self._unlockGate = gate
end

function WardenStagService.Init(self: WardenStagService, _context: any)
    local manifest = assert(self._expeditionService:manifest(), "expedition manifest unavailable")
    self._arena = assert(self._worldService:wardenStagArena(), "Warden Stag arena unavailable")
    self._state = self._encounter.create(
        self._expeditionService:runId(),
        manifest.hash,
        self._featureFlags:isEnabled("warden_stag_boss_enabled")
    )
    self._worldService:setWardenStagPresentation(self._state)
end

function WardenStagService.Start(self: WardenStagService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.05 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
    self._logger:info("warden_stag_ready", {
        boss = self._encounter.Id,
        enabled = self._state.status ~= "disabled",
        manifest = self._state.manifestHash,
    })
end

function WardenStagService.setChangedHandler(self: WardenStagService, callback: (string?) -> ())
    self._onChanged = callback
end

function WardenStagService._notify(self: WardenStagService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function WardenStagService._inArena(
    self: WardenStagService,
    player: Player,
    radius: number
): boolean
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return false
    end
    local root = rootPart(player)
    return root ~= nil and (root.Position - self._arena.center).Magnitude <= radius
end

function WardenStagService._spawnModel(self: WardenStagService, target: Player)
    if self._model ~= nil and self._model.Parent ~= nil then
        return
    end
    local targetRoot = rootPart(target)
    local lookAt = if targetRoot == nil
        then self._arena.center + Vector3.new(0, 0, -10)
        else targetRoot.Position
    local model = self._builder.build(self._arena.center, lookAt, self._encounter.MaxHealth)
    model.Parent = self._arena.model
    task.spawn(function()
        if model.Parent ~= nil then
            self._worldService:placeEnemyVisual(model, "warden_stag")
        end
    end)
    self._model = model
    -- Tappable like every night creature -- see OldGrowthService for the
    -- full account; the boss had the same touch gap as the elite.
    local click = Instance.new("ClickDetector")
    click.Name = "StrikeClick"
    click.MaxActivationDistance = 42
    click.CursorIcon = ""
    click.Parent = model
    click.MouseClick:Connect(function(clicker: Player)
        local handler = self._strikeHandler
        if handler ~= nil then
            handler(clicker)
        end
    end)
    self:_syncModel()
end

function WardenStagService.setStrikeHandler(self: WardenStagService, handler: (Player) -> ())
    self._strikeHandler = handler
end

function WardenStagService._syncModel(self: WardenStagService)
    if self._model == nil then
        return
    end
    self._builder.setState(
        self._model,
        self._state.health,
        self._state.status,
        workspace:GetServerTimeNow() < self._markedUntil,
        self._state.brokenAntlers,
        self._state.outcome
    )
end

function WardenStagService._clearAttack(self: WardenStagService)
    local attack = self._attack
    if attack == nil then
        return
    end
    if attack.visual.marker.Parent ~= nil then
        attack.visual.marker:Destroy()
    end
    self._attack = nil
end

function WardenStagService._groundPosition(self: WardenStagService, targetRoot: BasePart): Vector3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = { targetRoot.Parent :: Model }
    if self._model ~= nil then
        table.insert(excluded, self._model)
    end
    params.FilterDescendantsInstances = excluded
    local result = workspace:Raycast(
        targetRoot.Position + Vector3.new(0, 3, 0),
        Vector3.new(0, -18, 0),
        params
    )
    return if result == nil
        then targetRoot.Position - Vector3.new(0, 2.8, 0)
        else result.Position + Vector3.new(0, 0.14, 0)
end

function WardenStagService._attackArea(
    self: WardenStagService,
    definition: any,
    targetRoot: BasePart
): CFrame
    local ground = self:_groundPosition(targetRoot)
    if definition.shape == "circle" or self._model == nil or self._model.PrimaryPart == nil then
        return CFrame.new(ground)
    end
    local origin = self._model.PrimaryPart.Position
    local direction =
        Vector3.new(targetRoot.Position.X - origin.X, 0, targetRoot.Position.Z - origin.Z)
    if direction.Magnitude < 0.01 then
        direction = Vector3.new(0, 0, -1)
    end
    direction = direction.Unit
    local center = Vector3.new(origin.X, ground.Y, origin.Z) + direction * definition.length * 0.5
    return CFrame.lookAt(center, center + direction)
end

function WardenStagService._createAttackVisual(
    self: WardenStagService,
    definition: any,
    areaCFrame: CFrame
): AttackVisual
    local marker = Instance.new("Part")
    marker.Name = "WardenStagAttackWarning"
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.CastShadow = false
    marker.Color = if definition.shape == "lane"
        then Color3.fromRGB(105, 200, 148)
        else Color3.fromRGB(255, 157, 91)
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.48
    if definition.shape == "lane" then
        marker.Size = Vector3.new(definition.width, 0.2, definition.length)
        marker.CFrame = areaCFrame
    else
        marker.Shape = Enum.PartType.Cylinder
        marker.Size = Vector3.new(0.2, definition.radius * 2, definition.radius * 2)
        marker.CFrame = areaCFrame * CFrame.Angles(0, 0, math.rad(90))
    end
    marker.Parent = self._arena.model

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "WardenStagAttackLabel"
    billboard.Adornee = marker
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 120
    billboard.Size = UDim2.fromOffset(300, 72)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.5, 0)
    billboard.Parent = marker

    local label = Instance.new("TextLabel")
    label.Name = "Warning"
    label.BackgroundColor3 = Color3.fromRGB(23, 36, 29)
    label.BackgroundTransparency = 0.06
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = definition.attackName .. "\n" .. definition.instruction
    label.TextColor3 = Color3.fromRGB(248, 233, 198)
    label.TextScaled = true
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local outline = Instance.new("UIStroke")
    outline.Color = marker.Color
    outline.Thickness = 2
    outline.Transparency = 0.08
    outline.Parent = label
    return {
        label = label,
        marker = marker,
    }
end

function WardenStagService._startAttack(self: WardenStagService, target: Player, now: number)
    local targetRoot = rootPart(target)
    if targetRoot == nil then
        return
    end
    self._attackIndex += 1
    local definition = self._encounter.attack(self._attackIndex, self._state.phase)
    local areaCFrame = self:_attackArea(definition, targetRoot)
    self._attack = {
        areaCFrame = areaCFrame,
        definition = definition,
        flow = self._enemyAttackFlow.create(target.UserId, now, definition.windup),
        target = target,
        visual = self:_createAttackVisual(definition, areaCFrame),
    }
    self._lastAttackAt = now
    self._analyticsService:bossAttackTelegraphed(
        target,
        self._encounter.Id,
        definition.attackId,
        definition.shape,
        definition.windup
    )
    self:_notify(nil)
end

function WardenStagService._clearPath(self: WardenStagService, target: Player): boolean
    local model = self._model
    local root = rootPart(target)
    local character = target.Character
    if model == nil or model.PrimaryPart == nil or root == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { model }
    local result = workspace:Raycast(
        model.PrimaryPart.Position,
        root.Position - model.PrimaryPart.Position,
        params
    )
    return result == nil or result.Instance:IsDescendantOf(character)
end

function WardenStagService._insideAttack(
    self: WardenStagService,
    attack: Attack,
    targetRoot: BasePart
): boolean
    local localPosition = attack.areaCFrame:PointToObjectSpace(targetRoot.Position)
    return self._enemyCombatRules.contains(
        attack.definition.shape,
        localPosition.X,
        localPosition.Z,
        attack.definition.radius,
        attack.definition.width,
        attack.definition.length
    )
end

function WardenStagService._stepAttack(self: WardenStagService, now: number)
    local attack = self._attack
    if attack == nil then
        return
    end
    local targetRoot = rootPart(attack.target)
    local resolving = now >= attack.flow.endsAt
    local decision = self._enemyAttackFlow.evaluate(attack.flow, now, {
        clearPath = not resolving or self:_clearPath(attack.target),
        inImpactArea = not resolving
            or (targetRoot ~= nil and self:_insideAttack(attack, targetRoot)),
        targetCanAct = self._survivalService:canAct(attack.target),
        targetPresent = attack.target.Parent ~= nil and attack.target:GetAttribute(
            "LastLightInExpedition"
        ) == true and targetRoot ~= nil,
    })
    if decision.status == "pending" then
        attack.visual.label.Text = string.format(
            "%s\n%s · %.1fs",
            attack.definition.attackName,
            attack.definition.instruction,
            math.max(0, decision.remaining or 0)
        )
        return
    end

    local target = attack.target
    local definition = attack.definition
    self:_clearAttack()
    if decision.status == "cancel" or decision.status == "miss" then
        self._analyticsService:bossAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            decision.reason or decision.status
        )
        self:_notify(nil)
        return
    end
    if self._combatService:avoidsDamage(target, now) then
        self._analyticsService:bossAttackResult(
            target,
            self._encounter.Id,
            definition.attackId,
            "dodged"
        )
        self:_notify(nil)
        return
    end

    local damage, guarded =
        self._professionService:mitigateIncomingDamage(target, definition.damage, now)
    damage = self._combatService:mitigateShieldedDamage(target, damage, now)
    local result = self._survivalService:damage(target, damage, self._encounter.Id)
    if result.applied and definition.rootedDuration ~= nil then
        self._combatService:applyRooted(
            target,
            definition.rootedDuration,
            definition.rootedMultiplier
        )
    end
    self._analyticsService:bossAttackResult(
        target,
        self._encounter.Id,
        definition.attackId,
        if result.applied then (if guarded then "guarded_hit" else "hit") else "blocked"
    )
    if result.downed then
        self:_notify("ALLY DOWN — " .. definition.attackName)
    elseif guarded and result.applied then
        self:_notify("LANTERN GUARD ABSORBS " .. definition.attackName)
    else
        self:_notify(nil)
    end
end

function WardenStagService._playersInArena(self: WardenStagService): { Player }
    local players = {}
    for _, player in Players:GetPlayers() do
        if self:_inArena(player, ENCOUNTER_RADIUS) and self._survivalService:canAct(player) then
            table.insert(players, player)
        end
    end
    return players
end

function WardenStagService._nearestPlayer(self: WardenStagService, players: { Player }): Player?
    local anchor = self._arena.center
    if self._model ~= nil and self._model.PrimaryPart ~= nil then
        anchor = self._model.PrimaryPart.Position
    end
    local nearest: Player? = nil
    local nearestDistance = math.huge
    for _, player in players do
        local root = rootPart(player)
        if root ~= nil then
            local distance = (root.Position - anchor).Magnitude
            if distance < nearestDistance then
                nearest = player
                nearestDistance = distance
            end
        end
    end
    return nearest
end

function WardenStagService._step(self: WardenStagService, now: number)
    if
        self._state.status == "locked"
        and self._oldGrowthService:isComplete()
        and (self._unlockGate == nil or (self._unlockGate :: () -> boolean)())
    then
        local nextState, result = self._encounter.unlock(self._state)
        if result.accepted then
            self._state = nextState
            self._worldService:setWardenStagPresentation(self._state)
            self:_notify("THE WARDEN'S SEAL OPENS BEYOND OLD GROWTH")
        end
    end
    if self._state.status == "dormant" then
        for _, player in Players:GetPlayers() do
            if
                self:_inArena(player, ACTIVATION_RADIUS) and self._survivalService:canAct(player)
            then
                local nextState, result = self._encounter.activate(self._state, player.UserId)
                if result.accepted then
                    self._state = nextState
                    self:_spawnModel(player)
                    self._lastAttackAt = now
                    self._worldService:setWardenStagPresentation(self._state)
                    self._analyticsService:bossStarted(
                        player,
                        self._encounter.Id,
                        self._state.manifestHash
                    )
                    self._analyticsService:bossPhase(
                        player,
                        self._encounter.Id,
                        self._state.phase,
                        "cleansing_started",
                        self._state.antlersBroken
                    )
                    self:_notify("WARDEN STAG AWAKENS — CLEANSE THE LIVING ROOTS")
                end
                break
            end
        end
        return
    end
    if not self:combatActive() then
        return
    end

    local players = self:_playersInArena()
    for _, player in players do
        self._state = self._encounter.join(self._state, player.UserId)
    end
    if self._model == nil or self._model.Parent == nil then
        local target = self:_nearestPlayer(players)
        if target ~= nil then
            self:_spawnModel(target)
        end
    end
    if self._markedUntil > 0 and now >= self._markedUntil then
        self._markedUntil = 0
        self:_syncModel()
        self:_notify(nil)
    end
    if self._attack ~= nil then
        self:_stepAttack(now)
        return
    end
    local target = self:_nearestPlayer(players)
    if target == nil then
        return
    end
    local tuning = self._encounter.Tuning
    local cooldown = if self._state.status == "cleansing"
        then tuning.cleansingAttackCooldownSeconds
        else tuning.attackCooldownSeconds
    if now < self._markedUntil then
        cooldown *= tuning.markedAttackCooldownMultiplier
    end
    if now - self._lastAttackAt >= cooldown then
        self:_startAttack(target, now)
    end
end

function WardenStagService.interact(
    self: WardenStagService,
    player: Player,
    prompt: ProximityPrompt
): any
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return {
            accepted = false,
            message = "ENTER THE WARDEN'S SEAL WHILE ACTIVE",
            reason = "player_unavailable",
        }
    end
    local target = prompt.Parent
    local interaction = if target == nil then nil else target:GetAttribute("BossInteraction")
    local nextState, result
    if interaction == "cleanse_root" then
        nextState, result = self._encounter.cleanseRoot(
            self._state,
            player.UserId,
            tostring(target:GetAttribute("BossNodeId"))
        )
    elseif interaction == "break_antler" then
        nextState, result = self._encounter.breakAntler(
            self._state,
            player.UserId,
            tostring(target:GetAttribute("BossAntlerId"))
        )
    else
        return {
            accepted = false,
            message = "THAT WARDEN INTERACTION IS INVALID",
            reason = "invalid_interaction",
        }
    end
    if not result.accepted then
        result.message = if result.reason == "already_cleansed"
            then "THAT LIVING ROOT IS ALREADY CLEAN"
            elseif
                result.reason == "antler_already_broken"
                or result.reason == "phase_antler_already_broken"
            then "THAT ANTLER SHORTCUT IS NO LONGER AVAILABLE"
            elseif
                self._state.status == "vulnerable"
            then "THE MEMORY HEART IS EXPOSED — STRIKE NOW"
            else "THE WARDEN IS NOT CALLING FOR THAT CHOICE"
        return result
    end

    self._state = nextState
    self._worldService:setWardenStagPresentation(self._state)
    self:_syncModel()
    if result.reason == "antler_broken" then
        result.message = "ANTLER BROKEN — THE FOREST WILL REMEMBER THIS HARM"
        self._analyticsService:bossPhase(
            player,
            self._encounter.Id,
            self._state.phase,
            "antler_shortcut",
            self._state.antlersBroken
        )
    elseif result.exposed then
        result.message = "LIVING ROOTS CLEANSED — MEMORY HEART EXPOSED"
        self._analyticsService:bossPhase(
            player,
            self._encounter.Id,
            self._state.phase,
            "heart_exposed",
            self._state.antlersBroken
        )
    else
        result.message =
            string.format("LIVING ROOT CLEANSED — %d / %d", result.cleansed, result.required)
    end
    self:_notify(result.message)
    return result
end

function WardenStagService._lineOfSight(
    _self: WardenStagService,
    player: Player,
    model: Model
): boolean
    local root = rootPart(player)
    local heart = weakPoint(model)
    local character = player.Character
    if root == nil or heart == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    -- Exclude the boss itself for the same reason OldGrowthService does: its
    -- invisible hitbox parts are not cover against its own exposed heart, and
    -- the old first-hit-must-be-the-heart check could never pass once the
    -- visual pass cleared the heart's CanQuery. Only world geometry blocks.
    params.FilterDescendantsInstances = { character, model }
    local result = workspace:Raycast(root.Position, heart.Position - root.Position, params)
    return result == nil
end

function WardenStagService.damageNearest(self: WardenStagService, player: Player): (boolean, string)
    if self._state.status ~= "vulnerable" and self._state.status ~= "cleansing" then
        return false, "No Warden Stag threat is active."
    end
    if self._state.status == "cleansing" then
        return false, "CLEANSE LIVING ROOTS OR ACCEPT THE ANTLER CONSEQUENCE"
    end
    if not self:_inArena(player, ENCOUNTER_RADIUS) or not self._survivalService:canAct(player) then
        return false, "Enter the Warden's Seal to strike."
    end
    local model = self._model
    local root = rootPart(player)
    local heart = if model == nil then nil else weakPoint(model)
    if model == nil or root == nil or heart == nil then
        return false, "The Warden Stag is still taking shape."
    end
    if (root.Position - heart.Position).Magnitude > STRIKE_RANGE then
        return false, "Move closer to the memory heart."
    end
    if not self:_lineOfSight(player, model) then
        return false, "The memory heart is hidden behind the Warden."
    end

    local tuning = self._encounter.Tuning
    local amount = if workspace:GetServerTimeNow() < self._markedUntil
        then tuning.markedStrikeDamage
        else tuning.strikeDamage
    local nextState, result = self._encounter.strike(self._state, player.UserId, amount)
    if not result.accepted then
        return false, "The Warden Stag cannot be struck right now."
    end
    self._state = nextState
    self._worldService:setWardenStagPresentation(self._state)
    self:_syncModel()
    if result.completed then
        self:_clearAttack()
        for participantId in self._state.participants do
            local userId = tonumber(participantId)
            if userId ~= nil then
                self._expeditionService:grantEncounterReward(
                    userId,
                    self._encounter.Id,
                    self._encounter.rewardTransactionId(self._state, userId),
                    self._encounter.Reward
                )
            end
        end
        self._analyticsService:bossResult(
            player,
            self._encounter.Id,
            self._state.manifestHash,
            self._state.outcome,
            self._state.antlersBroken,
            self:_participantCount()
        )
        local message = if self._state.outcome == "preserved"
            then "WARDEN STAG CALMED — FOREST ALLY PRESERVED · +5 AMBER SAP"
            elseif
                self._state.outcome == "harmed"
            then "WARDEN STAG DEFEATED — FOREST HARMED · +5 AMBER SAP"
            else "WARDEN STAG DEFEATED — FOREST SCARRED · +5 AMBER SAP"
        self:_notify(message)
        return true, message
    end
    if result.phaseFinished then
        self._analyticsService:bossPhase(
            player,
            self._encounter.Id,
            self._state.phase,
            "cleansing_started",
            self._state.antlersBroken
        )
        self:_notify(string.format("PHASE %d/3 — CLEANSE THE LIVING ROOTS", self._state.phase))
        return true, "The memory heart closes. Cleanse the next root pattern."
    end
    self:_notify(
        string.format("HIT — WARDEN STAG %d / %d", self._state.health, self._encounter.MaxHealth)
    )
    return true, "Your tool strikes the exposed memory heart."
end

function WardenStagService._participantCount(self: WardenStagService): number
    local count = 0
    for _ in self._state.participants do
        count += 1
    end
    return count
end

function WardenStagService.canMarkNearest(
    self: WardenStagService,
    player: Player,
    range: number
): (boolean, string)
    local model = self._model
    local root = rootPart(player)
    if
        not self:combatActive()
        or model == nil
        or model.PrimaryPart == nil
        or root == nil
        or not self:_inArena(player, ENCOUNTER_RADIUS)
        or not self._survivalService:canAct(player)
    then
        return false, "NO BOSS THREAT CAN BE MARKED"
    end
    if (root.Position - model.PrimaryPart.Position).Magnitude > range then
        return false, "MOVE CLOSER TO MARK THE WARDEN STAG"
    end
    return true, "FOXFIRE MARK READY"
end

function WardenStagService.markNearest(
    self: WardenStagService,
    player: Player,
    range: number,
    duration: number
): (boolean, string)
    local allowed, reason = self:canMarkNearest(player, range)
    if not allowed then
        return false, reason
    end
    self._markedUntil = workspace:GetServerTimeNow() + duration
    self:_syncModel()
    local message = "FOXFIRE MARK — WARDEN STAG TELEGRAPHS SLOWED"
    self:_notify(message)
    return true, message
end

function WardenStagService.threatSnapshot(self: WardenStagService, viewer: Player): any
    local attack = self._attack
    if attack == nil or attack.target ~= viewer then
        return nil
    end
    return {
        attackId = attack.definition.attackId,
        displayName = attack.definition.attackName,
        enemyId = self._encounter.Id,
        enemyName = "WARDEN STAG",
        instruction = attack.definition.instruction,
        resolvesAt = attack.flow.endsAt,
        shape = attack.definition.shape,
    }
end

function WardenStagService.snapshot(self: WardenStagService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return nil
    end
    -- Same contract as the Old Growth rail: no boss rail before the fight
    -- exists. "locked" is the sealed annex and "dormant" the unlocked but
    -- not-yet-entered arena; the physical seal already explains both states
    -- in the world.
    if self._state.status == "locked" or self._state.status == "dormant" then
        return nil
    end
    if not self:_inArena(player, ENCOUNTER_RADIUS + 20) then
        return nil
    end
    return self._encounter.snapshot(self._state, player.UserId)
end

function WardenStagService.combatActive(self: WardenStagService): boolean
    return self._state.status == "cleansing" or self._state.status == "vulnerable"
end

function WardenStagService.isComplete(self: WardenStagService): boolean
    return self._state.status == "complete"
end

function WardenStagService.outcome(self: WardenStagService): string?
    return self._state.outcome
end

function WardenStagService.enabled(self: WardenStagService): boolean
    return self._state.status ~= "disabled"
end

return table.freeze(WardenStagService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local BramblewakeBuilder = require(script.Parent.Parent.World.BramblewakeBuilder)
local FoliageBuilder = require(script.Parent.Parent.World.FoliageBuilder)
local MeshTemplateLoader = require(script.Parent.Parent.World.MeshTemplateLoader)
local TerrainBuilder = require(script.Parent.Parent.World.TerrainBuilder)
local WorldSignBuilder = require(script.Parent.Parent.World.WorldSignBuilder)

local WorldService = {}
WorldService.__index = WorldService
WorldService.Name = "WorldService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type WorldService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _extractionPayoff: any,
        _memoryFragments: any,
        _memoryFragmentTargets: { [string]: any },
        _townProgression: any,
        _professionAbilityVisuals: any,
        _runtimeIds: any,
        _world: Model?,
        _interactions: { [string]: ProximityPrompt },
        _spawn: SpawnLocation?,
        _mara: Model?,
        _maraTrap: Model?,
        _maraStandY: number,
        _lobby: Folder?,
        _lobbySpawn: SpawnLocation?,
        _departurePlatform: BasePart?,
        _clickHandler: ((Player, string) -> ())?,
        _resourceNodes: { [string]: any },
        _lantern: BasePart?,
        _lanternVisualHealth: number,
        _beacon: BasePart?,
        _beaconCore: BasePart?,
        _beaconLens: BasePart?,
        _barricadeBuilt: boolean,
        _dusk: boolean,
        _duskSignals: { BasePart },
        _nightDefenseSignals: { BasePart },
        _nightThemeDressing: Model?,
        _breachActive: boolean,
        _night: boolean,
        _blackoutLightingActive: boolean,
        _expeditionEntry: CFrame?,
        _expeditionManifest: any,
        _expeditionModuleCenters: { any },
        _eventSockets: { [string]: BasePart },
        _eventTargets: { [string]: { [string]: BasePart } },
        _eventsEnabled: boolean,
        _oldGrowthArena: any,
        _wardenStagArena: any,
        _blackoutArena: any,
        _characterRoots: { [Player]: BasePart? },
        _townConsequence: any,
        _townConstruction: any,
        _townConstructionRules: any,
        _townCondition: any,
        _townResidents: { [string]: any },
        _buildingPlacements: { [string]: any },
        _townIncidentModel: Model?,
        _engineerBraceModel: Model?,
        _meshTemplateLoader: MeshTemplateLoader.MeshTemplateLoader,
        _townDecorationsCatalog: any,
        _meshPlacements: { MeshPlacement },
    },
    WorldService
))

-- Raised from (50, 63, 58): on a phone, shadowed ground fell back to only
-- this floor once exposure and contrast (both below) subtracted from it,
-- and read as near-black at the very start of the first level. Night keeps
-- its own separate, much lower floor (NIGHT_AMBIENT below), so this only
-- lifts the day/morning shadow, not the dusk/night contrast the design
-- docs ask for.
local DAY_AMBIENT = Color3.fromRGB(82, 94, 88)
-- Raised from (19, 26, 43) after the owner's tablet screenshots: values a
-- workstation renders as moody night, a real device crushes to black. Night
-- still reads as night -- the practicals and foxfire own it -- but ground
-- and silhouettes survive on hardware now.
local NIGHT_AMBIENT = Color3.fromRGB(36, 44, 60)
local AMBER = Color3.fromRGB(255, 181, 76)
local FOXFIRE = Color3.fromRGB(94, 206, 176)
local CREAM = Color3.fromRGB(244, 230, 197)
-- GREEN lived here for the old pine() canopy. That generator is gone; the same
-- value now reaches the forest as FOLIAGE_TONE.needle below.
local DARK_GREEN = Color3.fromRGB(18, 42, 32)
local BARK = Color3.fromRGB(62, 39, 30)
local WET_BARK = Color3.fromRGB(36, 26, 24)
local MOSS = Color3.fromRGB(58, 91, 54)
local WET_EARTH = Color3.fromRGB(67, 55, 39)
local HEARTWOOD_CENTER = Vector3.new(38, 0, -48)

local TOOL_YARD_CENTER = Vector3.new(-42, 0, -68)
--[[
    The town square: Emberhollow's centre, and the arena every night fight
    happens in.

    Both numbers used to live inside buildEmberhollowSanctuary while a dozen
    other places -- the First Lantern assembly, the foliage keep-out lots, the
    Watch Ring, the breach pulse, the road route -- each repeated the literal
    -112 instead. Moving the square meant finding all of them. They are here so
    that "where is the square and how big is it" has exactly one answer.

    Sized and seated for the fight rather than for the walk. The square sat at
    z -112, which put the arena at the far south end of town behind the
    lantern, and at 72 across it was only twice LanternSafeRadius (34) -- so
    the safe light reached the edge and there was nowhere to fight that was not
    already safe. At 112 across the lit core is the middle third: somewhere to
    retreat to rather than the whole floor. Pulling the centre north to -80
    brings the arena back up the road toward Mara and the arrival route, so a
    night defence happens where the player already is instead of at the bottom
    of the map.

    Everything that used to hard-code -112 or 36 now reads these.
]]
local TOWN_CENTER = Vector3.new(0, 0, -80)
local PLAZA_HALF = 56

--[[
    Across the arrival road just past the spawn, so the thing the player is
    asked to build visibly defends the way they came in. It used to sit 44
    studs off the route in an empty field, where building it read as busywork
    with nothing behind it.

    Raised clear of the road surface. The whole assembly is built relative to
    this point, and at ground level the construction plot spanned y 0 to 0.5
    while the arrival road surface sits around 0.24 to 0.60 -- so the road was
    drawn straight over the plot. There was nothing to see and nothing for a
    click to land on, which stranded the tutorial at the build step.
]]
local BARRICADE_CENTER = Vector3.new(-2, 0.62, -18)
-- Staging yard, north of the arrival clearing and clear of the route that
-- leaves it. Inside the flat valley bowl (x -190..190, z -260..90), so every
-- authored coordinate here sits on level ground.
local LOBBY_CENTER = Vector3.new(0, 0, 62)
local DEPARTURE_PLATFORM_CENTER = Vector3.new(0, 0, 54)
local DEPARTURE_PLATFORM_RADIUS = 9
-- Shared palette for the generated forest. Kept next to the existing colour
-- anchors so the treeline and the town read as the same world.
local FOLIAGE_TONE: FoliageBuilder.Tone = {
    bark = Color3.fromRGB(62, 39, 30),
    barkWet = Color3.fromRGB(36, 26, 24),
    needle = Color3.fromRGB(42, 77, 51),
    needleDeep = Color3.fromRGB(18, 42, 32),
    leaf = Color3.fromRGB(58, 91, 54),
    leafPale = Color3.fromRGB(112, 128, 79),
    moss = Color3.fromRGB(58, 91, 54),
    stone = Color3.fromRGB(75, 83, 79),
    stoneWarm = Color3.fromRGB(88, 84, 74),
}

type MeshPlacement = {
    assetId: string,
    fallbackKind: string,
    position: Vector3,
    scale: number,
    yaw: number,
    seed: number,
    swayTag: string?,
    parent: Instance?,
    fallbackInstance: Instance?,
    profileScale: Vector3?,
}

local function authoredPlacementTransform(placement: MeshPlacement): (CFrame, Vector3)
    local random = Random.new(placement.seed * 97 + 31)
    local pitch = 0
    local roll = 0
    local profileScale = placement.profileScale or Vector3.one

    -- Repeated organic assets keep the same measured mesh and collision-free
    -- template, but no two placements present the same upright silhouette.
    -- Buildings remain level so their doors, rotor, and fallback shells align.
    if placement.fallbackKind == "conifer" or placement.fallbackKind == "broadleaf" then
        pitch = random:NextNumber(math.rad(-6.5), math.rad(6.5))
        roll = random:NextNumber(math.rad(-7.5), math.rad(7.5))
        profileScale = Vector3.new(
            random:NextNumber(0.84, 1.16),
            random:NextNumber(0.92, 1.1),
            random:NextNumber(0.84, 1.16)
        )
    elseif placement.fallbackKind == "boulders" then
        pitch = random:NextNumber(math.rad(-4), math.rad(4))
        roll = random:NextNumber(math.rad(-4), math.rad(4))
        profileScale = Vector3.new(
            random:NextNumber(0.82, 1.18),
            random:NextNumber(0.88, 1.08),
            random:NextNumber(0.82, 1.18)
        )
    elseif placement.fallbackKind == "deadfall" then
        pitch = random:NextNumber(math.rad(-2.5), math.rad(2.5))
        roll = random:NextNumber(math.rad(-3.5), math.rad(3.5))
        profileScale = Vector3.new(
            random:NextNumber(0.88, 1.12),
            random:NextNumber(0.9, 1.08),
            random:NextNumber(0.82, 1.18)
        )
    elseif placement.fallbackKind == "undergrowth" then
        pitch = random:NextNumber(math.rad(-5), math.rad(5))
        roll = random:NextNumber(math.rad(-5), math.rad(5))
        profileScale = Vector3.new(
            random:NextNumber(0.82, 1.18),
            random:NextNumber(0.88, 1.12),
            random:NextNumber(0.82, 1.18)
        )
    elseif
        placement.assetId == "mesh_lantern_post_a"
        or placement.assetId == "mesh_creator_street_lantern_a"
    then
        pitch = random:NextNumber(math.rad(-2.5), math.rad(2.5))
        roll = random:NextNumber(math.rad(-3), math.rad(3))
    end

    return CFrame.new(placement.position) * CFrame.Angles(pitch, placement.yaw, roll), profileScale
end

local WAYHOME_DELIVERY_LIFETIME = 180
local WAYHOME_DELIVERY_ORIGINS = table.freeze({
    Vector3.new(-27, 0, -13),
    Vector3.new(-18, 0, -13),
    Vector3.new(-9, 0, -13),
    Vector3.new(9, 0, -13),
    Vector3.new(18, 0, -13),
    Vector3.new(27, 0, -13),
    Vector3.new(-27, 0, -21),
    Vector3.new(27, 0, -21),
})

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    if not instance.CanCollide then
        instance.CanQuery = false
    end
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function labelSign(parent: Instance, at: CFrame, text: string): Model
    return WorldSignBuilder.createDirectionSign(parent, "TrailSign", at, text, CREAM)
end

local function queueRoadAssetPlacements(
    placements: { MeshPlacement },
    parent: Instance,
    startPosition: Vector3,
    finishPosition: Vector3,
    seedBase: number
)
    local delta = finishPosition - startPosition
    local distance = delta.Magnitude
    local direction = delta.Unit
    local count = math.max(1, math.ceil(distance / 42))
    local chunkLength = distance / count
    local yaw = math.atan2(-direction.X, -direction.Z)
    for index = 1, count do
        local alpha = (index - 0.5) / count
        local position = startPosition:Lerp(finishPosition, alpha)
        table.insert(placements, {
            assetId = "mesh_creator_road_stones_a",
            fallbackKind = "asset_dressing",
            position = Vector3.new(position.X, 0.42, position.Z),
            scale = 1,
            yaw = yaw,
            seed = seedBase + index,
            swayTag = nil,
            parent = parent,
            fallbackInstance = nil,
            profileScale = Vector3.new(1.12, 0.92, chunkLength / 18),
        })
    end
end

--[[
    Clear terrain above a road so nothing can bury it.

    The whole road stack is under a stud tall -- foundation, surface, and worn
    centre together top out around 0.9 -- while the valley floor fills to
    GROUND_Y. That leaves almost no margin, and it has already gone wrong once:
    a half-voxel error in the floor fill put the surface a stud high and every
    road in the world vanished under the grass with nothing in the logs.

    Rather than rely on the two numbers staying in agreement, cut the corridor
    out. Terrain is filled before any road is placed, so clearing a box from
    just above the floor upward removes anything that could sit over the
    surface and is a harmless no-op when the floor is already correct. The cut
    is kept narrower than the road so the edges still meet grass instead of
    leaving a floating lip.
]]
local function clearRoadCorridor(startPosition: Vector3, finishPosition: Vector3, width: number)
    local delta = finishPosition - startPosition
    local length = delta.Magnitude
    if length <= 0.05 or width <= 2 then
        return
    end
    local midpoint = (startPosition + finishPosition) * 0.5
    local frame = CFrame.lookAt(
        Vector3.new(midpoint.X, 0, midpoint.Z),
        Vector3.new(finishPosition.X, 0, finishPosition.Z)
    )
    local clearHeight = 14
    Workspace.Terrain:FillBlock(
        frame * CFrame.new(0, 0.1 + clearHeight * 0.5, 0),
        Vector3.new(width - 2, clearHeight, length + 2),
        Enum.Material.Air
    )
end

local function buildEmberhollowSanctuary(
    parent: Instance,
    meshPlacements: { MeshPlacement }
): { Instance }
    local courtyard = TOWN_CENTER

    --[[
        How much room the town square gives a fight.

        The square shipped at 35 studs across, which combat had outgrown
        without anyone doing the arithmetic. At the sprint speed of 24 you
        crossed the whole plaza in 1.46 seconds, and a dodge covers about 18
        studs, so two dodges took you from one edge to the other. There was no
        room to retreat, circle, or pull an enemy off someone -- only room to
        hit the far wall.

        It then went to 72 -- twice LanternSafeRadius (34) -- which fixed the
        traversal problem but created a subtler one: the safe light reached the
        edge, so the entire arena was inside the safe zone and retreating into
        the light meant nothing. At 112 the lit core is the middle third. The
        boundary a player has been standing inside all along becomes something
        they can see and choose: the middle is lit and safe, the outer ring is
        neither, and pulling an enemy off someone means giving up the light.

        The cabins moved out to match, twice now. They sat at x +/-36 with a
        17.3-stud footprint, putting their inner walls at 27.4 -- inside the
        72-wide plaza -- and +/-52 put them inside this one. At +/-68 the inner
        walls sit at 59.3, clear of the 56-stud edge. See TOWN_CENTER and
        PLAZA_HALF at the top of this file; everything here is positioned off
        them, so retuning the square is still one number.
    ]]
    local COURTYARD_HALF_X = PLAZA_HALF + 22
    local COURTYARD_HALF_Z = PLAZA_HALF + 12
    local CABIN_X = 68

    local courtyardPatch = part(
        parent,
        "EmberhollowCourtyard",
        Vector3.new(COURTYARD_HALF_X * 2, 0.3, COURTYARD_HALF_Z * 2),
        CFrame.new(courtyard + Vector3.new(0, 0.18, 1)),
        Color3.fromRGB(53, 59, 45),
        Enum.Material.Ground,
        false
    )
    courtyardPatch.Transparency = 0.08

    -- This assembly follows the proven 65-part construction grammar from the
    -- supplied Place6 reference: raised foundation, segmented walls around real
    -- openings, four cross rafters, opposing roof wedges, framed windows, stairs,
    -- an open door, and a full-height stone chimney. Last Light owns the palette,
    -- props, dimensions, names, and lighting treatment.
    local function cabin(center: Vector3, yaw: number, name: string, accent: Color3): Instance
        local scale = 0.72
        center += Vector3.new(0, 2.2, 0)
        local cabinFrame = CFrame.new(center) * CFrame.Angles(0, yaw, 0)
        local cabinFolder = Instance.new("Folder")
        cabinFolder.Name = name
        cabinFolder.Parent = parent

        local shell = Instance.new("Folder")
        shell.Name = "ProceduralCabinShell"
        shell.Parent = cabinFolder

        local wallColor = if name == "MARA'S SHELTER"
            then Color3.fromRGB(69, 85, 66)
            else Color3.fromRGB(91, 63, 44)
        local trimColor = if name == "MARA'S SHELTER"
            then Color3.fromRGB(109, 126, 90)
            else Color3.fromRGB(137, 99, 61)
        local roofColor = Color3.fromRGB(48, 54, 49)
        local stoneColor = Color3.fromRGB(82, 84, 79)

        local function scaledSize(x: number, y: number, z: number): Vector3
            return Vector3.new(x * scale, y * scale, z * scale)
        end
        local function referenceCFrame(x: number, y: number, z: number): CFrame
            return cabinFrame * CFrame.new(x * scale, (y + 7.5) * scale + 0.25, z * scale)
        end
        local function cabinCFrame(x: number, y: number, z: number): CFrame
            return cabinFrame * CFrame.new(x, y, z)
        end
        local function referencePart(
            target: Instance,
            partName: string,
            dimensions: Vector3,
            x: number,
            y: number,
            z: number,
            color: Color3,
            material: Enum.Material,
            collidable: boolean?
        ): Part
            local created = part(
                target,
                partName,
                scaledSize(dimensions.X, dimensions.Y, dimensions.Z),
                referenceCFrame(x, y, z),
                color,
                material,
                collidable
            )
            if collidable == false then
                created.CanQuery = false
            end
            return created
        end

        referencePart(
            shell,
            "CabinFoundation",
            Vector3.new(36, 3, 24),
            0,
            -9.5,
            0,
            Color3.fromRGB(72, 76, 73),
            Enum.Material.Cobblestone
        )
        referencePart(
            shell,
            "CabinFloor",
            Vector3.new(34, 1, 22),
            0,
            -7.5,
            0,
            trimColor,
            Enum.Material.WoodPlanks
        )

        local wallPieces = {
            { 9, 9, 1, -13.5, -3.5, -11.5 },
            { 7, 5, 1, 0.5, -1.5, -11.5 },
            { 7, 5, 1, 14.5, -1.5, -11.5 },
            { 21, 4, 1, 7.5, -6, -11.5 },
            { 36, 6, 1, 0, 4, -11.5 },
            { 23, 8, 1, 6.5, -4, 11.5 },
            { 5, 8, 1, -15.5, -4, 11.5 },
            { 36, 7, 1, 0, 3.5, 11.5 },
        }
        for _, spec in wallPieces do
            referencePart(
                shell,
                "CabinWallPanel",
                Vector3.new(spec[1], spec[2], spec[3]),
                spec[4],
                spec[5],
                spec[6],
                wallColor,
                Enum.Material.WoodPlanks
            )
        end
        for side = -1, 1, 2 do
            for _, spec in
                {
                    { 1, 4, 22, -6, 0 },
                    { 1, 6, 22, 4, 0 },
                    { 1, 5, 7, -1.5, -7.5 },
                    { 1, 5, 8, -1.5, 7 },
                }
            do
                referencePart(
                    shell,
                    "CabinSideWallPanel",
                    Vector3.new(spec[1], spec[2], spec[3]),
                    side * 17.5,
                    spec[4],
                    spec[5],
                    wallColor,
                    Enum.Material.WoodPlanks
                )
            end
        end

        for _, z in { -7.5, -2.5, 2.5, 7.5 } do
            referencePart(
                shell,
                "CabinInteriorRafter",
                Vector3.new(34, 1, 1),
                0,
                6.5,
                z,
                WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
        -- Thin pitched roof planes keep the gable readable. The previous pair
        -- of six-stud-thick wedges became two enormous dark slabs at player
        -- height and hid the walls, windows, doors, and the road behind them.
        for roofSide = -1, 1, 2 do
            local roof = referencePart(
                shell,
                "CabinRoofPlane",
                Vector3.new(36.5, 0.72, 13.5),
                0,
                9.65,
                roofSide * 5.65,
                roofColor,
                Enum.Material.Slate
            )
            roof.CFrame *= CFrame.Angles(math.rad(roofSide * 28), 0, 0)
            roof.CastShadow = true
            referencePart(
                shell,
                "CabinEaveBeam",
                Vector3.new(37, 0.75, 0.75),
                0,
                6.55,
                roofSide * 11.55,
                WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
        referencePart(
            shell,
            "CabinRidgeBeam",
            Vector3.new(36.5, 0.8, 0.8),
            0,
            13,
            0,
            WET_BARK,
            Enum.Material.Wood,
            false
        )

        local function buildWindow(x: number, z: number, frontFacing: boolean)
            local window = referencePart(
                cabinFolder,
                "CabinWindowGlass",
                if frontFacing then Vector3.new(6.6, 4.6, 0.2) else Vector3.new(0.2, 4.6, 6.6),
                x,
                -1.5,
                z,
                Color3.fromRGB(118, 156, 157),
                Enum.Material.Glass,
                false
            )
            window.Transparency = 0.48
            if frontFacing then
                for frameY = -3.9, 0.9, 4.8 do
                    referencePart(
                        cabinFolder,
                        "CabinWindowFrame",
                        Vector3.new(7, 0.28, 0.72),
                        x,
                        frameY,
                        z - 0.1,
                        trimColor,
                        Enum.Material.Wood,
                        false
                    )
                end
                referencePart(
                    cabinFolder,
                    "CabinWindowMullion",
                    Vector3.new(0.28, 4.6, 0.72),
                    x,
                    -1.5,
                    z - 0.1,
                    trimColor,
                    Enum.Material.Wood,
                    false
                )
            else
                for frameY = -3.9, 0.9, 4.8 do
                    referencePart(
                        cabinFolder,
                        "CabinWindowFrame",
                        Vector3.new(0.72, 0.28, 7),
                        x,
                        frameY,
                        z,
                        trimColor,
                        Enum.Material.Wood,
                        false
                    )
                end
                referencePart(
                    cabinFolder,
                    "CabinWindowMullion",
                    Vector3.new(0.72, 4.6, 0.28),
                    x,
                    -1.5,
                    z,
                    trimColor,
                    Enum.Material.Wood,
                    false
                )
            end
        end
        buildWindow(7.5, -11.6, true)
        buildWindow(-17.6, -0.5, false)
        buildWindow(17.6, -0.5, false)

        for doorX in { -9.2, -3.2 } do
            referencePart(
                cabinFolder,
                "CabinDoorFrame",
                Vector3.new(0.65, 8.5, 0.7),
                doorX,
                -3,
                -11.7,
                trimColor,
                Enum.Material.Wood,
                false
            )
        end
        referencePart(
            cabinFolder,
            "CabinDoorHeader",
            Vector3.new(6.7, 0.65, 0.7),
            -6.2,
            1.25,
            -11.7,
            trimColor,
            Enum.Material.Wood,
            false
        )
        local hinge = referenceCFrame(-9.0, -3, -11.8)
        local openDoor = part(
            cabinFolder,
            "CabinOpenDoor",
            scaledSize(5.2, 8, 0.6),
            hinge * CFrame.Angles(0, math.rad(68), 0) * CFrame.new(2.6 * scale, 0, 0),
            trimColor,
            Enum.Material.WoodPlanks,
            false
        )
        openDoor.CanQuery = false
        part(
            cabinFolder,
            "CabinDoorBrace",
            scaledSize(4.4, 0.45, 0.24),
            openDoor.CFrame * CFrame.Angles(0, 0, math.rad(28)),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
        local handle = part(
            cabinFolder,
            "CabinDoorHandle",
            scaledSize(0.45, 0.45, 0.45),
            openDoor.CFrame * CFrame.new(1.7 * scale, -0.7 * scale, -0.5 * scale),
            Color3.fromRGB(111, 114, 108),
            Enum.Material.Metal,
            false
        )
        handle.Shape = Enum.PartType.Ball

        for stepIndex = 1, 4 do
            referencePart(
                shell,
                "CabinStep",
                Vector3.new(6, 1, 1 + stepIndex),
                -6,
                -7.5 - stepIndex,
                -12.5 - stepIndex * 0.5,
                Color3.fromRGB(88, 91, 86),
                Enum.Material.Cobblestone
            )
        end

        local fireplace = Instance.new("Model")
        fireplace.Name = "CabinFireplace"
        fireplace.Parent = cabinFolder
        local hearthFallback = Instance.new("Model")
        hearthFallback.Name = "CabinHearthFallback"
        hearthFallback.Parent = fireplace
        local fireplaceParts = {
            { "CabinHearth", 8, 2, 2, -9, -6, 10 },
            { "CabinHearthSide", 1, 7, 1, -12.5, -4.5, 11.5 },
            { "CabinHearthSide", 1, 7, 1, -5.5, -4.5, 11.5 },
            { "CabinHearthLintel", 8, 1, 2, -9, -0.5, 11 },
            { "CabinChimneyBack", 8, 11, 1, -9, -5.5, 14.5 },
            { "CabinChimneySide", 1, 11, 2, -12.5, -5.5, 13 },
            { "CabinChimneySide", 1, 11, 2, -5.5, -5.5, 13 },
            { "CabinChimneyStack", 4, 12, 1, -9, 6, 12.5 },
            { "CabinChimneyStack", 4, 12, 1, -9, 6, 14.5 },
            { "CabinChimneyStack", 1, 12, 1, -10.5, 6, 13.5 },
            { "CabinChimneyStack", 1, 12, 1, -7.5, 6, 13.5 },
            { "CabinChimneyCap", 5, 0.7, 2.2, -9, 12.2, 13.5 },
        }
        for _, spec in fireplaceParts do
            referencePart(
                fireplace,
                spec[1],
                Vector3.new(spec[2], spec[3], spec[4]),
                spec[5],
                spec[6],
                spec[7],
                stoneColor,
                Enum.Material.Cobblestone,
                false
            )
        end
        referencePart(
            fireplace,
            "CabinAshBed",
            Vector3.new(6, 0.5, 3),
            -9,
            -5.5,
            12.5,
            Color3.fromRGB(45, 47, 46),
            Enum.Material.Slate,
            false
        )
        referencePart(
            hearthFallback,
            "CabinBurningWood",
            Vector3.new(4, 0.65, 0.7),
            -9,
            -4.7,
            12.5,
            WET_BARK,
            Enum.Material.Wood,
            false
        )
        local hearthFire = referencePart(
            hearthFallback,
            "CabinHearthFire",
            Vector3.new(0.75, 1.7, 0.7),
            -9,
            -3.55,
            12.2,
            accent,
            Enum.Material.Neon,
            false
        )
        hearthFire.Shape = Enum.PartType.Wedge
        hearthFire.CFrame *= CFrame.Angles(0, math.rad(-18), 0)
        hearthFire.Transparency = 0.08
        local ember = referencePart(
            hearthFallback,
            "CabinHearthEmber",
            Vector3.new(0.48, 1.05, 0.5),
            -8.65,
            -3.85,
            12.05,
            Color3.fromRGB(255, 104, 48),
            Enum.Material.Neon,
            false
        )
        ember.Shape = Enum.PartType.Wedge
        ember.CFrame *= CFrame.Angles(0, math.rad(28), math.rad(-7))
        local hearthLight = Instance.new("PointLight")
        hearthLight.Color = accent
        hearthLight.Brightness = 1.05
        hearthLight.Range = 15
        hearthLight.Shadows = true
        hearthLight.Parent = hearthFire
        CollectionService:AddTag(hearthFire, "LastLightAmbientLight")
        table.insert(meshPlacements, {
            assetId = "mesh_creator_campfire_a",
            fallbackKind = "placeholder",
            position = referenceCFrame(-9, -4.6, 12.2).Position,
            scale = 0.86,
            yaw = yaw,
            seed = if name == "MARA'S SHELTER" then 9311 else 9312,
            swayTag = nil,
            parent = fireplace,
            fallbackInstance = hearthFallback,
        })

        local windowLight = Instance.new("PointLight")
        windowLight.Color = accent
        windowLight.Brightness = 0.55
        windowLight.Range = 15
        windowLight.Shadows = false
        local lightAnchor = part(
            cabinFolder,
            "CabinLight",
            Vector3.new(0.2, 0.2, 0.2),
            cabinCFrame(0, 5.4, 2.8),
            accent,
            Enum.Material.Glass,
            false
        )
        lightAnchor.Transparency = 1
        windowLight.Parent = lightAnchor
        local sign = part(
            cabinFolder,
            "CabinSign",
            Vector3.new(6.4, 1.25, 0.35),
            referenceCFrame(6, 3.3, -12.1),
            WET_BARK,
            Enum.Material.WoodPlanks,
            false
        )
        sign.CanQuery = false
        local surface = Instance.new("SurfaceGui")
        surface.Face = Enum.NormalId.Front
        surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        surface.PixelsPerStud = 28
        surface.Parent = sign
        local signText = Instance.new("TextLabel")
        signText.BackgroundTransparency = 1
        signText.Size = UDim2.fromScale(1, 1)
        signText.Font = Enum.Font.GothamBold
        signText.Text = string.upper(name)
        signText.TextColor3 = accent
        signText.TextScaled = true
        signText.Parent = surface

        if name == "MARA'S SHELTER" then
            local cotFallback = Instance.new("Model")
            cotFallback.Name = "MaraCotFallback"
            cotFallback.Parent = cabinFolder
            local cot = part(
                cotFallback,
                "MaraCot",
                Vector3.new(5.2, 0.55, 2.7),
                cabinCFrame(4.2, 1.0, 3.5),
                Color3.fromRGB(96, 112, 83),
                Enum.Material.Fabric,
                false
            )
            cot.CanQuery = false
            table.insert(meshPlacements, {
                assetId = "mesh_creator_wayfarer_bed_a",
                fallbackKind = "asset_replacement",
                -- MeshTemplateLoader normalizes the model's pivot to the
                -- bottom of its bounding box, so this Y is where the bed's
                -- underside lands, not its centre. 0.62 matches the interior
                -- floor (CabinWovenRug rests with its own bottom at the same
                -- height); -1.75 is the EXTERIOR ground level the barrel and
                -- crate correctly use a few lines below, since those sit
                -- outside the cabin footprint at x = -14.5 / 13.8. Copying
                -- that value here put the bed 2.36 studs under the interior
                -- floor -- fully invisible, since even its own top (0.53)
                -- never reached the floor it was meant to rest on (0.61).
                position = cabinCFrame(4.2, 0.62, 3.5).Position,
                scale = 1,
                -- No offset: the loader cancels the source model's stored
                -- rotation, so the bed's long axis already runs along the
                -- cabin's Z, head toward the back wall.
                yaw = yaw,
                seed = 9831,
                swayTag = nil,
                parent = cabinFolder,
                fallbackInstance = cotFallback,
            })
            local supplyFallback = Instance.new("Model")
            supplyFallback.Name = "MaraSupplyShelfFallback"
            supplyFallback.Parent = cabinFolder
            local tableTop = part(
                supplyFallback,
                "MaraWorkTable",
                Vector3.new(4.2, 0.45, 2.5),
                cabinCFrame(4.5, 2.15, -3.2),
                Color3.fromRGB(89, 64, 43),
                Enum.Material.WoodPlanks,
                false
            )
            tableTop.CanQuery = false
            -- A tabletop needs something holding it up.
            for legX = -1, 1, 2 do
                for legZ = -1, 1, 2 do
                    local leg = part(
                        supplyFallback,
                        "MaraWorkTableLeg",
                        Vector3.new(0.3, 1.7, 0.3),
                        cabinCFrame(4.5 + legX * 1.75, 1.28, -3.2 + legZ * 0.95),
                        Color3.fromRGB(72, 51, 34),
                        Enum.Material.Wood,
                        false
                    )
                    leg.CanQuery = false
                end
            end
            for jarIndex = -1, 1 do
                local jar = part(
                    supplyFallback,
                    "MemoryJar",
                    -- A Roblox Cylinder extends along its LOCAL X axis, so the
                    -- first component is the jar's height and the other two its
                    -- diameter. Sized (0.7, 1.05, 0.7) with no rotation these
                    -- were squat discs lying on their sides, not standing jars.
                    Vector3.new(1.05, 0.7, 0.7),
                    cabinCFrame(4.5 + jarIndex * 1.1, 2.9, -3.2) * CFrame.Angles(0, 0, math.rad(90)),
                    if jarIndex == 0 then FOXFIRE else AMBER,
                    Enum.Material.Glass,
                    false
                )
                jar.Shape = Enum.PartType.Cylinder
                jar.Transparency = 0.22
                jar.CanQuery = false
                local lid = part(
                    supplyFallback,
                    "MemoryJarLid",
                    Vector3.new(0.16, 0.76, 0.76),
                    cabinCFrame(4.5 + jarIndex * 1.1, 3.46, -3.2)
                        * CFrame.Angles(0, 0, math.rad(90)),
                    Color3.fromRGB(72, 51, 34),
                    Enum.Material.Wood,
                    false
                )
                lid.Shape = Enum.PartType.Cylinder
                lid.CanQuery = false
            end
            table.insert(meshPlacements, {
                assetId = "mesh_creator_potion_shelf_a",
                fallbackKind = "asset_replacement",
                position = cabinCFrame(4.5, 0.62, -3.2).Position,
                scale = 1,
                yaw = yaw + math.rad(90),
                seed = 9851,
                swayTag = nil,
                parent = cabinFolder,
                fallbackInstance = supplyFallback,
            })
        else
            for bedIndex = -1, 1, 2 do
                local bedrollFallback = Instance.new("Model")
                bedrollFallback.Name = "WayfarerBedrollFallback"
                bedrollFallback.Parent = cabinFolder
                local bedroll = part(
                    bedrollFallback,
                    "WayfarerBedroll",
                    Vector3.new(4.8, 0.45, 2.3),
                    cabinCFrame(3.5 + bedIndex * 3.6, 0.95, 3.8),
                    if bedIndex < 0
                        then Color3.fromRGB(127, 91, 58)
                        else Color3.fromRGB(72, 104, 82),
                    Enum.Material.Fabric,
                    false
                )
                bedroll.CanQuery = false
                table.insert(meshPlacements, {
                    assetId = "mesh_creator_wayfarer_bed_a",
                    fallbackKind = "asset_replacement",
                    -- Same floor-height correction as Mara's bed above: 0.62
                    -- is the interior floor (WayfarerBedroll's own bottom
                    -- lands at ~0.73, in the same range); -1.75 is the
                    -- exterior ground level the barrel and crate use.
                    position = cabinCFrame(3.5 + bedIndex * 3.6, 0.62, 3.8).Position,
                    scale = 1,
                    yaw = yaw,
                    seed = 9840 + bedIndex,
                    swayTag = nil,
                    parent = cabinFolder,
                    fallbackInstance = bedrollFallback,
                })
            end
            local trunkFallback = Instance.new("Model")
            trunkFallback.Name = "WayfarerTrunkFallback"
            trunkFallback.Parent = cabinFolder
            local trunk = part(
                trunkFallback,
                "WayfarerTrunk",
                Vector3.new(4.4, 2.3, 2.5),
                cabinCFrame(5.2, 1.2, -3.6),
                Color3.fromRGB(88, 61, 39),
                Enum.Material.WoodPlanks,
                false
            )
            trunk.CanQuery = false
            table.insert(meshPlacements, {
                assetId = "mesh_creator_crate_a",
                fallbackKind = "asset_replacement",
                position = cabinCFrame(5.2, 0.62, -3.6).Position,
                scale = 1,
                yaw = yaw + math.rad(12),
                seed = 9861,
                swayTag = nil,
                parent = cabinFolder,
                fallbackInstance = trunkFallback,
            })
        end

        local rug = part(
            cabinFolder,
            "CabinWovenRug",
            Vector3.new(6.4, 0.12, 3.4),
            cabinCFrame(2.5, 0.68, -0.1),
            if name == "MARA'S SHELTER"
                then Color3.fromRGB(70, 112, 102)
                else Color3.fromRGB(132, 88, 54),
            Enum.Material.Fabric,
            false
        )
        rug.CanQuery = false

        local shelf = part(
            cabinFolder,
            "CabinSupplyShelf",
            Vector3.new(4.8, 0.35, 1.15),
            cabinCFrame(4.5, 5.15, 7.5),
            Color3.fromRGB(92, 65, 43),
            Enum.Material.WoodPlanks,
            false
        )
        shelf.CanQuery = false
        for supplyIndex = -1, 1 do
            local supply = part(
                cabinFolder,
                if name == "MARA'S SHELTER" then "MaraHerbBundle" else "WayfarerSupply",
                Vector3.new(0.85, 1.05 + math.abs(supplyIndex) * 0.2, 0.75),
                shelf.CFrame + Vector3.new(supplyIndex * 1.35, 0.7, 0),
                if supplyIndex == 0 then accent else Color3.fromRGB(121, 96, 58),
                if name == "MARA'S SHELTER" then Enum.Material.Grass else Enum.Material.Fabric,
                false
            )
            supply.CanQuery = false
        end

        local stoolSeat = part(
            cabinFolder,
            "CabinStoolSeat",
            Vector3.new(2.1, 0.35, 2.1),
            cabinCFrame(5.2, 1.9, 0.3),
            Color3.fromRGB(91, 64, 42),
            Enum.Material.WoodPlanks,
            false
        )
        stoolSeat.CanQuery = false
        for legX = -1, 1, 2 do
            for legZ = -1, 1, 2 do
                part(
                    cabinFolder,
                    "CabinStoolLeg",
                    Vector3.new(0.28, 1.8, 0.28),
                    stoolSeat.CFrame * CFrame.new(legX * 0.72, -1.0, legZ * 0.72),
                    WET_BARK,
                    Enum.Material.Wood,
                    false
                )
            end
        end

        local woodpile = Instance.new("Model")
        woodpile.Name = "CabinWoodpile"
        woodpile.Parent = cabinFolder
        for logIndex = 1, 5 do
            local row = math.floor((logIndex - 1) / 3)
            part(
                woodpile,
                "SplitFirewood",
                Vector3.new(2.8, 0.65, 0.72),
                cabinCFrame(-14.5, -1.45 + row * 0.62, 2.5 + ((logIndex - 1) % 3) * 0.78)
                    * CFrame.Angles(0, math.rad(4 * logIndex), math.rad((logIndex % 2) * 5)),
                if logIndex % 2 == 0 then BARK else WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
        table.insert(meshPlacements, {
            assetId = "mesh_creator_barrel_a",
            fallbackKind = "asset_replacement",
            position = cabinCFrame(-14.5, -1.75, 4).Position,
            scale = 1,
            yaw = yaw + math.rad(8),
            seed = if name == "MARA'S SHELTER" then 9821 else 9822,
            swayTag = nil,
            parent = cabinFolder,
            fallbackInstance = woodpile,
        })
        table.insert(meshPlacements, {
            assetId = "mesh_creator_crate_a",
            fallbackKind = "asset_dressing",
            position = cabinCFrame(13.8, -1.75, 4.4).Position,
            scale = 0.9,
            yaw = yaw + math.rad(-7),
            seed = if name == "MARA'S SHELTER" then 9823 else 9824,
            swayTag = nil,
            parent = cabinFolder,
            fallbackInstance = nil,
        })
        local physicalParts = 0
        for _, descendant in cabinFolder:GetDescendants() do
            if descendant:IsA("BasePart") then
                physicalParts += 1
            end
        end
        cabinFolder:SetAttribute("ConstructionPattern", "place6_reference_adapted")
        cabinFolder:SetAttribute("PhysicalPartCount", physicalParts)
        cabinFolder:SetAttribute("FacesMainStreet", true)
        cabinFolder:SetAttribute("TownYawDegrees", math.deg(yaw))
        return shell
    end

    local shells = {
        cabin(Vector3.new(-CABIN_X, 0, TOWN_CENTER.Z), math.rad(-90), "WAYFARER CABIN", AMBER),
        cabin(Vector3.new(CABIN_X, 0, TOWN_CENTER.Z), math.rad(90), "MARA'S SHELTER", FOXFIRE),
    }

    local commons = Instance.new("Model")
    commons.Name = "EmberhollowCampCommons"
    commons.Parent = parent
    local commonsCenter = Vector3.new(62, 0, -198)
    local commonsTable = part(
        commons,
        "CampCommonsTable",
        Vector3.new(10.5, 0.55, 3.6),
        CFrame.new(commonsCenter + Vector3.new(0, 2.5, 0)),
        Color3.fromRGB(96, 67, 44),
        Enum.Material.WoodPlanks,
        false
    )
    commonsTable.CanQuery = false
    for side = -1, 1, 2 do
        part(
            commons,
            "CampCommonsBench",
            Vector3.new(10, 0.48, 1.25),
            CFrame.new(commonsCenter + Vector3.new(0, 1.4, side * 3.2)),
            Color3.fromRGB(84, 60, 42),
            Enum.Material.WoodPlanks,
            false
        )
    end
    for legX = -1, 1, 2 do
        for legZ = -1, 1, 2 do
            part(
                commons,
                "CampCommonsTableLeg",
                Vector3.new(0.48, 2.2, 0.48),
                commonsTable.CFrame * CFrame.new(legX * 4.2, -1.28, legZ * 1.15),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
    end
    for supplyIndex = 1, 5 do
        local supply = part(
            commons,
            "CampMealSupply",
            Vector3.new(0.9, 0.7 + (supplyIndex % 2) * 0.35, 0.9),
            commonsTable.CFrame
                * CFrame.new(-3.4 + supplyIndex * 1.4, 0.72, (supplyIndex % 2 - 0.5) * 1.1),
            if supplyIndex % 3 == 0
                then AMBER
                elseif supplyIndex % 2 == 0 then Color3.fromRGB(124, 141, 77)
                else Color3.fromRGB(132, 94, 60),
            if supplyIndex % 3 == 0 then Enum.Material.Glass else Enum.Material.Fabric,
            false
        )
        supply.CanQuery = false
    end
    table.insert(meshPlacements, {
        assetId = "mesh_creator_picnic_table_a",
        fallbackKind = "asset_replacement",
        position = commonsCenter,
        scale = 1.15,
        yaw = math.rad(90),
        seed = 9830,
        swayTag = nil,
        parent = parent,
        fallbackInstance = commons,
    })

    -- The town surface stack, referenced to the walk plane (terrain renders at
    -- the authored y = 0 -- see VOXEL_SURFACE_RISE in TerrainBuilder). Players
    -- and NPCs both stand on terrain, so every skin here must stay thin enough
    -- to read as paving underfoot: courtyard top 0.33, square pad top 0.38,
    -- street foundation top 0.44, street top 0.56, wear top 0.64. The street
    -- tops the courtyard by > 0.2 and the wear strip tops the square pad, so
    -- the critical road stays readable through both -- FoundationIntegration
    -- asserts exactly that. Before this pass the foundation was fully buried
    -- (top -0.02) and the street was coplanar with the courtyard (both 0.33),
    -- which z-fought where they overlapped and erased the road.
    local streetFoundation = part(
        parent,
        "TownMainStreetFoundation",
        Vector3.new(18, 0.34, 206),
        CFrame.new(0, 0.27, -102),
        Color3.fromRGB(38, 41, 39),
        Enum.Material.Slate,
        false
    )
    streetFoundation.CanQuery = false
    local townStreet = part(
        parent,
        "TownMainStreet",
        Vector3.new(15.5, 0.32, 204),
        CFrame.new(0, 0.40, -102),
        Color3.fromRGB(183, 143, 91),
        Enum.Material.Cobblestone,
        false
    )
    townStreet.CanQuery = false
    local streetWear = part(
        parent,
        "TownMainStreetWear",
        Vector3.new(3.8, 0.12, 202),
        CFrame.new(0, 0.58, -102),
        Color3.fromRGB(88, 58, 37),
        Enum.Material.Mud,
        false
    )
    streetWear.CanQuery = false
    for rutSide = -1, 1, 2 do
        local rut = part(
            parent,
            "TownStreetRut",
            Vector3.new(0.68, 0.08, 200),
            CFrame.new(rutSide * 2.4, 0.56, -102),
            Color3.fromRGB(61, 43, 30),
            Enum.Material.Mud,
            false
        )
        rut.CanQuery = false
    end
    clearRoadCorridor(Vector3.new(0, 0, 1), Vector3.new(0, 0, -205), 18)
    queueRoadAssetPlacements(
        meshPlacements,
        parent,
        Vector3.new(0, 0.92, 0),
        Vector3.new(0, 0.92, -204),
        9600
    )
    local function townSideRoad(start: Vector3, finish: Vector3)
        local delta = finish - start
        local frame = CFrame.lookAt((start + finish) / 2, finish)
        clearRoadCorridor(start, finish, 8.6)
        local base = part(
            parent,
            "TownDistrictRoadFoundation",
            Vector3.new(8.6, 0.26, delta.Magnitude + 1.2),
            frame * CFrame.new(0, -0.14, 0),
            Color3.fromRGB(38, 41, 39),
            Enum.Material.Slate,
            false
        )
        base.CanQuery = false
        local surface = part(
            parent,
            "TownDistrictRoad",
            Vector3.new(7.2, 0.24, delta.Magnitude + 0.8),
            frame * CFrame.new(0, -0.01, 0),
            Color3.fromRGB(176, 137, 87),
            Enum.Material.Cobblestone,
            false
        )
        surface.CanQuery = false
        local wear = part(
            parent,
            "TownDistrictRoadWear",
            Vector3.new(2.1, 0.08, delta.Magnitude + 0.5),
            frame * CFrame.new(0, 0.14, 0),
            Color3.fromRGB(79, 52, 34),
            Enum.Material.Mud,
            false
        )
        wear.CanQuery = false
        queueRoadAssetPlacements(
            meshPlacements,
            parent,
            start + Vector3.new(0, -0.62, 0),
            finish + Vector3.new(0, -0.62, 0),
            9700 + #meshPlacements
        )
    end
    -- These two run east and west at depths the plaza now covers. They start at
    -- its edge rather than at x = 0, so a road meets the square instead of
    -- appearing to begin in the middle of it.
    townSideRoad(Vector3.new(-PLAZA_HALF, 0.45, -144), Vector3.new(-80, 0.45, -144))
    townSideRoad(Vector3.new(PLAZA_HALF, 0.45, -126), Vector3.new(80, 0.45, -126))
    townSideRoad(Vector3.new(0, 0.45, -184), Vector3.new(-80, 0.45, -184))
    townSideRoad(Vector3.new(0, 0.45, -164), Vector3.new(80, 0.45, -164))
    townSideRoad(Vector3.new(0, 0.45, -198), Vector3.new(50, 0.45, -198))
    --[[
        A square that reads as a city centre.

        The pad alone read as road-through-grass with a lantern on it. Two
        rotated paving bands make a deliberate concentric plaza around the
        shrine, and a lamp post at each corner frames the space the way the
        watchtowers frame the gate. All visual skins; the walk plane and the
        night-fight arena are unchanged.
    ]]
    for band = 1, 2 do
        local size = PLAZA_HALF * 2 - band * 26
        local paving = part(
            parent,
            "TownSquarePavingBand",
            Vector3.new(size, 0.08, size),
            CFrame.new(courtyard + Vector3.new(0, 0.36 + band * 0.03, 0))
                * CFrame.Angles(0, math.rad(if band == 1 then 45 else 0), 0),
            if band == 1 then Color3.fromRGB(96, 88, 70) else Color3.fromRGB(72, 68, 58),
            Enum.Material.Cobblestone,
            false
        )
        paving.CanQuery = false
    end
    for cornerX = -1, 1, 2 do
        for cornerZ = -1, 1, 2 do
            table.insert(meshPlacements, {
                assetId = "mesh_lantern_post_a",
                fallbackKind = "asset_dressing",
                position = courtyard
                    + Vector3.new(cornerX * (PLAZA_HALF - 7), 0.4, cornerZ * (PLAZA_HALF - 7)),
                scale = 1,
                yaw = math.atan2(-cornerX, -cornerZ),
                seed = 9930 + cornerX * 2 + cornerZ,
                swayTag = nil,
                parent = parent,
                fallbackInstance = nil,
            })
        end
    end
    local square = part(
        parent,
        "FirstLanternTownSquare",
        Vector3.new(PLAZA_HALF * 2, 0.56, PLAZA_HALF * 2),
        -- Top face 0.38: a thin paving skin over the walk plane, not a raised
        -- deck. The pad is non-colliding, so characters stand on the terrain
        -- through it -- at the old 0.52 offset (top 0.80) every player and
        -- resident crossing the civic centre sank shin-deep into the paving.
        CFrame.new(courtyard + Vector3.new(0, 0.10, 0)),
        Color3.fromRGB(83, 64, 44),
        Enum.Material.Ground,
        false
    )
    square.CanQuery = false
    for _, pathSpec in
        {
            -- From the plaza edge out to each cabin door, rather than from
            -- near the lantern: the paths used to start inside what is now
            -- fighting space.
            {
                Vector3.new(-(PLAZA_HALF - 2), 0.44, TOWN_CENTER.Z - 1),
                Vector3.new(-(CABIN_X - 9), 0.44, TOWN_CENTER.Z - 4.5),
            },
            {
                Vector3.new(PLAZA_HALF - 2, 0.44, TOWN_CENTER.Z + 1),
                Vector3.new(CABIN_X - 9, 0.44, TOWN_CENTER.Z + 4.5),
            },
        }
    do
        local start = pathSpec[1]
        local finish = pathSpec[2]
        local delta = finish - start
        local entryPath = part(
            parent,
            "CabinEntryPath",
            Vector3.new(6.5, 0.18, delta.Magnitude + 1),
            CFrame.lookAt((start + finish) / 2, finish),
            Color3.fromRGB(101, 76, 48),
            Enum.Material.Mud,
            false
        )
        entryPath.CanQuery = false
        queueRoadAssetPlacements(meshPlacements, parent, start, finish, 9800 + #meshPlacements)
    end

    for index = 1, 16 do
        local angle = (index / 16) * math.pi * 2
        local xDirection = math.cos(angle)
        local zDirection = math.sin(angle)
        -- Leave four obvious gates: north/south for the main street and
        -- east/west for the cabin paths. These stones are visual edging, not
        -- player collision.
        if math.abs(xDirection) > 0.28 and math.abs(zDirection) > 0.28 then
            local stone = part(
                parent,
                "TownSquareEdgeStone",
                Vector3.new(2.4, 0.75, 1.6),
                CFrame.new(
                    courtyard
                        + Vector3.new(
                            xDirection * (PLAZA_HALF - 2.5),
                            0.44,
                            zDirection * (PLAZA_HALF - 2.5)
                        )
                ) * CFrame.Angles(0.08, angle, 0.12),
                Color3.fromRGB(78, 82, 74),
                Enum.Material.Slate,
                false
            )
            stone.Shape = Enum.PartType.Ball
        end
    end
    -- Benches line the plaza edge instead of standing in the middle of it.
    -- Seating a player could be knocked into during a night fight is furniture
    -- in an arena; seating at the rim is somewhere to watch from.
    local benchX = PLAZA_HALF - 6
    for side = -1, 1, 2 do
        local benchZ = TOWN_CENTER.Z + side * (PLAZA_HALF - 8)
        local bench = part(
            parent,
            "LanternBench",
            Vector3.new(7, 0.7, 1.6),
            CFrame.new(side * benchX, 1.2, benchZ) * CFrame.Angles(0, math.rad(90), 0),
            Color3.fromRGB(91, 65, 45),
            Enum.Material.WoodPlanks
        )
        bench.CanQuery = false
        for leg = -1, 1, 2 do
            local support = part(
                parent,
                "LanternBenchLeg",
                Vector3.new(0.45, 1.2, 1.1),
                CFrame.new(side * benchX, 0.6, benchZ + leg * 2.1),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
            support.CanQuery = false
        end
    end
    local signZ = TOWN_CENTER.Z + COURTYARD_HALF_Z - 4
    local campSign = labelSign(
        parent,
        CFrame.new(0, 3.2, signZ) * CFrame.Angles(0, math.pi, 0),
        "EMBERHOLLOW · SAFE CAMP"
    )
    -- Same reason as the FOLLOW THE LANTERNS sign: the authored forest sign
    -- has its own two-board silhouette, and the surviving SurfaceGui projects
    -- one wide sentence across both boards as clipped fragments.
    campSign:SetAttribute("HideSemanticGuiOnReplacement", true)
    table.insert(meshPlacements, {
        assetId = "mesh_creator_forest_sign_a",
        fallbackKind = "asset_replacement",
        position = Vector3.new(0, 0, signZ),
        scale = 1.2,
        yaw = math.pi,
        seed = 9840,
        swayTag = nil,
        parent = parent,
        fallbackInstance = campSign,
    })
    return shells
end

local function lantern(
    parent: Instance,
    at: Vector3,
    scale: number,
    ambientLightTag: string?
): Model
    local model = Instance.new("Model")
    model.Name = "ProceduralLanternPost"
    model.Parent = parent
    local post = part(
        model,
        "LanternPost",
        Vector3.new(0.8 * scale, 7 * scale, 0.8 * scale),
        CFrame.new(at + Vector3.new(0, 3.5 * scale, 0)),
        BARK,
        Enum.Material.Wood
    )
    local arm = part(
        model,
        "LanternArm",
        Vector3.new(2.2 * scale, 0.34 * scale, 0.34 * scale),
        CFrame.new(at + Vector3.new(0.78 * scale, 6.65 * scale, 0))
            * CFrame.Angles(0, 0, math.rad(-8)),
        WET_BARK,
        Enum.Material.Wood,
        false
    )
    arm.CanQuery = false
    local lanternCenter = at + Vector3.new(1.65 * scale, 5.55 * scale, 0)
    local glass = part(
        model,
        "LanternGlass",
        Vector3.new(1.15 * scale, 1.55 * scale, 1.15 * scale),
        CFrame.new(lanternCenter),
        Color3.fromRGB(202, 156, 84),
        Enum.Material.Glass,
        false
    )
    glass.Transparency = 0.52
    for sideX = -1, 1, 2 do
        for sideZ = -1, 1, 2 do
            part(
                model,
                "LanternCageRail",
                Vector3.new(0.1 * scale, 1.9 * scale, 0.1 * scale),
                CFrame.new(
                    lanternCenter + Vector3.new(sideX * 0.62 * scale, 0, sideZ * 0.62 * scale)
                ) * CFrame.Angles(0, 0, math.rad(sideX * sideZ * 3)),
                Color3.fromRGB(45, 49, 53),
                Enum.Material.Metal,
                false
            )
        end
    end
    for capY = -1, 1, 2 do
        part(
            model,
            if capY < 0 then "LanternCageBase" else "LanternRainCap",
            Vector3.new(1.6 * scale, 0.22 * scale, 1.6 * scale),
            CFrame.new(lanternCenter + Vector3.new(0, capY * 1.02 * scale, 0))
                * CFrame.Angles(0, math.rad(12), 0),
            Color3.fromRGB(45, 49, 53),
            Enum.Material.Metal,
            false
        )
    end
    local glow = part(
        model,
        "LanternFlame",
        Vector3.new(0.48 * scale, 0.88 * scale, 0.42 * scale),
        CFrame.new(lanternCenter + Vector3.new(0, -0.12 * scale, 0))
            * CFrame.Angles(0, math.rad(18), 0),
        AMBER,
        Enum.Material.Neon,
        false
    )
    glow.Shape = Enum.PartType.Wedge
    glow.Transparency = 0.08
    local light = Instance.new("PointLight")
    light.Color = AMBER
    light.Brightness = 1.95
    light.Range = 27 * scale
    -- Keep the sanctuary's key lantern as the only strong shadow source. The
    -- route lights are guidance, not a second sun, which keeps mobile scenes
    -- readable and avoids a wall of competing shadows.
    light.Shadows = false
    light.Parent = glow
    if ambientLightTag ~= nil then
        CollectionService:AddTag(glow, ambientLightTag)
    end
    model.PrimaryPart = post
    return model
end

local function groundPatch(
    parent: Instance,
    position: Vector3,
    size: Vector3,
    color: Color3,
    material: Enum.Material
)
    local patch = part(
        parent,
        "WetGroundPatch",
        size,
        CFrame.new(position + Vector3.new(0, 0.18, 0)) * CFrame.Angles(0, position.X * 0.017, 0),
        color,
        material,
        false
    )
    patch.Transparency = 0.08
    patch.CanQuery = false
    return patch
end

local function emberDrift(
    parent: Instance,
    position: Vector3,
    color: Color3,
    count: number,
    spread: number,
    ambientTag: string?
)
    local random = Random.new(math.floor(position.X * 17 + position.Z * 31))
    for _ = 1, count do
        local mote = part(
            parent,
            "FloatingMote",
            Vector3.new(0.16, 0.16, 0.16),
            CFrame.new(
                position
                    + Vector3.new(
                        random:NextNumber(-spread, spread),
                        random:NextNumber(1.5, 8),
                        random:NextNumber(-spread, spread)
                    )
            ),
            color,
            Enum.Material.Neon,
            false
        )
        mote.Shape = Enum.PartType.Ball
        mote.Transparency = random:NextNumber(0.1, 0.35)
        mote.CanQuery = false
        if ambientTag ~= nil then
            CollectionService:AddTag(mote, ambientTag)
        end
    end
end

local function addFillLight(
    parent: Instance,
    position: Vector3,
    color: Color3,
    brightness: number,
    range: number
)
    local source = part(
        parent,
        "HiddenAtmosphereLight",
        Vector3.new(0.4, 0.4, 0.4),
        CFrame.new(position),
        color,
        Enum.Material.Neon,
        false
    )
    source.Transparency = 1
    source.CanQuery = false
    local light = Instance.new("PointLight")
    light.Color = color
    light.Brightness = brightness
    light.Range = range
    light.Shadows = false
    light.Parent = source
end

local function addBillboard(
    partInstance: BasePart,
    title: string,
    accent: Color3,
    maxDistance: number?
)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "WorldLabel"
    billboard.Adornee = partInstance
    billboard.AlwaysOnTop = false
    billboard.LightInfluence = 0.35
    billboard.Size = UDim2.fromOffset(165, 38)
    -- Labels used to sit ~3.6 studs up, which on a waist-high display put the
    -- card directly over the object it was naming. Sitting them well clear
    -- keeps the prop readable, which is the order the visual standard asks
    -- for: recognize the object first, read the label second.
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 7.4, 0)
    billboard.MaxDistance = maxDistance or 20
    billboard.Parent = partInstance

    local text = Instance.new("TextLabel")
    text.BackgroundColor3 = Color3.fromRGB(16, 25, 23)
    text.BackgroundTransparency = 0.18
    text.BorderSizePixel = 0
    text.Size = UDim2.fromScale(1, 1)
    text.Font = Enum.Font.GothamBold
    text.Text = title
    text.TextColor3 = accent
    text.TextScaled = false
    text.TextSize = 12
    text.TextWrapped = true
    text.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = text
end

local function _addObjectIcon(partInstance: BasePart, kind: string, accent: Color3)
    local existing = partInstance:FindFirstChild("ObjectIcon")
    if existing ~= nil then
        existing:Destroy()
    end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ObjectIcon"
    billboard.Adornee = partInstance
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.Size = UDim2.fromOffset(44, 44)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 5.8, 0)
    billboard.MaxDistance = 72
    billboard.Parent = partInstance

    local glyph = Instance.new("TextLabel")
    glyph.Name = "IconGlyph"
    glyph.BackgroundColor3 = Color3.fromRGB(10, 21, 19)
    glyph.BackgroundTransparency = 0.05
    glyph.BorderSizePixel = 0
    glyph.Size = UDim2.fromScale(1, 1)
    glyph.Font = Enum.Font.GothamBold
    glyph.Text = if kind == "axe"
        then "⚒"
        elseif kind == "hammer" then "✚"
        elseif kind == "torch" or kind == "lantern" then "✦"
        elseif kind == "heartwood" then "◉"
        elseif kind == "barricade" then "▰"
        elseif kind == "satchel" then "▣"
        elseif kind == "charm" then "◆"
        elseif kind == "hood" then "⌂"
        elseif kind == "boots" then "≋"
        else "✦"
    glyph.TextColor3 = accent
    glyph.TextScaled = true
    glyph.ZIndex = 10
    glyph.Parent = billboard
    local glyphCorner = Instance.new("UICorner")
    glyphCorner.CornerRadius = UDim.new(0, 10)
    glyphCorner.Parent = glyph

    local viewport = Instance.new("ViewportFrame")
    viewport.Name = "IconViewport"
    viewport.Size = UDim2.fromScale(1, 1)
    viewport.BackgroundColor3 = Color3.fromRGB(15, 27, 24)
    viewport.BackgroundTransparency = 0.08
    viewport.BorderSizePixel = 0
    viewport.Ambient = Color3.fromRGB(210, 224, 212)
    viewport.LightColor = Color3.fromRGB(255, 214, 146)
    viewport.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = viewport

    local worldModel = Instance.new("WorldModel")
    worldModel.Parent = viewport
    local camera = Instance.new("Camera")
    camera.CFrame = CFrame.new(0, 0.2, 6) * CFrame.Angles(0, math.rad(16), 0)
    camera.FieldOfView = 28
    camera.Parent = viewport
    viewport.CurrentCamera = camera

    local function iconPart(
        name: string,
        size: Vector3,
        position: Vector3,
        color: Color3,
        material: Enum.Material,
        shape: Enum.PartType?
    )
        local icon = Instance.new("Part")
        icon.Name = name
        icon.Anchored = true
        icon.CanCollide = false
        icon.CanQuery = false
        icon.Size = size
        icon.Position = position
        icon.Color = color
        icon.Material = material
        icon.Shape = shape or Enum.PartType.Block
        icon.Parent = worldModel
        return icon
    end

    if kind == "heartwood" then
        iconPart(
            "Trunk",
            Vector3.new(1.5, 2.5, 1.5),
            Vector3.new(0, -0.5, 0),
            BARK,
            Enum.Material.Wood,
            Enum.PartType.Cylinder
        )
        iconPart(
            "Core",
            Vector3.new(1.2, 1.2, 1.2),
            Vector3.new(0, 0.65, 0),
            accent,
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
    elseif kind == "axe" then
        iconPart(
            "Handle",
            Vector3.new(0.25, 2.8, 0.25),
            Vector3.new(0, -0.1, 0),
            BARK,
            Enum.Material.Wood
        )
        iconPart(
            "Blade",
            Vector3.new(1.25, 0.9, 0.22),
            Vector3.new(0.35, 0.85, 0),
            accent,
            Enum.Material.Metal
        )
    elseif kind == "hammer" then
        iconPart(
            "Handle",
            Vector3.new(0.25, 2.6, 0.25),
            Vector3.new(0, -0.1, 0),
            BARK,
            Enum.Material.Wood
        )
        iconPart(
            "Head",
            Vector3.new(1.6, 0.55, 0.55),
            Vector3.new(0, 0.95, 0),
            accent,
            Enum.Material.Metal
        )
    elseif kind == "torch" or kind == "lantern" then
        iconPart(
            "Handle",
            Vector3.new(0.28, 2.1, 0.28),
            Vector3.new(0, -0.45, 0),
            BARK,
            Enum.Material.Wood
        )
        iconPart(
            "Flame",
            Vector3.new(1.2, 1.5, 1.2),
            Vector3.new(0, 0.75, 0),
            accent,
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
    elseif kind == "satchel" then
        iconPart(
            "Bag",
            Vector3.new(2.1, 1.6, 1.2),
            Vector3.new(0, -0.15, 0),
            accent,
            Enum.Material.Fabric
        )
        iconPart(
            "Strap",
            Vector3.new(0.22, 2.2, 0.2),
            Vector3.new(0, 0.15, 0.65),
            BARK,
            Enum.Material.Wood
        )
    elseif kind == "charm" then
        iconPart(
            "Gem",
            Vector3.new(1.35, 1.35, 1.35),
            Vector3.new(0, 0, 0),
            accent,
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
        iconPart(
            "Ring",
            Vector3.new(0.22, 1.9, 1.9),
            Vector3.new(0, 0, 0),
            FOXFIRE,
            Enum.Material.Metal,
            Enum.PartType.Cylinder
        )
    elseif kind == "hood" then
        iconPart(
            "Hood",
            Vector3.new(2.2, 1.7, 1.7),
            Vector3.new(0, 0.1, 0),
            accent,
            Enum.Material.Fabric
        )
        iconPart(
            "Rim",
            Vector3.new(2.5, 0.25, 1.8),
            Vector3.new(0, -0.75, -0.1),
            DARK_GREEN,
            Enum.Material.Wood
        )
    elseif kind == "boots" then
        iconPart(
            "LeftBoot",
            Vector3.new(0.8, 1.45, 1.6),
            Vector3.new(-0.55, -0.2, 0),
            accent,
            Enum.Material.Fabric
        )
        iconPart(
            "RightBoot",
            Vector3.new(0.8, 1.45, 1.6),
            Vector3.new(0.55, -0.2, 0),
            accent,
            Enum.Material.Fabric
        )
    else
        iconPart(
            "Marker",
            Vector3.new(1.4, 1.4, 1.4),
            Vector3.new(0, 0, 0),
            accent,
            Enum.Material.Neon,
            Enum.PartType.Ball
        )
    end
end

function WorldService.new(
    logger: Logger,
    extractionPayoff: any,
    townProgression: any,
    professionAbilityVisuals: any,
    townConstruction: any,
    memoryFragments: any,
    townDecorations: any
): WorldService
    return setmetatable({
        Name = WorldService.Name,
        _logger = logger,
        _extractionPayoff = extractionPayoff,
        _townProgression = townProgression,
        _professionAbilityVisuals = professionAbilityVisuals,
        _memoryFragments = memoryFragments,
        _memoryFragmentTargets = {},
        _runtimeIds = nil,
        _world = nil,
        _interactions = {},
        _spawn = nil,
        _mara = nil,
        _maraTrap = nil,
        _maraStandY = 3,
        _lobby = nil,
        _lobbySpawn = nil,
        _departurePlatform = nil,
        _clickHandler = nil,
        _resourceNodes = {},
        _lantern = nil,
        _lanternVisualHealth = 100,
        _beacon = nil,
        _beaconCore = nil,
        _beaconLens = nil,
        _barricadeBuilt = false,
        _dusk = false,
        _duskSignals = {},
        _nightDefenseSignals = {},
        _nightThemeDressing = nil,
        _breachActive = false,
        _night = false,
        _blackoutLightingActive = false,
        _expeditionEntry = nil,
        _expeditionManifest = nil,
        _expeditionModuleCenters = {},
        _eventSockets = {},
        _eventTargets = {},
        _eventsEnabled = true,
        _oldGrowthArena = nil,
        _wardenStagArena = nil,
        _blackoutArena = nil,
        _characterRoots = {},
        _townConsequence = nil,
        _townConstruction = townConstruction.default(),
        _townConstructionRules = townConstruction,
        _townCondition = { integrity = 100, damageLevel = 0, repairsRemaining = 0 },
        _townResidents = {},
        _buildingPlacements = {},
        _townIncidentModel = nil,
        _engineerBraceModel = nil,
        _meshTemplateLoader = MeshTemplateLoader.new(logger),
        _townDecorationsCatalog = townDecorations,
        _meshPlacements = {},
    }, WorldService)
end

function WorldService._registerInteraction(
    self: WorldService,
    target: BasePart,
    interactionId: string,
    actionId: string,
    actionText: string,
    objectText: string,
    payload: string?,
    holdDuration: number?,
    clickVolume: Vector3?
)
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = interactionId
    prompt.ActionText = actionText
    prompt.ObjectText = objectText
    prompt.HoldDuration = holdDuration or 0
    prompt.MaxActivationDistance = 12
    prompt.RequiresLineOfSight = false
    prompt.Style = Enum.ProximityPromptStyle.Custom
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
    prompt:SetAttribute("InteractionId", interactionId)
    prompt:SetAttribute("ActionId", actionId)
    if payload ~= nil then
        prompt:SetAttribute("Payload", payload)
    end
    prompt.Parent = target

    --[[
        Click or tap the object itself.

        The prompt still works, but requiring the player to walk into range and
        then find the right HUD button made every interaction a two-step
        exercise in button-hunting. A ClickDetector on the same anchor lets the
        object be the control: tap the stump to chop it. The server still
        validates range, stage, and everything else through the same path the
        prompt uses, so this adds a way to ask, not a way to bypass.
    ]]
    --[[
        Click the whole object, not the anchor.

        A ClickDetector only receives clicks if its part answers raycasts, and
        these anchors are the wrong thing to aim at even when they do. They are
        invisible bookkeeping volumes: a tool pedestal is a flat box under a
        display whose axe sits well above it, and the construction plot is an
        18 x 0.5 pancake that a player has almost no chance of hitting. The
        authored meshes cannot take the clicks themselves, because the loader
        makes every mesh part non-queryable so meshes never block the camera.

        So each interaction gets a generous invisible volume covering the space
        the object actually occupies, sized from the anchor and extended upward
        to reach whatever stands on it. Call sites can override it for anything
        unusually shaped.

        None of this grants anything: _interact still checks the prompt is
        enabled and the player is in range, the same guards the keyboard path
        uses. A bigger target only makes the ask easier to make.
    ]]
    target.CanQuery = true

    local function bindClick(surface: BasePart)
        local click = Instance.new("ClickDetector")
        click.Name = "InteractClick"
        click.MaxActivationDistance = prompt.MaxActivationDistance
        click.CursorIcon = ""
        click.Parent = surface
        click.MouseClick:Connect(function(clicker: Player)
            local handler = self._clickHandler
            if handler ~= nil then
                handler(clicker, interactionId)
            end
        end)
    end
    bindClick(target)

    local anchorSize = target.Size
    local volume = clickVolume
        or Vector3.new(
            math.max(anchorSize.X * 1.35, 10),
            math.max(anchorSize.Y, 11),
            math.max(anchorSize.Z * 1.35, 10)
        )
    local clickPart = Instance.new("Part")
    clickPart.Name = interactionId .. "_ClickVolume"
    clickPart.Size = volume
    -- Sit the volume on the anchor and grow upward, which is where the visible
    -- object is: displays stand on pedestals, meshes stand on their anchors.
    clickPart.CFrame = target.CFrame * CFrame.new(0, volume.Y / 2 - anchorSize.Y / 2, 0)
    clickPart.Anchored = true
    clickPart.CanCollide = false
    clickPart.CanTouch = false
    clickPart.CanQuery = true
    clickPart.CastShadow = false
    clickPart.Transparency = 1
    clickPart.Parent = target
    bindClick(clickPart)
    CollectionService:AddTag(prompt, self._runtimeIds.InteractionTag)
    self._interactions[interactionId] = prompt
end

function WorldService._configureLighting(_self: WorldService)
    -- 10.2, not 6.65: with GeographicLatitude 51 a 6.65 clock keeps the sun
    -- at dawn height for the entire day phase, so "DAY · 11:51" rendered as
    -- murky dusk on the owner's tablet. Mid-morning sun lights the ground
    -- and still throws real shadows. Duplicated in _applyTownLighting's day
    -- branch; change both together.
    Lighting.ClockTime = 10.2
    Lighting.Brightness = 2.05
    Lighting.Ambient = DAY_AMBIENT
    -- Raised from (72, 91, 84) alongside DAY_AMBIENT and ExposureCompensation
    -- below -- see the DAY_AMBIENT comment. Also duplicated in
    -- _applyTownLighting's day branch; change both together.
    Lighting.OutdoorAmbient = Color3.fromRGB(108, 122, 114)
    Lighting.EnvironmentDiffuseScale = 0.9
    Lighting.EnvironmentSpecularScale = 0.48
    Lighting.GlobalShadows = true
    -- Raised (less negative) from -0.18 for the same reason as DAY_AMBIENT.
    -- Also duplicated in _applyTownLighting's day branch.
    Lighting.ExposureCompensation = -0.08
    pcall(function()
        Lighting.ShadowSoftness = 0.65
        Lighting.GeographicLatitude = 51
    end)
    for _, name in
        {
            "LastLightAtmosphere",
            "LastLightBloom",
            "LastLightRays",
            "LastLightTone",
            "LastLightDepth",
        }
    do
        local existing = Lighting:FindFirstChild(name)
        if existing ~= nil then
            existing:Destroy()
        end
    end
    local existingClouds = Workspace.Terrain:FindFirstChild("LastLightClouds")
    if existingClouds ~= nil then
        existingClouds:Destroy()
    end

    -- Distant terrain peaks (TerrainBuilder reaches WORLD_EXTENT = 1450 studs)
    -- were reported washing out to a pale white smear instead of reading as a
    -- ridgeline. Atmosphere applies aerial perspective: with Haze and Glare
    -- above 0, the distant hue transitions from Atmosphere.Color toward
    -- Atmosphere.Decay as fog accumulates with distance. There is no sightline
    -- in the supplied Place6 reference (a small enclosed camp) anywhere near
    -- 1450 studs to have exposed this: its own Atmosphere -- Density 0.225,
    -- Haze 1, Color (199, 199, 199) -- is close to Roblox's stock defaults and
    -- was never tested at range either.
    --
    -- Some fade-to-fog at that distance is correct and even desirable -- it is
    -- what makes far terrain read as *distant*. The bug is the fade targets:
    -- Color (166, 185, 174) and Decay (43, 63, 61) both sat pale/washed rather
    -- than a readable rock tone, so anything far enough to have faded toward
    -- them read as near-white. Both are now a darker, more saturated
    -- slate-blue, which keeps the same falloff behavior but fades distant
    -- peaks toward a moody ridgeline silhouette instead of a blown-out white
    -- one -- consistent with the style formula's "slate blue-gray stone" and
    -- "moon cyan: distance" anchors. Density and Haze are also both eased back
    -- so full fade happens further out, giving mid-distance terrain more room
    -- to read as rock before it starts blending away.
    --
    -- These daytime values are duplicated in _applyTownLighting's `else`
    -- branch, which re-runs this same Atmosphere on every day/dusk transition
    -- and overwrites whatever is set here. Change both together or the fix
    -- reverts the moment a day/night cycle turns over.
    local atmosphere = Instance.new("Atmosphere")
    atmosphere.Name = "LastLightAtmosphere"
    atmosphere.Color = Color3.fromRGB(74, 89, 98)
    atmosphere.Decay = Color3.fromRGB(38, 52, 58)
    atmosphere.Density = 0.24
    atmosphere.Offset = 0.08
    atmosphere.Glare = 0.15
    atmosphere.Haze = 1.0
    atmosphere.Parent = Lighting

    local bloom = Instance.new("BloomEffect")
    bloom.Name = "LastLightBloom"
    -- Raised off 0.82 because Future lighting pushed every Neon part over it.
    -- Lantern flames and harvest glows were blooming into flat discs that hid
    -- the object underneath, which is the opposite of what marking it is for.
    bloom.Intensity = 0.22
    bloom.Size = 38
    bloom.Threshold = 1.08
    bloom.Parent = Lighting

    local rays = Instance.new("SunRaysEffect")
    rays.Name = "LastLightRays"
    rays.Intensity = 0.14
    rays.Spread = 0.72
    rays.Parent = Lighting

    local tone = Instance.new("ColorCorrectionEffect")
    tone.Name = "LastLightTone"
    tone.Brightness = -0.03
    -- Lowered from 0.24 -- contrast pushes shadow values toward black on top
    -- of the already-low ambient floor; also duplicated in
    -- _applyTownLighting's day branch.
    tone.Contrast = 0.18
    tone.Saturation = -0.04
    tone.TintColor = Color3.fromRGB(232, 238, 224)
    tone.Parent = Lighting

    local depth = Instance.new("DepthOfFieldEffect")
    depth.Name = "LastLightDepth"
    depth.FarIntensity = 0.28
    depth.FocusDistance = 95
    depth.InFocusRadius = 70
    depth.NearIntensity = 0.04
    depth.Parent = Lighting

    local clouds = Instance.new("Clouds")
    clouds.Name = "LastLightClouds"
    clouds.Color = Color3.fromRGB(118, 137, 132)
    clouds.Cover = 0.68
    clouds.Density = 0.58
    clouds.Parent = Workspace.Terrain
end

--[[
    Depth bands for the generated forest: near framing, regional mid-ground,
    distant silhouette. Density falls with distance because far trees only
    contribute silhouette, and spending parts on them is what pushes a mobile
    device over budget.
]]
local FOREST_BANDS = table.freeze({
    table.freeze({ inner = 64, outer = 168, count = 74, minScale = 0.85, maxScale = 1.5 }),
    table.freeze({ inner = 168, outer = 340, count = 86, minScale = 1.1, maxScale = 1.9 }),
    table.freeze({ inner = 340, outer = 620, count = 64, minScale = 1.5, maxScale = 2.6 }),
})

-- Trees are never planted inside this corridor around the walkable route.
local ROUTE_HALF_WIDTH = 26

--[[
    Authored structures the forest must not grow into, as {x, z, radius}.

    A corridor test alone is not enough: it only protects the walkable route,
    so band 1 (radius 64-168) could still drop a collidable trunk through the
    workshop roof, onto a mastery dais, or across a crafting bench, all of
    which sit outside the corridor. Radii are sized for a canopy rather than a
    trunk, because the visible problem is a tree overhanging a building, not
    just its base intersecting one.
]]
local FOLIAGE_KEEP_OUT = table.freeze({
    table.freeze({ x = 0, z = 62, radius = 52 }), -- the departure lodge and its clearing
    table.freeze({ x = -68, z = -80, radius = 30 }), -- Wayfarer cabin lot
    table.freeze({ x = 68, z = -80, radius = 30 }), -- Mara's shelter lot
    table.freeze({ x = 0, z = -80, radius = 56 }), -- lantern square
    table.freeze({ x = -42, z = -142, radius = 32 }), -- western workshop district
    table.freeze({ x = 42, z = -142, radius = 32 }), -- eastern workshop district
    table.freeze({ x = -78, z = -76, radius = 22 }), -- Scout mastery clearing
    table.freeze({ x = 78, z = -76, radius = 22 }), -- Warden mastery clearing
    table.freeze({ x = -78, z = -168, radius = 22 }), -- Engineer mastery clearing
    table.freeze({ x = 78, z = -168, radius = 22 }), -- Medic mastery clearing
    table.freeze({ x = -92, z = -184, radius = 25 }), -- Wayfarer inn
    table.freeze({ x = 96, z = -164, radius = 26 }), -- Greenward garden
    table.freeze({ x = 62, z = -198, radius = 18 }), -- camp commons
    table.freeze({ x = -92, z = -144, radius = 22 }), -- archive district
    table.freeze({ x = 92, z = -126, radius = 22 }), -- workbench district
    table.freeze({ x = 0, z = -158, radius = 16 }), -- town board turnout
    table.freeze({ x = -20, z = -132, radius = 10 }), -- field-book archive
    table.freeze({ x = 38, z = -48, radius = 12 }), -- Heartwood gathering lot
    table.freeze({ x = -42, z = -68, radius = 18 }), -- starter-tool yard
    table.freeze({ x = -44, z = -92, radius = 16 }), -- barricade work lot
    table.freeze({ x = 0, z = -143, radius = 26 }), -- night watch posts
    table.freeze({ x = 78, z = -42, radius = 22 }), -- authored root arch landmark
    table.freeze({ x = -78, z = -44, radius = 24 }), -- hollow lantern shrine landmark

    -- The eleven Milestone 4 buildings. Radii are each building's footprint
    -- half-width plus clearance, matching the margin the layout was computed
    -- against rather than a round number.
    table.freeze({ x = 0, z = -226, radius = 20 }), -- celebration stage
    table.freeze({ x = 150, z = -100, radius = 21 }), -- sawmill
    table.freeze({ x = 150, z = -140, radius = 17 }), -- union forge
    table.freeze({ x = 150, z = -180, radius = 18 }), -- engineer yard
    table.freeze({ x = -150, z = -158, radius = 18 }), -- common kitchen
    table.freeze({ x = -150, z = -196, radius = 20 }), -- hearthmarket stalls
    table.freeze({ x = -150, z = -232, radius = 14 }), -- trade post
    table.freeze({ x = 110, z = -212, radius = 16 }), -- waterworks
    table.freeze({ x = -70, z = -262, radius = 14 }), -- guardhouse
    table.freeze({ x = 70, z = -262, radius = 10 }), -- watchtower
    table.freeze({ x = 0, z = -270, radius = 14 }), -- trapworks
})

local TOWN_SIDE_ROAD_BOUNDS = table.freeze({
    table.freeze({ minX = -84, maxX = 4, minZ = -149, maxZ = -139 }),
    table.freeze({ minX = -4, maxX = 84, minZ = -131, maxZ = -121 }),
    table.freeze({ minX = -84, maxX = 4, minZ = -189, maxZ = -179 }),
    table.freeze({ minX = -4, maxX = 84, minZ = -169, maxZ = -159 }),
    table.freeze({ minX = -4, maxX = 54, minZ = -203, maxZ = -193 }),
})

--[[
    True when a position is clear of the route corridor and every authored
    structure, so foliage may be planted there.
]]
local function isFoliagePlantable(x: number, z: number): boolean
    if math.abs(x) <= ROUTE_HALF_WIDTH and z <= 20 and z >= -200 then
        return false
    end

    for _, bounds in TOWN_SIDE_ROAD_BOUNDS do
        if x >= bounds.minX and x <= bounds.maxX and z >= bounds.minZ and z <= bounds.maxZ then
            return false
        end
    end

    for _, keepOut in FOLIAGE_KEEP_OUT do
        local dx = x - keepOut.x
        local dz = z - keepOut.z
        if dx * dx + dz * dz < keepOut.radius * keepOut.radius then
            return false
        end
    end

    return true
end

--[[
    Plants one depth band of the forest.

    Each band owns a Random seeded from its own index rather than sharing one
    sequential generator. That is what lets band 1 be planted before the world
    is ready and bands 2-3 afterwards without changing what either produces: a
    shared generator would make every tree depend on how much of the rest of
    the build had already consumed from it, so deferring a band would silently
    reshape the whole forest -- and the firefly loop draws from the same
    generator, so it would have reshaped it differently depending on timing.
]]
local function plantForestBand(
    forest: Instance,
    bandIndex: number,
    swayTag: string?,
    meshPlacements: { MeshPlacement }?
)
    local band = FOREST_BANDS[bandIndex]
    local random = Random.new(1847 + bandIndex * 7919)
    local treeSeed = 4100 + bandIndex * 1000

    for _ = 1, band.count do
        local angle = random:NextNumber(0, math.pi * 2)
        local radius = random:NextNumber(band.inner, band.outer)
        local x = math.cos(angle) * radius
        local z = math.sin(angle) * radius - 70

        if isFoliagePlantable(x, z) then
            -- Sit the trunk on the real surface. Bands 2 and 3 reach 340 and
            -- 620 studs, well past the flat bowl, where the ground rises by up
            -- to ~90 studs; planting at a hardcoded y = 0 buried exactly the
            -- depth layers this scatter exists to create.
            local position = Vector3.new(x, TerrainBuilder.surfaceHeight(x, z), z)
            treeSeed += 1
            local scale = random:NextNumber(band.minScale, band.maxScale)
            local roll = random:NextNumber()

            if roll < 0.62 then
                if bandIndex == 1 and meshPlacements ~= nil and treeSeed % 3 == 0 then
                    table.insert(meshPlacements, {
                        assetId = if treeSeed % 2 == 0
                            then "mesh_conifer_hero_a"
                            else "mesh_conifer_hero_b",
                        fallbackKind = "conifer",
                        position = position,
                        scale = scale,
                        yaw = random:NextNumber(0, math.pi * 2),
                        seed = treeSeed,
                        swayTag = swayTag,
                    })
                else
                    FoliageBuilder.conifer(forest, position, scale, FOLIAGE_TONE, treeSeed, swayTag)
                end
            elseif roll < 0.9 then
                if bandIndex == 1 and meshPlacements ~= nil and treeSeed % 3 == 0 then
                    table.insert(meshPlacements, {
                        assetId = "mesh_broadleaf_hero_a",
                        fallbackKind = "broadleaf",
                        position = position,
                        scale = scale,
                        yaw = random:NextNumber(0, math.pi * 2),
                        seed = treeSeed,
                        swayTag = swayTag,
                    })
                else
                    FoliageBuilder.broadleaf(
                        forest,
                        position,
                        scale,
                        FOLIAGE_TONE,
                        treeSeed,
                        swayTag
                    )
                end
            else
                FoliageBuilder.snag(forest, position, scale, FOLIAGE_TONE, treeSeed)
            end

            -- Ground detail only in the near band, where the camera can
            -- actually resolve it.
            if bandIndex == 1 then
                if treeSeed % 3 == 0 then
                    local boulderPosition = position
                        + Vector3.new(random:NextNumber(-12, 12), 0, random:NextNumber(-12, 12))
                    local boulderScale = random:NextNumber(0.7, 1.5)
                    if meshPlacements ~= nil and treeSeed % 2 == 0 then
                        table.insert(meshPlacements, {
                            assetId = "mesh_boulder_cluster_a",
                            fallbackKind = "boulders",
                            position = boulderPosition,
                            scale = boulderScale,
                            yaw = random:NextNumber(0, math.pi * 2),
                            seed = treeSeed,
                            swayTag = nil,
                        })
                    else
                        FoliageBuilder.boulders(
                            forest,
                            boulderPosition,
                            boulderScale,
                            FOLIAGE_TONE,
                            treeSeed
                        )
                    end
                end
                if treeSeed % 4 == 0 then
                    local fernPosition = position
                        + Vector3.new(random:NextNumber(-9, 9), 0, random:NextNumber(-9, 9))
                    local fernScale = random:NextNumber(0.8, 1.5)
                    if meshPlacements ~= nil and treeSeed % 8 == 0 then
                        table.insert(meshPlacements, {
                            assetId = "mesh_fern_cluster_a",
                            fallbackKind = "undergrowth",
                            position = fernPosition,
                            scale = fernScale,
                            yaw = random:NextNumber(0, math.pi * 2),
                            seed = treeSeed,
                            swayTag = swayTag,
                        })
                    else
                        FoliageBuilder.undergrowth(
                            forest,
                            fernPosition,
                            fernScale,
                            FOLIAGE_TONE,
                            treeSeed,
                            swayTag
                        )
                    end
                end
                if treeSeed % 11 == 0 then
                    local deadfallPosition = position
                        + Vector3.new(random:NextNumber(-10, 10), 0, random:NextNumber(-10, 10))
                    local deadfallScale = random:NextNumber(0.7, 1.3)
                    if meshPlacements ~= nil then
                        table.insert(meshPlacements, {
                            assetId = "mesh_deadfall_a",
                            fallbackKind = "deadfall",
                            position = deadfallPosition,
                            scale = deadfallScale,
                            yaw = random:NextNumber(0, math.pi * 2),
                            seed = treeSeed,
                            swayTag = nil,
                        })
                    else
                        FoliageBuilder.deadfall(
                            forest,
                            deadfallPosition,
                            deadfallScale,
                            FOLIAGE_TONE,
                            treeSeed
                        )
                    end
                end
            end
        end
    end
end

function WorldService._buildEnvironment(_self: WorldService, world: Model)
    local geometry = Instance.new("Folder")
    geometry.Name = "Environment"
    geometry.Parent = world

    -- Real sculpted Terrain instead of a 320 x 6 x 340 Part. The valley floor
    -- every authored coordinate below sits on stays flat at y = 0; all relief
    -- happens outside it. See TerrainBuilder for why that split matters.
    --
    -- Core only: this runs before ArrivalSpawn exists and before the world is
    -- marked ready, so it covers the ground a player can stand on and stops
    -- there. The horizon is filled in by _buildDistantScenery once joining is
    -- unblocked.
    TerrainBuilder.buildCore()

    groundPatch(
        geometry,
        Vector3.new(0, 0, -70),
        Vector3.new(96, 0.28, 180),
        Color3.fromRGB(43, 63, 45),
        Enum.Material.LeafyGrass
    )
    --[[
        There used to be a "LowMorningMist" here: a 190 x 250 stud Glass slab
        floating at y = 2.3 over the whole first playable area.

        Glass is not a fog material. It renders a refractive pane no matter
        what Transparency says, so the slab did not read as mist -- it tinted
        every road stone, every patch of grass, and every building in the
        starting town a flat cyan-green, and it ended in a hard rectangular
        seam along x = +-95 and z = -211 where the washed ground met ordinary
        grass. It also never turned off: nothing ever toggled it, so a thing
        named "morning" mist sat over the town at dusk and through the night.

        Aerial perspective is already handled properly, by LastLightAtmosphere
        below, whose Density and Haze are eased per phase. That is the system
        that owns haze here; the slab was a second, cruder one fighting it.
    ]]
    local route = {
        -- Extend behind ArrivalSpawn so the opening camera visibly starts on
        -- the route instead of looking across an unbroken foreground of grass.
        Vector3.new(0, 0.42, 18),
        Vector3.new(0, 0.42, 0),
        Vector3.new(-3, 0.42, -28),
        Vector3.new(20, 0.42, -48),
        Vector3.new(0, 0.42, -68),
        Vector3.new(-20, 0.42, -88),
        Vector3.new(0, 0.42, TOWN_CENTER.Z),
        Vector3.new(0, 0.42, -148),
    }
    local arrivalRoadAssetPlacements: { MeshPlacement } = {}

    for segment = 1, #route - 1 do
        local start = route[segment]
        local finish = route[segment + 1]
        local delta = finish - start
        local distance = delta.Magnitude
        local midpoint = (start + finish) / 2
        local roadFrame = CFrame.lookAt(midpoint, finish)
        clearRoadCorridor(start, finish, 17.2)
        local foundation = part(
            geometry,
            "EmberhollowRoadFoundation",
            Vector3.new(17.2, 0.28, distance + 4),
            roadFrame * CFrame.new(0, -0.31, 0),
            Color3.fromRGB(38, 41, 39),
            Enum.Material.Slate,
            false
        )
        foundation.CanQuery = false
        local trail = part(
            geometry,
            "EmberhollowRoad",
            Vector3.new(15.2, 0.36, distance + 3.6),
            -- The whole road stack used to be lifted about two studs, because
            -- the voxel-rendered valley surface was occluding the authored y=0
            -- plane and this was diagnosed as a road problem. It was a datum
            -- problem: see VOXEL_SURFACE_RISE in TerrainBuilder. The terrain
            -- now renders on the authored plane, so the compensation is gone
            -- and these offsets are back to describing the layer stack alone.
            roadFrame * CFrame.new(0, -0.23, 0),
            Color3.fromRGB(190, 149, 94),
            Enum.Material.Cobblestone,
            false
        )
        trail.CanQuery = false
        trail.Reflectance = 0.02
        local wornCenter = part(
            geometry,
            "EmberhollowRoadWear",
            Vector3.new(3.6, 0.12, distance + 2.8),
            roadFrame * CFrame.new(0, 0.05, 0),
            Color3.fromRGB(78, 51, 33),
            Enum.Material.Mud,
            false
        )
        wornCenter.CanQuery = false

        -- A continuous dark shoulder on both sides makes the path silhouette
        -- survive fog, grass texture, and the low morning camera angle. Sparse
        -- edge stones alone disappeared into the meadow between placements.
        for shoulderSide = -1, 1, 2 do
            local shoulder = part(
                geometry,
                "RoadShoulder",
                Vector3.new(1.15, 0.3, distance + 3.2),
                roadFrame * CFrame.new(shoulderSide * 7.45, -0.17, 0),
                Color3.fromRGB(57, 62, 59),
                Enum.Material.Slate,
                false
            )
            shoulder.CanQuery = false
        end

        for rutSide = -1, 1, 2 do
            local rut = part(
                geometry,
                "RoadRut",
                Vector3.new(0.62, 0.08, distance + 1),
                roadFrame * CFrame.new(rutSide * 2.25, 0.14, 0),
                Color3.fromRGB(57, 40, 28),
                Enum.Material.Mud,
                false
            )
            rut.CanQuery = false
        end

        local markerCount = math.max(2, math.floor(distance / 8))
        for marker = 0, markerCount do
            local along = -distance * 0.5 + distance * marker / markerCount
            for side = -1, 1, 2 do
                local edgeStone = part(
                    geometry,
                    "RoadEdgeStone",
                    Vector3.new(1.3, 0.62, 1.75),
                    roadFrame
                        * CFrame.new(side * 7.85, 0.13, along)
                        * CFrame.Angles(0, math.rad(side * (marker % 2) * 7), 0),
                    if marker % 3 == 0
                        then Color3.fromRGB(132, 124, 101)
                        else Color3.fromRGB(84, 94, 89),
                    Enum.Material.Slate,
                    false
                )
                edgeStone.CanQuery = false
            end
        end
        -- Glowing waymarkers down the road centre. The route already has
        -- lantern posts and chevrons, but nothing that reads as "this way" at
        -- a glance in the dark, so the road can be underfoot and still not
        -- answer where to go next. These are foxfire inlays set into the worn
        -- centre, pointing along travel direction and brightening toward the
        -- destination so the trail has a readable gradient rather than a flat
        -- dotted line. Semantic, not decorative: they mark the critical route
        -- only, never the side spurs.
        local guideCount = math.max(2, math.floor(distance / 8))
        -- Half-open [start, finish): the finish of one segment is the start of
        -- the next, so an inclusive loop stacks two wedges and two PointLights
        -- on the exact same spot at every bend, with different headings. That
        -- reads as crossed, z-fighting arrows and a double-bright junction
        -- rather than one continuous trail.
        for guide = 0, guideCount - 1 do
            local along = -distance * 0.5 + distance * guide / guideCount
            local progress = (segment - 1 + guide / guideCount) / (#route - 1)
            local wedge = part(
                geometry,
                "RouteGuideMarker",
                Vector3.new(1.9, 0.12, 2.65),
                -- The route frame sits at Y = 0.42 and the worn road surface
                -- tops out at 0.91, so this offset puts the wedge's underside
                -- at 0.89 -- inlaid into the road. At 0.94 it floated a full
                -- 0.4 studs above the surface and pulsed in mid-air.
                roadFrame * CFrame.new(0, 0.15, along) * CFrame.Angles(0, math.pi, 0),
                FOXFIRE,
                Enum.Material.Neon,
                false
            )
            wedge.Shape = Enum.PartType.Wedge
            wedge.Transparency = 0.34 - progress * 0.16
            wedge.CastShadow = false
            wedge.CanQuery = false
            --[[
                Foxfire inlays are the only thing that says "this way" in the
                dark, and they should own the night. In daylight they had
                nothing to compete with and read as saturated cyan rectangles
                lying on the paving -- the ambient light level floors at 0.58,
                so the existing breathing never dimmed them meaningfully.
                This asks the ambient controller for a real daytime fade, so
                the road leads with its own worn surface by day and the
                foxfire takes over as the light goes.
            ]]
            wedge:SetAttribute("DaylightFade", 0.62)
            CollectionService:AddTag(wedge, _self._runtimeIds.AmbientLightTag)
            local guideLight = Instance.new("PointLight")
            guideLight.Color = FOXFIRE
            guideLight.Brightness = 0.5 + progress * 0.45
            guideLight.Range = 11
            guideLight.Shadows = false
            guideLight.Parent = wedge
        end
        queueRoadAssetPlacements(
            arrivalRoadAssetPlacements,
            geometry,
            start,
            finish,
            9400 + segment * 20
        )
    end

    local function tutorialSpur(start: Vector3, finish: Vector3)
        local delta = finish - start
        local spur = part(
            geometry,
            "TutorialSpurPath",
            Vector3.new(6, 0.16, delta.Magnitude + 1),
            CFrame.lookAt((start + finish) / 2, finish),
            Color3.fromRGB(105, 75, 44),
            Enum.Material.Mud,
            false
        )
        spur.CanQuery = false
    end
    tutorialSpur(Vector3.new(28, 0.42, -48), Vector3.new(34, 0.42, -48))
    tutorialSpur(Vector3.new(-8, 0.42, -68), Vector3.new(-38, 0.42, -68))
    tutorialSpur(Vector3.new(-27, 0.42, -89), Vector3.new(-39, 0.42, -92))

    -- The forest. Previously 92 identical conifers packed into a 54-154 stud
    -- ring, which is why the valley read as a yard with a hedge around it: the
    -- treeline sat almost on top of the route and there was nothing past it.
    --
    -- Now the scatter runs to 620 studs in three depth bands, which is the
    -- layering the art direction asks every background to have -- near framing,
    -- regional mid-ground, distant silhouette. StreamingTargetRadius is 1024,
    -- so the far band streams in and out rather than loading at join.
    local forest = Instance.new("Folder")
    forest.Name = "Forest"
    forest.Parent = geometry

    local random = Random.new(1847)
    local swayTag = _self._runtimeIds.AmbientSwayTag

    --[[
        The root arch that used to stand at (78, -42) is gone. It was a 25-stud
        grey stone arch alone in open grass east of the arrival road, framing
        nothing and part of no district -- and with the square moved north to
        TOWN_CENTER it would have sat just off the new arena's north-east
        corner, reading as clutter beside the fight rather than as a landmark
        on the approach. Removed at owner request.

        mesh_root_arch_a stays registered in MeshAssetRegistry and is still
        placed twice inside Bramblewake by BramblewakeBuilder, where an arch
        over a forest trail is doing real work. This is the same
        reviewed-but-unplaced-here status the retired wood arch has.
    ]]
    _self._meshPlacements = {
        {
            assetId = "mesh_hollow_lantern_shrine_a",
            fallbackKind = "hollow_shrine",
            position = Vector3.new(-78, TerrainBuilder.surfaceHeight(-78, -44), -44),
            scale = 1,
            yaw = math.rad(22),
            seed = 9148,
            swayTag = nil,
        },
    }
    for _, placement in arrivalRoadAssetPlacements do
        table.insert(_self._meshPlacements, placement)
    end

    -- Only the near band is planted here. Bands 2 and 3 are scenery beyond the
    -- immediate clearing and are planted after the world is marked ready; see
    -- _buildDistantScenery.
    plantForestBand(forest, 1, swayTag, _self._meshPlacements)

    for _ = 1, 34 do
        local glow = part(
            geometry,
            "Firefly",
            Vector3.new(0.18, 0.18, 0.18),
            CFrame.new(
                random:NextNumber(-52, 52),
                random:NextNumber(2, 12),
                random:NextNumber(-142, -8)
            ),
            if random:NextInteger(1, 4) == 1 then FOXFIRE else AMBER,
            Enum.Material.Neon,
            false
        )
        glow.Shape = Enum.PartType.Ball
        glow.Transparency = random:NextNumber(0.02, 0.28)
        glow.CanQuery = false
        CollectionService:AddTag(glow, _self._runtimeIds.AmbientMoteTag)
    end

    -- Near-field ground detail just outside the route, where the camera is
    -- close enough for it to register.
    for index = 1, 24 do
        local angle = (index / 24) * math.pi * 2
        local radius = 48 + (index % 4) * 8
        local x = math.cos(angle) * radius
        local z = math.sin(angle) * radius - 70

        -- Same keep-out test the tree bands use. This ring sits at radius
        -- 48-72, so without it indices land directly on the lantern trail.
        if isFoliagePlantable(x, z) then
            local position = Vector3.new(x, TerrainBuilder.surfaceHeight(x, z), z)
            FoliageBuilder.boulders(
                forest,
                position,
                0.6 + (index % 5) * 0.16,
                FOLIAGE_TONE,
                8300 + index
            )
            if index % 2 == 0 then
                FoliageBuilder.undergrowth(
                    forest,
                    position + Vector3.new(3, 0, -2),
                    0.9,
                    FOLIAGE_TONE,
                    8400 + index,
                    _self._runtimeIds.AmbientSwayTag
                )
            end
        end
    end

    addFillLight(geometry, Vector3.new(-46, 12, -96), Color3.fromRGB(54, 103, 95), 0.85, 78)
    addFillLight(geometry, Vector3.new(38, 10, -28), Color3.fromRGB(255, 177, 88), 0.45, 54)
    emberDrift(geometry, TOWN_CENTER, AMBER, 16, 28, _self._runtimeIds.AmbientMoteTag)

    local lanternSpecs = {
        { position = Vector3.new(7, 0, -9), scale = 0.68, yaw = math.rad(-18) },
        { position = Vector3.new(-10, 0, -28), scale = 0.62, yaw = math.rad(14) },
        { position = Vector3.new(24, 0, -42), scale = 0.62, yaw = math.rad(-12) },
        { position = Vector3.new(-8, 0, -66), scale = 0.62, yaw = math.rad(14) },
        { position = Vector3.new(-27, 0, -87), scale = 0.62, yaw = math.rad(-12) },
        { position = Vector3.new(8, 0, -103), scale = 0.62, yaw = math.rad(14) },
    }
    for index, spec in lanternSpecs do
        local placeholder =
            lantern(geometry, spec.position, spec.scale, _self._runtimeIds.AmbientLightTag)
        table.insert(_self._meshPlacements, {
            assetId = "mesh_creator_street_lantern_a",
            fallbackKind = "placeholder",
            position = spec.position,
            scale = spec.scale,
            yaw = spec.yaw,
            seed = 9200 + index,
            swayTag = nil,
            parent = geometry,
            fallbackInstance = placeholder,
        })
    end
    local routeSign = labelSign(
        geometry,
        CFrame.new(7, 3, -14) * CFrame.Angles(0, math.pi, 0),
        "FOLLOW THE LANTERNS"
    )
    -- The sourced sign has its own two-board silhouette. Keeping the legacy
    -- fallback SurfaceGui after replacement projects one wide sentence across
    -- both irregular boards and clips it into unreadable fragments.
    routeSign:SetAttribute("HideSemanticGuiOnReplacement", true)
    table.insert(_self._meshPlacements, {
        assetId = "mesh_creator_forest_sign_a",
        fallbackKind = "asset_replacement",
        position = Vector3.new(7, 0, -14),
        scale = 1.2,
        yaw = math.pi,
        seed = 9841,
        swayTag = nil,
        parent = geometry,
        fallbackInstance = routeSign,
    })
    buildEmberhollowSanctuary(geometry, _self._meshPlacements)

    local warningFolder = Instance.new("Folder")
    warningFolder.Name = "DuskTreelineWarnings"
    warningFolder.Parent = geometry
    local warningCenters = {
        Vector3.new(-44, 3.1, -133),
        Vector3.new(46, 3.4, -121),
        Vector3.new(0, 3.2, -174),
    }
    for warningIndex, center in warningCenters do
        local body = part(
            warningFolder,
            "DuskThreatSilhouette",
            Vector3.new(5.2, 6.4, 3.3),
            CFrame.new(center) * CFrame.Angles(0, math.rad((warningIndex - 2) * 18), 0),
            Color3.fromRGB(24, 27, 28),
            Enum.Material.Slate,
            false
        )
        body.Shape = Enum.PartType.Ball
        body.CastShadow = false
        body.Transparency = 1
        body:SetAttribute("DuskTransparency", 0.08)
        table.insert(_self._duskSignals, body)
        for side = -1, 1, 2 do
            local shoulder = part(
                warningFolder,
                "DuskThreatRoot",
                Vector3.new(0.8, 5.4, 0.8),
                CFrame.new(center + Vector3.new(side * 2.7, 0.2, 0))
                    * CFrame.Angles(0, 0, math.rad(side * 30)),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
            shoulder.CastShadow = false
            shoulder.Transparency = 1
            shoulder:SetAttribute("DuskTransparency", 0.12)
            table.insert(_self._duskSignals, shoulder)

            local eye = part(
                warningFolder,
                "DuskThreatEye",
                Vector3.new(0.38, 0.38, 0.22),
                CFrame.new(center + Vector3.new(side * 0.72, 0.65, -1.65)),
                Color3.fromRGB(255, 137, 82),
                Enum.Material.Neon,
                false
            )
            eye.Shape = Enum.PartType.Ball
            eye.CastShadow = false
            eye.Transparency = 1
            eye:SetAttribute("DuskTransparency", 0.04)
            table.insert(_self._duskSignals, eye)
        end
    end

    local defenseRoute = Instance.new("Folder")
    defenseRoute.Name = "NightDefenseRoute"
    defenseRoute.Parent = geometry
    for markerIndex = 1, 7 do
        local marker = part(
            defenseRoute,
            "DefenseTrailMarker",
            Vector3.new(5.8, 0.18, 1.1),
            CFrame.new(if markerIndex % 2 == 0 then 4.6 else -4.6, 0.3, -151 + markerIndex * 5),
            AMBER,
            Enum.Material.Glass,
            false
        )
        marker.Transparency = 1
        marker.CastShadow = false
        marker:SetAttribute("SignalRole", "trail")
        table.insert(_self._nightDefenseSignals, marker)
    end
    for side = -1, 1, 2 do
        -- Gate towers flank the Dawn Gate at (0, -148). At x = +/-10.5 they
        -- stood 21 studs apart across an 18-stud road -- effectively touching
        -- the verges, with no room for the gate between them. Real gatehouse
        -- towers sit outside the opening on the wall line, far enough apart
        -- that traffic passes cleanly between and each tower covers the other's
        -- approach. 38 studs apart, level with the gate.
        local towerCenter = Vector3.new(side * 19, 0, -148)
        local towerFallback = Instance.new("Model")
        towerFallback.Name = "WatchtowerFallback"
        towerFallback.Parent = defenseRoute
        for postSide = -1, 1, 2 do
            part(
                towerFallback,
                "WatchPost",
                Vector3.new(0.85, 8.5, 0.85),
                CFrame.new(towerCenter + Vector3.new(postSide * 2.2, 4.25, 0)),
                WET_BARK,
                Enum.Material.Wood
            )
        end
        part(
            towerFallback,
            "WatchPlatform",
            Vector3.new(6.2, 0.65, 5.2),
            CFrame.new(towerCenter + Vector3.new(0, 7.1, 0)),
            Color3.fromRGB(83, 61, 43),
            Enum.Material.WoodPlanks
        )
        table.insert(_self._meshPlacements, {
            assetId = "mesh_creator_watchtower_a",
            fallbackKind = "asset_replacement",
            position = towerCenter,
            scale = 1,
            yaw = if side < 0 then math.rad(12) else math.rad(-12),
            seed = 9850 + side,
            swayTag = nil,
            parent = defenseRoute,
            fallbackInstance = towerFallback,
        })
        table.insert(_self._meshPlacements, {
            assetId = "mesh_creator_campfire_a",
            fallbackKind = "asset_dressing",
            position = towerCenter + Vector3.new(0, 15.4, 0),
            scale = 0.65,
            yaw = math.rad(side * 17),
            seed = 9860 + side,
            swayTag = nil,
            parent = defenseRoute,
            fallbackInstance = nil,
        })
        local brazier = part(
            defenseRoute,
            "WatchSignalFire",
            Vector3.new(1.55, 2.2, 1.55),
            CFrame.new(towerCenter + Vector3.new(0, 8.8, 0)),
            AMBER,
            Enum.Material.Neon,
            false
        )
        brazier.Shape = Enum.PartType.Ball
        brazier.Transparency = 1
        brazier.CastShadow = false
        brazier:SetAttribute("SignalRole", "fire")
        local signalLight = Instance.new("PointLight")
        signalLight.Name = "WatchSignalLight"
        signalLight.Color = AMBER
        signalLight.Brightness = 0
        signalLight.Range = 24
        signalLight.Shadows = false
        signalLight.Parent = brazier
        table.insert(_self._nightDefenseSignals, brazier)
    end
    -- Off the beacon and off the approach. A 13-stud board standing 1.2 studs
    -- from the memory reliquary read as a wall boxing the orb in, which is
    -- exactly what it looked like from the road. Moved to the east verge and
    -- turned to face walkers coming up the lantern road, so it is still read
    -- on the way in without standing on top of the thing it points at.
    local warningBoard = part(
        defenseRoute,
        "NightWatchBoard",
        Vector3.new(13, 2.8, 0.55),
        CFrame.new(23, 4.6, -138) * CFrame.Angles(0, math.rad(-58), 0),
        BARK,
        Enum.Material.WoodPlanks,
        false
    )
    WorldSignBuilder.dressBoard(
        warningBoard,
        "NIGHT WATCH · HOLD THE LANTERN ROAD",
        CREAM,
        "warning"
    )
    table.insert(_self._meshPlacements, {
        assetId = "mesh_creator_notice_board_a",
        fallbackKind = "asset_replacement",
        position = Vector3.new(23, 1, -138),
        scale = 0.7,
        yaw = math.rad(-58),
        seed = 9870,
        swayTag = nil,
        parent = defenseRoute,
        fallbackInstance = warningBoard,
    })
end

-- Rebuilds the same placement from inexpensive geometry when an authored model
-- cannot load. The choice is stable and never leaves a hole in the route art.
local function buildMeshFallback(parent: Instance, placement: MeshPlacement)
    if placement.fallbackKind == "conifer" then
        FoliageBuilder.conifer(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed,
            placement.swayTag
        )
    elseif placement.fallbackKind == "broadleaf" then
        FoliageBuilder.broadleaf(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed,
            placement.swayTag
        )
    elseif placement.fallbackKind == "boulders" then
        FoliageBuilder.boulders(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed
        )
    elseif placement.fallbackKind == "undergrowth" then
        FoliageBuilder.undergrowth(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed,
            placement.swayTag
        )
    elseif placement.fallbackKind == "deadfall" then
        FoliageBuilder.deadfall(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.seed
        )
    elseif placement.fallbackKind == "root_arch" then
        FoliageBuilder.rootArch(
            parent,
            placement.position,
            placement.scale,
            FOLIAGE_TONE,
            placement.yaw
        )
    elseif placement.fallbackKind == "hollow_shrine" then
        FoliageBuilder.rootArch(
            parent,
            placement.position,
            placement.scale * 1.1,
            FOLIAGE_TONE,
            placement.yaw
        )
    end
end

--[[
    Opt a subtree out of being blanked when its placement's authored mesh wins.

    This project has now shipped the same bug four times: real, load-bearing
    content authored *inside* a placement's fallbackInstance -- the First
    Lantern's flame, the dawn beacon's flame, the three tool displays, and
    every illustrated notice on both first-world boards -- goes invisible the
    moment the unrelated mesh it shares a placement with finishes loading. The
    first three were fixed by hoisting the part to a sibling. That works, but
    it only fixes the one caller who remembered, and the notices proved the
    pattern keeps finding new places to happen.

    A part marked here, and everything under it, is skipped by the blanking
    pass. The mesh still replaces the scratch geometry around it.
]]
local function survivesMeshReplacement(instance: Instance, placeholder: Instance): boolean
    local node: Instance? = instance
    while node ~= nil do
        if node:GetAttribute("KeepVisibleOnReplacement") == true then
            return true
        end
        if node == placeholder then
            return false
        end
        node = node.Parent
    end
    return false
end

local function hideProceduralPlaceholder(placeholder: Instance)
    local removeSemanticGui = placeholder:GetAttribute("HideSemanticGuiOnReplacement") == true
    local instances = placeholder:GetDescendants()
    table.insert(instances, placeholder)
    for _, instance in instances do
        if survivesMeshReplacement(instance, placeholder) then
            continue
        end
        if removeSemanticGui and (instance:IsA("SurfaceGui") or instance:IsA("BillboardGui")) then
            instance:Destroy()
        elseif instance:IsA("BasePart") then
            instance.Transparency = 1
            instance.CastShadow = false
        elseif
            instance:IsA("Light")
            or instance:IsA("ParticleEmitter")
            or instance:IsA("Fire")
            or instance:IsA("Smoke")
            or instance:IsA("Sparkles")
            or instance:IsA("Trail")
            or instance:IsA("Beam")
            or instance:IsA("LayerCollector")
        then
            instance.Enabled = false
        end
    end
    placeholder:SetAttribute("ReplacedByAuthoredMesh", true)
end

local function keepReplacedAnchorHidden(target: BasePart)
    if target:GetAttribute("ReplacedByAuthoredMesh") ~= true then
        return
    end
    target.Transparency = 1
    target.CastShadow = false
    for _, child in target:GetChildren() do
        if child:IsA("LayerCollector") then
            child.Enabled = false
        end
    end
end

-- Authored art is optional streaming dressing. Loading begins only after the
-- spawn and interactions are ready, and a failed private asset immediately
-- takes the procedural path above.
function WorldService._placeAuthoredMeshes(
    self: WorldService,
    placements: { MeshPlacement },
    defaultParent: Instance,
    attributeTarget: Instance,
    readyEvent: string
)
    local queued = table.clone(placements)
    task.spawn(function()
        local authored = 0
        local fallbacks = 0
        -- Placements that failed but kept an authored-replacement fallback
        -- visible. These are worth another try later: a boot-burst throttle
        -- error otherwise leaves the whole town ring as dark shells for the
        -- server's lifetime (observed live -- all eleven Milestone 4
        -- buildings, every boot the burst went badly).
        local recoverable: { MeshPlacement } = {}
        local function tryPlace(placement: MeshPlacement): boolean
            local placementParent = placement.parent or defaultParent
            if attributeTarget.Parent == nil or placementParent.Parent == nil then
                return false
            end
            local placementFrame, profileScale = authoredPlacementTransform(placement)
            local placed, result = pcall(
                self._meshTemplateLoader.place,
                self._meshTemplateLoader,
                placement.assetId,
                placementParent,
                placementFrame,
                placement.scale,
                profileScale
            )
            local model = if placed then result else nil
            if not placed then
                self._logger:info("mesh_placement_failed", {
                    assetId = placement.assetId,
                    error = tostring(result),
                })
            end
            if model == nil then
                return false
            end
            if placement.fallbackInstance ~= nil then
                hideProceduralPlaceholder(placement.fallbackInstance)
            end
            return true
        end

        for index, placement in queued do
            if attributeTarget.Parent == nil then
                return
            end
            if tryPlace(placement) then
                authored += 1
            else
                if placement.fallbackInstance == nil then
                    local placementParent = placement.parent or defaultParent
                    if placementParent.Parent ~= nil then
                        buildMeshFallback(placementParent, placement)
                    end
                else
                    table.insert(recoverable, placement)
                end
                fallbacks += 1
            end
            if index % 5 == 0 then
                task.wait()
            end
        end

        attributeTarget:SetAttribute("AuthoredMeshCount", authored)
        attributeTarget:SetAttribute("AuthoredMeshFallbackCount", fallbacks)
        self._logger:info(readyEvent, {
            authored = authored,
            fallbacks = fallbacks,
            placements = #queued,
        })

        -- Recovery rounds. Widening pauses so a throttled boot has time to
        -- cool off; each round forgives only transient load failures and
        -- re-attempts the placements still wearing fallbacks. Success swaps
        -- the authored mesh in and hides the shell exactly as the first pass
        -- would have.
        for _, delay in { 75, 180, 360 } do
            if #recoverable == 0 then
                return
            end
            task.wait(delay)
            if attributeTarget.Parent == nil then
                return
            end
            self._meshTemplateLoader:forgetTransientFailures()
            local remaining: { MeshPlacement } = {}
            local recovered = 0
            for _, placement in recoverable do
                if tryPlace(placement) then
                    recovered += 1
                    authored += 1
                    fallbacks -= 1
                else
                    table.insert(remaining, placement)
                end
                task.wait()
            end
            recoverable = remaining
            if recovered > 0 then
                attributeTarget:SetAttribute("AuthoredMeshCount", authored)
                attributeTarget:SetAttribute("AuthoredMeshFallbackCount", fallbacks)
                self._logger:info("mesh_recovery_pass", {
                    recovered = recovered,
                    remaining = #remaining,
                })
            end
        end
    end)
end

-- Dynamic enemies keep their original primitive geometry as an invisible,
-- authoritative combat volume. Only the visible shell is replaced, so a
-- cosmetic Creator Store model can never change reach, navigation, or hits.
function WorldService.placeEnemyVisual(self: WorldService, model: Model, modelKey: string): boolean
    --[[
        groundOffset is how far below each species' hitbox core its authored
        mesh's feet sit -- see BramblewakeEnemyBuilder for the matching
        fallback-core lift each of these numbers has to track.

        Four of these -- rootling, briarback, snapvine, bark_ram -- used to
        carry exactly their fallback core's lift plus 2.0 more than that lift,
        every one of them, which is too consistent to be separate tuning
        mistakes. It sank each of those four authored meshes about two studs
        into the ground, for the entire lifetime of this feature: measured
        directly against terrain in Studio, a rootling and a snapvine both
        landed almost exactly 2 studs under. This did not come from the
        terrain-datum fix elsewhere in this file -- the sink is `lift -
        groundOffset`, and the spawn origin has always equaled the rendered
        terrain height (both before that fix, when both were the old wrong
        higher value, and after, when both are the corrected one), so the gap
        between them cancels out and was never affected by it.

        Corrected to equal each species' own fallback lift, so a
        ground-walking creature's authored mesh meets the ground exactly where
        its fallback silhouette already does. hollow_crow is untouched: it
        hovers by design (see BramblewakeEnemyBuilder's hoverOrigin), so
        "meets the ground" is not the right target for it. zombie is untouched
        too -- its own lift/offset pair was already close (a 0.2-stud
        difference, imperceptible).
    ]]
    local visualProfiles = {
        rootling = {
            assetId = "mesh_rootling_a",
            groundOffset = 0,
            yaw = math.rad(180),
            profile = Vector3.new(1, 1, 1),
        },
        briarback = {
            assetId = "mesh_briarback_a",
            groundOffset = 0.4,
            yaw = math.rad(180),
            profile = Vector3.new(1, 1, 1),
        },
        zombie = {
            assetId = "mesh_zombie_a",
            groundOffset = 2.9,
            yaw = math.rad(180),
            profile = Vector3.new(1, 1.04, 1),
            scale = 1,
        },
        hollow_crow = {
            assetId = "mesh_hollow_crow_a",
            groundOffset = 1.1,
            yaw = math.rad(180),
            profile = Vector3.new(1, 1, 1),
            scale = 1,
        },
        snapvine = {
            assetId = "mesh_snapvine_a",
            groundOffset = 0,
            yaw = math.rad(180),
            profile = Vector3.new(1, 1, 1),
            scale = 1,
        },
        bark_ram = {
            assetId = "mesh_bark_ram_a",
            groundOffset = 0.5,
            yaw = math.rad(180),
            profile = Vector3.new(1, 1, 1),
            scale = 1,
        },
        -- Generated with a hollow chest so the amber heart weak point sits
        -- inside the creature. The heart is a neon part the elite restores on
        -- every state change, so it stays lit in that cavity rather than
        -- being buried by the mesh.
        old_growth = {
            assetId = "mesh_old_growth_a",
            groundOffset = 9,
            yaw = math.rad(180),
            profile = Vector3.new(1, 1, 1),
        },
        -- The stag was generated without antlers on purpose. The fight breaks
        -- them one at a time, so they stay authored parts standing above the
        -- crown rather than geometry baked into the mesh.
        warden_stag = {
            assetId = "mesh_warden_stag_a",
            groundOffset = 10,
            yaw = math.rad(180),
            profile = Vector3.new(1, 1, 1),
            scale = 1.2,
        },
    }
    local profile = visualProfiles[modelKey]
    local core = model.PrimaryPart
    if profile == nil or core == nil or model.Parent == nil then
        return false
    end

    local fallbackParts = {}
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("BasePart") then
            table.insert(fallbackParts, descendant)
        end
    end
    local bottomPosition = core.Position - Vector3.new(0, profile.groundOffset, 0)
    local at = CFrame.new(bottomPosition) * core.CFrame.Rotation * CFrame.Angles(0, profile.yaw, 0)
    local placed, result = pcall(
        self._meshTemplateLoader.place,
        self._meshTemplateLoader,
        profile.assetId,
        model,
        at,
        profile.scale or 1,
        profile.profile
    )
    local authored = if placed then result else nil
    if authored == nil then
        self._logger:info("enemy_asset_visual_failed", {
            assetId = profile.assetId,
            enemy = modelKey,
            error = if placed then "asset_unavailable" else tostring(result),
        })
        return false
    end
    if model.Parent == nil then
        -- The enemy despawned while the first-time asset load yielded.
        -- Placing it anyway would leave a floating orphaned clone.
        authored:Destroy()
        return false
    end
    authored.Name = "AuthoredEnemyVisual"
    -- The load above can yield (first fetch of this enemy type per server),
    -- during which a moving enemy -- the crow fastest of all -- keeps
    -- flying. `at` was computed from the core's position *before* the yield,
    -- so placing the clone at that stale frame let the visible mesh and the
    -- authoritative hitbox drift permanently apart: the crow looked like it
    -- vanished mid-flight and "respawned" behind, and every tap landed on
    -- empty air. Recompute from the core's current frame right before the
    -- clone is seated so the two start aligned; every later _poseEnemy pivot
    -- of `model` then carries both together.
    local currentBottom = core.Position - Vector3.new(0, profile.groundOffset, 0)
    authored:PivotTo(
        CFrame.new(currentBottom) * core.CFrame.Rotation * CFrame.Angles(0, profile.yaw, 0)
    )
    for _, fallbackPart in fallbackParts do
        -- The same opt-out the world blanking pass honours. The Old Growth
        -- and Warden Stag weak-point hearts are authored INSIDE the creature
        -- (the meshes carry a hollow cavity for exactly this), and hiding
        -- them here made both encounters uncompletable: the heart went
        -- invisible, and clearing its CanQuery meant the strike line-of-sight
        -- ray could never hit it, so every strike reported "behind the
        -- trunk". Fifth instance of the blanked-fallback-content bug; see
        -- survivesMeshReplacement above.
        if survivesMeshReplacement(fallbackPart, model) then
            fallbackPart:SetAttribute("AuthoritativeEnemyHitbox", false)
            continue
        end
        fallbackPart.Transparency = 1
        fallbackPart.CastShadow = false
        local isCore = fallbackPart == core
        fallbackPart:SetAttribute("AuthoritativeEnemyHitbox", isCore)
        -- The strike volume is the tap target and must keep answering
        -- raycasts, or the creature becomes unhittable the moment its
        -- authored mesh loads -- which is exactly the bug this volume
        -- exists to fix.
        if fallbackPart:GetAttribute("EnemyStrikeVolume") == true then
            continue
        end
        -- Only the authoritative hitbox may answer raycasts once the
        -- authored mesh is up. Left true, the wing/beak/eye fallback parts
        -- stayed queryable with no ClickDetector of their own and silently
        -- swallowed taps aimed at the now-invisible crow.
        if not isCore then
            fallbackPart.CanQuery = false
        end
    end
    --[[
        Grow the tap target to the creature the player can actually see.

        The volume is authored from the core, but every species' authored mesh
        has its own silhouette -- the bark ram and the crow both read wider
        than the box their hitbox lives in. Fitting the volume to the real
        rendered bounds, plus a thumb's margin, is what makes "tap any part of
        the monster" true rather than approximately true.
    ]]
    local strikeVolume = model:FindFirstChild("StrikeVolume")
    if strikeVolume ~= nil and strikeVolume:IsA("BasePart") then
        local authoredCFrame, authoredSize = authored:GetBoundingBox()
        strikeVolume.Size = Vector3.new(
            math.max(strikeVolume.Size.X, authoredSize.X + 4),
            math.max(strikeVolume.Size.Y, authoredSize.Y + 3),
            math.max(strikeVolume.Size.Z, authoredSize.Z + 4)
        )
        strikeVolume.CFrame = CFrame.new(authoredCFrame.Position)
    end
    model:SetAttribute("EnemyVisualAssetId", profile.assetId)
    model:SetAttribute("EnemyVisualReady", true)
    return true
end

function WorldService._buildMeshDressing(self: WorldService)
    local world = self._world
    if world == nil then
        return
    end
    local geometry = world:FindFirstChild("Environment")
    local forest = if geometry ~= nil then geometry:FindFirstChild("Forest") else nil
    if forest == nil then
        return
    end
    self:_placeAuthoredMeshes(self._meshPlacements, forest, world, "mesh_dressing_ready")
end

--[[
    Fills in the horizon after joining is unblocked.

    Everything here is optional scenery: terrain past CORE_RADIUS, and the two
    outer forest bands. None of it is ground a player can stand on and none of
    it gates the tutorial, so it must not sit between a joining player and a
    playable world. AGENTS.md is explicit that joining never blocks on the
    whole world loading, and Config.BootstrapTimeoutSeconds is only 8 -- the
    first version of this change generated the entire 121 x 121 hill grid, the
    peak ring, and all 4,000-plus forest parts before ArrivalSpawn even
    existed.

    Yields between grid rows and between bands so the work lands across many
    frames instead of one long hitch. Failures are contained: scenery breaking
    out here must not take down a world that is already ready and playable.
]]
function WorldService._buildDistantScenery(self: WorldService)
    local world = self._world
    if world == nil then
        return
    end

    local geometry = world:FindFirstChild("Environment")
    local forest = if geometry ~= nil then geometry:FindFirstChild("Forest") else nil
    local swayTag = self._runtimeIds.AmbientSwayTag

    task.spawn(function()
        local ok, err = pcall(function()
            TerrainBuilder.buildDistant(nil, nil, function()
                task.wait()
            end)

            for bandIndex = 2, 3 do
                -- The world can be torn down and rebuilt while this runs.
                if forest == nil or forest.Parent == nil then
                    return
                end
                plantForestBand(forest, bandIndex, swayTag)
                task.wait()
            end
        end)

        if not ok then
            self._logger:info("distant_scenery_failed", { error = tostring(err) })
            return
        end
        self._logger:info("distant_scenery_ready", {})
    end)
end

--[[
    The Emberhollow departure yard.

    Where a session starts: a lantern-lit staging courtyard with a character
    hut on one side, a notice board and stall on the other, and a raised
    departure platform at its south edge facing the road out to the arrival
    clearing. Standing on that platform is what puts a player in the party;
    the countdown and the launch itself belong to LobbyService.

    Built to the same standard as the rest of the world rather than as a grey
    box: layered ground, a real timber-framed hut with a roof and rafters,
    banded platform edging, practical lantern light, and reviewed props. The
    platform reads as a threshold you deliberately step onto -- raised, ringed,
    and pointed at the gate -- because that is the whole mechanic.
]]
function WorldService._buildLobby(self: WorldService, world: Model)
    local lobby = Instance.new("Folder")
    lobby.Name = "EmberhollowLobby"
    lobby.Parent = world
    self._lobby = lobby

    -- Interior half-extents. The room is deliberately oversized for a cabin:
    -- a third-person camera needs to orbit a whole party inside it without
    -- clipping the walls, and the departure platform needs clear floor around
    -- it so stepping on is an obvious, deliberate act.
    local halfWidth = 32
    local halfDepth = 24
    local wallHeight = 18

    groundPatch(
        lobby,
        LOBBY_CENTER,
        Vector3.new(halfWidth * 2 + 20, 0.3, halfDepth * 2 + 20),
        Color3.fromRGB(46, 55, 45),
        Enum.Material.LeafyGrass
    )

    local floor = part(
        lobby,
        "LodgeFloor",
        Vector3.new(halfWidth * 2, 1, halfDepth * 2),
        CFrame.new(LOBBY_CENTER + Vector3.new(0, 0.5, 0)),
        Color3.fromRGB(86, 62, 43),
        Enum.Material.WoodPlanks
    )
    floor.CanQuery = false
    for plankIndex = -15, 15 do
        local plank = part(
            lobby,
            "LodgeFloorPlank",
            Vector3.new(1.9, 0.08, halfDepth * 2 - 1),
            CFrame.new(LOBBY_CENTER + Vector3.new(plankIndex * 2.05, 1.02, 0)),
            if plankIndex % 2 == 0 then Color3.fromRGB(94, 68, 47) else Color3.fromRGB(78, 56, 39),
            Enum.Material.WoodPlanks,
            false
        )
        plank.CanQuery = false
    end

    -- Walls stay collidable so the camera stops at them and the room reads as
    -- an interior. The roof above is non-colliding, so the camera passes
    -- through it instead of shoving itself into the player's back.
    local function wall(name: string, size: Vector3, at: Vector3)
        part(
            lobby,
            name,
            size,
            CFrame.new(LOBBY_CENTER + at),
            Color3.fromRGB(72, 52, 37),
            Enum.Material.Wood
        )
    end
    wall(
        "LodgeWallBack",
        Vector3.new(halfWidth * 2, wallHeight, 1.2),
        Vector3.new(0, wallHeight / 2, halfDepth)
    )
    for wallSide = -1, 1, 2 do
        wall(
            "LodgeWallSide",
            Vector3.new(1.2, wallHeight, halfDepth * 2),
            Vector3.new(wallSide * halfWidth, wallHeight / 2, 0)
        )
    end
    --[[
        The front wall is solid. There is no door.

        A doorway invited players to walk out and skip the departure entirely,
        arriving in the world alone; sealing it with an invisible pane stopped
        that but left an opening the player could see through and not use,
        which is its own kind of broken. A lodge with no exit but the platform
        states the rule in geometry instead of enforcing it with a trick.
        Windows keep the room from feeling like a box and still show the road
        the player is about to be sent to.
    ]]
    wall(
        "LodgeWallFront",
        Vector3.new(halfWidth * 2, wallHeight, 1.2),
        Vector3.new(0, wallHeight / 2, -halfDepth)
    )
    for windowSide = -1, 1, 2 do
        local windowAt = LOBBY_CENTER + Vector3.new(windowSide * 13, wallHeight * 0.58, -halfDepth)
        local pane = part(
            lobby,
            "LodgeWindow",
            Vector3.new(9, 5.5, 0.4),
            CFrame.new(windowAt),
            Color3.fromRGB(126, 168, 178),
            Enum.Material.Glass,
            false
        )
        pane.Transparency = 0.62
        pane.CanQuery = false
        for barIndex = -1, 1 do
            local bar = part(
                lobby,
                "LodgeWindowBar",
                Vector3.new(0.35, 5.7, 0.6),
                CFrame.new(windowAt + Vector3.new(barIndex * 3, 0, 0)),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
            bar.CanQuery = false
        end
        local sill = part(
            lobby,
            "LodgeWindowSill",
            Vector3.new(10, 0.6, 1.4),
            CFrame.new(windowAt - Vector3.new(0, 3.1, 0)),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
        sill.CanQuery = false
    end

    -- Log courses and corner posts so the walls read as built timber.
    for courseIndex = 1, 5 do
        for courseSide = -1, 1, 2 do
            local course = part(
                lobby,
                "LodgeLogCourse",
                Vector3.new(1.5, 1.5, halfDepth * 2),
                CFrame.new(
                    LOBBY_CENTER + Vector3.new(courseSide * (halfWidth - 0.4), courseIndex * 3.3, 0)
                ),
                if courseIndex % 2 == 0 then BARK else WET_BARK,
                Enum.Material.Wood,
                false
            )
            course.CanQuery = false
        end
    end
    for cornerX = -1, 1, 2 do
        for cornerZ = -1, 1, 2 do
            part(
                lobby,
                "LodgeCornerPost",
                Vector3.new(2.4, wallHeight + 1, 2.4),
                CFrame.new(
                    LOBBY_CENTER
                        + Vector3.new(
                            cornerX * halfWidth,
                            (wallHeight + 1) / 2,
                            cornerZ * halfDepth
                        )
                ),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
    end

    -- Roof: high, and non-colliding so the camera never fights it.
    local ridgeHeight = wallHeight + 9
    local ridge = part(
        lobby,
        "LodgeRidgeBeam",
        Vector3.new(1.4, 1.4, halfDepth * 2 + 3),
        CFrame.new(LOBBY_CENTER + Vector3.new(0, ridgeHeight, 0)),
        WET_BARK,
        Enum.Material.Wood,
        false
    )
    ridge.CanQuery = false
    for roofSide = -1, 1, 2 do
        local roof = part(
            lobby,
            "LodgeRoof",
            Vector3.new(halfWidth + 3, 10, halfDepth * 2 + 4),
            CFrame.new(LOBBY_CENTER + Vector3.new(roofSide * (halfWidth / 2), wallHeight + 4.5, 0))
                * CFrame.Angles(0, if roofSide < 0 then math.pi else 0, 0),
            Color3.fromRGB(48, 53, 49),
            Enum.Material.Slate,
            false
        )
        roof.Shape = Enum.PartType.Wedge
        roof.CanQuery = false
    end
    for rafterIndex = -5, 5 do
        for rafterSide = -1, 1, 2 do
            local rafter = part(
                lobby,
                "LodgeRafter",
                Vector3.new(0.5, 0.5, halfWidth * 0.72),
                CFrame.new(
                    LOBBY_CENTER
                        + Vector3.new(
                            rafterSide * halfWidth * 0.26,
                            wallHeight + 4.6,
                            rafterIndex * 4.3
                        )
                ) * CFrame.Angles(0, math.rad(90), math.rad(rafterSide * 30)),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
            rafter.CanQuery = false
        end
    end

    -- Warm interior light so the room is lit from inside, not by the sky.
    -- Each lamp is a housed fixture -- iron bracket, cap, and corner posts
    -- around the glow -- because a bare neon cube on a wall reads as a
    -- missing texture, not a lantern. That is exactly how the owner's first
    -- screenshot of this room read.
    for lampIndex = -1, 1, 2 do
        for lampZ = -1, 1, 2 do
            local lampAt = LOBBY_CENTER
                + Vector3.new(lampIndex * (halfWidth - 9), wallHeight - 4, lampZ * (halfDepth - 8))
            local bracket = part(
                lobby,
                "LodgeLampBracket",
                Vector3.new(0.35, 2.6, 0.35),
                CFrame.new(lampAt + Vector3.new(0, 1.6, 0)),
                Color3.fromRGB(50, 54, 58),
                Enum.Material.Metal,
                false
            )
            bracket.CanQuery = false
            local cap = part(
                lobby,
                "LodgeLampCap",
                Vector3.new(1.9, 0.4, 1.9),
                CFrame.new(lampAt + Vector3.new(0, 1.15, 0)),
                Color3.fromRGB(50, 54, 58),
                Enum.Material.Metal,
                false
            )
            cap.CanQuery = false
            for postX = -1, 1, 2 do
                for postZ = -1, 1, 2 do
                    local post = part(
                        lobby,
                        "LodgeLampPost",
                        Vector3.new(0.18, 1.9, 0.18),
                        CFrame.new(lampAt + Vector3.new(postX * 0.78, 0, postZ * 0.78)),
                        Color3.fromRGB(50, 54, 58),
                        Enum.Material.Metal,
                        false
                    )
                    post.CanQuery = false
                end
            end
            local base = part(
                lobby,
                "LodgeLampBase",
                Vector3.new(1.9, 0.3, 1.9),
                CFrame.new(lampAt + Vector3.new(0, -1.05, 0)),
                Color3.fromRGB(50, 54, 58),
                Enum.Material.Metal,
                false
            )
            base.CanQuery = false
            local lamp = part(
                lobby,
                "LodgeLamp",
                Vector3.new(1.1, 1.5, 1.1),
                CFrame.new(lampAt),
                AMBER,
                Enum.Material.Neon,
                false
            )
            lamp.Transparency = 0.15
            lamp.CastShadow = false
            lamp.CanQuery = false
            local lampLight = Instance.new("PointLight")
            -- Four lamps at 1.5/42 plus the hearth plus the platform washed
            -- the whole room to flat yellow and hid every material in it.
            -- Wall lamps now only pool light near the walls; the hearth and
            -- the platform are what the eye should actually go to.
            lampLight.Color = AMBER
            lampLight.Brightness = 0.5
            lampLight.Range = 20
            lampLight.Parent = lamp
            CollectionService:AddTag(lamp, self._runtimeIds.AmbientLightTag)
        end
    end

    -- Hearth at the back wall: the reason a lodge feels occupied.
    local hearthAt = LOBBY_CENTER + Vector3.new(0, 0, halfDepth - 4)
    part(
        lobby,
        "LodgeHearth",
        Vector3.new(13, 7, 4),
        CFrame.new(hearthAt + Vector3.new(0, 4.5, 1.4)),
        Color3.fromRGB(78, 82, 78),
        Enum.Material.Slate
    )
    part(
        lobby,
        "LodgeHearthMantel",
        Vector3.new(15, 0.8, 5.2),
        CFrame.new(hearthAt + Vector3.new(0, 8.2, 1.2)),
        WET_BARK,
        Enum.Material.Wood,
        false
    )
    part(
        lobby,
        "LodgeChimneyBreast",
        Vector3.new(9, wallHeight - 8, 3),
        CFrame.new(hearthAt + Vector3.new(0, 8.2 + (wallHeight - 8) / 2, 1.4)),
        Color3.fromRGB(70, 74, 70),
        Enum.Material.Slate,
        false
    )
    for jambSide = -1, 1, 2 do
        part(
            lobby,
            "LodgeHearthJamb",
            Vector3.new(2.2, 6, 3.4),
            CFrame.new(hearthAt + Vector3.new(jambSide * 5.4, 3, 0.9)),
            Color3.fromRGB(88, 92, 88),
            Enum.Material.Slate,
            false
        )
    end
    part(
        lobby,
        "LodgeHearthFender",
        Vector3.new(11, 0.6, 3),
        CFrame.new(hearthAt + Vector3.new(0, 1.3, -1.6)),
        Color3.fromRGB(58, 62, 58),
        Enum.Material.Slate,
        false
    )
    for logIndex = -1, 1 do
        part(
            lobby,
            "LodgeHearthLog",
            Vector3.new(0.9, 0.9, 4.4),
            CFrame.new(hearthAt + Vector3.new(logIndex * 1.1, 1.6, 0.2))
                * CFrame.Angles(0, math.rad(logIndex * 14), math.rad(90)),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
    end
    -- The fire is layered wedge flames over a coal bed, the same recipe the
    -- rebuilt torch uses. The old single neon box read as a flat yellow
    -- rectangle stuck to the chimney -- the owner's screenshot, again.
    local coals = part(
        lobby,
        "LodgeHearthCoals",
        Vector3.new(4.2, 0.5, 2.2),
        CFrame.new(hearthAt + Vector3.new(0, 1.35, 0.2)),
        Color3.fromRGB(255, 120, 40),
        Enum.Material.Neon,
        false
    )
    coals.Transparency = 0.25
    coals.CastShadow = false
    local hearthFire: BasePart? = nil
    for flameIndex = -1, 1 do
        local flameHeight = if flameIndex == 0 then 3.1 else 2.1
        local flame = part(
            lobby,
            "LodgeHearthFlame",
            Vector3.new(if flameIndex == 0 then 2.1 else 1.4, flameHeight, 1.1),
            CFrame.new(hearthAt + Vector3.new(flameIndex * 1.35, 1.6 + flameHeight / 2, 0.2))
                * CFrame.Angles(0, math.rad(flameIndex * 22), 0),
            if flameIndex == 0 then AMBER else Color3.fromRGB(255, 150, 60),
            Enum.Material.Neon,
            false
        )
        flame.Shape = Enum.PartType.Wedge
        flame.Transparency = if flameIndex == 0 then 0.1 else 0.3
        flame.CastShadow = false
        flame.CanQuery = false
        if flameIndex == 0 then
            hearthFire = flame
        end
    end
    assert(hearthFire ~= nil, "hearth flame missing")
    local hearthLight = Instance.new("PointLight")
    hearthLight.Color = AMBER
    hearthLight.Brightness = 1.5
    hearthLight.Range = 30
    hearthLight.Parent = hearthFire
    CollectionService:AddTag(hearthFire, self._runtimeIds.AmbientLightTag)

    --[[
        The departure platform, in the middle of the floor and impossible to
        miss: a raised timber dais on a stone base, ringed with a bright amber
        inlay, lit from four corner posts, with a floating title above it.
        Standing on it is the whole mechanic, so it is the brightest and most
        deliberate object in the room.
    ]]
    local platform = part(
        lobby,
        "DeparturePlatform",
        Vector3.new(DEPARTURE_PLATFORM_RADIUS * 2, 1.6, DEPARTURE_PLATFORM_RADIUS * 2),
        CFrame.new(DEPARTURE_PLATFORM_CENTER + Vector3.new(0, 1.8, 0)),
        Color3.fromRGB(84, 61, 43),
        Enum.Material.WoodPlanks
    )
    self._departurePlatform = platform
    local platformBase = part(
        lobby,
        "DeparturePlatformBase",
        Vector3.new(DEPARTURE_PLATFORM_RADIUS * 2 + 3, 1.1, DEPARTURE_PLATFORM_RADIUS * 2 + 3),
        CFrame.new(DEPARTURE_PLATFORM_CENTER + Vector3.new(0, 1.05, 0)),
        Color3.fromRGB(66, 70, 66),
        Enum.Material.Slate
    )
    platformBase.CanQuery = false
    for stepSide = -1, 1, 2 do
        local step = part(
            lobby,
            "DepartureStep",
            Vector3.new(DEPARTURE_PLATFORM_RADIUS * 1.5, 0.6, 2.4),
            CFrame.new(
                DEPARTURE_PLATFORM_CENTER
                    + Vector3.new(0, 0.8, stepSide * (DEPARTURE_PLATFORM_RADIUS + 2.4))
            ),
            Color3.fromRGB(74, 78, 74),
            Enum.Material.Slate
        )
        step.CanQuery = false
    end
    for markIndex = 0, 31 do
        local angle = (markIndex / 32) * math.pi * 2
        local mark = part(
            lobby,
            "DepartureRing",
            Vector3.new(1.3, 0.14, 0.6),
            CFrame.new(
                DEPARTURE_PLATFORM_CENTER
                    + Vector3.new(
                        math.cos(angle) * (DEPARTURE_PLATFORM_RADIUS - 1.5),
                        2.66,
                        math.sin(angle) * (DEPARTURE_PLATFORM_RADIUS - 1.5)
                    )
            ) * CFrame.Angles(0, -angle, 0),
            AMBER,
            Enum.Material.Neon,
            false
        )
        mark.Transparency = 0.24
        mark.CastShadow = false
        mark.CanQuery = false
    end
    local platformGlow = part(
        lobby,
        "DepartureGlow",
        Vector3.new(DEPARTURE_PLATFORM_RADIUS * 1.7, 0.12, DEPARTURE_PLATFORM_RADIUS * 1.7),
        CFrame.new(DEPARTURE_PLATFORM_CENTER + Vector3.new(0, 2.64, 0)),
        AMBER,
        Enum.Material.Neon,
        false
    )
    platformGlow.Transparency = 0.72
    platformGlow.CastShadow = false
    platformGlow.CanQuery = false
    local platformLight = Instance.new("PointLight")
    platformLight.Color = AMBER
    platformLight.Brightness = 1.1
    platformLight.Range = 22
    platformLight.Parent = platformGlow
    CollectionService:AddTag(platformGlow, self._runtimeIds.AmbientLightTag)
    for postIndex = 0, 3 do
        local angle = (postIndex / 4) * math.pi * 2 + math.pi / 4
        local postAt = DEPARTURE_PLATFORM_CENTER
            + Vector3.new(
                math.cos(angle) * (DEPARTURE_PLATFORM_RADIUS + 0.6),
                0,
                math.sin(angle) * (DEPARTURE_PLATFORM_RADIUS + 0.6)
            )
        part(
            lobby,
            "DepartureLanternPost",
            Vector3.new(0.7, 9.5, 0.7),
            CFrame.new(postAt + Vector3.new(0, 4.75, 0)),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
        local lampGlow = part(
            lobby,
            "DepartureLanternGlow",
            Vector3.new(1.2, 1.5, 1.2),
            CFrame.new(postAt + Vector3.new(0, 9.2, 0)),
            AMBER,
            Enum.Material.Neon,
            false
        )
        lampGlow.CastShadow = false
        lampGlow.CanQuery = false
        local lampLight = Instance.new("PointLight")
        lampLight.Color = AMBER
        lampLight.Brightness = 0.6
        lampLight.Range = 14
        lampLight.Parent = lampGlow
    end
    addBillboard(platform, "STAND HERE TO DEPART", AMBER, 120)

    -- Everything a staging room needs, indoors: work surfaces, supplies, a
    -- table to gather at, beds along the back, and the notice board.
    --[[
        Furnishing, arranged rather than scattered.

        Everything sits against a wall on a defined side of the room, so the
        centre floor stays clear for the platform and a party walking to it.
        Loose barrels dropped in the middle of the floor is what made the first
        pass read as a storeroom someone had emptied out.

          west wall  -- the work side: bench, anvil, shelf, tool rack
          east wall  -- the rest side: beds, table, notice board
          front wall -- stores stacked either side of the doorway
    ]]
    local props = {
        -- West wall: work.
        { asset = "mesh_creator_workbench_a", at = Vector3.new(-25, 0, 6), yaw = 90, scale = 1 },
        { asset = "mesh_creator_tool_set_a", at = Vector3.new(-25, 2.7, 6), yaw = 90, scale = 0.7 },
        { asset = "mesh_creator_anvil_a", at = Vector3.new(-25.5, 0, 13), yaw = 90, scale = 1 },
        {
            asset = "mesh_creator_potion_shelf_a",
            at = Vector3.new(-27.5, 0, 0),
            yaw = 90,
            scale = 1,
        },
        { asset = "mesh_creator_crate_a", at = Vector3.new(-27, 0, -8), yaw = 90, scale = 1 },
        { asset = "mesh_creator_barrel_a", at = Vector3.new(-27, 0, -13), yaw = 0, scale = 1 },
        -- East wall: rest.
        {
            asset = "mesh_creator_wayfarer_bed_a",
            at = Vector3.new(25.5, 0, 14),
            yaw = -90,
            scale = 1,
        },
        {
            asset = "mesh_creator_wayfarer_bed_a",
            at = Vector3.new(25.5, 0, 5),
            yaw = -90,
            scale = 1,
        },
        {
            asset = "mesh_creator_picnic_table_a",
            at = Vector3.new(23, 0, -6),
            yaw = 0,
            scale = 1.1,
        },
        {
            asset = "mesh_creator_notice_board_a",
            at = Vector3.new(27, 0, -15),
            yaw = -90,
            scale = 0.9,
        },
        -- Either side of the doorway: stores.
        { asset = "mesh_creator_crate_a", at = Vector3.new(-13, 0, -20), yaw = 0, scale = 1 },
        { asset = "mesh_creator_barrel_a", at = Vector3.new(-17, 0, -20), yaw = 0, scale = 1 },
        { asset = "mesh_creator_crate_a", at = Vector3.new(15, 0, -20), yaw = 0, scale = 1 },
    }
    for propIndex, prop in props do
        table.insert(self._meshPlacements, {
            assetId = prop.asset,
            fallbackKind = "asset_dressing",
            position = LOBBY_CENTER + prop.at + Vector3.new(0, 1, 0),
            scale = prop.scale,
            yaw = math.rad(prop.yaw),
            seed = 9460 + propIndex,
            swayTag = nil,
            parent = lobby,
            fallbackInstance = nil,
        })
    end

    labelSign(
        lobby,
        CFrame.new(LOBBY_CENTER + Vector3.new(10, 0, -halfDepth + 3))
            * CFrame.Angles(0, math.rad(180), 0),
        "TO EMBERHOLLOW"
    )

    -- Spawn at the back of the room, facing the platform and the doorway
    -- beyond it, so the first thing a player sees is where to go.
    local lobbySpawn = Instance.new("SpawnLocation")
    lobbySpawn.Name = "LobbySpawn"
    lobbySpawn.Size = Vector3.new(16, 1, 10)
    -- Unrotated on purpose: a Part's LookVector is its -Z axis, and the
    -- platform sits at lower Z than the spawn. The old 180-degree yaw did
    -- the opposite of this comment's promise and greeted every new player
    -- with a close-up of the hearth wall.
    lobbySpawn.CFrame = CFrame.new(LOBBY_CENTER + Vector3.new(0, 1.5, halfDepth - 12))
    lobbySpawn.Transparency = 1
    lobbySpawn.Anchored = true
    lobbySpawn.CanCollide = true
    lobbySpawn.Neutral = true
    lobbySpawn.Duration = 0
    lobbySpawn.Parent = lobby
    self._lobbySpawn = lobbySpawn
end

function WorldService._buildMara(self: WorldService, world: Model)
    -- A real R15 rig instead of ~30 hand-stacked primitive parts. Mara used
    -- to read as a box with a sphere for a head because nothing gave
    -- residents an actual articulated body; CreateHumanoidModelFromDescription
    -- builds Roblox's own body meshes (rounded head, jointed limbs, real
    -- hands and feet) tinted to her palette, with no external asset download
    -- required.
    local skin = Color3.fromRGB(205, 153, 111)
    local coat = Color3.fromRGB(59, 83, 62)
    local coatDark = Color3.fromRGB(45, 51, 48)
    local hairColor = Color3.fromRGB(79, 43, 31)

    local description = Instance.new("HumanoidDescription")
    description.HeadColor = skin
    description.LeftArmColor = coat
    description.RightArmColor = coat
    description.TorsoColor = coat
    description.LeftLegColor = coatDark
    description.RightLegColor = coatDark
    -- The default R15 rig is a broad, blocky, androgynous silhouette that read
    -- as male. Narrowing the shoulders and depth while easing the body toward
    -- avatar proportions gives a feminine frame to hang her clothing on; the
    -- long hair, waisted coat, and flared coat tails below do the rest. These
    -- stay conservative on purpose -- pushed further the stock rig stretches
    -- and reads uncanny rather than simply slimmer.
    description.HeightScale = 0.99
    description.WidthScale = 0.84
    description.DepthScale = 0.9
    description.HeadScale = 1.04
    description.BodyTypeScale = 0.3
    description.ProportionScale = 0.75

    local model = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
    model.Name = "Mara"
    model:SetAttribute("ResidentId", "npc_mara")
    -- On the approach side of the fallen trunk, facing the player walking
    -- in, so the pinned figure is actually visible. At (-3, 3, -30) she
    -- stood at the deadfall's own centre and the authored trunk swallowed
    -- her whole -- a rescue objective starring a floating nameplate.
    model:PivotTo(CFrame.new(-3, 3, -27.4) * CFrame.Angles(0, math.pi, 0))

    local maraHumanoid = model:WaitForChild("Humanoid") :: Humanoid
    maraHumanoid.DisplayName = "Mara"
    maraHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    maraHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    maraHumanoid.BreakJointsOnDeath = false
    maraHumanoid.RequiresNeck = false

    local root = model:WaitForChild("HumanoidRootPart") :: BasePart
    root.Transparency = 1
    local torso = model:WaitForChild("UpperTorso") :: BasePart
    local head = model:WaitForChild("Head") :: BasePart
    -- The old body was entirely non-colliding and non-queryable (interaction
    -- goes through _registerInteraction below, not physical touch/click), so
    -- keep the real rig's parts out of the way of players the same way.
    --
    -- Anchoring is what keeps her in the world at all. The hand-built body this
    -- replaced was made of part() calls, which anchor by default; a rig from
    -- CreateHumanoidModelFromDescription arrives unanchored, and because every
    -- part here is also CanCollide = false there is nothing under her to stand
    -- on. She fell through the valley floor the instant the world built and
    -- kept going -- the rescue's PivotTo only appeared to fix it, yanking her
    -- back up for the ~1s of the move loop before she resumed falling. She is
    -- a static NPC repositioned exclusively through PivotTo (see moveMara and
    -- the resident ambient motion), so nothing here needs physics.
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false
        end
    end

    -- Welds are redundant while every part above is anchored, but they keep the
    -- accessories attached to the body they were measured against if this rig
    -- is ever put back under physics.
    local function attach(piece: BasePart, to: BasePart)
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = to
        weld.Part1 = piece
        weld.Parent = piece
    end

    -- Hair, in layers. One sphere on top of the skull is what the character
    -- standard specifically calls out as not-a-hairstyle, and a cropped cap is
    -- most of why she read as male at gameplay distance.
    local hairCrown = part(
        model,
        "Hair",
        Vector3.new(head.Size.X * 1.12, head.Size.Y * 0.62, head.Size.Z * 1.12),
        head.CFrame * CFrame.new(0, head.Size.Y * 0.36, 0),
        hairColor,
        Enum.Material.SmoothPlastic,
        false
    )
    hairCrown.Shape = Enum.PartType.Ball
    attach(hairCrown, head)
    local hairFall = part(
        model,
        "HairFall",
        Vector3.new(head.Size.X * 1.02, head.Size.Y * 1.5, head.Size.Z * 0.66),
        head.CFrame * CFrame.new(0, -head.Size.Y * 0.42, head.Size.Z * 0.5),
        hairColor,
        Enum.Material.SmoothPlastic,
        false
    )
    attach(hairFall, head)
    for hairSide = -1, 1, 2 do
        local strand = part(
            model,
            "HairStrand",
            Vector3.new(head.Size.X * 0.26, head.Size.Y * 1.15, head.Size.Z * 0.72),
            head.CFrame
                * CFrame.new(hairSide * head.Size.X * 0.46, -head.Size.Y * 0.2, 0)
                * CFrame.Angles(0, 0, math.rad(hairSide * -4)),
            hairColor,
            Enum.Material.SmoothPlastic,
            false
        )
        attach(strand, head)
    end
    local braid = part(
        model,
        "HairBraid",
        Vector3.new(head.Size.X * 0.34, head.Size.Y * 0.9, head.Size.Z * 0.34),
        head.CFrame
            * CFrame.new(0, -head.Size.Y * 1.15, head.Size.Z * 0.56)
            * CFrame.Angles(math.rad(-9), 0, 0),
        Color3.fromRGB(64, 34, 25),
        Enum.Material.SmoothPlastic,
        false
    )
    attach(braid, head)

    -- A readable face. The standard requires eyes plus at least a nose and
    -- mouth; the stock rig head ships with none of them. Roblox heads face -Z.
    for eyeSide = -1, 1, 2 do
        local eye = part(
            model,
            "Eye",
            Vector3.new(head.Size.X * 0.15, head.Size.Y * 0.15, head.Size.Z * 0.1),
            head.CFrame
                * CFrame.new(eyeSide * head.Size.X * 0.22, head.Size.Y * 0.08, -head.Size.Z * 0.48),
            Color3.fromRGB(38, 44, 42),
            Enum.Material.SmoothPlastic,
            false
        )
        eye.Shape = Enum.PartType.Ball
        attach(eye, head)
        local brow = part(
            model,
            "Brow",
            Vector3.new(head.Size.X * 0.22, head.Size.Y * 0.05, head.Size.Z * 0.08),
            head.CFrame
                * CFrame.new(eyeSide * head.Size.X * 0.22, head.Size.Y * 0.21, -head.Size.Z * 0.47),
            Color3.fromRGB(64, 34, 25),
            Enum.Material.SmoothPlastic,
            false
        )
        attach(brow, head)
    end
    local nose = part(
        model,
        "Nose",
        Vector3.new(head.Size.X * 0.12, head.Size.Y * 0.16, head.Size.Z * 0.16),
        head.CFrame * CFrame.new(0, -head.Size.Y * 0.04, -head.Size.Z * 0.52),
        Color3.fromRGB(196, 143, 103),
        Enum.Material.SmoothPlastic,
        false
    )
    attach(nose, head)
    local mouth = part(
        model,
        "Mouth",
        Vector3.new(head.Size.X * 0.24, head.Size.Y * 0.06, head.Size.Z * 0.08),
        head.CFrame * CFrame.new(0, -head.Size.Y * 0.26, -head.Size.Z * 0.48),
        Color3.fromRGB(142, 84, 74),
        Enum.Material.SmoothPlastic,
        false
    )
    attach(mouth, head)

    local scarf = part(
        model,
        "Scarf",
        Vector3.new(torso.Size.X * 0.94, 0.42, torso.Size.Z * 1.18),
        torso.CFrame * CFrame.new(0, torso.Size.Y * 0.42, 0),
        AMBER,
        Enum.Material.Fabric,
        false
    )
    attach(scarf, torso)

    -- Layered coat: shoulders, lapels, cuffs, waist, and flared tails. The
    -- tails plus the belted waist are what turn a straight blocky torso into a
    -- silhouette that reads feminine without touching the interaction anchor.
    for shoulderSide = -1, 1, 2 do
        local shoulder = part(
            model,
            "CoatShoulder",
            Vector3.new(torso.Size.X * 0.46, torso.Size.Y * 0.3, torso.Size.Z * 1.24),
            torso.CFrame
                * CFrame.new(shoulderSide * torso.Size.X * 0.36, torso.Size.Y * 0.26, 0)
                * CFrame.Angles(0, 0, math.rad(shoulderSide * 7)),
            coatDark,
            Enum.Material.Fabric,
            false
        )
        attach(shoulder, torso)
        local lapel = part(
            model,
            "CoatLapel",
            Vector3.new(torso.Size.X * 0.2, torso.Size.Y * 0.68, torso.Size.Z * 0.22),
            torso.CFrame
                * CFrame.new(
                    shoulderSide * torso.Size.X * 0.17,
                    torso.Size.Y * 0.02,
                    -torso.Size.Z * 0.52
                )
                * CFrame.Angles(0, 0, math.rad(shoulderSide * 9)),
            coatDark,
            Enum.Material.Fabric,
            false
        )
        attach(lapel, torso)
    end

    local belt = part(
        model,
        "CoatBelt",
        Vector3.new(torso.Size.X * 1.05, 0.3, torso.Size.Z * 1.12),
        torso.CFrame * CFrame.new(0, -torso.Size.Y * 0.44, 0),
        Color3.fromRGB(84, 58, 40),
        Enum.Material.Leather,
        false
    )
    attach(belt, torso)
    local buckle = part(
        model,
        "CoatBuckle",
        Vector3.new(0.26, 0.26, 0.12),
        torso.CFrame * CFrame.new(0, -torso.Size.Y * 0.44, -torso.Size.Z * 0.58),
        Color3.fromRGB(168, 137, 92),
        Enum.Material.Metal,
        false
    )
    attach(buckle, torso)

    local lowerTorso = model:FindFirstChild("LowerTorso")
    if lowerTorso ~= nil and lowerTorso:IsA("BasePart") then
        for tailSide = -1, 1, 2 do
            local tail = part(
                model,
                "CoatTail",
                Vector3.new(lowerTorso.Size.X * 0.56, lowerTorso.Size.Y * 1.9, 0.3),
                lowerTorso.CFrame
                    * CFrame.new(
                        tailSide * lowerTorso.Size.X * 0.3,
                        -lowerTorso.Size.Y * 0.72,
                        lowerTorso.Size.Z * 0.5
                    )
                    * CFrame.Angles(math.rad(4), 0, math.rad(tailSide * 5)),
                coat,
                Enum.Material.Fabric,
                false
            )
            attach(tail, lowerTorso)
        end
        local skirt = part(
            model,
            "CoatSkirt",
            Vector3.new(lowerTorso.Size.X * 1.32, lowerTorso.Size.Y * 1.25, lowerTorso.Size.Z * 1.3),
            lowerTorso.CFrame * CFrame.new(0, -lowerTorso.Size.Y * 0.5, 0),
            coat,
            Enum.Material.Fabric,
            false
        )
        attach(skirt, lowerTorso)
    end

    for cuffSide = -1, 1, 2 do
        local lowerArm =
            model:FindFirstChild(if cuffSide < 0 then "LeftLowerArm" else "RightLowerArm")
        if lowerArm ~= nil and lowerArm:IsA("BasePart") then
            local cuff = part(
                model,
                "CoatCuff",
                Vector3.new(lowerArm.Size.X * 1.24, lowerArm.Size.Y * 0.3, lowerArm.Size.Z * 1.24),
                lowerArm.CFrame * CFrame.new(0, -lowerArm.Size.Y * 0.34, 0),
                coatDark,
                Enum.Material.Fabric,
                false
            )
            attach(cuff, lowerArm)
        end
    end

    -- Her role-specific prop: the Greenward field satchel she carries herbs and
    -- cuttings in, slung across the body so it reads from any angle.
    local satchel = part(
        model,
        "FieldSatchel",
        Vector3.new(1.05, 0.86, 0.44),
        torso.CFrame * CFrame.new(torso.Size.X * 0.62, -torso.Size.Y * 0.52, torso.Size.Z * 0.16),
        Color3.fromRGB(108, 76, 48),
        Enum.Material.Leather,
        false
    )
    attach(satchel, torso)
    local satchelFlap = part(
        model,
        "FieldSatchelFlap",
        Vector3.new(1.09, 0.34, 0.5),
        satchel.CFrame * CFrame.new(0, 0.3, 0),
        Color3.fromRGB(84, 58, 40),
        Enum.Material.Leather,
        false
    )
    attach(satchelFlap, satchel)
    local satchelStrap = part(
        model,
        "FieldSatchelStrap",
        Vector3.new(0.22, torso.Size.Y * 1.32, torso.Size.Z * 1.3),
        torso.CFrame * CFrame.new(torso.Size.X * 0.12, 0, 0) * CFrame.Angles(0, 0, math.rad(24)),
        Color3.fromRGB(84, 58, 40),
        Enum.Material.Leather,
        false
    )
    attach(satchelStrap, torso)
    local sprig = part(
        model,
        "SatchelSprig",
        Vector3.new(0.16, 0.5, 0.16),
        satchel.CFrame * CFrame.new(-0.22, 0.52, 0) * CFrame.Angles(0, 0, math.rad(-14)),
        MOSS,
        Enum.Material.Grass,
        false
    )
    attach(sprig, satchel)

    local leftHand = model:WaitForChild("LeftHand") :: BasePart
    local handLanternFallback = Instance.new("Model")
    handLanternFallback.Name = "MaraLanternFallback"
    handLanternFallback.Parent = model
    local handLantern = part(
        handLanternFallback,
        "MaraLantern",
        Vector3.new(0.82, 1.12, 0.82),
        leftHand.CFrame * CFrame.new(0, -0.55, 0),
        Color3.fromRGB(204, 154, 81),
        Enum.Material.Glass,
        false
    )
    handLantern.Transparency = 0.48
    for railX = -1, 1, 2 do
        for railZ = -1, 1, 2 do
            part(
                handLanternFallback,
                "MaraLanternRail",
                Vector3.new(0.1, 1.42, 0.1),
                handLantern.CFrame * CFrame.new(railX * 0.48, 0, railZ * 0.48),
                Color3.fromRGB(47, 50, 52),
                Enum.Material.Metal,
                false
            )
        end
    end
    for capY = -1, 1, 2 do
        part(
            handLanternFallback,
            "MaraLanternCap",
            Vector3.new(1.15, 0.18, 1.15),
            handLantern.CFrame * CFrame.new(0, capY * 0.7, 0),
            Color3.fromRGB(47, 50, 52),
            Enum.Material.Metal,
            false
        )
    end
    local handFlame = part(
        handLanternFallback,
        "MaraLanternFlame",
        Vector3.new(0.32, 0.62, 0.28),
        handLantern.CFrame * CFrame.new(0, -0.08, 0) * CFrame.Angles(0, math.rad(18), 0),
        AMBER,
        Enum.Material.Neon,
        false
    )
    handFlame.Shape = Enum.PartType.Wedge
    local handLight = Instance.new("PointLight")
    handLight.Color = AMBER
    handLight.Brightness = 1.25
    handLight.Range = 15
    handLight.Shadows = false
    handLight.Parent = handFlame
    CollectionService:AddTag(handFlame, self._runtimeIds.AmbientLightTag)
    table.insert(self._meshPlacements, {
        assetId = "mesh_creator_kerosene_lantern_a",
        fallbackKind = "placeholder",
        position = handLantern.Position,
        scale = 1,
        yaw = math.rad(-8),
        seed = 9313,
        swayTag = nil,
        parent = model,
        fallbackInstance = handLanternFallback,
    })
    model.PrimaryPart = root
    model.Parent = world
    model:SetAttribute("MotionKind", "resident")
    model:SetAttribute("MotionSpeed", 0.72)
    CollectionService:AddTag(model, self._runtimeIds.AmbientMotionTag)
    addBillboard(head, "MARA · GREENWARD", AMBER, 46)

    -- Mara has to look pinned, because the prompt on her reads FREE. The
    -- deadfall used to be placed at y = -0.2 -- lying flat on the ground
    -- alongside her, touching nothing -- and because it was wired as the
    -- fallback's replacement it hid the arching FallenRoot geometry the moment
    -- it loaded, which it does. The result was a rescue objective with visibly
    -- nothing holding her. The trunk now lies across her at waist height,
    -- carried on two broken stumps so it has believable support, and the whole
    -- assembly is one model that freeMara clears when she is released.
    local trap = Instance.new("Model")
    trap.Name = "MaraFallenRoots"
    trap.Parent = world
    for stumpSide = -1, 1, 2 do
        part(
            trap,
            "FallenRootStump",
            Vector3.new(1.9, 2.2, 1.9),
            CFrame.new(-3 + stumpSide * 5.4, 1.1, -30)
                * CFrame.Angles(0, 0, math.rad(stumpSide * 6)),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
    end

    local fallenRootsFallback = Instance.new("Model")
    fallenRootsFallback.Name = "MaraFallenRootsFallback"
    fallenRootsFallback.Parent = trap
    part(
        fallenRootsFallback,
        "FallenRoot",
        Vector3.new(13.6, 1.7, 1.7),
        CFrame.new(-3, 2.55, -30) * CFrame.Angles(0, 0, math.rad(-5)),
        BARK,
        Enum.Material.Wood,
        false
    )
    for limbIndex = -1, 1, 2 do
        part(
            fallenRootsFallback,
            "FallenRootLimb",
            Vector3.new(0.85, 5.4, 0.85),
            CFrame.new(-3 + limbIndex * 2.2, 2.1, -30 + limbIndex * 0.7)
                * CFrame.Angles(math.rad(limbIndex * 26), 0, math.rad(64)),
            BARK,
            Enum.Material.Wood,
            false
        )
    end
    table.insert(self._meshPlacements, {
        assetId = "mesh_deadfall_a",
        fallbackKind = "asset_replacement",
        position = Vector3.new(-3, 1.9, -30),
        scale = 1.15,
        yaw = math.rad(90),
        seed = 9320,
        swayTag = nil,
        parent = trap,
        fallbackInstance = fallenRootsFallback,
        profileScale = Vector3.new(1.18, 0.92, 0.86),
    })
    self._maraTrap = trap

    self._mara = model
    self._maraStandY = model:GetPivot().Position.Y
    self:_registerInteraction(
        torso,
        self._runtimeIds.InteractionIds.Mara,
        self._runtimeIds.Actions.Rescue,
        "FREE",
        "Mara",
        nil,
        nil,
        Vector3.new(7, 8, 7)
    )
end

function WorldService._buildInteractables(self: WorldService, world: Model)
    local interactables = Instance.new("Folder")
    interactables.Name = "Interactables"
    interactables.Parent = world

    local heartwoodFallback = Instance.new("Model")
    heartwoodFallback.Name = "HeartwoodVisualFallback"
    heartwoodFallback.Parent = interactables
    local stump = part(
        heartwoodFallback,
        "HeartwoodStump",
        -- Rotated a quarter turn about Z below, so local X is the stump's
        -- HEIGHT and Y/Z are its cross-section: (height, diameter, diameter).
        -- Authored as (7.6, 5.8, 7.6) this came out 7.6 tall with a squashed
        -- 5.8 x 7.6 oval cross-section instead of a 5.8-tall round stump. The
        -- growth rings are the proof: they offset 3.05 along the axis, which
        -- only reaches the cut face when the half-height is 2.9. At 3.8 they
        -- sat buried three quarters of a stud inside the wood.
        Vector3.new(5.8, 7.6, 7.6),
        CFrame.new(HEARTWOOD_CENTER + Vector3.new(0, 2.9, 0)),
        WET_BARK,
        Enum.Material.Wood
    )
    stump.Shape = Enum.PartType.Cylinder
    stump.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
    for rootIndex = 1, 6 do
        local angle = (rootIndex / 6) * math.pi * 2
        part(
            heartwoodFallback,
            "HeartwoodRoot",
            Vector3.new(1.05, 1.15, 5.8),
            CFrame.new(
                HEARTWOOD_CENTER + Vector3.new(math.cos(angle) * 3.8, 0.62, math.sin(angle) * 3.8)
            )
                * CFrame.Angles(0, -angle, math.rad(5 + rootIndex % 2 * 4)),
            if rootIndex % 2 == 0 then BARK else WET_BARK,
            Enum.Material.Wood,
            false
        )
    end
    for barkIndex = 1, 10 do
        local angle = (barkIndex / 10) * math.pi * 2
        local barkRib = part(
            heartwoodFallback,
            "HeartwoodBarkRib",
            Vector3.new(1.15, 4.8 + (barkIndex % 3) * 0.45, 0.62),
            CFrame.new(
                HEARTWOOD_CENTER
                    + Vector3.new(
                        math.cos(angle) * 3.65,
                        2.4 + (barkIndex % 3) * 0.18,
                        math.sin(angle) * 3.65
                    )
            )
                * CFrame.Angles(0, -angle + math.rad(90), math.rad((barkIndex % 2) * 3 - 1.5)),
            if barkIndex % 2 == 0 then BARK else Color3.fromRGB(48, 31, 25),
            Enum.Material.Wood,
            false
        )
        barkRib.CanQuery = false
    end
    for crownIndex = 1, 6 do
        local angle = (crownIndex / 6) * math.pi * 2
        local crown = part(
            heartwoodFallback,
            "HeartwoodSplitCrown",
            Vector3.new(1.5, 2 + (crownIndex % 2) * 0.7, 1.2),
            CFrame.new(
                HEARTWOOD_CENTER
                    + Vector3.new(
                        math.cos(angle) * 2.35,
                        6.1 + (crownIndex % 2) * 0.25,
                        math.sin(angle) * 2.35
                    )
            )
                * CFrame.Angles(0, -angle, math.rad(if crownIndex % 2 == 0 then 8 else -7)),
            if crownIndex % 2 == 0 then BARK else WET_BARK,
            Enum.Material.Wood,
            false
        )
        crown.Shape = Enum.PartType.Wedge
        crown.CanQuery = false
    end
    for ringIndex = 1, 3 do
        local growthRing = part(
            heartwoodFallback,
            "HeartwoodGrowthRing",
            Vector3.new(0.16, 5.7 - ringIndex * 0.7, 5.7 - ringIndex * 0.7),
            stump.CFrame * CFrame.new(3.05, 0, 0),
            Color3.fromRGB(128 + ringIndex * 12, 91 + ringIndex * 8, 55),
            Enum.Material.Wood,
            false
        )
        growthRing.Shape = Enum.PartType.Cylinder
    end
    local cavity = part(
        heartwoodFallback,
        "HeartwoodCavity",
        Vector3.new(3.9, 4.1, 0.5),
        CFrame.new(HEARTWOOD_CENTER + Vector3.new(0, 4.05, 3.42)),
        Color3.fromRGB(27, 19, 17),
        Enum.Material.Wood,
        false
    )
    cavity.Shape = Enum.PartType.Ball
    cavity.CanQuery = false
    local heart = part(
        heartwoodFallback,
        "HeartwoodCore",
        Vector3.new(2.5, 2.9, 0.85),
        CFrame.new(HEARTWOOD_CENTER + Vector3.new(0, 4.15, 3.65)),
        AMBER,
        Enum.Material.Glass,
        false
    )
    heart.Shape = Enum.PartType.Ball
    heart.Transparency = 0.2
    for shardIndex = -1, 1 do
        local shard = part(
            heartwoodFallback,
            "HeartwoodShard",
            Vector3.new(0.65, 2.1 + math.abs(shardIndex) * 0.45, 0.55),
            CFrame.new(
                HEARTWOOD_CENTER
                    + Vector3.new(shardIndex * 0.82, 4.2 + math.abs(shardIndex) * 0.25, 3.82)
            )
                * CFrame.Angles(0, math.rad(shardIndex * 18), math.rad(shardIndex * -8)),
            AMBER,
            Enum.Material.Glass,
            false
        )
        shard.Shape = Enum.PartType.Wedge
        shard.Transparency = 0.12
    end
    local heartLight = Instance.new("PointLight")
    heartLight.Color = AMBER
    heartLight.Brightness = 1.5
    heartLight.Range = 18
    heartLight.Parent = heart
    addBillboard(heart, "HEARTWOOD", AMBER, 18)
    table.insert(self._meshPlacements, {
        assetId = "mesh_heartwood_stump_a",
        fallbackKind = "asset_replacement",
        position = HEARTWOOD_CENTER,
        scale = 1,
        yaw = math.rad(-18),
        seed = 9880,
        swayTag = nil,
        parent = interactables,
        fallbackInstance = heartwoodFallback,
    })
    self:_registerInteraction(
        stump,
        self._runtimeIds.InteractionIds.Heartwood,
        self._runtimeIds.Actions.Gather,
        "GATHER",
        "Heartwood",
        nil,
        nil,
        Vector3.new(12, 12, 12)
    )

    local toolYard = Instance.new("Model")
    toolYard.Name = "StarterToolYard"
    toolYard.Parent = interactables
    -- Building floors are collidable in this codebase (see WorkshopFloor,
    -- ArchiveFloor, etc) -- only open-world roads rely on Terrain underneath
    -- a non-colliding visual skin. This floor was built with the road
    -- pattern (CanCollide false) despite being a roofed building interior,
    -- so wherever the procedural terrain dips even slightly below y=0 here,
    -- there is nothing solid under it and a player standing on it falls
    -- straight through into whatever is below the valley floor.
    local toolYardGround = part(
        toolYard,
        "ToolYardGround",
        Vector3.new(14, 0.38, 28),
        CFrame.new(TOOL_YARD_CENTER + Vector3.new(0, 0.19, 0)),
        Color3.fromRGB(71, 54, 39),
        Enum.Material.Ground
    )
    toolYardGround.CanQuery = false
    for xSide = -1, 1, 2 do
        for zSide = -1, 1, 2 do
            part(
                toolYard,
                "ToolYardPost",
                Vector3.new(0.7, 14.4, 0.7),
                CFrame.new(TOOL_YARD_CENTER + Vector3.new(xSide * 5.8, 7.2, zSide * 12.4))
                    * CFrame.Angles(0, 0, math.rad(xSide * zSide * 2)),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
    end
    part(
        toolYard,
        "ToolYardRidgeBeam",
        Vector3.new(0.7, 0.7, 28),
        CFrame.new(TOOL_YARD_CENTER + Vector3.new(0, 16.4, 0)),
        WET_BARK,
        Enum.Material.Wood,
        false
    )
    -- Open rafters carried high. Two solid slate wedges used to span the
    -- full 28-stud length directly above the three tool displays, and from any
    -- normal over-the-shoulder camera they covered the very thing the player
    -- had walked over to look at. Camera sightline is one of the four
    -- clearances the visual standard requires reserving before detail, and a
    -- roofed interior that hides its own interaction fails that.
    --
    -- Paired rafters carried on the ridge beam keep the frame reading as a
    -- built shelter -- posts, beam, rafters, believable support -- while
    -- leaving open sky between them to see and reach through. The whole frame
    -- also sits well above head height: at the original eaves the beams
    -- themselves crossed the screen at eye level, which is no better than the
    -- roof it replaced.
    for rafterIndex = -4, 4 do
        local rafterZ = rafterIndex * 3.2
        for rafterSide = -1, 1, 2 do
            part(
                toolYard,
                "ToolYardRafter",
                Vector3.new(0.34, 0.34, 7.4),
                CFrame.new(TOOL_YARD_CENTER + Vector3.new(rafterSide * 2.9, 15.5, rafterZ))
                    * CFrame.Angles(0, math.rad(90), math.rad(rafterSide * 26)),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
    end
    for braceSide = -1, 1, 2 do
        part(
            toolYard,
            "ToolYardEaveBeam",
            Vector3.new(0.4, 0.4, 28),
            CFrame.new(TOOL_YARD_CENTER + Vector3.new(braceSide * 5.6, 14.7, 0)),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
    end
    local toolDisplayFallback = Instance.new("Model")
    toolDisplayFallback.Name = "ToolDisplayFallback"
    toolDisplayFallback.Parent = toolYard
    local tools = {
        {
            id = self._runtimeIds.InteractionIds.ToolAxe,
            tool = "axe",
            position = TOOL_YARD_CENTER + Vector3.new(0, 0, 8),
            color = Color3.fromRGB(102, 154, 102),
            assetId = "mesh_hand_axe_a",
            seed = 9895,
        },
        {
            id = self._runtimeIds.InteractionIds.ToolHammer,
            tool = "hammer",
            position = TOOL_YARD_CENTER,
            color = AMBER,
            assetId = "mesh_blacksmith_hammer_a",
            seed = 9896,
        },
        {
            id = self._runtimeIds.InteractionIds.ToolTorch,
            tool = "torch",
            position = TOOL_YARD_CENTER + Vector3.new(0, 0, -8),
            color = Color3.fromRGB(111, 154, 184),
            assetId = "mesh_creator_handheld_torch_a",
            seed = 9897,
        },
        --[[
            The other five families, racked in a second row west of the
            first three. No reviewed meshes exist for these yet, so each
            crate carries a procedural silhouette below instead of a mesh
            placement -- same crate, cushion, and open lid as its siblings,
            with the tool readable on the cushion.
        ]]
        {
            id = self._runtimeIds.InteractionIds.ToolPick,
            tool = "pick",
            position = TOOL_YARD_CENTER + Vector3.new(-8, 0, 8),
            color = Color3.fromRGB(151, 116, 74),
            assetId = nil,
            seed = 9890,
        },
        {
            id = self._runtimeIds.InteractionIds.ToolSickle,
            tool = "sickle",
            position = TOOL_YARD_CENTER + Vector3.new(-8, 0, 0),
            color = Color3.fromRGB(133, 176, 108),
            assetId = nil,
            seed = 9891,
        },
        {
            id = self._runtimeIds.InteractionIds.ToolFishingKit,
            tool = "fishing_kit",
            position = TOOL_YARD_CENTER + Vector3.new(-8, 0, -8),
            color = Color3.fromRGB(98, 148, 176),
            assetId = nil,
            seed = 9892,
        },
        {
            id = self._runtimeIds.InteractionIds.ToolClimbingKit,
            tool = "climbing_kit",
            position = TOOL_YARD_CENTER + Vector3.new(-16, 0, 4),
            color = Color3.fromRGB(176, 134, 84),
            assetId = nil,
            seed = 9893,
        },
        {
            id = self._runtimeIds.InteractionIds.ToolSurveyKit,
            tool = "survey_kit",
            position = TOOL_YARD_CENTER + Vector3.new(-16, 0, -4),
            color = Color3.fromRGB(186, 168, 112),
            assetId = nil,
            seed = 9894,
        },
    }
    for _, definition in tools do
        local displayFrame = CFrame.new(definition.position) * CFrame.Angles(0, math.rad(90), 0)
        local display = Instance.new("Model")
        display.Name = "ToolDisplay_" .. definition.tool
        display:SetAttribute("DisplayKind", "open_supply_crate")
        display.Parent = toolDisplayFallback
        local pedestal = part(
            display,
            "Tool_" .. definition.tool,
            Vector3.new(6, 2, 6),
            displayFrame * CFrame.new(0, 1, 0),
            Color3.fromRGB(66, 70, 65),
            Enum.Material.Slate
        )
        pedestal.Transparency = 1
        pedestal.CanCollide = false
        pedestal.CastShadow = false
        part(
            display,
            "ToolDisplayCrate",
            Vector3.new(5.8, 1.7, 4.9),
            displayFrame * CFrame.new(0, 0.85, 0),
            Color3.fromRGB(89, 62, 42),
            Enum.Material.WoodPlanks
        )
        part(
            display,
            "ToolDisplayCushion",
            Vector3.new(4.8, 0.34, 3.7),
            displayFrame * CFrame.new(0, 1.87, 0),
            Color3.fromRGB(64, 77, 65):Lerp(definition.color, 0.24),
            Enum.Material.Fabric,
            false
        )
        for side = -1, 1, 2 do
            part(
                display,
                "ToolDisplayBand",
                Vector3.new(0.36, 1.95, 5.12),
                displayFrame * CFrame.new(side * 2.1, 0.98, 0),
                Color3.fromRGB(87, 91, 86),
                Enum.Material.Metal,
                false
            )
            part(
                display,
                "ToolDisplayLidBrace",
                Vector3.new(0.38, 3.8, 0.38),
                displayFrame
                    * CFrame.new(side * 2.25, 3.15, -2.05)
                    * CFrame.Angles(math.rad(-12), 0, 0),
                Color3.fromRGB(72, 49, 35),
                Enum.Material.Wood,
                false
            )
        end
        part(
            display,
            "ToolDisplayOpenLid",
            Vector3.new(5.8, 0.46, 4.7),
            displayFrame * CFrame.new(0, 3.72, -2.38) * CFrame.Angles(math.rad(-68), 0, 0),
            Color3.fromRGB(77, 53, 37),
            Enum.Material.WoodPlanks,
            false
        )
        part(
            display,
            "ToolDisplayPlaque",
            Vector3.new(3.7, 1.05, 0.28),
            displayFrame * CFrame.new(0, 1.1, 2.52) * CFrame.Angles(math.rad(-8), 0, 0),
            definition.color,
            Enum.Material.SmoothPlastic,
            false
        )
        -- The tool shape itself (handle + head/flame) is a disposable
        -- fallback -- the reviewed Creator Store axe/hammer/torch mesh
        -- replaces it below. The crate, cushion, bands, and plaque above
        -- stay as the permanent display stand regardless.
        local toolFallback = Instance.new("Model")
        toolFallback.Name = "ToolFallback"
        toolFallback.Parent = display
        local toolAnchor = displayFrame * CFrame.new(0, 5.4, 0)
        -- Only the torch lit itself. Under a shadow-casting technology the
        -- open-rafter tool yard roof above this display is enough shade that
        -- the axe and hammer -- which have no light of their own -- read as
        -- close to black. Every tool now gets the same small fixed light the
        -- torch was already getting from its own flame, so which one is lit
        -- stops depending on which tool a player happens to be looking at.
        local displayLight = Instance.new("PointLight")
        displayLight.Color = Color3.fromRGB(255, 238, 214)
        displayLight.Brightness = 2.4
        displayLight.Range = 14
        displayLight.Shadows = false
        displayLight.Parent = pedestal
        part(
            toolFallback,
            "ToolHandle",
            Vector3.new(0.45, 4.2, 0.45),
            displayFrame
                * CFrame.new(0, 4.1, 0)
                * CFrame.Angles(0, 0, if definition.tool == "torch" then 0 else math.rad(28)),
            Color3.fromRGB(111, 76, 48),
            Enum.Material.Wood,
            false
        )
        if definition.tool == "axe" then
            local head = part(
                toolFallback,
                "AxeHead",
                Vector3.new(2.25, 0.65, 0.38),
                displayFrame * CFrame.new(-0.28, 5.82, 0) * CFrame.Angles(0, 0, math.rad(28)),
                Color3.fromRGB(154, 169, 174),
                Enum.Material.Metal,
                false
            )
            head.Shape = Enum.PartType.Wedge
        elseif definition.tool == "hammer" then
            local head = part(
                toolFallback,
                "HammerHead",
                Vector3.new(2.15, 0.78, 0.9),
                displayFrame * CFrame.new(0, 5.85, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color3.fromRGB(123, 132, 137),
                Enum.Material.Metal,
                false
            )
            head.Shape = Enum.PartType.Cylinder
        elseif definition.tool == "pick" then
            for pointSide = -1, 1, 2 do
                local point = part(
                    toolFallback,
                    "PickPoint",
                    Vector3.new(1.35, 0.5, 0.4),
                    displayFrame
                        * CFrame.new(pointSide * 0.75 - 0.28, 5.86, 0)
                        * CFrame.Angles(0, 0, math.rad(28 + pointSide * 16)),
                    Color3.fromRGB(146, 152, 158),
                    Enum.Material.Metal,
                    false
                )
                point.Shape = Enum.PartType.Wedge
            end
        elseif definition.tool == "sickle" then
            local blade = part(
                toolFallback,
                "SickleBlade",
                Vector3.new(2, 0.34, 0.7),
                displayFrame * CFrame.new(-0.6, 5.9, 0) * CFrame.Angles(0, 0, math.rad(62)),
                Color3.fromRGB(158, 168, 158),
                Enum.Material.Metal,
                false
            )
            blade.Shape = Enum.PartType.Wedge
            local hook = part(
                toolFallback,
                "SickleHook",
                Vector3.new(1.15, 0.34, 0.55),
                displayFrame * CFrame.new(-1.35, 6.5, 0) * CFrame.Angles(0, 0, math.rad(118)),
                Color3.fromRGB(158, 168, 158),
                Enum.Material.Metal,
                false
            )
            hook.Shape = Enum.PartType.Wedge
        elseif definition.tool == "fishing_kit" then
            part(
                toolFallback,
                "FishingLine",
                Vector3.new(0.08, 2.4, 0.08),
                displayFrame * CFrame.new(-1.05, 5.15, 0),
                Color3.fromRGB(214, 205, 186),
                Enum.Material.Fabric,
                false
            )
            local bobber = part(
                toolFallback,
                "FishingBobber",
                Vector3.new(0.55, 0.55, 0.55),
                displayFrame * CFrame.new(-1.05, 3.85, 0),
                Color3.fromRGB(196, 84, 60),
                Enum.Material.SmoothPlastic,
                false
            )
            bobber.Shape = Enum.PartType.Ball
        elseif definition.tool == "climbing_kit" then
            local coil = part(
                toolFallback,
                "ClimbingCoil",
                Vector3.new(0.5, 1.7, 1.7),
                displayFrame * CFrame.new(0.2, 5.5, 0) * CFrame.Angles(0, math.rad(90), 0),
                Color3.fromRGB(156, 122, 82),
                Enum.Material.Fabric,
                false
            )
            coil.Shape = Enum.PartType.Cylinder
            local hook = part(
                toolFallback,
                "ClimbingHook",
                Vector3.new(0.85, 0.5, 0.35),
                displayFrame * CFrame.new(0.2, 6.6, 0) * CFrame.Angles(0, 0, math.rad(38)),
                Color3.fromRGB(123, 132, 137),
                Enum.Material.Metal,
                false
            )
            hook.Shape = Enum.PartType.Wedge
        elseif definition.tool == "survey_kit" then
            local scope = part(
                toolFallback,
                "SurveyScope",
                Vector3.new(1.9, 0.55, 0.55),
                displayFrame * CFrame.new(-0.2, 6.15, 0) * CFrame.Angles(0, 0, math.rad(74)),
                Color3.fromRGB(126, 112, 74),
                Enum.Material.Metal,
                false
            )
            scope.Shape = Enum.PartType.Cylinder
            local lens = part(
                toolFallback,
                "SurveyLens",
                Vector3.new(0.3, 0.62, 0.62),
                displayFrame * CFrame.new(0.05, 7.05, 0) * CFrame.Angles(0, 0, math.rad(74)),
                Color3.fromRGB(186, 214, 214),
                Enum.Material.Glass,
                false
            )
            lens.Shape = Enum.PartType.Cylinder
        else
            --[[
                A torch, built as a torch.

                This was a bare stick with a Neon ball stuck on the end, tinted
                the display's plaque colour -- pale blue-white, which is not a
                colour fire is. At gameplay distance it read as a lollipop, and
                the owner said so. A torch is legible from four things: a
                tapered handle, a wrapped cloth head, a charred cup, and a
                flame with a silhouette. Wedges give the flame a shape that
                narrows toward the tip; three of them at different angles and
                warmths read as fire rather than as a lamp.
            ]]
            local wrap = part(
                toolFallback,
                "TorchWrap",
                Vector3.new(0.62, 1.35, 0.62),
                displayFrame * CFrame.new(0, 5.6, 0),
                Color3.fromRGB(74, 58, 42),
                Enum.Material.Fabric,
                false
            )
            wrap.CanQuery = false
            local cup = part(
                toolFallback,
                "TorchCup",
                -- Cylinder axis is local X: (height, diameter, diameter).
                Vector3.new(0.66, 1.05, 1.05),
                displayFrame * CFrame.new(0, 6.28, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color3.fromRGB(48, 40, 36),
                Enum.Material.Metal,
                false
            )
            cup.Shape = Enum.PartType.Cylinder
            local embers = part(
                toolFallback,
                "TorchEmbers",
                Vector3.new(0.78, 0.34, 0.78),
                displayFrame * CFrame.new(0, 6.62, 0),
                Color3.fromRGB(196, 84, 30),
                Enum.Material.Neon,
                false
            )
            embers.CanQuery = false
            local flameShapes = {
                {
                    size = Vector3.new(1.05, 1.5, 1.05),
                    y = 7.05,
                    yaw = 0,
                    color = Color3.fromRGB(224, 104, 34),
                },
                {
                    size = Vector3.new(0.78, 1.9, 0.78),
                    y = 7.35,
                    yaw = 128,
                    color = Color3.fromRGB(255, 158, 54),
                },
                {
                    size = Vector3.new(0.46, 1.35, 0.46),
                    y = 7.85,
                    yaw = 246,
                    color = Color3.fromRGB(255, 214, 128),
                },
            }
            local flame
            for index, shape in flameShapes do
                local piece = part(
                    toolFallback,
                    if index == 1 then "TorchFlame" else "TorchFlameTip",
                    shape.size,
                    displayFrame
                        * CFrame.new(0, shape.y, 0)
                        * CFrame.Angles(0, math.rad(shape.yaw), math.rad(index * 4 - 6)),
                    shape.color,
                    Enum.Material.Neon,
                    false
                )
                piece.Shape = Enum.PartType.Wedge
                piece.CanQuery = false
                piece.CastShadow = false
                if index == 1 then
                    flame = piece
                end
                CollectionService:AddTag(piece, self._runtimeIds.AmbientLightTag)
            end
            local flameLight = Instance.new("PointLight")
            flameLight.Color = Color3.fromRGB(255, 168, 82)
            flameLight.Brightness = 2.2
            flameLight.Range = 19
            flameLight.Parent = flame
        end
        --[[
            The axe and hammer use their reviewed meshes. The torch does not:
            the sourced handheld torch renders as a pale stick whose own glow
            reads blue-white, which is what made this display look like a
            lollipop on a phone. The layered flame built above is the better
            object, so for the torch the "fallback" is the finished art and
            nothing is allowed to replace it.
        ]]
        if definition.assetId ~= nil and definition.tool ~= "torch" then
            table.insert(self._meshPlacements, {
                assetId = definition.assetId,
                fallbackKind = "asset_replacement",
                position = (toolAnchor * CFrame.new(0, -0.3, 0)).Position,
                scale = 1,
                yaw = math.rad(90),
                seed = definition.seed,
                swayTag = nil,
                parent = display,
                fallbackInstance = toolFallback,
            })
        end
        -- A dedicated, always-visible anchor for the name label, since the
        -- tool shape it used to hang from gets hidden once the reviewed
        -- mesh replaces it.
        local labelAnchor = part(
            display,
            "ToolLabelAnchor",
            Vector3.new(0.2, 0.2, 0.2),
            toolAnchor,
            definition.color,
            Enum.Material.SmoothPlastic,
            false
        )
        labelAnchor.Transparency = 1
        labelAnchor.CanQuery = false
        --[[
            The label finally says what the choice means. "AXE / HAMMER /
            TORCH" told a player nothing -- the owner's words: "I have no idea
            what to select because I don't know what the in-game difference
            is." The second line is the difference, and the numbers behind it
            live in TutorialService._strikeContext and ActionProgress.begin.
        ]]
        local toolBlurb = if definition.tool == "axe"
            then "AXE\nHITS 25% HARDER"
            elseif definition.tool == "hammer" then "HAMMER\nWORKS 25% FASTER"
            else "TORCH\nLONGER REACH · LIGHTS THE DARK"
        addBillboard(labelAnchor, toolBlurb, definition.color)
        self:_registerInteraction(
            pedestal,
            definition.id,
            self._runtimeIds.Actions.ChooseTool,
            "CHOOSE",
            definition.tool,
            definition.tool,
            nil,
            -- The axe, hammer, or torch stands above its crate, so the volume
            -- has to cover the whole display: clicking the tool itself is the
            -- obvious gesture and was previously missing the pedestal below.
            Vector3.new(7, 9, 7)
        )
    end
    --[[
        No workbench behind the middle stand.

        A 10-stud-tall workbench mesh used to sit at the yard centre, directly
        behind the hammer. The three stands are built from one loop and are
        otherwise identical, so that single prop made the middle choice look
        deliberately different from its neighbours -- the owner read it as "a
        wall holding up the hammer" and asked why that one was special. It is
        not, and nothing should imply it is: the yard's whole job is to
        present three equal choices.
    ]]
    -- No extra tool rack here. The yard exists to present exactly three
    -- choices -- axe, hammer, torch -- and a spare set of tools floating
    -- alongside them just read as clutter the player had to visually discard
    -- before finding the thing they were sent to pick.

    local barricadeFallback = Instance.new("Model")
    barricadeFallback.Name = "BarricadeWorksiteFallback"
    barricadeFallback.Parent = interactables
    local plot = part(
        barricadeFallback,
        "ConstructionPlot",
        Vector3.new(18, 0.5, 9),
        CFrame.new(BARRICADE_CENTER + Vector3.new(0, 0.25, 0)),
        Color3.fromRGB(218, 184, 108),
        Enum.Material.Ground
    )
    plot.Transparency = 0.08
    for postIndex = -2, 2 do
        local height = 2.8 + (postIndex + 2) * 0.55
        part(
            barricadeFallback,
            "BarricadeWorkPost",
            Vector3.new(0.78, height, 0.78),
            CFrame.new(BARRICADE_CENTER + Vector3.new(postIndex * 3.6, height / 2, 0))
                * CFrame.Angles(0, 0, math.rad(postIndex * 3)),
            WET_BARK,
            Enum.Material.Wood
        )
    end
    for braceIndex = -1, 1 do
        part(
            barricadeFallback,
            "BarricadeWorkBrace",
            Vector3.new(14.8, 0.55, 0.62),
            CFrame.new(BARRICADE_CENTER + Vector3.new(0, 1.7 + (braceIndex + 1) * 1.4, 0))
                * CFrame.Angles(0, 0, math.rad(braceIndex * 6)),
            Color3.fromRGB(103, 72, 46),
            Enum.Material.WoodPlanks,
            false
        )
    end
    for supplyIndex = 1, 4 do
        part(
            barricadeFallback,
            "BarricadeLumber",
            Vector3.new(4.8 + supplyIndex * 0.45, 0.42, 0.58),
            CFrame.new(BARRICADE_CENTER + Vector3.new(-7.3, 0.45 + supplyIndex * 0.36, 2.6))
                * CFrame.Angles(0, math.rad(-8 + supplyIndex * 3), math.rad(2)),
            Color3.fromRGB(112, 78, 48),
            Enum.Material.WoodPlanks,
            false
        )
    end
    addBillboard(plot, "BARRICADE WORKSITE", CREAM, 18)
    for index = -1, 1, 2 do
        table.insert(self._meshPlacements, {
            assetId = "mesh_creator_barricade_a",
            fallbackKind = "asset_replacement",
            position = BARRICADE_CENTER + Vector3.new(index * 5.2, 0, 0),
            scale = 1.05,
            yaw = math.rad(index * 6),
            seed = 9900 + index,
            swayTag = nil,
            parent = interactables,
            fallbackInstance = if index < 0 then barricadeFallback else nil,
        })
    end
    table.insert(self._meshPlacements, {
        assetId = "mesh_creator_crate_a",
        fallbackKind = "asset_dressing",
        position = BARRICADE_CENTER + Vector3.new(-8, 0, 3.2),
        scale = 0.9,
        yaw = math.rad(-12),
        seed = 9903,
        swayTag = nil,
        parent = interactables,
        fallbackInstance = nil,
    })
    self:_registerInteraction(
        plot,
        self._runtimeIds.InteractionIds.Barricade,
        self._runtimeIds.Actions.Build,
        "BUILD",
        "Barricade",
        nil,
        nil,
        -- The plot is an 18 x 0.5 slab: almost impossible to hit, and the one
        -- interaction players reported as simply not working. The volume
        -- covers the whole worksite, posts and braces included.
        Vector3.new(20, 12, 12)
    )

    local firstLanternFallback = Instance.new("Model")
    firstLanternFallback.Name = "FirstLanternVisualFallback"
    firstLanternFallback.Parent = interactables

    -- The authored lantern carries its own stepped stone plinth, so the
    -- procedural block and steps belong to the fallback rather than standing
    -- permanently under it -- otherwise the town centre grows a second plinth
    -- the moment the mesh loads. They stay collidable while invisible, which
    -- is what keeps players able to walk up onto the dais either way, and
    -- lanternBase remains the interaction anchor exactly as before.
    --[[
        The shrine the lantern deserves.

        The owner's note: the First Lantern read as "a lantern in the middle
        of a road". The town's whole fiction hangs on this object -- it is
        the reason Emberhollow exists -- so it now stands in a built place: a
        two-ring walkable stone dais, four standing stones carrying amber
        shrine lamps at the diagonals (the street's line stays open north and
        south), and an inlaid amber ring in the paving. Everything here is a
        few parts, collidable only where a player can stand, and none of it
        moves the interaction anchor or the plinth the mesh sits on.
    ]]
    local shrineDais = part(
        firstLanternFallback,
        "ShrineDais",
        Vector3.new(19, 0.9, 19),
        CFrame.new(0, 0.45, TOWN_CENTER.Z) * CFrame.Angles(0, math.rad(45), 0),
        Color3.fromRGB(74, 78, 74),
        Enum.Material.Slate
    )
    shrineDais.CanQuery = false
    local shrineUpper = part(
        firstLanternFallback,
        "ShrineDaisUpper",
        Vector3.new(14, 0.8, 14),
        CFrame.new(0, 1.05, TOWN_CENTER.Z),
        Color3.fromRGB(84, 88, 82),
        Enum.Material.Slate
    )
    shrineUpper.CanQuery = false
    -- An inlaid ring, drawn as four thin bands along the rotated square's
    -- edges. The first pass used one full 11x11 neon plate, and on a real
    -- device that rendered as a blinding flat yellow square in the middle of
    -- the square -- the owner's screenshot, not a subtle inlay.
    for edge = 0, 3 do
        local along = edge % 2 == 0
        local shrineInlay = part(
            firstLanternFallback,
            "ShrineInlayRing",
            if along then Vector3.new(0.55, 0.1, 11) else Vector3.new(11, 0.1, 0.55),
            CFrame.new(0, 1.5, TOWN_CENTER.Z)
                * CFrame.Angles(0, math.rad(45), 0)
                * CFrame.new(
                    if along then (if edge == 0 then 5.225 else -5.225) else 0,
                    0,
                    if along then 0 else (if edge == 1 then 5.225 else -5.225)
                ),
            AMBER,
            Enum.Material.Neon,
            false
        )
        shrineInlay.Transparency = 0.4
        shrineInlay.CanQuery = false
        shrineInlay.CastShadow = false
        CollectionService:AddTag(shrineInlay, self._runtimeIds.AmbientLightTag)
    end
    for corner = 0, 3 do
        local angle = math.rad(45 + corner * 90)
        local offset = Vector3.new(math.cos(angle) * 10.5, 0, math.sin(angle) * 10.5)
        local pillar = part(
            firstLanternFallback,
            "ShrineStone",
            Vector3.new(1.4, 6.4, 1.4),
            CFrame.new(Vector3.new(0, 3.2, TOWN_CENTER.Z) + offset)
                * CFrame.Angles(math.rad(2), angle, math.rad(-2)),
            Color3.fromRGB(64, 70, 68),
            Enum.Material.Slate
        )
        pillar.CanQuery = false
        local cap = part(
            firstLanternFallback,
            "ShrineStoneCap",
            Vector3.new(1.8, 0.5, 1.8),
            CFrame.new(Vector3.new(0, 6.6, TOWN_CENTER.Z) + offset) * CFrame.Angles(0, angle, 0),
            Color3.fromRGB(52, 56, 55),
            Enum.Material.Slate,
            false
        )
        cap.CanQuery = false
        local lamp = part(
            firstLanternFallback,
            "ShrineLamp",
            Vector3.new(0.75, 0.75, 0.75),
            CFrame.new(Vector3.new(0, 7.25, TOWN_CENTER.Z) + offset),
            AMBER,
            Enum.Material.Neon,
            false
        )
        lamp.Shape = Enum.PartType.Ball
        lamp.CanQuery = false
        lamp.CastShadow = false
        local lampLight = Instance.new("PointLight")
        lampLight.Color = AMBER
        lampLight.Brightness = 1.4
        lampLight.Range = 16
        lampLight.Shadows = false
        lampLight.Parent = lamp
        CollectionService:AddTag(lamp, self._runtimeIds.AmbientLightTag)
    end
    local lanternBase = part(
        firstLanternFallback,
        "FirstLantern",
        Vector3.new(8, 3, 8),
        CFrame.new(0, 1.5, TOWN_CENTER.Z),
        Color3.fromRGB(67, 68, 61),
        Enum.Material.Slate
    )
    for stepIndex = 1, 3 do
        part(
            firstLanternFallback,
            "FirstLanternPlinth",
            Vector3.new(10.5 - stepIndex * 1.45, 0.52, 10.5 - stepIndex * 1.45),
            CFrame.new(0, 1.05 + stepIndex * 0.42, TOWN_CENTER.Z),
            if stepIndex % 2 == 0 then Color3.fromRGB(76, 79, 73) else Color3.fromRGB(61, 66, 62),
            Enum.Material.Slate
        )
    end
    for sideX = -1, 1, 2 do
        for sideZ = -1, 1, 2 do
            part(
                firstLanternFallback,
                "FirstLanternCagePost",
                Vector3.new(0.48, 6.2, 0.48),
                CFrame.new(sideX * 2.35, 5.7, TOWN_CENTER.Z + sideZ * 2.35)
                    * CFrame.Angles(0, 0, math.rad(sideX * sideZ * 4)),
                Color3.fromRGB(75, 72, 62),
                Enum.Material.Metal,
                false
            )
        end
    end
    for ringY = 3.1, 8.2, 5.1 do
        for side = -1, 1, 2 do
            part(
                firstLanternFallback,
                "FirstLanternCageBand",
                Vector3.new(5.2, 0.28, 0.28),
                CFrame.new(0, ringY, TOWN_CENTER.Z + side * 2.5),
                Color3.fromRGB(86, 76, 59),
                Enum.Material.Metal,
                false
            )
            part(
                firstLanternFallback,
                "FirstLanternCageBand",
                Vector3.new(0.28, 0.28, 5.2),
                CFrame.new(side * 2.5, ringY, TOWN_CENTER.Z),
                Color3.fromRGB(86, 76, 59),
                Enum.Material.Metal,
                false
            )
        end
    end
    for side = -1, 1, 2 do
        local frontGlass = part(
            firstLanternFallback,
            "FirstLanternGlassPanel",
            Vector3.new(4.35, 4.55, 0.13),
            CFrame.new(0, 5.65, TOWN_CENTER.Z + side * 2.34),
            Color3.fromRGB(205, 158, 91),
            Enum.Material.Glass,
            false
        )
        frontGlass.Transparency = 0.64
        local sideGlass = part(
            firstLanternFallback,
            "FirstLanternGlassPanel",
            Vector3.new(0.13, 4.55, 4.35),
            CFrame.new(side * 2.34, 5.65, TOWN_CENTER.Z),
            Color3.fromRGB(205, 158, 91),
            Enum.Material.Glass,
            false
        )
        sideGlass.Transparency = 0.64
        part(
            firstLanternFallback,
            "FirstLanternRainHood",
            Vector3.new(5.7, 0.34, 3.5),
            CFrame.new(0, 9.22, TOWN_CENTER.Z + side * 1.35)
                * CFrame.Angles(math.rad(side * 28), 0, 0),
            Color3.fromRGB(55, 57, 53),
            Enum.Material.Slate,
            false
        )
    end
    part(
        firstLanternFallback,
        "FirstLanternCrown",
        Vector3.new(0.42, 1.25, 0.42),
        CFrame.new(0, 10.35, TOWN_CENTER.Z) * CFrame.Angles(0, 0, math.rad(5)),
        Color3.fromRGB(73, 67, 57),
        Enum.Material.Metal,
        false
    )
    local flame = part(
        firstLanternFallback,
        "FirstLanternFlame",
        Vector3.new(1.05, 2.45, 0.82),
        CFrame.new(0, 5.65, TOWN_CENTER.Z) * CFrame.Angles(0, math.rad(18), 0),
        AMBER,
        Enum.Material.Neon,
        false
    )
    flame.Shape = Enum.PartType.Wedge

    --[[
        The lantern's fire lives outside the fallback on purpose.

        Everything above belongs to firstLanternFallback, which is exactly what
        hideProceduralPlaceholder blanks once the authored lantern loads: it
        sets Transparency to 1 and disables every Light beneath it. The flame
        used to be part of that, so lighting the First Lantern -- the object the
        entire night defense is built around, whose health this drives -- turned
        it dark instead of lighting it.

        This core sits at the height of the authored lantern's glass and stays
        visible whichever way the placement resolves, so self._lantern always
        points at something that can actually glow.
    ]]
    local lanternCore = part(
        interactables,
        "FirstLanternCore",
        Vector3.new(2.3, 3.1, 2.3),
        CFrame.new(0, 6.3, TOWN_CENTER.Z),
        AMBER,
        Enum.Material.Neon,
        false
    )
    lanternCore.Shape = Enum.PartType.Ball
    lanternCore.Transparency = 0.28
    lanternCore.CastShadow = false
    lanternCore.CanQuery = false
    local light = Instance.new("PointLight")
    light.Color = AMBER
    light.Brightness = 1.5
    light.Range = 30
    light.Shadows = true
    light.Parent = lanternCore
    addBillboard(lanternCore, "THE FIRST LANTERN", AMBER, 32)
    CollectionService:AddTag(lanternCore, self._runtimeIds.AmbientLightTag)
    self._lantern = lanternCore
    table.insert(self._meshPlacements, {
        assetId = "mesh_first_lantern_a",
        fallbackKind = "placeholder",
        -- Base slightly set into the 0.38-top square pad. At y = 0 the
        -- lantern's own authored plinth was swallowed by the pad and the
        -- town's centrepiece read almost a stud shorter than authored.
        -- Base atop the shrine dais (upper ring tops at 1.45).
        position = Vector3.new(0, 1.5, TOWN_CENTER.Z),
        scale = 0.95,
        yaw = math.rad(8),
        seed = 9314,
        swayTag = nil,
        parent = interactables,
        fallbackInstance = firstLanternFallback,
    })
    self:_registerInteraction(
        lanternBase,
        self._runtimeIds.InteractionIds.Lantern,
        self._runtimeIds.Actions.Prepare,
        "LIGHT",
        "First Lantern",
        nil,
        nil,
        Vector3.new(12, 16, 12)
    )

    -- The gate reads as a threshold you walk through on the way in, not a
    -- cage wrapped around the beacon. Sitting it at the same z as the beacon
    -- (both at -148) put the crossed braces directly around the glowing
    -- reliquary, which read as clutter crowding the memory orb. Pulling it
    -- 28 studs back to the start of the approach (before the path markers
    -- and steps that already lead up to the beacon) keeps the arch as an
    -- entrance and leaves the beacon itself uncluttered.
    -- The Dawn Gate arch used to stand at z -120, on the approach between the
    -- First Lantern (z -112) and the memory beacon (z -148) -- an owner
    -- playtest read it as clutter boxing in the walk between the two and
    -- asked for it gone outright. It is removed entirely rather than pushed
    -- somewhere else: mesh_creator_wood_arch_a stays registered in
    -- MeshAssetRegistry (its provenance and measurements are still real) but
    -- is no longer placed anywhere, the same status this codebase already
    -- gives other reviewed-but-unplaced assets.
    --
    -- The steps and path markers below lead a walker to the beacon; they are
    -- unrelated to the arch and are kept, only reseated (see the road-height
    -- comment on the beacon placement just below) so they are not buried
    -- under the road's raised visual skin.
    local approach = Instance.new("Folder")
    approach.Name = "BramblewakeDawnApproach"
    approach.Parent = interactables
    -- ROAD_SURFACE_Y matches the trail/wear-strip top computed in the
    -- Emberhollow road loop above (route base y 0.42 + wear offset 0.05 +
    -- half its 0.36 thickness, and the wear strip reaching to 0.42 + 2.05 +
    -- half its 0.12 thickness) -- anything at or below the old y~0.2-0.4
    -- authored here rendered buried under that raised visual skin.
    local ROAD_SURFACE_Y = 0.53
    for stepIndex = 1, 3 do
        part(
            approach,
            "DawnGateStep",
            Vector3.new(12 - stepIndex * 1.3, 0.45, 3.2),
            CFrame.new(0, ROAD_SURFACE_Y + stepIndex * 0.08, -140 - stepIndex * 2.2),
            Color3.fromRGB(66, 73, 68),
            Enum.Material.Slate
        )
    end
    for markerIndex = 1, 6 do
        local marker = part(
            approach,
            "DawnPathMarker",
            Vector3.new(0.72, 0.36, 0.72),
            CFrame.new(
                if markerIndex % 2 == 0 then 4.8 else -4.8,
                ROAD_SURFACE_Y,
                -114 - markerIndex * 4.3
            ),
            FOXFIRE,
            Enum.Material.Glass,
            false
        )
        marker.Shape = Enum.PartType.Ball
        marker.Transparency = 1
        marker.CastShadow = false
    end

    local beacon = part(
        interactables,
        "BramblewakeBeacon",
        Vector3.new(3.4, 5.4, 3.4),
        CFrame.new(0, 3.9, -148),
        Color3.fromRGB(104, 187, 166),
        Enum.Material.Glass,
        false
    )
    beacon.Shape = Enum.PartType.Ball
    beacon.Transparency = 1
    beacon.CanQuery = false
    self._beacon = beacon
    -- The gameplay beacon remains an invisible interaction anchor. The visible
    -- object is a thumbnail-reviewed crystal reliquary placed through
    -- MeshTemplateLoader below; this fallback only appears if the reviewed
    -- model cannot load.
    --
    -- Reseated from y 0.25 (and every fallback part below raised by the same
    -- +2.2 delta): the road's raised visual skin (see ROAD_SURFACE_Y above)
    -- buried roughly the bottom two studs of the vessel and the six
    -- DawnPathMarker/DawnGateStep parts that lead to it -- what read as a
    -- dark half-buried wall/sign on a phone was this reliquary, not a
    -- separate object.
    local beaconFallback = Instance.new("Model")
    beaconFallback.Name = "MemoryReliquaryFallback"
    beaconFallback.Parent = interactables
    local beaconCradle = part(
        beaconFallback,
        "BeaconCradleMount",
        Vector3.new(0.34, 3.6, 0.34),
        CFrame.new(0, 12.6, -148),
        Color3.fromRGB(47, 50, 52),
        Enum.Material.Metal,
        false
    )
    beaconCradle.CanQuery = false
    for armIndex = 0, 3 do
        local armAngle = (armIndex / 4) * math.pi * 2
        local arm = part(
            beaconFallback,
            "BeaconCradleArm",
            Vector3.new(0.26, 2.9, 0.26),
            CFrame.new(0, 10.25, -148)
                * CFrame.Angles(0, armAngle, 0)
                * CFrame.new(0, 0, -1.5)
                * CFrame.Angles(math.rad(26), 0, 0),
            Color3.fromRGB(47, 50, 52),
            Enum.Material.Metal,
            false
        )
        arm.CanQuery = false
    end
    local beaconCollar = part(
        beaconFallback,
        "BeaconCradleCollar",
        Vector3.new(0.3, 2.9, 2.9),
        CFrame.new(0, 10.8, -148) * CFrame.Angles(0, 0, math.rad(90)),
        Color3.fromRGB(47, 50, 52),
        Enum.Material.Metal,
        false
    )
    beaconCollar.Shape = Enum.PartType.Cylinder
    beaconCollar.CanQuery = false
    --[[
        The memory orb itself, and the reason the reliquary read as broken.

        This lens is the orb a player sees resting in the vessel. It used to
        live inside beaconFallback, so hideProceduralPlaceholder blanked it the
        moment the reviewed reliquary mesh loaded -- and that mesh was
        deliberately generated as an *empty* vessel, because "both placements
        supply their own light". The only other thing in the cradle is
        BeaconCore, which is held at Transparency 1 until the dawn reveal. So
        for the entire tutorial the vessel stood on the road holding nothing:
        the owner's report was literally "the memory orb was gone".

        Hoisted out of the fallback and made a sibling, exactly like BeaconCore
        and FirstLanternCore before it. The orb is always in the vessel. What
        the dawn reveal changes is that it catches fire, not that it appears.
    ]]
    local beaconLens = part(
        interactables,
        "BeaconLens",
        Vector3.new(1.9, 1.9, 1.9),
        CFrame.new(0, 7.6, -148),
        FOXFIRE,
        Enum.Material.Glass,
        false
    )
    -- A sphere, not the cylinder this used to be. The cylinder was shaped to
    -- sit between the fallback's four cradle arms, and those arms are exactly
    -- what the authored mesh replaces -- so on the real vessel it read as a
    -- bucket balanced on the rim. Seated at 7.6 it nests into the mouth of the
    -- vessel (which tops out at 7.9) with its upper half proud.
    beaconLens.Shape = Enum.PartType.Ball
    beaconLens.Transparency = 0.42
    beaconLens.CastShadow = false
    beaconLens.CanQuery = false
    self._beaconLens = beaconLens
    --[[
        The beacon's fire lives outside the fallback on purpose, exactly like
        FirstLanternCore above.

        BeaconFallbackFlame used to live inside beaconFallback, which is
        exactly what hideProceduralPlaceholder blanks the moment the reviewed
        reliquary mesh loads -- the mesh itself was deliberately generated
        as an empty, unlit glass vessel ("both placements supply their own
        light"), so the moment the fallback flame vanished, nothing was left
        to light it. This core sits at the vessel's glass height and stays
        visible whichever way the placement resolves.
    ]]
    local beaconCore = part(
        interactables,
        "BeaconCore",
        Vector3.new(0.72, 1.55, 0.64),
        CFrame.new(0, 8.38, -148) * CFrame.Angles(0, math.rad(18), 0),
        FOXFIRE,
        Enum.Material.Neon,
        false
    )
    beaconCore.Shape = Enum.PartType.Wedge
    beaconCore.CastShadow = false
    beaconCore.CanQuery = false
    -- Hidden until the dawn reveal, same as the invisible anchor's own light
    -- below -- the beacon must not glow before First Light finishes.
    beaconCore.Transparency = 1
    local beaconCoreLight = Instance.new("PointLight")
    beaconCoreLight.Color = FOXFIRE
    beaconCoreLight.Brightness = 1.6
    beaconCoreLight.Range = 26
    beaconCoreLight.Shadows = false
    beaconCoreLight.Enabled = false
    beaconCoreLight.Parent = beaconCore
    self._beaconCore = beaconCore
    table.insert(self._meshPlacements, {
        assetId = "mesh_memory_reliquary_a",
        fallbackKind = "asset_replacement",
        position = Vector3.new(0, ROAD_SURFACE_Y, -148),
        scale = 1,
        yaw = math.pi,
        seed = 9911,
        swayTag = nil,
        parent = interactables,
        fallbackInstance = beaconFallback,
    })
    self:_registerInteraction(
        beacon,
        self._runtimeIds.InteractionIds.Beacon,
        self._runtimeIds.Actions.Reveal,
        "REMEMBER",
        "Bramblewake",
        nil,
        nil,
        Vector3.new(11, 14, 11)
    )
    local beaconPrompt = self._interactions[self._runtimeIds.InteractionIds.Beacon]
    beaconPrompt.Enabled = false

    local workshop = Instance.new("Folder")
    workshop.Name = "GreenwardWorkshop"
    workshop.Parent = interactables
    local workshopZ = -142
    local function workshopBay(centerX: number, title: string, accent: Color3)
        part(
            workshop,
            "WorkshopFloor",
            Vector3.new(27, 0.45, 14),
            CFrame.new(centerX, 0.22, workshopZ),
            Color3.fromRGB(73, 57, 42),
            Enum.Material.WoodPlanks
        )
        part(
            workshop,
            "WorkshopBackWall",
            Vector3.new(27, 7.4, 0.7),
            CFrame.new(centerX, 3.7, workshopZ - 6.65),
            BARK,
            Enum.Material.WoodPlanks
        )
        for side = -1, 1, 2 do
            part(
                workshop,
                "WorkshopSideWall",
                Vector3.new(0.7, 7.4, 14),
                CFrame.new(centerX + side * 13.15, 3.7, workshopZ),
                BARK,
                Enum.Material.WoodPlanks
            )
            part(
                workshop,
                "WorkshopFrontPost",
                Vector3.new(0.9, 8, 0.9),
                CFrame.new(centerX + side * 12.7, 4, workshopZ + 6.65),
                WET_BARK,
                Enum.Material.Wood
            )
        end
        part(
            workshop,
            "WorkshopFrontBeam",
            Vector3.new(27, 0.9, 0.9),
            CFrame.new(centerX, 7.45, workshopZ + 6.65),
            WET_BARK,
            Enum.Material.Wood
        )
        for slope = -1, 1, 2 do
            part(
                workshop,
                "WorkshopRoof",
                Vector3.new(29, 0.72, 8.4),
                CFrame.new(centerX, 8.3, workshopZ + slope * 3.55)
                    * CFrame.Angles(math.rad(slope * 8), 0, 0),
                Color3.fromRGB(42, 47, 43),
                Enum.Material.Slate
            )
        end
        part(
            workshop,
            "WorkshopShelf",
            Vector3.new(21, 0.4, 2.1),
            CFrame.new(centerX, 3.2, workshopZ - 5.25),
            Color3.fromRGB(91, 65, 45),
            Enum.Material.WoodPlanks
        )
        for supplyIndex = 1, 4 do
            local supply = part(
                workshop,
                "WorkshopSupply",
                Vector3.new(2.3, 1.4 + (supplyIndex % 2) * 0.5, 1.6),
                CFrame.new(centerX - 8.2 + supplyIndex * 3.3, 4.1, workshopZ - 5.2),
                if supplyIndex % 2 == 0 then accent else Color3.fromRGB(103, 78, 52),
                if supplyIndex % 2 == 0 then Enum.Material.Fabric else Enum.Material.WoodPlanks,
                false
            )
            supply.CanQuery = false
        end
        for crateIndex = -1, 1, 2 do
            local crate = part(
                workshop,
                "WorkshopCrate",
                Vector3.new(3.1, 2.4, 3),
                CFrame.new(centerX + crateIndex * 9.5, 1.2, workshopZ - 4.1),
                Color3.fromRGB(88, 64, 43),
                Enum.Material.WoodPlanks,
                false
            )
            crate.CanQuery = false
        end
        local lamp = part(
            workshop,
            "WorkshopLamp",
            Vector3.new(1.25, 1.65, 1.25),
            CFrame.new(centerX, 6.5, workshopZ + 3.9),
            accent,
            Enum.Material.Glass,
            false
        )
        lamp.Shape = Enum.PartType.Ball
        lamp.Transparency = 0.14
        local lampLight = Instance.new("PointLight")
        lampLight.Color = accent
        lampLight.Brightness = 1.5
        lampLight.Range = 21
        lampLight.Shadows = false
        lampLight.Parent = lamp
        -- The bay's back wall is at workshopZ - 6.65 and its open front at
        -- workshopZ + 6.65, so a sign behind the back wall faces away from the
        -- players walking in. Stand it beside the entrance, turned to face the
        -- arrival direction like every other labelSign in this file.
        labelSign(
            workshop,
            CFrame.new(centerX - 10.5, 3.2, workshopZ + 8.6) * CFrame.Angles(0, math.pi, 0),
            title
        )
    end
    workshopBay(-42, "ROOTWORKS", Color3.fromRGB(133, 176, 108))
    workshopBay(42, "OUTFITTER", AMBER)
    for index, centerX in { -42, 42 } do
        table.insert(self._meshPlacements, {
            assetId = "mesh_creator_market_stall_a",
            fallbackKind = "asset_replacement",
            position = Vector3.new(centerX, 0, workshopZ),
            scale = 1.15,
            yaw = 0,
            seed = 9920 + index,
            swayTag = nil,
            parent = interactables,
            fallbackInstance = if index == 1 then workshop else nil,
        })
    end

    local craftingFallback = Instance.new("Model")
    craftingFallback.Name = "CraftingDisplayFallback"
    craftingFallback.Parent = interactables
    local craftingBenches = {
        {
            id = self._runtimeIds.InteractionIds.CraftMeadowSatchel,
            recipeId = "recipe_meadow_satchel",
            label = "MEADOW SATCHEL",
            x = -48,
            color = Color3.fromRGB(133, 176, 108),
        },
        {
            id = self._runtimeIds.InteractionIds.CraftAmberCharm,
            recipeId = "recipe_amber_charm",
            label = "AMBER CHARM",
            x = 36,
            color = AMBER,
        },
        {
            id = self._runtimeIds.InteractionIds.CraftIronrootHood,
            recipeId = "recipe_ironroot_hood",
            label = "IRONROOT HOOD",
            x = -36,
            color = Color3.fromRGB(122, 148, 132),
        },
        {
            id = self._runtimeIds.InteractionIds.CraftBrambleBoots,
            recipeId = "recipe_bramble_boots",
            label = "BRAMBLE BOOTS",
            x = 48,
            color = Color3.fromRGB(142, 112, 84),
        },
        {
            id = self._runtimeIds.InteractionIds.CraftThornwoodBow,
            recipeId = "recipe_thornwood_bow",
            label = "THORNWOOD BOW",
            x = -60,
            color = Color3.fromRGB(164, 132, 78),
        },
        -- The five other weapon families, filling the row outward from the
        -- original five benches. Same shared bench construction; each gets
        -- its own sample silhouette below so the row reads as ten different
        -- crafts rather than ten copies of one table.
        {
            id = self._runtimeIds.InteractionIds.CraftHeartwoodMaul,
            recipeId = "recipe_heartwood_maul",
            label = "HEARTWOOD MAUL",
            x = -72,
            color = Color3.fromRGB(139, 98, 54),
        },
        {
            id = self._runtimeIds.InteractionIds.CraftBriarLance,
            recipeId = "recipe_briar_lance",
            label = "BRIAR LANCE",
            x = -24,
            color = Color3.fromRGB(104, 128, 68),
        },
        {
            id = self._runtimeIds.InteractionIds.CraftFoxfireSling,
            recipeId = "recipe_foxfire_sling",
            label = "FOXFIRE SLING",
            x = 24,
            color = Color3.fromRGB(94, 206, 176),
        },
        {
            id = self._runtimeIds.InteractionIds.CraftAmberEdge,
            recipeId = "recipe_amber_edge",
            label = "AMBER EDGE",
            x = 60,
            color = Color3.fromRGB(255, 181, 76),
        },
        {
            id = self._runtimeIds.InteractionIds.CraftWardenCudgel,
            recipeId = "recipe_warden_cudgel",
            label = "WARDEN CUDGEL",
            x = 72,
            color = Color3.fromRGB(112, 151, 119),
        },
    }
    for _, definition in craftingBenches do
        local display = Instance.new("Model")
        display.Name = "CraftingDisplay_" .. definition.recipeId
        display:SetAttribute("RecipeId", definition.recipeId)
        display:SetAttribute("DisplayKind", "physical_recipe_sample")
        display.Parent = craftingFallback
        local bench = part(
            display,
            "CraftingBench_" .. definition.recipeId,
            Vector3.new(6, 2.6, 6),
            CFrame.new(definition.x, 1.3, workshopZ),
            Color3.fromRGB(66, 70, 65),
            Enum.Material.Slate
        )
        bench.Transparency = 1
        bench.CanCollide = false
        bench.CastShadow = false
        part(
            display,
            "CraftingTableTop",
            Vector3.new(6.4, 0.55, 4.8),
            CFrame.new(definition.x, 3.15, workshopZ),
            Color3.fromRGB(91, 64, 44),
            Enum.Material.WoodPlanks
        )
        for side = -1, 1, 2 do
            for depth = -1, 1, 2 do
                part(
                    display,
                    "CraftingTableLeg",
                    Vector3.new(0.55, 3.15, 0.55),
                    CFrame.new(definition.x + side * 2.65, 1.57, workshopZ + depth * 1.85)
                        * CFrame.Angles(0, 0, math.rad(side * 3)),
                    WET_BARK,
                    Enum.Material.Wood
                )
            end
        end
        part(
            display,
            "CraftingWorkbenchApron",
            Vector3.new(5.4, 0.75, 0.42),
            CFrame.new(definition.x, 2.55, workshopZ + 2.18),
            Color3.fromRGB(68, 48, 36),
            Enum.Material.Wood,
            false
        )
        local marker = part(
            display,
            "CraftingBenchGlow",
            Vector3.new(2, 3.4, 2),
            CFrame.new(definition.x, 4.3, workshopZ),
            definition.color,
            Enum.Material.Neon,
            false
        )
        marker.Shape = if definition.recipeId == "recipe_amber_charm"
            then Enum.PartType.Ball
            elseif definition.recipeId == "recipe_ironroot_hood" then Enum.PartType.Wedge
            else Enum.PartType.Block
        marker.Size = if definition.recipeId == "recipe_meadow_satchel"
            then Vector3.new(2.6, 1.7, 1.2)
            elseif definition.recipeId == "recipe_bramble_boots" then Vector3.new(
                2.2,
                1.2,
                1.8
            )
            else Vector3.new(1.8, 1.8, 1.8)
        marker.Material = if definition.recipeId == "recipe_meadow_satchel"
                or definition.recipeId == "recipe_ironroot_hood"
            then Enum.Material.Fabric
            elseif definition.recipeId == "recipe_bramble_boots" then Enum.Material.Leather
            else Enum.Material.Glass
        marker.Transparency = 0.06
        if definition.recipeId == "recipe_meadow_satchel" then
            part(
                display,
                "SatchelFlap",
                Vector3.new(2.35, 0.32, 1.1),
                CFrame.new(definition.x, 4.72, workshopZ + 0.36) * CFrame.Angles(math.rad(18), 0, 0),
                Color3.fromRGB(103, 128, 84),
                Enum.Material.Fabric,
                false
            )
            for strapSide = -1, 1, 2 do
                part(
                    display,
                    "SatchelStrap",
                    Vector3.new(0.22, 2.4, 0.22),
                    CFrame.new(definition.x + strapSide * 1.05, 4.65, workshopZ - 0.2)
                        * CFrame.Angles(0, 0, math.rad(strapSide * 24)),
                    Color3.fromRGB(78, 58, 41),
                    Enum.Material.Fabric,
                    false
                )
            end
        elseif definition.recipeId == "recipe_amber_charm" then
            local charmRing = part(
                display,
                "AmberCharmRing",
                Vector3.new(0.32, 2.4, 2.4),
                CFrame.new(definition.x, 4.55, workshopZ) * CFrame.Angles(0, math.rad(90), 0),
                Color3.fromRGB(126, 97, 54),
                Enum.Material.Metal,
                false
            )
            charmRing.Shape = Enum.PartType.Cylinder
            part(
                display,
                "AmberCharmCord",
                Vector3.new(0.2, 1.7, 0.2),
                CFrame.new(definition.x, 5.8, workshopZ),
                Color3.fromRGB(73, 54, 38),
                Enum.Material.Fabric,
                false
            )
        elseif definition.recipeId == "recipe_ironroot_hood" then
            part(
                display,
                "HoodShoulders",
                Vector3.new(3.6, 0.55, 1.45),
                CFrame.new(definition.x, 3.82, workshopZ),
                Color3.fromRGB(75, 91, 81),
                Enum.Material.Fabric,
                false
            )
            part(
                display,
                "HoodStand",
                Vector3.new(0.34, 2.5, 0.34),
                CFrame.new(definition.x, 4.45, workshopZ),
                Color3.fromRGB(76, 55, 39),
                Enum.Material.Wood,
                false
            )
        elseif definition.recipeId == "recipe_bramble_boots" then
            -- Explicit, no longer the chain's else: the fallthrough put a
            -- pair of boots on every bench without its own branch -- the bow
            -- bench had displayed boots since it shipped, and all five new
            -- weapon benches would have inherited the same pair.
            for bootSide = -1, 1, 2 do
                part(
                    display,
                    "BrambleBoot",
                    Vector3.new(0.92, 1.45, 1.9),
                    CFrame.new(definition.x + bootSide * 0.72, 4.05, workshopZ + 0.28)
                        * CFrame.Angles(0, math.rad(bootSide * 8), 0),
                    Color3.fromRGB(103, 76, 54),
                    Enum.Material.Leather,
                    false
                )
            end
        elseif definition.recipeId == "recipe_thornwood_bow" then
            part(
                display,
                "BowSampleStave",
                Vector3.new(0.3, 3, 0.5),
                CFrame.new(definition.x + 0.35, 4.6, workshopZ) * CFrame.Angles(0, 0, math.rad(14)),
                Color3.fromRGB(112, 84, 52),
                Enum.Material.Wood,
                false
            )
            part(
                display,
                "BowSampleString",
                Vector3.new(0.08, 2.8, 0.08),
                CFrame.new(definition.x - 0.45, 4.6, workshopZ),
                Color3.fromRGB(214, 205, 186),
                Enum.Material.Fabric,
                false
            )
        elseif definition.recipeId == "recipe_heartwood_maul" then
            part(
                display,
                "MaulSampleHaft",
                Vector3.new(0.4, 3.1, 0.4),
                CFrame.new(definition.x, 4.55, workshopZ) * CFrame.Angles(0, 0, math.rad(-18)),
                Color3.fromRGB(96, 68, 44),
                Enum.Material.Wood,
                false
            )
            part(
                display,
                "MaulSampleHead",
                Vector3.new(1.9, 1.15, 1.15),
                CFrame.new(definition.x + 0.5, 5.9, workshopZ) * CFrame.Angles(0, 0, math.rad(-18)),
                Color3.fromRGB(139, 98, 54),
                Enum.Material.Wood,
                false
            )
        elseif definition.recipeId == "recipe_briar_lance" then
            part(
                display,
                "LanceSampleShaft",
                Vector3.new(0.32, 4.4, 0.32),
                CFrame.new(definition.x, 4.9, workshopZ) * CFrame.Angles(0, 0, math.rad(24)),
                Color3.fromRGB(104, 128, 68),
                Enum.Material.Wood,
                false
            )
            local lanceTip = part(
                display,
                "LanceSampleTip",
                Vector3.new(0.5, 1.1, 0.5),
                CFrame.new(definition.x - 0.95, 6.85, workshopZ) * CFrame.Angles(0, 0, math.rad(24)),
                Color3.fromRGB(74, 96, 46),
                Enum.Material.Wood,
                false
            )
            lanceTip.Shape = Enum.PartType.Wedge
        elseif definition.recipeId == "recipe_foxfire_sling" then
            part(
                display,
                "SlingSampleStrap",
                Vector3.new(0.22, 2.6, 0.22),
                CFrame.new(definition.x, 4.7, workshopZ) * CFrame.Angles(0, 0, math.rad(32)),
                Color3.fromRGB(78, 58, 41),
                Enum.Material.Fabric,
                false
            )
            local slingPouch = part(
                display,
                "SlingSamplePouch",
                Vector3.new(0.95, 0.7, 0.95),
                CFrame.new(definition.x - 0.75, 3.75, workshopZ),
                Color3.fromRGB(94, 206, 176),
                Enum.Material.Fabric,
                false
            )
            slingPouch.Shape = Enum.PartType.Ball
        elseif definition.recipeId == "recipe_amber_edge" then
            local edgeBlade = part(
                display,
                "EdgeSampleBlade",
                Vector3.new(0.35, 2.5, 0.9),
                CFrame.new(definition.x + 0.2, 4.95, workshopZ) * CFrame.Angles(0, 0, math.rad(-9)),
                Color3.fromRGB(255, 197, 106),
                Enum.Material.Glass,
                false
            )
            edgeBlade.Shape = Enum.PartType.Wedge
            part(
                display,
                "EdgeSampleGrip",
                Vector3.new(0.42, 1.05, 0.42),
                CFrame.new(definition.x - 0.15, 3.6, workshopZ) * CFrame.Angles(0, 0, math.rad(-9)),
                Color3.fromRGB(73, 54, 38),
                Enum.Material.Leather,
                false
            )
        else
            -- recipe_warden_cudgel and any future recipe without its own
            -- silhouette yet: a club on a rest, not somebody else's boots.
            part(
                display,
                "CudgelSampleShaft",
                Vector3.new(0.45, 2.7, 0.45),
                CFrame.new(definition.x, 4.5, workshopZ) * CFrame.Angles(0, 0, math.rad(12)),
                Color3.fromRGB(91, 62, 40),
                Enum.Material.Wood,
                false
            )
            local cudgelHead = part(
                display,
                "CudgelSampleHead",
                Vector3.new(1, 1, 1),
                CFrame.new(definition.x - 0.35, 5.85, workshopZ),
                Color3.fromRGB(112, 151, 119),
                Enum.Material.Wood,
                false
            )
            cudgelHead.Shape = Enum.PartType.Ball
        end
        local markerLight = Instance.new("PointLight")
        markerLight.Color = definition.color
        markerLight.Brightness = 1.15
        markerLight.Range = 14
        markerLight.Parent = marker
        addBillboard(marker, definition.label, definition.color)
        self:_registerInteraction(
            bench,
            definition.id,
            self._runtimeIds.Actions.CraftItem,
            "CRAFT",
            definition.label,
            definition.recipeId
        )
    end
    for index, centerX in { -42, 42 } do
        table.insert(self._meshPlacements, {
            assetId = "mesh_creator_workbench_a",
            fallbackKind = "asset_replacement",
            position = Vector3.new(centerX, 0, workshopZ + 1.5),
            scale = 0.95,
            yaw = math.pi,
            seed = 9930 + index,
            swayTag = nil,
            parent = interactables,
            fallbackInstance = if index == 1 then craftingFallback else nil,
        })
    end

    -- North-west of the gate rather than at the west tower's base, where the
    -- board stood in the scaffold's lap and its header read as tower junk.
    local archiveX = -26
    local archiveZ = -120
    local archiveFallback = Instance.new("Model")
    archiveFallback.Name = "ArchiveVisualFallback"
    archiveFallback.Parent = interactables
    local archive = part(
        archiveFallback,
        "GreenwardArchive",
        Vector3.new(9, 6, 1),
        CFrame.new(archiveX, 3, archiveZ),
        BARK,
        Enum.Material.WoodPlanks
    )
    for side = -1, 1, 2 do
        part(
            archiveFallback,
            "ArchivePost",
            Vector3.new(0.75, 8.2, 0.75),
            CFrame.new(archiveX + side * 5.1, 4.1, archiveZ - 0.1)
                * CFrame.Angles(0, 0, math.rad(side * 3)),
            WET_BARK,
            Enum.Material.Wood
        )
        part(
            archiveFallback,
            "ArchiveShelf",
            Vector3.new(3.8, 0.42, 1.9),
            CFrame.new(archiveX + side * 2.2, 1.65, archiveZ + 0.75),
            Color3.fromRGB(91, 65, 44),
            Enum.Material.WoodPlanks,
            false
        )
    end
    part(
        archiveFallback,
        "ArchiveCanopy",
        Vector3.new(12.2, 0.62, 4.1),
        CFrame.new(archiveX, 7.5, archiveZ + 0.6) * CFrame.Angles(math.rad(-6), 0, 0),
        Color3.fromRGB(47, 53, 48),
        Enum.Material.Slate,
        false
    )
    -- "FIELD BOOK" and nothing more: it is the name every prompt and HUD
    -- button already uses, and the previous five-word title shrank to
    -- unreadable wrapped mush on the header plank.
    WorldSignBuilder.dressNoticeBoard(archive, "FIELD BOOK", CREAM, {
        "field_botany",
        "evacuation_route",
        "bramble_hazard",
        "lantern_maintenance",
        "supply_inventory",
    })
    table.insert(self._meshPlacements, {
        assetId = "mesh_creator_notice_board_a",
        fallbackKind = "asset_replacement",
        position = Vector3.new(archiveX, 0, archiveZ),
        scale = 1.05,
        yaw = 0,
        seed = 9940,
        swayTag = nil,
        parent = interactables,
        fallbackInstance = archiveFallback,
    })
    self:_registerInteraction(
        archive,
        self._runtimeIds.InteractionIds.QuestBoard,
        self._runtimeIds.Actions.OpenFieldBook,
        "OPEN",
        "Field Book",
        nil
    )

    local masteryGrove = Instance.new("Folder")
    masteryGrove.Name = "GreenwardMasteryGrove"
    masteryGrove.Parent = interactables
    local professionAltars = {
        {
            center = Vector3.new(-78, 0, -76),
            color = FOXFIRE,
            name = "SCOUT",
            paths = {
                { id = "specialization_pathfinder", name = "PATHFINDER" },
                { id = "specialization_foxfire_trapper", name = "FOXFIRE TRAPPER" },
                { id = "specialization_trailseer", name = "TRAILSEER" },
            },
        },
        {
            center = Vector3.new(78, 0, -76),
            color = Color3.fromRGB(112, 151, 119),
            name = "WARDEN",
            paths = {
                { id = "specialization_bulwark", name = "BULWARK" },
                { id = "specialization_greenkeeper", name = "GREENKEEPER" },
                { id = "specialization_oathbound", name = "OATHBOUND" },
            },
        },
        {
            center = Vector3.new(-78, 0, -168),
            color = Color3.fromRGB(191, 137, 73),
            name = "ENGINEER",
            paths = {
                { id = "specialization_lamplighter", name = "LAMPLIGHTER" },
                { id = "specialization_rootwright", name = "ROOTWRIGHT" },
                { id = "specialization_salvager", name = "SALVAGER" },
            },
        },
        {
            center = Vector3.new(78, 0, -168),
            color = Color3.fromRGB(176, 108, 112),
            name = "MEDIC",
            paths = {
                { id = "specialization_dawnmender", name = "DAWNMENDER" },
                { id = "specialization_wayhome_tender", name = "WAYHOME TENDER" },
                { id = "specialization_brightcap_herbalist", name = "BRIGHTCAP HERBALIST" },
            },
        },
        --[[
            The roster's last three shrines grow the grove along its own
            columns: the Alchemist fills the west column's empty middle row,
            and the Beastkeeper and Runebinder open a third row to the
            south, toward the Watch Ring. All three centres were checked
            against every authored building footprint and placement before
            being chosen -- the nearest neighbours are the Lantern Workbench
            (92, -126) and the Waterworks (110, -212), both comfortably
            clear. Colors match each profession's ability visual.
        ]]
        {
            center = Vector3.new(-78, 0, -122),
            color = Color3.fromRGB(154, 187, 92),
            name = "ALCHEMIST",
            paths = {
                { id = "specialization_brewer", name = "BREWER" },
                { id = "specialization_catalyst", name = "CATALYST" },
                { id = "specialization_forager", name = "FORAGER" },
            },
        },
        {
            center = Vector3.new(78, 0, -214),
            color = Color3.fromRGB(196, 120, 60),
            name = "BEASTKEEPER",
            paths = {
                { id = "specialization_handler", name = "HANDLER" },
                { id = "specialization_bondkeeper", name = "BONDKEEPER" },
                { id = "specialization_wildspeaker", name = "WILDSPEAKER" },
            },
        },
        {
            center = Vector3.new(-78, 0, -214),
            color = Color3.fromRGB(132, 150, 224),
            name = "RUNEBINDER",
            paths = {
                { id = "specialization_scribe", name = "SCRIBE" },
                { id = "specialization_channeler", name = "CHANNELER" },
                { id = "specialization_veilwalker", name = "VEILWALKER" },
            },
        },
    }
    local authoredInteractionIds = {}
    local authoredInteractionCount = 0
    for _, altar in professionAltars do
        for _, path in altar.paths do
            local interactionId = "mastery_" .. path.id
            assert(
                authoredInteractionIds[interactionId] == nil,
                "duplicate authored mastery interaction ID: " .. interactionId
            )
            authoredInteractionIds[interactionId] = true
            authoredInteractionCount += 1
        end
    end
    assert(
        authoredInteractionCount == #self._runtimeIds.ProfessionSpecializationInteractionIds,
        "mastery grove and runtime interaction catalogs differ in size"
    )
    for _, interactionId in self._runtimeIds.ProfessionSpecializationInteractionIds do
        assert(
            authoredInteractionIds[interactionId] == true,
            "mastery grove is missing runtime interaction ID: " .. interactionId
        )
    end
    for _, altar in professionAltars do
        local dais = part(
            masteryGrove,
            altar.name .. "MasteryDais",
            Vector3.new(13, 0.8, 8),
            CFrame.new(altar.center + Vector3.new(0, 0.4, 0)),
            Color3.fromRGB(62, 64, 57),
            Enum.Material.Slate
        )
        for ring = 1, 2 do
            local rootRing = part(
                masteryGrove,
                altar.name .. "RootRing",
                Vector3.new(13.6 + ring, 0.28, 8.6 + ring),
                CFrame.new(altar.center + Vector3.new(0, 0.7 + ring * 0.12, 0)),
                if ring == 1 then BARK else MOSS,
                if ring == 1 then Enum.Material.Wood else Enum.Material.Ground,
                false
            )
            rootRing.CanQuery = false
        end
        -- A dais, two flat rings and a sign is not a hero location. The
        -- standard forbids shipping an interaction as a plain block, pedestal,
        -- orb, or ring, and this was all four at once. Every anchor below
        -- keeps its name, attributes, and interaction IDs; what follows is
        -- physical construction wrapped around them so a mastery clearing
        -- reads as a built shrine rather than decoration on the floor.
        local shrineBase = CFrame.new(altar.center)
        for postX = -1, 1, 2 do
            for postZ = -1, 1, 2 do
                local post = part(
                    masteryGrove,
                    altar.name .. "MasteryPost",
                    Vector3.new(0.85, 9.2, 0.85),
                    shrineBase
                        * CFrame.new(postX * 6.4, 4.6, postZ * 3.9)
                        * CFrame.Angles(0, 0, math.rad(postX * 1.5)),
                    WET_BARK,
                    Enum.Material.Wood,
                    false
                )
                post.CanQuery = false
                local brace = part(
                    masteryGrove,
                    altar.name .. "MasteryBrace",
                    Vector3.new(0.5, 3.1, 0.5),
                    shrineBase
                        * CFrame.new(postX * 5.6, 7.6, postZ * 3.3)
                        * CFrame.Angles(math.rad(postZ * 34), 0, math.rad(-postX * 30)),
                    BARK,
                    Enum.Material.Wood,
                    false
                )
                brace.CanQuery = false
            end
        end
        for beamZ = -1, 1, 2 do
            local beam = part(
                masteryGrove,
                altar.name .. "MasteryBeam",
                Vector3.new(14.2, 0.7, 0.7),
                shrineBase * CFrame.new(0, 9.05, beamZ * 3.9),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
            beam.CanQuery = false
        end
        for roofSide = -1, 1, 2 do
            local roof = part(
                masteryGrove,
                altar.name .. "MasteryCanopy",
                Vector3.new(15, 0.42, 5.4),
                shrineBase
                    * CFrame.new(0, 10.1, roofSide * 2.05)
                    * CFrame.Angles(math.rad(roofSide * 21), 0, 0),
                Color3.fromRGB(47, 53, 48),
                Enum.Material.Slate,
                false
            )
            roof.CanQuery = false
        end
        local ridge = part(
            masteryGrove,
            altar.name .. "MasteryRidge",
            Vector3.new(15.4, 0.5, 0.5),
            shrineBase * CFrame.new(0, 11.1, 0),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
        ridge.CanQuery = false
        -- Profession colour belongs on cloth, not on a glowing shape.
        local banner = part(
            masteryGrove,
            altar.name .. "MasteryBanner",
            Vector3.new(4.6, 5.4, 0.16),
            shrineBase * CFrame.new(0, 5.6, 3.72) * CFrame.Angles(math.rad(2), 0, 0),
            altar.color,
            Enum.Material.Fabric,
            false
        )
        banner.CanQuery = false
        local bannerRod = part(
            masteryGrove,
            altar.name .. "MasteryBannerRod",
            Vector3.new(5.4, 0.24, 0.24),
            shrineBase * CFrame.new(0, 8.35, 3.72),
            Color3.fromRGB(47, 50, 52),
            Enum.Material.Metal,
            false
        )
        bannerRod.CanQuery = false
        -- Somewhere to actually work, with the craft laid out on it.
        local bench = part(
            masteryGrove,
            altar.name .. "MasteryBench",
            Vector3.new(6.4, 0.42, 1.9),
            shrineBase * CFrame.new(-3.4, 3.05, 2.5),
            Color3.fromRGB(96, 68, 45),
            Enum.Material.WoodPlanks,
            false
        )
        bench.CanQuery = false
        for legX = -1, 1, 2 do
            local benchLeg = part(
                masteryGrove,
                altar.name .. "MasteryBenchLeg",
                Vector3.new(0.34, 2.7, 0.34),
                shrineBase * CFrame.new(-3.4 + legX * 2.7, 1.7, 2.5),
                BARK,
                Enum.Material.Wood,
                false
            )
            benchLeg.CanQuery = false
        end
        for toolIndex = -1, 1 do
            local supply = part(
                masteryGrove,
                altar.name .. "MasterySupply",
                Vector3.new(0.95, 0.85, 0.95),
                shrineBase
                    * CFrame.new(-3.4 + toolIndex * 1.85, 3.68, 2.5)
                    * CFrame.Angles(0, math.rad(toolIndex * 11), 0),
                if toolIndex == 0 then Color3.fromRGB(121, 96, 58) else Color3.fromRGB(89, 63, 42),
                Enum.Material.WoodPlanks,
                false
            )
            supply.CanQuery = false
        end
        -- Restrained practical light, hung from the frame rather than floating.
        -- The tie beam this hangs from is centred at y = 9.05 with a z = +3.9
        -- half-length of 14.2/2 = 7.1, so its underside sits at 8.7 and any x
        -- inside +/-7.1 sits below it. The chain top lands exactly on that
        -- underside and the lantern hangs from the chain's bottom, so nothing
        -- in this stack floats without a physical thing above it holding it up
        -- -- the failure the first version had: its chain sat at z = 2.1, 1.8
        -- studs clear of either beam, with its own top above the beam height,
        -- so the lantern read as an unsupported glowing box.
        local beamUnderside = 9.05 - 0.35
        local chainLength = 1.0
        local hookChain = part(
            masteryGrove,
            altar.name .. "MasteryLanternChain",
            Vector3.new(0.22, chainLength, 0.22),
            shrineBase * CFrame.new(5.7, beamUnderside - chainLength * 0.5, 3.9),
            Color3.fromRGB(58, 62, 66),
            Enum.Material.Metal,
            false
        )
        hookChain.CanQuery = false
        local lanternHeight = 1.05
        local hookLantern = part(
            masteryGrove,
            altar.name .. "MasteryLantern",
            Vector3.new(0.78, lanternHeight, 0.78),
            shrineBase * CFrame.new(5.7, beamUnderside - chainLength - lanternHeight * 0.5, 3.9),
            AMBER,
            Enum.Material.Neon,
            false
        )
        hookLantern.CanQuery = false
        hookLantern.Transparency = 0.18
        local masteryLight = Instance.new("PointLight")
        masteryLight.Color = AMBER
        masteryLight.Brightness = 1.2
        masteryLight.Range = 17
        masteryLight.Shadows = false
        masteryLight.Parent = hookLantern
        CollectionService:AddTag(hookLantern, self._runtimeIds.AmbientLightTag)
        -- A reviewed anvil stands at the working end of each shrine, so the
        -- craft has a recognizable tool rather than only stacked supply boxes.
        table.insert(self._meshPlacements, {
            assetId = "mesh_creator_anvil_a",
            fallbackKind = "asset_dressing",
            position = altar.center + Vector3.new(4.6, 1.08, 2.4),
            scale = 1,
            yaw = math.rad(-24),
            seed = 9980 + #altar.name,
            swayTag = nil,
            parent = masteryGrove,
            fallbackInstance = nil,
        })
        labelSign(
            masteryGrove,
            CFrame.new(altar.center + Vector3.new(0, 4.8, 3.7)) * CFrame.Angles(0, math.pi, 0),
            altar.name .. " MASTERY"
        )
        for pathIndex, path in altar.paths do
            local xOffset = (pathIndex - 2) * 3.7
            local stone = part(
                masteryGrove,
                altar.name .. "PathStone_" .. path.id,
                Vector3.new(2.6, 3.8, 2.6),
                CFrame.new(altar.center + Vector3.new(xOffset, 2.55, -0.5))
                    * CFrame.Angles(
                        math.rad(pathIndex == 2 and 2 or -3),
                        0,
                        math.rad(xOffset * 0.6)
                    ),
                if pathIndex == 2 then altar.color else Color3.fromRGB(76, 82, 75),
                Enum.Material.Slate
            )
            local crest = part(
                masteryGrove,
                altar.name .. "PathCrest_" .. path.id,
                Vector3.new(1.15, 1.15, 0.22),
                stone.CFrame * CFrame.new(0, 0.45, -1.38),
                altar.color,
                Enum.Material.Glass,
                false
            )
            crest.Shape = Enum.PartType.Ball
            crest.Transparency = 0.1
            addBillboard(stone, path.name, altar.color)
            local interactionId =
                self._runtimeIds.ProfessionSpecializationInteractionIdBySpecialization[path.id]
            assert(interactionId ~= nil, "missing mastery runtime ID for " .. path.id)
            self:_registerInteraction(
                stone,
                interactionId,
                self._runtimeIds.Actions.SelectProfessionSpecialization,
                "CHOOSE PATH",
                path.name,
                path.id,
                1.1
            )
        end
        dais:SetAttribute("ProfessionId", "profession_" .. string.lower(altar.name))
        table.insert(self._meshPlacements, {
            assetId = if altar.name == "ENGINEER"
                then "mesh_creator_workbench_a"
                else "mesh_creator_stump_a",
            fallbackKind = "asset_dressing",
            position = altar.center + Vector3.new(0, 0.85, 2.1),
            scale = if altar.name == "ENGINEER" then 0.58 else 0.44,
            yaw = math.rad(
                if altar.name == "SCOUT" then -11 elseif altar.name == "MEDIC" then 14 else 4
            ),
            seed = 9970 + #altar.name,
            swayTag = nil,
            parent = masteryGrove,
            fallbackInstance = nil,
            profileScale = if altar.name == "WARDEN"
                then Vector3.new(1.12, 0.92, 0.88)
                else Vector3.one,
        })
    end
end

function WorldService.Init(self: WorldService, context: any)
    self._runtimeIds = context.runtimeIds
    self:_configureLighting()

    local existing = workspace:FindFirstChild(self._runtimeIds.WorldName)
    if existing ~= nil then
        existing:Destroy()
    end

    local world = Instance.new("Model")
    world.Name = self._runtimeIds.WorldName
    world:SetAttribute("WorldVersion", "emberhollow-runtime-visual-v28")
    world:SetAttribute("Ready", false)
    world.Parent = workspace
    self._world = world

    self:_buildEnvironment(world)

    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "ArrivalSpawn"
    spawn.Size = Vector3.new(12, 1, 12)
    spawn.CFrame = CFrame.new(0, 1, 0)
    spawn.Transparency = 1
    spawn.Anchored = true
    spawn.CanCollide = true
    spawn.Neutral = true
    spawn.Duration = 0
    -- The lodge owns spawning now. Leaving this enabled let Roblox choose
    -- between the two, which is why a fresh session could still start on the
    -- arrival road. It stays in the world as the launch destination and as the
    -- anchor the Studio test looks for.
    spawn.Enabled = false
    spawn.Parent = world
    self._spawn = spawn

    self:_buildLobby(world)
    self:_buildMara(world)
    self:_buildInteractables(world)
    self:setTownCondition(self._townCondition)

    world:SetAttribute("Ready", true)

    -- Only after the world is playable. Optional private assets and distant
    -- terrain can yield without delaying ArrivalSpawn.
    self:_buildMeshDressing()
    self:_buildDistantScenery()
end

function WorldService.Start(self: WorldService)
    local function bindPlayer(player: Player)
        player:SetAttribute("LastLightInExpedition", false)
        player:SetAttribute("LastLightExpeditionTransition", false)
        self._characterRoots[player] = nil
        local function bindCharacter(character: Model)
            self._characterRoots[player] = nil
            task.defer(function()
                local root = character:WaitForChild("HumanoidRootPart", 5)
                if player.Character == character and root:IsA("BasePart") then
                    self._characterRoots[player] = root
                end
            end)
        end
        player.CharacterAdded:Connect(function(character: Model)
            player:SetAttribute("LastLightInExpedition", false)
            player:SetAttribute("LastLightExpeditionTransition", false)
            bindCharacter(character)
        end)
        local character = player.Character
        if character ~= nil then
            bindCharacter(character)
        end
    end
    Players.PlayerAdded:Connect(bindPlayer)
    for _, player in Players:GetPlayers() do
        bindPlayer(player)
    end

    Players.PlayerRemoving:Connect(function(player: Player)
        self._characterRoots[player] = nil
        local world = self._world
        local deliveries = if world ~= nil then world:FindFirstChild("WayhomeDeliveries") else nil
        local delivery = if deliveries ~= nil
            then deliveries:FindFirstChild("WayhomeDelivery_" .. tostring(player.UserId))
            else nil
        if delivery ~= nil then
            delivery:Destroy()
        end
    end)

    local accumulator = 0
    RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.5 then
            return
        end
        accumulator = 0

        for _, player in Players:GetPlayers() do
            local character = player.Character
            local root = self._characterRoots[player]
            if
                character ~= nil
                and root ~= nil
                and root.Parent ~= nil
                and root.Position.Y < -18
            then
                local recovery = if player:GetAttribute("LastLightInExpedition") == true
                        and self._expeditionEntry ~= nil
                    then self._expeditionEntry
                    else self:spawnCFrame()
                character:PivotTo(recovery :: CFrame)
            end
        end
    end)

    self._logger:info("world_started", {
        interactions = self:interactionCount(),
        worldVersion = "emberhollow-runtime-visual-v28",
    })
end

function WorldService.interaction(self: WorldService, interactionId: string): ProximityPrompt?
    return self._interactions[interactionId]
end

function WorldService.interactionCount(self: WorldService): number
    local count = 0
    for _ in self._interactions do
        count += 1
    end
    return count
end

function WorldService.isInRange(
    _self: WorldService,
    player: Player,
    prompt: ProximityPrompt
): boolean
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    local target = prompt.Parent
    if root == nil or not root:IsA("BasePart") or target == nil or not target:IsA("BasePart") then
        return false
    end
    return (root.Position - target.Position).Magnitude <= prompt.MaxActivationDistance + 3
end

function WorldService.buildBarricade(self: WorldService, animated: boolean?)
    if self._barricadeBuilt then
        return
    end
    self._barricadeBuilt = true
    local world = assert(self._world, "world service has not initialized")
    local shouldAnimate = animated == true

    local prompt = self._interactions[self._runtimeIds.InteractionIds.Barricade]
    if prompt ~= nil then
        -- Tutorial progress is per player but this model is shared. Keep the
        -- prompt alive so a player still at `build` can submit their own
        -- action after somebody else constructed the server-wide barricade;
        -- HUDController hides it for every stage that no longer needs it.
        prompt.Enabled = true
        local target = prompt.Parent
        if target ~= nil and target:IsA("BasePart") then
            target.CanCollide = false
            target.CanQuery = true
            TweenService
                :Create(
                    target,
                    TweenInfo.new(if shouldAnimate then 0.35 else 0),
                    { Transparency = 1 }
                )
                :Play()
            local label = target:FindFirstChild("WorldLabel")
            if label ~= nil then
                label:Destroy()
            end
        end
    end

    for index = -4, 4 do
        local height = if index % 2 == 0 then 8 else 7
        local targetCFrame = CFrame.new(BARRICADE_CENTER + Vector3.new(index * 1.8, height / 2, 0))
            * CFrame.Angles(0, 0, math.rad(index * 2))
        local stake = part(
            world,
            "BarricadeStake",
            Vector3.new(1.3, height, 1.3),
            if shouldAnimate then targetCFrame - Vector3.new(0, height + 1, 0) else targetCFrame,
            BARK,
            Enum.Material.WoodPlanks,
            not shouldAnimate
        )
        if shouldAnimate then
            stake.Transparency = 0.2
            task.delay((index + 4) * 0.055, function()
                if stake.Parent == nil then
                    return
                end
                TweenService
                    :Create(
                        stake,
                        TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                        { CFrame = targetCFrame, Transparency = 0 }
                    )
                    :Play()
                task.delay(0.36, function()
                    if stake.Parent ~= nil then
                        stake.CanCollide = true
                        stake.CanQuery = true
                        stake.CanTouch = true
                    end
                end)
            end)
        end
    end
    for level = 1, 2 do
        local targetCFrame = CFrame.new(BARRICADE_CENTER + Vector3.new(0, 2 + level * 2.2, 0.7))
            * CFrame.Angles(0, 0, math.rad(if level == 1 then 8 else -8))
        local brace = part(
            world,
            "BarricadeBrace",
            Vector3.new(18, 1, 1),
            if shouldAnimate then targetCFrame + Vector3.new(0, 0, 5) else targetCFrame,
            Color3.fromRGB(105, 69, 45),
            Enum.Material.WoodPlanks,
            not shouldAnimate
        )
        if shouldAnimate then
            brace.Transparency = 0.2
            task.delay(0.55 + level * 0.12, function()
                if brace.Parent == nil then
                    return
                end
                TweenService
                    :Create(
                        brace,
                        TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                        { CFrame = targetCFrame, Transparency = 0 }
                    )
                    :Play()
                task.delay(0.3, function()
                    if brace.Parent ~= nil then
                        brace.CanCollide = true
                        brace.CanQuery = true
                        brace.CanTouch = true
                    end
                end)
            end)
        end
    end

    if shouldAnimate then
        task.delay(0.9, function()
            if world.Parent == nil then
                return
            end
            local pulse = part(
                world,
                "BarricadeCompletePulse",
                Vector3.new(0.14, 4, 4),
                CFrame.new(BARRICADE_CENTER + Vector3.new(0, 0.18, 0))
                    * CFrame.Angles(0, 0, math.rad(90)),
                AMBER,
                Enum.Material.Glass,
                false
            )
            pulse.Shape = Enum.PartType.Cylinder
            pulse.Transparency = 0.45
            pulse.CastShadow = false
            TweenService:Create(
                pulse,
                TweenInfo.new(0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Size = Vector3.new(0.14, 20, 20), Transparency = 1 }
            ):Play()
            task.delay(0.55, function()
                if pulse.Parent ~= nil then
                    pulse:Destroy()
                end
            end)
        end)
    end
end

-- Lift the fallen trunk off Mara. Called once, when she is actually freed, so
-- the rescue has a visible physical consequence instead of only a toast.
--[[
    Swing the player's tool for a timed action.

    Rotates the right shoulder joint through a chopping arc, once per swing,
    over the action's own duration. Driven from the server so every player in
    the world sees the same motion, and guarded throughout because a character
    can despawn mid-swing.

    Deliberately joint-driven rather than an animation asset: it needs no
    upload, cannot fail to load, and works on whatever rig a player brings.
]]
function WorldService.playToolAction(
    _self: WorldService,
    player: Player,
    _actionId: string,
    duration: number,
    swings: number
)
    local character = player.Character
    if character == nil or type(duration) ~= "number" or duration ~= duration or duration <= 0 then
        return
    end
    local arm = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
    if arm == nil then
        return
    end
    local joint = arm:FindFirstChild("RightShoulder")
    if joint == nil or not joint:IsA("Motor6D") then
        return
    end

    local motor = joint :: Motor6D
    local rest = motor.C0
    local count = math.clamp(math.floor(swings), 1, 6)
    task.spawn(function()
        local perSwing = duration / count
        for _ = 1, count do
            if character.Parent == nil or motor.Parent == nil then
                break
            end
            local raise = TweenService:Create(
                motor,
                TweenInfo.new(perSwing * 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { C0 = rest * CFrame.Angles(math.rad(-115), 0, 0) }
            )
            raise:Play()
            task.wait(perSwing * 0.35)
            if character.Parent == nil or motor.Parent == nil then
                break
            end
            local strike = TweenService:Create(
                motor,
                TweenInfo.new(perSwing * 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In),
                { C0 = rest * CFrame.Angles(math.rad(25), 0, 0) }
            )
            strike:Play()
            task.wait(perSwing * 0.65)
        end
        if motor.Parent ~= nil then
            TweenService:Create(
                motor,
                TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { C0 = rest }
            ):Play()
        end
    end)
end

function WorldService.resourceNode(self: WorldService, interactionId: string): any
    return self._resourceNodes[interactionId]
end

--[[
    The survey glass's question: of the nodes still standing, which is
    closest to this position? Harvested nodes leave the registry, so the
    scan is over live nodes only, and the registry is small (twenty-two on
    the preview route) -- a linear pass at objective-publish frequency.
]]
function WorldService.nearestResourceNode(self: WorldService, position: Vector3): any
    local closest = nil
    local closestDistance = math.huge
    for _, node in self._resourceNodes do
        local target = node.target
        if target ~= nil and target:IsA("BasePart") and target.Parent ~= nil then
            local distance = (target.Position - position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closest = node
            end
        end
    end
    return closest
end

-- Harvested nodes stay in the world but stop glowing and stop offering the
-- prompt, so a player can see what they have already taken.
function WorldService.markResourceNodeHarvested(self: WorldService, interactionId: string)
    local node = self._resourceNodes[interactionId]
    if node == nil then
        return
    end
    self._resourceNodes[interactionId] = nil
    local prompt = self._interactions[interactionId]
    if prompt ~= nil then
        prompt.Enabled = false
    end
    local module = node.target.Parent
    if module ~= nil then
        for _, descendant in module:GetChildren() do
            if descendant:IsA("BasePart") and descendant.Name == "ResourceGlow" then
                if (descendant.Position - node.target.Position).Magnitude < 8 then
                    descendant.Transparency = 1
                    for _, child in descendant:GetChildren() do
                        if child:IsA("Light") then
                            child.Enabled = false
                        end
                    end
                end
            end
        end
    end
end

function WorldService.setClickHandler(self: WorldService, handler: (Player, string) -> ())
    self._clickHandler = handler
end

--[[
    Decoration slots: authored anchors, rendered from profile state.

    Each slot is a small primitive assembly; empty slots carry a PLACE
    prompt priced from the catalog. Rendering is idempotent -- call it with
    every snapshot and it builds only what is missing, so placement,
    session load, and shared-town merges all take the same path.
]]
local DECORATION_ANCHORS: { [string]: { position: Vector3, yaw: number } } = {
    decor_plaza_banner_east = { position = Vector3.new(24, 0, -80), yaw = math.rad(-90) },
    decor_plaza_banner_west = { position = Vector3.new(-24, 0, -80), yaw = math.rad(90) },
    decor_road_garland_north = { position = Vector3.new(0, 0, -58), yaw = 0 },
    decor_road_garland_south = { position = Vector3.new(0, 0, -104), yaw = 0 },
    decor_planter_gate = { position = Vector3.new(12, 0, -152), yaw = 0 },
    decor_planter_archive = { position = Vector3.new(-31, 0, -117), yaw = 0 },
    decor_planter_inn = { position = Vector3.new(-84, 0, -178), yaw = 0 },
    decor_planter_workshop = { position = Vector3.new(34, 0, -136), yaw = 0 },
}

function WorldService.setTownDecorations(self: WorldService, snapshot: any)
    local world = self._world
    if world == nil or type(snapshot) ~= "table" then
        return
    end
    local folder = world:FindFirstChild("TownDecorations")
    if folder == nil then
        folder = Instance.new("Folder")
        folder.Name = "TownDecorations"
        folder.Parent = world
    end
    local placed = if type(snapshot.placed) == "table" then snapshot.placed else {}
    for _, slot in self._townDecorationsCatalog.Slots do
        local anchor = DECORATION_ANCHORS[slot.id]
        if anchor == nil then
            continue
        end
        local existing = folder:FindFirstChild(slot.id)
        if placed[slot.id] == true then
            local prompt = self._interactions["decor_place_" .. slot.id]
            if prompt ~= nil then
                prompt.Enabled = false
            end
            if existing ~= nil then
                continue
            end
            local model = Instance.new("Model")
            model.Name = slot.id
            model.Parent = folder
            local base = CFrame.new(anchor.position) * CFrame.Angles(0, anchor.yaw, 0)
            if slot.kind == "banner" then
                part(
                    model,
                    "DecorBannerPole",
                    Vector3.new(0.55, 9.5, 0.55),
                    base * CFrame.new(0, 4.75, 0),
                    WET_BARK,
                    Enum.Material.Wood
                )
                local cloth = part(
                    model,
                    "DecorBannerCloth",
                    Vector3.new(0.18, 4.2, 2.6),
                    base * CFrame.new(0, 6.4, 1.5) * CFrame.Angles(math.rad(-4), 0, 0),
                    AMBER,
                    Enum.Material.Fabric,
                    false
                )
                cloth.CanQuery = false
            elseif slot.kind == "garland" then
                for span = -1, 1 do
                    local rope = part(
                        model,
                        "DecorGarlandRope",
                        Vector3.new(6.4, 0.22, 0.22),
                        base
                            * CFrame.new(span * 5.8, 8.2 - math.abs(span) * 0.7, 0)
                            * CFrame.Angles(0, 0, math.rad(span * 7)),
                        Color3.fromRGB(96, 84, 58),
                        Enum.Material.Fabric,
                        false
                    )
                    rope.CanQuery = false
                    for lamp = -1, 1 do
                        local mote = part(
                            model,
                            "DecorGarlandLamp",
                            Vector3.new(0.45, 0.45, 0.45),
                            base
                                * CFrame.new(span * 5.8 + lamp * 1.9, 7.6 - math.abs(span) * 0.7, 0),
                            FOXFIRE,
                            Enum.Material.Neon,
                            false
                        )
                        mote.Shape = Enum.PartType.Ball
                        mote.CanQuery = false
                        mote.CastShadow = false
                    end
                end
            else
                part(
                    model,
                    "DecorPlanterBox",
                    Vector3.new(3.4, 1.1, 1.6),
                    base * CFrame.new(0, 0.55, 0),
                    Color3.fromRGB(78, 58, 39),
                    Enum.Material.WoodPlanks
                )
                for stem = -1, 1 do
                    local bloom = part(
                        model,
                        "DecorPlanterBloom",
                        Vector3.new(0.5, 0.5, 0.5),
                        base * CFrame.new(stem * 1.05, 1.55, 0),
                        if stem == 0 then AMBER else FOXFIRE,
                        Enum.Material.Neon,
                        false
                    )
                    bloom.Shape = Enum.PartType.Ball
                    bloom.CanQuery = false
                    bloom.CastShadow = false
                end
            end
        elseif existing == nil and self._interactions["decor_place_" .. slot.id] == nil then
            -- Empty slot: a low marker with a priced PLACE prompt.
            local marker = part(
                folder,
                slot.id .. "_Marker",
                Vector3.new(1.6, 0.35, 1.6),
                CFrame.new(anchor.position + Vector3.new(0, 0.2, 0)),
                Color3.fromRGB(96, 92, 74),
                Enum.Material.WoodPlanks,
                false
            )
            marker.CanQuery = true
            local costText = {}
            for materialId, amount in slot.cost do
                table.insert(
                    costText,
                    string.format("%d %s", amount, (string.gsub(materialId, "material_", "")))
                )
            end
            table.sort(costText)
            self:_registerInteraction(
                marker,
                "decor_place_" .. slot.id,
                self._runtimeIds.Actions.PlaceDecoration,
                "PLACE",
                slot.displayName .. " · " .. table.concat(costText, " + "),
                slot.id
            )
        end
    end
end

--[[
    An injured resident wears it: attribute for systems, a RESTING suffix on
    the nameplate for players. Presentation only -- the truth lives in the
    profile's resident state.
]]
function WorldService.setResidentInjured(self: WorldService, residentId: string, injured: boolean)
    local residents = self._townResidents
    if residents == nil then
        return
    end
    local resident = residents[residentId]
    if resident == nil or resident.model == nil or resident.model.Parent == nil then
        return
    end
    resident.model:SetAttribute("Injured", injured)
    local head = resident.interactionTarget
    if head ~= nil then
        local label = head:FindFirstChild("WorldLabel")
        local text = if label ~= nil then label:FindFirstChildOfClass("TextLabel") else nil
        if text ~= nil then
            text.Text = if injured
                then resident.displayName .. " · RESTING"
                else resident.displayName
        end
    end
end

function WorldService.freeMara(self: WorldService)
    local trap = self._maraTrap
    if trap == nil then
        return
    end
    self._maraTrap = nil
    -- The trunk breaks and settles instead of blinking out of existence: a
    -- thirty-stud log vanishing in one frame reads as a bug, not a rescue.
    task.spawn(function()
        local parts = {}
        for _, descendant in trap:GetDescendants() do
            if descendant:IsA("BasePart") then
                table.insert(parts, descendant)
            end
        end
        for _step = 1, 10 do
            for index, item in parts do
                local roll = if index % 2 == 0 then 0.02 else -0.02
                item.CFrame = item.CFrame * CFrame.Angles(0, 0, roll) + Vector3.new(0, -0.16, 0)
                item.Transparency = math.min(1, item.Transparency + 0.1)
            end
            task.wait(0.09)
        end
        trap:Destroy()
    end)
end

-- The physical departure platform and where a launched party lands. Owned
-- here because the geometry is authored here; LobbyService reads them rather
-- than duplicating the coordinates.
function WorldService.departurePlatform(self: WorldService): (Vector3, number)
    local platform = self._departurePlatform
    if platform == nil then
        return DEPARTURE_PLATFORM_CENTER, DEPARTURE_PLATFORM_RADIUS
    end
    return platform.Position, DEPARTURE_PLATFORM_RADIUS
end

function WorldService.arrivalSpawnPosition(self: WorldService): Vector3
    local spawn = self._spawn
    if spawn == nil then
        return Vector3.new(0, 4, 0)
    end
    return spawn.Position + Vector3.new(0, 3, 0)
end

function WorldService.moveMara(self: WorldService, destination: Vector3)
    local mara = self._mara
    if mara == nil or mara.PrimaryPart == nil then
        return
    end

    task.spawn(function()
        local start = mara:GetPivot()
        -- Walk her across the ground at her recorded standing height. Reading
        -- it back off the live pivot sampled whatever the ambient bob happened
        -- to be applying at that instant, which biased the whole walk down.
        -- An R15 pivot sits about three studs above the floor, so the callers'
        -- waist-height destination Y (a leftover from the hand-stacked body
        -- this rig replaced, whose pivot sat much lower) buried her to the
        -- chest on arrival. The valley floor is flat at GROUND_Y here, so
        -- carrying her current height across is both correct and immune to the
        -- next caller passing a Y that means something else.
        local target = CFrame.new(destination.X, self._maraStandY, destination.Z)
        for step = 1, 30 do
            mara:PivotTo(start:Lerp(target, step / 30))
            task.wait(0.035)
        end
    end)
end

function WorldService.setBeaconVisible(self: WorldService, visible: boolean)
    local beacon = self._beacon
    if beacon == nil then
        return
    end
    local becomingVisible = visible and beacon.CanQuery == false
    -- Never reveal the procedural interaction sphere. Progression is conveyed
    -- by the reliquary light and prompt, not a second orb or a floating label.
    beacon.Transparency = 1
    beacon.CanQuery = visible
    local prompt = self._interactions[self._runtimeIds.InteractionIds.Beacon]
    if prompt ~= nil then
        prompt.Enabled = visible
    end
    local light = beacon:FindFirstChildOfClass("PointLight")
    if light == nil then
        light = Instance.new("PointLight")
        light.Color = beacon.Color
        light.Brightness = 2.2
        light.Range = 34
        light.Shadows = false
        light.Parent = beacon
    end
    light.Enabled = visible
    local oldLabel = beacon:FindFirstChild("WorldLabel")
    if oldLabel ~= nil then
        oldLabel:Destroy()
    end
    local core = self._beaconCore
    if core ~= nil then
        core.Transparency = if visible then 0 else 1
        local coreLight = core:FindFirstChildOfClass("PointLight")
        if coreLight ~= nil then
            coreLight.Enabled = visible
        end
    end
    -- The orb is present either way; the reveal is it clearing rather than
    -- arriving. Dormant glass reads as a cold lens, lit glass as a held flame.
    local lens = self._beaconLens
    if lens ~= nil then
        lens.Transparency = if visible then 0.16 else 0.42
        lens.Material = if visible then Enum.Material.Neon else Enum.Material.Glass
    end

    local world = self._world
    if world ~= nil then
        for _, descendant in world:GetDescendants() do
            if descendant:IsA("BasePart") and descendant.Name == "DawnPathMarker" then
                TweenService
                    :Create(
                        descendant,
                        TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                        { Transparency = if visible then 0.12 else 1 }
                    )
                    :Play()
            end
        end
    end

    if becomingVisible then
        local pulse = part(
            assert(beacon.Parent, "beacon parent is missing"),
            "DawnRevealPulse",
            Vector3.new(0.16, 5, 5),
            -- Was y 0.24 -- under the road's raised visual skin, same as the
            -- reliquary and path markers above.
            CFrame.new(beacon.Position.X, 2.45, beacon.Position.Z)
                * CFrame.Angles(0, 0, math.rad(90)),
            FOXFIRE,
            Enum.Material.Neon,
            false
        )
        pulse.Shape = Enum.PartType.Cylinder
        pulse.Transparency = 0.16
        pulse.CastShadow = false
        TweenService:Create(
            pulse,
            TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = Vector3.new(0.16, 34, 34), Transparency = 1 }
        ):Play()
        task.delay(1.25, function()
            if pulse.Parent ~= nil then
                pulse:Destroy()
            end
        end)
    end
end

function WorldService.showProfessionAbility(
    self: WorldService,
    player: Player,
    professionId: string,
    effectRadius: number,
    activeSeconds: number
)
    local world = self._world
    local visual = self._professionAbilityVisuals.get(professionId)
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    if world == nil or visual == nil or root == nil or not root:IsA("BasePart") then
        return
    end

    local effects = world:FindFirstChild("ProfessionAbilityEffects")
    if effects == nil then
        effects = Instance.new("Folder")
        effects.Name = "ProfessionAbilityEffects"
        effects.Parent = world
    end
    local effectName = string.format("Ability_%d_%s", player.UserId, professionId)
    local previous = effects:FindFirstChild(effectName)
    if previous ~= nil then
        previous:Destroy()
    end

    local model = Instance.new("Model")
    model.Name = effectName
    model:SetAttribute("ProfessionId", professionId)
    model:SetAttribute("Motif", visual.motif)
    model:SetAttribute("OwnerUserId", player.UserId)
    model.Parent = effects

    local color = Color3.fromRGB(visual.color[1], visual.color[2], visual.color[3])
    local accent = Color3.fromRGB(visual.accent[1], visual.accent[2], visual.accent[3])
    local origin = if professionId == "profession_engineer"
        then self:lanternPosition() - Vector3.new(0, 5.75, 0)
        else root.Position - Vector3.new(0, 2.8, 0)
    local radius = math.clamp(math.max(effectRadius, visual.minimumRadius), 8, 24)
    local pulse = part(
        model,
        "AbilityGroundSignal",
        Vector3.new(0.12, 2, 2),
        CFrame.new(origin + Vector3.new(0, 0.16, 0)) * CFrame.Angles(0, 0, math.rad(90)),
        color,
        Enum.Material.Glass,
        false
    )
    pulse.Shape = Enum.PartType.Cylinder
    pulse.Transparency = 0.3
    pulse.CastShadow = false
    TweenService:Create(
        pulse,
        TweenInfo.new(visual.pulseLifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = Vector3.new(0.12, radius * 2, radius * 2), Transparency = 1 }
    ):Play()

    if visual.motif == "foxfire_compass" then
        for index = 1, 4 do
            local angle = math.rad((index - 1) * 90)
            local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
            local marker = part(
                model,
                "FoxfireCompassNeedle_" .. tostring(index),
                Vector3.new(0.35, 0.18, 4.6),
                CFrame.lookAt(
                    origin + direction * 3.1 + Vector3.new(0, 0.22, 0),
                    origin + direction * 8 + Vector3.new(0, 0.22, 0)
                ),
                if index == 1 then accent else color,
                Enum.Material.Neon,
                false
            )
            marker.Transparency = 0.12
        end
    elseif visual.motif == "root_ward" then
        for index = 1, 6 do
            local angle = math.rad(index * 60)
            local stake = part(
                model,
                "WardenRootStake_" .. tostring(index),
                Vector3.new(0.42, 3.4, 0.42),
                CFrame.new(origin + Vector3.new(math.cos(angle) * 4.4, 1.3, math.sin(angle) * 4.4))
                    * CFrame.Angles(math.rad(-8), angle, math.rad(index % 2 == 0 and 10 or -10)),
                if index % 2 == 0 then color else accent,
                Enum.Material.Wood,
                false
            )
            stake.Transparency = 0.08
        end
        local existingGuard = character:FindFirstChild("LastLightWardenGuardVisual")
        if existingGuard ~= nil then
            existingGuard:Destroy()
        end
        local guard = Instance.new("Highlight")
        guard.Name = "LastLightWardenGuardVisual"
        guard.Adornee = character
        guard.DepthMode = Enum.HighlightDepthMode.Occluded
        guard.FillColor = color
        guard.FillTransparency = 0.78
        guard.OutlineColor = accent
        guard.OutlineTransparency = 0.12
        guard.Parent = character
        task.delay(math.clamp(activeSeconds, 0.5, 12), function()
            if guard.Parent ~= nil then
                guard:Destroy()
            end
        end)
    elseif visual.motif == "rootline_gear" then
        for index = 1, 6 do
            local angle = math.rad(index * 60)
            local tooth = part(
                model,
                "RootlineGearTooth_" .. tostring(index),
                Vector3.new(0.8, 0.34, 2.7),
                CFrame.new(origin + Vector3.new(math.cos(angle) * 5.8, 0.28, math.sin(angle) * 5.8))
                    * CFrame.Angles(0, -angle, 0),
                if index % 2 == 0 then color else accent,
                Enum.Material.Metal,
                false
            )
            tooth.Transparency = 0.06
        end
    elseif visual.motif == "brightcap_bloom" then
        for index = 1, 6 do
            local angle = math.rad(index * 60)
            local bloomPosition = origin
                + Vector3.new(math.cos(angle) * 4.5, 0.55, math.sin(angle) * 4.5)
            part(
                model,
                "BrightcapStem_" .. tostring(index),
                Vector3.new(0.24, 1.2, 0.24),
                CFrame.new(bloomPosition),
                accent,
                Enum.Material.Grass,
                false
            )
            local cap = part(
                model,
                "BrightcapBloom_" .. tostring(index),
                Vector3.new(1.3, 0.55, 1.3),
                CFrame.new(bloomPosition + Vector3.new(0, 0.72, 0)),
                color,
                Enum.Material.Glass,
                false
            )
            cap.Shape = Enum.PartType.Ball
            cap.Transparency = 0.12
        end
    elseif visual.motif == "tonic_bloom" then
        -- Corked vials tipping outward in a ring: the pour, not the garden --
        -- the Medic's bloom already owns mushroom caps.
        for index = 1, 5 do
            local angle = math.rad(index * 72)
            local vialPosition = origin
                + Vector3.new(math.cos(angle) * 3.9, 0.85, math.sin(angle) * 3.9)
            local vial = part(
                model,
                "TonicVial_" .. tostring(index),
                Vector3.new(0.6, 1.35, 0.6),
                CFrame.new(vialPosition) * CFrame.Angles(math.rad(24), angle, 0),
                if index % 2 == 0 then color else accent,
                Enum.Material.Glass,
                false
            )
            vial.Transparency = 0.18
            local cork = part(
                model,
                "TonicCork_" .. tostring(index),
                Vector3.new(0.3, 0.26, 0.3),
                vial.CFrame * CFrame.new(0, 0.78, 0),
                Color3.fromRGB(110, 82, 54),
                Enum.Material.Wood,
                false
            )
            cork.Transparency = 0.05
        end
    elseif visual.motif == "hound_dash" then
        -- A dash of paw-fall chevrons running out ahead of the keeper, the
        -- direction the hound was sent. Root orientation is the only honest
        -- signal of where the player was facing at cast.
        local forward = root.CFrame.LookVector
        local flat = Vector3.new(forward.X, 0, forward.Z)
        local direction = if flat.Magnitude > 0.05 then flat.Unit else Vector3.new(0, 0, -1)
        for index = 1, 4 do
            local step = origin + direction * (2.4 + index * 2.3) + Vector3.new(0, 0.24, 0)
            local sideways = Vector3.new(-direction.Z, 0, direction.X)
                * (if index % 2 == 0 then 0.9 else -0.9)
            local paw = part(
                model,
                "HoundDashStep_" .. tostring(index),
                Vector3.new(0.95, 0.2, 1.5),
                CFrame.lookAt(step + sideways, step + sideways + direction),
                if index == 4 then accent else color,
                Enum.Material.Neon,
                false
            )
            paw.Transparency = 0.1 + index * 0.08
        end
    elseif visual.motif == "still_rune" then
        -- A bound circle: four glyph bars crossing a thin ring, holding
        -- rather than radiating -- this is the one ability motif about
        -- stopping something, so nothing in it points outward.
        local ring = part(
            model,
            "StillRuneRing",
            Vector3.new(0.18, 7.6, 7.6),
            CFrame.new(origin + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
            color,
            Enum.Material.Neon,
            false
        )
        ring.Shape = Enum.PartType.Cylinder
        ring.Transparency = 0.35
        for index = 1, 4 do
            local angle = math.rad(45 + (index - 1) * 90)
            local bar = part(
                model,
                "StillRuneGlyph_" .. tostring(index),
                Vector3.new(0.4, 0.22, 3.1),
                CFrame.new(origin + Vector3.new(math.cos(angle) * 2.4, 0.42, math.sin(angle) * 2.4))
                    * CFrame.Angles(0, -angle + math.rad(90), 0),
                accent,
                Enum.Material.Neon,
                false
            )
            bar.Transparency = 0.08
        end
    end

    task.delay(visual.pulseLifetime + 0.2, function()
        if model.Parent ~= nil then
            model:Destroy()
        end
    end)
end

function WorldService.setEngineerBrace(self: WorldService, snapshot: any, absorbed: number?)
    local world = self._world
    if world == nil then
        return
    end
    local active = type(snapshot) == "table" and snapshot.active == true
    local current = self._engineerBraceModel
    if not active then
        if current ~= nil and current.Parent ~= nil then
            current:Destroy()
        end
        self._engineerBraceModel = nil
        return
    end

    local revision = math.max(0, math.floor(tonumber(snapshot.revision) or 0))
    if
        current == nil
        or current.Parent == nil
        or current:GetAttribute("BraceRevision") ~= revision
    then
        if current ~= nil and current.Parent ~= nil then
            current:Destroy()
        end
        current = Instance.new("Model")
        current.Name = "EngineerRootlineBrace"
        current:SetAttribute("BraceRevision", revision)
        current.Parent = world
        self._engineerBraceModel = current

        local center = self:lanternPosition() - Vector3.new(0, 5.75, 0)
        for index = 1, 4 do
            local angle = math.rad(45 + (index - 1) * 90)
            local railAngle = angle - math.rad(45)
            part(
                current,
                "RootlineGroundRail_" .. tostring(index),
                Vector3.new(0.42, 0.28, 10.8),
                CFrame.new(
                    center
                        + Vector3.new(math.cos(railAngle) * 5.45, 0.24, math.sin(railAngle) * 5.45)
                ) * CFrame.Angles(0, -railAngle, 0),
                Color3.fromRGB(191, 137, 73),
                Enum.Material.Metal,
                false
            )
            part(
                current,
                "RootlineBraceStrut_" .. tostring(index),
                Vector3.new(0.62, 4.8, 0.62),
                CFrame.new(center + Vector3.new(math.cos(angle) * 5.2, 2.1, math.sin(angle) * 5.2))
                    * CFrame.Angles(math.rad(12), -angle, math.rad(index % 2 == 0 and 12 or -12)),
                Color3.fromRGB(91, 62, 40),
                Enum.Material.Wood,
                false
            )
        end
        local core = part(
            current,
            "RootlineCapacityCore",
            Vector3.new(1.8, 1.8, 1.8),
            CFrame.new(center + Vector3.new(5.6, 1.15, 0)),
            Color3.fromRGB(255, 206, 112),
            Enum.Material.Glass,
            false
        )
        core.Shape = Enum.PartType.Ball
        core.Transparency = 0.12
        local light = Instance.new("PointLight")
        light.Color = core.Color
        light.Brightness = 1.15
        light.Range = 13
        light.Parent = core

        local delaySeconds = math.clamp(tonumber(snapshot.remainingSeconds) or 0, 0.1, 30)
        task.delay(delaySeconds + 0.1, function()
            if
                self._engineerBraceModel == current
                and current.Parent ~= nil
                and current:GetAttribute("BraceRevision") == revision
            then
                current:Destroy()
                self._engineerBraceModel = nil
            end
        end)
    end

    current:SetAttribute("Capacity", math.max(0, math.floor(tonumber(snapshot.capacity) or 0)))
    current:SetAttribute(
        "MaxCapacity",
        math.max(1, math.floor(tonumber(snapshot.maxCapacity) or 1))
    )
    current:SetAttribute(
        "OwnerUserId",
        math.max(0, math.floor(tonumber(snapshot.ownerUserId) or 0))
    )
    current:SetAttribute("ActiveUntil", tonumber(snapshot.activeUntil) or 0)
    local core = current:FindFirstChild("RootlineCapacityCore")
    if core ~= nil and core:IsA("BasePart") then
        local ratio = math.clamp(
            (tonumber(snapshot.capacity) or 0) / math.max(1, tonumber(snapshot.maxCapacity) or 1),
            0,
            1
        )
        TweenService
            :Create(core, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Color = Color3.fromRGB(255, 112, 78):Lerp(Color3.fromRGB(255, 206, 112), ratio),
                Size = Vector3.new(1.05, 1.05, 1.05):Lerp(Vector3.new(1.8, 1.8, 1.8), ratio),
            })
            :Play()
    end
    if (absorbed or 0) > 0 then
        local center = self:lanternPosition() - Vector3.new(0, 5.6, 0)
        local impact = part(
            current,
            "RootlineImpactPulse",
            Vector3.new(0.16, 14, 14),
            CFrame.new(center + Vector3.new(0, 0.22, 0)) * CFrame.Angles(0, 0, math.rad(90)),
            Color3.fromRGB(255, 206, 112),
            Enum.Material.Neon,
            false
        )
        impact.Shape = Enum.PartType.Cylinder
        impact.Transparency = 0.16
        impact.CastShadow = false
        TweenService:Create(
            impact,
            TweenInfo.new(0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = Vector3.new(0.16, 20, 20), Transparency = 1 }
        ):Play()
        task.delay(0.45, function()
            if impact.Parent ~= nil then
                impact:Destroy()
            end
        end)
    end
end

--[[
    Centre of the First Lantern's safe zone, or nil before the world is built.

    Read from the live part rather than a constant so the safe zone cannot
    drift away from the lantern players can actually see if it is ever moved.
]]
function WorldService.lanternSafeCenter(self: WorldService): Vector3?
    local world = self._world
    if world == nil then
        return nil
    end
    local base = world:FindFirstChild("FirstLantern", true)
    if base == nil or not base:IsA("BasePart") then
        return nil
    end
    return base.Position
end

function WorldService.setLanternHealth(self: WorldService, health: number)
    local flame = self._lantern
    if flame == nil then
        return
    end
    local clamped = math.clamp(health, 0, 100)
    local previous = self._lanternVisualHealth
    self._lanternVisualHealth = clamped
    local strength = clamped / 100
    local danger = Color3.fromRGB(255, 104, 76)
    local targetColor = danger:Lerp(AMBER, strength)
    local targetSize = Vector3.new(0.62, 1.35, 0.48):Lerp(Vector3.new(1.05, 2.45, 0.82), strength)

    TweenService:Create(
        flame,
        TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Color = targetColor, Size = targetSize }
    ):Play()
    local light = flame:FindFirstChildOfClass("PointLight")
    if light ~= nil then
        TweenService
            :Create(light, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Brightness = 0.9 + strength * 1.7,
                Color = targetColor,
                Range = 26 + strength * 22,
            })
            :Play()
    end
    local world = self._world
    if world ~= nil then
        world:SetAttribute("FirstLanternHealth", clamped)
    end

    if math.abs(previous - clamped) < 1 then
        return
    end
    local pulse = part(
        assert(flame.Parent, "First Lantern parent is missing"),
        if clamped < previous then "LanternDamagePulse" else "LanternRepairPulse",
        targetSize,
        flame.CFrame,
        if clamped < previous then danger else FOXFIRE,
        Enum.Material.Glass,
        false
    )
    pulse.Shape = Enum.PartType.Ball
    pulse.Transparency = 0.58
    pulse.CastShadow = false
    TweenService:Create(
        pulse,
        TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = targetSize * 1.65, Transparency = 1 }
    ):Play()
    task.delay(0.5, function()
        if pulse.Parent ~= nil then
            pulse:Destroy()
        end
    end)
end

function WorldService.showTownGuardRecovery(self: WorldService, players: { Player }, result: any)
    local world = self._world
    local flame = self._lantern
    if world == nil or flame == nil or #players < 1 then
        return
    end

    local previous = world:FindFirstChild("TownGuardLastStand")
    if previous ~= nil then
        previous:Destroy()
    end

    world:SetAttribute("LastStandNight", result.nightNumber)
    world:SetAttribute("LastStandPartySize", #players)
    world:SetAttribute("LastStandLanternSpent", result.lanternSpent or result.lanternCost or 0)

    local rally = Instance.new("Model")
    rally.Name = "TownGuardLastStand"
    rally:SetAttribute("NightNumber", result.nightNumber)
    rally:SetAttribute("PartySize", #players)
    rally.Parent = world

    local ground = flame.Position - Vector3.new(0, 5.5, 0)
    for index = 1, 4 do
        local angle = math.rad(45 + (index - 1) * 90)
        local offset = Vector3.new(math.cos(angle) * 7.4, 0, math.sin(angle) * 7.4)
        local postAt = ground + offset
        local post = part(
            rally,
            "WatchRallyPost",
            Vector3.new(0.45, 4.8, 0.45),
            CFrame.new(postAt + Vector3.new(0, 2.4, 0))
                * CFrame.Angles(0, -angle, math.rad(if index % 2 == 0 then 5 else -5)),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
        post.Transparency = 0.08
        local pennant = part(
            rally,
            "WatchRallyPennant",
            Vector3.new(2.4, 1.15, 0.16),
            CFrame.new(postAt + Vector3.new(0.95 * math.cos(angle), 3.7, 0.95 * math.sin(angle)))
                * CFrame.Angles(0, -angle, math.rad(-8)),
            AMBER,
            Enum.Material.Fabric,
            false
        )
        pennant.Transparency = 0.08
        pennant.CastShadow = false
        TweenService:Create(
            pennant,
            TweenInfo.new(1.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Transparency = 1, Position = pennant.Position + Vector3.new(0, 1.2, 0) }
        ):Play()
    end

    for _, signal in self._nightDefenseSignals do
        if signal.Parent ~= nil then
            TweenService
                :Create(
                    signal,
                    TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {
                        Color = AMBER,
                        Transparency = if signal:GetAttribute("SignalRole") == "fire"
                            then 0
                            else 0.12,
                    }
                )
                :Play()
            local signalLight = signal:FindFirstChild("WatchSignalLight")
            if signalLight ~= nil and signalLight:IsA("PointLight") then
                signalLight.Color = AMBER
                signalLight.Brightness = 3.4
            end
        end
    end

    for _, player in players do
        local character = player.Character
        if character ~= nil and character.Parent ~= nil then
            local highlight = Instance.new("Highlight")
            highlight.Name = "LastLightTownGuardRecovery"
            highlight.Adornee = character
            highlight.DepthMode = Enum.HighlightDepthMode.Occluded
            highlight.FillColor = AMBER
            highlight.FillTransparency = 0.72
            highlight.OutlineColor = CREAM
            highlight.OutlineTransparency = 0.08
            highlight.Parent = character
            task.delay(math.clamp(tonumber(result.recoveryWardSeconds) or 5, 0.5, 8), function()
                if highlight.Parent ~= nil then
                    highlight:Destroy()
                end
            end)
        end
    end

    task.delay(0.7, function()
        if world.Parent ~= nil then
            self:_setNightDefenseState(
                if self._breachActive then "breach" elseif self._night then "night" else "day"
            )
        end
    end)
    task.delay(1.6, function()
        if rally.Parent ~= nil then
            rally:Destroy()
        end
    end)
end

local function buildTownConsequenceLandscape(
    parent: Instance,
    consequence: any,
    assetParent: Instance,
    meshPlacements: { MeshPlacement }
)
    local center = Vector3.new(96, 0, -164)
    local landscapeKind = tostring(consequence.landscapeKind or "seed_ground")
    local memorialKind = tostring(consequence.memorialKind or "unmarked_stone")
    local growthStage = math.clamp(math.floor(tonumber(consequence.growthStage) or 0), 0, 3)

    local ground = part(
        parent,
        "GreenwardGround",
        Vector3.new(42, 0.28, 34),
        CFrame.new(center + Vector3.new(0, 0.1, 0)),
        if landscapeKind == "cultivated_fields"
            then Color3.fromRGB(73, 58, 39)
            elseif landscapeKind == "living_grove" then Color3.fromRGB(38, 69, 43)
            else Color3.fromRGB(53, 68, 43),
        if landscapeKind == "cultivated_fields" then Enum.Material.Mud else Enum.Material.Ground,
        false
    )
    ground.CanQuery = false

    local borderColor = if landscapeKind == "living_grove" then MOSS else BARK
    for side = -1, 1, 2 do
        for postIndex = -1, 1 do
            part(
                parent,
                "GreenwardFencePost",
                Vector3.new(0.48, 2.6, 0.48),
                CFrame.new(center + Vector3.new(side * 20.5, 1.3, postIndex * 13.5))
                    * CFrame.Angles(0, 0, math.rad(side * postIndex * 3)),
                borderColor,
                Enum.Material.Wood,
                false
            )
        end
        for railY = 0.8, 1.75, 0.95 do
            part(
                parent,
                "GreenwardFenceRail",
                Vector3.new(0.32, 0.32, 27),
                CFrame.new(center + Vector3.new(side * 20.5, railY, 0))
                    * CFrame.Angles(math.rad(side * 1.5), 0, 0),
                borderColor,
                Enum.Material.Wood,
                false
            )
        end
    end

    local function cropRow(x: number, z: number, accent: Color3)
        part(
            parent,
            "CultivatedBed",
            Vector3.new(6.6, 0.3, 8.5),
            CFrame.new(center + Vector3.new(x, 0.28, z)),
            Color3.fromRGB(92, 67, 42),
            Enum.Material.Mud,
            false
        )
        for furrow = -1, 1 do
            part(
                parent,
                "CultivatedFurrow",
                Vector3.new(0.32, 0.12, 7.7),
                CFrame.new(center + Vector3.new(x + furrow * 1.7, 0.49, z)),
                Color3.fromRGB(54, 42, 31),
                Enum.Material.Ground,
                false
            )
        end
        for cropIndex = -1, 1 do
            local stem = part(
                parent,
                "CropStem",
                Vector3.new(0.24, 1.15 + growthStage * 0.12, 0.24),
                CFrame.new(center + Vector3.new(x + cropIndex * 1.65, 1.05, z)),
                Color3.fromRGB(71, 123, 63),
                Enum.Material.Grass,
                false
            )
            stem.CanQuery = false
            for leafSide = -1, 1, 2 do
                local leaf = part(
                    parent,
                    "HarvestCropLeaf",
                    Vector3.new(0.78, 0.18, 0.48),
                    stem.CFrame
                        * CFrame.new(leafSide * 0.34, 0.38 + leafSide * 0.08, 0)
                        * CFrame.Angles(0, math.rad(leafSide * 18), math.rad(-leafSide * 22)),
                    if leafSide < 0 then accent else Color3.fromRGB(82, 131, 65),
                    Enum.Material.LeafyGrass,
                    false
                )
                leaf.Shape = Enum.PartType.Wedge
                leaf.CanQuery = false
            end
        end
    end

    local function orchardTree(x: number, z: number, accent: Color3)
        local trunk = part(
            parent,
            "OrchardTrunk",
            Vector3.new(1.1, 5.5 + growthStage * 0.5, 1.1),
            CFrame.new(center + Vector3.new(x, 2.75, z)),
            BARK,
            Enum.Material.Wood,
            false
        )
        trunk.CanQuery = false
        local crown = part(
            parent,
            "OrchardCrown",
            Vector3.new(5.4 + growthStage * 0.4, 4.2, 5.4 + growthStage * 0.4),
            trunk.CFrame + Vector3.new(0, 4.15, 0),
            Color3.fromRGB(55, 103, 58),
            Enum.Material.Grass,
            false
        )
        crown.Shape = Enum.PartType.Ball
        crown.CanQuery = false
        for fruitIndex = -1, 1 do
            local fruit = part(
                parent,
                "OrchardFruit",
                Vector3.new(0.55, 0.55, 0.55),
                crown.CFrame + Vector3.new(fruitIndex * 1.25, -0.25, 2.1),
                accent,
                Enum.Material.SmoothPlastic,
                false
            )
            fruit.Shape = Enum.PartType.Ball
            fruit.CanQuery = false
        end
    end

    if landscapeKind == "cultivated_fields" then
        cropRow(-8.5, -5.2, Color3.fromRGB(205, 149, 72))
        cropRow(0, -5.2, Color3.fromRGB(169, 86, 58))
        cropRow(8.5, -5.2, Color3.fromRGB(220, 188, 90))
        cropRow(-8.5, 5.2, Color3.fromRGB(193, 118, 67))
        cropRow(0, 5.2, Color3.fromRGB(219, 178, 81))
        cropRow(8.5, 5.2, Color3.fromRGB(151, 92, 61))
        local trough = part(
            parent,
            "IrrigationTrough",
            Vector3.new(28, 0.55, 1.5),
            CFrame.new(center + Vector3.new(0, 0.45, 0)),
            Color3.fromRGB(72, 94, 94),
            Enum.Material.Glass,
            false
        )
        trough.Transparency = 0.18
    elseif landscapeKind == "living_grove" then
        for treeIndex, offset in
            {
                Vector3.new(-9, 0, -6),
                Vector3.new(0, 0, -3),
                Vector3.new(9, 0, -6),
                Vector3.new(-6, 0, 6),
                Vector3.new(7, 0, 6),
            }
        do
            orchardTree(offset.X, offset.Z, if treeIndex % 2 == 0 then FOXFIRE else AMBER)
        end
        for archIndex = -1, 1 do
            local archCenter = center + Vector3.new(archIndex * 10, 0, 10)
            for side = -1, 1, 2 do
                part(
                    parent,
                    "LivingRootArch",
                    Vector3.new(1.2, 7.5, 1.2),
                    CFrame.new(archCenter + Vector3.new(side * 3.1, 3.6, 0))
                        * CFrame.Angles(0, 0, math.rad(-side * 13)),
                    BARK,
                    Enum.Material.Wood,
                    false
                )
            end
            part(
                parent,
                "LivingRootCrown",
                Vector3.new(7, 1.1, 1.1),
                CFrame.new(archCenter + Vector3.new(0, 7.1, 0)),
                MOSS,
                Enum.Material.Wood,
                false
            )
        end
    elseif landscapeKind == "community_orchard" then
        cropRow(-9, -5.5, Color3.fromRGB(213, 157, 73))
        cropRow(9, -5.5, Color3.fromRGB(171, 94, 61))
        orchardTree(-9, 6, AMBER)
        orchardTree(0, 7.5, FOXFIRE)
        orchardTree(9, 6, AMBER)
        local tableTop = part(
            parent,
            "CommonsTable",
            Vector3.new(10, 0.55, 3.3),
            CFrame.new(center + Vector3.new(0, 2.5, -0.2)),
            Color3.fromRGB(102, 73, 47),
            Enum.Material.WoodPlanks,
            false
        )
        tableTop.CanQuery = false
        for side = -1, 1, 2 do
            part(
                parent,
                "CommonsBench",
                Vector3.new(10, 0.5, 1.3),
                CFrame.new(center + Vector3.new(0, 1.4, -0.2 + side * 3)),
                Color3.fromRGB(89, 63, 43),
                Enum.Material.WoodPlanks,
                false
            )
        end
    else
        cropRow(-9, -5.5, Color3.fromRGB(149, 122, 66))
        cropRow(0, -5.5, Color3.fromRGB(113, 143, 71))
        cropRow(9, -5.5, Color3.fromRGB(157, 102, 61))
        for stakeIndex = -1, 1 do
            local stake = part(
                parent,
                "SeedlingRowStake",
                Vector3.new(0.34, 2.4, 0.34),
                CFrame.new(center + Vector3.new(stakeIndex * 9, 1.2, 6))
                    * CFrame.Angles(0, 0, math.rad(stakeIndex * 4)),
                BARK,
                Enum.Material.Wood,
                false
            )
            part(
                parent,
                "SeedlingRowMarker",
                Vector3.new(2.4, 0.9, 0.22),
                stake.CFrame * CFrame.new(0, 0.55, -0.22),
                Color3.fromRGB(126, 96, 58),
                Enum.Material.WoodPlanks,
                false
            )
        end
    end

    local memorialCenter = center + Vector3.new(0, 0, 14)
    local plinth = part(
        parent,
        "WardenMemorialPlinth",
        Vector3.new(7.5, 1.2, 4.2),
        CFrame.new(memorialCenter + Vector3.new(0, 0.6, 0)),
        if memorialKind == "broken_antlers" then WET_BARK else Color3.fromRGB(76, 84, 79),
        if memorialKind == "living_antlers" then Enum.Material.Ground else Enum.Material.Slate,
        false
    )
    plinth.CanQuery = false
    local antlerColor = if memorialKind == "living_antlers"
        then Color3.fromRGB(92, 137, 77)
        elseif memorialKind == "broken_antlers" then Color3.fromRGB(45, 35, 32)
        else Color3.fromRGB(113, 106, 91)
    for side = -1, 1, 2 do
        local brokenSide = memorialKind == "broken_antlers" and side == 1
        local height = if brokenSide then 3.4 else 6.8
        part(
            parent,
            if brokenSide then "BrokenWardenAntler" else "WardenAntler",
            Vector3.new(0.7, height, 0.7),
            CFrame.new(memorialCenter + Vector3.new(side * 1.45, 1 + height * 0.5, 0))
                * CFrame.Angles(0, 0, math.rad(-side * 18)),
            antlerColor,
            Enum.Material.Wood,
            false
        )
        if not brokenSide and memorialKind ~= "unmarked_stone" then
            for tineIndex = 1, 2 do
                part(
                    parent,
                    "WardenAntlerTine",
                    Vector3.new(0.48, 2.8, 0.48),
                    CFrame.new(
                        memorialCenter
                            + Vector3.new(side * (2 + tineIndex * 0.65), 3.3 + tineIndex * 1.2, 0)
                    ) * CFrame.Angles(0, 0, math.rad(-side * 48)),
                    antlerColor,
                    Enum.Material.Wood,
                    false
                )
            end
        end
    end
    if memorialKind == "living_antlers" then
        local memoryLight = part(
            parent,
            "WardenMemoryLight",
            Vector3.new(1.1, 1.1, 1.1),
            CFrame.new(memorialCenter + Vector3.new(0, 5.8, 0)),
            FOXFIRE,
            Enum.Material.Glass,
            false
        )
        memoryLight.Shape = Enum.PartType.Ball
        memoryLight.Transparency = 0.14
        local glow = Instance.new("PointLight")
        glow.Color = FOXFIRE
        glow.Brightness = 1.25
        glow.Range = 16
        glow.Shadows = false
        glow.Parent = memoryLight
    elseif memorialKind == "scarred_antlers" then
        for scarIndex = -1, 1, 2 do
            local scar = part(
                parent,
                "WardenScar",
                Vector3.new(0.15, 1.9, 2.5),
                CFrame.new(memorialCenter + Vector3.new(scarIndex * 1.6, 1.25, -2.12))
                    * CFrame.Angles(0, 0, math.rad(scarIndex * 19)),
                Color3.fromRGB(187, 111, 65),
                Enum.Material.Neon,
                false
            )
            scar.Transparency = 0.22
        end
    end

    local sign = part(
        parent,
        "GreenwardConsequenceSign",
        Vector3.new(13, 3.2, 0.6),
        CFrame.new(center + Vector3.new(0, 4.2, -15.2)),
        BARK,
        Enum.Material.WoodPlanks,
        false
    )
    WorldSignBuilder.dressBoard(
        sign,
        string.format("TIER %d · %s", consequence.tier, consequence.title),
        CREAM,
        "consequence"
    )
    sign:SetAttribute("Consequence", consequence.detail)

    if landscapeKind == "living_grove" then
        local groveOffsets = {
            Vector3.new(-10, 0, -7),
            Vector3.new(0, 0, -4),
            Vector3.new(10, 0, -7),
            Vector3.new(-7, 0, 7),
            Vector3.new(8, 0, 7),
        }
        for index, offset in groveOffsets do
            table.insert(meshPlacements, {
                assetId = "mesh_broadleaf_hero_a",
                fallbackKind = "asset_replacement",
                position = center + offset,
                scale = 0.48 + index * 0.025,
                yaw = math.rad(index * 51),
                seed = 10000 + index,
                swayTag = nil,
                parent = assetParent,
                fallbackInstance = if index == 1 then parent else nil,
            })
        end
    else
        table.insert(meshPlacements, {
            assetId = "mesh_creator_field_rows_a",
            fallbackKind = "asset_replacement",
            position = center,
            scale = 1.12,
            yaw = 0,
            seed = 10010,
            swayTag = nil,
            parent = assetParent,
            fallbackInstance = parent,
        })
        if landscapeKind == "cultivated_fields" or landscapeKind == "community_orchard" then
            for index, offset in
                {
                    Vector3.new(-10, 0, -6),
                    Vector3.new(0, 0, -5),
                    Vector3.new(10, 0, -6),
                }
            do
                table.insert(meshPlacements, {
                    assetId = "mesh_creator_wheat_cluster_a",
                    fallbackKind = "asset_dressing",
                    position = center + offset,
                    scale = 1,
                    yaw = math.rad(index * 37),
                    seed = 10020 + index,
                    swayTag = nil,
                    parent = assetParent,
                    fallbackInstance = nil,
                })
            end
        end
        if landscapeKind == "community_orchard" then
            for index, offset in
                { Vector3.new(-10, 0, 7), Vector3.new(0, 0, 8), Vector3.new(10, 0, 7) }
            do
                table.insert(meshPlacements, {
                    assetId = "mesh_broadleaf_hero_a",
                    fallbackKind = "asset_dressing",
                    position = center + offset,
                    scale = 0.4,
                    yaw = math.rad(index * 63),
                    seed = 10030 + index,
                    swayTag = nil,
                    parent = assetParent,
                    fallbackInstance = nil,
                })
            end
            table.insert(meshPlacements, {
                assetId = "mesh_creator_picnic_table_a",
                fallbackKind = "asset_dressing",
                position = center,
                scale = 0.9,
                yaw = math.rad(90),
                seed = 10034,
                swayTag = nil,
                parent = assetParent,
                fallbackInstance = nil,
            })
        end
    end
    for index, spec in
        {
            { position = center + Vector3.new(-20, 0, -10), yaw = math.rad(90) },
            { position = center + Vector3.new(-20, 0, 0), yaw = math.rad(90) },
            { position = center + Vector3.new(-20, 0, 10), yaw = math.rad(90) },
            { position = center + Vector3.new(20, 0, -10), yaw = math.rad(90) },
            { position = center + Vector3.new(20, 0, 0), yaw = math.rad(90) },
            { position = center + Vector3.new(20, 0, 10), yaw = math.rad(90) },
            { position = center + Vector3.new(-12, 0, -16), yaw = 0 },
            { position = center + Vector3.new(0, 0, -16), yaw = 0 },
            { position = center + Vector3.new(12, 0, -16), yaw = 0 },
            { position = center + Vector3.new(-12, 0, 16), yaw = 0 },
            { position = center + Vector3.new(0, 0, 16), yaw = 0 },
            { position = center + Vector3.new(12, 0, 16), yaw = 0 },
        }
    do
        table.insert(meshPlacements, {
            assetId = "mesh_creator_rustic_fence_a",
            fallbackKind = "asset_dressing",
            position = spec.position,
            scale = 1,
            yaw = spec.yaw,
            seed = 10040 + index,
            swayTag = nil,
            parent = assetParent,
            fallbackInstance = nil,
        })
    end
    table.insert(meshPlacements, {
        assetId = "mesh_creator_stump_a",
        fallbackKind = "asset_dressing",
        position = memorialCenter,
        scale = 0.82,
        yaw = math.rad(-11),
        seed = 10060,
        swayTag = nil,
        parent = assetParent,
        fallbackInstance = nil,
    })
    table.insert(meshPlacements, {
        assetId = "mesh_creator_forest_sign_a",
        fallbackKind = "asset_dressing",
        position = center + Vector3.new(0, 0, -15.2),
        scale = 1.1,
        yaw = 0,
        seed = 10061,
        swayTag = nil,
        parent = assetParent,
        fallbackInstance = nil,
    })
    parent:SetAttribute("LandscapeKind", landscapeKind)
    parent:SetAttribute("MemorialKind", memorialKind)
    parent:SetAttribute("GrowthStage", growthStage)
end

local function buildTownProgressionBuildings(
    parent: Instance,
    consequence: any,
    runtimeIds: any,
    assetParent: Instance,
    meshPlacements: { MeshPlacement },
    construction: any,
    townConstructionRules: any
): (
    { [string]: any },
    { [string]: any },
    { [string]: any }
)
    local stages = if type(consequence.buildingStages) == "table"
        then consequence.buildingStages
        else {}
    local residents: { [string]: any } = {}
    -- Buildings currently short of their tier ceiling, keyed by ID, with the
    -- anchor part a ContributeConstruction prompt belongs on and the name to
    -- show for it. A building already at its ceiling gets no entry, so
    -- nothing prompts a player to fund a stage nights have not unlocked yet.
    local constructionTargets: { [string]: { target: BasePart, displayName: string } } = {}

    -- Where each building actually stands, recorded as it is placed rather than
    -- duplicated into a second table of coordinates. Per-building storm damage
    -- has to put its repair site at the building it damaged, and a hand-copied
    -- position list would drift away from these call sites the first time a lot
    -- moved -- the exact failure validate_town_layout.py exists to catch.
    -- `damageable` is false for a construction site: a building nobody has
    -- built yet cannot be storm-damaged, and asking a player to repair one
    -- would be asking them to fix something that was never there.
    local buildingPlacements: { [string]: { center: Vector3, damageable: boolean } } = {}

    -- The tier a building is *allowed* to reach right now, purely from nights
    -- and chapter one -- unchanged from before construction orders existed.
    local function ceilingStageFor(id: string): number
        return math.clamp(math.floor(tonumber(stages[id]) or 0), 0, 3)
    end

    -- What a building actually renders as: never ahead of what a player has
    -- paid to build, and never ahead of what the story has earned either.
    local function stageFor(id: string): number
        return math.min(ceilingStageFor(id), townConstructionRules.stageFor(construction, id))
    end

    -- The sign each buildingShell/constructionSite anchors a readable name
    -- to, whichever of the two produced this particular model. Neither name
    -- is guaranteed (a bespoke model like the town board has neither), so
    -- callers with their own anchor part skip this and pass it directly.
    local function signAnchor(model: Model): BasePart?
        local sign = model:FindFirstChild("BuildingSign")
            or model:FindFirstChild("ConstructionSign")
        if sign ~= nil and sign:IsA("BasePart") then
            return sign
        end
        return nil
    end

    local function noteConstructionTarget(id: string, displayName: string, anchor: BasePart?)
        if anchor == nil then
            return
        end
        local built = townConstructionRules.stageFor(construction, id)
        if built < ceilingStageFor(id) then
            constructionTargets[id] = {
                target = anchor,
                displayName = displayName,
            }
        end
    end

    -- Yaw that turns a building's entrance toward `to`. A part's Front face is
    -- -Z, and CFrame.Angles(0, theta, 0) has look vector (-sin, 0, -cos), so
    -- the yaw pointing Front along `delta` is atan2(-dx, -dz).
    local function yawToward(from: Vector3, to: Vector3): number
        local delta = to - from
        if delta.Magnitude < 0.05 then
            return 0
        end
        return math.atan2(-delta.X, -delta.Z)
    end

    local function constructionSite(
        id: string,
        displayName: string,
        center: Vector3,
        size: Vector3,
        facingYaw: number
    )
        -- Authored in the building's own frame so the entrance, sign, and
        -- worksite face the street from whichever lot the building sits on.
        local base = CFrame.new(center) * CFrame.Angles(0, facingYaw, 0)
        local function at(offset: Vector3): CFrame
            return base * CFrame.new(offset)
        end
        buildingPlacements[id] = { center = center, damageable = false }
        local model = Instance.new("Model")
        model.Name = id
        model:SetAttribute("BuildingId", id)
        model:SetAttribute("BuildingStage", 0)
        model:SetAttribute("BuildingState", "construction")
        model.Parent = parent
        part(
            model,
            "StoneFooting",
            Vector3.new(size.X, 0.65, size.Z),
            at(Vector3.new(0, 0.32, 0)),
            Color3.fromRGB(73, 76, 72),
            Enum.Material.Slate,
            false
        )
        for sideX = -1, 1, 2 do
            for sideZ = -1, 1, 2 do
                part(
                    model,
                    "ScaffoldPost",
                    Vector3.new(0.55, 7.5, 0.55),
                    at(Vector3.new(sideX * (size.X * 0.45), 3.9, sideZ * (size.Z * 0.42))),
                    Color3.fromRGB(94, 69, 46),
                    Enum.Material.Wood,
                    false
                )
            end
        end
        for sideZ = -1, 1, 2 do
            part(
                model,
                "ScaffoldRail",
                Vector3.new(size.X * 0.92, 0.4, 0.4),
                at(Vector3.new(0, 5.7, sideZ * (size.Z * 0.42))),
                Color3.fromRGB(102, 75, 49),
                Enum.Material.Wood,
                false
            )
        end
        for tarpSide = -1, 1, 2 do
            local tarp = part(
                model,
                "BuilderTarp",
                Vector3.new(size.X * 0.72, 0.12, size.Z * 0.36),
                at(Vector3.new(0, 7.3, tarpSide * size.Z * 0.16))
                    * CFrame.Angles(math.rad(tarpSide * 12), 0, math.rad(tarpSide * 1.5)),
                if tarpSide < 0 then Color3.fromRGB(91, 107, 82) else Color3.fromRGB(111, 121, 91),
                Enum.Material.Fabric,
                false
            )
            tarp.Transparency = 0.08
        end
        local materials = Instance.new("Model")
        materials.Name = "BuilderMaterials"
        materials.Parent = model
        for lumberIndex = 1, 4 do
            part(
                materials,
                "ConstructionLumber",
                Vector3.new(size.X * 0.38, 0.42, 0.72),
                at(Vector3.new(-size.X * 0.23, 0.55 + lumberIndex * 0.36, size.Z * 0.34))
                    * CFrame.Angles(0, math.rad((lumberIndex % 2) * 2), 0),
                if lumberIndex % 2 == 0 then BARK else WET_BARK,
                Enum.Material.WoodPlanks,
                false
            )
        end
        for stoneIndex = 1, 4 do
            local row = math.floor((stoneIndex - 1) / 2)
            part(
                materials,
                "ConstructionStone",
                Vector3.new(2.3, 1.05, 1.7),
                at(
                    Vector3.new(
                        size.X * 0.3 + ((stoneIndex - 1) % 2) * 2.5,
                        0.55 + row * 1.05,
                        size.Z * 0.3
                    )
                )
                    * CFrame.Angles(0, math.rad(stoneIndex * 7), math.rad((stoneIndex % 2) * 2)),
                if stoneIndex % 2 == 0
                    then Color3.fromRGB(83, 87, 82)
                    else Color3.fromRGB(68, 73, 70),
                Enum.Material.Cobblestone,
                false
            )
        end
        local sawhorse = part(
            materials,
            "BuilderSawhorse",
            Vector3.new(5.2, 0.5, 1.2),
            at(Vector3.new(0, 2.45, -size.Z * 0.3)),
            Color3.fromRGB(99, 70, 46),
            Enum.Material.WoodPlanks,
            false
        )
        for side = -1, 1, 2 do
            for depth = -1, 1, 2 do
                part(
                    materials,
                    "BuilderSawhorseLeg",
                    Vector3.new(0.35, 2.2, 0.35),
                    sawhorse.CFrame
                        * CFrame.new(side * 1.9, -1.15, depth * 0.35)
                        * CFrame.Angles(0, 0, math.rad(side * 9)),
                    WET_BARK,
                    Enum.Material.Wood,
                    false
                )
            end
        end
        local sign = part(
            model,
            "ConstructionSign",
            Vector3.new(8.5, 2.2, 0.45),
            at(Vector3.new(0, 2.5, -(size.Z * 0.5 + 0.5))),
            BARK,
            Enum.Material.WoodPlanks,
            false
        )
        WorldSignBuilder.dressBoard(sign, displayName .. " · PLANNED", CREAM, "construction")
        return model
    end

    local function buildingShell(
        id: string,
        displayName: string,
        center: Vector3,
        size: Vector3,
        stage: number,
        accent: Color3,
        facingYaw: number
    ): Model
        if stage == 0 then
            return constructionSite(id, displayName, center, size, facingYaw)
        end
        buildingPlacements[id] = { center = center, damageable = true }
        local model = Instance.new("Model")
        model.Name = id
        model:SetAttribute("BuildingId", id)
        model:SetAttribute("BuildingStage", stage)
        model:SetAttribute("BuildingState", if stage == 3 then "flourishing" else "complete")
        model:SetAttribute("BuildingFacingYaw", facingYaw)
        model.Parent = parent
        local wallHeight = 7.5 + stage * 0.75
        local halfX = size.X * 0.5
        local halfZ = size.Z * 0.5
        -- Same local-frame contract as constructionSite: the door gap in
        -- FrontWall, DoorHeader, BuildingSign, and FrontAwning all sit on -Z
        -- here, and the yaw turns that whole face toward the street.
        local base = CFrame.new(center) * CFrame.Angles(0, facingYaw, 0)
        local function at(offset: Vector3): CFrame
            return base * CFrame.new(offset)
        end
        part(
            model,
            "Floor",
            Vector3.new(size.X, 0.55, size.Z),
            at(Vector3.new(0, 0.28, 0)),
            Color3.fromRGB(83, 61, 42),
            Enum.Material.WoodPlanks
        )
        part(
            model,
            "BackWall",
            Vector3.new(size.X, wallHeight, 0.7),
            at(Vector3.new(0, wallHeight * 0.5, halfZ - 0.35)),
            Color3.fromRGB(69, 48, 36),
            Enum.Material.WoodPlanks
        )
        for side = -1, 1, 2 do
            part(
                model,
                "SideWall",
                Vector3.new(0.7, wallHeight, size.Z),
                at(Vector3.new(side * (halfX - 0.35), wallHeight * 0.5, 0)),
                Color3.fromRGB(69, 48, 36),
                Enum.Material.WoodPlanks
            )
            part(
                model,
                "FrontWall",
                Vector3.new((size.X - 5) * 0.5, wallHeight, 0.7),
                at(Vector3.new(side * (halfX * 0.5 + 1.25), wallHeight * 0.5, -halfZ + 0.35)),
                Color3.fromRGB(69, 48, 36),
                Enum.Material.WoodPlanks
            )
            local window = part(
                model,
                "Window",
                Vector3.new(0.18, 2.4, 2.8),
                at(Vector3.new(side * (halfX - 0.72), 4.5, 1.6)),
                accent,
                Enum.Material.Glass,
                false
            )
            window.Transparency = 0.25
        end
        for sideX = -1, 1, 2 do
            for sideZ = -1, 1, 2 do
                part(
                    model,
                    "BuildingCornerPost",
                    Vector3.new(0.72, wallHeight + 0.5, 0.72),
                    at(Vector3.new(sideX * (halfX - 0.2), wallHeight * 0.5, sideZ * (halfZ - 0.2)))
                        * CFrame.Angles(0, 0, math.rad(sideX * sideZ * 1.5)),
                    WET_BARK,
                    Enum.Material.Wood,
                    false
                )
            end
        end
        part(
            model,
            "DoorHeader",
            Vector3.new(5, 1.1, 0.85),
            at(Vector3.new(0, wallHeight - 0.55, -halfZ + 0.3)),
            WET_BARK,
            Enum.Material.Wood
        )
        for roofSide = -1, 1, 2 do
            part(
                model,
                "RoofPlane",
                Vector3.new(size.X + 2.2, 0.42, size.Z * 0.62),
                at(Vector3.new(0, wallHeight + 1.25, roofSide * (size.Z * 0.25)))
                    * CFrame.Angles(math.rad(roofSide * 24), 0, 0),
                if stage >= 2 then Color3.fromRGB(48, 55, 49) else Color3.fromRGB(59, 58, 51),
                Enum.Material.Slate
            )
        end
        part(
            model,
            "RoofRidgeBeam",
            Vector3.new(size.X + 2.4, 0.48, 0.48),
            at(Vector3.new(0, wallHeight + 2.65, 0)),
            WET_BARK,
            Enum.Material.Wood,
            false
        )
        local sign = part(
            model,
            "BuildingSign",
            Vector3.new(8.8, 1.7, 0.38),
            at(Vector3.new(0, wallHeight - 1.7, -halfZ - 0.18)),
            WET_BARK,
            Enum.Material.WoodPlanks,
            false
        )
        WorldSignBuilder.dressBoard(sign, displayName, accent, "building")
        local lightAnchor = part(
            model,
            "WarmInterior",
            Vector3.new(0.25, 0.25, 0.25),
            at(Vector3.new(0, 4.5, 1.5)),
            accent,
            Enum.Material.Neon,
            false
        )
        lightAnchor.Transparency = 1
        local light = Instance.new("PointLight")
        light.Color = accent
        light.Brightness = 1.05 + stage * 0.3
        light.Range = 17 + stage * 4
        light.Shadows = false
        light.Parent = lightAnchor
        local interiorCounter = part(
            model,
            "BuildingInteriorCounter",
            Vector3.new(size.X * 0.48, 1.25, 2.4),
            at(Vector3.new(0, 1.25, halfZ - 1.8)),
            Color3.fromRGB(96, 68, 45),
            Enum.Material.WoodPlanks,
            false
        )
        interiorCounter.CanQuery = false
        for crateIndex = -1, 1, 2 do
            local crate = part(
                model,
                "BuildingSupplyCrate",
                Vector3.new(2.4, 1.9, 2.2),
                at(Vector3.new(crateIndex * (halfX * 0.52), 0.95, -0.5)),
                if crateIndex < 0 then Color3.fromRGB(89, 63, 42) else Color3.fromRGB(102, 87, 56),
                Enum.Material.WoodPlanks,
                false
            )
            crate.CanQuery = false
        end
        if stage >= 2 then
            local awning = part(
                model,
                "FrontAwning",
                Vector3.new(10, 0.4, 4),
                at(Vector3.new(0, wallHeight - 2.2, -halfZ - 2)) * CFrame.Angles(math.rad(-8), 0, 0),
                Color3.fromRGB(96, 105, 77),
                Enum.Material.Fabric,
                false
            )
            awning.Transparency = 0.04
        end
        if stage >= 3 then
            for side = -1, 1, 2 do
                local planter = part(
                    model,
                    "WindowPlanter",
                    Vector3.new(3.4, 0.7, 0.85),
                    at(Vector3.new(side * (halfX + 0.15), 3, 1.6)),
                    Color3.fromRGB(91, 65, 43),
                    Enum.Material.WoodPlanks,
                    false
                )
                for flower = -1, 1 do
                    local bloom = part(
                        model,
                        "WindowBloom",
                        Vector3.new(0.5, 0.5, 0.5),
                        planter.CFrame * CFrame.new(0, 0.58, flower * 0.85),
                        if flower == 0 then accent else FOXFIRE,
                        Enum.Material.SmoothPlastic,
                        false
                    )
                    bloom.Shape = Enum.PartType.Ball
                end
            end
        end
        return model
    end

    local archiveStage = stageFor("building_archive")
    local archive = buildingShell(
        "building_archive",
        "MEMORY ARCHIVE",
        Vector3.new(-92, 0, -144),
        Vector3.new(17, 0, 14),
        archiveStage,
        FOXFIRE,
        yawToward(Vector3.new(-92, 0, -144), Vector3.new(0, 0, -144))
    )
    noteConstructionTarget("building_archive", "MEMORY ARCHIVE", signAnchor(archive))
    if archiveStage > 0 then
        local archivePropsFallback = Instance.new("Model")
        archivePropsFallback.Name = "ArchivePropsFallback"
        archivePropsFallback.Parent = archive
        for shelf = -1, 1, 2 do
            part(
                archivePropsFallback,
                "ArchiveShelf",
                Vector3.new(4.8, 5.2, 0.75),
                CFrame.new(-92 + shelf * 5.3, 2.85, -139.1),
                Color3.fromRGB(85, 61, 42),
                Enum.Material.WoodPlanks,
                false
            )
        end
        for jarIndex = -2, 2 do
            local jar = part(
                archivePropsFallback,
                "ArchiveMemoryJar",
                Vector3.new(0.65, 0.9, 0.65),
                CFrame.new(-92 + jarIndex * 1.4, 1.1, -144),
                if jarIndex % 2 == 0 then FOXFIRE else AMBER,
                Enum.Material.Glass,
                false
            )
            jar.Shape = Enum.PartType.Ball
            jar.Transparency = 0.18
        end
        for index, definition in
            {
                { assetId = "mesh_creator_crate_a", x = -96, yaw = -9 },
                { assetId = "mesh_creator_barrel_a", x = -92, yaw = 7 },
                { assetId = "mesh_creator_crate_a", x = -88, yaw = 12 },
            }
        do
            table.insert(meshPlacements, {
                assetId = definition.assetId,
                fallbackKind = "asset_replacement",
                position = Vector3.new(definition.x, 0, -140),
                scale = 0.9,
                yaw = math.rad(definition.yaw),
                seed = 10100 + index,
                swayTag = nil,
                parent = assetParent,
                fallbackInstance = if index == 1 then archivePropsFallback else nil,
            })
        end
    end

    local workbenchStage = stageFor("building_workbench")
    local workshop = buildingShell(
        "building_workbench",
        "LANTERN WORKBENCH",
        Vector3.new(92, 0, -126),
        Vector3.new(18, 0, 14),
        workbenchStage,
        AMBER,
        yawToward(Vector3.new(92, 0, -126), Vector3.new(0, 0, -126))
    )
    noteConstructionTarget("building_workbench", "LANTERN WORKBENCH", signAnchor(workshop))
    if workbenchStage > 0 then
        local workbenchFallback = Instance.new("Model")
        workbenchFallback.Name = "TownWorkbenchFallback"
        workbenchFallback.Parent = workshop
        local bench = part(
            workbenchFallback,
            "CraftingBench",
            Vector3.new(8, 1.2, 3.2),
            CFrame.new(92, 1.3, -122.3),
            Color3.fromRGB(104, 73, 46),
            Enum.Material.WoodPlanks,
            false
        )
        for toolIndex = -1, 1 do
            part(
                workbenchFallback,
                "WorkbenchTool",
                Vector3.new(0.35, 2.4, 0.35),
                bench.CFrame + Vector3.new(toolIndex * 2.2, 1.65, 0),
                if toolIndex == 0 then Color3.fromRGB(141, 150, 153) else BARK,
                if toolIndex == 0 then Enum.Material.Metal else Enum.Material.Wood,
                false
            )
        end
        table.insert(meshPlacements, {
            assetId = "mesh_creator_workbench_a",
            fallbackKind = "asset_replacement",
            position = Vector3.new(92, 0, -122.3),
            scale = 1,
            yaw = math.pi,
            seed = 10110,
            swayTag = nil,
            parent = assetParent,
            fallbackInstance = workbenchFallback,
        })
    end

    local boardStage = stageFor("building_town_board")
    local boardModel = Instance.new("Model")
    boardModel.Name = "building_town_board"
    boardModel:SetAttribute("BuildingId", "building_town_board")
    boardModel:SetAttribute("BuildingStage", boardStage)
    boardModel:SetAttribute("BuildingState", "complete")
    boardModel.Parent = parent
    --[[
        Off the road's centreline, turned to face it.

        The board stood at (0, -158), ten studs directly behind the memory
        reliquary at (0, -148) and on the same axis. Walking south down the
        road you saw the reliquary silhouetted against a big blank board --
        the owner's report was a "sign right in the middle of" the memory orb.
        Nothing was broken about the board itself; it was standing in the one
        place that ruins the landmark behind it.

        Seated on the west verge and rotated -90 degrees so its face looks east
        across the road. A reader now stands beside the road looking west,
        rather than standing on the road blocking the walk south, and the
        reliquary keeps a clear backdrop.

        Then the Dawn Gate towers moved out to x = +/-19, and (-24, -150) put
        this board five studs from the west tower -- swallowed by its
        scaffold, with the header plank reading as a sign nailed sideways to
        the stairs. The owner photographed exactly that. South of the gate on
        the same verge keeps the original intent with the tower well clear.
    ]]
    local boardBase = CFrame.new(-32, 0, -162) * CFrame.Angles(0, math.rad(-90), 0)
    for side = -1, 1, 2 do
        part(
            boardModel,
            "TownBoardPost",
            Vector3.new(0.8, 7.2, 0.8),
            boardBase * CFrame.new(side * 5.2, 3.6, 0),
            WET_BARK,
            Enum.Material.Wood
        )
    end
    local board = part(
        boardModel,
        "TownBoard",
        Vector3.new(11.5, 5.5, 0.65),
        boardBase * CFrame.new(0, 5.2, 0),
        Color3.fromRGB(90, 64, 42),
        Enum.Material.WoodPlanks,
        false
    )
    WorldSignBuilder.dressNoticeBoard(
        board,
        string.format("EMBERHOLLOW · TIER %d", consequence.tier or 0),
        CREAM,
        { "community_watch", "lantern_maintenance", "supply_inventory" }
    )
    noteConstructionTarget("building_town_board", "TOWN BOARD", board)
    table.insert(meshPlacements, {
        assetId = "mesh_creator_notice_board_a",
        fallbackKind = "asset_replacement",
        position = Vector3.new(-32, 0, -162),
        scale = 1.05,
        yaw = math.rad(-90),
        seed = 10120,
        swayTag = nil,
        parent = assetParent,
        fallbackInstance = boardModel,
    })

    local innStage = stageFor("building_inn")
    local inn = buildingShell(
        "building_inn",
        "WAYFARER INN",
        Vector3.new(-92, 0, -184),
        Vector3.new(18, 0, 14),
        innStage,
        Color3.fromRGB(219, 151, 77),
        yawToward(Vector3.new(-92, 0, -184), Vector3.new(0, 0, -184))
    )
    noteConstructionTarget("building_inn", "WAYFARER INN", signAnchor(inn))
    if innStage > 0 then
        local innFurnitureFallback = Instance.new("Model")
        innFurnitureFallback.Name = "InnFurnitureFallback"
        innFurnitureFallback.Parent = inn
        for side = -1, 1, 2 do
            part(
                innFurnitureFallback,
                "InnTable",
                Vector3.new(4.5, 0.55, 3),
                CFrame.new(-92 + side * 5, 2.1, -180.5),
                Color3.fromRGB(100, 69, 45),
                Enum.Material.WoodPlanks,
                false
            )
            table.insert(meshPlacements, {
                assetId = "mesh_creator_picnic_table_a",
                fallbackKind = "asset_replacement",
                position = Vector3.new(-92 + side * 5, 0, -180.5),
                scale = 0.7,
                yaw = math.rad(90),
                seed = 10130 + side,
                swayTag = nil,
                parent = assetParent,
                fallbackInstance = if side < 0 then innFurnitureFallback else nil,
            })
        end
    end

    --[[
        The eleven Milestone 4 buildings that complete the sixteen-building
        town: Builder's Row, Hearthmarket, the Watch Ring, the celebration
        stage, and Waterworks. Each is an authored Meshy model rather than the
        five hand-built procedural shells above.

        The procedural shell is not retired for these -- it becomes the
        fallback. buildingShell(..., stage, ...) already produces a readable,
        stage-appropriate building out of primitives, so it is reused wholesale
        as what the town shows if the authored mesh ever fails to load
        (moderation, deletion, a private asset). Milestone 3's asset pipeline
        exists precisely because that happens; three of the game's meshes have
        already needed this exact kind of fallback in production.

        What these do NOT get, and the original five do: a bespoke escalating
        look across stages one through three. There is one authored model per
        building, not three, so stage 0 is the shared constructionSite and
        stages 1-3 all show the same finished mesh. The fallback shell still
        escalates (its own stage-based awning and planters), which is a
        harmless bonus on a path that only renders when the primary path has
        already failed.

        Positions were chosen to clear every existing keep-out zone and every
        other new building by at least six studs, computed once rather than by
        eye; none of this has been seen in Studio, so treat placement as a
        first pass to confirm there, not a final one.
    ]]
    local function authoredBuilding(
        id: string,
        displayName: string,
        meshAssetId: string,
        center: Vector3,
        footprint: Vector3,
        accent: Color3,
        facingYaw: number,
        seed: number
    ): Model
        local stage = stageFor(id)
        if stage == 0 then
            return constructionSite(id, displayName, center, footprint, facingYaw)
        end

        local fallback = buildingShell(id, displayName, center, footprint, stage, accent, facingYaw)
        table.insert(meshPlacements, {
            assetId = meshAssetId,
            fallbackKind = "asset_replacement",
            position = center,
            scale = 1,
            yaw = facingYaw,
            seed = seed,
            swayTag = nil,
            parent = assetParent,
            fallbackInstance = fallback,
        })
        return fallback
    end

    local PLAZA = TOWN_CENTER
    -- The Watch Ring faces outward, away from the plaza, the way a defensive
    -- post looks toward what it is watching rather than toward the town it
    -- guards.
    local function facingAwayFromTown(center: Vector3): number
        return yawToward(center, center + Vector3.new(0, 0, -40))
    end

    local celebrationStage = authoredBuilding(
        "building_celebration_stage",
        "CELEBRATION STAGE",
        "mesh_celebration_stage_a",
        Vector3.new(0, 0, -226),
        Vector3.new(22, 0, 17),
        AMBER,
        yawToward(Vector3.new(0, 0, -226), PLAZA),
        10200
    )
    noteConstructionTarget(
        "building_celebration_stage",
        "CELEBRATION STAGE",
        signAnchor(celebrationStage)
    )

    -- Builder's Row: a line running south along the town's eastern edge, past
    -- the existing workbench.
    local sawmill = authoredBuilding(
        "building_sawmill",
        "SAWMILL",
        "mesh_sawmill_a",
        Vector3.new(150, 0, -100),
        Vector3.new(24, 0, 22),
        Color3.fromRGB(158, 122, 74),
        yawToward(Vector3.new(150, 0, -100), PLAZA),
        10201
    )
    noteConstructionTarget("building_sawmill", "SAWMILL", signAnchor(sawmill))
    local forge = authoredBuilding(
        "building_forge",
        "UNION FORGE",
        "mesh_union_forge_a",
        Vector3.new(150, 0, -140),
        Vector3.new(20, 0, 13),
        Color3.fromRGB(178, 92, 58),
        yawToward(Vector3.new(150, 0, -140), PLAZA),
        10202
    )
    noteConstructionTarget("building_forge", "UNION FORGE", signAnchor(forge))
    local engineerYard = authoredBuilding(
        "building_engineer_yard",
        "ENGINEER YARD",
        "mesh_engineer_yard_a",
        Vector3.new(150, 0, -180),
        Vector3.new(17, 0, 20),
        Color3.fromRGB(120, 128, 118),
        yawToward(Vector3.new(150, 0, -180), PLAZA),
        10203
    )
    noteConstructionTarget("building_engineer_yard", "ENGINEER YARD", signAnchor(engineerYard))

    -- Hearthmarket: the mirrored line on the western edge, past the inn.
    local kitchen = authoredBuilding(
        "building_kitchen",
        "COMMON KITCHEN",
        "mesh_common_kitchen_a",
        Vector3.new(-150, 0, -158),
        Vector3.new(20, 0, 20),
        Color3.fromRGB(196, 140, 79),
        yawToward(Vector3.new(-150, 0, -158), PLAZA),
        10204
    )
    noteConstructionTarget("building_kitchen", "COMMON KITCHEN", signAnchor(kitchen))
    local market = authoredBuilding(
        "building_market",
        "HEARTHMARKET STALLS",
        "mesh_hearthmarket_stalls_a",
        Vector3.new(-150, 0, -196),
        Vector3.new(24, 0, 12),
        Color3.fromRGB(112, 118, 132),
        yawToward(Vector3.new(-150, 0, -196), PLAZA),
        10205
    )
    noteConstructionTarget("building_market", "HEARTHMARKET STALLS", signAnchor(market))
    local tradePost = authoredBuilding(
        "building_trade_post",
        "TRADE POST",
        "mesh_trade_post_a",
        Vector3.new(-150, 0, -232),
        Vector3.new(16, 0, 10),
        Color3.fromRGB(184, 158, 96),
        yawToward(Vector3.new(-150, 0, -232), PLAZA),
        10206
    )
    noteConstructionTarget("building_trade_post", "TRADE POST", signAnchor(tradePost))

    -- Waterworks, tucked south of the existing Greenward garden.
    local waterworks = authoredBuilding(
        "building_waterworks",
        "WATERWORKS",
        "mesh_waterworks_a",
        Vector3.new(110, 0, -212),
        Vector3.new(18, 0, 15),
        Color3.fromRGB(96, 110, 118),
        yawToward(Vector3.new(110, 0, -212), PLAZA),
        10207
    )
    noteConstructionTarget("building_waterworks", "WATERWORKS", signAnchor(waterworks))

    -- The Watch Ring: the town's southern perimeter, facing outward.
    local guardhouse = authoredBuilding(
        "building_guardhouse",
        "GUARDHOUSE",
        "mesh_guardhouse_a",
        Vector3.new(-70, 0, -262),
        Vector3.new(16, 0, 14),
        Color3.fromRGB(88, 84, 80),
        facingAwayFromTown(Vector3.new(-70, 0, -262)),
        10208
    )
    noteConstructionTarget("building_guardhouse", "GUARDHOUSE", signAnchor(guardhouse))
    local watchtower = authoredBuilding(
        "building_watchtower",
        "WATCHTOWER",
        "mesh_watchtower_a",
        Vector3.new(70, 0, -262),
        Vector3.new(7, 0, 7),
        Color3.fromRGB(80, 78, 76),
        facingAwayFromTown(Vector3.new(70, 0, -262)),
        10209
    )
    noteConstructionTarget("building_watchtower", "WATCHTOWER", signAnchor(watchtower))
    local trapworks = authoredBuilding(
        "building_trapworks",
        "TRAPWORKS",
        "mesh_trapworks_a",
        Vector3.new(0, 0, -270),
        Vector3.new(16, 0, 14),
        Color3.fromRGB(94, 92, 74),
        facingAwayFromTown(Vector3.new(0, 0, -270)),
        10210
    )
    noteConstructionTarget("building_trapworks", "TRAPWORKS", signAnchor(trapworks))

    local residentDefinitions = {
        npc_tomas_reed = {
            displayName = "TOMAS REED",
            role = "QUARTERMASTER",
            coat = Color3.fromRGB(116, 72, 49),
            accent = Color3.fromRGB(221, 154, 78),
            skin = Color3.fromRGB(177, 124, 87),
            hair = Color3.fromRGB(55, 40, 34),
            prop = "cookpot",
            day = CFrame.new(-92, 3, -178) * CFrame.Angles(0, math.rad(180), 0),
            dusk = CFrame.new(-10, 3, -128) * CFrame.Angles(0, math.rad(-10), 0),
            night = CFrame.new(-9, 3, -138) * CFrame.Angles(0, math.rad(-15), 0),
            dayDuty = "PREPARING SUPPLIES",
        },
        npc_pip_wren = {
            displayName = "PIP WREN",
            role = "COURIER",
            coat = Color3.fromRGB(61, 88, 92),
            accent = Color3.fromRGB(112, 192, 176),
            skin = Color3.fromRGB(210, 157, 112),
            hair = Color3.fromRGB(111, 66, 43),
            prop = "route_map",
            day = CFrame.new(0, 3, -151) * CFrame.Angles(0, math.rad(180), 0),
            dusk = CFrame.new(0, 3, -128),
            night = CFrame.new(0, 3, -139),
            dayDuty = "MAPPING SAFE ROUTES",
        },
        npc_ena_moss = {
            displayName = "ENA MOSS",
            role = "SEEDKEEPER",
            coat = Color3.fromRGB(72, 103, 62),
            accent = Color3.fromRGB(191, 178, 82),
            skin = Color3.fromRGB(126, 87, 65),
            hair = Color3.fromRGB(41, 35, 29),
            prop = "seed_basket",
            day = CFrame.new(96, 3, -146) * CFrame.Angles(0, math.rad(180), 0),
            dusk = CFrame.new(10, 3, -128) * CFrame.Angles(0, math.rad(10), 0),
            night = CFrame.new(9, 3, -138) * CFrame.Angles(0, math.rad(15), 0),
            dayDuty = "TENDING THE GREENWARD",
        },
    }

    --[[
        A resident is a person, built the way Mara is.

        These were ~15 hand-stacked primitives: a coat slab, a cube head, a
        sphere of hair. At gameplay distance that read as a blocky mess rather
        than a villager, which is exactly what the character standard exists to
        prevent. They now use the same real R15 rig Mara does -- jointed limbs,
        real hands and feet, a rounded head -- tinted to each resident's own
        palette, with layered clothing, a readable face, and their role prop.

        Anchored throughout, for the same reason Mara is: the rig arrives
        unanchored and every part is non-colliding, so an unanchored resident
        falls through the valley floor and never stops.
    ]]
    local function buildResident(residentId: string, definition: any)
        local description = Instance.new("HumanoidDescription")
        description.HeadColor = definition.skin
        description.LeftArmColor = definition.coat
        description.RightArmColor = definition.coat
        description.TorsoColor = definition.coat
        description.LeftLegColor = definition.coat:Lerp(Color3.new(0, 0, 0), 0.35)
        description.RightLegColor = definition.coat:Lerp(Color3.new(0, 0, 0), 0.35)
        description.HeightScale = 0.98
        description.WidthScale = 0.9
        description.DepthScale = 0.92
        description.HeadScale = 1.02
        description.BodyTypeScale = 0.25
        description.ProportionScale = 0.6

        local model =
            Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
        model.Name = definition.displayName
        model:SetAttribute("ResidentId", residentId)
        model:SetAttribute("ResidentRole", definition.role)
        model:SetAttribute("RoutineDay", definition.day)
        model:SetAttribute("RoutineDusk", definition.dusk)
        model:SetAttribute("RoutineNight", definition.night)
        model:SetAttribute("DayDuty", definition.dayDuty)
        model:SetAttribute("MotionKind", "resident")
        model:SetAttribute("MotionSpeed", 0.58 + (#residentId % 5) * 0.06)
        model:PivotTo(definition.day)

        local residentHumanoid = model:WaitForChild("Humanoid") :: Humanoid
        residentHumanoid.DisplayName = definition.displayName
        -- The engine's own floating name renders bubble-less at 100 studs,
        -- stacked over the bubbled plate below at close range. One tag.
        residentHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        residentHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        residentHumanoid.BreakJointsOnDeath = false
        residentHumanoid.RequiresNeck = false

        local root = model:WaitForChild("HumanoidRootPart") :: BasePart
        root.Transparency = 1
        local torso = model:WaitForChild("UpperTorso") :: BasePart
        local head = model:WaitForChild("Head") :: BasePart
        for _, descendant in model:GetDescendants() do
            if descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
                descendant.CanTouch = false
                descendant.CanQuery = false
            end
        end

        local function attach(piece: BasePart, to: BasePart)
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = to
            weld.Part1 = piece
            weld.Parent = piece
        end

        -- Hair in layers rather than one sphere.
        local crown = part(
            model,
            "Hair",
            Vector3.new(head.Size.X * 1.12, head.Size.Y * 0.6, head.Size.Z * 1.12),
            head.CFrame * CFrame.new(0, head.Size.Y * 0.36, 0),
            definition.hair,
            Enum.Material.SmoothPlastic,
            false
        )
        crown.Shape = Enum.PartType.Ball
        attach(crown, head)
        local back = part(
            model,
            "HairBack",
            Vector3.new(head.Size.X * 0.98, head.Size.Y * 1.0, head.Size.Z * 0.6),
            head.CFrame * CFrame.new(0, -head.Size.Y * 0.24, head.Size.Z * 0.5),
            definition.hair,
            Enum.Material.SmoothPlastic,
            false
        )
        attach(back, head)

        -- A readable face: eyes, nose, mouth. Roblox heads face -Z.
        for eyeSide = -1, 1, 2 do
            local eye = part(
                model,
                "Eye",
                Vector3.new(head.Size.X * 0.14, head.Size.Y * 0.14, head.Size.Z * 0.1),
                head.CFrame
                    * CFrame.new(
                        eyeSide * head.Size.X * 0.22,
                        head.Size.Y * 0.08,
                        -head.Size.Z * 0.48
                    ),
                Color3.fromRGB(38, 44, 42),
                Enum.Material.SmoothPlastic,
                false
            )
            eye.Shape = Enum.PartType.Ball
            attach(eye, head)
        end
        local nose = part(
            model,
            "Nose",
            Vector3.new(head.Size.X * 0.12, head.Size.Y * 0.15, head.Size.Z * 0.15),
            head.CFrame * CFrame.new(0, -head.Size.Y * 0.04, -head.Size.Z * 0.52),
            definition.skin:Lerp(Color3.new(0, 0, 0), 0.12),
            Enum.Material.SmoothPlastic,
            false
        )
        attach(nose, head)
        local mouth = part(
            model,
            "Mouth",
            Vector3.new(head.Size.X * 0.22, head.Size.Y * 0.05, head.Size.Z * 0.08),
            head.CFrame * CFrame.new(0, -head.Size.Y * 0.26, -head.Size.Z * 0.48),
            Color3.fromRGB(142, 84, 74),
            Enum.Material.SmoothPlastic,
            false
        )
        attach(mouth, head)

        -- Layered working clothes, tinted per resident so the cast reads apart
        -- at a glance without relying on the nameplate.
        for shoulderSide = -1, 1, 2 do
            local shoulder = part(
                model,
                "CoatShoulder",
                Vector3.new(torso.Size.X * 0.44, torso.Size.Y * 0.28, torso.Size.Z * 1.2),
                torso.CFrame
                    * CFrame.new(shoulderSide * torso.Size.X * 0.36, torso.Size.Y * 0.26, 0)
                    * CFrame.Angles(0, 0, math.rad(shoulderSide * 6)),
                definition.coat:Lerp(Color3.new(0, 0, 0), 0.3),
                Enum.Material.Fabric,
                false
            )
            attach(shoulder, torso)
            local lowerArm =
                model:FindFirstChild(if shoulderSide < 0 then "LeftLowerArm" else "RightLowerArm")
            if lowerArm ~= nil and lowerArm:IsA("BasePart") then
                local cuff = part(
                    model,
                    "CoatCuff",
                    Vector3.new(
                        lowerArm.Size.X * 1.22,
                        lowerArm.Size.Y * 0.28,
                        lowerArm.Size.Z * 1.22
                    ),
                    lowerArm.CFrame * CFrame.new(0, -lowerArm.Size.Y * 0.34, 0),
                    definition.accent,
                    Enum.Material.Fabric,
                    false
                )
                attach(cuff, lowerArm)
            end
        end
        local apron = part(
            model,
            "ProfessionLayer",
            Vector3.new(torso.Size.X * 0.92, torso.Size.Y * 0.95, torso.Size.Z * 0.28),
            torso.CFrame * CFrame.new(0, -torso.Size.Y * 0.12, -torso.Size.Z * 0.56),
            definition.accent,
            Enum.Material.Fabric,
            false
        )
        attach(apron, torso)
        local belt = part(
            model,
            "CoatBelt",
            Vector3.new(torso.Size.X * 1.04, 0.28, torso.Size.Z * 1.1),
            torso.CFrame * CFrame.new(0, -torso.Size.Y * 0.44, 0),
            Color3.fromRGB(84, 58, 40),
            Enum.Material.Leather,
            false
        )
        attach(belt, torso)

        -- The prop that says what they do.
        local lowerArm = model:FindFirstChild("RightLowerArm")
        if lowerArm ~= nil and lowerArm:IsA("BasePart") then
            local propColor = if definition.prop == "cookpot"
                then Color3.fromRGB(58, 62, 60)
                elseif definition.prop == "route_map" then Color3.fromRGB(216, 200, 160)
                else Color3.fromRGB(96, 128, 74)
            local prop = part(
                model,
                "RolePropCarried",
                if definition.prop == "route_map"
                    then Vector3.new(1.5, 0.12, 1.1)
                    else Vector3.new(1, 0.9, 1),
                lowerArm.CFrame * CFrame.new(0, -lowerArm.Size.Y * 0.7, -0.3),
                propColor,
                if definition.prop == "route_map"
                    then Enum.Material.SmoothPlastic
                    else Enum.Material.Metal,
                false
            )
            attach(prop, lowerArm)
        end

        model.PrimaryPart = root
        model.Parent = parent
        table.insert(meshPlacements, {
            assetId = "mesh_creator_kerosene_lantern_a",
            fallbackKind = "asset_dressing",
            position = (definition.day * CFrame.new(1.6, -1.4, 0)).Position,
            scale = 0.9,
            yaw = math.rad(12),
            seed = 10150 + #residentId,
            swayTag = nil,
            parent = model,
            fallbackInstance = nil,
        })
        addBillboard(
            head,
            definition.displayName .. " · " .. definition.role,
            definition.accent,
            40
        )
        CollectionService:AddTag(model, runtimeIds.AmbientMotionTag)
        residents[residentId] = {
            model = model,
            dayDuty = definition.dayDuty,
            displayName = definition.displayName,
            interactionTarget = head,
        }
    end

    local activeResidentIds = if type(consequence.residentIds) == "table"
        then consequence.residentIds
        else {}
    for _, residentId in activeResidentIds do
        local definition = residentDefinitions[residentId]
        if definition ~= nil then
            buildResident(residentId, definition)
        end
    end

    parent:SetAttribute("BuildingCount", 4)
    parent:SetAttribute("ResidentCount", #activeResidentIds)
    parent:SetAttribute("ArchiveStage", archiveStage)
    parent:SetAttribute("WorkbenchStage", workbenchStage)
    parent:SetAttribute("InnStage", innStage)
    return residents, constructionTargets, buildingPlacements
end

function WorldService._setTownResidentRoutine(self: WorldService, phase: string)
    local normalized = if phase == "night" then "Night" elseif phase == "dusk" then "Dusk" else "Day"
    for _, resident in self._townResidents do
        local model = resident.model
        if model ~= nil and model.Parent ~= nil then
            local destination = model:GetAttribute("Routine" .. normalized)
            if typeof(destination) == "CFrame" then
                model:PivotTo(destination)
            end
            model:SetAttribute("Routine", string.lower(normalized))
            model:SetAttribute(
                "CurrentDuty",
                if normalized == "Day"
                    then resident.dayDuty
                    elseif normalized == "Dusk" then "REPORTING TO THE NIGHT WATCH"
                    else "DEFENDING THE LANTERN ROAD"
            )
            local lanternPart = model:FindFirstChild("NightWatchLantern")
            if lanternPart ~= nil and lanternPart:IsA("BasePart") then
                local active = normalized ~= "Day"
                lanternPart.Transparency = if active then 0.16 else 1
                local light = lanternPart:FindFirstChildOfClass("PointLight")
                if light ~= nil then
                    light.Enabled = active
                end
            end
        end
    end
end

-- Tears down and rebuilds the whole GreenwardConsequence/TownProgressionBuildings
-- tree from self._townConsequence and self._townConstruction. Both setters
-- below update their own piece of merged state and then call this, so
-- neither the tier ceiling nor the construction ledger can drive a rebuild
-- that reflects only half of what the town actually knows.
function WorldService._rebuildTownProgression(self: WorldService)
    local world = self._world
    local resolved = self._townConsequence
    if world == nil or type(resolved) ~= "table" then
        return
    end
    local existing = world:FindFirstChild("GreenwardConsequence")
    if existing ~= nil then
        existing:Destroy()
    end
    local existingBuildings = world:FindFirstChild("TownProgressionBuildings")
    for _, interactionId in self._runtimeIds.ResidentInteractionIds do
        local residentPrompt = self._interactions[interactionId]
        if residentPrompt ~= nil then
            residentPrompt:Destroy()
            self._interactions[interactionId] = nil
        end
    end
    for _, interactionId in self._runtimeIds.ConstructionInteractionIds do
        local constructionPrompt = self._interactions[interactionId]
        if constructionPrompt ~= nil then
            constructionPrompt:Destroy()
            self._interactions[interactionId] = nil
        end
    end
    if existingBuildings ~= nil then
        existingBuildings:Destroy()
    end
    --[[
        The authored meshes this rebuild is about to queue used to be parented
        straight to the world, while only GreenwardConsequence and
        TownProgressionBuildings were torn down above. Every rebuild therefore
        orphaned whatever the previous pass had already placed, stacked at
        identical coordinates.

        That is not a rare path. A profile load calls setTownConsequence and
        setTownConstruction back to back, so the town rebuilds twice before a
        player has done anything, and it rebuilds again on every construction
        contribution for the rest of the session. Holding the placements in
        their own container means one Destroy takes the whole previous pass
        with it.
    ]]
    local existingAuthored = world:FindFirstChild("TownAuthoredMeshes")
    if existingAuthored ~= nil then
        existingAuthored:Destroy()
    end
    local authoredMeshes = Instance.new("Model")
    authoredMeshes.Name = "TownAuthoredMeshes"
    authoredMeshes.Parent = world
    local landscape = Instance.new("Model")
    landscape.Name = "GreenwardConsequence"
    landscape.Parent = world
    local townMeshPlacements: { MeshPlacement } = {}
    buildTownConsequenceLandscape(landscape, resolved, authoredMeshes, townMeshPlacements)
    local buildings = Instance.new("Model")
    buildings.Name = "TownProgressionBuildings"
    buildings.Parent = world
    local residents, constructionTargets, buildingPlacements = buildTownProgressionBuildings(
        buildings,
        resolved,
        self._runtimeIds,
        authoredMeshes,
        townMeshPlacements,
        self._townConstruction,
        self._townConstructionRules
    )
    self._townResidents = residents
    self._buildingPlacements = buildingPlacements
    self:_placeAuthoredMeshes(
        townMeshPlacements,
        authoredMeshes,
        buildings,
        "town_mesh_dressing_ready"
    )
    for residentId, resident in self._townResidents do
        local interactionId = self._runtimeIds.ResidentInteractionIds[residentId]
        if interactionId ~= nil and resident.interactionTarget ~= nil then
            self:_registerInteraction(
                resident.interactionTarget,
                interactionId,
                self._runtimeIds.Actions.TalkResident,
                "TALK",
                resident.displayName,
                residentId,
                nil,
                -- People get a person-sized volume, like Mara. The default is
                -- shaped for buildings and props, and at that size neighbouring
                -- residents would overlap into each other's reach.
                Vector3.new(7, 8, 7)
            )
        end
    end
    for buildingId, buildingTarget in constructionTargets do
        local interactionId = self._runtimeIds.ConstructionInteractionIds[buildingId]
        if interactionId ~= nil then
            self:_registerInteraction(
                buildingTarget.target,
                interactionId,
                self._runtimeIds.Actions.ContributeConstruction,
                "BUILD",
                buildingTarget.displayName,
                buildingId
            )
        end
    end
    self:_setTownResidentRoutine(
        if self._night then "night" elseif self._dusk then "dusk" else "day"
    )
    local visualPartCount = 0
    for _, descendant in landscape:GetDescendants() do
        if descendant:IsA("BasePart") then
            visualPartCount += 1
        end
    end
    landscape:SetAttribute("VisualPartCount", visualPartCount)
    world:SetAttribute("TownTier", resolved.tier)
    world:SetAttribute("TownDecision", tostring(resolved.decision or "unresolved"))
    world:SetAttribute("WardenOutcome", tostring(resolved.wardenOutcome or "unresolved"))
end

function WorldService.setTownConsequence(self: WorldService, consequence: any)
    if self._world == nil or type(consequence) ~= "table" then
        return
    end
    self._townConsequence = self._townProgression.merge(self._townConsequence, consequence)
    self:_rebuildTownProgression()
end

-- Construction orders are shared town state exactly like the tier
-- consequence above: whichever player funds a stage, everyone sees it, so
-- this merges into the same server-wide accumulator rather than per-player
-- state, and never regresses one player's contribution because another
-- player's snapshot has not caught up yet.
function WorldService.setTownConstruction(self: WorldService, construction: any)
    if self._world == nil or type(construction) ~= "table" then
        return
    end
    self._townConstruction = self._townConstructionRules.merge(self._townConstruction, construction)
    self:_rebuildTownProgression()
end

--[[
    Rebuild the town's visible storm damage from a per-building condition
    snapshot.

    A repair site now stands beside the building it belongs to, at the centre
    that building recorded when it was placed, and its prompt carries that
    building's ID as its baked Payload -- so repairing the inn repairs the inn.
    Under the single-integrity model this could not be true: every repair moved
    one shared number, and which of three fixed piles appeared was a function of
    that number, so fixing the inn could make the archive's damage vanish.
]]
function WorldService.setTownCondition(self: WorldService, condition: any)
    local world = self._world
    if world == nil or type(condition) ~= "table" then
        return
    end
    local integrity = math.clamp(math.floor(tonumber(condition.integrity) or 100), 25, 100)
    local damaged = if type(condition.damagedBuildings) == "table"
        then condition.damagedBuildings
        else {}
    self._townCondition = {
        integrity = integrity,
        damageLevel = #damaged,
        lastNightNumber = math.max(0, math.floor(tonumber(condition.lastNightNumber) or 0)),
        lastDamage = math.max(0, math.floor(tonumber(condition.lastDamage) or 0)),
        repairsCompleted = math.max(0, math.floor(tonumber(condition.repairsCompleted) or 0)),
        repairsRemaining = math.max(0, math.floor(tonumber(condition.repairsRemaining) or 0)),
    }

    for _, interactionId in self._runtimeIds.TownRepairInteractionIdByBuilding do
        local prompt = self._interactions[interactionId]
        if prompt ~= nil then
            prompt:Destroy()
            self._interactions[interactionId] = nil
        end
    end
    local existing = world:FindFirstChild("TownDamageConsequences")
    if existing ~= nil then
        existing:Destroy()
    end
    world:SetAttribute("TownIntegrity", integrity)
    world:SetAttribute("TownDamageLevel", #damaged)
    if #damaged == 0 then
        return
    end

    local damageModel = Instance.new("Model")
    damageModel.Name = "TownDamageConsequences"
    damageModel:SetAttribute("Integrity", integrity)
    damageModel:SetAttribute("DamageLevel", #damaged)
    damageModel.Parent = world

    local placed = 0
    for _, entry in damaged do
        local buildingId = if type(entry) == "table" then entry.buildingId else nil
        local placement = if type(buildingId) == "string"
            then self._buildingPlacements[buildingId]
            else nil
        local interactionId = if type(buildingId) == "string"
            then self._runtimeIds.TownRepairInteractionIdByBuilding[buildingId]
            else nil
        -- A building with no recorded placement, or one still standing as a
        -- construction site, is not something this town has built -- and a
        -- migrated profile can carry damage for either. The snapshot already
        -- filters these out; this is the second gate, because the cost of
        -- getting it wrong is a REPAIR prompt on an empty lot.
        if placement == nil or placement.damageable ~= true or interactionId == nil then
            continue
        end

        placed += 1
        local buildingIntegrity = math.clamp(math.floor(tonumber(entry.integrity) or 100), 25, 100)
        -- Offset toward the street so the work sits in front of the building
        -- rather than inside its walls, and never on the building's own anchor.
        local site = placement.center + Vector3.new(0, 2.4, 9.5)
        local target = part(
            damageModel,
            "RepairPile_" .. buildingId,
            Vector3.new(5.5, 1.2, 2.8),
            CFrame.new(site) * CFrame.Angles(0, math.rad(placed * 8 - 16), 0),
            Color3.fromRGB(93, 65, 43),
            Enum.Material.WoodPlanks,
            false
        )
        target:SetAttribute("BuildingId", buildingId)
        target:SetAttribute("BuildingIntegrity", buildingIntegrity)
        for braceIndex = -1, 1 do
            part(
                damageModel,
                "StormBrokenBrace",
                Vector3.new(0.55, 5.5, 0.55),
                target.CFrame
                    * CFrame.new(braceIndex * 1.8, 2, 0)
                    * CFrame.Angles(0, 0, math.rad(braceIndex * 18)),
                if braceIndex == 0 then Color3.fromRGB(48, 41, 37) else BARK,
                Enum.Material.Wood,
                false
            )
        end
        local canvas = part(
            damageModel,
            "StormTarp",
            Vector3.new(5.8, 0.2, 4.4),
            CFrame.new(site + Vector3.new(0, 4.2, 0))
                * CFrame.Angles(0, 0, math.rad(placed % 2 == 0 and -7 or 7)),
            Color3.fromRGB(75, 87, 77),
            Enum.Material.Fabric,
            false
        )
        canvas.Transparency = 0.06
        self:_registerInteraction(
            target,
            interactionId,
            self._runtimeIds.Actions.RepairTown,
            "REPAIR",
            string.format("%s · %d%%", self:_buildingDisplayName(buildingId), buildingIntegrity),
            -- The building this prompt repairs, baked in at build time. The
            -- client only ever sends the interaction ID, exactly as it does for
            -- a crafting bench, so nothing a client says can name a building.
            buildingId,
            1.1
        )
    end
    self:setTownRepairEnabled(not self._night and not self._dusk)
end

-- A readable name for a building ID, for a prompt that has to say which
-- building it repairs. Falls back to the ID's own words rather than going
-- blank on a building added without a display name.
function WorldService._buildingDisplayName(self: WorldService, buildingId: string): string
    local model = if self._world ~= nil then self._world:FindFirstChild(buildingId, true) else nil
    if model ~= nil then
        local sign = model:FindFirstChild("BuildingSign")
        if sign ~= nil and sign:GetAttribute("DisplayName") ~= nil then
            return tostring(sign:GetAttribute("DisplayName"))
        end
    end
    local words = string.gsub(string.gsub(buildingId, "^building_", ""), "_", " ")
    return string.upper(words)
end

-- Which buildings physically stand and can therefore be storm damaged. A
-- construction site is excluded: nobody has built it yet.
function WorldService.damageableBuildingIds(self: WorldService): { string }
    local ids = {}
    for buildingId, placement in self._buildingPlacements do
        if type(placement) == "table" and placement.damageable == true then
            table.insert(ids, buildingId)
        end
    end
    table.sort(ids)
    return ids
end

function WorldService.setTownRepairEnabled(self: WorldService, enabled: boolean)
    for _, interactionId in self._runtimeIds.TownRepairInteractionIdByBuilding do
        local prompt = self._interactions[interactionId]
        if prompt ~= nil then
            prompt.Enabled = enabled and self._townCondition.damageLevel > 0
        end
    end
end

function WorldService.showExtractionPayoff(
    self: WorldService,
    player: Player,
    materials: any,
    overflow: any?
)
    local entries, total = self._extractionPayoff.summarize(materials)
    local world = self._world
    if world == nil or #entries == 0 or total <= 0 or player.Parent == nil then
        return
    end
    -- A full store is said at the moment of delivery, on the delivery
    -- itself, where the player is already reading what they banked. Storage
    -- caps that fail silently are just theft with paperwork.
    local overflowLost = 0
    if type(overflow) == "table" then
        for _, amount in overflow do
            overflowLost += tonumber(amount) or 0
        end
    end

    local deliveries = world:FindFirstChild("WayhomeDeliveries")
    if deliveries == nil then
        deliveries = Instance.new("Folder")
        deliveries.Name = "WayhomeDeliveries"
        deliveries.Parent = world
    end
    local deliveryName = "WayhomeDelivery_" .. tostring(player.UserId)
    local existing = deliveries:FindFirstChild(deliveryName)
    local existingSlot = if existing ~= nil then existing:GetAttribute("DeliverySlot") else nil
    if existing ~= nil then
        existing:Destroy()
    end

    local occupied: { [number]: boolean } = {}
    for _, candidate in deliveries:GetChildren() do
        local candidateSlot = candidate:GetAttribute("DeliverySlot")
        if type(candidateSlot) == "number" then
            occupied[candidateSlot] = true
        end
    end
    local slot = if type(existingSlot) == "number"
            and existingSlot >= 1
            and existingSlot <= #WAYHOME_DELIVERY_ORIGINS
        then existingSlot
        else self._extractionPayoff.firstAvailableSlot(occupied, #WAYHOME_DELIVERY_ORIGINS)
    if slot == nil then
        self._logger:info("wayhome_delivery_skipped", {
            player = player.UserId,
            reason = "delivery_slots_full",
        })
        return
    end

    local delivery = Instance.new("Model")
    delivery.Name = deliveryName
    delivery:SetAttribute("OwnerUserId", player.UserId)
    delivery:SetAttribute("MaterialCount", total)
    delivery:SetAttribute("DeliverySlot", slot)
    delivery.Parent = deliveries

    local origin = WAYHOME_DELIVERY_ORIGINS[slot]
    local pallet = part(
        delivery,
        "WayhomePallet",
        Vector3.new(7, 0.65, 5.5),
        CFrame.new(origin + Vector3.new(0, 0.34, 0)),
        Color3.fromRGB(91, 63, 43),
        Enum.Material.WoodPlanks,
        false
    )
    for railSide = -1, 1, 2 do
        part(
            delivery,
            "WayhomePalletRail",
            Vector3.new(0.42, 1.85, 5.65),
            CFrame.new(origin + Vector3.new(railSide * 3.18, 1.2, 0)),
            Color3.fromRGB(72, 50, 36),
            Enum.Material.Wood,
            false
        )
        part(
            delivery,
            "WayhomePalletBinding",
            Vector3.new(6.55, 0.22, 0.26),
            CFrame.new(origin + Vector3.new(0, 1.65, railSide * 2.25)),
            Color3.fromRGB(103, 91, 68),
            Enum.Material.Fabric,
            false
        )
    end
    if overflowLost > 0 then
        local warning = part(
            delivery,
            "WayhomeOverflowNotice",
            Vector3.new(0.2, 0.2, 0.2),
            CFrame.new(origin + Vector3.new(0, 4.6, 0)),
            Color3.fromRGB(255, 138, 92),
            Enum.Material.Neon,
            false
        )
        warning.Transparency = 1
        warning.CanQuery = false
        addBillboard(
            warning,
            string.format("STORES FULL · %d SURPLUS TURNED AWAY", overflowLost),
            Color3.fromRGB(255, 138, 92),
            60
        )
    end
    addBillboard(
        pallet,
        string.format(
            "%s · WAYHOME DELIVERY · %d",
            string.upper(string.sub(player.DisplayName, 1, 18)),
            total
        ),
        AMBER
    )

    local pieceIndex = 0
    local function animatePiece(piece: BasePart, targetCFrame: CFrame)
        pieceIndex += 1
        piece.CFrame = targetCFrame - Vector3.new(0, 4.5 + pieceIndex * 0.16, 0)
        task.delay(0.08 * pieceIndex, function()
            if piece.Parent ~= nil then
                TweenService
                    :Create(
                        piece,
                        TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                        { CFrame = targetCFrame }
                    )
                    :Play()
            end
        end)
    end

    for entryIndex, entry in entries do
        local stackCount = math.min(3, math.max(1, math.ceil(entry.amount / 3)))
        for stackIndex = 1, stackCount do
            local row = entryIndex - 1
            local offset = Vector3.new(-2.4 + (stackIndex - 1) * 2.35, 1.2, -1.7 + row * 1.15)
            local targetCFrame = CFrame.new(origin + offset)
            local cargo: Part
            if entry.kind == "heartwood" then
                cargo = part(
                    delivery,
                    "HeartwoodLog",
                    Vector3.new(1.1, 3.6, 1.1),
                    targetCFrame * CFrame.Angles(0, 0, math.rad(90)),
                    BARK,
                    Enum.Material.Wood,
                    false
                )
                cargo.Shape = Enum.PartType.Cylinder
                targetCFrame = cargo.CFrame
            elseif entry.kind == "amber" then
                cargo = part(
                    delivery,
                    "AmberSapVial",
                    Vector3.new(1.25, 1.55, 1.25),
                    targetCFrame,
                    AMBER,
                    Enum.Material.Glass,
                    false
                )
                cargo.Shape = Enum.PartType.Ball
                cargo.Transparency = 0.12
                if stackIndex == 1 then
                    local cargoLight = Instance.new("PointLight")
                    cargoLight.Color = AMBER
                    cargoLight.Brightness = 0.8
                    cargoLight.Range = 9
                    cargoLight.Shadows = false
                    cargoLight.Parent = cargo
                end
            elseif entry.kind == "brightcap" then
                cargo = part(
                    delivery,
                    "Brightcap",
                    Vector3.new(1.8, 0.85, 1.8),
                    targetCFrame + Vector3.new(0, 0.65, 0),
                    FOXFIRE,
                    Enum.Material.Neon,
                    false
                )
                cargo.Shape = Enum.PartType.Ball
                targetCFrame = cargo.CFrame
                local stem = part(
                    delivery,
                    "BrightcapStem",
                    Vector3.new(0.55, 1.3, 0.55),
                    targetCFrame - Vector3.new(0, 0.8, 0),
                    CREAM,
                    Enum.Material.Wood,
                    false
                )
                animatePiece(stem, stem.CFrame)
            elseif entry.kind == "fiber" then
                cargo = part(
                    delivery,
                    "MeadowFiberBundle",
                    Vector3.new(1.5, 1.1, 2.4),
                    targetCFrame * CFrame.Angles(0, 0, math.rad(12)),
                    Color3.fromRGB(169, 139, 67),
                    Enum.Material.Fabric,
                    false
                )
                targetCFrame = cargo.CFrame
            else
                cargo = part(
                    delivery,
                    "SpringClayBundle",
                    Vector3.new(1.6, 1.35, 1.6),
                    targetCFrame,
                    Color3.fromRGB(133, 91, 72),
                    Enum.Material.Ground,
                    false
                )
                cargo.Shape = Enum.PartType.Ball
            end
            cargo:SetAttribute("MaterialId", entry.id)
            cargo:SetAttribute("Amount", entry.amount)
            animatePiece(cargo, targetCFrame)
        end
    end

    local pulse = part(
        delivery,
        "WayhomeDeliveryPulse",
        Vector3.new(0.14, 3, 3),
        CFrame.new(origin + Vector3.new(0, 0.16, 0)) * CFrame.Angles(0, 0, math.rad(90)),
        FOXFIRE,
        Enum.Material.Glass,
        false
    )
    pulse.Shape = Enum.PartType.Cylinder
    pulse.Transparency = 0.38
    pulse.CastShadow = false
    TweenService:Create(
        pulse,
        TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = Vector3.new(0.14, 13, 13), Transparency = 1 }
    ):Play()
    task.delay(WAYHOME_DELIVERY_LIFETIME, function()
        if delivery.Parent ~= nil then
            delivery:Destroy()
        end
    end)
    task.delay(1, function()
        if pulse.Parent ~= nil then
            pulse:Destroy()
        end
    end)
end

function WorldService.buildBramblewake(
    self: WorldService,
    manifest: any,
    generator: any,
    catalog: any
): any
    local world = assert(self._world, "world service has not initialized")
    for interactionId, prompt in self._interactions do
        local actionId = prompt:GetAttribute("ActionId")
        if
            actionId == self._runtimeIds.Actions.ExpeditionEvent
            or actionId == self._runtimeIds.Actions.Extract
            or actionId == self._runtimeIds.Actions.OldGrowthFire
            or actionId == self._runtimeIds.Actions.WardenStagChoice
            or actionId == self._runtimeIds.Actions.BramblewakeBlackout
            or actionId == self._runtimeIds.Actions.RecoverExpeditionCache
        then
            self._interactions[interactionId] = nil
        end
    end
    self._eventSockets = {}
    self._eventTargets = {}
    self._oldGrowthArena = nil
    self._wardenStagArena = nil
    self._blackoutArena = nil

    local result = BramblewakeBuilder.build(world, manifest, generator, catalog, self._runtimeIds)
    self:_placeAuthoredMeshes(
        result.meshPlacements,
        result.model,
        result.model,
        "expedition_mesh_dressing_ready"
    )
    self._expeditionEntry = result.entryCFrame
    self._expeditionManifest = manifest
    self._expeditionModuleCenters = result.moduleCenters
    self._eventSockets = result.eventSockets
    self._oldGrowthArena = result.eliteArena
    self._wardenStagArena = result.bossArena
    self._blackoutArena = result.blackout
    self:_registerInteraction(
        result.extractionTarget,
        self._runtimeIds.InteractionIds.Wayhome,
        self._runtimeIds.Actions.Extract,
        "BANK & RETURN",
        "Wayhome Gate",
        nil,
        nil
    )
    -- Harvest nodes: the reason to walk the route. Registered with the same
    -- generous click volume everything else uses, and remembered here so the
    -- tutorial service can look up what a given node grants.
    self._resourceNodes = {}
    for _, node in result.resourceNodes or {} do
        self:_registerInteraction(
            node.target,
            node.interactionId,
            self._runtimeIds.Actions.GatherResource,
            "HARVEST",
            node.objectText,
            nil,
            nil,
            Vector3.new(10, 12, 10)
        )
        self._resourceNodes[node.interactionId] = node
        addBillboard(node.target, string.upper(node.objectText), AMBER, 90)
    end

    --[[
        Memory fragments: chapter one's story, resting on scenery that was
        already standing there.

        Anchors resolve against the world the builder just made rather than a
        second table of coordinates, because a hand-maintained position list
        drifts from the builder the first time a landmark moves -- the exact
        failure validate_town_layout.py exists to catch. A fragment whose
        anchor cannot be resolved is skipped silently: content should never be
        able to break world construction.

        The shard itself is physical, per the visual standard -- a slate
        cradle holding an angular foxfire crystal, foxfire being the palette's
        memory cue -- with the interaction on an invisible anchor inside it.
    ]]
    self._memoryFragmentTargets = {}
    local function resolveFragmentAnchor(anchorKey: string): BasePart?
        local kind, key = string.match(anchorKey, "^(%a+):(.+)$")
        if kind == nil or key == nil then
            return nil
        end
        if kind == "story" then
            for _, descendant in result.model:GetDescendants() do
                if
                    descendant:IsA("BasePart")
                    and descendant:GetAttribute("StoryLandmark") == key
                then
                    return descendant
                end
            end
            return nil
        elseif kind == "poi" then
            local model = result.model:FindFirstChild("PhysicalPOI_" .. key, true)
            local anchorPart = if model ~= nil
                then model:FindFirstChild("PointOfInterest", true)
                else nil
            return if anchorPart ~= nil and anchorPart:IsA("BasePart") then anchorPart else nil
        elseif kind == "site" and key == "wayhome" then
            return result.extractionTarget
        elseif kind == "site" and key == "warden_seal" then
            local seal = result.bossArena ~= nil and result.bossArena.seal or nil
            return if seal ~= nil and seal:IsA("BasePart") then seal else nil
        end
        return nil
    end

    for _, fragment in self._memoryFragments.List do
        local anchorPart = resolveFragmentAnchor(fragment.anchorKey)
        if anchorPart ~= nil then
            local shard = Instance.new("Model")
            shard.Name = "MemoryFragment_" .. fragment.id
            shard:SetAttribute("MemoryFragmentId", fragment.id)
            shard.Parent = result.model
            --[[
                Seat the shard on the ground, not on its anchor's height.

                The anchors are whatever object holds the memory -- a harvest
                table top, a well rim, the Wayhome gate's light. Their Y
                values have nothing in common, so inheriting one put the
                bell fragment 7.5 studs in the air above the extraction gate
                and sank the Mothwell one into the rim stone. Measure the
                surface instead, the same way foliage and enemy placement
                already do; fall back to the anchor only if nothing is under
                it at all.
            ]]
            local shardX = anchorPart.Position.X + 2.6
            local shardZ = anchorPart.Position.Z + 2.6
            local groundParams = RaycastParams.new()
            groundParams.FilterType = Enum.RaycastFilterType.Exclude
            local ignored: { Instance } = { shard }
            groundParams.FilterDescendantsInstances = ignored
            --[[
                Ground is what a player can stand on, so anything that does
                not collide is not ground. Without this the ray stopped on the
                Wayhome Gate's own invisible interaction volume and seated the
                bell fragment sixteen studs in the air -- click volumes are
                deliberately queryable (that is what makes tap-to-interact
                work), so they answer a raycast while being nothing anyone
                could stand on.
            ]]
            local groundY = anchorPart.Position.Y
            local origin = Vector3.new(shardX, anchorPart.Position.Y + 14, shardZ)
            for _ = 1, 8 do
                local groundHit = workspace:Raycast(origin, Vector3.new(0, -90, 0), groundParams)
                if groundHit == nil then
                    break
                end
                if groundHit.Instance:IsA("Terrain") or groundHit.Instance.CanCollide then
                    groundY = groundHit.Position.Y
                    break
                end
                table.insert(ignored, groundHit.Instance)
                groundParams.FilterDescendantsInstances = ignored
                origin = groundHit.Position - Vector3.new(0, 0.05, 0)
            end
            local base = Vector3.new(shardX, groundY, shardZ)
            local cradle = part(
                shard,
                "MemoryShardCradle",
                Vector3.new(2.2, 0.5, 2.2),
                CFrame.new(base + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0.4, 0),
                Color3.fromRGB(58, 67, 63),
                Enum.Material.Slate,
                false
            )
            cradle.CanQuery = false
            for index = 1, 3 do
                local stone = part(
                    shard,
                    "MemoryShardStone",
                    Vector3.new(0.7, 0.5, 0.6),
                    CFrame.new(
                        base
                            + Vector3.new(
                                math.cos(index * 2.1) * 0.85,
                                0.62,
                                math.sin(index * 2.1) * 0.85
                            )
                    ) * CFrame.Angles(0.2, index * 1.3, 0.15),
                    Color3.fromRGB(74, 84, 78),
                    Enum.Material.Slate,
                    false
                )
                stone.CanQuery = false
            end
            local crystal = part(
                shard,
                "MemoryShardCrystal",
                Vector3.new(0.62, 1.5, 0.62),
                CFrame.new(base + Vector3.new(0, 1.35, 0)) * CFrame.Angles(0.16, 0.7, 0.1),
                FOXFIRE,
                Enum.Material.Neon,
                false
            )
            crystal.CanQuery = false
            crystal.CastShadow = false
            local crystalLight = Instance.new("PointLight")
            crystalLight.Color = FOXFIRE
            crystalLight.Brightness = 1.1
            crystalLight.Range = 13
            crystalLight.Shadows = false
            crystalLight.Parent = crystal
            CollectionService:AddTag(crystal, self._runtimeIds.AmbientLightTag)
            local target = part(
                shard,
                "MemoryFragmentAnchor",
                Vector3.new(3.4, 4, 3.4),
                CFrame.new(base + Vector3.new(0, 1.6, 0)),
                FOXFIRE,
                Enum.Material.Neon,
                false
            )
            target.Transparency = 1
            local interactionId = "memory_" .. fragment.id
            self:_registerInteraction(
                target,
                interactionId,
                self._runtimeIds.Actions.RecoverMemoryFragment,
                "REMEMBER",
                fragment.title,
                nil,
                nil,
                Vector3.new(9, 11, 9)
            )
            self._memoryFragmentTargets[interactionId] = {
                fragmentId = fragment.id,
                model = shard,
                crystal = crystal,
            }
        end
    end

    for _, descriptor in result.eventInteractions do
        self:_registerInteraction(
            descriptor.target,
            descriptor.interactionId,
            self._runtimeIds.Actions.ExpeditionEvent,
            descriptor.actionText,
            descriptor.objectText,
            nil,
            nil
        )
        local prompt = self._interactions[descriptor.interactionId]
        prompt:SetAttribute("EventId", descriptor.eventId)
        prompt:SetAttribute("EventStepId", descriptor.stepId)
        local targets = self._eventTargets[descriptor.eventId]
        if targets == nil then
            targets = {}
            self._eventTargets[descriptor.eventId] = targets
        end
        targets[descriptor.stepId] = descriptor.target
    end
    self:_registerInteraction(
        result.eliteArena.fireSource,
        self._runtimeIds.InteractionIds.OldGrowthFireSource,
        self._runtimeIds.Actions.OldGrowthFire,
        "TAKE FIRE",
        "Lantern Fire",
        nil,
        nil
    )
    self:_registerInteraction(
        result.eliteArena.rootHeart,
        self._runtimeIds.InteractionIds.OldGrowthHeart,
        self._runtimeIds.Actions.OldGrowthFire,
        "BURN SHIELD",
        "Root Heart",
        nil,
        nil
    )
    self:setOldGrowthPresentation("dormant")
    for _, descriptor in result.bossArena.interactions do
        self:_registerInteraction(
            descriptor.target,
            descriptor.interactionId,
            self._runtimeIds.Actions.WardenStagChoice,
            descriptor.actionText,
            descriptor.objectText,
            nil,
            descriptor.holdDuration
        )
    end
    self:setWardenStagPresentation({
        brokenAntlers = {},
        cleansedNodes = {},
        status = "locked",
    })
    for _, descriptor in result.blackout.interactions do
        self:_registerInteraction(
            descriptor.target,
            descriptor.interactionId,
            self._runtimeIds.Actions.BramblewakeBlackout,
            descriptor.actionText,
            descriptor.objectText,
            nil,
            descriptor.holdDuration
        )
    end
    self:setBlackoutPresentation({
        deliveredNodes = {},
        status = "dormant",
    })
    world:SetAttribute("ExpeditionReady", true)
    world:SetAttribute("ExpeditionManifestHash", manifest.hash)
    world:SetAttribute("ExpeditionEventInteractions", #result.eventInteractions)
    return result
end

function WorldService.clearRecoveryCache(self: WorldService, player: Player)
    local interactionId = string.format("recovery_cache:%d", player.UserId)
    local prompt = self._interactions[interactionId]
    if prompt ~= nil then
        prompt:Destroy()
        self._interactions[interactionId] = nil
    end
    local world = self._world
    if world ~= nil then
        local caches = world:FindFirstChild("ExpeditionRecoveryCaches")
        local model = if caches == nil
            then nil
            else caches:FindFirstChild("RecoveryCache_" .. tostring(player.UserId))
        if model ~= nil then
            model:Destroy()
        end
    end
end

function WorldService.showRecoveryCache(self: WorldService, player: Player, cache: any)
    self:clearRecoveryCache(player)
    local world = self._world
    local entry = self._expeditionEntry
    if world == nil or entry == nil or cache == nil then
        return
    end
    local caches = world:FindFirstChild("ExpeditionRecoveryCaches")
    if caches == nil then
        caches = Instance.new("Folder")
        caches.Name = "ExpeditionRecoveryCaches"
        caches.Parent = world
    end
    local model = Instance.new("Model")
    model.Name = "RecoveryCache_" .. tostring(player.UserId)
    model:SetAttribute("CacheId", cache.cacheId)
    model:SetAttribute("OwnerUserId", player.UserId)
    model.Parent = caches
    local side = if player.UserId % 2 == 0 then -1 else 1
    local offset = Vector3.new(side * (5 + player.UserId % 3), 0.7, 7 + player.UserId % 4)
    local at = entry.Position + offset
    local body = part(
        model,
        "RecoverySatchel",
        Vector3.new(3.8, 2.6, 2.4),
        CFrame.new(at),
        Color3.fromRGB(77, 57, 40),
        Enum.Material.Fabric,
        false
    )
    for index = -1, 1, 2 do
        part(
            model,
            "SatchelBrace",
            Vector3.new(0.28, 2.8, 2.55),
            CFrame.new(at + Vector3.new(index * 1.25, 0, 0)),
            Color3.fromRGB(111, 81, 48),
            Enum.Material.Wood,
            false
        )
    end
    part(
        model,
        "SatchelFlap",
        Vector3.new(3.65, 0.35, 2.2),
        CFrame.new(at + Vector3.new(0, 1.35, -0.15)) * CFrame.Angles(math.rad(-7), 0, 0),
        Color3.fromRGB(53, 72, 51),
        Enum.Material.Fabric,
        false
    )
    local clasp = part(
        model,
        "WayhomeClasp",
        Vector3.new(0.8, 0.8, 0.32),
        CFrame.new(at + Vector3.new(0, 0.25, -1.3)),
        Color3.fromRGB(185, 145, 72),
        Enum.Material.Metal,
        false
    )
    clasp.Shape = Enum.PartType.Ball
    addBillboard(body, "LOST SATCHEL · " .. string.upper(player.DisplayName), CREAM)
    local interactionId = string.format("recovery_cache:%d", player.UserId)
    self:_registerInteraction(
        body,
        interactionId,
        self._runtimeIds.Actions.RecoverExpeditionCache,
        "RECOVER",
        "Lost Expedition Satchel",
        cache.cacheId,
        1.2
    )
    local prompt = self._interactions[interactionId]
    prompt:SetAttribute("OwnerUserId", player.UserId)
end

function WorldService.wardenSealPart(self: WorldService): BasePart?
    local arena = self._wardenStagArena
    local seal = if arena ~= nil then arena.seal else nil
    return if seal ~= nil and seal:IsA("BasePart") then seal else nil
end

function WorldService.blackoutArena(self: WorldService): any
    return self._blackoutArena
end

function WorldService.setBlackoutPresentation(self: WorldService, state: any)
    local arena = self._blackoutArena
    local world = self._world
    if arena == nil then
        return
    end
    local status = tostring(state.status)
    local relay = status == "relay"
    local resolution = status == "resolution"
    local complete = status == "complete"
    local deliveredNodes = if type(state.deliveredNodes) == "table"
        then state.deliveredNodes
        else {}

    arena.fireSource.Color = if relay then AMBER else Color3.fromRGB(94, 83, 64)
    arena.fireSource.Material = if relay then Enum.Material.Neon else Enum.Material.SmoothPlastic
    arena.fireSource.Transparency = if relay then 0.1 else 0.58
    keepReplacedAnchorHidden(arena.fireSource)
    local firePrompt = self._interactions[self._runtimeIds.InteractionIds.BlackoutFireSource]
    if firePrompt ~= nil then
        firePrompt.Enabled = relay
    end

    for nodeId, target in arena.relayNodes do
        local delivered = deliveredNodes[nodeId] == true
        target.Color = if delivered
            then FOXFIRE
            elseif relay then Color3.fromRGB(255, 137, 72)
            else Color3.fromRGB(70, 91, 72)
        target.Material = if delivered or relay
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        target.Transparency = if delivered then 0.28 elseif relay then 0.12 else 0.58
        keepReplacedAnchorHidden(target)
        local prompt = target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = relay
            prompt.ActionText = if delivered then "TAKE ROOTFIRE" else "DELIVER ROOTFIRE"
            prompt.ObjectText = if delivered then "Lit Living Root" else "Unlit Living Root"
        end
        local nextMarker = target:FindFirstChild("BlackoutNextMarker")
        if nodeId == state.nextNodeId and relay and not delivered then
            local marker = if nextMarker ~= nil and nextMarker:IsA("BillboardGui")
                then nextMarker
                else Instance.new("BillboardGui")
            marker.Name = "BlackoutNextMarker"
            marker.Adornee = target
            marker.AlwaysOnTop = true
            marker.LightInfluence = 0
            marker.Size = UDim2.fromOffset(190, 40)
            marker.StudsOffsetWorldSpace = Vector3.new(0, 8, 0)
            -- The relay legs are 120, 228, and 161 studs, and the carry timer
            -- is 18 seconds. At the old MaxDistance of 70 the marker only
            -- appeared once a carrier was already most of the way there, so
            -- the one thing that says "this way" could not be seen from where
            -- the fire is taken. 500 covers every leg from anywhere on the
            -- route; AlwaysOnTop and zero light influence keep it readable in
            -- Blackout darkness.
            marker.MaxDistance = 500
            marker.Parent = target
            local markerText = marker:FindFirstChild("MarkerText")
            if markerText == nil or not markerText:IsA("TextLabel") then
                markerText = Instance.new("TextLabel")
                markerText.Name = "MarkerText"
                markerText.BackgroundColor3 = Color3.fromRGB(12, 31, 25)
                markerText.BackgroundTransparency = 0.08
                markerText.BorderSizePixel = 0
                markerText.Font = Enum.Font.GothamBold
                markerText.Size = UDim2.fromScale(1, 1)
                markerText.TextColor3 = Color3.fromRGB(172, 255, 205)
                markerText.TextSize = 16
                markerText.Text = "▼  NEXT ROOT"
                markerText.Parent = marker
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 8)
                corner.Parent = markerText
            end
        elseif nextMarker ~= nil then
            nextMarker:Destroy()
        end
        for _, rootedWall in arena.model:GetChildren() do
            if
                rootedWall:IsA("BasePart")
                and rootedWall.Name == "RootedWall"
                and rootedWall:GetAttribute("BlackoutNodeId") == nodeId
            then
                -- A lit root has been cleansed, so it should read as living
                -- wood taking the light back -- not as a half-faded pane. The
                -- old 0.48 transparency turned a solid rooted pillar into a
                -- flat translucent green slab the moment it succeeded, which
                -- made progress look like something breaking.
                rootedWall.Color = if delivered then Color3.fromRGB(74, 118, 76) else BARK
                rootedWall.Material = if delivered
                    then Enum.Material.LeafyGrass
                    else Enum.Material.Wood
                rootedWall.Transparency = 0
            end
        end
    end

    for decisionId, target in arena.decisions do
        target.Material = if resolution or complete
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        target.Transparency = if resolution then 0.08 elseif complete then 0.3 else 0.68
        local prompt = target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = resolution
        end
        if complete then
            target:SetAttribute("Selected", state.decision == decisionId)
            if state.decision ~= decisionId then
                target.Transparency = 0.78
            end
        end
        keepReplacedAnchorHidden(target)
    end

    if world ~= nil then
        world:SetAttribute(
            "BlackoutActive",
            relay or status == "old_growth" or status == "warden" or resolution
        )
        world:SetAttribute("BlackoutStatus", status)
        world:SetAttribute("BlackoutRevision", tonumber(state.revision) or 0)
    end
end

function WorldService.setBlackoutLighting(self: WorldService, active: boolean)
    self._blackoutLightingActive = active
    local world = self._world
    if world ~= nil then
        world:SetAttribute("BlackoutLighting", active)
    end
    local effect = Lighting:FindFirstChild("LastLightBlackoutColor")
    if not active then
        if effect ~= nil then
            effect:Destroy()
        end
        -- Restore the current town phase; the cycle may have advanced while
        -- the Blackout owned shared Lighting.
        if self._dusk and not self._night then
            self:_applyDuskLighting()
        else
            self:_applyTownLighting(self._night)
        end
        return
    end
    --[[
        A Blackout should read as dangerous, not as a colour filter.

        The old values washed the whole world to one flat teal: a heavy
        saturated tint over raised brightness and flattened contrast, which
        left every surface the same value and made the place genuinely
        unreadable -- you could not tell a wall from a road from a creature.
        Now the tint is nearly neutral with only a cool cast, contrast is up
        so silhouettes separate, and brightness is down so the lantern-fire
        the Blackout is about is the brightest thing in frame.
    ]]
    --[[
        Tablet screenshots from the owner showed what these values actually
        render as on hardware: a black screen with a faint character outline.
        The previous rewrite fixed the flat teal wash but kept a floor that
        Studio-on-a-workstation flattered and a real device crushed to
        nothing. A Blackout must read as a dangerous night the player can
        still play: ground visible underfoot, trunks separating from sky,
        and the carried fire still the brightest thing in frame.
    ]]
    Lighting.Brightness = 1.6
    Lighting.Ambient = Color3.fromRGB(96, 104, 118)
    Lighting.OutdoorAmbient = Color3.fromRGB(88, 98, 114)
    Lighting.ExposureCompensation = 0.25
    local atmosphere = Lighting:FindFirstChild("LastLightAtmosphere")
    if atmosphere ~= nil and atmosphere:IsA("Atmosphere") then
        -- Night haze was eating what little light survived; the Blackout
        -- keeps its cool cast through the tint below instead.
        atmosphere.Density = 0.28
        atmosphere.Haze = 1.1
    end
    local color = if effect ~= nil and effect:IsA("ColorCorrectionEffect")
        then effect
        else Instance.new("ColorCorrectionEffect")
    color.Name = "LastLightBlackoutColor"
    color.Brightness = 0.03
    color.Contrast = 0.12
    color.Saturation = -0.05
    color.TintColor = Color3.fromRGB(210, 222, 230)
    color.Parent = Lighting
end

function WorldService.oldGrowthArena(self: WorldService): any
    return self._oldGrowthArena
end

function WorldService.setOldGrowthPresentation(self: WorldService, status: string)
    local arena = self._oldGrowthArena
    if arena == nil then
        return
    end
    local shielded = status == "shielded"
    local complete = status == "complete"
    arena.fireSource.Color = if shielded then AMBER else Color3.fromRGB(96, 87, 68)
    arena.fireSource.Material = if shielded then Enum.Material.Neon else Enum.Material.SmoothPlastic
    arena.fireSource.Transparency = if shielded then 0.12 else 0.58
    arena.rootHeart.Color = if complete
        then FOXFIRE
        elseif shielded then Color3.fromRGB(255, 117, 74)
        else Color3.fromRGB(83, 102, 82)
    arena.rootHeart.Material = if shielded or complete
        then Enum.Material.Neon
        else Enum.Material.SmoothPlastic
    arena.rootHeart.Transparency = if shielded or complete then 0.14 else 0.58
    keepReplacedAnchorHidden(arena.fireSource)
    keepReplacedAnchorHidden(arena.rootHeart)

    local firePrompt = self._interactions[self._runtimeIds.InteractionIds.OldGrowthFireSource]
    local heartPrompt = self._interactions[self._runtimeIds.InteractionIds.OldGrowthHeart]
    if firePrompt ~= nil then
        firePrompt.Enabled = shielded
    end
    if heartPrompt ~= nil then
        heartPrompt.Enabled = shielded
    end
end

function WorldService.wardenStagArena(self: WorldService): any
    return self._wardenStagArena
end

function WorldService.setWardenStagPresentation(self: WorldService, state: any)
    local arena = self._wardenStagArena
    if arena == nil then
        return
    end
    local status = tostring(state.status)
    local cleansing = status == "cleansing"
    local vulnerable = status == "vulnerable"
    local complete = status == "complete"
    local enabled = status ~= "disabled"
    local cleansedNodes = if type(state.cleansedNodes) == "table" then state.cleansedNodes else {}
    local brokenAntlers = if type(state.brokenAntlers) == "table" then state.brokenAntlers else {}

    arena.seal.Color = if complete
        then FOXFIRE
        elseif vulnerable then AMBER
        elseif cleansing then Color3.fromRGB(132, 186, 126)
        elseif status == "dormant" then Color3.fromRGB(94, 154, 133)
        else Color3.fromRGB(77, 88, 79)
    arena.seal.Material = if complete
            or vulnerable
            or cleansing
        then Enum.Material.Neon
        else Enum.Material.SmoothPlastic
    arena.seal.Transparency = if enabled then 0.24 else 0.72
    keepReplacedAnchorHidden(arena.seal)

    for nodeId, target in arena.nodes do
        local cleansed = cleansedNodes[nodeId] == true
        target.Color = if cleansed
            then FOXFIRE
            elseif cleansing then AMBER
            else Color3.fromRGB(80, 99, 82)
        target.Material = if cleansed or cleansing
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        target.Transparency = if cleansed then 0.46 elseif cleansing then 0.12 else 0.56
        keepReplacedAnchorHidden(target)
        local interactionId = target:GetAttribute("InteractionId")
        local prompt = if type(interactionId) == "string"
            then self._interactions[interactionId]
            else target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = cleansing and not cleansed
        end
    end

    for antlerId, target in arena.antlers do
        local broken = brokenAntlers[antlerId] == true
        target.Color = if broken
            then Color3.fromRGB(91, 78, 67)
            elseif cleansing then Color3.fromRGB(255, 166, 106)
            else Color3.fromRGB(145, 145, 126)
        target.Material = if cleansing and not broken
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        target.Transparency = if broken then 0.78 elseif cleansing then 0.14 else 0.58
        local prompt = target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = cleansing and not broken
        end
    end
end

function WorldService.setExpeditionEventsEnabled(self: WorldService, enabled: boolean)
    self._eventsEnabled = enabled
    local world = self._world
    if world ~= nil then
        world:SetAttribute("ExpeditionEventsEnabled", enabled)
    end
    for _, prompt in self._interactions do
        if prompt:GetAttribute("ActionId") == self._runtimeIds.Actions.ExpeditionEvent then
            prompt.Enabled = enabled
        end
    end
end

function WorldService.setExpeditionEventState(self: WorldService, eventId: string, state: any)
    local socket = self._eventSockets[eventId]
    if socket ~= nil then
        socket:SetAttribute("Dormant", state.status == "dormant")
        socket:SetAttribute("Status", state.status)
        socket:SetAttribute("Progress", state.progress)
        socket:SetAttribute("ProgressTotal", state.total)
        socket:SetAttribute("Revision", state.revision)
    end

    local targets = self._eventTargets[eventId]
    if targets == nil then
        return
    end
    local eventCanProgress = self._eventsEnabled
        and (state.status == "dormant" or state.status == "active")
    for stepId, target in targets do
        local complete = state.completedSteps[stepId] == true
        target:SetAttribute(
            "EventStepState",
            if complete then "complete" else if eventCanProgress then "available" else state.status
        )
        if complete then
            target.Color = FOXFIRE
            target.Material = Enum.Material.Neon
            target.Transparency = 0.12
        elseif state.status == "failed" or state.status == "disabled" then
            target.Color = Color3.fromRGB(83, 91, 83)
            target.Material = Enum.Material.SmoothPlastic
            target.Transparency = 0.5
        end
        keepReplacedAnchorHidden(target)
        local prompt = target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = eventCanProgress and not complete
        end
    end
end

function WorldService.enterBramblewake(self: WorldService, player: Player): boolean
    local entry = self._expeditionEntry
    local character = player.Character
    if entry == nil or character == nil then
        return false
    end
    if player:GetAttribute("LastLightExpeditionTransition") == true then
        return true
    end

    player:SetAttribute("LastLightInExpedition", true)
    player:SetAttribute("LastLightExpeditionTransition", true)
    task.spawn(function()
        local streamFinished = false
        task.spawn(function()
            pcall(function()
                player:RequestStreamAroundAsync(entry.Position)
            end)
            streamFinished = true
        end)

        local deadline = os.clock() + 5
        while not streamFinished and os.clock() < deadline and player.Parent ~= nil do
            task.wait(0.1)
        end

        local activeCharacter = player.Character
        if
            player.Parent ~= nil
            and player:GetAttribute("LastLightInExpedition") == true
            and activeCharacter ~= nil
        then
            activeCharacter:PivotTo(entry)
        end
        player:SetAttribute("LastLightExpeditionTransition", false)
    end)
    return true
end

function WorldService.exitBramblewake(
    self: WorldService,
    player: Player,
    onArrive: (() -> ())?
): boolean
    local character = player.Character
    if character == nil then
        return false
    end
    if player:GetAttribute("LastLightExpeditionTransition") == true then
        return false
    end

    local destination = self:spawnCFrame()
    player:SetAttribute("LastLightInExpedition", false)
    player:SetAttribute("LastLightExpeditionTransition", true)
    task.spawn(function()
        local streamFinished = false
        task.spawn(function()
            pcall(function()
                player:RequestStreamAroundAsync(destination.Position)
            end)
            streamFinished = true
        end)

        local deadline = os.clock() + 5
        while not streamFinished and os.clock() < deadline and player.Parent ~= nil do
            task.wait(0.1)
        end

        local activeCharacter = player.Character
        if player.Parent ~= nil and activeCharacter ~= nil then
            activeCharacter:PivotTo(destination)
        end
        player:SetAttribute("LastLightExpeditionTransition", false)
        if player.Parent ~= nil and onArrive ~= nil then
            task.defer(onArrive)
        end
    end)
    return true
end

function WorldService.expeditionSnapshot(self: WorldService, player: Player): any
    local manifest = self._expeditionManifest
    if manifest == nil or player:GetAttribute("LastLightInExpedition") ~= true then
        return {
            active = false,
        }
    end

    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    local closestIndex = 1
    local closestDistance = math.huge
    if root ~= nil and root:IsA("BasePart") then
        for _, moduleCenter in self._expeditionModuleCenters do
            local distance = (root.Position - moduleCenter.position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closestIndex = moduleCenter.index
            end
        end
    end

    local placement = manifest.modules[closestIndex]
    return {
        active = true,
        eventId = placement.eventId,
        manifestHash = manifest.hash,
        moduleId = placement.moduleId,
        moduleIndex = closestIndex,
        moduleTotal = #manifest.modules,
        poiId = placement.poiId,
        seed = manifest.seed,
        source = manifest.source,
    }
end

function WorldService._setDuskSignals(self: WorldService, visible: boolean)
    for _, signal in self._duskSignals do
        if signal.Parent ~= nil then
            TweenService
                :Create(
                    signal,
                    TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {
                        Transparency = if visible
                            then tonumber(signal:GetAttribute("DuskTransparency")) or 0.1
                            else 1,
                    }
                )
                :Play()
        end
    end
end

local function nightThemeColor(theme: string?): Color3
    return if theme == "MIRETIDE"
        then Color3.fromRGB(90, 192, 170)
        elseif theme == "ROOTMOON" then Color3.fromRGB(174, 128, 205)
        elseif theme == "ASHEN VEIL" then Color3.fromRGB(218, 132, 91)
        else AMBER
end

local function buildNightThemeDressing(parent: Instance, theme: string): Model
    local model = Instance.new("Model")
    model.Name = "NightThemeDressing"
    model:SetAttribute("Theme", theme)
    model.Parent = parent
    local accent = nightThemeColor(theme)

    if theme == "EMBERFALL" then
        for row = 0, 2 do
            for side = -1, 1, 2 do
                local center = Vector3.new(side * 7.5, 0.45, -144 + row * 12)
                local basin = part(
                    model,
                    "EmberCatchBasin",
                    -- Cylinder axis is local X: (height, diameter, diameter).
                    Vector3.new(0.7, 3.4, 3.4),
                    CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
                    Color3.fromRGB(72, 58, 49),
                    Enum.Material.Slate,
                    false
                )
                basin.Shape = Enum.PartType.Cylinder
                local coal = part(
                    model,
                    "CaughtEmbers",
                    -- Cylinder axis is local X: (height, diameter, diameter).
                    Vector3.new(0.35, 2.2, 2.2),
                    CFrame.new(center + Vector3.new(0, 0.48, 0)) * CFrame.Angles(0, 0, math.rad(90)),
                    accent,
                    Enum.Material.Neon,
                    false
                )
                coal.Shape = Enum.PartType.Cylinder
                coal.Transparency = 0.18
            end
        end
    elseif theme == "MIRETIDE" then
        for poolIndex = 0, 4 do
            local side = if poolIndex % 2 == 0 then -1 else 1
            local pool = part(
                model,
                "MiretidePool",
                Vector3.new(8 + poolIndex % 3, 0.16, 6.5),
                CFrame.new(side * 6.5, 0.24, -145 + poolIndex * 7.2)
                    * CFrame.Angles(0, math.rad(side * (8 + poolIndex * 3)), 0),
                accent,
                Enum.Material.Glass,
                false
            )
            pool.Transparency = 0.48
            local reed = part(
                model,
                "MiretideReeds",
                Vector3.new(0.35, 3.2, 0.35),
                pool.CFrame + Vector3.new(side * 2.4, 1.5, 0.8),
                Color3.fromRGB(64, 103, 77),
                Enum.Material.Grass,
                false
            )
            reed.CFrame *= CFrame.Angles(0, 0, math.rad(side * 8))
        end
    elseif theme == "ROOTMOON" then
        for archIndex = 0, 2 do
            local z = -145 + archIndex * 13
            for side = -1, 1, 2 do
                part(
                    model,
                    "RootmoonPillar",
                    Vector3.new(1.05, 8, 1.05),
                    CFrame.new(side * 6.2, 4, z) * CFrame.Angles(0, 0, math.rad(-side * 12)),
                    Color3.fromRGB(72, 54, 45),
                    Enum.Material.Wood,
                    false
                )
            end
            local crown = part(
                model,
                "RootmoonCrown",
                Vector3.new(13, 1, 1),
                CFrame.new(0, 7.7, z),
                accent,
                Enum.Material.Wood,
                false
            )
            crown.Transparency = 0.12
        end
    else
        for driftIndex = 1, 8 do
            local side = if driftIndex % 2 == 0 then -1 else 1
            local drift = part(
                model,
                "AshenDrift",
                Vector3.new(4 + driftIndex % 3, 1.1, 2.5 + driftIndex % 2),
                CFrame.new(side * (7 + driftIndex % 3), 0.55, -149 + driftIndex * 4.2)
                    * CFrame.Angles(0, math.rad(side * driftIndex * 9), 0),
                Color3.fromRGB(89, 82, 78),
                Enum.Material.Sand,
                false
            )
            drift.Shape = Enum.PartType.Ball
            drift.Transparency = 0.18
            if driftIndex % 2 == 0 then
                part(
                    model,
                    "CharredWaypost",
                    Vector3.new(0.65, 5.5, 0.65),
                    CFrame.new(side * 9, 2.7, -149 + driftIndex * 4.2)
                        * CFrame.Angles(0, 0, math.rad(side * 10)),
                    Color3.fromRGB(38, 35, 34),
                    Enum.Material.Wood,
                    false
                )
            end
        end
    end

    local marker = part(
        model,
        "NightThemeMarker",
        Vector3.new(12, 2.5, 0.45),
        CFrame.new(0, 5.2, -151),
        Color3.fromRGB(48, 39, 35),
        Enum.Material.WoodPlanks,
        false
    )
    addBillboard(marker, theme, accent)
    return model
end

function WorldService._setNightDefenseState(self: WorldService, state: string, theme: string?)
    local accent = if state == "breach" then Color3.fromRGB(255, 91, 58) else nightThemeColor(theme)
    for _, signal in self._nightDefenseSignals do
        if signal.Parent ~= nil then
            local role = signal:GetAttribute("SignalRole")
            local transparency = if state == "day"
                then 1
                elseif state == "dusk" then (if role == "fire" then 0.28 else 0.74)
                elseif state == "breach" then (if role == "fire" then 0.02 else 0.2)
                else (if role == "fire" then 0.1 else 0.46)
            signal.Color = accent
            TweenService:Create(
                signal,
                TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Transparency = transparency }
            ):Play()
            local signalLight = signal:FindFirstChild("WatchSignalLight")
            if signalLight ~= nil and signalLight:IsA("PointLight") then
                signalLight.Color = accent
                signalLight.Brightness = if state == "day"
                    then 0
                    elseif state == "dusk" then 0.8
                    elseif state == "breach" then 2.8
                    else 1.7
            end
        end
    end
    local world = self._world
    if world ~= nil then
        world:SetAttribute("NightDefenseState", state)
        world:SetAttribute("NightDefenseTheme", theme or "")
    end
end

function WorldService.signalNightWave(
    self: WorldService,
    enemyId: string?,
    wave: number?,
    theme: string?
)
    local world = self._world
    if world == nil or not self._night then
        return
    end
    local accent = nightThemeColor(theme)
    local start = Vector3.new(0, 0.34, -149)
    local finish = Vector3.new(0, 0.34, -116)
    local lane = part(
        world,
        "NightWaveApproach",
        Vector3.new(10, 0.16, (finish - start).Magnitude),
        CFrame.lookAt((start + finish) / 2, finish),
        accent,
        Enum.Material.Neon,
        false
    )
    lane.Transparency = 0.72
    lane.CastShadow = false
    lane:SetAttribute("EnemyId", enemyId or "unknown")
    lane:SetAttribute("Wave", wave or 0)
    local enemyLabel = string.upper(string.gsub(enemyId or "forest threat", "enemy_", ""))
    enemyLabel = string.gsub(enemyLabel, "_", " ")
    addBillboard(lane, string.format("WAVE %d · %s INBOUND", wave or 0, enemyLabel), accent)
    TweenService:Create(
        lane,
        TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Transparency = 1, Size = Vector3.new(13, 0.16, lane.Size.Z) }
    ):Play()
    task.delay(1.3, function()
        if lane.Parent ~= nil then
            lane:Destroy()
        end
    end)
end

function WorldService.setTownBreach(self: WorldService, enabled: boolean, theme: string?)
    self._breachActive = enabled
    local world = self._world
    if world == nil then
        return
    end
    world:SetAttribute("TownBreachActive", enabled)
    self:_setNightDefenseState(
        if enabled then "breach" else (if self._night then "night" else "day"),
        theme
    )
    if not enabled then
        return
    end
    local accent = Color3.fromRGB(255, 91, 58)
    for _, center in { Vector3.new(0, 0.4, -148), Vector3.new(0, 0.4, TOWN_CENTER.Z) } do
        local pulse = part(
            world,
            "TownBreachPulse",
            Vector3.new(0.14, 4, 4),
            CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
            accent,
            Enum.Material.Glass,
            false
        )
        pulse.Shape = Enum.PartType.Cylinder
        pulse.Transparency = 0.28
        pulse.CastShadow = false
        TweenService:Create(
            pulse,
            TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = Vector3.new(0.14, 25, 25), Transparency = 1 }
        ):Play()
        task.delay(1, function()
            if pulse.Parent ~= nil then
                pulse:Destroy()
            end
        end)
    end
end

function WorldService.clearTownIncident(self: WorldService)
    for interactionId, prompt in self._interactions do
        if prompt:GetAttribute("ActionId") == self._runtimeIds.Actions.ResolveTownIncident then
            if prompt.Parent ~= nil then
                prompt:Destroy()
            end
            self._interactions[interactionId] = nil
        end
    end
    if self._townIncidentModel ~= nil and self._townIncidentModel.Parent ~= nil then
        self._townIncidentModel:Destroy()
    end
    self._townIncidentModel = nil
    local world = self._world
    if world ~= nil then
        world:SetAttribute("TownIncidentId", nil)
        world:SetAttribute("TownIncidentEndsAt", nil)
        world:SetAttribute("TownIncidentResolved", nil)
        world:SetAttribute("TownIncidentRequired", nil)
    end
end

local INCIDENT_SITES = table.freeze({
    archive = Vector3.new(-31, 0.65, -108),
    workshop = Vector3.new(31, 0.65, -108),
    inn = Vector3.new(-28, 0.65, -137),
})

local function buildIncidentSite(parent: Model, incidentId: string, siteId: string): BasePart
    local at = assert(INCIDENT_SITES[siteId], "town incident site is unknown")
    local site = Instance.new("Model")
    site.Name = "IncidentSite_" .. siteId
    site:SetAttribute("SiteId", siteId)
    site:SetAttribute("Resolved", false)
    site.Parent = parent

    local target: Part
    if incidentId == "incident_emberfall_cinders" then
        target = part(
            site,
            "IncidentCore",
            Vector3.new(3.8, 0.75, 3.2),
            CFrame.new(at),
            Color3.fromRGB(55, 47, 42),
            Enum.Material.Slate,
            false
        )
        target.Shape = Enum.PartType.Ball
        for index = -1, 1 do
            part(
                site,
                "CharredTimber",
                Vector3.new(0.42, 3.3, 0.42),
                CFrame.new(at + Vector3.new(index * 0.8, 0.55, 0))
                    * CFrame.Angles(math.rad(90), 0, math.rad(index * 24)),
                Color3.fromRGB(40, 32, 29),
                Enum.Material.Wood,
                false
            )
        end
        local ember = part(
            site,
            "BuriedEmber",
            Vector3.new(1.2, 0.18, 1.2),
            CFrame.new(at + Vector3.new(0, 0.46, 0)),
            Color3.fromRGB(190, 78, 38),
            Enum.Material.SmoothPlastic,
            false
        )
        ember.Shape = Enum.PartType.Ball
    elseif incidentId == "incident_emberfall_flues" then
        target = part(
            site,
            "IncidentCore",
            Vector3.new(2.8, 3.2, 2.8),
            CFrame.new(at + Vector3.new(0, 1.25, 0)),
            Color3.fromRGB(74, 65, 58),
            Enum.Material.Brick,
            false
        )
        for tier = 1, 3 do
            part(
                site,
                "FlueBrick",
                Vector3.new(3.4 - tier * 0.35, 0.42, 3.4 - tier * 0.35),
                CFrame.new(at + Vector3.new(0, 2.75 + tier * 0.35, 0)),
                Color3.fromRGB(86 - tier * 8, 69 - tier * 6, 59 - tier * 5),
                Enum.Material.Brick,
                false
            )
        end
        local cap = part(
            site,
            "LooseFlueCap",
            Vector3.new(3.1, 0.28, 3.1),
            CFrame.new(at + Vector3.new(0.55, 4.15, 0))
                * CFrame.Angles(math.rad(8), 0, math.rad(-12)),
            Color3.fromRGB(58, 56, 53),
            Enum.Material.Metal,
            false
        )
        cap:SetAttribute("NeedsSecuring", true)
    elseif incidentId == "incident_miretide_clogs" then
        target = part(
            site,
            "IncidentCore",
            Vector3.new(0.28, 4.2, 4.2),
            CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90)),
            Color3.fromRGB(58, 67, 48),
            Enum.Material.Ground,
            false
        )
        target.Shape = Enum.PartType.Cylinder
        for index = 1, 5 do
            local angle = math.rad(index * 72)
            part(
                site,
                "DrainStone",
                Vector3.new(0.85, 0.7, 1.2),
                CFrame.new(at + Vector3.new(math.cos(angle) * 2, 0.12, math.sin(angle) * 2))
                    * CFrame.Angles(0, -angle, 0),
                Color3.fromRGB(88, 91, 79),
                Enum.Material.Rock,
                false
            )
        end
        for index = -1, 1 do
            part(
                site,
                "RootClog",
                Vector3.new(0.5, 3.5, 0.5),
                CFrame.new(at + Vector3.new(index * 0.65, 0.55, 0))
                    * CFrame.Angles(0, 0, math.rad(78 + index * 16)),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
        end
    elseif incidentId == "incident_miretide_seeps" then
        target = part(
            site,
            "IncidentCore",
            Vector3.new(5.2, 0.32, 4.4),
            CFrame.new(at - Vector3.new(0, 0.35, 0)),
            Color3.fromRGB(52, 69, 60),
            Enum.Material.Ground,
            false
        )
        target.Shape = Enum.PartType.Ball
        for index = 1, 6 do
            local angle = math.rad(index * 60)
            part(
                site,
                "SeepStone",
                Vector3.new(1.25, 0.65, 0.9),
                CFrame.new(at + Vector3.new(math.cos(angle) * 2.3, 0, math.sin(angle) * 1.9))
                    * CFrame.Angles(0, angle, math.rad(index % 2 == 0 and 6 or -6)),
                Color3.fromRGB(83, 91, 81),
                Enum.Material.Rock,
                false
            )
        end
        for index = -1, 1, 2 do
            part(
                site,
                "SealStake",
                Vector3.new(0.45, 2.8, 0.45),
                CFrame.new(at + Vector3.new(index * 1.3, 0.65, 0.3))
                    * CFrame.Angles(0, 0, math.rad(index * 12)),
                BARK,
                Enum.Material.Wood,
                false
            )
        end
    elseif incidentId == "incident_rootmoon_anchors" then
        target = part(
            site,
            "IncidentCore",
            Vector3.new(2.7, 1.1, 2.7),
            CFrame.new(at),
            WET_EARTH,
            Enum.Material.Ground,
            false
        )
        target.Shape = Enum.PartType.Ball
        for index = -1, 1 do
            part(
                site,
                "RootAnchor",
                Vector3.new(0.72, 5.2, 0.72),
                CFrame.new(at + Vector3.new(index * 0.85, 2.2, index % 2 * 0.4))
                    * CFrame.Angles(math.rad(index * 8), 0, math.rad(index * 13)),
                BARK,
                Enum.Material.Wood,
                false
            )
        end
    elseif incidentId == "incident_rootmoon_snares" then
        target = part(
            site,
            "IncidentCore",
            Vector3.new(3.4, 3.4, 3.4),
            CFrame.new(at + Vector3.new(0, 1.4, 0)),
            Color3.fromRGB(74, 83, 58),
            Enum.Material.Ground,
            false
        )
        target.Shape = Enum.PartType.Ball
        for index = 1, 5 do
            local angle = math.rad(index * 72)
            local thorn = part(
                site,
                "SnareThorn",
                Vector3.new(0.5, 2.6, 0.5),
                CFrame.new(at + Vector3.new(math.cos(angle) * 1.45, 1.5, math.sin(angle) * 1.45))
                    * CFrame.Angles(math.rad(55), -angle, math.rad(18)),
                WET_BARK,
                Enum.Material.Wood,
                false
            )
            thorn.Shape = Enum.PartType.Cylinder
        end
        for loop = -1, 1, 2 do
            part(
                site,
                "SnareVine",
                Vector3.new(0.38, 5.4, 0.38),
                CFrame.new(at + Vector3.new(loop * 1.3, 0.4, 0))
                    * CFrame.Angles(math.rad(90), 0, math.rad(loop * 24)),
                BARK,
                Enum.Material.Wood,
                false
            )
        end
    elseif incidentId == "incident_ashen_watchfires" then
        target = part(
            site,
            "IncidentCore",
            Vector3.new(3.6, 0.5, 3.6),
            CFrame.new(at),
            Color3.fromRGB(45, 43, 42),
            Enum.Material.Metal,
            false
        )
        for index = -1, 1 do
            part(
                site,
                "ColdFuel",
                Vector3.new(0.42, 2.8, 0.42),
                CFrame.new(at + Vector3.new(index * 0.62, 0.75, 0))
                    * CFrame.Angles(math.rad(90), 0, math.rad(index * 34)),
                Color3.fromRGB(55, 43, 34),
                Enum.Material.Wood,
                false
            )
        end
        for index = -1, 1, 2 do
            part(
                site,
                "BrazierLeg",
                Vector3.new(0.28, 2.4, 0.28),
                CFrame.new(at + Vector3.new(index * 1.15, -0.25, 0)),
                Color3.fromRGB(58, 57, 55),
                Enum.Material.Metal,
                false
            )
        end
    else
        target = part(
            site,
            "IncidentCore",
            Vector3.new(0.7, 4.8, 0.7),
            CFrame.new(at + Vector3.new(0, 1.65, 0)),
            Color3.fromRGB(66, 52, 39),
            Enum.Material.Wood,
            false
        )
        for side = -1, 1, 2 do
            part(
                site,
                "BellFramePost",
                Vector3.new(0.55, 5.2, 0.55),
                CFrame.new(at + Vector3.new(side * 1.8, 1.7, 0)),
                BARK,
                Enum.Material.Wood,
                false
            )
        end
        part(
            site,
            "BellFrameBeam",
            Vector3.new(4.4, 0.55, 0.55),
            CFrame.new(at + Vector3.new(0, 4.2, 0)),
            BARK,
            Enum.Material.Wood,
            false
        )
        local bell = part(
            site,
            "SilentWardBell",
            Vector3.new(2.2, 2.1, 2.2),
            CFrame.new(at + Vector3.new(0, 2.75, 0)),
            Color3.fromRGB(115, 103, 79),
            Enum.Material.Metal,
            false
        )
        bell.Shape = Enum.PartType.Ball
        part(
            site,
            "BellClapper",
            Vector3.new(0.38, 1.6, 0.38),
            CFrame.new(at + Vector3.new(0, 1.45, 0)),
            Color3.fromRGB(72, 66, 58),
            Enum.Material.Metal,
            false
        )
    end
    target:SetAttribute("IncidentId", incidentId)
    target:SetAttribute("SiteId", siteId)
    return target
end

function WorldService.startTownIncident(self: WorldService, definition: any, endsAt: number)
    self:clearTownIncident()
    local world = self._world
    if world == nil or not self._night then
        return
    end
    local model = Instance.new("Model")
    model.Name = "TownNightIncident"
    model:SetAttribute("IncidentId", definition.id)
    model:SetAttribute("Title", definition.title)
    model:SetAttribute("Required", #definition.sites)
    model.Parent = world
    self._townIncidentModel = model
    for _, siteId in definition.sites do
        local target = buildIncidentSite(model, definition.id, siteId)
        local interactionId = string.format("town_incident:%s:%s", definition.id, siteId)
        self:_registerInteraction(
            target,
            interactionId,
            self._runtimeIds.Actions.ResolveTownIncident,
            definition.actionText,
            definition.objectText,
            siteId,
            0.85
        )
        addBillboard(target, string.format("%s · %s", definition.title, siteId), CREAM)
    end
    world:SetAttribute("TownIncidentId", definition.id)
    world:SetAttribute("TownIncidentEndsAt", endsAt)
    world:SetAttribute("TownIncidentResolved", 0)
    world:SetAttribute("TownIncidentRequired", #definition.sites)
end

function WorldService.resolveTownIncidentSite(self: WorldService, siteId: string, resolved: number)
    local model = self._townIncidentModel
    local world = self._world
    if model == nil or world == nil then
        return
    end
    for _, child in model:GetChildren() do
        if child:IsA("Model") and child:GetAttribute("SiteId") == siteId then
            child:SetAttribute("Resolved", true)
            local target = child:FindFirstChild("IncidentCore")
            if target ~= nil and target:IsA("BasePart") then
                local interactionId = nil
                local prompt = target:FindFirstChildOfClass("ProximityPrompt")
                if prompt ~= nil then
                    interactionId = prompt:GetAttribute("InteractionId")
                    prompt:Destroy()
                end
                if type(interactionId) == "string" then
                    self._interactions[interactionId] = nil
                end
                local oldLabel = target:FindFirstChild("WorldLabel")
                if oldLabel ~= nil then
                    oldLabel:Destroy()
                end
                target.Color = Color3.fromRGB(72, 96, 66)
                addBillboard(target, "SECURED", FOXFIRE)
            end
            break
        end
    end
    world:SetAttribute("TownIncidentResolved", resolved)
end

function WorldService._applyDuskLighting(_self: WorldService)
    Lighting.ClockTime = 18.15
    Lighting.Brightness = 1.42
    Lighting.Ambient = Color3.fromRGB(49, 46, 52)
    Lighting.OutdoorAmbient = Color3.fromRGB(72, 61, 65)
    Lighting.ExposureCompensation = -0.36
    local atmosphere = Lighting:FindFirstChild("LastLightAtmosphere")
    if atmosphere ~= nil and atmosphere:IsA("Atmosphere") then
        atmosphere.Color = Color3.fromRGB(164, 143, 133)
        atmosphere.Decay = Color3.fromRGB(42, 42, 54)
        atmosphere.Density = 0.4
        atmosphere.Haze = 2.15
        atmosphere.Glare = 0.13
    end
    local tone = Lighting:FindFirstChild("LastLightTone")
    if tone ~= nil and tone:IsA("ColorCorrectionEffect") then
        tone.Brightness = -0.05
        tone.Contrast = 0.28
        tone.Saturation = -0.08
        tone.TintColor = Color3.fromRGB(237, 205, 188)
    end
    local bloom = Lighting:FindFirstChild("LastLightBloom")
    if bloom ~= nil and bloom:IsA("BloomEffect") then
        bloom.Intensity = 0.4
        bloom.Threshold = 0.78
    end
end

--[[
    Force the world's lighting phase for a tester.

    Goes through the same setDusk/setNight the phase clock uses, so an admin
    can only put the world into a state it reaches on its own. It does not
    touch the schedule: the next real phase change overwrites this, which is
    the intended behaviour -- this is for looking at something, not for
    running the game from chat.
]]
function WorldService.adminSetPhase(self: WorldService, phase: string): boolean
    if phase == "day" then
        self:setNight(false)
        self:setDusk(false)
        return true
    elseif phase == "dusk" then
        self:setNight(false)
        self:setDusk(true)
        return true
    elseif phase == "night" then
        self:setDusk(false)
        self:setNight(true)
        return true
    end
    return false
end

function WorldService.setDusk(self: WorldService, enabled: boolean)
    self._dusk = enabled
    self:_setDuskSignals(enabled)
    self:_setNightDefenseState(if enabled then "dusk" else "day", nil)
    self:_setTownResidentRoutine(if enabled then "dusk" else "day")
    if self._blackoutLightingActive or self._night then
        return
    end
    if enabled then
        self:_applyDuskLighting()
    else
        self:_applyTownLighting(false)
    end
end

-- Raw property application shared by the cycle and Blackout restore path, so
-- day and night always return to the same authored values.
function WorldService._applyTownLighting(_self: WorldService, night: boolean)
    local atmosphere = Lighting:FindFirstChild("LastLightAtmosphere")
    local tone = Lighting:FindFirstChild("LastLightTone")
    local bloom = Lighting:FindFirstChild("LastLightBloom")
    local depth = Lighting:FindFirstChild("LastLightDepth")

    if night then
        Lighting.ClockTime = 0.15
        Lighting.Brightness = 1.0
        Lighting.Ambient = NIGHT_AMBIENT
        Lighting.OutdoorAmbient = Color3.fromRGB(46, 56, 74)
        Lighting.ExposureCompensation = -0.18
        if atmosphere ~= nil and atmosphere:IsA("Atmosphere") then
            atmosphere.Color = Color3.fromRGB(82, 106, 126)
            atmosphere.Decay = Color3.fromRGB(12, 18, 36)
            atmosphere.Density = 0.32
            atmosphere.Haze = 1.3
            atmosphere.Glare = 0.08
        end
        if tone ~= nil and tone:IsA("ColorCorrectionEffect") then
            tone.Brightness = -0.08
            tone.Contrast = 0.32
            tone.Saturation = -0.16
            tone.TintColor = Color3.fromRGB(183, 205, 231)
        end
        if bloom ~= nil and bloom:IsA("BloomEffect") then
            bloom.Intensity = 0.48
            bloom.Threshold = 0.72
        end
        if depth ~= nil and depth:IsA("DepthOfFieldEffect") then
            depth.FarIntensity = 0.34
            depth.FocusDistance = 72
        end
    else
        -- Must stay identical to _configureLighting's day ClockTime -- see
        -- the comment there.
        Lighting.ClockTime = 10.2
        Lighting.Brightness = 2.05
        Lighting.Ambient = DAY_AMBIENT
        -- Must stay identical to _configureLighting's day values -- see the
        -- comment on DAY_AMBIENT there and the atmosphere note just below.
        Lighting.OutdoorAmbient = Color3.fromRGB(108, 122, 114)
        Lighting.ExposureCompensation = -0.08
        if atmosphere ~= nil and atmosphere:IsA("Atmosphere") then
            -- Must stay identical to the daytime values _configureLighting
            -- sets on world build. This function re-runs on every day/dusk
            -- transition (PhaseService:setNight(false),
            -- TownNightService:setDusk(false), and the Blackout restore
            -- path), so the two are effectively the same setting duplicated
            -- in two places -- if only one is updated, the fix holds until
            -- the first phase transition and then silently reverts. That is
            -- exactly what shipped here initially: the pale-sage atmosphere
            -- that washed distant terrain out to white was fixed in
            -- _configureLighting but left unchanged here.
            atmosphere.Color = Color3.fromRGB(74, 89, 98)
            atmosphere.Decay = Color3.fromRGB(38, 52, 58)
            atmosphere.Density = 0.24
            atmosphere.Haze = 1.0
            atmosphere.Glare = 0.15
        end
        if tone ~= nil and tone:IsA("ColorCorrectionEffect") then
            tone.Brightness = -0.03
            tone.Contrast = 0.18
            tone.Saturation = -0.04
            tone.TintColor = Color3.fromRGB(232, 238, 224)
        end
        if bloom ~= nil and bloom:IsA("BloomEffect") then
            bloom.Intensity = 0.34
            bloom.Threshold = 0.82
        end
        if depth ~= nil and depth:IsA("DepthOfFieldEffect") then
            depth.FarIntensity = 0.28
            depth.FocusDistance = 95
        end
    end
end

function WorldService.setNight(self: WorldService, enabled: boolean, theme: string?)
    self._night = enabled
    self._breachActive = false
    if self._nightThemeDressing ~= nil then
        self._nightThemeDressing:Destroy()
        self._nightThemeDressing = nil
    end
    if enabled and self._world ~= nil then
        self._nightThemeDressing = buildNightThemeDressing(self._world, theme or "EMBERFALL")
    end
    self:_setNightDefenseState(if enabled then "night" else "day", theme)
    self:_setTownResidentRoutine(if enabled then "night" elseif self._dusk then "dusk" else "day")
    if enabled then
        self._dusk = false
        self:_setDuskSignals(false)
    end
    -- The recurring town cycle and the Blackout are timed independently and
    -- can now be active at once (an earlier decision deliberately keeps
    -- Bramblewake entry unblocked regardless of the town's night count).
    -- Let the Blackout's own dramatic presentation own shared Lighting while
    -- it's active instead of the two fighting over the same properties every
    -- time either one ticks; setBlackoutLighting(false) restores whichever
    -- of these this flag says is current once it ends.
    if self._blackoutLightingActive then
        return
    end
    self:_applyTownLighting(enabled)
end

function WorldService.spawnCFrame(self: WorldService): CFrame
    local spawn = assert(self._spawn, "arrival spawn has not initialized")
    return spawn.CFrame + Vector3.new(0, 5, 0)
end

function WorldService.lanternPosition(self: WorldService): Vector3
    return assert(self._lantern, "First Lantern has not initialized").Position
end

--[[
    Where a night-defense enemy is born.

    The Y used to be a bare literal, 2. That was never GROUND_Y (0) -- it was
    tuned by hand to sit on the terrain surface as Roblox rendered it *before*
    the datum fix in TerrainBuilder, when a voxel fill's top face rendered two
    studs above where it was authored. Once that was corrected so the surface
    renders where it is authored, this literal stopped meaning anything: every
    enemy in every night defense has been spawning, walking, and fighting
    2+ studs above the ground for its entire encounter, because EnemyService
    holds an enemy's Y fixed at its spawn value for its whole lifetime (see
    `_step`'s `flatTarget` computation, which only moves X/Z).

    Reading the real surface here, the same way foliage placement already
    does, means this can never drift out of sync with the terrain again --
    including if the datum ever moves a second time.
]]
--[[
    What a memory-fragment prompt refers to, and how it goes quiet.

    Recovering is per player but the shard is one shared world object, so it
    stays standing and lit for everyone else who has not read it. Only the
    prompt's own text changes for a player who already has it, which the
    tutorial service reports.
]]
--[[
    The visible half of a strike.

    Tapping a monster used to change a number and nothing else -- no swing, no
    shot, nothing on the character. The owner asked for the character to look
    like he is hitting it with whatever he holds. Real rig animations are a
    later asset pass; what sells the hit today is a fast arc of the tool's
    colour swept toward the target for a melee blow, and a visible arrow that
    flies the actual path for a bow shot. Both are short-lived anchored parts
    the server spawns and Debris clears; they carry no collision, no queries,
    and no authority -- the damage they illustrate was already applied.
]]
function WorldService.showStrikeFeedback(
    _self: WorldService,
    player: Player,
    context: any,
    targetPosition: Vector3
)
    local character = player.Character
    local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
    if root == nil or not root:IsA("BasePart") then
        return
    end
    local origin = root.Position + Vector3.new(0, 0.6, 0)
    local toTarget = targetPosition - origin
    if toTarget.Magnitude < 0.5 then
        return
    end
    local direction = toTarget.Unit
    if context ~= nil and context.ranged == true then
        -- An arrow that flies the real path. Tween-free: two frames placed by
        -- Heartbeat would jitter under load, so it is one anchored shaft
        -- lerped by a spawned loop across a tenth of a second per 12 studs.
        local arrow = Instance.new("Part")
        arrow.Name = "StrikeArrow"
        arrow.Size = Vector3.new(0.12, 0.12, 2.6)
        arrow.Color = Color3.fromRGB(214, 178, 118)
        arrow.Material = Enum.Material.Wood
        arrow.Anchored = true
        arrow.CanCollide = false
        arrow.CanTouch = false
        arrow.CanQuery = false
        arrow.CastShadow = false
        local tip = Instance.new("Part")
        tip.Name = "StrikeArrowTip"
        tip.Size = Vector3.new(0.2, 0.2, 0.34)
        tip.Color = Color3.fromRGB(120, 129, 134)
        tip.Material = Enum.Material.Metal
        tip.Anchored = true
        tip.CanCollide = false
        tip.CanTouch = false
        tip.CanQuery = false
        tip.CastShadow = false
        arrow.Parent = workspace
        tip.Parent = workspace
        local flightSeconds = math.clamp(toTarget.Magnitude / 120, 0.08, 0.35)
        task.spawn(function()
            local started = os.clock()
            while true do
                local alpha = math.clamp((os.clock() - started) / flightSeconds, 0, 1)
                local position = origin:Lerp(targetPosition, alpha)
                local frame = CFrame.lookAt(position, position + direction)
                arrow.CFrame = frame
                tip.CFrame = frame * CFrame.new(0, 0, -1.45)
                if alpha >= 1 then
                    break
                end
                task.wait()
            end
            arrow:Destroy()
            tip:Destroy()
        end)
    else
        -- A melee swing: a thin arc of the held tool's colour, swept from the
        -- character toward the target and gone in a sixth of a second.
        local swing = Instance.new("Part")
        swing.Name = "StrikeSwingArc"
        swing.Size = Vector3.new(3.4, 0.18, 1.4)
        swing.Color = Color3.fromRGB(255, 220, 156)
        swing.Material = Enum.Material.Neon
        swing.Transparency = 0.25
        swing.Anchored = true
        swing.CanCollide = false
        swing.CanTouch = false
        swing.CanQuery = false
        swing.CastShadow = false
        swing.CFrame = CFrame.lookAt(origin + direction * 2.4, targetPosition)
            * CFrame.Angles(0, 0, math.rad(24))
        swing.Parent = workspace
        task.spawn(function()
            for step = 1, 4 do
                swing.CFrame = swing.CFrame * CFrame.Angles(0, 0, math.rad(-16))
                swing.Transparency = 0.25 + step * 0.17
                task.wait(0.035)
            end
            swing:Destroy()
        end)
    end
end

function WorldService.memoryFragmentTarget(self: WorldService, interactionId: string): any
    return self._memoryFragmentTargets[interactionId]
end

function WorldService.enemySpawnPosition(_self: WorldService): Vector3
    return Vector3.new(0, TerrainBuilder.surfaceHeight(0, -153), -153)
end

return table.freeze(WorldService)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="126">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">BramblewakeBuilder</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local WorldSignBuilder = require(script.Parent.WorldSignBuilder)

local BramblewakeBuilder = {}

local GRASS = Color3.fromRGB(40, 74, 48)
local DEEP_GRASS = Color3.fromRGB(18, 45, 34)
local PATH = Color3.fromRGB(79, 64, 44)
local BARK = Color3.fromRGB(58, 38, 29)
local DARK_BARK = Color3.fromRGB(32, 25, 23)
local STONE = Color3.fromRGB(58, 67, 63)
local AMBER = Color3.fromRGB(255, 178, 71)
local FOXFIRE = Color3.fromRGB(94, 206, 176)
local MEADOW = Color3.fromRGB(151, 123, 59)
local CREAM = Color3.fromRGB(244, 230, 197)
local MOSS = Color3.fromRGB(52, 83, 49)
local WET_EARTH = Color3.fromRGB(61, 50, 36)

local ORIGIN = Vector3.new(1600, 0, -230)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function orb(
    parent: Instance,
    name: string,
    position: Vector3,
    size: number,
    color: Color3,
    material: Enum.Material
): Part
    local instance = part(
        parent,
        name,
        Vector3.new(size, size, size),
        CFrame.new(position),
        color,
        material,
        false
    )
    instance.Shape = Enum.PartType.Ball
    return instance
end

--[[
    Shadows are off unless a light is asked to cast them.

    Under Future lighting every shadow-casting light is paid for each frame,
    and this route runs about seventy small ones: a glow on all twenty-five
    event steps, two on every harvest node, and a foxfire post the length of
    the road. Those exist to make the path readable in the dark, and none of
    them is anywhere a player looks for a shadow.

    The handful that are -- the Wayhome beacon, the blackout flame, the
    lantern at each point of interest -- ask for it. That is the same
    discipline the town already uses, where the hearth casts and the windows
    do not.
]]
local function light(
    target: BasePart,
    color: Color3,
    brightness: number,
    range: number,
    shadows: boolean?
)
    local pointLight = Instance.new("PointLight")
    pointLight.Color = color
    pointLight.Brightness = brightness
    pointLight.Range = range
    pointLight.Shadows = shadows == true
    pointLight.Parent = target
end

local function surfaceGrain(target: BasePart, color: Color3, transparency: number)
    local decal = Instance.new("Decal")
    decal.Name = "MaterialVariation"
    decal.Color3 = color
    decal.Transparency = transparency
    decal.Face = Enum.NormalId.Top
    decal.Parent = target
end

local function groundPatch(
    parent: Instance,
    center: Vector3,
    size: Vector3,
    color: Color3,
    material: Enum.Material
)
    local patch = part(
        parent,
        "BramblewakeGroundPatch",
        size,
        CFrame.new(center + Vector3.new(0, 0.18, 0)) * CFrame.Angles(0, center.X * 0.011, 0),
        color,
        material,
        false
    )
    patch.Transparency = 0.07
    patch.CanQuery = false
    return patch
end

local function queueItemAsset(
    placements: { any },
    target: BasePart,
    assetId: string,
    scale: number,
    seed: number,
    yaw: number?,
    bottomY: number?
)
    table.insert(placements, {
        assetId = assetId,
        fallbackKind = "asset_replacement",
        position = Vector3.new(
            target.Position.X,
            bottomY or (target.Position.Y - target.Size.Y * 0.5),
            target.Position.Z
        ),
        scale = scale,
        yaw = yaw or 0,
        seed = seed,
        swayTag = nil,
        parent = target.Parent,
        fallbackInstance = target,
    })
end

local function fernCluster(
    parent: Instance,
    center: Vector3,
    scale: number,
    ambientSwayTag: string?
)
    for blade = 1, 6 do
        local angle = (blade / 6) * math.pi * 2
        local frond = part(
            parent,
            "BrambleFern",
            Vector3.new(0.32 * scale, 0.18 * scale, 2.9 * scale),
            CFrame.new(
                center
                    + Vector3.new(
                        math.cos(angle) * 0.65 * scale,
                        0.55 * scale,
                        math.sin(angle) * 0.65 * scale
                    )
            ) * CFrame.Angles(math.rad(23), angle, math.rad(math.sin(angle) * 8)),
            if blade % 2 == 0 then MOSS else Color3.fromRGB(35, 69, 43),
            Enum.Material.Grass,
            false
        )
        frond.CanQuery = false
        if ambientSwayTag ~= nil and (blade == 2 or blade == 5) then
            CollectionService:AddTag(frond, ambientSwayTag)
        end
    end
end

local function rootTangle(parent: Instance, center: Vector3, scale: number, seed: number)
    local random = Random.new(seed)
    for root = 1, 4 do
        local angle = random:NextNumber(0, math.pi * 2)
        local length = random:NextNumber(7, 13) * scale
        local tangle = part(
            parent,
            "ExposedWetRoot",
            Vector3.new(0.7 * scale, length, 0.7 * scale),
            CFrame.new(
                center
                    + Vector3.new(
                        math.cos(angle) * 2.2 * scale,
                        0.65 * scale,
                        math.sin(angle) * 2.2 * scale
                    )
            )
                * CFrame.Angles(math.rad(84), angle, math.rad(random:NextNumber(-10, 10))),
            if root % 2 == 0 then DARK_BARK else BARK,
            Enum.Material.Wood,
            false
        )
        tangle.Shape = Enum.PartType.Cylinder
        tangle.CanQuery = false
    end
end

--[[
    There used to be a lowMist() here: a Glass slab dropped over each module
    cell and over the Blackout arena floor, 1.2 studs up, to suggest ground fog.

    Thirteen of them, covering about 1.8 million square studs -- effectively
    all of Bramblewake -- and Glass is not a fog material. It renders a
    refractive pane whatever Transparency says, so the expedition was being
    viewed through a sheet of tinted glass at knee height: the forest floor,
    the trail, the water and every prop came out flat blue-grey, and from any
    raised angle the slab edges read as the boundary of a void.

    This is the same mistake LowMorningMist made over Emberhollow, removed for
    the same reason. Bramblewake already has its own Atmosphere and Blackout
    lighting doing volumetric work properly; this was a second, cruder system
    fighting it and winning.
]]

local function fireflyCluster(
    parent: Instance,
    center: Vector3,
    color: Color3,
    count: number,
    spread: number,
    seed: number,
    ambientMoteTag: string?
)
    local random = Random.new(seed)
    for _ = 1, count do
        local mote = orb(
            parent,
            "BrambleMote",
            center
                + Vector3.new(
                    random:NextNumber(-spread, spread),
                    random:NextNumber(1.8, 8),
                    random:NextNumber(-spread, spread)
                ),
            random:NextNumber(0.14, 0.32),
            color,
            Enum.Material.Neon
        )
        mote.Transparency = random:NextNumber(0.05, 0.3)
        mote.CanQuery = false
        if ambientMoteTag ~= nil then
            CollectionService:AddTag(mote, ambientMoteTag)
        end
    end
end

local function billboard(target: BasePart, text: string, color: Color3)
    local gui = Instance.new("BillboardGui")
    gui.Name = "LandmarkLabel"
    gui.Adornee = target
    gui.AlwaysOnTop = false
    gui.LightInfluence = 0.35
    gui.MaxDistance = 26
    gui.Size = UDim2.fromOffset(190, 40)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 3.8, 0)
    gui.Parent = target

    local label = Instance.new("TextLabel")
    label.BackgroundColor3 = Color3.fromRGB(14, 24, 21)
    label.BackgroundTransparency = 0.2
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = text
    label.TextColor3 = color
    label.TextScaled = false
    label.TextSize = 12
    label.TextWrapped = true
    label.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
end

local function _objectIcon(target: BasePart, kind: string, color: Color3)
    local gui = Instance.new("BillboardGui")
    gui.Name = "ObjectIcon"
    gui.Adornee = target
    gui.AlwaysOnTop = true
    gui.LightInfluence = 0
    gui.Size = UDim2.fromOffset(42, 42)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 5.8, 0)
    gui.MaxDistance = 72
    gui.Parent = target

    local glyph = Instance.new("TextLabel")
    glyph.Name = "IconGlyph"
    glyph.BackgroundColor3 = Color3.fromRGB(10, 21, 19)
    glyph.BackgroundTransparency = 0.05
    glyph.BorderSizePixel = 0
    glyph.Size = UDim2.fromScale(1, 1)
    glyph.Font = Enum.Font.GothamBold
    glyph.Text = if kind == "rootfire"
        then "✦"
        elseif kind == "livingroot" or kind == "root" then "✤"
        elseif kind == "wayhome" then "⌂"
        elseif kind == "event" or kind == "step" then "!"
        elseif kind == "antler" then "♢"
        else "✦"
    glyph.TextColor3 = color
    glyph.TextScaled = true
    glyph.ZIndex = 10
    glyph.Parent = gui
    local glyphCorner = Instance.new("UICorner")
    glyphCorner.CornerRadius = UDim.new(0, 10)
    glyphCorner.Parent = glyph

    local viewport = Instance.new("ViewportFrame")
    viewport.Size = UDim2.fromScale(1, 1)
    viewport.BackgroundColor3 = Color3.fromRGB(15, 27, 24)
    viewport.BackgroundTransparency = 0.08
    viewport.BorderSizePixel = 0
    viewport.Ambient = Color3.fromRGB(210, 224, 212)
    viewport.LightColor = Color3.fromRGB(255, 214, 146)
    viewport.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = viewport
    local worldModel = Instance.new("WorldModel")
    worldModel.Parent = viewport
    local camera = Instance.new("Camera")
    camera.CFrame = CFrame.new(0, 0.2, 6)
    camera.FieldOfView = 28
    camera.Parent = viewport
    viewport.CurrentCamera = camera

    local icon = Instance.new("Part")
    icon.Name = kind .. "Icon"
    icon.Anchored = true
    icon.CanCollide = false
    icon.CanQuery = false
    icon.Size = if kind == "rootfire"
        then Vector3.new(1.4, 1.8, 1.4)
        else Vector3.new(1.8, 1.8, 1.8)
    icon.Position = Vector3.new(0, 0, 0)
    icon.Color = color
    icon.Material = Enum.Material.Neon
    icon.Shape = if kind == "rootfire" then Enum.PartType.Ball else Enum.PartType.Cylinder
    icon.Parent = worldModel
end

-- Interactable identity is authored by the physical world prop itself. Keep
-- this compatibility hook for older callers without adding floating UI cards.
local function objectIcon(_target: BasePart, _kind: string, _color: Color3) end

local function destinationCairns(parent: Instance, center: Vector3, color: Color3, radius: number)
    local placements = {
        { angle = math.rad(28), radius = radius * 0.92, lean = math.rad(-5) },
        { angle = math.rad(157), radius = radius * 1.08, lean = math.rad(4) },
        { angle = math.rad(262), radius = radius * 0.84, lean = math.rad(-3) },
    }
    for index, placement in placements do
        local offset = Vector3.new(
            math.cos(placement.angle) * placement.radius,
            0,
            math.sin(placement.angle) * placement.radius
        )
        local base = center + offset
        local stone = part(
            parent,
            "DestinationCairnStone",
            Vector3.new(1.75, 1.35, 1.45),
            CFrame.new(base + Vector3.new(0, 0.68, 0))
                * CFrame.Angles(0, placement.angle + 0.37, placement.lean),
            if index == 2 then Color3.fromRGB(70, 81, 77) else STONE,
            Enum.Material.Slate,
            false
        )
        stone.Shape = Enum.PartType.Ball
        local inset = part(
            parent,
            "DestinationCairnInset",
            Vector3.new(0.42, 0.42, 0.16),
            CFrame.lookAt(base + Vector3.new(0, 1.62, 0), center),
            color,
            Enum.Material.Glass,
            false
        )
        inset.Transparency = 0.12
        inset:SetAttribute("CairnIndex", index)
    end
end

local function cagedLanternShell(parent: Instance, center: Vector3, scale: number, prefix: string)
    part(
        parent,
        prefix .. "StoneFoot",
        Vector3.new(4.4, 0.8, 4.4) * scale,
        CFrame.new(center + Vector3.new(0, -2.2 * scale, 0)),
        STONE,
        Enum.Material.Slate,
        false
    )
    for sideX = -1, 1, 2 do
        for sideZ = -1, 1, 2 do
            part(
                parent,
                prefix .. "CageBar",
                Vector3.new(0.28, 5.1, 0.28) * scale,
                CFrame.new(center + Vector3.new(sideX * 1.45 * scale, 0, sideZ * 1.45 * scale))
                    * CFrame.Angles(0, 0, math.rad(sideX * sideZ * 2.5)),
                Color3.fromRGB(48, 52, 56),
                Enum.Material.Metal,
                false
            )
        end
    end
    local hood = part(
        parent,
        prefix .. "RainHood",
        Vector3.new(4.8, 1.1, 4.8) * scale,
        CFrame.new(center + Vector3.new(0, 2.72 * scale, 0)),
        DARK_BARK,
        Enum.Material.Slate,
        false
    )
    hood.Shape = Enum.PartType.Cylinder
end

local function livingRootShell(parent: Instance, center: Vector3, scale: number, prefix: string)
    part(
        parent,
        prefix .. "RootMound",
        Vector3.new(5.8, 1.2, 5.2) * scale,
        CFrame.new(center + Vector3.new(0, -2.15 * scale, 0)),
        Color3.fromRGB(56, 67, 50),
        Enum.Material.Ground,
        false
    )
    for rootIndex = 1, 3 do
        local angle = (rootIndex / 3) * math.pi * 2
        part(
            parent,
            prefix .. "LivingRoot",
            Vector3.new(0.72, 5.6 + (rootIndex % 2) * 1.1, 0.72) * scale,
            CFrame.new(
                center
                    + Vector3.new(
                        math.cos(angle) * 1.75 * scale,
                        -0.2 * scale,
                        math.sin(angle) * 1.75 * scale
                    )
            )
                * CFrame.Angles(
                    math.rad(math.sin(angle) * 10),
                    angle,
                    math.rad(math.cos(angle) * 28)
                ),
            if rootIndex % 2 == 0 then BARK else DARK_BARK,
            Enum.Material.Wood,
            false
        )
    end
end

local function chapterChoiceShrine(
    parent: Instance,
    center: Vector3,
    color: Color3,
    decisionId: string
): BasePart
    local target = orb(
        parent,
        "GreenwardChoice_" .. decisionId,
        center + Vector3.new(0, 1.3, 0),
        1.15,
        color,
        Enum.Material.Glass
    )
    target.Transparency = 0.35
    part(
        parent,
        "ChoicePlanter_" .. decisionId,
        Vector3.new(6.8, 1.5, 5.2),
        CFrame.new(center + Vector3.new(0, -0.25, 0)),
        Color3.fromRGB(78, 58, 39),
        Enum.Material.WoodPlanks,
        false
    )
    local stemCount = 2
    for stemIndex = 1, stemCount do
        local x = ((stemIndex * 17) % 9 - 4) * 0.55
        local z = ((stemIndex * 11) % 7 - 3) * 0.48
        local height = 2.4 + (stemIndex % 3) * 0.65
        part(
            parent,
            "ChoicePlantStem_" .. decisionId,
            Vector3.new(0.28, height, 0.28),
            CFrame.new(center + Vector3.new(x, 0.5 + height * 0.5, z))
                * CFrame.Angles(0, 0, math.rad((stemIndex % 2 == 0 and 1 or -1) * 8)),
            if decisionId == "restore_farmland" then MEADOW else MOSS,
            Enum.Material.Grass,
            false
        )
        local leaf = part(
            parent,
            "ChoicePlantLeaf_" .. decisionId,
            Vector3.new(1.15, 0.22, 0.65),
            CFrame.new(center + Vector3.new(x + 0.35, 1.4 + height * 0.62, z)),
            color,
            Enum.Material.LeafyGrass,
            false
        )
        leaf.Shape = Enum.PartType.Wedge
    end
    target:SetAttribute("PhysicalChoiceShrine", true)
    return target
end

local function tree(parent: Instance, position: Vector3, scale: number)
    local trunk = part(
        parent,
        "BrambleTrunk",
        Vector3.new(2.4 * scale, 14 * scale, 2.4 * scale),
        CFrame.new(position + Vector3.new(0, 7 * scale, 0)),
        BARK,
        Enum.Material.Wood
    )
    for side = -1, 1, 2 do
        local branch = part(
            parent,
            "BrambleBranch",
            Vector3.new(0.65 * scale, 5 * scale, 0.65 * scale),
            CFrame.new(position + Vector3.new(side * 2.3 * scale, 7 * scale, 0))
                * CFrame.Angles(0, 0, math.rad(side * 48)),
            BARK,
            Enum.Material.Wood,
            false
        )
        branch.CanQuery = false
    end
    for layer = 1, 2 do
        local crownPosition = position + Vector3.new(0, (11 + layer * 4.2) * scale, 0)
        local crownSize =
            Vector3.new((11 - layer * 1.5) * scale, (7 - layer) * scale, (11 - layer * 1.5) * scale)
        for half = 1, 2 do
            local crown = part(
                parent,
                "BrambleCrown",
                crownSize,
                CFrame.new(crownPosition)
                    * CFrame.Angles(0, if half == 1 then 0.15 else math.pi + 0.15, 0),
                if layer == 1 then DEEP_GRASS else GRASS,
                Enum.Material.Grass,
                false
            )
            crown.Shape = Enum.PartType.Wedge
            crown.CanQuery = false
        end
    end
    trunk.CanQuery = false
end

local function rootArch(parent: Instance, center: Vector3, scale: number, facing: number?)
    local turn = CFrame.Angles(0, facing or 0, 0)
    local function placed(offset: Vector3): Vector3
        return center + (turn * offset)
    end
    for side = -1, 1, 2 do
        part(
            parent,
            "LivingRoot",
            Vector3.new(2.4 * scale, 18 * scale, 2.4 * scale),
            CFrame.new(placed(Vector3.new(side * 10 * scale, 8 * scale, side * 10 * scale)))
                * CFrame.Angles(0, facing or 0, math.rad(-side * 18)),
            BARK,
            Enum.Material.Wood
        )
    end
    part(
        parent,
        "RootCrown",
        Vector3.new(29 * scale, 2.8 * scale, 3 * scale),
        CFrame.new(center + Vector3.new(0, 17 * scale, 0)) * CFrame.Angles(0, math.rad(45), 0),
        DARK_BARK,
        Enum.Material.Wood
    )
end

local function lantern(parent: Instance, position: Vector3, scale: number, ambientLightTag: string?)
    part(
        parent,
        "FoxfirePost",
        Vector3.new(0.8 * scale, 6 * scale, 0.8 * scale),
        CFrame.new(position + Vector3.new(0, 3 * scale, 0)),
        BARK,
        Enum.Material.Wood
    )
    local glow = orb(
        parent,
        "FoxfireGlow",
        position + Vector3.new(0, 6.4 * scale, 0),
        2.1 * scale,
        FOXFIRE,
        Enum.Material.Neon
    )
    light(glow, FOXFIRE, 1.8, 18 * scale)
    if ambientLightTag ~= nil then
        CollectionService:AddTag(glow, ambientLightTag)
    end
end

local function pathArm(parent: Instance, center: Vector3, neighbor: Vector3)
    local delta = neighbor - center
    local target = center + delta.Unit * 38
    local midpoint = (center + target) / 2 + Vector3.new(0, 0.28, 0)
    local roadFrame = CFrame.lookAt(midpoint, target)
    local road = part(
        parent,
        "CriticalPath",
        Vector3.new(16, 0.5, (target - center).Magnitude + 4),
        roadFrame,
        PATH,
        Enum.Material.Ground
    )
    road.Reflectance = 0.02
    local wear = part(
        parent,
        "EvacuationTrailWear",
        Vector3.new(5.2, 0.16, (target - center).Magnitude + 3.5),
        roadFrame * CFrame.new(0, 0.31, 0),
        Color3.fromRGB(95, 72, 48),
        Enum.Material.Mud,
        false
    )
    wear.CanQuery = false
    wear.CastShadow = false
    for side = -1, 1, 2 do
        local edge = part(
            parent,
            "EvacuationTrailEdge",
            Vector3.new(0.72, 0.32, (target - center).Magnitude + 3.2),
            roadFrame * CFrame.new(side * 7.15, 0.34, 0),
            if side < 0 then DARK_BARK else Color3.fromRGB(82, 91, 58),
            Enum.Material.Ground,
            false
        )
        edge.CanQuery = false
    end
end

local function evacuationRoadMarker(
    parent: Instance,
    center: Vector3,
    neighbor: Vector3,
    sequenceIndex: number
)
    local direction = (neighbor - center).Unit
    local side = Vector3.new(-direction.Z, 0, direction.X)
    local base = center + direction * 13 + side * 9
    local lean = if sequenceIndex % 4 == 1 then math.rad(-4) else math.rad(4)
    local sign = WorldSignBuilder.createDirectionSign(
        parent,
        "EvacuationRoadMarker",
        CFrame.lookAt(base + Vector3.new(0, 5.4, 0), neighbor) * CFrame.Angles(0, 0, lean),
        "EVACUATION ROAD",
        CREAM
    )
    local board = sign.PrimaryPart
    assert(board ~= nil, "evacuation road sign has no board")
    board.Name = "EvacuationRoadSign"
end

local function window(parent: Instance, position: Vector3, rotation: number)
    local frame = part(
        parent,
        "FarmWindowFrame",
        Vector3.new(3.8, 2.6, 0.35),
        CFrame.new(position) * CFrame.Angles(0, rotation, 0),
        DARK_BARK,
        Enum.Material.WoodPlanks,
        false
    )
    local pane = part(
        parent,
        "FarmWindowGlow",
        Vector3.new(2.8, 1.7, 0.15),
        CFrame.new(position + Vector3.new(0, 0, -0.22)) * CFrame.Angles(0, rotation, 0),
        Color3.fromRGB(255, 196, 103),
        Enum.Material.Glass,
        false
    )
    pane.Transparency = 0.18
    local cross = part(
        parent,
        "FarmWindowCross",
        Vector3.new(0.18, 2.1, 0.2),
        CFrame.new(position + Vector3.new(0, 0, -0.32)) * CFrame.Angles(0, rotation, 0),
        CREAM,
        Enum.Material.Wood,
        false
    )
    cross.CanQuery = false
    frame.CanQuery = false
end

local function fence(parent: Instance, start: Vector3, count: number, spacing: number)
    for index = 0, count - 1 do
        local position = start + Vector3.new(index * spacing, 0, 0)
        part(
            parent,
            "FieldFencePost",
            Vector3.new(0.6, 2.8, 0.6),
            CFrame.new(position + Vector3.new(0, 1.4, 0)),
            BARK,
            Enum.Material.Wood
        )
        if index < count - 1 then
            part(
                parent,
                "FieldFenceRail",
                Vector3.new(spacing + 0.2, 0.35, 0.35),
                CFrame.new(position + Vector3.new(spacing / 2, 1.1, 0)),
                DARK_BARK,
                Enum.Material.WoodPlanks,
                false
            )
            part(
                parent,
                "FieldFenceRail",
                Vector3.new(spacing + 0.2, 0.35, 0.35),
                CFrame.new(position + Vector3.new(spacing / 2, 2.0, 0)),
                DARK_BARK,
                Enum.Material.WoodPlanks,
                false
            )
        end
    end
end

--[[
    `isArrival` halves the scatter for the one module a player is guaranteed
    to stand in with no context yet. The arrival module already authors a
    small partBudget of its own for exactly this reason, but that budget only
    ever bounded its own visual -- this generic scatter ran at full density on
    top of it regardless, on every module including that one. First
    impressions do not get to be the busiest ones.
]]
local function moduleDressing(
    parent: Instance,
    center: Vector3,
    seed: number,
    runtimeIds: any,
    isArrival: boolean?
)
    local random = Random.new(seed)
    local scale = if isArrival then 0.5 else 1
    groundPatch(
        parent,
        center,
        Vector3.new(42, 0.28, 42),
        Color3.fromRGB(35, 61, 42),
        Enum.Material.LeafyGrass
    )
    groundPatch(
        parent,
        center + Vector3.new(0, 0.02, 0),
        Vector3.new(25, 0.22, 25),
        WET_EARTH,
        Enum.Material.Mud
    )
    for index = 1, math.floor(13 * scale) do
        local angle = random:NextNumber(0, math.pi * 2)
        local radius = random:NextNumber(12, 31)
        local position = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        local stone = orb(
            parent,
            "TrailStone",
            position + Vector3.new(0, 0.55, 0),
            random:NextNumber(1.2, 2.6),
            if index % 2 == 0 then STONE else Color3.fromRGB(75, 85, 72),
            Enum.Material.Slate
        )
        stone.CFrame *= CFrame.Angles(0.15, angle, 0.1)
        stone.CanQuery = false
        if index % 3 == 0 then
            rootTangle(
                parent,
                position + Vector3.new(1, 0, -1),
                random:NextNumber(0.65, 1.1),
                seed + index
            )
        end
    end
    for index = 1, math.floor(10 * scale) do
        local angle = random:NextNumber(0, math.pi * 2)
        local radius = random:NextNumber(7, 28)
        local position = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        if index % 2 == 0 then
            fernCluster(parent, position, random:NextNumber(0.7, 1.25), runtimeIds.AmbientSwayTag)
        else
            -- Deliberately not Neon and deliberately not the amber/foxfire
            -- pair that every functional light in this level uses -- a
            -- harvest node, the blackout fire, a relay core. A decorative
            -- mote that borrows the same colour and the same blown-out
            -- material as something a player is meant to walk toward is a
            -- decorative mote a player cannot tell apart from one.
            local tuft = orb(
                parent,
                "MossLight",
                position + Vector3.new(0, 0.6, 0),
                0.3,
                Color3.fromRGB(150, 176, 138),
                Enum.Material.ForceField
            )
            tuft.Transparency = 0.55
            tuft.CanQuery = false
            tuft.CastShadow = false
        end
    end
    if not isArrival then
        fireflyCluster(
            parent,
            center + Vector3.new(0, 0, 5),
            FOXFIRE,
            5,
            24,
            seed + 1301,
            runtimeIds.AmbientMoteTag
        )
    end
end

--[[
    Lantern posts marking the way to the next module.

    Emberhollow's own tutorial line is "follow the lantern path" -- this
    reuses that exact primitive rather than inventing a new symbol for
    Bramblewake. The arrival module's own gate already lights its two posts
    with `lantern()`; running the same shape rhythmically down every
    connection is what turns "a lit post" into "the lit post means forward,"
    the same way it already does at the gate.

    Two posts per forward connection, offset to the side so they mark the way
    without standing in it, placed for every module transition rather than
    some of them, because a trail with gaps reads as decoration and a trail
    without them reads as a trail.
]]
local function wayfindingTrail(
    parent: Instance,
    center: Vector3,
    neighbor: Vector3,
    ambientLightTag: string?
)
    local delta = neighbor - center
    if delta.Magnitude < 1 then
        return
    end
    local direction = delta.Unit
    local side = Vector3.new(-direction.Z, 0, direction.X)
    for index, fraction in { 0.32, 0.68 } do
        local offset = if index == 1 then 7 else -7
        local at = center + direction * (fraction * delta.Magnitude) + side * offset
        lantern(parent, at, 0.68, ambientLightTag)
    end
end

local function buildFarm(parent: Instance, center: Vector3): Model
    local shell = Instance.new("Model")
    shell.Name = "ProceduralCrookedFarmhouseShell"
    shell.Parent = parent
    local housePosition = center + Vector3.new(21, 5.5, 20)
    part(
        shell,
        "Farmhouse",
        Vector3.new(16, 11, 12),
        CFrame.new(housePosition),
        Color3.fromRGB(92, 66, 46),
        Enum.Material.WoodPlanks
    )
    local roof = part(
        shell,
        "RainDarkRoof",
        Vector3.new(20, 2, 8.5),
        CFrame.new(housePosition + Vector3.new(0, 7.2, -4.2)) * CFrame.Angles(0, 0, math.rad(-24)),
        DARK_BARK,
        Enum.Material.Slate
    )
    roof.CanQuery = false
    local roof2 = part(
        shell,
        "RainDarkRoof",
        Vector3.new(20, 2, 8.5),
        CFrame.new(housePosition + Vector3.new(0, 7.2, 4.2)) * CFrame.Angles(0, 0, math.rad(24)),
        DARK_BARK,
        Enum.Material.Slate
    )
    roof2.CanQuery = false
    part(
        parent,
        "FarmDoor",
        Vector3.new(3.2, 5.4, 0.35),
        CFrame.new(housePosition + Vector3.new(0, -2.8, -6.2)),
        DARK_BARK,
        Enum.Material.WoodPlanks,
        false
    )
    window(parent, housePosition + Vector3.new(-5, 1.3, -6.25), 0)
    window(parent, housePosition + Vector3.new(5, 1.3, -6.25), 0)
    part(
        shell,
        "FarmChimney",
        Vector3.new(2.2, 5, 2.2),
        CFrame.new(housePosition + Vector3.new(4.5, 9, 1.5)),
        STONE,
        Enum.Material.Brick,
        false
    )
    fence(parent, center + Vector3.new(-31, 0, 24), 6, 4.8)
    for index = 1, 3 do
        local bale = part(
            parent,
            "HayBale",
            Vector3.new(3.4, 2.2, 2.2),
            CFrame.new(center + Vector3.new(-28 + index * 3.8, 1.1, 17)),
            MEADOW,
            Enum.Material.Fabric,
            false
        )
        bale.Shape = Enum.PartType.Cylinder
        bale.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    end
    for row = -1, 1 do
        part(
            parent,
            "OldFieldRow",
            Vector3.new(3, 0.8, 28),
            CFrame.new(center + Vector3.new(-18 + row * 6, 0.2, 9)),
            MEADOW,
            Enum.Material.Ground,
            false
        )
    end
    return shell
end

local function buildWindmill(parent: Instance, center: Vector3, ambientMotionTag: string): Model
    local shell = Instance.new("Model")
    shell.Name = "ProceduralFoxfireMillTowerShell"
    shell.Parent = parent
    local tower = part(
        shell,
        "WindmillTower",
        Vector3.new(9, 30, 9),
        CFrame.new(center + Vector3.new(22, 15, 20)),
        Color3.fromRGB(105, 84, 61),
        Enum.Material.WoodPlanks
    )
    local hub = orb(
        parent,
        "WindmillHub",
        tower.Position + Vector3.new(0, 8, -5),
        3,
        STONE,
        Enum.Material.Metal
    )
    local cap = part(
        shell,
        "WindmillCap",
        Vector3.new(11, 3, 11),
        CFrame.new(tower.Position + Vector3.new(0, 16, 0)),
        DARK_BARK,
        Enum.Material.Slate,
        false
    )
    cap.Shape = Enum.PartType.Cylinder
    cap.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    for side = -1, 1, 2 do
        part(
            shell,
            "WindmillBrace",
            Vector3.new(1.1, 28, 1.1),
            CFrame.new(tower.Position + Vector3.new(side * 3.3, 0, -4.6))
                * CFrame.Angles(0, 0, math.rad(side * 9)),
            DARK_BARK,
            Enum.Material.Wood,
            false
        )
    end
    local rotor = Instance.new("Model")
    rotor.Name = "WindmillRotor"
    rotor:SetAttribute("MotionKind", "rotor")
    rotor:SetAttribute("MotionSpeed", 0.3)
    rotor.Parent = parent
    local rotorPivot = part(
        rotor,
        "WindmillRotorPivot",
        Vector3.new(0.2, 0.2, 0.2),
        CFrame.new(hub.Position),
        STONE,
        Enum.Material.SmoothPlastic,
        false
    )
    rotorPivot.Transparency = 1
    rotorPivot.CanQuery = false
    rotorPivot.CastShadow = false
    rotor.PrimaryPart = rotorPivot
    for angle = 0, 3 do
        part(
            rotor,
            "WindmillSail",
            Vector3.new(2, 19, 0.8),
            CFrame.new(hub.Position) * CFrame.Angles(0, 0, angle * math.pi / 2),
            CREAM,
            Enum.Material.Fabric,
            false
        )
        part(
            rotor,
            "WindmillSailArm",
            Vector3.new(0.7, 16, 1.2),
            CFrame.new(hub.Position) * CFrame.Angles(0, 0, angle * math.pi / 2 + math.pi / 4),
            BARK,
            Enum.Material.Wood,
            false
        )
    end
    CollectionService:AddTag(rotor, ambientMotionTag)
    return shell
end

local function dress(
    extra: { any },
    assetId: string,
    parent: Instance,
    position: Vector3,
    scale: number,
    yaw: number,
    seed: number
)
    table.insert(extra, {
        assetId = assetId,
        fallbackKind = "asset_dressing",
        position = position,
        scale = scale,
        yaw = yaw,
        seed = seed,
        swayTag = nil,
        parent = parent,
        fallbackInstance = nil,
    })
end

--[[
    A story landmark is a scene the route walks past rather than an encounter
    it stops at, so it has to say what happened without a prompt to read. The
    primitives below are the specific evidence -- a sickle dropped mid-row, a
    cart still loaded, a satchel at a crossing nobody finished. `extra` is
    what puts the world back around them, because a table and three baskets
    alone read as crates in a field.
]]
local function buildStoryLandmark(
    parent: Instance,
    center: Vector3,
    kind: string,
    title: string,
    offset: any,
    extra: { any }
): number
    assert(
        type(offset) == "table" and type(offset.x) == "number" and type(offset.z) == "number",
        "Bramblewake story landmark is missing its authored offset"
    )
    local origin = center + Vector3.new(offset.x, 0, offset.z)
    local count = 0
    local function storyPart(
        name: string,
        size: Vector3,
        cframe: CFrame,
        color: Color3,
        material: Enum.Material
    ): Part
        local artifact = part(parent, name, size, cframe, color, material, false)
        artifact.CanQuery = false
        artifact:SetAttribute("StoryLandmark", kind)
        count += 1
        return artifact
    end

    local anchor: BasePart
    if kind == "last_harvest" then
        anchor = storyPart(
            "LastHarvestTable",
            Vector3.new(8.5, 0.55, 4.2),
            CFrame.new(origin + Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, 0.18, 0),
            Color3.fromRGB(96, 68, 43),
            Enum.Material.WoodPlanks
        )
        for x = -1, 1, 2 do
            for z = -1, 1, 2 do
                storyPart(
                    "HarvestTableLeg",
                    Vector3.new(0.45, 2.5, 0.45),
                    CFrame.new(origin + Vector3.new(x * 3.2, 1.25, z * 1.25)),
                    DARK_BARK,
                    Enum.Material.Wood
                )
            end
        end
        for basketIndex = -1, 1 do
            local basket = storyPart(
                "AbandonedHarvestBasket",
                Vector3.new(1.8, 1.3, 1.8),
                CFrame.new(origin + Vector3.new(basketIndex * 2.5, 3.45, 0)),
                if basketIndex == 0 then MEADOW else Color3.fromRGB(145, 91, 53),
                Enum.Material.WoodPlanks
            )
            basket.Shape = Enum.PartType.Ball
        end
        storyPart(
            "HarvestSickleHandle",
            Vector3.new(0.35, 3.6, 0.35),
            CFrame.new(origin + Vector3.new(4.7, 0.9, 1.5)) * CFrame.Angles(0, 0, math.rad(68)),
            BARK,
            Enum.Material.Wood
        )
        storyPart(
            "HarvestSickleBlade",
            Vector3.new(1.8, 0.3, 0.55),
            CFrame.new(origin + Vector3.new(5.8, 1.9, 1.5)) * CFrame.Angles(0, 0, math.rad(28)),
            Color3.fromRGB(127, 139, 140),
            Enum.Material.Metal
        )
        -- The crop is what makes the dropped sickle mean anything: rows still
        -- standing on one side, cut and stacked on the other, stopping where
        -- whoever was working simply left.
        for row = 0, 3 do
            dress(
                extra,
                "mesh_creator_wheat_cluster_a",
                parent,
                origin + Vector3.new(-9.5 + row * 1.6, 0, -7.5 - row * 2.2),
                1.05 + (row % 2) * 0.14,
                math.rad(row * 37),
                8100 + row
            )
            dress(
                extra,
                "mesh_creator_wheat_cluster_a",
                parent,
                origin + Vector3.new(9 - row * 1.3, 0, -6 - row * 2.6),
                0.92 + (row % 3) * 0.1,
                math.rad(180 + row * 29),
                8110 + row
            )
        end
        dress(
            extra,
            "mesh_creator_crate_a",
            parent,
            origin + Vector3.new(-6.2, 0, 3.4),
            1,
            math.rad(21),
            8120
        )
        dress(
            extra,
            "mesh_creator_barrel_a",
            parent,
            origin + Vector3.new(-7.4, 0, 5.6),
            1,
            math.rad(-14),
            8121
        )
        dress(
            extra,
            "mesh_creator_rustic_fence_a",
            parent,
            origin + Vector3.new(0, 0, 9.5),
            1.1,
            0,
            8122
        )
    elseif kind == "evacuation_cart" then
        anchor = storyPart(
            "EvacuationHandcart",
            Vector3.new(8.5, 2.8, 5.2),
            CFrame.new(origin + Vector3.new(0, 1.65, 0)) * CFrame.Angles(0.08, 0.35, 0.12),
            Color3.fromRGB(103, 70, 43),
            Enum.Material.WoodPlanks
        )
        storyPart(
            "EvacuationCartTongue",
            Vector3.new(0.7, 0.7, 7.5),
            anchor.CFrame * CFrame.new(0, -0.35, -5.8) * CFrame.Angles(math.rad(-8), 0, 0),
            BARK,
            Enum.Material.Wood
        )
        for side = -1, 1, 2 do
            local wheel = storyPart(
                "EvacuationCartWheel",
                Vector3.new(0.65, 4.4, 4.4),
                anchor.CFrame * CFrame.new(side * 4.55, -0.6, 0),
                DARK_BARK,
                Enum.Material.Wood
            )
            wheel.Shape = Enum.PartType.Cylinder
        end
        for crateIndex = -1, 1 do
            storyPart(
                "EvacuationCrate",
                Vector3.new(2.2, 1.8 + math.abs(crateIndex) * 0.35, 2.2),
                anchor.CFrame * CFrame.new(crateIndex * 2.4, 2.2, 0),
                if crateIndex == 0 then Color3.fromRGB(108, 124, 74) else Color3.fromRGB(91, 62, 40),
                Enum.Material.WoodPlanks
            )
        end
        dress(
            extra,
            "mesh_creator_crate_a",
            parent,
            origin + Vector3.new(-7.8, 0, 2.9),
            1.05,
            math.rad(-24),
            8200
        )
        dress(
            extra,
            "mesh_creator_crate_a",
            parent,
            origin + Vector3.new(-6.1, 0, -3.6),
            0.9,
            math.rad(11),
            8201
        )
        dress(
            extra,
            "mesh_creator_barrel_a",
            parent,
            origin + Vector3.new(7.2, 0, 3.1),
            1,
            math.rad(38),
            8202
        )
        -- Spilled on the verge, because a cart left loaded was a cart nobody
        -- came back for.
        dress(
            extra,
            "mesh_creator_road_stones_a",
            parent,
            origin + Vector3.new(2.4, 0, 7.8),
            1.15,
            math.rad(-9),
            8203
        )
        dress(
            extra,
            "mesh_deadfall_a",
            parent,
            origin + Vector3.new(-10.5, 0, -7.2),
            1,
            math.rad(64),
            8204
        )
        for trackIndex = 1, 4 do
            local track = storyPart(
                "DepartureTrack",
                Vector3.new(1.2, 0.12, 2.4),
                CFrame.new(origin + Vector3.new(-5 + trackIndex * 2.1, 0.31, -5 - trackIndex * 2.7))
                    * CFrame.Angles(0, 0.25, 0),
                WET_EARTH,
                Enum.Material.Mud
            )
            track.Transparency = 0.12
        end
    elseif kind == "last_repair" then
        anchor = storyPart(
            "FallenWindmillSpar",
            Vector3.new(1, 17, 1),
            CFrame.new(origin + Vector3.new(0, 1.2, 0))
                * CFrame.Angles(math.rad(88), math.rad(16), 0),
            BARK,
            Enum.Material.Wood
        )
        for sailIndex = -1, 1, 2 do
            local sail = storyPart(
                "TornWindmillSail",
                Vector3.new(4.2, 0.28, 6.8),
                CFrame.new(origin + Vector3.new(sailIndex * 3.2, 0.48, sailIndex * 2.1))
                    * CFrame.Angles(0, math.rad(16 + sailIndex * 8), math.rad(sailIndex * 4)),
                CREAM,
                Enum.Material.Fabric
            )
            sail.Transparency = 0.12
        end
        storyPart(
            "RepairToolChest",
            Vector3.new(4.5, 2.1, 2.8),
            CFrame.new(origin + Vector3.new(6, 1.05, 4)),
            Color3.fromRGB(90, 61, 41),
            Enum.Material.WoodPlanks
        )
        dress(
            extra,
            "mesh_creator_crate_a",
            parent,
            origin + Vector3.new(4.9, 0, -4.2),
            0.95,
            math.rad(17),
            8300
        )
        dress(
            extra,
            "mesh_creator_barrel_a",
            parent,
            origin + Vector3.new(6.3, 0, -1.8),
            1,
            math.rad(-31),
            8301
        )
        dress(
            extra,
            "mesh_boulder_cluster_a",
            parent,
            origin + Vector3.new(-8.6, 0, 4.4),
            1.2,
            math.rad(53),
            8302
        )
        dress(
            extra,
            "mesh_deadfall_a",
            parent,
            origin + Vector3.new(-5.2, 0, -8.1),
            1.05,
            math.rad(-72),
            8303
        )
        dress(
            extra,
            "mesh_fern_cluster_a",
            parent,
            origin + Vector3.new(8.1, 0, 5.9),
            1,
            math.rad(26),
            8304
        )
        for toolIndex = -1, 1 do
            storyPart(
                "AbandonedRepairTool",
                Vector3.new(0.35, 3.2, 0.35),
                CFrame.new(origin + Vector3.new(5.3 + toolIndex * 1.1, 2.75, 4))
                    * CFrame.Angles(0, 0, math.rad(68 + toolIndex * 9)),
                if toolIndex == 0 then Color3.fromRGB(131, 144, 146) else BARK,
                if toolIndex == 0 then Enum.Material.Metal else Enum.Material.Wood
            )
        end
    elseif kind == "lost_crossing" then
        anchor = storyPart(
            "LostCrossingSatchel",
            Vector3.new(3.1, 2.2, 1.3),
            CFrame.new(origin + Vector3.new(3.5, 1.2, 1.8)) * CFrame.Angles(0.12, -0.4, 0.2),
            Color3.fromRGB(118, 78, 49),
            Enum.Material.Fabric
        )
        for plankIndex = -1, 1 do
            storyPart(
                "SnappedCrossingPlank",
                Vector3.new(2.8, 0.45, 7),
                CFrame.new(origin + Vector3.new(plankIndex * 3.4, 0.55, -1 + plankIndex * 1.4))
                    * CFrame.Angles(
                        math.rad(plankIndex * 5),
                        math.rad(plankIndex * 12),
                        math.rad(plankIndex * 4)
                    ),
                Color3.fromRGB(94, 65, 43),
                Enum.Material.WoodPlanks
            )
        end
        for railIndex = -1, 1, 2 do
            storyPart(
                "BrokenCrossingRail",
                Vector3.new(0.55, 6.5, 0.55),
                CFrame.new(origin + Vector3.new(railIndex * 5.2, 1.25, -1))
                    * CFrame.Angles(math.rad(74), 0, math.rad(railIndex * 12)),
                DARK_BARK,
                Enum.Material.Wood
            )
        end
        -- The bank is dressed, not the gap. The missing span is the point,
        -- so nothing is placed across it.
        dress(
            extra,
            "mesh_boulder_cluster_a",
            parent,
            origin + Vector3.new(-7.9, 0, 3.2),
            1.25,
            math.rad(41),
            8400
        )
        dress(
            extra,
            "mesh_boulder_cluster_a",
            parent,
            origin + Vector3.new(6.8, 0, -4.6),
            1,
            math.rad(-18),
            8401
        )
        dress(
            extra,
            "mesh_deadfall_a",
            parent,
            origin + Vector3.new(-4.1, 0, -7.4),
            1.1,
            math.rad(88),
            8402
        )
        dress(
            extra,
            "mesh_lantern_post_a",
            parent,
            origin + Vector3.new(5.4, 0, 6.2),
            1,
            math.rad(-7),
            8403
        )
        dress(
            extra,
            "mesh_fern_cluster_a",
            parent,
            origin + Vector3.new(-6.3, 0, -2.1),
            0.95,
            math.rad(133),
            8404
        )
        local lostLantern = storyPart(
            "ColdTrailLantern",
            Vector3.new(1.6, 2.1, 1.6),
            CFrame.new(origin + Vector3.new(-4.7, 1.15, 4.2)),
            Color3.fromRGB(91, 118, 113),
            Enum.Material.Glass
        )
        lostLantern.Shape = Enum.PartType.Ball
        lostLantern.Transparency = 0.28
    else
        error("Unknown Bramblewake story landmark kind: " .. kind)
    end
    billboard(anchor, title, CREAM)
    parent:SetAttribute("StoryLandmark", kind)
    parent:SetAttribute("StoryLandmarkTitle", title)
    parent:SetAttribute("StoryLandmarkPartCount", count)
    return count
end

--[[
    Authored dressing for a module.

    Several of these assets already existed and simply were not being used out
    here -- the root arch, the boulder cluster, the conifers, the shrine --
    which is most of why Bramblewake read as grey slabs while Emberhollow read
    as a place. `extra` collects any number of placements so a module can carry
    a proper set rather than the single one the return value allows.
]]

--[[
    `facing` is the yaw of the road as it arrives at this module.

    Route modules sit on a winding grid, so anything a player walks through
    rather than past -- the three gates -- has to be turned to meet them.
    Every one of them was placed at yaw 0 regardless of which way the road
    ran, which is why the arches read as standing sideways across the path.
]]
local function buildModuleVisual(
    parent: Instance,
    visual: string,
    center: Vector3,
    runtimeIds: any,
    extra: { any },
    facing: number
): any?
    if visual == "lantern_gate" then
        rootArch(parent, center, 1, facing)
        lantern(parent, center + Vector3.new(-14, 0, 13), 1, runtimeIds.AmbientLightTag)
        lantern(parent, center + Vector3.new(14, 0, 13), 1, runtimeIds.AmbientLightTag)
        dress(extra, "mesh_root_arch_a", parent, center, 1, facing, 2401)
        dress(
            extra,
            "mesh_creator_street_lantern_a",
            parent,
            center + Vector3.new(-14, 0, 13),
            1,
            0,
            2402
        )
        dress(
            extra,
            "mesh_creator_street_lantern_a",
            parent,
            center + Vector3.new(14, 0, 13),
            1,
            0,
            2403
        )
    elseif visual == "root_arch" then
        rootArch(parent, center + Vector3.new(0, 0, -7), 0.9)
        dress(extra, "mesh_root_arch_a", parent, center + Vector3.new(0, 0, -7), 0.9, facing, 2411)
        dress(extra, "mesh_fern_cluster_a", parent, center + Vector3.new(-11, 0, 6), 1.2, 0.4, 2412)
        dress(extra, "mesh_fern_cluster_a", parent, center + Vector3.new(12, 0, 4), 1.1, 2.2, 2413)
        for offset = -1, 1, 2 do
            orb(
                parent,
                "Brightcap",
                center + Vector3.new(offset * 15, 1.1, 12),
                2.2,
                FOXFIRE,
                Enum.Material.Neon
            )
        end
    elseif visual == "orchard" then
        for x = -1, 1 do
            for z = -1, 1 do
                tree(parent, center + Vector3.new(x * 17, 0, z * 17), 0.68)
                dress(
                    extra,
                    if (x + z) % 2 == 0 then "mesh_broadleaf_hero_a" else "mesh_conifer_hero_b",
                    parent,
                    center + Vector3.new(x * 17, 0, z * 17),
                    0.85,
                    (x + 2) * 1.3 + z,
                    2420 + (x + 1) * 3 + (z + 1)
                )
            end
        end
        dress(extra, "mesh_deadfall_a", parent, center + Vector3.new(6, 0, -20), 1, 0.7, 2429)
    elseif visual == "foxglove" then
        -- The orbs stay: they are the light this stretch of road is read by,
        -- and a textured flower cannot emit. The authored plant goes around
        -- each one so the glow reads as coming from inside the blooms rather
        -- than from a bare sphere floating in the dark.
        for index = 1, 8 do
            local side = if index % 2 == 0 then 1 else -1
            local at = center + Vector3.new(side * (12 + index), 1.2, -26 + index * 6)
            local glow = orb(
                parent,
                "Foxglove",
                at,
                1.4,
                if index % 3 == 0 then AMBER else FOXFIRE,
                Enum.Material.Neon
            )
            glow.CanQuery = false
            dress(
                extra,
                "mesh_foxglove_cluster_a",
                parent,
                at - Vector3.new(0, 1.2, 0),
                0.95 + (index % 3) * 0.12,
                math.rad(index * 47 + side * 20),
                7300 + index
            )
        end
    elseif visual == "farm" then
        local shell = buildFarm(parent, center)
        return {
            assetId = "mesh_crooked_farmhouse_a",
            fallbackKind = "placeholder",
            position = center + Vector3.new(21, 0, 20),
            scale = 1,
            yaw = 0,
            seed = 2101,
            swayTag = nil,
            parent = parent,
            fallbackInstance = shell,
        }
    elseif visual == "briar_ring" then
        for index = 1, 10 do
            local angle = (index / 10) * math.pi * 2 + math.pi / 10
            dress(
                extra,
                "mesh_briar_wall_a",
                parent,
                center + Vector3.new(math.cos(angle) * 25, 0, math.sin(angle) * 25),
                1.1,
                -angle + math.pi / 2,
                2480 + index
            )
        end
        for index = 1, 6 do
            local angle = (index / 6) * math.pi * 2
            dress(
                extra,
                "mesh_deadfall_a",
                parent,
                center + Vector3.new(math.cos(angle) * 25, 0, math.sin(angle) * 25),
                1.1,
                -angle,
                2440 + index
            )
        end
        for index = 1, 8 do
            local angle = (index / 8) * math.pi * 2 + math.pi / 8
            part(
                parent,
                "BriarSpine",
                Vector3.new(1.4, 10, 1.4),
                CFrame.new(center + Vector3.new(math.cos(angle) * 25, 4, math.sin(angle) * 25))
                    * CFrame.Angles(math.rad(18), 0, -angle),
                DARK_BARK,
                Enum.Material.Wood
            )
        end
    elseif visual == "sapfall" then
        for index = -2, 2 do
            dress(
                extra,
                "mesh_boulder_cluster_a",
                parent,
                center + Vector3.new(index * 8, 0, 17 + math.abs(index) * 2),
                0.9,
                index * 0.8,
                2450 + index
            )
        end
        for index = -2, 2 do
            local stone = orb(
                parent,
                "SapglassStone",
                center + Vector3.new(index * 8, 2, 17 + math.abs(index) * 2),
                4.5,
                STONE,
                Enum.Material.Slate
            )
            local sap = orb(
                parent,
                "AmberSap",
                stone.Position + Vector3.new(0, 3.2, 0),
                1.8,
                AMBER,
                Enum.Material.Neon
            )
            if index == 0 then
                light(sap, AMBER, 1.7, 18)
            end
        end
    elseif visual == "windmill" then
        local shell = buildWindmill(parent, center, runtimeIds.AmbientMotionTag)
        return {
            assetId = "mesh_foxfire_windmill_tower_a",
            fallbackKind = "placeholder",
            position = center + Vector3.new(22, 0, 20),
            scale = 1,
            yaw = 0,
            seed = 2201,
            swayTag = nil,
            parent = parent,
            fallbackInstance = shell,
        }
    elseif visual == "bridge" then
        dress(extra, "mesh_tangle_bridge_a", parent, center + Vector3.new(19, 0.4, 0), 1, 0, 2470)
        for index = -4, 4 do
            part(
                parent,
                "RootBridgePlank",
                Vector3.new(7, 0.8, 4.5),
                CFrame.new(center + Vector3.new(19, 1 + math.abs(index) * 0.2, index * 4.4)),
                Color3.fromRGB(121, 83, 52),
                Enum.Material.WoodPlanks
            )
        end
    elseif visual == "moth_meadow" then
        for index = 1, 5 do
            local angle = index * 1.26
            dress(
                extra,
                if index % 2 == 0 then "mesh_conifer_hero_a" else "mesh_broadleaf_hero_a",
                parent,
                center + Vector3.new(math.cos(angle) * 26, 0, math.sin(angle) * 26),
                0.9,
                angle,
                2460 + index
            )
        end
        part(
            parent,
            "MeadowGold",
            Vector3.new(46, 0.7, 46),
            CFrame.new(center + Vector3.new(0, 0.1, 0)),
            MEADOW,
            Enum.Material.Grass
        )
        for index = 1, 10 do
            local angle = index * 2.4
            local moth = orb(
                parent,
                "LanternMoth",
                center
                    + Vector3.new(
                        math.cos(angle) * (8 + index),
                        3 + (index % 4),
                        math.sin(angle) * (8 + index)
                    ),
                0.65,
                FOXFIRE,
                Enum.Material.Neon
            )
            CollectionService:AddTag(moth, runtimeIds.AmbientMoteTag)
        end
    elseif visual == "old_growth" then
        dress(
            extra,
            "mesh_old_growth_stump_a",
            parent,
            center + Vector3.new(22, 0, 22),
            1.4,
            0.5,
            2490
        )
        dress(extra, "mesh_deadfall_a", parent, center + Vector3.new(6, 0, 14), 1.2, 1.9, 2491)
        dress(
            extra,
            "mesh_boulder_cluster_a",
            parent,
            center + Vector3.new(-14, 0, 18),
            1,
            0.3,
            2492
        )
        part(
            parent,
            "OldGrowthTrunk",
            Vector3.new(15, 48, 15),
            CFrame.new(center + Vector3.new(22, 23, 22)),
            DARK_BARK,
            Enum.Material.Wood
        )
        for index = 1, 5 do
            local angle = (index / 5) * math.pi * 2
            part(
                parent,
                "CathedralRoot",
                Vector3.new(4, 30, 5),
                CFrame.new(
                    center + Vector3.new(22 + math.cos(angle) * 10, 10, 22 + math.sin(angle) * 10)
                ) * CFrame.Angles(math.rad(24), 0, -angle),
                BARK,
                Enum.Material.Wood
            )
        end
    elseif visual == "wayhome_gate" then
        rootArch(parent, center, 1.15, facing)
        dress(extra, "mesh_wayhome_gate_a", parent, center, 1.25, facing, 2495)
        dress(
            extra,
            "mesh_creator_street_lantern_a",
            parent,
            center + Vector3.new(-11, 0, 8),
            1,
            0,
            2496
        )
        dress(
            extra,
            "mesh_creator_street_lantern_a",
            parent,
            center + Vector3.new(11, 0, 8),
            1,
            0,
            2497
        )
        local beacon =
            orb(parent, "WayhomeLight", center + Vector3.new(0, 8, 0), 6, AMBER, Enum.Material.Neon)
        light(beacon, AMBER, 3, 36, true)
        billboard(beacon, "WAYHOME GATE", CREAM)
        objectIcon(beacon, "wayhome", AMBER)
    end
end

--[[
    Points of interest are the reason to leave the road, so they have to look
    worth leaving it for. All four were built entirely from primitives while
    the assets that suit them -- the farmhouse, the lantern shrine, boulders,
    trees, crates -- already existed and were placed only in town.
]]
local function buildPointOfInterest(
    parent: Instance,
    center: Vector3,
    definition: any,
    runtimeIds: any,
    extra: { any }
)
    local landmark = Instance.new("Model")
    landmark.Name = "PhysicalPOI_" .. definition.id
    landmark:SetAttribute("ContentId", definition.id)
    landmark:SetAttribute("DisplayName", definition.displayName)
    landmark:SetAttribute("VisualKind", definition.visual)
    landmark.Parent = parent
    local origin = center + Vector3.new(-21, 0, -18)
    local anchor = part(
        landmark,
        "PointOfInterest",
        Vector3.new(4, 1, 4),
        CFrame.new(origin + Vector3.new(0, 0.5, 0)),
        STONE,
        Enum.Material.Slate,
        false
    )
    anchor.Transparency = 1
    anchor.CastShadow = false
    anchor:SetAttribute("ContentId", definition.id)
    anchor:SetAttribute("DisplayName", definition.displayName)
    CollectionService:AddTag(anchor, runtimeIds.ExpeditionPointOfInterestTag)

    local physicalParts = 0
    local function detail(
        name: string,
        size: Vector3,
        at: CFrame,
        color: Color3,
        material: Enum.Material,
        shape: Enum.PartType?
    ): Part
        physicalParts += 1
        local created = part(landmark, name, size, at, color, material, false)
        if shape ~= nil then
            created.Shape = shape
        end
        return created
    end

    local origin2 = center + Vector3.new(-21, 0, -18)
    if definition.visual == "ruined_homestead" then
        -- A burnt-out farm: the house it used to be, and what was left behind.
        dress(
            extra,
            "mesh_crooked_farmhouse_a",
            parent,
            origin2 + Vector3.new(0, 0, -6),
            1,
            0.4,
            2510
        )
        dress(extra, "mesh_creator_crate_a", parent, origin2 + Vector3.new(7, 0, 4), 1, 1.1, 2511)
        dress(extra, "mesh_creator_barrel_a", parent, origin2 + Vector3.new(9, 0, 1), 1, 0.2, 2512)
        dress(extra, "mesh_deadfall_a", parent, origin2 + Vector3.new(-9, 0, 6), 1, 2.4, 2513)
        detail(
            "ReedsteadFoundation",
            Vector3.new(13, 0.65, 10),
            CFrame.new(origin + Vector3.new(0, 0.32, 0)),
            Color3.fromRGB(76, 78, 72),
            Enum.Material.Cobblestone,
            nil
        )
        for side = -1, 1, 2 do
            detail(
                "ReedsteadBrokenPost",
                Vector3.new(0.85, if side < 0 then 7.5 else 5.6, 0.85),
                CFrame.new(origin + Vector3.new(side * 5.3, if side < 0 then 4 else 3, 3.8))
                    * CFrame.Angles(0, 0, math.rad(side * 7)),
                DARK_BARK,
                Enum.Material.Wood,
                nil
            )
            detail(
                "ReedsteadWallFragment",
                Vector3.new(4.8, 4.1 + side * 0.4, 0.55),
                CFrame.new(origin + Vector3.new(side * 2.8, 2.35, 4.6))
                    * CFrame.Angles(0, 0, math.rad(side * 4)),
                BARK,
                Enum.Material.WoodPlanks,
                nil
            )
        end
        detail(
            "ReedsteadCollapsedRafter",
            Vector3.new(12.5, 0.75, 1),
            CFrame.new(origin + Vector3.new(0, 3.2, -0.4))
                * CFrame.Angles(math.rad(12), math.rad(-18), math.rad(9)),
            WET_EARTH,
            Enum.Material.Wood,
            nil
        )
        detail(
            "ReedsteadColdHearth",
            Vector3.new(3.5, 2.6, 2.4),
            CFrame.new(origin + Vector3.new(3.8, 1.3, 2.8)),
            STONE,
            Enum.Material.Cobblestone,
            nil
        )
        for crateIndex = -1, 1 do
            detail(
                "ReedsteadSupplyCrate",
                Vector3.new(2.2, 1.8 + math.abs(crateIndex) * 0.3, 2.2),
                CFrame.new(origin + Vector3.new(crateIndex * 2.6, 1, -3.2))
                    * CFrame.Angles(0, math.rad(crateIndex * 9), 0),
                if crateIndex == 0 then Color3.fromRGB(108, 124, 74) else Color3.fromRGB(91, 62, 40),
                Enum.Material.WoodPlanks,
                nil
            )
        end
    elseif definition.visual == "moth_well" then
        dress(
            extra,
            "mesh_boulder_cluster_a",
            parent,
            origin2 + Vector3.new(-7, 0, 5),
            0.9,
            0.7,
            2520
        )
        dress(
            extra,
            "mesh_boulder_cluster_a",
            parent,
            origin2 + Vector3.new(8, 0, -4),
            0.8,
            2.1,
            2521
        )
        dress(extra, "mesh_lantern_post_a", parent, origin2 + Vector3.new(5, 0, 6), 1, 0, 2522)
        dress(
            extra,
            "mesh_fern_cluster_a",
            parent,
            origin2 + Vector3.new(-4, 0, -6),
            1.2,
            1.4,
            2523
        )
        for stoneIndex = 1, 10 do
            local angle = stoneIndex * math.pi * 2 / 10
            detail(
                "MothwellRimStone",
                Vector3.new(2.2, 1.25, 1.55),
                CFrame.new(origin + Vector3.new(math.cos(angle) * 4.2, 0.65, math.sin(angle) * 4.2))
                    * CFrame.Angles(0, -angle, math.rad((stoneIndex % 3 - 1) * 4)),
                if stoneIndex % 2 == 0 then STONE else Color3.fromRGB(65, 74, 72),
                Enum.Material.Slate,
                nil
            )
        end
        for side = -1, 1, 2 do
            detail(
                "MothwellPost",
                Vector3.new(0.65, 7.2, 0.65),
                CFrame.new(origin + Vector3.new(side * 4.9, 3.6, 0))
                    * CFrame.Angles(0, 0, math.rad(side * 4)),
                DARK_BARK,
                Enum.Material.Wood,
                nil
            )
        end
        detail(
            "MothwellCrossbeam",
            Vector3.new(10.8, 0.7, 0.7),
            CFrame.new(origin + Vector3.new(0, 6.8, 0)),
            BARK,
            Enum.Material.Wood,
            nil
        )
        detail(
            "MothwellBucket",
            Vector3.new(2, 2.2, 2),
            CFrame.new(origin + Vector3.new(0, 2.1, 0)),
            Color3.fromRGB(93, 70, 50),
            Enum.Material.WoodPlanks,
            Enum.PartType.Cylinder
        )
        for mothIndex = 1, 5 do
            local angle = mothIndex * 2.2
            local moth = detail(
                "MothwellLanternMoth",
                Vector3.new(0.55, 0.35, 0.18),
                CFrame.new(
                    origin
                        + Vector3.new(
                            math.cos(angle) * (3.2 + mothIndex * 0.3),
                            3.2 + mothIndex * 0.55,
                            math.sin(angle) * (3.2 + mothIndex * 0.3)
                        )
                ),
                FOXFIRE,
                Enum.Material.Glass,
                nil
            )
            moth.Transparency = 0.12
            CollectionService:AddTag(moth, runtimeIds.AmbientMoteTag)
        end
    elseif definition.visual == "sap_grove" then
        -- The grove is where sap comes from, so it shows real tapped boles.
        for groveIndex = 1, 3 do
            local angle = groveIndex * 2.1
            dress(
                extra,
                "mesh_amber_sap_node_a",
                parent,
                origin2 + Vector3.new(math.cos(angle) * 9, 0, math.sin(angle) * 9),
                1,
                angle,
                2530 + groveIndex
            )
        end
        dress(
            extra,
            "mesh_broadleaf_hero_a",
            parent,
            origin2 + Vector3.new(-11, 0, -8),
            0.9,
            0.6,
            2534
        )
        dress(
            extra,
            "mesh_conifer_hero_a",
            parent,
            origin2 + Vector3.new(12, 0, 7),
            0.85,
            2.7,
            2535
        )
        for trunkIndex = -1, 1 do
            local x = trunkIndex * 4.6
            detail(
                "SapglassTrunk",
                Vector3.new(2.6, 8 + math.abs(trunkIndex) * 2.2, 2.6),
                CFrame.new(origin + Vector3.new(x, 4.3 + math.abs(trunkIndex), 1.5))
                    * CFrame.Angles(0, 0, math.rad(trunkIndex * 7)),
                DARK_BARK,
                Enum.Material.Wood,
                nil
            )
            local sap = detail(
                "SapglassVein",
                Vector3.new(0.7, 4.8, 0.32),
                CFrame.new(origin + Vector3.new(x, 4.2, 0.1)),
                AMBER,
                Enum.Material.Glass,
                nil
            )
            sap.Transparency = 0.12
        end
        detail(
            "SapglassCollector",
            Vector3.new(9.5, 1.4, 3.2),
            CFrame.new(origin + Vector3.new(0, 0.7, -3.8)),
            Color3.fromRGB(87, 64, 45),
            Enum.Material.WoodPlanks,
            nil
        )
        for vialIndex = -2, 2 do
            local vial = detail(
                "SapglassVial",
                Vector3.new(0.85, 1.45, 0.85),
                CFrame.new(origin + Vector3.new(vialIndex * 1.55, 1.95, -3.8)),
                AMBER,
                Enum.Material.Glass,
                Enum.PartType.Cylinder
            )
            vial.Transparency = 0.16
        end
    else
        for side = -1, 1, 2 do
            detail(
                "RootChapelPillar",
                Vector3.new(1.2, 9.5, 1.2),
                CFrame.new(origin + Vector3.new(side * 4.2, 4.6, 2.6))
                    * CFrame.Angles(0, 0, math.rad(-side * 11)),
                DARK_BARK,
                Enum.Material.Wood,
                nil
            )
            detail(
                "RootChapelCrown",
                Vector3.new(1.0, 7.2, 1.0),
                CFrame.new(origin + Vector3.new(side * 2.1, 8.2, 2.6))
                    * CFrame.Angles(0, 0, math.rad(side * 58)),
                BARK,
                Enum.Material.Wood,
                nil
            )
            detail(
                "RootChapelBench",
                Vector3.new(5.8, 0.65, 1.45),
                CFrame.new(origin + Vector3.new(side * 3.4, 1.05, -2.5)),
                Color3.fromRGB(92, 65, 44),
                Enum.Material.WoodPlanks,
                nil
            )
        end
        detail(
            "RootChapelAltar",
            Vector3.new(5.2, 2.6, 3.2),
            CFrame.new(origin + Vector3.new(0, 1.3, 2.9)),
            Color3.fromRGB(72, 78, 74),
            Enum.Material.Slate,
            nil
        )
        for candleIndex = -1, 1 do
            local candle = detail(
                "RootChapelMemoryCandle",
                Vector3.new(0.65, 1.25, 0.65),
                CFrame.new(origin + Vector3.new(candleIndex * 1.4, 3.15, 2.7)),
                if candleIndex == 0 then AMBER else FOXFIRE,
                Enum.Material.Glass,
                Enum.PartType.Cylinder
            )
            candle.Transparency = 0.1
        end
        -- The lantern shrine asset was authored for exactly this and had never
        -- been placed anywhere in the world.
        dress(extra, "mesh_hollow_lantern_shrine_a", parent, origin2, 0.8, 0.2, 2540)
        dress(
            extra,
            "mesh_creator_kerosene_lantern_a",
            parent,
            origin2 + Vector3.new(3, 0, 4),
            1,
            0.9,
            2541
        )
        dress(extra, "mesh_fern_cluster_a", parent, origin2 + Vector3.new(-6, 0, 3), 1.1, 1.7, 2542)

        -- The chapel is the one point of interest whose structure was still
        -- primitive: pillars, a crown and benches standing in for a nave. The
        -- authored chapel replaces that shape rather than sitting beside it,
        -- so the pillars move into a shell the placement hides once the asset
        -- resolves. The altar and its candles stay outside the shell, because
        -- they are what the landmark is read by and they must survive an
        -- asset that never loads.
        local shell = Instance.new("Model")
        shell.Name = "RootChapelShell"
        shell.Parent = landmark
        for _, existing in landmark:GetChildren() do
            if
                existing:IsA("BasePart")
                and (
                    existing.Name == "RootChapelPillar"
                    or existing.Name == "RootChapelCrown"
                    or existing.Name == "RootChapelBench"
                )
            then
                existing.Parent = shell
            end
        end
        table.insert(extra, {
            assetId = "mesh_root_chapel_a",
            fallbackKind = "placeholder",
            position = origin,
            scale = 1,
            yaw = math.rad(6),
            seed = 2543,
            swayTag = nil,
            parent = parent,
            fallbackInstance = shell,
        })
    end

    local memory = orb(
        landmark,
        "POIMemoryLantern",
        origin + Vector3.new(0, 4.6, -0.8),
        1.35,
        FOXFIRE,
        Enum.Material.Glass
    )
    physicalParts += 1
    memory.Transparency = 0.1
    light(memory, FOXFIRE, 0.85, 13, true)
    billboard(memory, string.upper(definition.displayName), FOXFIRE)
    objectIcon(memory, "memory", FOXFIRE)
    landmark:SetAttribute("PhysicalPartCount", physicalParts)
    return memory
end

--[[
    Event scenes are the encounters a player stops for, and they were the last
    part of the route still assembled entirely from boxes. Each now carries the
    authored props that say what it is before the prompt is read, which is the
    order the visual standard asks for.
]]
local function buildEventSocket(
    parent: Instance,
    center: Vector3,
    definition: any,
    runtimeIds: any,
    extra: { any }
): any
    local anchor = part(
        parent,
        "EventSocket",
        Vector3.new(7, 1, 7),
        CFrame.new(center + Vector3.new(22, 0.5, -19)),
        Color3.fromRGB(99, 72, 48),
        Enum.Material.WoodPlanks
    )
    anchor:SetAttribute("ContentId", definition.id)
    anchor:SetAttribute("DisplayName", definition.displayName)
    anchor:SetAttribute("Dormant", true)
    anchor:SetAttribute("Status", "dormant")
    anchor:SetAttribute("Progress", 0)
    anchor:SetAttribute("ProgressTotal", #definition.steps)
    anchor.Transparency = 1
    anchor.CanCollide = false
    anchor.CastShadow = false
    CollectionService:AddTag(anchor, runtimeIds.ExpeditionEventTag)
    billboard(anchor, string.upper(definition.displayName), AMBER)
    objectIcon(anchor, "event", AMBER)
    destinationCairns(parent, anchor.Position, AMBER, 5.5)

    local scene = Instance.new("Model")
    scene.Name = "EventScene_" .. definition.id
    scene:SetAttribute("VisualKind", definition.visual)
    scene.Parent = parent

    local sceneAt = center + Vector3.new(22, 0, -19)
    if definition.visual == "wagon" then
        -- A wagon that did not make it, and the load it was carrying.
        dress(extra, "mesh_creator_crate_a", parent, sceneAt + Vector3.new(3, 0, 2), 1, 0.6, 2560)
        dress(extra, "mesh_creator_crate_a", parent, sceneAt + Vector3.new(-2, 0, 4), 1, 2.2, 2561)
        dress(extra, "mesh_creator_barrel_a", parent, sceneAt + Vector3.new(4, 0, -3), 1, 1.1, 2562)
        dress(extra, "mesh_deadfall_a", parent, sceneAt + Vector3.new(-6, 0, -2), 1, 1.6, 2563)
        part(
            scene,
            "LostWagon",
            Vector3.new(10, 5, 7),
            CFrame.new(anchor.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0.35, 0.14),
            Color3.fromRGB(104, 69, 42),
            Enum.Material.WoodPlanks
        )
        for wheelSide = -1, 1, 2 do
            local wheel = part(
                scene,
                "LostWagonWheel",
                Vector3.new(0.7, 5.3, 5.3),
                CFrame.new(anchor.Position + Vector3.new(wheelSide * 5.15, 2.6, 0))
                    * CFrame.Angles(0, math.rad(90), 0.14),
                Color3.fromRGB(64, 47, 36),
                Enum.Material.Wood
            )
            wheel.Shape = Enum.PartType.Cylinder
            for spokeIndex = 1, 4 do
                part(
                    scene,
                    "LostWagonSpoke",
                    Vector3.new(0.28, 4.6, 0.28),
                    wheel.CFrame * CFrame.Angles(math.rad(spokeIndex * 45), 0, 0),
                    Color3.fromRGB(91, 65, 44),
                    Enum.Material.Wood,
                    false
                )
            end
        end
        for shaftSide = -1, 1, 2 do
            part(
                scene,
                "LostWagonShaft",
                Vector3.new(0.52, 0.52, 10),
                CFrame.new(anchor.Position + Vector3.new(shaftSide * 2.5, 1.8, -7.2))
                    * CFrame.Angles(math.rad(5), 0, 0),
                Color3.fromRGB(78, 54, 38),
                Enum.Material.Wood,
                false
            )
        end
        for cargoIndex = -1, 1 do
            part(
                scene,
                "LostWagonCargo",
                Vector3.new(2.7, 2.2, 2.5),
                CFrame.new(anchor.Position + Vector3.new(cargoIndex * 2.5, 5.5, 0.2)),
                if cargoIndex == 0 then Color3.fromRGB(83, 102, 75) else Color3.fromRGB(94, 68, 45),
                if cargoIndex == 0 then Enum.Material.Fabric else Enum.Material.WoodPlanks,
                false
            )
        end
    elseif definition.visual == "hedge" then
        for hedgeIndex = -2, 2 do
            dress(
                extra,
                "mesh_briar_wall_a",
                parent,
                sceneAt + Vector3.new(hedgeIndex * 7, 0, 0),
                1,
                math.pi / 2,
                2610 + hedgeIndex
            )
        end
        part(
            scene,
            "MovingHedge",
            Vector3.new(18, 9, 5),
            CFrame.new(anchor.Position + Vector3.new(0, 4.5, 0)),
            DEEP_GRASS,
            Enum.Material.Grass
        )
        for branchIndex = -3, 3 do
            part(
                scene,
                "MovingHedgeBranch",
                Vector3.new(0.55, 8.5 + math.abs(branchIndex % 2), 0.55),
                CFrame.new(anchor.Position + Vector3.new(branchIndex * 2.7, 4.2, 0.4))
                    * CFrame.Angles(0, 0, math.rad(branchIndex * 7)),
                DARK_BARK,
                Enum.Material.Wood,
                false
            )
            local leaf = orb(
                scene,
                "MovingHedgeCrown",
                anchor.Position + Vector3.new(branchIndex * 2.7, 6 + math.abs(branchIndex % 2), 0),
                2.3 + (math.abs(branchIndex) % 2) * 0.5,
                if branchIndex % 2 == 0 then DEEP_GRASS else MOSS,
                Enum.Material.Grass
            )
            leaf.CanQuery = false
        end
    elseif definition.visual == "root_bridge" then
        dress(extra, "mesh_tangle_bridge_a", parent, sceneAt, 0.9, 1.57, 2570)
        dress(
            extra,
            "mesh_boulder_cluster_a",
            parent,
            sceneAt + Vector3.new(-8, 0, 5),
            0.9,
            0.4,
            2571
        )
        rootArch(scene, anchor.Position, 0.52)
    elseif definition.visual == "pollen_storm" then
        dress(
            extra,
            "mesh_broadleaf_hero_a",
            parent,
            sceneAt + Vector3.new(-8, 0, -5),
            0.85,
            0.9,
            2620
        )
        dress(extra, "mesh_fern_cluster_a", parent, sceneAt + Vector3.new(5, 0, 4), 1.3, 2.1, 2621)
        for moteIndex = 1, 7 do
            local angle = (moteIndex / 7) * math.pi * 2
            local mote = orb(
                scene,
                "PollenStormMote",
                anchor.Position
                    + Vector3.new(math.cos(angle) * 7, 3 + moteIndex % 3, math.sin(angle) * 5),
                0.7,
                Color3.fromRGB(224, 190, 93),
                Enum.Material.SmoothPlastic
            )
            mote.Transparency = 0.28
            mote.CanQuery = false
        end
    elseif definition.visual == "hungry_homestead" then
        dress(
            extra,
            "mesh_crooked_farmhouse_a",
            parent,
            sceneAt + Vector3.new(0, 0, -5),
            0.9,
            0.8,
            2580
        )
        dress(extra, "mesh_creator_barrel_a", parent, sceneAt + Vector3.new(5, 0, 2), 1, 0.3, 2581)
        dress(
            extra,
            "mesh_creator_rustic_fence_a",
            parent,
            sceneAt + Vector3.new(-7, 0, 3),
            1,
            0,
            2582
        )
        part(
            scene,
            "HomesteadPorch",
            Vector3.new(16, 0.7, 9),
            CFrame.new(anchor.Position + Vector3.new(0, 0.35, 1)),
            Color3.fromRGB(104, 72, 45),
            Enum.Material.WoodPlanks
        )
        for side = -1, 1, 2 do
            part(
                scene,
                "HomesteadPost",
                Vector3.new(0.7, 7, 0.7),
                CFrame.new(anchor.Position + Vector3.new(side * 7, 3.5, -3)),
                DARK_BARK,
                Enum.Material.Wood
            )
        end
        part(
            scene,
            "HomesteadRoof",
            Vector3.new(18, 0.7, 11),
            CFrame.new(anchor.Position + Vector3.new(0, 7.2, 1)) * CFrame.Angles(0, 0, math.rad(3)),
            Color3.fromRGB(55, 61, 50),
            Enum.Material.Slate
        )
        part(
            scene,
            "HomesteadBackWall",
            Vector3.new(15.5, 6.8, 0.7),
            CFrame.new(anchor.Position + Vector3.new(0, 3.4, 5)),
            Color3.fromRGB(77, 55, 40),
            Enum.Material.WoodPlanks
        )
        for side = -1, 1, 2 do
            part(
                scene,
                "HomesteadSideWall",
                Vector3.new(0.7, 6.8, 8.5),
                CFrame.new(anchor.Position + Vector3.new(side * 7.5, 3.4, 1)),
                Color3.fromRGB(77, 55, 40),
                Enum.Material.WoodPlanks
            )
            part(
                scene,
                "HomesteadSupplyCrate",
                Vector3.new(2.8, 2.4, 2.7),
                CFrame.new(anchor.Position + Vector3.new(side * 4.9, 1.55, 3.1)),
                Color3.fromRGB(96, 67, 43),
                Enum.Material.WoodPlanks,
                false
            )
        end
        part(
            scene,
            "HomesteadTable",
            Vector3.new(5.8, 0.55, 2.8),
            CFrame.new(anchor.Position + Vector3.new(0, 2.7, 3)),
            Color3.fromRGB(91, 63, 43),
            Enum.Material.WoodPlanks
        )
    elseif definition.visual == "stag_tracks" then
        dress(extra, "mesh_deadfall_a", parent, sceneAt + Vector3.new(6, 0, -4), 1.1, 2.9, 2590)
        dress(
            extra,
            "mesh_conifer_hero_b",
            parent,
            sceneAt + Vector3.new(-9, 0, -6),
            0.8,
            1.2,
            2591
        )
        dress(extra, "mesh_fern_cluster_a", parent, sceneAt + Vector3.new(2, 0, 5), 1.2, 0.5, 2592)
        for side = -1, 1, 2 do
            part(
                scene,
                "WardenTrackAntler",
                Vector3.new(0.6, 6.5, 0.6),
                CFrame.new(anchor.Position + Vector3.new(side * 2.2, 4.2, 4))
                    * CFrame.Angles(0, 0, math.rad(-side * 24)),
                Color3.fromRGB(112, 109, 87),
                Enum.Material.Wood,
                false
            )
        end
        for trackIndex = 1, 5 do
            local track = part(
                scene,
                "WardenTrackPrint",
                Vector3.new(1.1, 0.18, 1.8),
                CFrame.new(
                    anchor.Position
                        + Vector3.new((trackIndex % 2) * 1.8 - 0.9, 0.12, -7 + trackIndex * 2.2)
                )
                    * CFrame.Angles(0, math.rad(-12 + trackIndex * 4), 0),
                Color3.fromRGB(53, 48, 40),
                Enum.Material.Mud,
                false
            )
            track.Shape = Enum.PartType.Ball
        end
    elseif definition.visual == "wildfire_choice" then
        dress(extra, "mesh_creator_campfire_a", parent, sceneAt, 1.4, 0, 2600)
        dress(extra, "mesh_deadfall_a", parent, sceneAt + Vector3.new(-7, 0, 4), 1.2, 1.1, 2601)
        dress(
            extra,
            "mesh_boulder_cluster_a",
            parent,
            sceneAt + Vector3.new(7, 0, 3),
            0.9,
            2.4,
            2602
        )
        for side = -1, 1, 2 do
            local flame = orb(
                scene,
                "WildfireFront",
                anchor.Position + Vector3.new(side * 8, 2.2, 4),
                2.6,
                Color3.fromRGB(232, 105, 57),
                Enum.Material.Neon
            )
            flame.Transparency = 0.12
            flame.CanQuery = false
            part(
                scene,
                "CharredSapling",
                Vector3.new(0.7, 6, 0.7),
                CFrame.new(anchor.Position + Vector3.new(side * 8, 2.8, 6))
                    * CFrame.Angles(0, 0, math.rad(side * 12)),
                Color3.fromRGB(43, 37, 34),
                Enum.Material.Wood,
                false
            )
        end
    end

    local interactions = {}
    for index, step in definition.steps do
        local offset = step.offset
        local position = anchor.Position + Vector3.new(offset.x, offset.y, offset.z)
        local target: Part
        if definition.visual == "foxlight" then
            target = orb(scene, "Foxlight_" .. step.id, position, 2.2, FOXFIRE, Enum.Material.Neon)
            target.Transparency = 0.16
            light(target, FOXFIRE, 1.1, 14)
            part(
                scene,
                "FoxlightStem_" .. step.id,
                Vector3.new(0.35, 2.2, 0.35),
                CFrame.new(position - Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, 0, math.rad(12)),
                DARK_BARK,
                Enum.Material.Wood,
                false
            )
        elseif definition.visual == "root_bridge" then
            target = orb(scene, "RootKnot_" .. step.id, position, 2.7, AMBER, Enum.Material.Wood)
            target.Shape = Enum.PartType.Cylinder
            target.CFrame *= CFrame.Angles(0, 0, math.rad(90))
            target.Size = Vector3.new(1.5, 2.7, 1.5)
            for rootIndex = -1, 1 do
                part(
                    scene,
                    "RootBridgeBranch_" .. step.id,
                    Vector3.new(0.45, 2.8, 0.45),
                    CFrame.new(position + Vector3.new(rootIndex * 0.8, 0.4, 0.8))
                        * CFrame.Angles(math.rad(34), 0, math.rad(rootIndex * 18)),
                    BARK,
                    Enum.Material.Wood,
                    false
                )
            end
        elseif definition.visual == "wagon" then
            target = part(
                scene,
                "WagonBrace_" .. step.id,
                Vector3.new(2.8, 1.4, 2.8),
                CFrame.new(position) * CFrame.Angles(0, index * 0.55, math.rad(8)),
                AMBER,
                Enum.Material.WoodPlanks,
                false
            )
        elseif definition.visual == "pollen_storm" then
            target = part(
                scene,
                "PollenScreen_" .. step.id,
                Vector3.new(4.2, 5.2, 0.45),
                CFrame.new(position) * CFrame.Angles(0, index * 0.18 - 0.36, 0),
                Color3.fromRGB(171, 148, 86),
                Enum.Material.Fabric,
                false
            )
            for postSide = -1, 1, 2 do
                part(
                    scene,
                    "PollenScreenPost_" .. step.id,
                    Vector3.new(0.35, 5.8, 0.35),
                    target.CFrame * CFrame.new(postSide * 2.2, 0, 0),
                    DARK_BARK,
                    Enum.Material.Wood,
                    false
                )
            end
        elseif definition.visual == "hungry_homestead" then
            target = part(
                scene,
                "HomesteadStore_" .. step.id,
                if step.id == "fill_water"
                    then Vector3.new(2.7, 3.4, 2.7)
                    else Vector3.new(3.6, 2.5, 3.2),
                CFrame.new(position) * CFrame.Angles(0, index * 0.42, 0),
                if step.id == "fill_water"
                    then Color3.fromRGB(76, 104, 105)
                    else Color3.fromRGB(116, 81, 48),
                if step.id == "fill_water" then Enum.Material.Metal else Enum.Material.WoodPlanks,
                false
            )
            if step.id == "fill_water" then
                target.Shape = Enum.PartType.Cylinder
            end
        elseif definition.visual == "stag_tracks" then
            target = part(
                scene,
                "WardenSign_" .. step.id,
                if step.id == "study_scrape"
                    then Vector3.new(1.1, 4.2, 1.1)
                    else Vector3.new(3.8, 0.45, 2.8),
                CFrame.new(position)
                    * CFrame.Angles(0, index * 0.3, if step.id == "study_scrape" then 0 else 0.08),
                Color3.fromRGB(102, 91, 69),
                if step.id == "study_scrape" then Enum.Material.Wood else Enum.Material.Ground,
                false
            )
            if step.id ~= "study_scrape" then
                target.Shape = Enum.PartType.Ball
            end
        elseif definition.visual == "wildfire_choice" then
            target = part(
                scene,
                "WetFirebreak_" .. step.id,
                Vector3.new(4.8, 1.2, 3.4),
                CFrame.new(position) * CFrame.Angles(0, index * 0.28, 0),
                Color3.fromRGB(96, 79, 59),
                Enum.Material.Mud,
                false
            )
            target.Shape = Enum.PartType.Ball
        else
            target = part(
                scene,
                "HedgeLatch_" .. step.id,
                Vector3.new(1.4, 3.2, 1.4),
                CFrame.new(position) * CFrame.Angles(0, 0, math.rad(index * 8 - 16)),
                AMBER,
                Enum.Material.WoodPlanks,
                false
            )
        end
        target.CastShadow = false
        objectIcon(target, "step", AMBER)
        target:SetAttribute("EventId", definition.id)
        target:SetAttribute("EventStepId", step.id)
        target:SetAttribute("EventStepState", "available")
        CollectionService:AddTag(target, runtimeIds.ExpeditionEventStepTag)
        table.insert(interactions, {
            actionText = step.actionText,
            eventId = definition.id,
            interactionId = runtimeIds.eventInteractionId(definition.id, step.id),
            objectText = step.objectText,
            stepId = step.id,
            target = target,
        })
    end

    local physicalParts = 0
    for _, descendant in scene:GetDescendants() do
        if descendant:IsA("BasePart") then
            physicalParts += 1
        end
    end
    scene:SetAttribute("PhysicalPartCount", physicalParts)

    return {
        interactions = interactions,
        socket = anchor,
    }
end

--[[
    The forest Bramblewake stands in.

    This used to be a mist plane and thirty-six pillars on a fixed radius
    around the average module position, and it had two problems that together
    made the region read as platforms in a void.

    The pillars were rotated by `CFrame.Angles(lean, 0, -angle)`, which spends
    the ring angle on roll instead of yaw. A pillar a quarter of the way round
    the ring lay flat; one halfway round stood upside down. What should have
    been a treeline was a spray of slabs across the sky.

    And nothing held the ground. Each module carried its own patch, so beyond
    the route there was no floor at all -- the edge of the last patch was the
    edge of the world, with sky underneath it.

    So the floor now spans the whole route with a wide margin, and the trees
    are placed by distance from the route's own bounds rather than from a
    guessed centre, thickening as they go out until the far rank closes the
    horizon. Nothing here is interactive or collidable: it exists to be the
    reason you cannot see the edge.
]]
local function buildBackdrop(parent: Instance, centers: { Vector3 }, extra: { any })
    local folder = Instance.new("Folder")
    folder.Name = "RegionalBackdrop"
    folder.Parent = parent

    local low = centers[1]
    local high = centers[1]
    for _, center in centers do
        low = Vector3.new(math.min(low.X, center.X), 0, math.min(low.Z, center.Z))
        high = Vector3.new(math.max(high.X, center.X), 0, math.max(high.Z, center.Z))
    end
    local middle = (low + high) / 2
    local span = high - low
    local reach = math.max(span.X, span.Z) / 2 + 120

    -- One floor under everything. Sized well past the outermost module so the
    -- route never reaches its edge, and low enough that the per-module ground
    -- patches still read as the path over it.
    --
    -- This is a safety net, not scenery: it is the only thing standing
    -- between a player who steps past a module's own collision footprint and
    -- FallenPartsDestroyHeight. It must collide. The `false` this originally
    -- shipped with was meant for CanQuery two lines down and landed on the
    -- wrong parameter instead, so the one floor built to stop Bramblewake
    -- from having a bottomless edge did not have one.
    local floorSpan = (reach + 420) * 2
    local groundFloor = part(
        folder,
        "BramblewakeForestFloor",
        Vector3.new(floorSpan, 4, floorSpan),
        CFrame.new(middle - Vector3.new(0, 2.1, 0)),
        Color3.fromRGB(31, 38, 30),
        Enum.Material.Ground
    )
    groundFloor.CanQuery = false

    local function backdropTree(
        at: Vector3,
        height: number,
        width: number,
        shade: number,
        seed: number
    )
        local lean = math.rad(((seed % 7) - 3) * 1.6)
        local trunk = part(
            folder,
            "BackdropTrunk",
            Vector3.new(width, height, width),
            CFrame.new(at + Vector3.new(0, height / 2, 0))
                * CFrame.Angles(lean, (seed % 360) * 0.0175, lean * 0.6),
            Color3.fromRGB(math.floor(34 * shade), math.floor(30 * shade), math.floor(26 * shade)),
            Enum.Material.Wood,
            false
        )
        trunk.CanQuery = false
        local canopy = part(
            folder,
            "BackdropCanopy",
            -- Narrower and set higher: a ball nearly five trunks wide sitting
            -- at shoulder height is a bush; a crown riding a visible trunk is
            -- a tree.
            Vector3.new(width * 3.4, height * 0.6, width * 3.4),
            CFrame.new(at + Vector3.new(0, height * 0.95, 0))
                * CFrame.Angles(lean, (seed % 211) * 0.021, 0),
            Color3.fromRGB(math.floor(38 * shade), math.floor(58 * shade), math.floor(41 * shade)),
            Enum.Material.Grass,
            false
        )
        canopy.CanQuery = false
        canopy.Shape = Enum.PartType.Ball
    end

    -- Four ranks. The near one is sparse enough to walk toward and see
    -- through; each one out is denser, darker and taller, so the horizon
    -- closes gradually rather than ending at a wall.
    --[[
        The owner's tablet run read the old near rank as "so many bushes":
        34 ball canopies at reach+40, plus the hero ring, packed into one
        hedge the route ran straight at. The near rank now stands further
        off and thinner, so the forest frames the route instead of crowding
        it -- density still climbs with distance, just starting politely.
    ]]
    local ranks = {
        { radius = reach + 72, count = 20, height = 46, width = 4.2, shade = 1.0 },
        { radius = reach + 150, count = 40, height = 62, width = 5.0, shade = 0.86 },
        { radius = reach + 250, count = 56, height = 84, width = 6.0, shade = 0.7 },
        { radius = reach + 360, count = 66, height = 108, width = 7.2, shade = 0.56 },
    }
    for rankIndex, rank in ranks do
        for index = 1, rank.count do
            local angle = (index / rank.count) * math.pi * 2 + rankIndex * 0.21
            local jitter = ((index * 37 + rankIndex * 11) % 23) - 11
            local radius = rank.radius + jitter * 2.4
            local at = middle + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
            backdropTree(
                at,
                rank.height + ((index % 5) - 2) * 6,
                rank.width,
                rank.shade,
                index * 13 + rankIndex * 7
            )
        end
    end

    -- Authored trees only where a player can actually get close enough to
    -- read one. Past the first rank the silhouette is all that survives, and
    -- a mesh costs the same there as it does underfoot.
    local heroes = { "mesh_conifer_hero_a", "mesh_conifer_hero_b", "mesh_broadleaf_hero_a" }
    for index = 1, 14 do
        local angle = (index / 14) * math.pi * 2 + 0.4
        local radius = reach + 12 + ((index * 29) % 56)
        dress(
            extra,
            heroes[(index % #heroes) + 1],
            folder,
            middle + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius),
            1 + ((index % 4) * 0.12),
            angle + math.rad((index % 9) * 7),
            9600 + index
        )
    end

    -- A few sap lights deep in the trees, so the dark past the route reads as
    -- somewhere rather than as nothing.
    for index = 1, 7 do
        local angle = (index / 7) * math.pi * 2 + 1.1
        local radius = reach + 150 + (index % 3) * 60
        local glow = orb(
            folder,
            "DistantSapGlow",
            middle
                + Vector3.new(
                    math.cos(angle) * radius,
                    16 + (index % 4) * 7,
                    math.sin(angle) * radius
                ),
            2.6,
            FOXFIRE,
            Enum.Material.Neon
        )
        glow.Transparency = 0.52
        glow.CanQuery = false
        glow.CastShadow = false
    end
end

local function isOccupied(center: Vector3, centers: { Vector3 }): boolean
    for _, existing in centers do
        if (existing - center).Magnitude < 1 then
            return true
        end
    end
    return false
end

local function annexCenter(
    oldGrowthCenter: Vector3,
    centers: { Vector3 },
    cellSize: number
): Vector3
    for _, direction in
        {
            Vector3.new(1, 0, 0),
            Vector3.new(0, 0, 1),
            Vector3.new(-1, 0, 0),
            Vector3.new(0, 0, -1),
        }
    do
        local candidate = oldGrowthCenter + direction * cellSize
        if not isOccupied(candidate, centers) then
            return candidate
        end
    end
    error("Old Growth has no free neighbor for the Warden's Seal")
end

local function buildWardenSeal(
    parent: Instance,
    oldGrowthCenter: Vector3,
    centers: { Vector3 },
    cellSize: number,
    runtimeIds: any
): any
    local center = annexCenter(oldGrowthCenter, centers, cellSize)
    local arena = Instance.new("Model")
    arena.Name = "WardenSealAnnex"
    arena:SetAttribute("BossId", "boss_warden_stag")
    arena:SetAttribute("ContentId", "arena_bw_warden_seal")
    arena.Parent = parent
    pcall(function()
        arena.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    end)

    pathArm(arena, oldGrowthCenter, center)
    pathArm(arena, center, oldGrowthCenter)
    part(
        arena,
        "WardenSealGround",
        Vector3.new(66, 5, 66),
        CFrame.new(center + Vector3.new(0, -2.5, 0)),
        Color3.fromRGB(38, 68, 48),
        Enum.Material.Grass
    )
    part(
        arena,
        "MemorySeal",
        Vector3.new(38, 1.1, 38),
        CFrame.new(center + Vector3.new(0, 0.15, 0)),
        STONE,
        Enum.Material.Slate
    )

    local seal = orb(
        arena,
        "WardenMemorySeal",
        center + Vector3.new(0, 1.5, 0),
        7,
        Color3.fromRGB(87, 119, 101),
        Enum.Material.Glass
    )
    seal.Shape = Enum.PartType.Cylinder
    seal.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    seal.Size = Vector3.new(1.2, 7, 7)
    seal.Transparency = 0.52
    billboard(seal, "WARDEN'S SEAL · CLEANSE OLD GROWTH", CREAM)
    objectIcon(seal, "seal", FOXFIRE)

    local nodeDefinitions = {
        {
            direction = Vector3.new(0, 0, -1),
            interactionId = runtimeIds.InteractionIds.WardenStagRootNorth,
            nodeId = "root_node_north",
            suffix = "North",
        },
        {
            direction = Vector3.new(1, 0, 0),
            interactionId = runtimeIds.InteractionIds.WardenStagRootEast,
            nodeId = "root_node_east",
            suffix = "East",
        },
        {
            direction = Vector3.new(0, 0, 1),
            interactionId = runtimeIds.InteractionIds.WardenStagRootSouth,
            nodeId = "root_node_south",
            suffix = "South",
        },
        {
            direction = Vector3.new(-1, 0, 0),
            interactionId = runtimeIds.InteractionIds.WardenStagRootWest,
            nodeId = "root_node_west",
            suffix = "West",
        },
    }
    local nodes = {}
    local interactions = {}
    for _, definition in nodeDefinitions do
        local node = orb(
            arena,
            "LivingRootNode" .. definition.suffix,
            center + definition.direction * 22 + Vector3.new(0, 3, 0),
            1.45,
            Color3.fromRGB(80, 116, 83),
            Enum.Material.Glass
        )
        node.Shape = Enum.PartType.Cylinder
        node.CFrame *= CFrame.Angles(0, 0, math.rad(90))
        node.Size = Vector3.new(1.2, 2.7, 1.2)
        node.Transparency = 0.34
        livingRootShell(arena, node.Position, 0.92, "Warden" .. definition.suffix)
        node:SetAttribute("BossId", "boss_warden_stag")
        node:SetAttribute("BossInteraction", "cleanse_root")
        node:SetAttribute("BossNodeId", definition.nodeId)
        CollectionService:AddTag(node, runtimeIds.ExpeditionBossTag)
        billboard(node, string.upper(string.gsub(definition.nodeId, "_", " ")), CREAM)
        objectIcon(node, "root", FOXFIRE)
        nodes[definition.nodeId] = node
        table.insert(interactions, {
            actionText = "CLEANSE ROOT",
            holdDuration = 0.6,
            interactionId = definition.interactionId,
            objectText = "Living Root Node",
            target = node,
        })
    end

    local antlers = {}
    for _, definition in
        {
            {
                antlerId = "antler_left",
                interactionId = runtimeIds.InteractionIds.WardenStagAntlerLeft,
                side = -1,
            },
            {
                antlerId = "antler_right",
                interactionId = runtimeIds.InteractionIds.WardenStagAntlerRight,
                side = 1,
            },
        }
    do
        local target = part(
            arena,
            if definition.side < 0 then "MemoryAntlerLeft" else "MemoryAntlerRight",
            Vector3.new(2.2, 9, 2.2),
            CFrame.new(center + Vector3.new(definition.side * 12, 4.5, 8))
                * CFrame.Angles(0, 0, math.rad(definition.side * 24)),
            Color3.fromRGB(194, 199, 173),
            Enum.Material.Wood,
            false
        )
        target.Transparency = 0.2
        for tineIndex = 1, 3 do
            part(
                arena,
                "MemoryAntlerTine",
                Vector3.new(0.7, 3.1 - tineIndex * 0.35, 0.7),
                target.CFrame
                    * CFrame.new(
                        definition.side * (0.75 + tineIndex * 0.18),
                        1.1 + tineIndex * 1.65,
                        0
                    )
                    * CFrame.Angles(0, 0, math.rad(-definition.side * (42 + tineIndex * 4))),
                Color3.fromRGB(151, 148, 125),
                Enum.Material.Wood,
                false
            )
        end
        target:SetAttribute("BossId", "boss_warden_stag")
        target:SetAttribute("BossInteraction", "break_antler")
        target:SetAttribute("BossAntlerId", definition.antlerId)
        CollectionService:AddTag(target, runtimeIds.ExpeditionBossTag)
        billboard(target, "BREAK ANTLER · CHANGES FOREST", Color3.fromRGB(255, 166, 106))
        objectIcon(target, "antler", Color3.fromRGB(255, 166, 106))
        antlers[definition.antlerId] = target
        table.insert(interactions, {
            actionText = "BREAK ANTLER",
            holdDuration = 1.1,
            interactionId = definition.interactionId,
            objectText = "Harmful Shortcut",
            target = target,
        })
    end

    for index = 1, 10 do
        local angle = (index / 10) * math.pi * 2
        if math.abs(math.sin(angle)) > 0.32 then
            part(
                arena,
                "SealRootPillar",
                Vector3.new(3, 18 + (index % 3) * 4, 3),
                CFrame.new(
                    center
                        + Vector3.new(
                            math.cos(angle) * 31,
                            8 + (index % 3) * 2,
                            math.sin(angle) * 31
                        )
                ) * CFrame.Angles(math.rad(9), 0, -angle),
                if index % 2 == 0 then BARK else DARK_BARK,
                Enum.Material.Wood
            )
        end
    end
    for side = -1, 1, 2 do
        tree(arena, center + Vector3.new(side * 27, 0, -27), 1.25)
    end

    return {
        antlers = antlers,
        center = center,
        interactions = interactions,
        model = arena,
        nodes = nodes,
        seal = seal,
    }
end

local function buildBlackoutLayer(
    parent: Instance,
    centers: { Vector3 },
    bossCenter: Vector3,
    runtimeIds: any
): any
    local layer = Instance.new("Model")
    layer.Name = "BramblewakeBlackoutLayer"
    layer:SetAttribute("BlackoutId", "blackout_bramblewake")
    layer:SetAttribute("ContentId", "blackout_bw_rootfire_relay")
    layer.Parent = parent
    pcall(function()
        layer.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    end)

    local sourceCenter = assert(centers[1], "Blackout fire source center is missing")
    local fireSource = orb(
        layer,
        "BlackoutLanternFire",
        sourceCenter + Vector3.new(13, 4, 13),
        5,
        Color3.fromRGB(94, 83, 64),
        Enum.Material.SmoothPlastic
    )
    fireSource.Shape = Enum.PartType.Cylinder
    fireSource.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    fireSource.Size = Vector3.new(2.2, 4.8, 2.2)
    fireSource.Color = DARK_BARK
    fireSource.Material = Enum.Material.Wood
    local sourceFlame = orb(
        layer,
        "BlackoutLanternFlame",
        fireSource.Position + Vector3.new(0, 2.7, 0),
        2.1,
        AMBER,
        Enum.Material.Neon
    )
    cagedLanternShell(layer, sourceFlame.Position, 0.78, "BlackoutLantern")
    light(sourceFlame, AMBER, 1.8, 16, true)
    fireSource:SetAttribute("BlackoutInteraction", "take_fire")
    CollectionService:AddTag(fireSource, runtimeIds.ExpeditionBlackoutTag)
    billboard(fireSource, "BLACKOUT FIRE · CARRY TO LIVING ROOTS", CREAM)
    objectIcon(fireSource, "rootfire", AMBER)

    local interactions = {
        {
            actionText = "TAKE ROOTFIRE",
            holdDuration = 0.45,
            interactionId = runtimeIds.InteractionIds.BlackoutFireSource,
            objectText = "Blackout Lantern",
            target = fireSource,
        },
    }
    local relayNodes = {}
    for _, definition in
        {
            {
                center = assert(centers[3], "Blackout farm relay center is missing"),
                interactionId = runtimeIds.InteractionIds.BlackoutRootFarm,
                label = "FARM ROOT",
                nodeId = "blackout_root_farm",
            },
            {
                center = assert(centers[7], "Blackout mill relay center is missing"),
                interactionId = runtimeIds.InteractionIds.BlackoutRootMill,
                label = "MILL ROOT",
                nodeId = "blackout_root_mill",
            },
            {
                center = assert(centers[10], "Blackout cathedral relay center is missing"),
                interactionId = runtimeIds.InteractionIds.BlackoutRootCathedral,
                label = "CATHEDRAL ROOT",
                nodeId = "blackout_root_cathedral",
            },
        }
    do
        local node = orb(
            layer,
            "BlackoutRelay_" .. definition.label,
            definition.center + Vector3.new(-14, 3.5, -12),
            6,
            Color3.fromRGB(70, 91, 72),
            Enum.Material.SmoothPlastic
        )
        node.Shape = Enum.PartType.Cylinder
        node.CFrame *= CFrame.Angles(0, 0, math.rad(90))
        node.Size = Vector3.new(2.4, 5.8, 2.4)
        node.Color = DARK_BARK
        node.Material = Enum.Material.Wood
        local relayCore = orb(
            layer,
            "BlackoutRelayCore_" .. definition.label,
            node.Position + Vector3.new(0, 3.2, 0),
            1.8,
            FOXFIRE,
            Enum.Material.Neon
        )
        light(relayCore, FOXFIRE, 1.1, 12)
        node:SetAttribute("BlackoutInteraction", "deliver_fire")
        node:SetAttribute("BlackoutNodeId", definition.nodeId)
        CollectionService:AddTag(node, runtimeIds.ExpeditionBlackoutTag)
        billboard(node, definition.label .. " · NEEDS CARRIED FIRE", CREAM)
        objectIcon(node, "livingroot", FOXFIRE)
        relayNodes[definition.nodeId] = node
        table.insert(interactions, {
            actionText = "DELIVER ROOTFIRE",
            holdDuration = 0.7,
            interactionId = definition.interactionId,
            objectText = definition.label,
            target = node,
        })

        for rootIndex = -1, 1 do
            local rootedWall = part(
                layer,
                "RootedWall",
                Vector3.new(3.5, 14 + (rootIndex + 1) * 2, 3.5),
                CFrame.new(node.Position + Vector3.new(rootIndex * 5.5, 5 + (rootIndex + 1), 4.5))
                    * CFrame.Angles(math.rad(rootIndex * 8), 0, math.rad(rootIndex * 10)),
                DARK_BARK,
                Enum.Material.Wood,
                true
            )
            rootedWall:SetAttribute("BlackoutNodeId", definition.nodeId)
        end
    end

    local decisions = {}
    for _, definition in
        {
            {
                color = MEADOW,
                decisionId = "restore_farmland",
                interactionId = runtimeIds.InteractionIds.BlackoutDecisionFarmland,
                label = "RESTORE FARMLAND",
                offset = Vector3.new(-16, 2.5, 16),
            },
            {
                color = Color3.fromRGB(71, 139, 84),
                decisionId = "wild_regrowth",
                interactionId = runtimeIds.InteractionIds.BlackoutDecisionWild,
                label = "ALLOW WILD REGROWTH",
                offset = Vector3.new(0, 2.5, 20),
            },
            {
                color = FOXFIRE,
                decisionId = "shared_agroforest",
                interactionId = runtimeIds.InteractionIds.BlackoutDecisionShared,
                label = "CREATE SHARED AGROFOREST",
                offset = Vector3.new(16, 2.5, 16),
            },
        }
    do
        local shrineCenter = bossCenter + Vector3.new(definition.offset.X, 0, definition.offset.Z)
        local seedling =
            chapterChoiceShrine(layer, shrineCenter, definition.color, definition.decisionId)
        seedling.Transparency = 0.58
        seedling:SetAttribute("BlackoutInteraction", "chapter_decision")
        seedling:SetAttribute("BlackoutDecisionId", definition.decisionId)
        CollectionService:AddTag(seedling, runtimeIds.ExpeditionBlackoutTag)
        billboard(seedling, definition.label, CREAM)
        decisions[definition.decisionId] = seedling
        table.insert(interactions, {
            actionText = "VOTE " .. definition.label,
            holdDuration = 1.1,
            interactionId = definition.interactionId,
            objectText = "Permanent Greenward Choice",
            target = seedling,
        })
    end

    return {
        decisions = decisions,
        fireSource = fireSource,
        interactions = interactions,
        model = layer,
        relayNodes = relayNodes,
    }
end

--[[
    Harvestable resource nodes along the route.

    Bramblewake previously had no gather nodes of any kind: Heartwood and
    Amber Sap existed as materials, as crafting inputs, and as elite and boss
    rewards, but there was nothing in the world to harvest. A player walking
    the route had no way to find either, because neither was there.

    Two per module from the second module onward, alternating material and
    offset to either side of the road, so the route always has something
    visible to walk toward and the reason to travel is on the path rather than
    only at the far end. Each carries a lantern-amber or foxfire glow so it
    reads at distance in Blackout lighting, and a billboard naming what it is.
]]
local function buildResourceNodes(
    module: Instance,
    center: Vector3,
    moduleIndex: number,
    runtimeIds: any,
    nodes: { any },
    meshPlacements: { any }
)
    if moduleIndex < 2 then
        return
    end
    for slot = 1, 2 do
        local isSap = (moduleIndex + slot) % 2 == 0
        local side = if slot == 1 then -1 else 1
        local at = center + Vector3.new(side * (15 + (moduleIndex % 3) * 2), 0, (slot - 1.5) * 18)
        local nodeId = string.format("node_bw_%d_%d", moduleIndex, slot)

        local anchor = part(
            module,
            if isSap then "AmberSapNode" else "HeartwoodNode",
            Vector3.new(5, 7, 5),
            CFrame.new(at + Vector3.new(0, 3.5, 0)),
            if isSap then Color3.fromRGB(196, 142, 58) else Color3.fromRGB(96, 68, 46),
            Enum.Material.Wood
        )
        anchor.Transparency = 1
        anchor.CanCollide = false

        --[[
            Small and quiet on purpose. At 1.15 studs and 0.62 transparency,
            five of these in one camera frame read as a row of blinding
            yellow orbs brighter than any actual objective -- the owner's
            tablet screenshot showed exactly that. A resource cue should be
            findable when looked for, not the loudest thing on screen.
        ]]
        local glow = part(
            module,
            "ResourceGlow",
            Vector3.new(0.7, 0.7, 0.7),
            CFrame.new(at + Vector3.new(0, 3.2, 0)),
            if isSap then Color3.fromRGB(255, 186, 84) else Color3.fromRGB(120, 214, 178),
            Enum.Material.Neon,
            false
        )
        glow.Shape = Enum.PartType.Ball
        glow.Transparency = 0.8
        glow.CastShadow = false
        light(glow, glow.Color, 0.4, 12)
        CollectionService:AddTag(glow, runtimeIds.AmbientLightTag)

        table.insert(meshPlacements, {
            assetId = if isSap then "mesh_amber_sap_node_a" else "mesh_heartwood_stump_a",
            fallbackKind = "asset_replacement",
            position = at,
            scale = 1,
            yaw = math.rad((moduleIndex * 37 + slot * 61) % 360),
            seed = 11200 + moduleIndex * 10 + slot,
            swayTag = nil,
            parent = module,
            fallbackInstance = nil,
        })

        table.insert(nodes, {
            target = anchor,
            interactionId = nodeId,
            materialId = if isSap then "material_amber_sap" else "material_heartwood",
            objectText = if isSap then "Amber Sap" else "Heartwood",
        })
    end
end

function BramblewakeBuilder.build(
    parent: Instance,
    manifest: any,
    generator: any,
    catalog: any,
    runtimeIds: any
): any
    local existing = parent:FindFirstChild("BramblewakeExpedition")
    if existing ~= nil then
        existing:Destroy()
    end

    local expedition = Instance.new("Model")
    expedition.Name = "BramblewakeExpedition"
    expedition:SetAttribute("RegionId", manifest.regionId)
    expedition:SetAttribute("ManifestHash", manifest.hash)
    expedition:SetAttribute("Seed", manifest.seed)
    expedition:SetAttribute("Source", manifest.source)
    expedition:SetAttribute("Ready", false)
    expedition.Parent = parent

    local centers: { Vector3 } = {}
    local eventInteractions = {}
    local eventSockets: { [string]: BasePart } = {}
    local storyLandmarkCount = 0
    local storyLandmarkPartCount = 0
    local eliteArena = nil
    local oldGrowthCenter: Vector3? = nil
    local extractionTarget: BasePart? = nil
    local meshPlacements = {}
    local resourceNodes = {}
    for _, placement in manifest.modules do
        centers[placement.index] = ORIGIN
            + Vector3.new(placement.cellX * catalog.CellSize, 0, placement.cellZ * catalog.CellSize)
    end

    for _, placement in manifest.modules do
        local definition = generator.moduleDefinition(placement.moduleId)
        local center = centers[placement.index]
        local module = Instance.new("Model")
        module.Name = string.format("Module_%02d", placement.index)
        module:SetAttribute("ContentId", placement.moduleId)
        module:SetAttribute("DisplayName", definition.displayName)
        module:SetAttribute("SequenceIndex", placement.index)
        module:SetAttribute("CellX", placement.cellX)
        module:SetAttribute("CellZ", placement.cellZ)
        module.Parent = expedition
        pcall(function()
            module.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
        end)
        CollectionService:AddTag(module, runtimeIds.ExpeditionModuleTag)

        local cell = part(
            module,
            "StreamingCellCollision",
            Vector3.new(catalog.CellSize, 5, catalog.CellSize),
            CFrame.new(center + Vector3.new(0, -2.5, 0)),
            if placement.index % 2 == 0 then GRASS else Color3.fromRGB(43, 72, 49),
            Enum.Material.LeafyGrass
        )
        surfaceGrain(cell, Color3.fromRGB(23, 38, 31), 0.82)
        local clearing = part(
            module,
            "PathClearing",
            Vector3.new(26, 0.55, 26),
            CFrame.new(center + Vector3.new(0, 0.25, 0)),
            WET_EARTH,
            Enum.Material.Mud
        )
        clearing.Reflectance = 0.03
        if placement.index > 1 then
            pathArm(module, center, centers[placement.index - 1])
        end
        if placement.index < #manifest.modules then
            pathArm(module, center, centers[placement.index + 1])
            wayfindingTrail(
                module,
                center,
                centers[placement.index + 1],
                runtimeIds.AmbientLightTag
            )
            if placement.index % 2 == 1 then
                evacuationRoadMarker(module, center, centers[placement.index + 1], placement.index)
            end
        end

        moduleDressing(
            module,
            center,
            manifest.seed + placement.index * 97,
            runtimeIds,
            definition.role == "arrival"
        )

        for cornerIndex = 1, 4 do
            local x = if cornerIndex == 1 or cornerIndex == 4 then -27 else 27
            local z = if cornerIndex <= 2 then -27 else 27
            tree(module, center + Vector3.new(x, 0, z), 0.62 + (cornerIndex % 2) * 0.08)
        end
        buildResourceNodes(
            module,
            center,
            placement.index,
            runtimeIds,
            resourceNodes,
            meshPlacements
        )
        local moduleDressingExtra = {}
        -- The yaw of the road as it reaches this module, taken from the
        -- module before it. The first module has nothing behind it, so it
        -- borrows the direction of the one ahead. Gates are built to this so
        -- a player walks through them rather than past their edge.
        local previous = centers[placement.index - 1]
        local ahead = centers[placement.index + 1]
        local along = if previous ~= nil
            then center - previous
            elseif ahead ~= nil then ahead - center
            else Vector3.new(0, 0, 1)
        local facing = if along.Magnitude > 0.01 then math.atan2(along.X, along.Z) else 0
        local meshPlacement = buildModuleVisual(
            module,
            definition.visual,
            center,
            runtimeIds,
            moduleDressingExtra,
            facing
        )
        if meshPlacement ~= nil then
            table.insert(meshPlacements, meshPlacement)
        end
        for _, placementExtra in moduleDressingExtra do
            table.insert(meshPlacements, placementExtra)
        end
        if
            type(definition.storyLandmark) == "string"
            and type(definition.storyTitle) == "string"
        then
            local landmarkParts = buildStoryLandmark(
                module,
                center,
                definition.storyLandmark,
                definition.storyTitle,
                definition.storyOffset,
                meshPlacements
            )
            assert(
                landmarkParts == definition.storyPartCount,
                "Bramblewake story landmark exceeded its authored part count"
            )
            storyLandmarkCount += 1
            storyLandmarkPartCount += landmarkParts
        end
        if definition.eliteId == "elite_old_growth" then
            oldGrowthCenter = center
            local fireSource = orb(
                module,
                "OldGrowthFireSource",
                center + Vector3.new(-20, 3.4, -12),
                1.35,
                AMBER,
                Enum.Material.Glass
            )
            fireSource.Transparency = 0.48
            cagedLanternShell(module, fireSource.Position, 0.86, "OldGrowthLantern")
            fireSource:SetAttribute("EliteId", definition.eliteId)
            fireSource:SetAttribute("EliteInteraction", "fire_source")
            billboard(fireSource, "LANTERN FIRE", CREAM)
            objectIcon(fireSource, "rootfire", AMBER)

            local rootHeart = orb(
                module,
                "OldGrowthRootHeart",
                center + Vector3.new(20, 4.2, 12),
                1.6,
                FOXFIRE,
                Enum.Material.Glass
            )
            rootHeart.Transparency = 0.56
            livingRootShell(module, rootHeart.Position, 1.08, "OldGrowthHeart")
            rootHeart:SetAttribute("EliteId", definition.eliteId)
            rootHeart:SetAttribute("EliteInteraction", "root_heart")
            billboard(rootHeart, "ROOT HEART", CREAM)
            objectIcon(rootHeart, "root", FOXFIRE)
            CollectionService:AddTag(fireSource, runtimeIds.ExpeditionEliteTag)
            CollectionService:AddTag(rootHeart, runtimeIds.ExpeditionEliteTag)
            eliteArena = {
                center = center,
                fireSource = fireSource,
                rootHeart = rootHeart,
            }
            queueItemAsset(
                meshPlacements,
                fireSource,
                "mesh_creator_kerosene_lantern_a",
                1.15,
                5200 + placement.index,
                math.rad(12),
                fireSource.Position.Y - 2.1
            )
            queueItemAsset(
                meshPlacements,
                rootHeart,
                "mesh_snapvine_a",
                1.05,
                5300 + placement.index,
                math.rad(-16),
                rootHeart.Position.Y - 2.35
            )
        end
        if definition.role == "extraction" then
            local target = module:FindFirstChild("WayhomeLight")
            assert(
                target ~= nil and target:IsA("BasePart"),
                "Wayhome Gate is missing its extraction target"
            )
            target:SetAttribute("ContentId", placement.moduleId)
            target:SetAttribute("ExtractionId", "extraction_bw_wayhome")
            CollectionService:AddTag(target, runtimeIds.ExpeditionExtractionTag)
            extractionTarget = target
            destinationCairns(module, target.Position, AMBER, 7)
        end

        if placement.poiId ~= nil then
            local poiMemory = buildPointOfInterest(
                module,
                center,
                generator.pointOfInterestDefinition(placement.poiId),
                runtimeIds,
                meshPlacements
            )
            queueItemAsset(
                meshPlacements,
                poiMemory,
                "mesh_creator_kerosene_lantern_a",
                0.95,
                5400 + placement.index,
                math.rad((placement.index % 3 - 1) * 9),
                poiMemory.Position.Y - 1.35
            )
        end

        --[[
            A module can host a point of interest AND an event. This used to be
            an `elseif` on the branch above, so whenever the generator put both
            on one module the POI won and the event was dropped on the floor --
            silently, because ExpeditionService still counts events from the
            manifest and reported eight of them with twenty-five interaction
            steps while the world held five and sixteen.

            On the preview seed that lost three of the eight events outright:
            stag tracks, the moving hedge, and the root bridge, on modules 5, 9
            and 11. Better than a third of Bramblewake's authored event content
            never spawned, and no check caught it because the count the service
            logs comes from the plan rather than from the build.

            They do not collide: buildPointOfInterest anchors at
            center + (-21, 0, -18) and buildEventSocket at (22, 0.5, -19),
            opposite sides of a 72-stud cell.
        ]]
        if placement.eventId ~= nil then
            local eventResult = buildEventSocket(
                module,
                center,
                generator.eventDefinition(placement.eventId),
                runtimeIds,
                meshPlacements
            )
            eventSockets[placement.eventId] = eventResult.socket
            for interactionIndex, interaction in eventResult.interactions do
                table.insert(eventInteractions, interaction)
                local target = interaction.target
                local targetName = target.Name
                local assetId = "mesh_creator_crate_a"
                local scale = 0.72
                if string.find(targetName, "Foxlight", 1, true) ~= nil then
                    assetId = "mesh_creator_kerosene_lantern_a"
                    scale = 1
                elseif string.find(targetName, "RootKnot", 1, true) ~= nil then
                    assetId = "mesh_creator_stump_a"
                    scale = 0.58
                elseif string.find(targetName, "PollenScreen", 1, true) ~= nil then
                    assetId = "mesh_creator_barricade_a"
                    scale = 0.6
                elseif string.find(targetName, "HomesteadStore", 1, true) ~= nil then
                    assetId = if string.find(targetName, "fill_water", 1, true) ~= nil
                        then "mesh_creator_barrel_a"
                        else "mesh_creator_crate_a"
                    scale = 0.78
                elseif string.find(targetName, "WardenSign", 1, true) ~= nil then
                    assetId = "mesh_creator_forest_sign_a"
                    scale = 0.72
                elseif string.find(targetName, "WetFirebreak", 1, true) ~= nil then
                    assetId = "mesh_creator_road_stones_a"
                    scale = 0.28
                elseif string.find(targetName, "HedgeLatch", 1, true) ~= nil then
                    assetId = "mesh_creator_stump_a"
                    scale = 0.48
                end
                queueItemAsset(
                    meshPlacements,
                    target,
                    assetId,
                    scale,
                    6000 + placement.index * 10 + interactionIndex,
                    math.rad((interactionIndex - 2) * 11)
                )
            end
        end

        if placement.index == 1 then
            local arrivalSign = WorldSignBuilder.createDirectionSign(
                module,
                "BramblewakeArrival",
                CFrame.new(center + Vector3.new(0, 5.4, -8)) * CFrame.Angles(0, math.pi, 0),
                "BRAMBLEWAKE WOODS",
                CREAM
            )
            arrivalSign:SetAttribute("ArrivalLandmark", true)
        end
    end

    local bossArena = buildWardenSeal(
        expedition,
        assert(oldGrowthCenter, "Old Growth center is missing"),
        centers,
        catalog.CellSize,
        runtimeIds
    )
    local blackout = buildBlackoutLayer(expedition, centers, bossArena.center, runtimeIds)
    queueItemAsset(
        meshPlacements,
        bossArena.seal,
        "mesh_memory_reliquary_a",
        1.12,
        7101,
        math.rad(180),
        bossArena.center.Y + 0.28
    )
    --[[
        Living roots look like roots now. These nodes and the relay roots
        below wore the rootling CREATURE mesh -- the same silhouette as the
        enemy -- so on a dark tablet screen the objectives read as a crowd of
        pale ghosts standing in the forest. An objective may never share a
        silhouette with a threat: the living stump carries "alive and rooted"
        without impersonating the roster.
    ]]
    for nodeIndex, node in bossArena.nodes do
        queueItemAsset(
            meshPlacements,
            node,
            "mesh_heartwood_stump_a",
            0.82,
            7200 + string.len(nodeIndex),
            math.rad(string.len(nodeIndex) * 7),
            node.Position.Y - 3
        )
    end
    queueItemAsset(
        meshPlacements,
        blackout.fireSource,
        "mesh_creator_kerosene_lantern_a",
        1.25,
        7301,
        math.rad(-9),
        blackout.fireSource.Position.Y - 2.2
    )
    local relaySeed = 0
    for _, node in blackout.relayNodes do
        relaySeed += 1
        queueItemAsset(
            meshPlacements,
            node,
            "mesh_heartwood_stump_a",
            0.94,
            7310 + relaySeed,
            math.rad((relaySeed - 2) * 13),
            node.Position.Y - 3
        )
    end
    local decisionAssets = {
        restore_farmland = "mesh_creator_wheat_cluster_a",
        wild_regrowth = "mesh_snapvine_a",
        shared_agroforest = "mesh_creator_stump_a",
    }
    local decisionSeed = 0
    for decisionId, target in blackout.decisions do
        decisionSeed += 1
        queueItemAsset(
            meshPlacements,
            target,
            decisionAssets[decisionId],
            1.05,
            7400 + decisionSeed,
            math.rad((decisionSeed - 2) * 15),
            target.Position.Y - 2.2
        )
    end
    buildBackdrop(expedition, centers, meshPlacements)

    local generatedParts = 0
    for _, descendant in expedition:GetDescendants() do
        if descendant:IsA("BasePart") then
            generatedParts += 1
        end
    end
    expedition:SetAttribute("GeneratedPartCount", generatedParts)
    expedition:SetAttribute("ModuleCount", #manifest.modules)
    expedition:SetAttribute("PointOfInterestCount", catalog.PointOfInterestCount)
    expedition:SetAttribute("EventCount", catalog.EventCount)
    expedition:SetAttribute("EventInteractionCount", #eventInteractions)
    expedition:SetAttribute("StoryLandmarkCount", storyLandmarkCount)
    expedition:SetAttribute("StoryLandmarkPartCount", storyLandmarkPartCount)
    expedition:SetAttribute("ExtractionReady", extractionTarget ~= nil)
    expedition:SetAttribute("BossArenaReady", bossArena ~= nil)
    expedition:SetAttribute("BlackoutLayerReady", blackout ~= nil)
    expedition:SetAttribute("Ready", true)

    local moduleCenters = {}
    for index, center in centers do
        table.insert(moduleCenters, {
            index = index,
            moduleId = manifest.modules[index].moduleId,
            position = center,
        })
    end
    return {
        model = expedition,
        entryCFrame = CFrame.new(centers[1] + Vector3.new(0, 5, 0)),
        extractionTarget = assert(extractionTarget, "Bramblewake extraction target is missing"),
        eventInteractions = eventInteractions,
        resourceNodes = resourceNodes,
        eventSockets = eventSockets,
        eliteArena = assert(eliteArena, "Old Growth elite arena is missing"),
        bossArena = bossArena,
        blackout = blackout,
        meshPlacements = meshPlacements,
        moduleCenters = moduleCenters,
        partCount = generatedParts,
    }
end

return table.freeze(BramblewakeBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">BramblewakeEnemyBuilder</string>
            <string name="Source"><![CDATA[--!strict

local BramblewakeEnemyBuilder = {}

local function part(
    parent: Model,
    name: string,
    size: Vector3,
    offset: Vector3,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?,
    rotation: CFrame?
): Part
    local item = Instance.new("Part")
    item.Name = name
    item.Size = size
    item.CFrame = CFrame.new(offset) * (rotation or CFrame.identity)
    item.Color = color
    item.Material = material
    item.Anchored = true
    item.CanCollide = false
    item.CanQuery = true
    item.CanTouch = false
    item.CastShadow = true
    item.TopSurface = Enum.SurfaceType.Smooth
    item.BottomSurface = Enum.SurfaceType.Smooth
    item.Shape = shape or Enum.PartType.Block
    item.Parent = parent
    return item
end

local function addEye(parent: Model, offset: Vector3, color: Color3)
    part(
        parent,
        "ReadableEye",
        Vector3.new(0.58, 0.58, 0.34),
        offset,
        color,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
end

local function rootling(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "RootCore",
        Vector3.new(4.5, 5.4, 3.4),
        origin,
        Color3.fromRGB(48, 38, 31),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "MossCrown",
        Vector3.new(5.4, 2.1, 2.6),
        origin + Vector3.new(0, 3.2, 0),
        Color3.fromRGB(51, 78, 54),
        Enum.Material.Grass,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        part(
            model,
            "RootArm",
            Vector3.new(1.1, 5.5, 1.1),
            origin + Vector3.new(side * 2.5, 0.2, 0),
            Color3.fromRGB(65, 48, 37),
            Enum.Material.Wood,
            nil,
            CFrame.Angles(0, 0, math.rad(side * 28))
        )
        addEye(model, origin + Vector3.new(side * 0.72, 0.8, -1.62), Color3.fromRGB(255, 143, 91))
    end
    return core
end

local function briarback(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BriarbackCore",
        Vector3.new(6.8, 4.2, 7.2),
        origin + Vector3.new(0, 0.4, 0),
        Color3.fromRGB(64, 47, 36),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "FrontShield",
        Vector3.new(7.8, 5.4, 1.1),
        origin + Vector3.new(0, 0.7, -3.4),
        Color3.fromRGB(47, 68, 50),
        Enum.Material.Slate,
        nil,
        CFrame.Angles(math.rad(-8), 0, 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "ShieldTusk",
            Vector3.new(3.3, 0.9, 0.9),
            origin + Vector3.new(side * 2.8, 0.5, -4.5),
            Color3.fromRGB(208, 188, 138),
            Enum.Material.Wood,
            Enum.PartType.Cylinder,
            CFrame.Angles(0, math.rad(90), math.rad(side * 8))
        )
        part(
            model,
            "BriarLeg",
            Vector3.new(1.4, 3.5, 1.4),
            origin + Vector3.new(side * 2.2, -2, 1.6),
            Color3.fromRGB(55, 42, 34),
            Enum.Material.Wood,
            nil,
            CFrame.Angles(0, 0, math.rad(side * 8))
        )
        addEye(model, origin + Vector3.new(side * 1.05, 1.2, -4.02), Color3.fromRGB(255, 196, 99))
    end
    for x = -1, 1, 2 do
        part(
            model,
            "BackThorn",
            Vector3.new(0.8, 3.4, 0.8),
            origin + Vector3.new(x * 1.7, 3, 0.6),
            Color3.fromRGB(97, 72, 43),
            Enum.Material.Wood,
            nil,
            CFrame.Angles(0, 0, math.rad(x * 25))
        )
    end
    return core
end

local function zombie(model: Model, origin: Vector3): Part
    -- A standing, ground-walking silhouette: torso mass, hunched shoulders,
    -- hanging arms, and a forward-tilted head. Only ever seen if the authored
    -- mesh fails to load, so it is built to read as the same creature at
    -- gameplay distance rather than as a different enemy.
    local torsoOrigin = origin + Vector3.new(0, 3.1, 0)
    local core = part(
        model,
        "ZombieTorso",
        Vector3.new(2.5, 3.2, 1.5),
        torsoOrigin,
        Color3.fromRGB(63, 74, 60),
        Enum.Material.Fabric,
        Enum.PartType.Block,
        CFrame.Angles(math.rad(9), 0, 0)
    )
    part(
        model,
        "ZombieRibcage",
        Vector3.new(1.7, 1.5, 0.5),
        torsoOrigin + Vector3.new(0, 0.35, -0.72),
        Color3.fromRGB(206, 200, 182),
        Enum.Material.SmoothPlastic,
        Enum.PartType.Block,
        CFrame.Angles(math.rad(9), 0, 0)
    )
    part(
        model,
        "ZombieCloak",
        Vector3.new(2.9, 2.1, 1.9),
        torsoOrigin + Vector3.new(0, 0.8, 0.24),
        Color3.fromRGB(44, 48, 44),
        Enum.Material.Fabric,
        Enum.PartType.Block,
        CFrame.Angles(math.rad(11), 0, 0)
    )
    part(
        model,
        "ZombieMossPad",
        Vector3.new(1.25, 0.6, 1.2),
        torsoOrigin + Vector3.new(0.72, 1.5, 0.1),
        Color3.fromRGB(74, 104, 66),
        Enum.Material.Grass,
        Enum.PartType.Block,
        CFrame.Angles(0, 0, math.rad(-13))
    )
    local head = part(
        model,
        "ZombieHead",
        Vector3.new(1.25, 1.4, 1.3),
        torsoOrigin + Vector3.new(0, 2.35, -0.28),
        Color3.fromRGB(126, 133, 121),
        Enum.Material.SmoothPlastic,
        Enum.PartType.Block,
        CFrame.Angles(math.rad(17), math.rad(-8), 0)
    )
    for armSide = -1, 1, 2 do
        part(
            model,
            "ZombieArm",
            Vector3.new(0.6, 3.4, 0.6),
            torsoOrigin + Vector3.new(armSide * 1.6, -0.5, -0.35),
            Color3.fromRGB(112, 120, 108),
            Enum.Material.SmoothPlastic,
            Enum.PartType.Block,
            CFrame.Angles(math.rad(-24), 0, math.rad(armSide * 7))
        )
        part(
            model,
            "ZombieLeg",
            Vector3.new(0.72, 3.1, 0.72),
            origin + Vector3.new(armSide * 0.62, 1.55, 0),
            Color3.fromRGB(58, 74, 62),
            Enum.Material.Fabric,
            Enum.PartType.Block,
            CFrame.Angles(0, 0, math.rad(armSide * 3))
        )
    end
    addEye(model, head.Position + Vector3.new(-0.3, 0.12, -0.62), Color3.fromRGB(94, 206, 176))
    addEye(model, head.Position + Vector3.new(0.3, 0.12, -0.62), Color3.fromRGB(94, 206, 176))
    return core
end

local function hollowCrow(model: Model, origin: Vector3): Part
    local hoverOrigin = origin + Vector3.new(0, 5, 0)
    local core = part(
        model,
        "HollowCrowCore",
        Vector3.new(3.6, 3.8, 4.5),
        hoverOrigin,
        Color3.fromRGB(31, 35, 42),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        CFrame.Angles(math.rad(-12), 0, 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "CrowWing",
            Vector3.new(7.8, 0.65, 3.4),
            hoverOrigin + Vector3.new(side * 4.2, 0.25, 0.5),
            Color3.fromRGB(42, 47, 55),
            Enum.Material.Slate,
            nil,
            CFrame.Angles(0, math.rad(side * 10), math.rad(side * 12))
        )
        addEye(
            model,
            hoverOrigin + Vector3.new(side * 0.72, 0.65, -2.12),
            Color3.fromRGB(126, 211, 194)
        )
    end
    part(
        model,
        "CrowBeak",
        Vector3.new(1.5, 1.1, 3.3),
        hoverOrigin + Vector3.new(0, 0.1, -3.35),
        Color3.fromRGB(183, 154, 83),
        Enum.Material.Wood,
        nil,
        CFrame.Angles(math.rad(-12), 0, 0)
    )
    part(
        model,
        "StolenSpark",
        Vector3.new(1.1, 1.1, 1.1),
        hoverOrigin + Vector3.new(0, -2.2, 0.2),
        Color3.fromRGB(255, 203, 97),
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    return core
end

local function snapvine(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "SnapvineRoot",
        Vector3.new(4.6, 2.2, 4.6),
        origin,
        Color3.fromRGB(59, 46, 35),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "VineStem",
        Vector3.new(6.5, 1.8, 1.8),
        origin + Vector3.new(0, 3.6, 0),
        Color3.fromRGB(57, 91, 53),
        Enum.Material.Grass,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, 0, math.rad(90))
    )
    for side = -1, 1, 2 do
        part(
            model,
            "SnapJaw",
            Vector3.new(5.5, 1.5, 4.2),
            origin + Vector3.new(0, 6.2 + side * 0.9, -0.9),
            if side < 0 then Color3.fromRGB(73, 111, 62) else Color3.fromRGB(91, 126, 65),
            Enum.Material.Grass,
            nil,
            CFrame.Angles(math.rad(side * 15), 0, 0)
        )
        addEye(model, origin + Vector3.new(side * 1.2, 6.4, -3), Color3.fromRGB(255, 116, 82))
        for index = 1, 2 do
            part(
                model,
                "JawThorn",
                Vector3.new(0.55, 1.5, 0.55),
                origin + Vector3.new(side * index * 1.25, 6.1, -3.15),
                Color3.fromRGB(221, 205, 151),
                Enum.Material.Wood,
                nil,
                CFrame.Angles(math.rad(70), 0, math.rad(side * 15))
            )
        end
    end
    return core
end

local function barkRam(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BarkRamCore",
        Vector3.new(7.5, 5.8, 8.4),
        origin + Vector3.new(0, 0.5, 0),
        Color3.fromRGB(65, 49, 38),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "RamBrow",
        Vector3.new(6.2, 3.6, 3),
        origin + Vector3.new(0, 1.5, -4.1),
        Color3.fromRGB(54, 70, 50),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        part(
            model,
            "RamHorn",
            Vector3.new(6.2, 1.5, 1.5),
            origin + Vector3.new(side * 3.2, 2.2, -5.1),
            Color3.fromRGB(219, 195, 139),
            Enum.Material.Wood,
            Enum.PartType.Cylinder,
            CFrame.Angles(0, math.rad(90), math.rad(side * 13))
        )
        for front = -1, 1, 2 do
            part(
                model,
                "RamLeg",
                Vector3.new(1.7, 4.2, 1.7),
                origin + Vector3.new(side * 2.45, -2.6, front * 2.35),
                Color3.fromRGB(57, 43, 34),
                Enum.Material.Wood,
                nil,
                CFrame.Angles(0, 0, math.rad(side * 4))
            )
        end
        addEye(model, origin + Vector3.new(side * 1.15, 1.8, -5.38), Color3.fromRGB(255, 152, 91))
    end
    part(
        model,
        "MossBack",
        Vector3.new(6.5, 1.5, 6),
        origin + Vector3.new(0, 3.5, 0.6),
        Color3.fromRGB(62, 91, 55),
        Enum.Material.Grass,
        Enum.PartType.Ball,
        nil
    )
    return core
end

--[[
    The Delve's six. Their silhouettes are deliberately unlike the
    forest's rounded, mossy masses: plated, angular, rail-borne and
    lit from inside. Readability at night comes from a hot interior
    color -- ember, slag, whitedamp green -- rather than from bulk.
]]
local IRON_PLATE = Color3.fromRGB(88, 84, 82)
local IRON_DARK = Color3.fromRGB(54, 50, 49)
local EMBER = Color3.fromRGB(255, 126, 48)
local SLAG = Color3.fromRGB(255, 168, 66)
local WHITEDAMP = Color3.fromRGB(158, 226, 138)
local ECHO_BLUE = Color3.fromRGB(126, 176, 214)

local function cinderMite(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "MiteShell",
        Vector3.new(3.2, 2.2, 3.8),
        origin,
        IRON_DARK,
        Enum.Material.Metal,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "EmberVent",
        Vector3.new(1.9, 0.9, 2.4),
        origin + Vector3.new(0, 1.2, 0.3),
        EMBER,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        for pair = -1, 1, 2 do
            part(
                model,
                "MiteLeg",
                Vector3.new(0.32, 2.2, 0.32),
                origin + Vector3.new(side * 1.5, -1, pair * 1.1),
                IRON_PLATE,
                Enum.Material.Metal,
                nil,
                CFrame.Angles(0, 0, math.rad(side * 24))
            )
        end
        addEye(model, origin + Vector3.new(side * 0.6, 0.5, -1.85), EMBER)
    end
    return core
end

local function railHound(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "HoundChassis",
        Vector3.new(2.6, 2.4, 6.4),
        origin,
        IRON_PLATE,
        Enum.Material.DiamondPlate,
        nil,
        nil
    )
    part(
        model,
        "HoundSnout",
        Vector3.new(1.8, 1.6, 2.2),
        origin + Vector3.new(0, 0.2, -4),
        IRON_DARK,
        Enum.Material.Metal,
        nil,
        nil
    )
    part(
        model,
        "SparkTrail",
        Vector3.new(1.2, 0.5, 3.4),
        origin + Vector3.new(0, -1.2, 2.6),
        EMBER,
        Enum.Material.Neon,
        nil,
        nil
    )
    --[[
        A cylinder's axis runs along its Size.X, and Y/Z are its diameters.
        These wheels were sized as though the axis were Y and then turned
        a quarter turn on top of it, which buried them inside the chassis:
        seen in Studio the hound was a floating plank with an ember streak.
        The axle now runs left to right, which is the only way a wheel on
        a rail can run, and four short legs put a creature under it.
    ]]
    for side = -1, 1, 2 do
        for pair = -1, 1, 2 do
            part(
                model,
                "HoundWheel",
                Vector3.new(0.5, 1.6, 1.6),
                origin + Vector3.new(side * 1.5, -1.3, pair * 2),
                IRON_DARK,
                Enum.Material.Metal,
                Enum.PartType.Cylinder,
                nil
            )
            part(
                model,
                "HoundLeg",
                Vector3.new(0.4, 1.6, 0.4),
                origin + Vector3.new(side * 1.05, -1, pair * 2),
                IRON_PLATE,
                Enum.Material.Metal,
                nil,
                CFrame.Angles(0, 0, math.rad(side * 14))
            )
        end
        addEye(model, origin + Vector3.new(side * 0.5, 0.7, -4.9), EMBER)
    end
    return core
end

local function slagSpitter(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "SpitterBase",
        Vector3.new(4.4, 3.6, 4.4),
        origin,
        IRON_DARK,
        Enum.Material.Slate,
        nil,
        nil
    )
    part(
        model,
        "SpitterMouth",
        Vector3.new(2.4, 2.4, 2.4),
        origin + Vector3.new(0, 2.4, -1.6),
        SLAG,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        part(
            model,
            "SpitterRib",
            Vector3.new(0.7, 4.6, 0.7),
            origin + Vector3.new(side * 2.2, 0.8, 0.6),
            IRON_PLATE,
            Enum.Material.Metal,
            nil,
            CFrame.Angles(math.rad(12), 0, math.rad(side * -10))
        )
    end
    -- Same cylinder-axis error as the hound's wheels, and far louder: in
    -- Studio this pool stood as a glowing bar straight up through the
    -- spitter. Thickness belongs on the axis (X), width on the diameters.
    part(
        model,
        "SlagPool",
        Vector3.new(0.4, 5.6, 5.6),
        origin + Vector3.new(0, -1.9, 0),
        SLAG,
        Enum.Material.Neon,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, 0, math.rad(90))
    )
    return core
end

local function shiftEcho(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "EchoTorso",
        Vector3.new(2.4, 3.4, 1.6),
        origin + Vector3.new(0, 0.6, 0),
        ECHO_BLUE,
        Enum.Material.Glass,
        nil,
        nil
    )
    core.Transparency = 0.35
    local head = part(
        model,
        "EchoHead",
        Vector3.new(1.3, 1.4, 1.3),
        origin + Vector3.new(0, 3, 0),
        ECHO_BLUE,
        Enum.Material.Glass,
        nil,
        nil
    )
    head.Transparency = 0.35
    part(
        model,
        "EchoLamp",
        Vector3.new(0.7, 0.9, 0.7),
        origin + Vector3.new(1.4, 1.6, -0.6),
        WHITEDAMP,
        Enum.Material.Neon,
        nil,
        nil
    )
    for side = -1, 1, 2 do
        local arm = part(
            model,
            "EchoArm",
            Vector3.new(0.6, 2.8, 0.6),
            origin + Vector3.new(side * 1.5, 0.8, -0.4),
            ECHO_BLUE,
            Enum.Material.Glass,
            nil,
            CFrame.Angles(math.rad(side * 34), 0, 0)
        )
        arm.Transparency = 0.45
        addEye(model, origin + Vector3.new(side * 0.35, 3.1, -0.72), WHITEDAMP)
    end
    return core
end

local function crankGuard(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "GuardFrame",
        Vector3.new(5.2, 4.6, 3.6),
        origin + Vector3.new(0, 0.6, 0),
        IRON_PLATE,
        Enum.Material.DiamondPlate,
        nil,
        nil
    )
    part(
        model,
        "FrontPlate",
        Vector3.new(6.4, 5.2, 0.9),
        origin + Vector3.new(0, 0.9, -2.4),
        IRON_DARK,
        Enum.Material.Metal,
        nil,
        CFrame.Angles(math.rad(-6), 0, 0)
    )
    -- The exposed mechanism: the reason a flank strike lands for five
    -- times what the plate allows, and it must read from behind.
    part(
        model,
        "ExposedMechanism",
        Vector3.new(1, 2.6, 2.6),
        origin + Vector3.new(0, 1, 2.1),
        EMBER,
        Enum.Material.Neon,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, math.rad(90), 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "GuardLeg",
            Vector3.new(1.3, 3.2, 1.3),
            origin + Vector3.new(side * 2, -2.2, 0.4),
            IRON_DARK,
            Enum.Material.Metal,
            nil,
            nil
        )
        addEye(model, origin + Vector3.new(side * 1, 2.2, -2.9), EMBER)
    end
    return core
end

local function gasBloomer(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BloomerBulb",
        Vector3.new(4.2, 4.2, 4.2),
        origin + Vector3.new(0, 0.8, 0),
        Color3.fromRGB(72, 88, 64),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        nil
    )
    --[[
        Petals lean up and out from the bulb. Pitching each one before its
        yaw made all five settle into the same plane, so in Studio the
        bloom read as a flat saucer hanging over a shrub. Yaw first, then
        pitch, and the flower opens.
    ]]
    for index = 0, 4 do
        local angle = index * math.pi * 0.4
        part(
            model,
            "BloomPetal",
            Vector3.new(1.6, 0.4, 2.8),
            origin + Vector3.new(math.cos(angle) * 1.5, 3.1, math.sin(angle) * 1.5),
            WHITEDAMP,
            Enum.Material.Neon,
            nil,
            CFrame.Angles(0, -angle, 0) * CFrame.Angles(math.rad(-52), 0, 0)
        )
    end
    local haze = part(
        model,
        "Whitedamp",
        Vector3.new(7.5, 2.6, 7.5),
        origin + Vector3.new(0, -0.6, 0),
        WHITEDAMP,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    haze.Transparency = 0.72
    addEye(model, origin + Vector3.new(0, 1.4, -2.1), EMBER)
    return core
end

--[[
    The Fen's six. Where the Delve reads by heat, the Fen reads by water:
    pale glass, wet reed, and cold witchlight. Several of them are
    deliberately half-hidden shapes -- a heron that is mostly stillness, a
    lurker that is mostly reeds -- so the outline highlight is doing more
    work here than the geometry, which is the point of the place.
]]
local REED_GREEN = Color3.fromRGB(74, 96, 66)
local BOG_DARK = Color3.fromRGB(46, 54, 48)
local MIRROR_PALE = Color3.fromRGB(186, 206, 210)
local WITCHLIGHT = Color3.fromRGB(146, 214, 226)
local LEECH_RED = Color3.fromRGB(120, 52, 58)

local function reedLurker(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "LurkerBody",
        Vector3.new(3.6, 2.4, 6),
        origin,
        BOG_DARK,
        Enum.Material.Slate,
        nil,
        nil
    )
    for index = -2, 2 do
        part(
            model,
            "ReedFrond",
            Vector3.new(0.24, 5.5, 0.24),
            origin + Vector3.new(index * 0.9, 2.4, index * 0.5),
            REED_GREEN,
            Enum.Material.Grass,
            nil,
            CFrame.Angles(math.rad(index * 7), 0, math.rad(index * 9))
        )
    end
    for side = -1, 1, 2 do
        addEye(model, origin + Vector3.new(side * 0.7, 1.3, -2.7), WITCHLIGHT)
    end
    return core
end

local function mirrorling(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "MirrorTorso",
        Vector3.new(2.6, 4, 1.4),
        origin + Vector3.new(0, 0.8, 0),
        MIRROR_PALE,
        Enum.Material.Glass,
        nil,
        nil
    )
    core.Reflectance = 0.55
    local head = part(
        model,
        "MirrorHead",
        Vector3.new(1.4, 1.5, 1.4),
        origin + Vector3.new(0, 3.5, 0),
        MIRROR_PALE,
        Enum.Material.Glass,
        Enum.PartType.Ball,
        nil
    )
    head.Reflectance = 0.55
    for side = -1, 1, 2 do
        local arm = part(
            model,
            "MirrorArm",
            Vector3.new(0.6, 3, 0.6),
            origin + Vector3.new(side * 1.7, 0.9, 0),
            MIRROR_PALE,
            Enum.Material.Glass,
            nil,
            CFrame.Angles(0, 0, math.rad(side * 10))
        )
        arm.Reflectance = 0.4
        addEye(model, origin + Vector3.new(side * 0.36, 3.6, -0.76), WITCHLIGHT)
    end
    return core
end

local function mireLeech(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "LeechBody",
        Vector3.new(1.8, 1.6, 5.2),
        origin,
        LEECH_RED,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    core.Transparency = 0.25
    for index = -1, 1 do
        part(
            model,
            "LeechSegment",
            Vector3.new(1.5, 1.4, 1.4),
            origin + Vector3.new(0, 0.1, index * 1.5),
            BOG_DARK,
            Enum.Material.Slate,
            Enum.PartType.Ball,
            nil
        )
    end
    part(
        model,
        "LeechMouth",
        Vector3.new(0.7, 1.1, 1.1),
        origin + Vector3.new(0, 0, -2.7),
        LEECH_RED,
        Enum.Material.Neon,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, math.rad(90), 0)
    )
    return core
end

local function falseFriend(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "FriendTorso",
        Vector3.new(2.4, 3.6, 1.5),
        origin + Vector3.new(0, 0.8, 0),
        Color3.fromRGB(96, 84, 72),
        Enum.Material.Fabric,
        nil,
        nil
    )
    part(
        model,
        "FriendHead",
        Vector3.new(1.3, 1.4, 1.3),
        origin + Vector3.new(0, 3.2, 0),
        Color3.fromRGB(150, 148, 132),
        Enum.Material.SmoothPlastic,
        nil,
        nil
    )
    -- The tell: it carries a lantern that gives no light, and its hands
    -- are on backwards. Readability by wrongness, not by glow.
    local lantern = part(
        model,
        "DeadLantern",
        Vector3.new(0.8, 1, 0.8),
        origin + Vector3.new(1.6, 1.8, -0.6),
        Color3.fromRGB(58, 62, 56),
        Enum.Material.Metal,
        nil,
        nil
    )
    lantern.Reflectance = 0.1
    for side = -1, 1, 2 do
        part(
            model,
            "BackwardHand",
            Vector3.new(0.6, 0.6, 0.9),
            origin + Vector3.new(side * 1.5, 0.7, 0.5),
            Color3.fromRGB(150, 148, 132),
            Enum.Material.SmoothPlastic,
            nil,
            CFrame.Angles(0, math.rad(180), 0)
        )
        addEye(model, origin + Vector3.new(side * 0.34, 3.3, -0.72), WITCHLIGHT)
    end
    return core
end

local function glassHeron(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "HeronBody",
        Vector3.new(1.8, 2.2, 3.4),
        origin + Vector3.new(0, 3.2, 0),
        MIRROR_PALE,
        Enum.Material.Glass,
        Enum.PartType.Ball,
        nil
    )
    core.Reflectance = 0.4
    part(
        model,
        "HeronNeck",
        Vector3.new(0.5, 3.4, 0.5),
        origin + Vector3.new(0, 5.2, -0.8),
        MIRROR_PALE,
        Enum.Material.Glass,
        nil,
        CFrame.Angles(math.rad(14), 0, 0)
    )
    part(
        model,
        "HeronBeak",
        Vector3.new(0.32, 0.32, 3.4),
        origin + Vector3.new(0, 6.6, -2.6),
        WITCHLIGHT,
        Enum.Material.Neon,
        nil,
        CFrame.Angles(math.rad(-8), 0, 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "HeronLeg",
            Vector3.new(0.3, 4.4, 0.3),
            origin + Vector3.new(side * 0.5, 0.9, 0.2),
            BOG_DARK,
            Enum.Material.Slate,
            nil,
            nil
        )
        addEye(model, origin + Vector3.new(side * 0.32, 6.5, -1.6), WITCHLIGHT)
    end
    return core
