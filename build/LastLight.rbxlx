            x = 0,
            color = AMBER,
        },
        {
            id = self._runtimeIds.InteractionIds.ToolTorch,
            tool = "torch",
            x = 10,
            color = Color3.fromRGB(111, 154, 184),
        },
    }
    for _, definition in tools do
        local pedestal = part(
            interactables,
            "Tool_" .. definition.tool,
            Vector3.new(6, 2, 6),
            CFrame.new(definition.x, 1, -68),
            Color3.fromRGB(66, 70, 65),
            Enum.Material.Slate
