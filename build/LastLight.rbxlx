        shape = "circle",
        radius = 7,
        width = nil,
        length = nil,
        windup = 0.9,
        stationary = false,
        targetMode = "lantern",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    enemy_briarback = freezeDefinition({
        id = "enemy_briarback",
        displayName = "Briarback",
        modelKey = "briarback",
        health = 120,
        speed = 5.6,
        attackRange = 10,
        attackCooldown = 2.2,
        playerDamage = 22,
        lanternDamage = 7,
        strikeRange = 10,
        strikeDamage = 34,
        attackId = "briarback_sweep",
        attackName = "BRIARBACK SWEEP",
        instruction = "CLEAR THE LANE · FLANK IT",
        shape = "lane",
        radius = nil,
        width = 8,
        length = 12,
        windup = 1.05,
        stationary = false,
        targetMode = "lantern",
        frontShield = true,
        frontalStrikeDamage = 8,
        flankStrikeDamage = 40,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    enemy_pollen_wisp = freezeDefinition({
        id = "enemy_pollen_wisp",
        displayName = "Pollen Wisp",
        modelKey = "pollen_wisp",
        health = 68,
        speed = 6.8,
        attackRange = 12,
        attackCooldown = 2.7,
        playerDamage = 12,
        lanternDamage = 4,
        strikeRange = 11,
        strikeDamage = 34,
        attackId = "pollen_sleep_cloud",
        attackName = "SLEEP CLOUD",
        instruction = "LEAVE THE CLOUD",
        shape = "circle",
        radius = 10,
        width = nil,
        length = nil,
        windup = 1.25,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "drowsy",
        statusDuration = 3,
        statusMultiplier = 0.65,
        statusLanternDamage = nil,
    }),
    enemy_hollow_crow = freezeDefinition({
        id = "enemy_hollow_crow",
        displayName = "Hollow Crow",
        modelKey = "hollow_crow",
        health = 60,
        speed = 9,
        attackRange = 13,
        attackCooldown = 1.9,
        playerDamage = 10,
        lanternDamage = 5,
        strikeRange = 12,
        strikeDamage = 34,
        attackId = "hollow_crow_swoop",
        attackName = "CROW SWOOP",
        instruction = "STEP OUT OF THE FLIGHT PATH",
        shape = "lane",
        radius = nil,
        width = 5,
        length = 16,
        windup = 0.8,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "spark_theft",
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = 4,
    }),
    enemy_snapvine = freezeDefinition({
        id = "enemy_snapvine",
