        shape = "circle",
        radius = 7,
        width = nil,
        length = nil,
        windup = 0.9,
        stationary = false,
        targetMode = "lantern",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    enemy_briarback = freezeDefinition({
        id = "enemy_briarback",
        displayName = "Briarback",
        modelKey = "briarback",
        health = 120,
        speed = 5.6,
