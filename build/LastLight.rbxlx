      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">ProfessionCatalog</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = {}

export type Definition = {
    id: string,
    displayName: string,
    shortName: string,
    role: string,
    abilityId: string,
    abilityName: string,
    abilityDescription: string,
    cooldownSeconds: number,
    activeSeconds: number,
    effectAmount: number,
    effectRadius: number,
}

local ORDER = table.freeze({
    "profession_scout",
    "profession_warden",
    "profession_engineer",
    "profession_medic",
    "profession_alchemist",
    "profession_beastkeeper",
    "profession_runebinder",
})

local DEFINITIONS: { [string]: Definition } = {
    profession_scout = table.freeze({
        id = "profession_scout",
        displayName = "SCOUT",
        shortName = "SCOUT",
        role = "TRACK · REVEAL · SLOW",
        abilityId = "ability_foxfire_mark",
        abilityName = "FOXFIRE MARK",
        abilityDescription = "Mark and slow the nearest Rootling for the whole team.",
        cooldownSeconds = 16,
        activeSeconds = 8,
        effectAmount = 35,
        effectRadius = 55,
    }),
    profession_warden = table.freeze({
        id = "profession_warden",
        displayName = "WARDEN",
        shortName = "WARDEN",
        role = "GUARD · HOLD · PROTECT",
        abilityId = "ability_lantern_guard",
        abilityName = "LANTERN GUARD",
        abilityDescription = "Reduce incoming Rootling damage for a short window.",
        cooldownSeconds = 20,
        activeSeconds = 6,
        effectAmount = 60,
        effectRadius = 0,
    }),
    profession_engineer = table.freeze({
        id = "profession_engineer",
        displayName = "ENGINEER",
        shortName = "ENGINEER",
        role = "REPAIR · BUILD · CONTROL",
        abilityId = "ability_emergency_patch",
        abilityName = "EMERGENCY PATCH",
        abilityDescription = "Restore the First Lantern while defending it nearby.",
        cooldownSeconds = 18,
        activeSeconds = 0,
        effectAmount = 18,
        effectRadius = 30,
    }),
    profession_medic = table.freeze({
        id = "profession_medic",
        displayName = "MEDIC",
        shortName = "MEDIC",
        role = "HEAL · RESCUE · SUSTAIN",
        abilityId = "ability_guiding_pulse",
        abilityName = "GUIDING PULSE",
        abilityDescription = "Heal yourself and active allies in a nearby pulse.",
        cooldownSeconds = 24,
        activeSeconds = 0,
        effectAmount = 22,
        effectRadius = 28,
    }),
    --[[
        The final three of the seven-profession roster. Each maps onto an
        existing combat primitive rather than inventing a parallel system:
        the tonic is the Medic's radius pattern applied to stamina as well
        as health, the hound is enemy target selection with a preference,
        and the rune is the same held-state the mark's slow already uses,
        taken to a full stop. effectAmount doubles as the tonic's stamina
        number (its heal is derived as half), and activeSeconds is the
        hound's and rune's duration, so the mastery bonus fields mean the
        same thing here that they mean for the first four kits.
    ]]
    profession_alchemist = table.freeze({
        id = "profession_alchemist",
        displayName = "ALCHEMIST",
        shortName = "ALCHEMIST",
        role = "BREW · RESTORE · SUSTAIN",
        abilityId = "ability_sporebright_tonic",
        abilityName = "SPOREBRIGHT TONIC",
        abilityDescription = "Share a tonic that restores stamina and mends nearby allies.",
        cooldownSeconds = 22,
        activeSeconds = 0,
        effectAmount = 30,
        effectRadius = 26,
    }),
    profession_beastkeeper = table.freeze({
        id = "profession_beastkeeper",
        displayName = "BEASTKEEPER",
        shortName = "KEEPER",
        role = "BOND · LURE · PROTECT",
        abilityId = "ability_briar_hound",
        abilityName = "BRIAR HOUND",
        abilityDescription = "Send your hound to harry the threat so it hunts you instead.",
        cooldownSeconds = 20,
        activeSeconds = 7,
        effectAmount = 0,
        effectRadius = 50,
    }),
    profession_runebinder = table.freeze({
        id = "profession_runebinder",
        displayName = "RUNEBINDER",
        shortName = "BINDER",
        role = "BIND · STILL · WARD",
        abilityId = "ability_still_rune",
        abilityName = "STILL RUNE",
        abilityDescription = "Bind the threat in light, holding it still for a few breaths.",
        cooldownSeconds = 26,
        activeSeconds = 3.5,
        effectAmount = 0,
        effectRadius = 45,
    }),
}

function ProfessionCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function ProfessionCatalog.get(id: string): Definition?
    return DEFINITIONS[id]
end

function ProfessionCatalog.list(): { Definition }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

ProfessionCatalog.Ids = table.freeze({
    Scout = "profession_scout",
    Warden = "profession_warden",
    Engineer = "profession_engineer",
    Medic = "profession_medic",
    Alchemist = "profession_alchemist",
    Beastkeeper = "profession_beastkeeper",
    Runebinder = "profession_runebinder",
})

return table.freeze(ProfessionCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">ProfessionMastery</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = require("./ProfessionCatalog")

local ProfessionMastery = {}

export type Entry = {
    xp: number,
    level: number,
    specializationId: string?,
}

export type State = { [string]: Entry }

export type Specialization = {
    id: string,
    name: string,
    description: string,
    effectAmountBonus: number?,
    effectRadiusBonus: number?,
    activeSecondsBonus: number?,
    cooldownReduction: number?,
    rescueDurationMultiplier: number?,
    rescueHealthBonus: number?,
    rescueWardBonus: number?,
}

local MAX_LEVEL = 10
local XP_PER_LEVEL = 100
local MAX_XP = MAX_LEVEL * XP_PER_LEVEL

local RANKS = table.freeze({
    table.freeze({ level = 1, name = "INITIATE" }),
    table.freeze({ level = 2, name = "KEEPER" }),
    table.freeze({ level = 4, name = "ADEPT" }),
    table.freeze({ level = 6, name = "VETERAN" }),
    table.freeze({ level = 8, name = "LUMINARY" }),
    table.freeze({ level = 10, name = "MASTER" }),
})

local function specialization(definition: any): Specialization
    return table.freeze({
        id = assert(definition.id, "specialization ID is required"),
        name = assert(definition.name, "specialization name is required"),
        description = assert(definition.description, "specialization description is required"),
        effectAmountBonus = tonumber(definition.effectAmountBonus) or 0,
        effectRadiusBonus = tonumber(definition.effectRadiusBonus) or 0,
        activeSecondsBonus = tonumber(definition.activeSecondsBonus) or 0,
        cooldownReduction = tonumber(definition.cooldownReduction) or 0,
        rescueDurationMultiplier = tonumber(definition.rescueDurationMultiplier) or 1,
        rescueHealthBonus = tonumber(definition.rescueHealthBonus) or 0,
        rescueWardBonus = tonumber(definition.rescueWardBonus) or 0,
    })
end

local SPECIALIZATIONS: { [string]: { Specialization } } = table.freeze({
    profession_scout = table.freeze({
        specialization({
            id = "specialization_pathfinder",
            name = "PATHFINDER",
            description = "Foxfire Mark reaches 8 studs farther.",
            effectRadiusBonus = 8,
        }),
        specialization({
            id = "specialization_foxfire_trapper",
            name = "FOXFIRE TRAPPER",
            description = "Foxfire Mark lasts 3 seconds longer.",
            activeSecondsBonus = 3,
        }),
        specialization({
            id = "specialization_trailseer",
            name = "TRAILSEER",
            description = "Foxfire Mark recharges 4 seconds faster.",
            cooldownReduction = 4,
        }),
    }),
    profession_warden = table.freeze({
        specialization({
            id = "specialization_bulwark",
            name = "BULWARK",
            description = "Lantern Guard reduces 10% more incoming damage.",
            effectAmountBonus = 10,
        }),
        specialization({
            id = "specialization_greenkeeper",
            name = "GREENKEEPER",
            description = "Lantern Guard lasts 3 seconds longer.",
            activeSecondsBonus = 3,
        }),
        specialization({
            id = "specialization_oathbound",
            name = "OATHBOUND",
            description = "Warden rescues grant 1.5 more ward seconds.",
            rescueWardBonus = 1.5,
        }),
    }),
    profession_engineer = table.freeze({
        specialization({
            id = "specialization_lamplighter",
            name = "LAMPLIGHTER",
            description = "Emergency Patch restores 10 more lantern health.",
            effectAmountBonus = 10,
        }),
        specialization({
            id = "specialization_rootwright",
            name = "ROOTWRIGHT",
            description = "Emergency Patch reaches 10 studs farther.",
            effectRadiusBonus = 10,
        }),
        specialization({
            id = "specialization_salvager",
            name = "SALVAGER",
            description = "Emergency Patch recharges 5 seconds faster.",
            cooldownReduction = 5,
        }),
    }),
    profession_medic = table.freeze({
        specialization({
            id = "specialization_dawnmender",
            name = "DAWNMENDER",
            description = "Guiding Pulse restores 10 more health.",
            effectAmountBonus = 10,
        }),
        specialization({
            id = "specialization_wayhome_tender",
            name = "WAYHOME TENDER",
            description = "Medic rescues are faster and restore 8 more health.",
            rescueDurationMultiplier = 0.82,
            rescueHealthBonus = 8,
        }),
        specialization({
            id = "specialization_brightcap_herbalist",
            name = "BRIGHTCAP HERBALIST",
            description = "Guiding Pulse reaches 10 studs farther.",
            effectRadiusBonus = 10,
        }),
    }),
    profession_alchemist = table.freeze({
        specialization({
            id = "specialization_brewer",
            name = "BREWER",
            description = "Sporebright Tonic restores 8 more stamina and mends deeper.",
            effectAmountBonus = 8,
        }),
        specialization({
            id = "specialization_catalyst",
            name = "CATALYST",
            description = "Sporebright Tonic recharges 4 seconds faster.",
            cooldownReduction = 4,
        }),
        specialization({
            id = "specialization_forager",
            name = "FORAGER",
            description = "Sporebright Tonic reaches 8 studs farther.",
            effectRadiusBonus = 8,
        }),
    }),
    profession_beastkeeper = table.freeze({
        specialization({
            id = "specialization_handler",
            name = "HANDLER",
            description = "Briar Hound harries the threat 2.5 seconds longer.",
            activeSecondsBonus = 2.5,
        }),
        specialization({
            id = "specialization_bondkeeper",
            name = "BONDKEEPER",
            description = "Briar Hound can be sent 10 studs farther.",
            effectRadiusBonus = 10,
        }),
        specialization({
            id = "specialization_wildspeaker",
            name = "WILDSPEAKER",
            description = "Briar Hound recharges 4 seconds faster.",
            cooldownReduction = 4,
        }),
    }),
    profession_runebinder = table.freeze({
        specialization({
            id = "specialization_scribe",
            name = "SCRIBE",
            description = "Still Rune holds the threat 1.25 seconds longer.",
            activeSecondsBonus = 1.25,
        }),
        specialization({
            id = "specialization_channeler",
            name = "CHANNELER",
            description = "Still Rune can be cast 10 studs farther.",
            effectRadiusBonus = 10,
        }),
        specialization({
            id = "specialization_veilwalker",
            name = "VEILWALKER",
            description = "Still Rune recharges 5 seconds faster.",
            cooldownReduction = 5,
        }),
    }),
})

local SPECIALIZATION_PROFESSIONS: { [string]: string } = {}
for professionId, definitions in SPECIALIZATIONS do
    for _, definition in definitions do
        assert(
            SPECIALIZATION_PROFESSIONS[definition.id] == nil,
            "duplicate specialization ID: " .. definition.id
        )
        SPECIALIZATION_PROFESSIONS[definition.id] = professionId
    end
end

local function specializationBonus(definition: any, field: string): number
    if definition == nil then
        return 0
    end
    return tonumber(definition[field]) or 0
end

local function levelForXp(xp: number): number
    return math.clamp(math.floor(xp / XP_PER_LEVEL) + 1, 1, MAX_LEVEL)
end

local function rankName(level: number): string
    local name = RANKS[1].name
    for _, rank in RANKS do
        if level >= rank.level then
            name = rank.name
        end
    end
    return name
end

function ProfessionMastery.default(): State
    return {}
end

function ProfessionMastery.normalize(value: any): State
    local result: State = {}
    if type(value) ~= "table" then
        return result
    end
    for _, definition in ProfessionCatalog.list() do
        local raw = value[definition.id]
        if type(raw) == "table" then
            local xp = if type(raw.xp) == "number"
                then math.clamp(math.floor(raw.xp), 0, MAX_XP)
                else 0
            local level = levelForXp(xp)
            local specializationId = if level >= MAX_LEVEL
                    and type(raw.specializationId) == "string"
                    and SPECIALIZATION_PROFESSIONS[raw.specializationId] == definition.id
                then raw.specializationId
                else nil
            result[definition.id] = {
                xp = xp,
                level = level,
                specializationId = specializationId,
            }
        end
    end
    return result
end

function ProfessionMastery.award(state: State, professionId: any, amount: number): (State, any)
    if not ProfessionCatalog.isValid(professionId) or type(amount) ~= "number" or amount <= 0 then
        return state, { applied = false, reason = "invalid_mastery_award" }
    end
    local nextState = ProfessionMastery.normalize(state)
    local current = nextState[professionId]
        or {
            xp = 0,
            level = 1,
            specializationId = nil,
        }
    local nextXp = math.min(MAX_XP, current.xp + math.floor(amount))
    local nextLevel = levelForXp(nextXp)
    nextState[professionId] = {
        xp = nextXp,
        level = nextLevel,
        specializationId = current.specializationId,
    }
    return nextState,
        {
            applied = true,
            professionId = professionId,
            xp = nextXp,
            level = nextLevel,
            rankName = rankName(nextLevel),
            leveledUp = nextLevel > current.level,
            specializationUnlocked = current.level < MAX_LEVEL and nextLevel == MAX_LEVEL,
        }
end

function ProfessionMastery.selectSpecialization(
    state: State,
    professionId: any,
    specializationId: any
): (State, any)
    if not ProfessionCatalog.isValid(professionId) then
        return state, { applied = false, reason = "unknown_profession" }
    end
    if
        type(specializationId) ~= "string"
        or SPECIALIZATION_PROFESSIONS[specializationId] ~= professionId
    then
        return state, { applied = false, reason = "invalid_specialization" }
    end
    local normalized = ProfessionMastery.normalize(state)
    local current = normalized[professionId] or { xp = 0, level = 1, specializationId = nil }
    if current.level < MAX_LEVEL then
        return state, { applied = false, reason = "specialization_locked" }
    end
    if current.specializationId == specializationId then
        return state,
            {
                applied = false,
                duplicate = true,
                professionId = professionId,
                reason = "already_selected",
                specializationId = specializationId,
            }
    end
    local nextState = table.clone(normalized)
    nextState[professionId] = {
        xp = current.xp,
        level = current.level,
        specializationId = specializationId,
    }
    return nextState,
        {
            applied = true,
            professionId = professionId,
            specializationId = specializationId,
        }
end

function ProfessionMastery.specializationProfession(specializationId: any): string?
    return if type(specializationId) == "string"
        then SPECIALIZATION_PROFESSIONS[specializationId]
        else nil
end

function ProfessionMastery.specializationDefinition(specializationId: any): any
    local professionId = ProfessionMastery.specializationProfession(specializationId)
    if professionId == nil then
        return nil
    end
    for _, definition in SPECIALIZATIONS[professionId] do
        if definition.id == specializationId then
            return definition
        end
    end
    return nil
end

function ProfessionMastery.specializationIds(): { string }
    local result = {}
    for _, profession in ProfessionCatalog.list() do
        for _, definition in SPECIALIZATIONS[profession.id] do
            table.insert(result, definition.id)
        end
    end
    return result
end

function ProfessionMastery.tuning(state: State, professionId: any): any
    local normalized = ProfessionMastery.normalize(state)
    local entry = if ProfessionCatalog.isValid(professionId)
        then normalized[professionId] or { xp = 0, level = 1, specializationId = nil }
        else { xp = 0, level = 1, specializationId = nil }
    local rewardSteps = math.floor(entry.level / 2)
    local selectedSpecialization =
        ProfessionMastery.specializationDefinition(entry.specializationId)
    return {
        level = entry.level,
        rankName = rankName(entry.level),
        effectAmountBonus = rewardSteps * 2
            + specializationBonus(selectedSpecialization, "effectAmountBonus"),
        effectRadiusBonus = rewardSteps * 1.5
            + specializationBonus(selectedSpecialization, "effectRadiusBonus"),
        activeSecondsBonus = rewardSteps * 0.35
            + specializationBonus(selectedSpecialization, "activeSecondsBonus"),
        cooldownReduction = rewardSteps * 0.4
            + specializationBonus(selectedSpecialization, "cooldownReduction"),
        rescueDurationMultiplier = if selectedSpecialization == nil
            then 1
            else selectedSpecialization.rescueDurationMultiplier or 1,
        rescueHealthBonus = if selectedSpecialization == nil
            then 0
            else selectedSpecialization.rescueHealthBonus or 0,
        rescueWardBonus = if selectedSpecialization == nil
            then 0
            else selectedSpecialization.rescueWardBonus or 0,
        specialization = selectedSpecialization,
        specializationId = entry.specializationId,
        specializationUnlocked = entry.level >= MAX_LEVEL,
        specializationUnlockLevel = MAX_LEVEL,
        specializations = if ProfessionCatalog.isValid(professionId)
            then SPECIALIZATIONS[professionId]
            else {},
    }
end

function ProfessionMastery.snapshot(state: State): { [string]: any }
    local normalized = ProfessionMastery.normalize(state)
    local result = {}
    for _, definition in ProfessionCatalog.list() do
        local entry = normalized[definition.id] or { xp = 0, level = 1, specializationId = nil }
        local tuning = ProfessionMastery.tuning(normalized, definition.id)
        result[definition.id] = {
            xp = entry.xp,
            level = entry.level,
            rankName = tuning.rankName,
            currentLevelXp = (entry.level - 1) * XP_PER_LEVEL,
            nextLevelXp = if entry.level >= MAX_LEVEL then MAX_XP else entry.level * XP_PER_LEVEL,
            effectAmountBonus = tuning.effectAmountBonus,
            effectRadiusBonus = tuning.effectRadiusBonus,
            activeSecondsBonus = tuning.activeSecondsBonus,
            cooldownReduction = tuning.cooldownReduction,
            specialization = tuning.specialization,
            specializationId = tuning.specializationId,
            specializationUnlocked = tuning.specializationUnlocked,
            specializationUnlockLevel = tuning.specializationUnlockLevel,
            specializations = tuning.specializations,
        }
    end
    return result
end

ProfessionMastery.MaxLevel = MAX_LEVEL
ProfessionMastery.MaxXp = MAX_XP
ProfessionMastery.Ranks = RANKS
ProfessionMastery.Specializations = SPECIALIZATIONS
ProfessionMastery.XpPerLevel = XP_PER_LEVEL

return table.freeze(ProfessionMastery)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">ProfessionRescue</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionRescue = {}

local MAX_LEVEL = 10

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function safeLevel(value: any): number
    return if finite(value) then math.clamp(math.floor(value), 1, MAX_LEVEL) else 1
end

function ProfessionRescue.resolve(
    professionId: any,
    level: any,
    baseDuration: number,
    baseHealth: number,
    baseWardSeconds: number,
    specializationTuning: any?
): any
    assert(finite(baseDuration) and baseDuration > 0, "base revive duration is invalid")
    assert(finite(baseHealth) and baseHealth > 0, "base revive health is invalid")
    assert(finite(baseWardSeconds) and baseWardSeconds >= 0, "base revive ward is invalid")

    local normalizedLevel = safeLevel(level)
    local masterySteps = math.floor(normalizedLevel / 2)
    local duration = baseDuration
    local health = baseHealth
    local wardSeconds = baseWardSeconds
    local rescueTitle = "FIELD RESCUE"
    local specialized = false

    if professionId == "profession_medic" then
        duration = baseDuration * (0.72 - masterySteps * 0.015)
        health = baseHealth + 10 + masterySteps * 2
        wardSeconds = baseWardSeconds + 0.75 + masterySteps * 0.15
        rescueTitle = "MEDIC RESCUE"
        specialized = true
    elseif professionId == "profession_warden" then
        wardSeconds = baseWardSeconds + 0.5 + masterySteps * 0.1
        rescueTitle = "WARDEN ESCORT"
        specialized = true
    end

    if type(specializationTuning) == "table" then
        local durationMultiplier = if finite(specializationTuning.rescueDurationMultiplier)
            then math.clamp(specializationTuning.rescueDurationMultiplier, 0.7, 1)
            else 1
        local healthBonus = if finite(specializationTuning.rescueHealthBonus)
            then math.clamp(math.floor(specializationTuning.rescueHealthBonus), 0, 12)
            else 0
        local wardBonus = if finite(specializationTuning.rescueWardBonus)
            then math.clamp(specializationTuning.rescueWardBonus, 0, 2)
            else 0
        duration *= durationMultiplier
        health += healthBonus
        wardSeconds += wardBonus
    end

    return table.freeze({
        duration = math.clamp(duration, 1.25, baseDuration),
        health = math.clamp(math.floor(health), baseHealth, 65),
        level = normalizedLevel,
        professionId = if type(professionId) == "string" then professionId else nil,
        rescueTitle = rescueTitle,
        specialized = specialized,
        wardSeconds = math.clamp(wardSeconds, baseWardSeconds, 6),
    })
end

return table.freeze(ProfessionRescue)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">ProfessionState</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = require("./ProfessionCatalog")

local ProfessionState = {}

export type State = {
    selectedId: string?,
    cooldownReadyAt: number,
    activeUntil: number,
    revision: number,
}

local function validNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function ProfessionState.create(selectedId: string?, now: number): State
    assert(validNumber(now), "profession state time is invalid")
    return {
        selectedId = if ProfessionCatalog.isValid(selectedId) then selectedId else nil,
        cooldownReadyAt = now,
        activeUntil = now,
        revision = 0,
    }
end

function ProfessionState.select(
    state: State,
    professionId: string,
    now: number,
    canSwitch: boolean
): (State, any)
    if not ProfessionCatalog.isValid(professionId) then
        return state,
            {
                accepted = false,
                changed = false,
                reason = "unknown_profession",
            }
    end
    if not canSwitch then
        return state,
            {
                accepted = false,
                changed = false,
                reason = "switch_unavailable",
            }
    end
    if state.selectedId == professionId then
        return state,
            {
                accepted = true,
                changed = false,
                reason = "already_selected",
            }
    end

    local nextState: State = table.clone(state)
    nextState.selectedId = professionId
    nextState.cooldownReadyAt = math.max(state.cooldownReadyAt, now)
    nextState.activeUntil = now
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            changed = true,
            reason = "selected",
        }
end

function ProfessionState.canUse(state: State, now: number, canAct: boolean): any
    if not canAct then
        return {
            accepted = false,
            reason = "player_cannot_act",
        }
    end
    local professionId = state.selectedId
    if professionId == nil then
        return {
            accepted = false,
            reason = "profession_required",
        }
    end
    local definition = ProfessionCatalog.get(professionId)
    if definition == nil then
        return {
            accepted = false,
            reason = "unknown_profession",
        }
    end
    if now < state.cooldownReadyAt then
        return {
            accepted = false,
            reason = "cooldown",
            remaining = state.cooldownReadyAt - now,
        }
    end
    return {
        accepted = true,
        definition = definition,
    }
end

function ProfessionState.commitAbility(
    state: State,
    now: number,
    cooldownSeconds: number?,
    activeSeconds: number?
): (State, any)
    local professionId = state.selectedId
    local definition = if professionId == nil then nil else ProfessionCatalog.get(professionId)
    assert(definition ~= nil, "cannot commit a profession ability without a valid profession")

    local nextState: State = table.clone(state)
    local resolvedCooldown = if cooldownSeconds ~= nil
            and validNumber(cooldownSeconds)
            and cooldownSeconds >= 1
        then cooldownSeconds
        else definition.cooldownSeconds
    local resolvedActive = if activeSeconds ~= nil
            and validNumber(activeSeconds)
            and activeSeconds >= 0
        then activeSeconds
        else definition.activeSeconds
    nextState.cooldownReadyAt = now + resolvedCooldown
    nextState.activeUntil = now + resolvedActive
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            abilityId = definition.abilityId,
            activeUntil = nextState.activeUntil,
            cooldownReadyAt = nextState.cooldownReadyAt,
        }
end

function ProfessionState.mitigatesDamage(state: State, now: number): boolean
    return state.selectedId == ProfessionCatalog.Ids.Warden and now < state.activeUntil
end

function ProfessionState.snapshot(state: State, now: number): any
    local definition = if state.selectedId == nil
        then nil
        else ProfessionCatalog.get(state.selectedId)
    return {
        selectedId = state.selectedId,
        displayName = if definition == nil then nil else definition.displayName,
        abilityId = if definition == nil then nil else definition.abilityId,
        abilityName = if definition == nil then nil else definition.abilityName,
        abilityDescription = if definition == nil then nil else definition.abilityDescription,
        cooldownReadyAt = state.cooldownReadyAt,
        cooldownSeconds = if definition == nil then 0 else definition.cooldownSeconds,
        activeUntil = state.activeUntil,
        ready = definition ~= nil and now >= state.cooldownReadyAt,
        revision = state.revision,
    }
end

return table.freeze(ProfessionState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">ProfileBackup</string>
          <string name="Source"><![CDATA[--!strict

--[[
    When a save is copied aside, which copies are kept, and what a restore
    writes back.

    Milestone 4's persistence deliverable asks for "versioned profile, locking,
    autosave, shutdown, migrations, backups". Everything but the last of those
    already exists in ProfileService and ProfilePersistence. This module is the
    last one, and it is deliberately the same shape as ProfilePersistence: pure
    decisions about state, no DataStore, so the properties that matter can be
    tested rather than argued about.

    TECHNICAL_ARCHITECTURE names the requirement that drove the design: "Backups
    and export tooling are required before migrations that alter inventory or
    commerce." A migration in this codebase is not a numbered pipeline -- it is
    SaveSchema.normalize folding an older profile into the current default --
    which means a migration that drops a field drops it silently and leaves
    nothing behind to compare against. So the moment a stored profile arrives
    carrying a schema version other than the current one is the moment worth
    photographing, and `shouldCapture` treats it as unconditional.

    Two properties are load-bearing, and both are easy to get wrong in a way
    that is invisible until someone actually needs a restore:

      * **A restored profile must out-rank the profile it replaces.**
        ProfilePersistence.resolveWrite retains the stored copy whenever its
        revision is higher, which is exactly right for two servers racing and
        exactly wrong for a restore -- a restore is a deliberate move backwards
        in content and must still be a move forwards in revision, or it writes
        nothing and reports success.
      * **A snapshot never carries a session lock.** Locks ride along inside the
        saved profile so a crashed server leaves a heartbeat that stops. Copy one
        into a backup and a restore months later resurrects a lock held by a job
        that no longer exists, and the player is read-only until someone runs
        /unlock. Snapshots are stripped on the way in, not on the way out, so
        even a backup written by an older build cannot carry one through.
]]

local ProfileBackup = {}

export type Snapshot = {
    revision: number,
    capturedAt: number,
    schemaVersion: number,
    reason: string,
    profile: any,
}

export type Ring = {
    version: number,
    snapshots: { Snapshot },
}

export type CaptureDecision = {
    capture: boolean,
    reason: string,
}

-- Why a snapshot was taken. Kept as a closed set so an operator reading an
-- audit line sees one of a handful of known words rather than free text.
local CAPTURE_REASONS: { [string]: boolean } = table.freeze({
    schema_change = true,
    first_backup = true,
    interval = true,
    pre_restore = true,
})

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeAtLeast(value: any, low: number): boolean
    return finite(value) and value == math.floor(value) and value >= low
end

function ProfileBackup.default(): Ring
    return { version = 1, snapshots = {} }
end

function ProfileBackup.captureReasons(): { string }
    local reasons: { string } = {}
    for reason in CAPTURE_REASONS do
        table.insert(reasons, reason)
    end
    table.sort(reasons)
    return reasons
end

--[[
    Read whatever the backup key held into a ring this build understands.

    Forgiving in the same way SaveSchema.normalize is forgiving, and for the
    same reason: a backup that cannot be parsed must degrade to "no backups"
    rather than to an error, because the caller is usually a load path that has
    a player waiting on it. A malformed entry is dropped individually so one bad
    snapshot cannot cost a player the good ones sitting next to it.
]]
function ProfileBackup.normalize(value: any): Ring
    local ring = ProfileBackup.default()
    if type(value) ~= "table" or type(value.snapshots) ~= "table" then
        return ring
    end

    for _, candidate in value.snapshots do
        if
            type(candidate) == "table"
            and type(candidate.profile) == "table"
            and wholeAtLeast(candidate.revision, 0)
            and finite(candidate.capturedAt)
            and wholeAtLeast(candidate.schemaVersion, 1)
            and type(candidate.reason) == "string"
            and CAPTURE_REASONS[candidate.reason] == true
        then
            local profile = table.clone(candidate.profile)
            -- Defence in depth: strip on the way out as well as on the way in,
            -- so a snapshot written by a build that predates this rule cannot
            -- carry a dead lock into a restore.
            profile.sessionLock = nil
            table.insert(ring.snapshots, {
                revision = math.floor(candidate.revision),
                capturedAt = candidate.capturedAt,
                schemaVersion = math.floor(candidate.schemaVersion),
                reason = candidate.reason,
                profile = profile,
            })
        end
    end

    return ring
end

--[[
    Whether this save is worth copying aside right now.

    A backup on every autosave would double the write traffic of the busiest
    path in the game to photograph a profile that has usually not meaningfully
    changed, so ordinary captures are rate limited. A schema change is not
    ordinary and ignores the limit: it is the one moment where the old shape
    stops being recoverable from the new one.
]]
function ProfileBackup.shouldCapture(
    ring: any,
    storedSchemaVersion: any,
    currentSchemaVersion: number,
    now: number,
    interval: number
): CaptureDecision
    assert(
        wholeAtLeast(currentSchemaVersion, 1),
        "current schema version must be a positive whole number"
    )
    assert(finite(now), "capture time must be finite")
    assert(finite(interval) and interval > 0, "capture interval must be positive")

    -- An unreadable or absent stored schema version is treated as a change: it
    -- means the profile did not come from this build, which is precisely when a
    -- copy is worth having.
    if not wholeAtLeast(storedSchemaVersion, 1) or storedSchemaVersion ~= currentSchemaVersion then
        return { capture = true, reason = "schema_change" }
    end

    local normalized = ProfileBackup.normalize(ring)
    local newest = ProfileBackup.newest(normalized)
    if newest == nil then
        return { capture = true, reason = "first_backup" }
    end
    if now - newest.capturedAt >= interval then
        return { capture = true, reason = "interval" }
    end
    return { capture = false, reason = "recent_backup_exists" }
end

--[[
    Append a snapshot, dropping the oldest beyond `limit`.

    Returns a new ring; the input is never mutated, so a failed DataStore write
    cannot leave the caller holding a ring that claims a snapshot it never
    stored. The bound exists because a DataStore value has a hard size ceiling
    and a profile is not small -- an unbounded history would eventually fail
    every write to this key, silently taking backups down at the exact moment
    the save is growing fastest.
]]
function ProfileBackup.capture(
    ring: any,
    profile: any,
    now: number,
    reason: string,
    limit: number
): Ring
    assert(type(profile) == "table", "a snapshot needs a profile")
    assert(finite(now), "capture time must be finite")
    assert(CAPTURE_REASONS[reason] == true, "unknown capture reason: " .. tostring(reason))
    assert(wholeAtLeast(limit, 1), "retained backup count must be at least one")

    local normalized = ProfileBackup.normalize(ring)

    local copied = table.clone(profile)
    -- The lock belongs to the session that wrote the save, never to the copy.
    copied.sessionLock = nil

    local snapshot: Snapshot = {
        revision = if wholeAtLeast(profile.revision, 0) then math.floor(profile.revision) else 0,
        capturedAt = now,
        schemaVersion = if wholeAtLeast(profile.schemaVersion, 1)
            then math.floor(profile.schemaVersion)
            else 1,
        reason = reason,
        profile = copied,
    }

    local snapshots = table.clone(normalized.snapshots)
    table.insert(snapshots, snapshot)
    while #snapshots > limit do
        table.remove(snapshots, 1)
    end

    return { version = normalized.version, snapshots = snapshots }
end

-- The most recently captured snapshot, or nil when there are none.
function ProfileBackup.newest(ring: any): Snapshot?
    local normalized = if type(ring) == "table"
            and type(ring.snapshots) == "table"
            and ring.version ~= nil
        then ring :: Ring
        else ProfileBackup.normalize(ring)
    local count = #normalized.snapshots
    if count == 0 then
        return nil
    end
    return normalized.snapshots[count]
end

--[[
    A specific copy, 1 = the oldest kept. Bounded and explicit: an operator
    restoring history names the copy they read in /backups, and an index off
    either end is nil rather than a clamp -- silently restoring a different
    copy than the one asked for is the one unforgivable behaviour here.
]]
function ProfileBackup.snapshotAt(ring: any, index: number): Snapshot?
    local normalized = if type(ring) == "table"
            and type(ring.snapshots) == "table"
            and ring.version ~= nil
        then ring :: Ring
        else ProfileBackup.normalize(ring)
    if type(index) ~= "number" or index ~= math.floor(index) then
        return nil
    end
    return normalized.snapshots[index]
end

--[[
    The profile a restore should write.

    `storedRevision` is the revision currently sitting in the live profile key,
    not the one in the snapshot. The returned profile takes a revision above
    both, because a restore has to survive ProfilePersistence.resolveWrite --
    which, left to itself, would see an old revision arriving over a newer one
    and correctly refuse it. Getting this wrong produces the worst possible
    failure mode: a restore that logs success and changes nothing.
]]
function ProfileBackup.restoredProfile(snapshot: any, storedRevision: any, now: number): any
    assert(
        type(snapshot) == "table" and type(snapshot.profile) == "table",
        "a restore needs a snapshot"
    )
    assert(finite(now), "restore time must be finite")

    local restored = table.clone(snapshot.profile)
    restored.sessionLock = nil
    restored.updatedAt = now

    local snapshotRevision = if wholeAtLeast(snapshot.revision, 0) then snapshot.revision else 0
    local liveRevision = if wholeAtLeast(storedRevision, 0) then storedRevision else 0
    restored.revision = math.max(snapshotRevision, liveRevision) + 1

    return restored
end

--[[
    What an operator sees before deciding to restore.

    Deliberately counts and timestamps rather than profile contents: an admin
    choosing whether to roll a save back needs to know how far back it goes and
    what shape it was in, and the full contents are what /inspect is for.
]]
function ProfileBackup.summary(ring: any): any
    local normalized = ProfileBackup.normalize(ring)
    local entries = {}
    for _, snapshot in normalized.snapshots do
        table.insert(entries, {
            revision = snapshot.revision,
            capturedAt = snapshot.capturedAt,
            schemaVersion = snapshot.schemaVersion,
            reason = snapshot.reason,
        })
    end
    local newest = ProfileBackup.newest(normalized)
    return {
        count = #entries,
        entries = entries,
        newestRevision = if newest ~= nil then newest.revision else nil,
        newestCapturedAt = if newest ~= nil then newest.capturedAt else nil,
    }
end

return table.freeze(ProfileBackup)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">ProfilePersistence</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The decisions ProfileService makes about a save, separated from the calls
    it makes to reach one.

    Milestone 4's exit gate asks that forced crashes, lock contention, write
    failure, stale revision, and shutdown all pass. Every one of those is a
    decision about state -- should this load be trusted, may this server claim
    this profile, whose copy wins -- and none of them needs a DataStore to
    answer. They live here so the gate can be tested rather than argued about,
    and so the one place that decides whether a save may be overwritten is a
    place you can read in one sitting.

    The property everything else protects: **a save is never overwritten by a
    profile that failed to load.** A DataStore read that errors or times out
    produces a playable session with a default profile and no write permission,
    because the alternative -- treating "I could not read your save" as "you
    have no save" -- deletes a player's game during a Roblox outage. That is
    the single worst thing this system could do, and it is why loadOutcome
    returns writable = false on every unhappy path.
]]

local ProfilePersistence = {}

export type Lock = {
    jobId: string,
    heartbeat: number,
}

export type LoadOutcome = {
    source: string,
    writable: boolean,
    useStored: boolean,
}

export type LockDecision = {
    acquired: boolean,
    reason: string,
}

export type WriteDecision = {
    action: string,
    reason: string,
}

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

--[[
    What a load attempt produced.

    `finished` is whether the request came back at all before the deadline, and
    `ok` whether it came back without erroring. Only the path where both hold
    and the store answered may write.
]]
function ProfilePersistence.loadOutcome(finished: boolean, ok: boolean, stored: any): LoadOutcome
    if not finished then
        -- The request never returned. Somebody else's copy may still be live;
        -- writing over it from here would be guessing.
        return { source = "read_only", writable = false, useStored = false }
    end
    if not ok then
        return { source = "read_only", writable = false, useStored = false }
    end
    if stored == nil then
        return { source = "new", writable = true, useStored = false }
    end
    return { source = "datastore", writable = true, useStored = true }
end

--[[
    Whether this server may claim a profile.

    A lock is a job ID and a heartbeat. The heartbeat is what makes a crash
    survivable: a server that dies never releases its lock, so the only way the
    player ever plays again is for a later session to reclaim a lock that has
    stopped beating. `staleAfter` therefore has to exceed the heartbeat interval
    by enough that a slow save is not mistaken for a dead server.

    Two shapes of bad data are treated as unlocked rather than as locked, on the
    principle that corrupt bookkeeping must never cost a player their save
    permanently: a lock that is not a well-formed record, and a lock whose
    heartbeat is far enough in the future that it cannot be a real clock.
]]
function ProfilePersistence.acquireLock(
    existing: any,
    jobId: string,
    now: number,
    staleAfter: number
): LockDecision
    assert(type(jobId) == "string" and jobId ~= "", "a lock needs a job ID")
    assert(finite(now), "lock time must be finite")
    assert(finite(staleAfter) and staleAfter > 0, "stale threshold must be positive")

    if existing == nil then
        return { acquired = true, reason = "unlocked" }
    end
    if
        type(existing) ~= "table"
        or type(existing.jobId) ~= "string"
        or existing.jobId == ""
        or not finite(existing.heartbeat)
    then
        return { acquired = true, reason = "malformed_lock" }
    end
    if existing.jobId == jobId then
        return { acquired = true, reason = "already_held" }
    end

    local age = now - existing.heartbeat
    if age >= staleAfter then
        return { acquired = true, reason = "reclaimed_stale" }
    end
    if age < -staleAfter then
        -- A heartbeat from the future by more than the whole stale window is a
        -- broken clock, not a live server holding the profile.
        return { acquired = true, reason = "reclaimed_future" }
    end
    return { acquired = false, reason = "held_by_another_server" }
end

function ProfilePersistence.lock(jobId: string, now: number): Lock
    return { jobId = jobId, heartbeat = now }
end

--[[
    Whose copy of a profile wins.

    Two servers can hold the same profile briefly -- a reclaimed lock, a
    teleport, a rejoin before the old session flushed. Revision is the tie
    break, and the rule is that the higher revision is never overwritten by a
    lower one. Losing here is not a failure: it means the copy in memory is
    behind, and the caller adopts the stored one instead of pushing stale
    progress over fresh progress.
]]
function ProfilePersistence.resolveWrite(stored: any, pending: any): WriteDecision
    assert(type(pending) == "table" and finite(pending.revision), "a write needs a revision")

    if stored == nil then
        return { action = "write", reason = "no_stored_profile" }
    end
    if type(stored) ~= "table" or not finite(stored.revision) then
        -- Unreadable stored data is replaced rather than deferred to: deferring
        -- would strand the player on a profile nothing can parse.
        return { action = "write", reason = "stored_profile_unreadable" }
    end
    if stored.revision > pending.revision then
        return { action = "retain_stored", reason = "stored_revision_is_newer" }
    end
    return { action = "write", reason = "pending_revision_is_current" }
end

-- Whether a heartbeat is due. Kept here so the interval that refreshes a lock
-- and the threshold that reclaims one stay visibly related.
function ProfilePersistence.shouldRefreshLock(
    lastHeartbeat: any,
    now: number,
    interval: number
): boolean
    if not finite(lastHeartbeat) then
        return true
    end
    return now - lastHeartbeat >= interval
end

return table.freeze(ProfilePersistence)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">QuestCatalog</string>
          <string name="Source"><![CDATA[--!strict

local QuestCatalog = {}

export type Objective = {
    kind: string,
    threshold: number,
}

export type Reward = {
    materialId: string,
    amount: number,
}

export type Quest = {
    id: string,
    displayName: string,
    objective: Objective,
    reward: Reward,
}

--[[
    Chapter I's three come first and keep their exact ids, thresholds and
    rewards. The eight that follow belong to the residents Milestone 7
    brings back from the Delve and the Fen -- each one asks for something
    that resident would actually care about, and every objective is
    computed from facts the profile already records.
]]
local ORDER = table.freeze({
    "quest_survive_three_nights",
    "quest_first_craft",
    "quest_bramblewake_veteran",
    -- Ironroot Delve residents
    "quest_delve_smith",
    "quest_rail_keeper",
    "quest_lamp_trimmer",
    "quest_deep_cook",
    -- Mireglass Fen residents
    "quest_ferry_ledger",
    "quest_reed_weaver",
    "quest_glass_reader",
    "quest_fen_healer",
})

local DEFINITIONS: { [string]: Quest } = {
    quest_survive_three_nights = table.freeze({
        id = "quest_survive_three_nights",
        displayName = "THREE NIGHTS SURVIVED",
        objective = table.freeze({ kind = "survive_nights", threshold = 3 }),
        reward = table.freeze({ materialId = "material_heartwood", amount = 5 }),
    }),
    quest_first_craft = table.freeze({
        id = "quest_first_craft",
        displayName = "FIRST CRAFT",
        objective = table.freeze({ kind = "craft_items", threshold = 1 }),
        reward = table.freeze({ materialId = "material_amber_sap", amount = 3 }),
    }),
    quest_bramblewake_veteran = table.freeze({
        id = "quest_bramblewake_veteran",
        displayName = "BRAMBLEWAKE VETERAN",
        objective = table.freeze({ kind = "bramblewake_settlements", threshold = 3 }),
        reward = table.freeze({ materialId = "material_brightcap", amount = 3 }),
    }),

    -- Hesper kept her tools when she lost everything else, and measures
    -- people by whether they keep theirs.
    quest_delve_smith = table.freeze({
        id = "quest_delve_smith",
        displayName = "A SMITH'S MEASURE",
        objective = table.freeze({ kind = "gear_traits", threshold = 3 }),
        reward = table.freeze({ materialId = "material_heartwood", amount = 6 }),
    }),
    -- Odell hauled for a mine that stopped paying; a full store is the
    -- only thing that makes him sit down.
    quest_rail_keeper = table.freeze({
        id = "quest_rail_keeper",
        displayName = "THE STORES ARE FULL",
        objective = table.freeze({ kind = "materials_banked", threshold = 60 }),
        reward = table.freeze({ materialId = "material_spring_clay", amount = 4 }),
    }),
    -- Junie counts nights the way other people count money.
    quest_lamp_trimmer = table.freeze({
        id = "quest_lamp_trimmer",
        displayName = "SEVEN LIT NIGHTS",
        objective = table.freeze({ kind = "survive_nights", threshold = 7 }),
        reward = table.freeze({ materialId = "material_amber_sap", amount = 5 }),
    }),
    -- Bartram fed a hundred people on nothing and still thinks the pantry
    -- is short; he is satisfied by a town that builds its own kitchen.
    quest_deep_cook = table.freeze({
        id = "quest_deep_cook",
        displayName = "SOMEWHERE TO COOK",
        objective = table.freeze({ kind = "buildings_raised", threshold = 4 }),
        reward = table.freeze({ materialId = "material_brightcap", amount = 4 }),
    }),

    -- Saoirse's ledger recorded names out and names back. She wants to
    -- see a column that balances.
    quest_ferry_ledger = table.freeze({
        id = "quest_ferry_ledger",
        displayName = "NAMES OUT, NAMES BACK",
        objective = table.freeze({ kind = "bramblewake_settlements", threshold = 8 }),
        reward = table.freeze({ materialId = "material_heartwood", amount = 8 }),
    }),
    -- Dabbler left a woven figure for every house the water took, and
    -- would rather this town be decorated than remembered.
    quest_reed_weaver = table.freeze({
        id = "quest_reed_weaver",
        displayName = "SOMETHING WOVEN",
        objective = table.freeze({ kind = "decorations_placed", threshold = 3 }),
        reward = table.freeze({ materialId = "material_meadow_fiber", amount = 6 }),
    }),
    -- Marek read glass for a living and knows most people never look
    -- twice at what they carry.
    quest_glass_reader = table.freeze({
        id = "quest_glass_reader",
        displayName = "LOOK TWICE",
        objective = table.freeze({ kind = "craft_items", threshold = 6 }),
        reward = table.freeze({ materialId = "material_amber_sap", amount = 6 }),
    }),
    -- Lissen still counts heads at dusk. Bonds are how she counts.
    quest_fen_healer = table.freeze({
        id = "quest_fen_healer",
        displayName = "COUNT EVERY HEAD",
        objective = table.freeze({ kind = "residents_bonded", threshold = 3 }),
        reward = table.freeze({ materialId = "material_brightcap", amount = 6 }),
    }),
}

function QuestCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function QuestCatalog.get(id: string): Quest?
    return DEFINITIONS[id]
end

function QuestCatalog.list(): { Quest }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

return table.freeze(QuestCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[--!strict

local QuestCatalog = require("./QuestCatalog")

local Quests = {}

export type Signals = {
    nightsSurvived: number,
    craftedItems: number,
    bramblewakeSettlements: number,
    -- Milestone 7's resident quests. Every one of these is derived from
    -- something the profile already stores, so no new tracking rides
    -- along with the new residents.
    buildingsRaised: number,
    decorationsPlaced: number,
    gearTraits: number,
    materialsBanked: number,
    residentsBonded: number,
}

local function currentValue(kind: string, signals: Signals): number
    if kind == "survive_nights" then
        return signals.nightsSurvived
    elseif kind == "craft_items" then
        return signals.craftedItems
    elseif kind == "bramblewake_settlements" then
        return signals.bramblewakeSettlements
    elseif kind == "buildings_raised" then
        return signals.buildingsRaised
    elseif kind == "decorations_placed" then
        return signals.decorationsPlaced
    elseif kind == "gear_traits" then
        return signals.gearTraits
    elseif kind == "materials_banked" then
        return signals.materialsBanked
    elseif kind == "residents_bonded" then
        return signals.residentsBonded
    end
    return 0
end

function Quests.default(): { [string]: boolean }
    return {}
end

function Quests.normalizeClaimed(value: any): { [string]: boolean }
    local claimed: { [string]: boolean } = {}
    if type(value) ~= "table" then
        return claimed
    end
    for questId, isClaimed in value do
        if QuestCatalog.isValid(questId) and isClaimed == true then
            claimed[questId] = true
        end
    end
    return claimed
end

-- Progress is always read live from `signals`, never stored, so a quest
-- that briefly regresses (e.g. crafting an item and then using it up)
-- doesn't lose credit once already claimed — only the claimed set persists.
function Quests.progress(questId: string, signals: Signals): (number, number, boolean)
    if not QuestCatalog.isValid(questId) then
        return 0, 0, false
    end
    local quest = QuestCatalog.get(questId) :: QuestCatalog.Quest
    local current = currentValue(quest.objective.kind, signals)
    local threshold = quest.objective.threshold
    return current, threshold, current >= threshold
end

function Quests.snapshot(claimed: { [string]: boolean }, signals: Signals): { any }
    local result = {}
    for _, quest in QuestCatalog.list() do
        local current, threshold, complete = Quests.progress(quest.id, signals)
        table.insert(result, {
            claimed = claimed[quest.id] == true,
            complete = complete,
            displayName = quest.displayName,
            id = quest.id,
            progress = current,
            threshold = threshold,
        })
    end
    return result
end

-- Silently claims every not-yet-claimed quest whose objective is currently
-- met, granting each one's material reward. Called opportunistically after
-- any action that could move a signal (a night completing, a craft
-- succeeding, an expedition settling) rather than through an accept step.
-- Resident quest-givers surface this progress and its story context, so a quest that's already
-- satisfiable claims itself the moment it's checked.
function Quests.checkAndClaim(
    claimed: { [string]: boolean },
    materials: { [string]: number },
    signals: Signals
): ({ [string]: boolean }, { [string]: number }, { any })
    local claimedResults = {}
    local nextClaimed = claimed
    local nextMaterials = materials

    for _, quest in QuestCatalog.list() do
        if claimed[quest.id] ~= true then
            local _current, _threshold, complete = Quests.progress(quest.id, signals)
            if complete then
                if nextClaimed == claimed then
                    nextClaimed = table.clone(claimed)
                end
                if nextMaterials == materials then
                    nextMaterials = table.clone(materials)
                end
                nextClaimed[quest.id] = true
                nextMaterials[quest.reward.materialId] = (
                    nextMaterials[quest.reward.materialId] or 0
                ) + quest.reward.amount
                table.insert(claimedResults, {
                    displayName = quest.displayName,
                    questId = quest.id,
                    reward = table.clone(quest.reward),
                })
            end
        end
    end

    return nextClaimed, nextMaterials, claimedResults
end

return table.freeze(Quests)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--!strict

local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Limiter = typeof(setmetatable(
    {} :: {
        _rate: number,
        _burst: number,
        _buckets: { [string]: { tokens: number, updatedAt: number } },
    },
    RateLimiter
))

function RateLimiter.new(ratePerSecond: number, burst: number): Limiter
    assert(ratePerSecond > 0, "rate must be positive")
    assert(burst >= 1, "burst must be at least one")
    return setmetatable({
        _rate = ratePerSecond,
        _burst = burst,
        _buckets = {},
    }, RateLimiter)
end

function RateLimiter.allow(self: Limiter, key: string, now: number, cost: number?): boolean
    local requested = cost or 1
    if requested <= 0 then
        return true
    end

    local bucket = self._buckets[key]
    if bucket == nil then
        bucket = { tokens = self._burst, updatedAt = now }
        self._buckets[key] = bucket
    end

    local elapsed = math.max(0, now - bucket.updatedAt)
    bucket.tokens = math.min(self._burst, bucket.tokens + elapsed * self._rate)
    bucket.updatedAt = now

    if bucket.tokens < requested then
        return false
    end

    bucket.tokens -= requested
    return true
end

function RateLimiter.clear(self: Limiter, key: string)
    self._buckets[key] = nil
end

return table.freeze(RateLimiter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">RegionAccess</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Which regions a departure may actually target.

    Three regions now exist as content, but existence is not access: a
    region is walkable only when its catalog has a builder (the Regions
    registry's `enabled` flag, still false for everything but
    Bramblewake), its registry dependencies are themselves enabled, and
    the story has reached its chapter. This module is the one place those
    three tests compose, so the departure flow, the generator call, and a
    future region-select UI all refuse for the same reasons in the same
    order.

    Today every request resolves to Bramblewake, exactly as before this
    module existed. When the Delve's builder lands, flipping its `enabled`
    flag in Content/Definitions/Regions.luau is the whole switch -- the
    chapter gate is already waiting behind it.
]]

local ChapterCatalog = require("./ChapterCatalog")
local Regions = require("./Content/Definitions/Regions")

local RegionAccess = {}

export type Verdict = {
    allowed: boolean,
    reason: string,
}

local REGIONS_BY_ID: { [string]: any } = {}
for _, region in Regions do
    REGIONS_BY_ID[region.id] = region
end
table.freeze(REGIONS_BY_ID)

local DEFAULT_REGION_ID = "region_bramblewake"

RegionAccess.DefaultRegionId = DEFAULT_REGION_ID

local function chapterComplete(story: any, chapterId: string?): boolean
    if chapterId == nil then
        return true
    end
    if type(story) ~= "table" then
        return false
    end
    if chapterId == "chapter_one" then
        return type(story.chapterOne) == "table" and story.chapterOne.status == "complete"
    end
    local chapters = story.chapters
    if type(chapters) ~= "table" then
        return false
    end
    local record = chapters[chapterId]
    return type(record) == "table" and record.status == "complete"
end

--[[
    Has the story reached a region's chapter? A region belongs to the
    chapter it hosts, and that chapter is playable once its prerequisite
    chapter is complete -- Bramblewake needs nothing, the Delve needs the
    Warden resolved, the Fen needs the Maw.
]]
function RegionAccess.chapterReached(story: any, regionId: any): boolean
    local chapter = ChapterCatalog.forRegion(regionId)
    if chapter == nil then
        -- a region with no chapter (a future postgame area) is gated only
        -- by its enabled flag
        return true
    end
    return chapterComplete(story, (chapter :: any).requires)
end

--[[
    Readiness is the server's business (the builders live there), so the
    shared layer takes it as an injected fact rather than reaching for a
    server module it cannot see. Absent, every enabled region is treated
    as walkable, which is the behavior this module had before readiness
    existed.
]]
local readinessProvider: ((string) -> boolean)? = nil

function RegionAccess.setReadinessProvider(provider: ((string) -> boolean)?)
    readinessProvider = provider
end

function RegionAccess.evaluate(regionId: any, story: any): Verdict
    local region = if type(regionId) == "string" then REGIONS_BY_ID[regionId] else nil
    if region == nil then
        return { allowed = false, reason = "region_unknown" }
    end
    if region.enabled ~= true then
        return { allowed = false, reason = "region_not_built" }
    end
    for _, dependencyId in region.dependencies do
        local dependency = REGIONS_BY_ID[dependencyId]
        if dependency == nil or dependency.enabled ~= true then
            return { allowed = false, reason = "region_dependency_missing" }
        end
    end
    if not RegionAccess.chapterReached(story, regionId) then
        return { allowed = false, reason = "chapter_not_reached" }
    end
    -- A region whose builder cannot yet draw a walkable world is refused
    -- even if somebody flips its enabled flag: the flag says "we mean to
    -- ship this", readiness says "a party would find something there".
    if readinessProvider ~= nil and not readinessProvider(regionId :: string) then
        return { allowed = false, reason = "region_not_walkable" }
    end
    return { allowed = true, reason = "open" }
end

-- The regions a departure could offer this profile, in registry order.
function RegionAccess.available(story: any): { string }
    local ids: { string } = {}
    for _, region in Regions do
        if RegionAccess.evaluate(region.id, story).allowed then
            table.insert(ids, region.id)
        end
    end
    return ids
end

--[[
    Resolve a requested destination. Anything that is not an open region
    resolves to Bramblewake rather than erroring -- a malformed or
    too-early request earns the default walk, never a broken server. The
    same shape ExpeditionContracts.resolve gives malformed contract ids.
]]
function RegionAccess.destinationFor(regionId: any, story: any): string
    if RegionAccess.evaluate(regionId, story).allowed then
        return regionId :: string
    end
    return DEFAULT_REGION_ID
end

return table.freeze(RegionAccess)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">ResidentDialogue</string>
          <string name="Source"><![CDATA[--!strict

local ResidentRoster = require("./ResidentRoster")

local ResidentDialogue = {}

export type Response = {
    message: string,
    questId: string,
    state: string,
}

--[[
    Names and quests come from the roster now; the two tables that used to
    hold them here were the first place the roster drifted, which is why
    it exists.
]]
local RESIDENT_QUESTS: { [string]: string } = {}
local RESIDENT_NAMES: { [string]: string } = {}
for _, definition in ResidentRoster.list() do
    RESIDENT_QUESTS[definition.id] = definition.questId
    RESIDENT_NAMES[definition.id] = definition.displayName
end
table.freeze(RESIDENT_QUESTS)
table.freeze(RESIDENT_NAMES)

--[[
    What the residents brought back from their own regions say once their
    work is done. Chapter I's three answer to the town's decisions, which
    is handled below; these four-and-four answer to the places they came
    from, and each one is a person rather than a job title.
]]
-- What each resident asks for, in their own words.
local GUIDANCE = table.freeze({
    npc_tomas_reed = "CRAFT ONE USEFUL ITEM AT THE WORKBENCH",
    npc_pip_wren = "HELP THE LANTERN ROAD SURVIVE THREE NIGHTS",
    npc_ena_moss = "RETURN SAFELY FROM BRAMBLEWAKE THREE TIMES",
    npc_hesper_vane = "BRING ME GEAR THAT HAS FOUND ITS OWN CHARACTER",
    npc_odell_crane = "FILL THE STORES — SIXTY OF ANYTHING WILL DO",
    npc_junie_falk = "KEEP THE LIGHT LIT FOR SEVEN NIGHTS",
    npc_bartram_hoke = "RAISE FOUR BUILDINGS SO THERE IS SOMEWHERE TO COOK",
    npc_saoirse_quill = "COME BACK FROM BRAMBLEWAKE EIGHT TIMES, AND I WILL RULE THE COLUMN",
    npc_wren_dabbler = "PUT UP THREE DECORATIONS — THIS TOWN SHOULD LOOK LIVED IN",
    npc_marek_still = "CRAFT SIX THINGS AND LOOK TWICE AT EACH",
    npc_lissen_ford = "BE TRUSTED BY THREE RESIDENTS — CHECK ON THEM",
})

local ARRIVAL_LINES = table.freeze({
    npc_hesper_vane = "A TOOL YOU KEPT SHARP IS A DAY YOU MEANT TO SURVIVE. BRING ME THE DULL ONES.",
    npc_odell_crane = "FULL STORES AND A QUIET BELL. I COULD ALMOST SIT DOWN.",
    npc_junie_falk = "SEVEN NIGHTS LIT IN A ROW. DOWN BELOW WE NEVER MANAGED THREE.",
    npc_bartram_hoke = "A REAL KITCHEN. I HAVE BEEN COOKING OUT OF A HELMET SINCE I WAS TWENTY.",
    npc_saoirse_quill = "NAMES OUT AND NAMES BACK, AND THE COLUMNS AGREE. I HAVE NOT WRITTEN THAT IN YEARS.",
    npc_wren_dabbler = "I WOVE ONE FOR EVERY HOUSE THE WATER TOOK. NOW I WEAVE THEM FOR DOORS THAT STAND.",
    npc_marek_still = "LOOK TWICE AT WHAT YOU CARRY. THE FEN TAUGHT ME THAT AND IT COST IT NOTHING.",
    npc_lissen_ford = "EVERY HEAD COUNTED AT DUSK, AND EVERY ONE OF THEM KNOWS YOUR NAME. THAT IS THE WORK.",
})

local function questById(quests: any, questId: string): any
    if type(quests) ~= "table" then
        return nil
    end
    for _, quest in quests do
        if type(quest) == "table" and quest.id == questId then
            return quest
        end
    end
    return nil
end

local function completedStory(residentId: string, consequence: any): string
    local arrival = ARRIVAL_LINES[residentId]
    if arrival ~= nil then
        return arrival
    end
    local decision = if type(consequence) == "table" then consequence.decision else nil
    local wardenOutcome = if type(consequence) == "table" then consequence.wardenOutcome else nil
    if residentId == "npc_tomas_reed" then
        if decision == "restore_farmland" then
            return "THE RENEWED FIELDS NEED TOOLS AS MUCH AS SEED. KEEP THE BENCH BUSY."
        elseif decision == "wild_regrowth" then
            return "THE WILD GROVE GIVES LESS ON COMMAND, BUT MORE TO THOSE WHO LISTEN."
        elseif decision == "shared_agroforest" then
            return "FOREST AND FIELD ARE SHARING ONE TABLE NOW. THAT IS WORTH BUILDING FOR."
        end
        return "ONE GOOD TOOL CAN TURN A BAD NIGHT. KEEP MAKING WHAT THE TOWN NEEDS."
    elseif residentId == "npc_pip_wren" then
        if wardenOutcome == "preserved" then
            return "THE WARDEN LEFT OLD TRACKS OPEN. I HAVE MARKED THE SAFEST ONES."
        elseif wardenOutcome == "scarred" then
            return "THE SCARRED TRAILS SHIFT AFTER RAIN. FOLLOW THE FRESH AMBER MARKS."
        elseif wardenOutcome == "harmed" then
            return "THE FOREST IS WATCHING THE ROAD NOW. TRAVEL WITH LIGHT AND COMPANY."
        end
        return "THREE DAWNS PROVE A ROAD CAN HOLD. THE NEXT ONE STILL NEEDS A SCOUT."
    elseif decision == "restore_farmland" then
        return "I SAVED BRAMBLEWAKE SEED FOR THESE FURROWS. THE FIRST SHOOTS ARE YOURS TOO."
    elseif decision == "wild_regrowth" then
        return "THE GROVE IS CHOOSING ITS OWN SHAPE. WATCH WHERE THE BRIGHTCAPS RETURN."
    elseif decision == "shared_agroforest" then
        return "ROOT, CROP, AND LANTERN ARE GROWING TOGETHER. KEEP BRINGING PEOPLE HOME."
    end
    return "EVERY SAFE RETURN TEACHES THE GREENWARD HOW TO GROW AROUND US."
end

function ResidentDialogue.respond(residentId: any, quests: any, consequence: any): Response?
    if type(residentId) ~= "string" then
        return nil
    end
    local questId = RESIDENT_QUESTS[residentId]
    local residentName = RESIDENT_NAMES[residentId]
    if questId == nil or residentName == nil then
        return nil
    end

    local quest = questById(quests, questId)
    if quest == nil then
        return {
            message = residentName .. ": CHECK BACK WHEN THE GREENWARD RECORDS ARE READY.",
            questId = questId,
            state = "loading",
        }
    end
    if quest.claimed == true then
        return {
            message = residentName .. ": " .. completedStory(residentId, consequence),
            questId = questId,
            state = "story",
        }
    end

    local current = math.max(0, math.floor(tonumber(quest.progress) or 0))
    local threshold = math.max(1, math.floor(tonumber(quest.threshold) or 1))
    local guidance = GUIDANCE[residentId] or "RETURN SAFELY FROM BRAMBLEWAKE THREE TIMES"
    return {
        message = string.format(
            "%s: %s — %d/%d. I WILL MARK IT WHEN IT IS DONE.",
            residentName,
            guidance,
            math.min(current, threshold),
            threshold
        ),
        questId = questId,
        state = if current >= threshold then "ready" else "active",
    }
end

return table.freeze(ResidentDialogue)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">ResidentLife</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Resident life: jobs, injury, bonds, and town crises.

    Milestone 4 asks for residents who are part of the town's systems rather
    than scenery on a schedule. This module is the whole of that judgement,
    kept pure — night outcomes in, next resident state out — so the specs can
    hold every rule still and the services stay wiring.

    Design rules this module enforces:
    - Everything here is deterministic. An injury is caused by a workplace
      falling, never by a dice roll, so a player can always answer "why".
    - Effects touch town systems only (repairs, warnings, the lantern's
      floor). No resident boon ever changes player damage, speed, or drops —
      that keeps the no-paid-power line easy to hold forever.
    - Bonds are per-profile: they are the town remembering *you*.
]]

local ResidentRoster = require("./ResidentRoster")

local ResidentLife = {}

export type ResidentState = {
    injuredUntilNight: number,
    bond: number,
    lastVisitNight: number,
}

export type State = { [string]: ResidentState }

export type Job = {
    residentId: string,
    buildingId: string,
    title: string,
    boon: string,
    boonLabel: string,
}

export type NightContext = {
    nightNumber: number,
    buildingIntegrity: { [string]: number },
    lanternHitFloor: boolean,
}

export type Crisis = {
    id: string,
    kind: string,
    title: string,
    detail: string,
    startedNight: number,
}

export type NightReport = {
    injuries: { string },
    recoveries: { string },
    crisis: Crisis?,
}

--[[
    Who exists, and what job each holds, now comes from ResidentRoster --
    one list instead of the several that used to drift apart. Chapter I's
    three still come first, in their original order, with their original
    jobs, so nothing about an existing town changes.
]]
local RESIDENT_IDS = ResidentRoster.Order

local JOBS: { [string]: Job } = table.freeze(ResidentRoster.jobs())

-- A workplace this damaged injures its keeper during the night's chaos.
local INJURY_INTEGRITY_THRESHOLD = 0.5
-- Nights of rest an injury costs, before anyone checks on them.
local INJURY_REST_NIGHTS = 2
local BOND_MAX = 100
local BOND_VISIT = 1
local BOND_CARE = 5

ResidentLife.Ids = RESIDENT_IDS
ResidentLife.Jobs = JOBS
ResidentLife.BondTiers = table.freeze({
    { threshold = 75, title = "KINDRED" },
    { threshold = 50, title = "TRUSTED" },
    { threshold = 25, title = "ACQUAINTED" },
    { threshold = 0, title = "NEWCOMER" },
})

local function defaultResident(): ResidentState
    return {
        injuredUntilNight = 0,
        bond = 0,
        lastVisitNight = 0,
    }
end

function ResidentLife.default(): State
    local state: State = {}
    for _, residentId in RESIDENT_IDS do
        state[residentId] = defaultResident()
    end
    return state
end

function ResidentLife.normalize(value: any): State
    local state = ResidentLife.default()
    if type(value) ~= "table" then
        return state
    end
    for _, residentId in RESIDENT_IDS do
        local stored = value[residentId]
        if type(stored) == "table" then
            local resident = state[residentId]
            resident.injuredUntilNight =
                math.max(0, math.floor(tonumber(stored.injuredUntilNight) or 0))
            resident.bond = math.clamp(math.floor(tonumber(stored.bond) or 0), 0, BOND_MAX)
            resident.lastVisitNight = math.max(0, math.floor(tonumber(stored.lastVisitNight) or 0))
        end
    end
    return state
end

function ResidentLife.isInjured(state: State, residentId: string, nightNumber: number): boolean
    local resident = state[residentId]
    return resident ~= nil and resident.injuredUntilNight >= nightNumber
end

function ResidentLife.bondTitle(bond: number): string
    for _, tier in ResidentLife.BondTiers do
        if bond >= tier.threshold then
            return tier.title
        end
    end
    return "NEWCOMER"
end

local function clone(state: State): State
    local next: State = {}
    for residentId, resident in state do
        next[residentId] = {
            injuredUntilNight = resident.injuredUntilNight,
            bond = resident.bond,
            lastVisitNight = resident.lastVisitNight,
        }
    end
    return next
end

--[[
    A night has ended; decide who it hurt and whether the town tips into
    crisis. Injuries come only from a resident's own workplace falling below
    half integrity while they were out defending it. Two or more injuries at
    once is a crisis: the clinic story writes itself, and the town needs its
    players to go check on people.
]]
function ResidentLife.resolveNight(state: State, context: NightContext): (State, NightReport)
    local nextState = clone(state)
    local report: NightReport = { injuries = {}, recoveries = {}, crisis = nil }
    for _, residentId in RESIDENT_IDS do
        local resident = nextState[residentId]
        local job = JOBS[residentId]
        local wasInjured = resident.injuredUntilNight >= context.nightNumber
        if not wasInjured and resident.injuredUntilNight > 0 then
            resident.injuredUntilNight = 0
            table.insert(report.recoveries, residentId)
        end
        local integrity = context.buildingIntegrity[job.buildingId]
        if not wasInjured and integrity ~= nil and integrity < INJURY_INTEGRITY_THRESHOLD then
            resident.injuredUntilNight = context.nightNumber + INJURY_REST_NIGHTS
            table.insert(report.injuries, residentId)
        end
    end

    local injuredNow = 0
    for _, residentId in RESIDENT_IDS do
        if ResidentLife.isInjured(nextState, residentId, context.nightNumber + 1) then
            injuredNow += 1
        end
    end
    if injuredNow >= 2 then
        report.crisis = {
            id = string.format("crisis_clinic_%d", context.nightNumber),
            kind = "care",
            title = "THE CLINIC IS FULL",
            detail = "Check on the injured residents to help them back on their feet.",
            startedNight = context.nightNumber,
        }
    elseif context.lanternHitFloor and injuredNow >= 1 then
        report.crisis = {
            id = string.format("crisis_darkwatch_%d", context.nightNumber),
            kind = "care",
            title = "A HARD NIGHT'S TOLL",
            detail = "The light nearly failed and someone was hurt. Check on them.",
            startedNight = context.nightNumber,
        }
    end
    return nextState, report
end

export type CheckResult = {
    accepted: boolean,
    reason: string?,
    healed: boolean,
    bond: number,
}

--[[
    A player checks on a resident. Injured: recovery accelerates by one night
    and the bond grows properly — care is how people become close. Healthy:
    a small bond nudge, once per night, so the loop is worth doing without
    being a tapping exercise.
]]
function ResidentLife.checkOn(
    state: State,
    residentId: string,
    nightNumber: number
): (State, CheckResult)
    local resident = state[residentId]
    if resident == nil then
        return state, { accepted = false, reason = "unknown_resident", healed = false, bond = 0 }
    end
    local nextState = clone(state)
    local target = nextState[residentId]
    if target.injuredUntilNight >= nightNumber then
        target.injuredUntilNight = math.max(0, target.injuredUntilNight - 1)
        target.bond = math.min(BOND_MAX, target.bond + BOND_CARE)
        target.lastVisitNight = nightNumber
        return nextState,
            {
                accepted = true,
                reason = nil,
                healed = target.injuredUntilNight < nightNumber,
                bond = target.bond,
            }
    end
    if target.lastVisitNight >= nightNumber then
        return state,
            {
                accepted = false,
                reason = "already_visited",
                healed = false,
                bond = target.bond,
            }
    end
    target.bond = math.min(BOND_MAX, target.bond + BOND_VISIT)
    target.lastVisitNight = nightNumber
    return nextState, { accepted = true, reason = nil, healed = false, bond = target.bond }
end

export type Boon = {
    residentId: string,
    boon: string,
    label: string,
}

--[[
    What the healthy, employed residents contribute at dawn. A resident sits
    a boon out while injured or while their workplace is an unbuilt site —
    which is exactly the pressure that makes repairs and rescues matter.
]]
function ResidentLife.dawnBoons(
    state: State,
    nightNumber: number,
    buildingStages: { [string]: number },
    activeResidentIds: { string }
): { Boon }
    local active: { [string]: boolean } = {}
    for _, residentId in activeResidentIds do
        active[residentId] = true
    end
    local boons: { Boon } = {}
    for _, residentId in RESIDENT_IDS do
        local job = JOBS[residentId]
        if
            active[residentId]
            and not ResidentLife.isInjured(state, residentId, nightNumber)
            and (buildingStages[job.buildingId] or 0) > 0
        then
            table.insert(boons, { residentId = residentId, boon = job.boon, label = job.boonLabel })
        end
    end
    return boons
end

--[[
    Snapshot for the client: status, job, and bond per resident, plus the
    crisis if one is standing. Pure formatting; the client renders it in the
    Field Book and never decides anything from it.
]]
function ResidentLife.snapshot(
    state: State,
    nightNumber: number,
    activeResidentIds: { string },
    crisis: Crisis?
): { [string]: any }
    local residents = {}
    local active: { [string]: boolean } = {}
    for _, residentId in activeResidentIds do
        active[residentId] = true
    end
    for _, residentId in RESIDENT_IDS do
        local resident = state[residentId]
        local job = JOBS[residentId]
        table.insert(residents, {
            residentId = residentId,
            title = job.title,
            buildingId = job.buildingId,
            present = active[residentId] == true,
            injured = ResidentLife.isInjured(state, residentId, nightNumber),
            bond = resident.bond,
            bondTitle = ResidentLife.bondTitle(resident.bond),
        })
    end
    return {
        residents = residents,
        crisis = crisis,
    }
end

return table.freeze(ResidentLife)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="74">
        <Properties>
          <string name="Name">ResidentRoster</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Who lives in Emberhollow, and who is going to.

    Three residents shipped with chapter I and have been named in half a
    dozen places since -- ResidentLife's job table, the dialogue module,
    the world's placement code. Milestone 7 adds eight more, drawn from
    the two new regions, and eight more hand-maintained lists is how a
    roster drifts out of agreement with itself. So the roster lives here
    once: identity, home region, when they arrive, the job they take, and
    the quest they carry.

    Arrival is the important field. A resident is not in town because a
    module exists; they arrive when their chapter does. Chapter I's three
    are present from the first dawn, the Delve's four arrive with chapter
    II, and the Fen's four with chapter III -- so a fresh save still meets
    exactly the three people it always met, and the town fills as the
    story does.

    Nobody here is a job title with a name attached. Each one wanted
    something in their own region, failed or half-succeeded at it, and
    brought that with them.
]]

local ResidentRoster = {}

export type Job = {
    residentId: string,
    buildingId: string,
    title: string,
    boon: string,
    boonLabel: string,
}

export type Resident = {
    id: string,
    displayName: string,
    fullName: string,
    homeRegion: string,
    arrivesInChapter: number,
    questId: string,
    job: Job,
    -- One line about who they are, for the world sign and the Field Book.
    introduction: string,
}

local function resident(definition: Resident): Resident
    return table.freeze({
        id = definition.id,
        displayName = definition.displayName,
        fullName = definition.fullName,
        homeRegion = definition.homeRegion,
        arrivesInChapter = definition.arrivesInChapter,
        questId = definition.questId,
        introduction = definition.introduction,
        job = table.freeze(definition.job),
    })
end

--[[
    Chapter I's three keep their exact ids, jobs, titles and boons -- this
    module inherits those definitions rather than restating them, so
    nothing about the town that exists today changes.
]]
local ORDER = table.freeze({
    "npc_tomas_reed",
    "npc_pip_wren",
    "npc_ena_moss",
    -- Ironroot Delve, chapter II
    "npc_hesper_vane",
    "npc_odell_crane",
    "npc_junie_falk",
    "npc_bartram_hoke",
    -- Mireglass Fen, chapter III
    "npc_saoirse_quill",
    "npc_wren_dabbler",
    "npc_marek_still",
    "npc_lissen_ford",
})

local DEFINITIONS: { [string]: Resident } = {
    npc_tomas_reed = resident({
        id = "npc_tomas_reed",
        displayName = "TOMAS",
        fullName = "Tomas Reed",
        homeRegion = "region_bramblewake",
        arrivesInChapter = 1,
        questId = "quest_first_craft",
        introduction = "Keeps the inn and the tool bench, and patches what the night breaks.",
        job = {
            residentId = "npc_tomas_reed",
            buildingId = "building_inn",
            title = "QUARTERMASTER",
            boon = "dawn_repair",
            boonLabel = "TOMAS PATCHES THE WORST-HIT BUILDING",
        },
    }),
    npc_pip_wren = resident({
        id = "npc_pip_wren",
        displayName = "PIP",
        fullName = "Pip Wren",
        homeRegion = "region_bramblewake",
        arrivesInChapter = 1,
        questId = "quest_survive_three_nights",
        introduction = "Runs the roads and posts what is coming before it arrives.",
        job = {
            residentId = "npc_pip_wren",
            buildingId = "building_town_board",
            title = "COURIER",
            boon = "night_forewarning",
            boonLabel = "PIP POSTS WORD OF THE COMING NIGHT",
        },
    }),
    npc_ena_moss = resident({
        id = "npc_ena_moss",
        displayName = "ENA",
        fullName = "Ena Moss",
        homeRegion = "region_bramblewake",
        arrivesInChapter = 1,
        questId = "quest_bramblewake_veteran",
        introduction = "Keeps seed and spark, and decides what the town plants next.",
        job = {
            residentId = "npc_ena_moss",
            buildingId = "building_workbench",
            title = "SEEDKEEPER",
            boon = "lantern_reserve",
            boonLabel = "ENA BANKS A SPARK RESERVE FOR THE LANTERN",
        },
    }),

    -- Ironroot Delve. Four people who worked a mine that stopped being a
    -- mine, and who each kept a different piece of it.
    npc_hesper_vane = resident({
        id = "npc_hesper_vane",
        displayName = "HESPER",
        fullName = "Hesper Vane",
        homeRegion = "region_ironroot",
        arrivesInChapter = 2,
        questId = "quest_delve_smith",
        introduction = "Shift smith. Came up with her tools and somebody else's tally book.",
        job = {
            residentId = "npc_hesper_vane",
            buildingId = "building_forge",
            title = "SHIFT SMITH",
            boon = "dawn_whetstone",
            boonLabel = "HESPER WHETS THE WORST-WORN GEAR IN TOWN",
        },
    }),
    npc_odell_crane = resident({
        id = "npc_odell_crane",
        displayName = "ODELL",
        fullName = "Odell Crane",
        homeRegion = "region_ironroot",
        arrivesInChapter = 2,
        questId = "quest_rail_keeper",
        introduction = "Ran the cart lines. Still flinches when a bell rings twice.",
        job = {
            residentId = "npc_odell_crane",
            buildingId = "building_market",
            title = "RAIL KEEPER",
            boon = "dawn_haulage",
            boonLabel = "ODELL HAULS AN EXTRA BUNDLE IN BEFORE DAWN",
        },
    }),
    npc_junie_falk = resident({
        id = "npc_junie_falk",
        displayName = "JUNIE",
        fullName = "Junie Falk",
        homeRegion = "region_ironroot",
        arrivesInChapter = 2,
        questId = "quest_lamp_trimmer",
        introduction = "Trimmed lamps below. Will not sit with her back to a dark doorway.",
        job = {
            residentId = "npc_junie_falk",
            buildingId = "building_first_lantern",
            title = "LAMP TRIMMER",
            boon = "lantern_trim",
            boonLabel = "JUNIE TRIMS THE FIRST LANTERN BEFORE NIGHTFALL",
        },
    }),
    npc_bartram_hoke = resident({
        id = "npc_bartram_hoke",
        displayName = "BARTRAM",
        fullName = "Bartram Hoke",
        homeRegion = "region_ironroot",
        arrivesInChapter = 2,
        questId = "quest_deep_cook",
        introduction = "Fed a hundred miners on nothing. Cooks like the pantry is still short.",
        job = {
            residentId = "npc_bartram_hoke",
            buildingId = "building_kitchen",
            title = "PIT COOK",
            boon = "dawn_ration",
            boonLabel = "BARTRAM SETS OUT A HOT RATION AT DAWN",
        },
    }),

    -- Mireglass Fen. Four people from a country that drowned slowly
    -- enough for everyone to argue about whether it was drowning.
    npc_saoirse_quill = resident({
        id = "npc_saoirse_quill",
        displayName = "SAOIRSE",
        fullName = "Saoirse Quill",
        homeRegion = "region_mireglass",
        arrivesInChapter = 3,
        questId = "quest_ferry_ledger",
        introduction = "Kept the ferry ledger. Knows exactly how many did not come back.",
        job = {
            residentId = "npc_saoirse_quill",
            buildingId = "building_archive",
            title = "LEDGER KEEPER",
            boon = "dawn_accounting",
            boonLabel = "SAOIRSE FINDS A MISFILED BUNDLE IN THE STORES",
        },
    }),
    npc_wren_dabbler = resident({
        id = "npc_wren_dabbler",
        displayName = "DABBLER",
        fullName = "Wren Dabbler",
        homeRegion = "region_mireglass",
        arrivesInChapter = 3,
        questId = "quest_reed_weaver",
        introduction = "Weaves reed into everything. Left a figure for every house the water took.",
        job = {
            residentId = "npc_wren_dabbler",
            buildingId = "building_celebration_stage",
            title = "REED WEAVER",
            boon = "dawn_decoration",
            boonLabel = "DABBLER LEAVES A WOVEN CHARM ON A TOWN DOOR",
        },
    }),
    npc_marek_still = resident({
        id = "npc_marek_still",
        displayName = "MAREK",
        fullName = "Marek Still",
        homeRegion = "region_mireglass",
        arrivesInChapter = 3,
        questId = "quest_glass_reader",
        introduction = "Read mireglass for a living. Warns people about their own reflections.",
        job = {
            residentId = "npc_marek_still",
            buildingId = "building_watchtower",
            title = "GLASS READER",
            boon = "night_tell",
            boonLabel = "MAREK NAMES A TELL BEFORE THE NIGHT USES IT",
        },
    }),
    npc_lissen_ford = resident({
        id = "npc_lissen_ford",
        displayName = "LISSEN",
        fullName = "Lissen Ford",
        homeRegion = "region_mireglass",
        arrivesInChapter = 3,
        questId = "quest_fen_healer",
        introduction = "Pulled people out of the water for years. Still counts heads at dusk.",
        job = {
            residentId = "npc_lissen_ford",
            buildingId = "building_guardhouse",
            title = "FEN HEALER",
            boon = "dawn_recovery",
            boonLabel = "LISSEN GETS ONE INJURED RESIDENT BACK ON THEIR FEET",
        },
    }),
}

ResidentRoster.Order = ORDER

function ResidentRoster.get(residentId: any): Resident?
    return if type(residentId) == "string" then DEFINITIONS[residentId] else nil
end

function ResidentRoster.require(residentId: string): Resident
    local definition = DEFINITIONS[residentId]
    assert(definition ~= nil, string.format("unknown resident ID %q", residentId))
    return definition
end

function ResidentRoster.list(): { Resident }
    local result: { Resident } = {}
    for _, residentId in ORDER do
        table.insert(result, DEFINITIONS[residentId])
    end
    return result
end

--[[
    Who is in town at a given chapter. Chapter defaults to one, which is
    what every caller that predates the roster means, so nothing changes
    for a save that has not left Bramblewake.
]]
function ResidentRoster.idsForChapter(chapter: number?): { string }
    local reached = math.max(1, math.floor(tonumber(chapter) or 1))
    local ids: { string } = {}
    for _, residentId in ORDER do
        if DEFINITIONS[residentId].arrivesInChapter <= reached then
            table.insert(ids, residentId)
        end
    end
    return ids
end

function ResidentRoster.jobs(): { [string]: Job }
    local jobs: { [string]: Job } = {}
    for _, residentId in ORDER do
        jobs[residentId] = DEFINITIONS[residentId].job
    end
    return jobs
end

function ResidentRoster.questIdFor(residentId: any): string?
    local definition = ResidentRoster.get(residentId)
    return if definition == nil then nil else definition.questId
end

return table.freeze(ResidentRoster)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">ReviveFlow</string>
          <string name="Source"><![CDATA[--!strict

local ReviveFlow = {}

export type Channel = {
    endsAt: number,
    reviverRevision: number,
    reviverUserId: number,
    startedAt: number,
    targetUserId: number,
}
export type Conditions = {
    reachable: boolean,
    reviverCanAct: boolean,
    reviverPresent: boolean,
    reviverRevision: number,
    targetDowned: boolean,
    targetPresent: boolean,
}
export type DecisionStatus = "cancel" | "complete" | "pending"
export type Decision = {
    elapsed: number?,
    reason: string?,
    remaining: number?,
    status: DecisionStatus,
}

local function finiteNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeNonNegative(value: any): boolean
    return finiteNumber(value) and value >= 0 and value == math.floor(value)
end

function ReviveFlow.create(
    targetUserId: number,
    reviverUserId: number,
    reviverRevision: number,
    now: number,
    duration: number
): Channel
    assert(wholeNonNegative(targetUserId), "target user ID is invalid")
    assert(wholeNonNegative(reviverUserId), "reviver user ID is invalid")
    assert(targetUserId ~= reviverUserId, "players cannot revive themselves")
    assert(wholeNonNegative(reviverRevision), "reviver revision is invalid")
    assert(finiteNumber(now), "revive start time is invalid")
    assert(finiteNumber(duration) and duration > 0, "revive duration is invalid")

    return table.freeze({
        endsAt = now + duration,
        reviverRevision = reviverRevision,
        reviverUserId = reviverUserId,
        startedAt = now,
        targetUserId = targetUserId,
    })
end

function ReviveFlow.evaluate(channel: Channel, now: number, conditions: Conditions): Decision
    assert(finiteNumber(now), "revive evaluation time is invalid")
    if conditions.targetPresent ~= true then
        return {
            reason = "target_left",
            status = "cancel",
        }
    end
    if conditions.reviverPresent ~= true then
        return {
            reason = "reviver_left",
            status = "cancel",
        }
    end
    if conditions.targetDowned ~= true then
        return {
            reason = "target_not_downed",
            status = "cancel",
        }
    end
    if conditions.reviverCanAct ~= true then
        return {
            reason = "reviver_cannot_act",
            status = "cancel",
        }
    end
    if conditions.reviverRevision ~= channel.reviverRevision then
        return {
            reason = "reviver_state_changed",
            status = "cancel",
        }
    end
    if conditions.reachable ~= true then
        return {
            reason = "revive_out_of_range",
            status = "cancel",
        }
    end
    if now >= channel.endsAt then
        return {
            elapsed = math.max(0, now - channel.startedAt),
            status = "complete",
        }
    end
    return {
        remaining = math.max(0, channel.endsAt - now),
        status = "pending",
    }
end

return table.freeze(ReviveFlow)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">RunHandoff</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The contract for handing a departing party to its own run server.

    Pure logic: no TeleportService, no players. It decides what a departure
    payload must contain, whether an arriving server should trust one, and
    what a server should do when a teleport fails. Keeping that here means the
    rules can be tested without a live game, which matters more than usual
    because reserved-server teleports cannot be exercised in Studio at all.

    The rules:

      * A run server is told what it is by its teleport payload. A server that
        receives no payload, or one it cannot verify, behaves as a lobby --
        the safe default, because a wrong guess in that direction strands a
        player in an empty world rather than merely showing them the lodge.
      * Payloads are validated field by field on arrival. Teleport data is
        reachable by exploiters on some paths, so nothing in it is trusted as
        authority: it may say "this is a run", never "give me rewards".
      * A failed teleport returns the party to the lobby with the departure
        cancelled and nothing consumed. A half-sent party that lost its
        staging state is worse than a party that never left.
      * The party size that was chosen travels with the payload so the run
        server can bound its own population without asking the lobby.
]]

local RunHandoff = {}

export type Payload = {
    schemaVersion: number,
    kind: string,
    partySize: number,
    departedAt: number,
}

local SCHEMA_VERSION = 1
local RUN_KIND = "last_light_run"
local MAX_PARTY_SIZE = 8

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeBetween(value: any, low: number, high: number): boolean
    return finite(value) and value >= low and value <= high and value == math.floor(value)
end

function RunHandoff.schemaVersion(): number
    return SCHEMA_VERSION
end

function RunHandoff.runKind(): string
    return RUN_KIND
end

--[[
    Build the payload a departing party carries to its run server.

    `partySize` is the size the lobby actually launched, not the size that was
    requested, so a party that shrank on the platform arrives described
    correctly.
]]
function RunHandoff.buildPayload(partySize: any, now: any): (Payload?, any)
    if not wholeBetween(partySize, 1, MAX_PARTY_SIZE) then
        return nil, { accepted = false, reason = "invalid_party_size" }
    end
    if not finite(now) or now < 0 then
        return nil, { accepted = false, reason = "invalid_time" }
    end
    return {
        schemaVersion = SCHEMA_VERSION,
        kind = RUN_KIND,
        partySize = partySize,
        departedAt = now,
    }, { accepted = true }
end

--[[
    Decide what an arriving server is.

    Anything unrecognised resolves to a lobby. A server that wrongly believes
    it is a run skips the lodge and drops a player into the world with no way
    to start one; a server that wrongly believes it is a lobby merely shows a
    staging room the player can depart from again.
]]
function RunHandoff.readPayload(value: any): any
    if type(value) ~= "table" then
        return { isRun = false, reason = "no_payload" }
    end
    if value.schemaVersion ~= SCHEMA_VERSION then
        return { isRun = false, reason = "schema_mismatch" }
    end
    if value.kind ~= RUN_KIND then
        return { isRun = false, reason = "unknown_kind" }
    end
    if not wholeBetween(value.partySize, 1, MAX_PARTY_SIZE) then
        return { isRun = false, reason = "invalid_party_size" }
    end
    if not finite(value.departedAt) or value.departedAt < 0 then
        return { isRun = false, reason = "invalid_time" }
    end
    return { isRun = true, partySize = value.partySize, departedAt = value.departedAt }
end

--[[
    What to do when a teleport attempt fails.

    Always returns the party to the lobby and always cancels the departure.
    Reserving and teleporting are separate calls that can each fail, and the
    only safe response to either is to put everyone back where they were
    standing with nothing spent.
]]
function RunHandoff.failureRecovery(reason: any): any
    return {
        returnToLobby = true,
        cancelDeparture = true,
        reason = if type(reason) == "string" and #reason > 0 then reason else "unknown",
        message = "THE ROAD DID NOT OPEN - EVERYONE IS STILL HERE",
    }
end

return table.freeze(RunHandoff)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">RuntimeIds</string>
          <string name="Source"><![CDATA[--!strict

local ExpeditionEventFlow = require("./ExpeditionEventFlow")
local ProfessionMastery = require("./ProfessionMastery")
local TownProgression = require("./TownProgression")

local professionSpecializationInteractionIds = {}
local professionSpecializationInteractionIdBySpecialization = {}
for _, specializationId in ProfessionMastery.specializationIds() do
    local interactionId = "mastery_" .. specializationId
    assert(
        professionSpecializationInteractionIdBySpecialization[specializationId] == nil,
        "duplicate profession specialization runtime ID: " .. specializationId
    )
    table.insert(professionSpecializationInteractionIds, interactionId)
    professionSpecializationInteractionIdBySpecialization[specializationId] = interactionId
end

-- One construction interaction per building, generated from the shared
-- sixteen-building list rather than written out by hand, the same reasoning
-- TownProgression.luau itself gives for driving the later eleven buildings
-- off one table: a building added to the town gets an interaction ID for
-- free instead of needing someone to remember to add one.
local constructionInteractionIds = {}
-- Storm damage is per building now, so a repair prompt belongs to a building
-- the same way a construction prompt does. Generated from the same list for the
-- same reason: a building added to the town gets both for free.
local townRepairInteractionIds = {}
for _, buildingId in TownProgression.buildingIds() do
    constructionInteractionIds[buildingId] = "construction_" .. buildingId
    townRepairInteractionIds[buildingId] = "town_repair_" .. buildingId
end

local RuntimeIds = {
    FolderName = "LastLightRuntime",
    WorldName = "LastLightWorld",
    InteractionTag = "LastLightInteractable",
    AmbientMoteTag = "LastLightAmbientMote",
    AmbientMotionTag = "LastLightAmbientMotion",
    AmbientLightTag = "LastLightAmbientLight",
    AmbientSwayTag = "LastLightAmbientSway",
    ExpeditionModuleTag = "LastLightExpeditionModule",
    ExpeditionPointOfInterestTag = "LastLightExpeditionPOI",
    ExpeditionEventTag = "LastLightExpeditionEvent",
    ExpeditionEventStepTag = "LastLightExpeditionEventStep",
    ExpeditionExtractionTag = "LastLightExpeditionExtraction",
    ExpeditionEliteTag = "LastLightExpeditionElite",
    ExpeditionBossTag = "LastLightExpeditionBoss",
    ExpeditionBlackoutTag = "LastLightExpeditionBlackout",
    PlayerDownedTag = "LastLightPlayerDowned",
    eventInteractionId = ExpeditionEventFlow.interactionId,
    Remotes = table.freeze({
        ActionRequest = "ActionRequest",
        StateChanged = "StateChanged",
        GetState = "GetState",
        -- Deliberately not an action kind. Perf samples are telemetry that
        -- grants nothing, and keeping them off the action remote means the
        -- gameplay payload contract stays one field per kind.
        PerformanceReport = "PerformanceReport",
    }),
    Actions = table.freeze({
        Rescue = "rescue",
        Gather = "gather",
        ChooseTool = "choose_tool",
        Build = "build",
        Prepare = "prepare",
        PlaceDecoration = "place_decoration",
        Reveal = "reveal",
        Interact = "interact",
        UseTool = "use_tool",
        Sprint = "sprint",
        Dodge = "dodge",
        ProfessionAbility = "profession_ability",
        SelectProfession = "select_profession",
        CompactHud = "compact_hud",
        ExpeditionEvent = "expedition_event",
        OldGrowthFire = "old_growth_fire",
        WardenStagChoice = "warden_stag_choice",
        BramblewakeBlackout = "bramblewake_blackout",
        Extract = "extract",
        Revive = "revive",
        CraftItem = "craft_item",
        UseGear = "use_gear",
        EquipGear = "equip_gear",
        LobbyDepart = "lobby_depart",
        SaveLoadout = "save_loadout",
        RepairGear = "repair_gear",
        CompanionCommand = "companion_command",
        ApplyLoadout = "apply_loadout",
        GatherResource = "gather_resource",
        OpenFieldBook = "open_field_book",
        TalkResident = "talk_resident",
        RepairTown = "repair_town",
        ResolveTownIncident = "resolve_town_incident",
        RecoverExpeditionCache = "recover_expedition_cache",
        SelectProfessionSpecialization = "select_profession_specialization",
        ContributeConstruction = "contribute_construction",
        RecoverMemoryFragment = "recover_memory_fragment",
    }),
    InteractionIds = table.freeze({
        Mara = "mara_rescue",
        Heartwood = "heartwood_gather",
        ToolAxe = "tool_axe",
        ToolHammer = "tool_hammer",
        ToolTorch = "tool_torch",
        ToolPick = "tool_pick",
        ToolSickle = "tool_sickle",
        ToolFishingKit = "tool_fishing_kit",
        ToolClimbingKit = "tool_climbing_kit",
        ToolSurveyKit = "tool_survey_kit",
        Barricade = "barricade_build",
        Lantern = "first_lantern_prepare",
        Beacon = "bramblewake_reveal",
        Wayhome = "bramblewake_wayhome",
        OldGrowthFireSource = "old_growth_fire_source",
        OldGrowthHeart = "old_growth_root_heart",
        WardenStagRootNorth = "warden_stag_root_node_north",
        WardenStagRootEast = "warden_stag_root_node_east",
        WardenStagRootSouth = "warden_stag_root_node_south",
        WardenStagRootWest = "warden_stag_root_node_west",
        WardenStagAntlerLeft = "warden_stag_antler_left",
        WardenStagAntlerRight = "warden_stag_antler_right",
        BlackoutFireSource = "blackout_fire_source",
        BlackoutRootFarm = "blackout_root_farm",
        BlackoutRootMill = "blackout_root_mill",
        BlackoutRootCathedral = "blackout_root_cathedral",
        BlackoutDecisionFarmland = "blackout_decision_farmland",
        BlackoutDecisionWild = "blackout_decision_wild",
        BlackoutDecisionShared = "blackout_decision_shared",
        CraftMeadowSatchel = "craft_meadow_satchel_bench",
        CraftAmberCharm = "craft_amber_charm_bench",
        CraftIronrootHood = "craft_ironroot_hood_bench",
        CraftBrambleBoots = "craft_bramble_boots_bench",
        CraftThornwoodBow = "craft_thornwood_bow_bench",
        CraftHeartwoodMaul = "craft_heartwood_maul_bench",
        CraftBriarLance = "craft_briar_lance_bench",
        CraftFoxfireSling = "craft_foxfire_sling_bench",
        CraftAmberEdge = "craft_amber_edge_bench",
        CraftWardenCudgel = "craft_warden_cudgel_bench",
        QuestBoard = "quest_board",
    }),
    ResidentInteractionIds = table.freeze({
        npc_tomas_reed = "resident_tomas_reed",
        npc_pip_wren = "resident_pip_wren",
        npc_ena_moss = "resident_ena_moss",
    }),
    ConstructionInteractionIds = table.freeze(constructionInteractionIds),
    TownRepairInteractionIdByBuilding = table.freeze(townRepairInteractionIds),
    ProfessionSpecializationInteractionIds = table.freeze(professionSpecializationInteractionIds),
    ProfessionSpecializationInteractionIdBySpecialization = table.freeze(
        professionSpecializationInteractionIdBySpecialization
    ),
}

return table.freeze(RuntimeIds)
]]></string>
        </Properties>
