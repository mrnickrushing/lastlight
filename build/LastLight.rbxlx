      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">GearWear</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Equipment wear and repair -- the M6 "repair" deliverable, scoped to
    weapons first: a blade dulls as it lands blows, and whetting it costs
    half its own recipe. Wear is friendly by design: a worn weapon works at
    half strength and a failing one stops helping, but nothing is ever
    destroyed or unequipped -- the player is nudged to the bench, not
    punished with loss.

    Pure state math over { [itemId]: wearPoints 0..100 }; the profile owns
    persistence and the server owns when wear accrues. A client never
    submits wear.
]]

local CraftingCatalog = require("./CraftingCatalog")

local GearWear = {}

local MAX_WEAR = 100
local WORN_AT = 60

export type Wear = { [string]: number }

function GearWear.default(): Wear
    return {}
end

function GearWear.normalize(value: any): Wear
    local wear: Wear = {}
    if type(value) ~= "table" then
        return wear
    end
    for itemId, points in value do
        if
            CraftingCatalog.isKnownOutputItem(itemId)
            and type(points) == "number"
            and points > 0
        then
            wear[itemId] = math.clamp(math.floor(points), 0, MAX_WEAR)
        end
    end
    return wear
end

function GearWear.accrue(wear: Wear, itemId: any, points: number): (Wear, any)
    if not CraftingCatalog.isKnownOutputItem(itemId) then
        return wear, { applied = false, reason = "unknown_item" }
    end
    if type(points) ~= "number" or points <= 0 then
        return wear, { applied = false, reason = "invalid_points" }
    end
    local nextWear = table.clone(wear)
    local before = nextWear[itemId] or 0
    local after = math.clamp(before + math.floor(points), 0, MAX_WEAR)
    nextWear[itemId] = after
    return nextWear,
        {
            applied = after ~= before,
            points = after,
            conditionBefore = GearWear.condition(wear, itemId),
            conditionAfter = GearWear.conditionForPoints(after),
        }
end

function GearWear.conditionForPoints(points: number): string
    if points >= MAX_WEAR then
        return "failing"
    elseif points >= WORN_AT then
        return "worn"
    end
    return "sound"
end

function GearWear.condition(wear: Wear, itemId: any): string
    return GearWear.conditionForPoints(if type(itemId) == "string" then wear[itemId] or 0 else 0)
end

-- What remains of the item's identity at its current wear: full, half, or
-- nothing. Consumers multiply their own stat by this rather than knowing
-- the thresholds.
function GearWear.effectiveness(wear: Wear, itemId: any): number
    local condition = GearWear.condition(wear, itemId)
    if condition == "failing" then
        return 0
    elseif condition == "worn" then
        return 0.5
    end
    return 1
end

-- Half the item's own recipe, rounded up per material: repair always costs
-- something, and always costs less than crafting anew.
function GearWear.repairCost(itemId: any): { [string]: number }?
    if type(itemId) ~= "string" then
        return nil
    end
    for _, recipe in CraftingCatalog.list() do
        if recipe.outputItemId == itemId then
            local cost: { [string]: number } = {}
            for materialId, amount in recipe.materials do
                cost[materialId] = math.max(1, math.ceil(amount / 2))
            end
            return cost
        end
    end
    return nil
end

function GearWear.repair(
    wear: Wear,
    materials: { [string]: number },
    itemId: any
): (Wear, { [string]: number }, any)
    local cost = GearWear.repairCost(itemId)
    if cost == nil then
        return wear, materials, { applied = false, reason = "unknown_item" }
    end
    if (wear[itemId] or 0) <= 0 then
        return wear, materials, { applied = false, reason = "not_worn" }
    end
    for materialId, amount in cost do
        if (materials[materialId] or 0) < amount then
            return wear, materials, { applied = false, reason = "insufficient_materials" }
        end
    end
    local nextWear = table.clone(wear)
    nextWear[itemId] = nil
    local nextMaterials = table.clone(materials)
    for materialId, amount in cost do
        nextMaterials[materialId] -= amount
    end
    return nextWear, nextMaterials, { applied = true, cost = cost }
end

GearWear.Constants = table.freeze({
    MaxWear = MAX_WEAR,
    WornAt = WORN_AT,
})

return table.freeze(GearWear)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">IronWidowEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Iron Widow -- the Delve's second elite.

    She does not hold ground; she owns the rails. A web of cut cable spans
    the stope, and while an anchor still holds she sends loaded carts down
    the lines on an ambush cadence -- the longer an anchor survives, the
    faster they come. Cutting an anchor is the whole fight: each one taken
    slows the ambush and drops her out of the web for a while, and only
    with the web fully cut does she come down to be finished.

    Where the Foreman Echo is about authority (shut it off in the right
    order), the Widow is about tempo (spend your window well). Her
    vulnerability is not a state you unlock once but a window you keep
    re-earning, and her pressure scales down as you take the web apart, so
    a solo player who is slow still converges rather than drowning.

    Same contract as every elite here: profession-independent, solo
    passable, one reward per participant per run through a deterministic
    transaction id, disable-able, server-called throughout.
]]

local IronWidowEncounter = {}

export type Status = "disabled" | "dormant" | "webbed" | "grounded" | "complete"

export type State = {
    anchors: { [string]: boolean },
    groundedUntil: number,
    health: number,
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    status: Status,
}

local MAX_HEALTH = 300
local ANCHOR_IDS = table.freeze({
    "anchor_head",
    "anchor_spur",
    "anchor_tail",
    "anchor_crown",
})
-- Cutting an anchor drops her out of the web for this long. It is the
-- only window in which she can be struck while the web still stands.
local GROUNDED_SECONDS = 9

local CART_AMBUSH = table.freeze({
    attackId = "iron_widow_cart",
    attackName = "CART AMBUSH",
    damage = 24,
    instruction = "OFF THE LINE — A CART IS COMING",
    length = 34,
    shape = "lane",
    width = 7,
    windup = 1.15,
})

local CABLE_SWEEP = table.freeze({
    attackId = "iron_widow_sweep",
    attackName = "CABLE SWEEP",
    damage = 20,
    instruction = "DUCK THE SWEEPING CABLE",
    radius = 12,
    shape = "circle",
    windup = 1.3,
})

IronWidowEncounter.Id = "elite_iron_widow"
IronWidowEncounter.MaxHealth = MAX_HEALTH
IronWidowEncounter.AnchorIds = ANCHOR_IDS
IronWidowEncounter.GroundedSeconds = GROUNDED_SECONDS
IronWidowEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_coalglass",
})
IronWidowEncounter.Tuning = table.freeze({
    baseAmbushCooldownSeconds = 3.6,
    -- Each anchor cut adds this much breathing room between ambushes.
    anchorCooldownBonusSeconds = 0.7,
    groundedAttackCooldownSeconds = 5,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.anchors = table.clone(state.anchors)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

local function isAnchor(anchorId: any): boolean
    for _, id in ANCHOR_IDS do
        if id == anchorId then
            return true
        end
    end
    return false
end

local function anchorsCut(state: State): number
    local count = 0
    for _, id in ANCHOR_IDS do
        if state.anchors[id] then
            count += 1
        end
    end
    return count
end

function IronWidowEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Iron Widow run ID is required")
    assert(manifestHash ~= "", "Iron Widow manifest hash is required")
    return {
        anchors = {},
        groundedUntil = 0,
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        status = if enabled then "dormant" else "disabled",
    }
end

function IronWidowEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "webbed"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function IronWidowEncounter.join(state: State, userId: number): State
    if state.status ~= "webbed" and state.status ~= "grounded" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    Cut one web anchor. Anchors stay cut -- progress never unwinds -- and
    each cut both slows the ambush cadence and drops her into the open.
    With the last anchor gone she stays down: the web is what held her up.
]]
function IronWidowEncounter.cutAnchor(
    state: State,
    userId: number,
    anchorId: any,
    now: number
): (State, any)
    if state.status ~= "webbed" and state.status ~= "grounded" then
        return state, { accepted = false, reason = state.status }
    end
    if not isAnchor(anchorId) then
        return state, { accepted = false, reason = "unknown_anchor" }
    end
    if state.anchors[anchorId] then
        return state, { accepted = false, reason = "already_cut" }
    end
    local nextState = cloneState(state)
    nextState.anchors[anchorId] = true
    nextState.participants[participantKey(userId)] = true
    local cut = anchorsCut(nextState)
    local webDown = cut >= #ANCHOR_IDS
    nextState.status = "grounded"
    nextState.groundedUntil = if webDown then math.huge else now + GROUNDED_SECONDS
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            cut = cut,
            groundedUntil = nextState.groundedUntil,
            reason = if webDown then "web_down" else "anchor_cut",
            remaining = #ANCHOR_IDS - cut,
            webDown = webDown,
        }
end

function IronWidowEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Iron Widow strike amount is invalid")
    if state.status ~= "grounded" then
        return state, { accepted = false, reason = state.status }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - amount)
    if nextState.health <= 0 then
        nextState.status = "complete"
        nextState.groundedUntil = 0
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            reason = if nextState.status == "complete" then "completed" else "damaged",
        }
end

-- She climbs back into the web when her window closes -- unless the web
-- is fully cut, in which case there is nothing left to climb.
function IronWidowEncounter.expire(state: State, now: number): State
    if state.status ~= "grounded" or now < state.groundedUntil then
        return state
    end
    local nextState = cloneState(state)
    nextState.status = "webbed"
    nextState.groundedUntil = 0
    nextState.revision += 1
    return nextState
end

-- Ambush cadence eases with every anchor taken: the fight gets calmer as
-- it gets closer, so a slow solo run converges instead of drowning.
function IronWidowEncounter.ambushCooldown(state: State): number
    local tuning = IronWidowEncounter.Tuning
    if state.status == "grounded" then
        return tuning.groundedAttackCooldownSeconds
    end
    return tuning.baseAmbushCooldownSeconds + anchorsCut(state) * tuning.anchorCooldownBonusSeconds
end

function IronWidowEncounter.attack(attackIndex: number, cutCount: number): any
    -- With half the web gone she can no longer keep carts running on
    -- every line, and falls back to sweeping cable.
    if cutCount >= 2 and attackIndex % 2 == 0 then
        return CABLE_SWEEP
    end
    return CART_AMBUSH
end

function IronWidowEncounter.snapshot(state: State, userId: number, now: number): any
    local cut = anchorsCut(state)
    local grounded = state.status == "grounded" and now < state.groundedUntil
    local instruction = if state.status == "webbed"
        then string.format("CUT THE WEB ANCHORS — %d OF %d", cut, #ANCHOR_IDS)
        elseif state.status == "grounded" then "STRIKE HER WHILE SHE IS DOWN"
        elseif state.status == "complete" then "THE RAILS ARE QUIET"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE FLOODED STOPE"
    return {
        active = state.status == "webbed" or state.status == "grounded",
        anchorsCut = cut,
        anchorTotal = #ANCHOR_IDS,
        complete = state.status == "complete",
        displayName = "IRON WIDOW",
        enabled = state.status ~= "disabled",
        grounded = grounded,
        groundedUntil = if grounded and state.groundedUntil ~= math.huge
            then state.groundedUntil
            else 0,
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, math.floor(cut / 2) + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        status = state.status,
        webDown = cut >= #ANCHOR_IDS,
    }
end

function IronWidowEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        IronWidowEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(IronWidowEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">IronrootEnemies</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Ironroot Delve's six standard enemies, in the same definition
    shape the Bramblewake roster uses so the night systems need no new
    vocabulary to run them.

    The Delve does not fight like the forest. Bramblewake's roster is
    slow, heavy and structure-hungry: things that shoulder toward the
    lantern and telegraph in wide circles. The Delve's is fast, narrow and
    positional -- it uses the mine's own geometry against you. Rail hounds
    charge down straight lanes, slag spitters hold a corridor from a fixed
    mouth, crank guards present armored plate until you take their flank,
    and gas blooms sit still and make the ground itself the threat. Where
    a Bramblewake enemy wants your lantern, most of these want you.

    Two behaviors the content catalog names for this region -- persistent
    hot zones that outlive their attack, and a hazard the player can
    redirect rather than merely avoid -- are expressed here with the
    existing telegraph and status vocabulary, because inventing new
    mechanics without a live session to feel them is how a system ships
    wrong. They are recorded open in the region runbook; the enemies read
    correctly today and gain depth when the Delve's own encounter wave
    can be driven in Studio.
]]

local IronrootEnemies = {}

export type EnemyDefinition = {
    id: string,
    displayName: string,
    modelKey: string,
    health: number,
    speed: number,
    attackRange: number,
    attackCooldown: number,
    playerDamage: number,
    lanternDamage: number,
    strikeRange: number,
    strikeDamage: number,
    attackId: string,
    attackName: string,
    instruction: string,
    shape: "circle" | "lane",
    radius: number?,
    width: number?,
    length: number?,
    windup: number,
    stationary: boolean,
    targetMode: "lantern" | "player",
    frontShield: boolean,
    frontalStrikeDamage: number?,
    flankStrikeDamage: number?,
    statusEffect: ("drowsy" | "spark_theft")?,
    statusDuration: number?,
    statusMultiplier: number?,
    statusLanternDamage: number?,
}

local function freezeDefinition(definition: EnemyDefinition): EnemyDefinition
    return table.freeze(definition)
end

local DEFINITIONS: { [string]: EnemyDefinition } = {
    -- Swarm pressure: individually trivial, dangerous in number and near
    -- heat. The fastest thing in either roster, and the frailest.
    enemy_cinder_mite = freezeDefinition({
        id = "enemy_cinder_mite",
        displayName = "Cinder Mite",
        modelKey = "cinder_mite",
        health = 55,
        speed = 10.5,
        attackRange = 7,
        attackCooldown = 1.6,
        playerDamage = 14,
        lanternDamage = 4,
        strikeRange = 8,
        strikeDamage = 40,
        attackId = "cinder_mite_scald",
        attackName = "CINDER MITE SCALD",
        instruction = "STEP OUT OF THE EMBER RING",
        shape = "circle",
        radius = 5,
        width = nil,
        length = nil,
        windup = 0.7,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- The rails are its road: a long, narrow charge that owns a corridor
    -- until you leave it. Fast to close, slow to turn around.
    enemy_rail_hound = freezeDefinition({
        id = "enemy_rail_hound",
        displayName = "Rail Hound",
        modelKey = "rail_hound",
        health = 95,
        speed = 9,
        attackRange = 16,
        attackCooldown = 3,
        playerDamage = 30,
        lanternDamage = 8,
        strikeRange = 10,
        strikeDamage = 34,
        attackId = "rail_hound_run",
        attackName = "RAIL HOUND RUN",
        instruction = "GET OFF THE RAILS",
        shape = "lane",
        radius = nil,
        width = 6,
        length = 22,
        windup = 1.1,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- Holds a corridor from a fixed mouth. It never chases; it makes the
    -- ground between you and it expensive.
    enemy_slag_spitter = freezeDefinition({
        id = "enemy_slag_spitter",
        displayName = "Slag Spitter",
        modelKey = "slag_spitter",
        health = 130,
        speed = 0,
        attackRange = 26,
        attackCooldown = 3.4,
        playerDamage = 26,
        lanternDamage = 12,
        strikeRange = 11,
        strikeDamage = 32,
        attackId = "slag_spitter_pour",
        attackName = "SLAG POUR",
        instruction = "CROSS THE POUR LINE, DO NOT STAND IN IT",
        shape = "lane",
        radius = nil,
        width = 5,
        length = 26,
        windup = 1.5,
        stationary = true,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- A worker's last motion, repeating. Being caught in it leaves you
    -- moving like the shift did at hour eleven.
    enemy_shift_echo = freezeDefinition({
        id = "enemy_shift_echo",
        displayName = "Shift Echo",
        modelKey = "shift_echo",
        health = 85,
        speed = 6.4,
        attackRange = 10,
        attackCooldown = 2.6,
        playerDamage = 18,
        lanternDamage = 5,
        strikeRange = 9,
        strikeDamage = 36,
        attackId = "shift_echo_repeat",
        attackName = "REPEATED MOTION",
        instruction = "BREAK THE PATTERN — MOVE ASIDE",
        shape = "circle",
        radius = 8,
        width = nil,
        length = nil,
        windup = 1.2,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "drowsy",
        statusDuration = 7,
        statusMultiplier = 0.72,
        statusLanternDamage = nil,
    }),
    -- Plate at the front, mechanism at the back. The Delve's answer to the
    -- Briarback, and a harder one: slower, tougher, and it hunts the
    -- lantern rather than the person, so you cannot simply walk away.
    enemy_crank_guard = freezeDefinition({
        id = "enemy_crank_guard",
        displayName = "Crank Guard",
        modelKey = "crank_guard",
        health = 165,
        speed = 4.2,
        attackRange = 11,
        attackCooldown = 3.2,
        playerDamage = 32,
        lanternDamage = 16,
        strikeRange = 10,
        strikeDamage = 30,
        attackId = "crank_guard_sweep",
        attackName = "CRANK SWEEP",
        instruction = "TAKE THE MECHANISM — STRIKE FROM BEHIND",
        shape = "circle",
        radius = 9,
        width = nil,
        length = nil,
        windup = 1.5,
        stationary = false,
        targetMode = "lantern",
        frontShield = true,
        frontalStrikeDamage = 8,
        flankStrikeDamage = 44,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- It does not come to you. It opens, and the air in a wide circle
    -- becomes the attack; the lantern gutters while the bloom is open.
    enemy_gas_bloomer = freezeDefinition({
        id = "enemy_gas_bloomer",
        displayName = "Gas Bloomer",
        modelKey = "gas_bloomer",
        health = 110,
        speed = 0,
        attackRange = 15,
        attackCooldown = 4,
        playerDamage = 20,
        lanternDamage = 18,
        strikeRange = 12,
        strikeDamage = 38,
        attackId = "gas_bloomer_open",
        attackName = "WHITEDAMP BLOOM",
        instruction = "LEAVE THE CLOUD BEFORE IT OPENS",
        shape = "circle",
        radius = 13,
        width = nil,
        length = nil,
        windup = 1.8,
        stationary = true,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "drowsy",
        statusDuration = 9,
        statusMultiplier = 0.8,
        statusLanternDamage = 6,
    }),
}

local ORDER = table.freeze({
    "enemy_cinder_mite",
    "enemy_rail_hound",
    "enemy_slag_spitter",
    "enemy_shift_echo",
    "enemy_crank_guard",
    "enemy_gas_bloomer",
})

function IronrootEnemies.get(enemyId: string): EnemyDefinition?
    return DEFINITIONS[enemyId]
end

function IronrootEnemies.require(enemyId: string): EnemyDefinition
    local definition = DEFINITIONS[enemyId]
    assert(definition ~= nil, string.format("unknown Ironroot enemy ID %q", enemyId))
    return definition
end

function IronrootEnemies.order(): { string }
    return table.clone(ORDER)
end

function IronrootEnemies.all(): { EnemyDefinition }
    local result: { EnemyDefinition } = {}
    for _, enemyId in ORDER do
        table.insert(result, DEFINITIONS[enemyId])
    end
    return result
end

return table.freeze(IronrootEnemies)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">LanternWitchEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Lantern Witch -- chapter III's boss, at the heart of Mireglass Fen.

    Four phases, and the content catalog's non-profession solution read
    literally: identify tells, use copies, consent seal.

    - **Identify.** She stands among her own copies. Each round, every
      copy shows a tell -- one of them is wrong, and naming the wrong one
      is the only way to find her. Naming a true copy costs the round, not
      the run.
    - **Use.** Found, she does not simply take damage: her copies do. The
      copies she made are turned, and each one spent is a phase's worth of
      progress. This is the chapter's decision -- spend a copy or spare it.
    - **Consent.** At the last phase she asks to be sealed rather than
      broken, and the seal only holds if it is given, not taken. A crew
      that spent every copy has nothing left to offer and seals her the
      hard way; a crew that spared them can close the chapter gently.

    Outcomes: sealed (copies spared, consent given), broken (copies spent),
    or bound (somewhere between). Recorded the way the Warden's antlers and
    the Maw's vent are -- decided by play, legible in one line.
]]

local LanternWitchEncounter = {}

export type Status = "disabled" | "locked" | "dormant" | "hiding" | "found" | "asking" | "complete"

export type State = {
    copiesRemaining: number,
    copiesSpent: number,
    health: number,
    manifestHash: string,
    outcome: string?,
    participants: { [string]: boolean },
    phase: number,
    revision: number,
    round: number,
    runId: string,
    status: Status,
}

local MAX_HEALTH = 520
local PHASE_THRESHOLDS = table.freeze({ 390, 260, 130, 0 })
local COPY_COUNT = 4
-- Which copy is false in a given round: deterministic from the round, so
-- the tell is learnable rather than a coin toss.
local COPY_IDS = table.freeze({
    "copy_first",
    "copy_second",
    "copy_third",
    "copy_fourth",
})

local WITCHLIGHT_RING = table.freeze({
    attackId = "lantern_witch_ring",
    attackName = "WITCHLIGHT RING",
    damage = 24,
    instruction = "LEAVE THE RING OF LIGHTS",
    radius = 12,
    shape = "circle",
    windup = 1.4,
})

local FALSE_PATH = table.freeze({
    attackId = "lantern_witch_false_path",
    attackName = "FALSE PATH",
    damage = 28,
    instruction = "THAT GROUND IS NOT THERE — GET OFF THE LINE",
    length = 32,
    shape = "lane",
    width = 8,
    windup = 1.25,
})

local DROWNING_CHOIR = table.freeze({
    attackId = "lantern_witch_choir",
    attackName = "DROWNING CHOIR",
    damage = 32,
    instruction = "COVER YOUR EARS AND MOVE",
    radius = 15,
    shape = "circle",
    windup = 1.8,
})

LanternWitchEncounter.Id = "boss_lantern_witch"
LanternWitchEncounter.MaxHealth = MAX_HEALTH
LanternWitchEncounter.CopyIds = COPY_IDS
LanternWitchEncounter.CopyCount = COPY_COUNT
LanternWitchEncounter.Reward = table.freeze({
    amount = 5,
    materialId = "material_witchlight_pollen",
})
LanternWitchEncounter.Tuning = table.freeze({
    askingAttackCooldownSeconds = 5,
    attackCooldownSeconds = 3.4,
    hidingAttackCooldownSeconds = 4,
    markedStrikeDamage = 46,
    strikeDamage = 40,
})

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "boss participant user ID is invalid")
    return tostring(userId)
end

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function isActive(status: Status): boolean
    return status == "hiding" or status == "found" or status == "asking"
end

--[[
    Which copy carries the wrong tell this round. Deterministic, and it
    walks rather than repeats, so a crew learns the rhythm instead of
    guessing four ways every time.
]]
function LanternWitchEncounter.falseCopy(round: number, phase: number): string
    return COPY_IDS[(round + phase - 2) % COPY_COUNT + 1]
end

function LanternWitchEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Lantern Witch run ID is required")
    assert(manifestHash ~= "", "Lantern Witch manifest hash is required")
    return {
        copiesRemaining = COPY_COUNT,
        copiesSpent = 0,
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        outcome = nil,
        participants = {},
        phase = 1,
        revision = 0,
        round = 1,
        runId = runId,
        status = if enabled then "locked" else "disabled",
    }
end

function LanternWitchEncounter.unlock(state: State): (State, any)
    if state.status ~= "locked" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "dormant"
    nextState.revision += 1
    return nextState, { accepted = true, reason = "unlocked" }
end

function LanternWitchEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "hiding"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function LanternWitchEncounter.join(state: State, userId: number): State
    if not isActive(state.status) then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    Name a copy. The one whose tell is wrong is the Witch; naming a true
    copy costs the round -- the tells reshuffle -- and nothing else. A
    wrong guess is never fatal, because a boss that punishes reading is a
    boss nobody reads.
]]
function LanternWitchEncounter.nameCopy(state: State, userId: number, copyId: any): (State, any)
    if state.status ~= "hiding" then
        return state, { accepted = false, reason = state.status }
    end
    local valid = false
    for _, id in COPY_IDS do
        if id == copyId then
            valid = true
            break
        end
    end
    if not valid then
        return state, { accepted = false, reason = "unknown_copy" }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local target = LanternWitchEncounter.falseCopy(state.round, state.phase)
    if copyId ~= target then
        nextState.round += 1
        nextState.revision += 1
        return nextState,
            {
                accepted = true,
                found = false,
                reason = "true_copy_named",
                round = nextState.round,
            }
    end
    nextState.status = "found"
    nextState.revision += 1
    return nextState, { accepted = true, found = true, reason = "witch_found" }
end

--[[
    Spend one of her copies against her, or spare it. Spending advances
    the phase outright; sparing means finding her again the hard way, and
    is what the ending remembers.
]]
function LanternWitchEncounter.useCopy(state: State, userId: number, spend: boolean): (State, any)
    if state.status ~= "found" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    if not spend then
        -- spared: she slips back among them and the round moves on
        nextState.status = "hiding"
        nextState.round += 1
        nextState.revision += 1
        return nextState, { accepted = true, reason = "copy_spared", spent = false }
    end
    if state.copiesRemaining <= 0 then
        return state, { accepted = false, reason = "no_copies_left" }
    end
    nextState.copiesRemaining -= 1
    nextState.copiesSpent += 1
    local threshold = PHASE_THRESHOLDS[state.phase]
    nextState.health = threshold
    if state.phase >= #PHASE_THRESHOLDS - 1 then
        nextState.status = "asking"
    else
        nextState.phase += 1
        nextState.round = 1
        nextState.status = "hiding"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            copiesRemaining = nextState.copiesRemaining,
            health = nextState.health,
            phase = nextState.phase,
            reason = if nextState.status == "asking" then "final_phase" else "copy_spent",
            spent = true,
        }
end

--[[
    The last phase: she asks. Granting consent seals her, and how gently
    depends on what is left of her copies. Refusing takes the seal by
    force, which the Fen also remembers.
]]
function LanternWitchEncounter.answer(state: State, userId: number, consent: boolean): (State, any)
    if state.status ~= "asking" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = 0
    nextState.status = "complete"
    nextState.outcome = if not consent
        then "broken"
        elseif nextState.copiesSpent <= 1 then "sealed"
        else "bound"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = true,
            consent = consent,
            outcome = nextState.outcome,
            reason = "chapter_closed",
        }
end

function LanternWitchEncounter.attack(attackIndex: number, phase: number): any
    if phase >= 4 then
        return DROWNING_CHOIR
    elseif phase >= 2 and attackIndex % 2 == 0 then
        return FALSE_PATH
    end
    return WITCHLIGHT_RING
end

function LanternWitchEncounter.snapshot(state: State, userId: number): any
    local instruction = if state.status == "hiding"
        then "ONE TELL IS WRONG — NAME THE FALSE LANTERN"
        elseif state.status == "found" then "SPEND ONE OF HER COPIES, OR SPARE IT"
        elseif state.status == "asking" then "SHE ASKS TO BE SEALED — ANSWER HER"
        elseif state.status == "complete" then if state.outcome == "sealed"
            then "THE WITCH IS SEALED · SHE WENT WILLINGLY"
            elseif state.outcome == "broken" then "THE WITCH IS BROKEN · THE FEN IS QUIET AND COLD"
            else "THE WITCH IS BOUND · SOMETHING OF HER REMAINS"
        elseif state.status == "dormant" then "ENTER THE WITCHLIGHT RING"
        elseif state.status == "locked" then "CLEAR THE FEN'S ELITES TO REACH HER"
        elseif state.status == "disabled" then "LANTERN WITCH TEMPORARILY DORMANT"
        else "LANTERN WITCH"
    return {
        active = isActive(state.status),
        asking = state.status == "asking",
        choiceAvailable = state.status == "found" or state.status == "asking",
        complete = state.status == "complete",
        copiesRemaining = state.copiesRemaining,
        copiesSpent = state.copiesSpent,
        displayName = "LANTERN WITCH",
        enabled = state.status ~= "disabled",
        found = state.status == "found",
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        outcome = state.outcome,
        phase = state.phase,
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        round = state.round,
        status = state.status,
    }
end

function LanternWitchEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        LanternWitchEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(LanternWitchEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">LighthouseEaterEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Lighthouse Eater -- Tempest Reach's first elite.

    It eats beams. Every lamp on this coast that still worked went out the
    week it arrived, and it hides in the storm wall where nothing can see
    it and it does not need to see. The catalog calls this "extinguishes
    beams and hides in the storm wall", and both halves are the fight:
    while the coast is dark it cannot be found, and the only way to find
    it is to give it something to come for.

    So the fight is lighting things it wants to eat. Four beacons stand
    around the point; lighting one draws the Eater out of the wall and
    holds it in the open for as long as the beam lasts, and it puts that
    beacon out on its way back in. Relighting is the whole loop, and the
    beacons run down whether or not anyone is watching, so a party that
    stops to fight in the dark loses the light it already paid for.

    Where the Iron Widow's windows are bought by cutting something
    permanent, these are rented. Same contract as every elite here:
    profession-independent, solo-passable, one reward per participant per
    run through a deterministic transaction id, disable-able, and every
    mutation server-called.
]]

local LighthouseEaterEncounter = {}

export type Status = "disabled" | "dormant" | "hidden" | "drawn" | "complete"

export type State = {
    beacons: { [string]: number },
    health: number,
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    status: Status,
}

local MAX_HEALTH = 320
local BEACON_IDS = table.freeze({
    "beacon_point",
    "beacon_jetty",
    "beacon_shoal",
    "beacon_wall",
})
-- How long a lit beacon burns, and so how long the Eater stays out.
local BEACON_SECONDS = 11

local BEAM_SNUFF = table.freeze({
    attackId = "lighthouse_eater_snuff",
    attackName = "SNUFFED BEAM",
    damage = 24,
    instruction = "GET OUT OF THE DARK IT MAKES",
    radius = 12,
    shape = "circle",
    windup = 1.4,
})

local STORM_LUNGE = table.freeze({
    attackId = "lighthouse_eater_lunge",
    attackName = "LUNGE FROM THE WALL",
    damage = 30,
    instruction = "CLEAR THE LINE TO THE STORM WALL",
    length = 30,
    shape = "lane",
    width = 8,
    windup = 1.15,
})

LighthouseEaterEncounter.Id = "elite_lighthouse_eater"
LighthouseEaterEncounter.MaxHealth = MAX_HEALTH
LighthouseEaterEncounter.BeaconIds = BEACON_IDS
LighthouseEaterEncounter.BeaconSeconds = BEACON_SECONDS
LighthouseEaterEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_storm_glass",
})
LighthouseEaterEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.2,
    drawnAttackCooldownSeconds = 4,
    hiddenAttackCooldownSeconds = 2.6,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.beacons = table.clone(state.beacons)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

local function isBeacon(beaconId: any): boolean
    for _, id in BEACON_IDS do
        if id == beaconId then
            return true
        end
    end
    return false
end

function LighthouseEaterEncounter.litCount(state: State, now: number): number
    local lit = 0
    for _, id in BEACON_IDS do
        if (state.beacons[id] or 0) > now then
            lit += 1
        end
    end
    return lit
end

function LighthouseEaterEncounter.create(
    runId: string,
    manifestHash: string,
    enabled: boolean
): State
    assert(runId ~= "", "Lighthouse Eater run ID is required")
    assert(manifestHash ~= "", "Lighthouse Eater manifest hash is required")
    return {
        beacons = {},
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        status = if enabled then "dormant" else "disabled",
    }
end

function LighthouseEaterEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "hidden"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function LighthouseEaterEncounter.join(state: State, userId: number): State
    if state.status ~= "hidden" and state.status ~= "drawn" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    Light a beacon. It burns for a fixed span and draws the Eater into the
    open for exactly that long; lighting a second while the first burns
    extends nothing, because the Eater is already out -- what it buys is
    the next window starting later, which is the difference between a
    party that spends its light well and one that spends it all at once.
]]
function LighthouseEaterEncounter.lightBeacon(
    state: State,
    userId: number,
    beaconId: any,
    now: number
): (State, any)
    if state.status ~= "hidden" and state.status ~= "drawn" then
        return state, { accepted = false, reason = state.status }
    end
    if not isBeacon(beaconId) then
        return state, { accepted = false, reason = "unknown_beacon" }
    end
    if (state.beacons[beaconId] or 0) > now then
        return state, { accepted = false, reason = "already_lit" }
    end
    local nextState = cloneState(state)
    nextState.beacons[beaconId] = now + BEACON_SECONDS
    nextState.participants[participantKey(userId)] = true
    nextState.status = "drawn"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            burnsUntil = nextState.beacons[beaconId],
            lit = LighthouseEaterEncounter.litCount(nextState, now),
            reason = "beacon_lit",
        }
end

-- Beacons burn down on their own; when the last one gutters the Eater is
-- back in the wall and cannot be struck.
function LighthouseEaterEncounter.expire(state: State, now: number): State
    if state.status ~= "drawn" then
        return state
    end
    if LighthouseEaterEncounter.litCount(state, now) > 0 then
        return state
    end
    local nextState = cloneState(state)
    nextState.status = "hidden"
    nextState.revision += 1
    return nextState
end

function LighthouseEaterEncounter.strike(
    state: State,
    userId: number,
    amount: number,
    now: number
): (State, any)
    assert(amount > 0 and amount <= 100, "Lighthouse Eater strike amount is invalid")
    if state.status ~= "drawn" or LighthouseEaterEncounter.litCount(state, now) <= 0 then
        return state, { accepted = false, reason = "hidden" }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - amount)
    if nextState.health <= 0 then
        nextState.status = "complete"
        nextState.beacons = {}
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            reason = if nextState.status == "complete" then "completed" else "damaged",
        }
end

function LighthouseEaterEncounter.attack(attackIndex: number, litCount: number): any
    -- In the dark it lunges from the wall; in the light it snuffs what it
    -- can reach, which is the only time a party can see it coming.
    if litCount > 0 and attackIndex % 2 == 0 then
        return BEAM_SNUFF
    end
    return STORM_LUNGE
end

function LighthouseEaterEncounter.snapshot(state: State, userId: number, now: number): any
    local lit = LighthouseEaterEncounter.litCount(state, now)
    local instruction = if state.status == "hidden"
        then "IT IS IN THE STORM WALL — LIGHT A BEACON TO DRAW IT"
        elseif state.status == "drawn" then "IT IS IN THE OPEN — STRIKE WHILE THE BEAM HOLDS"
        elseif state.status == "complete" then "THE COAST KEEPS ITS LIGHT"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE POINT"
    return {
        active = state.status == "hidden" or state.status == "drawn",
        beaconTotal = #BEACON_IDS,
        beaconsLit = lit,
        complete = state.status == "complete",
        displayName = "LIGHTHOUSE EATER",
        drawn = state.status == "drawn",
        enabled = state.status ~= "disabled",
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, math.floor((MAX_HEALTH - state.health) / (MAX_HEALTH / 3)) + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        status = state.status,
    }
end

function LighthouseEaterEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        LighthouseEaterEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(LighthouseEaterEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">LobbyDeparture</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Departure platform state for the Emberhollow lobby.

    Pure logic: no Roblox instances, no players, no clock of its own. The
    service layer owns "who is physically standing on the platform" and passes
    that in as a count; everything about whether a departure may start, how long
    is left, and whether it may launch lives here so it can be tested and can
    never be decided by a client.

    The rules the countdown has to hold:

      * Only the platform counts. Players who are not standing on it when the
        countdown reaches zero are not taken, which is the whole point of a
        staging platform.
      * A departure cannot be started, resized, or rushed by a client. The
        client may only ask; every bound below is checked here.
      * An emptied platform cancels the countdown rather than launching nobody.
      * Launch happens exactly once per departure. The state is consumed on
        launch so a duplicated remote or a retried tick cannot send a party
        twice.
]]

local LobbyDeparture = {}

export type State = {
    partySize: number,
    countdownEndsAt: number,
    launchedAt: number,
}

export type Snapshot = {
    partySize: number,
    counting: boolean,
    secondsRemaining: number,
}

local COUNTDOWN_SECONDS = 10
local MIN_PARTY_SIZE = 1

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeAtLeast(value: any, minimum: number): boolean
    return finite(value) and value >= minimum and value == math.floor(value)
end

function LobbyDeparture.countdownSeconds(): number
    return COUNTDOWN_SECONDS
end

function LobbyDeparture.create(): State
    return { partySize = 0, countdownEndsAt = 0, launchedAt = 0 }
end

function LobbyDeparture.normalize(value: any): State
    if
        type(value) ~= "table"
        or not finite(value.partySize)
        or not finite(value.countdownEndsAt)
        or not finite(value.launchedAt)
        or value.partySize < 0
        or value.countdownEndsAt < 0
        or value.launchedAt < 0
    then
        return LobbyDeparture.create()
    end
    return {
        partySize = math.floor(value.partySize),
        countdownEndsAt = value.countdownEndsAt,
        launchedAt = value.launchedAt,
    }
end

--[[
    Ask to start a departure for `size` players.

    `readyCount` is how many players are standing on the platform right now.
    Requiring at least one means the button cannot start a countdown for an
    empty platform, and `maxPartySize` is supplied by the caller so the bound
    stays with Config rather than being duplicated here.
]]
function LobbyDeparture.requestDeparture(
    state: State,
    size: any,
    now: number,
    readyCount: any,
    maxPartySize: any
): (State, any)
    local current = LobbyDeparture.normalize(state)
    if not finite(now) or now < 0 then
        return current, { accepted = false, reason = "invalid_time" }
    end
    if not wholeAtLeast(maxPartySize, MIN_PARTY_SIZE) then
        return current, { accepted = false, reason = "invalid_capacity" }
    end
    if not wholeAtLeast(readyCount, 0) then
        return current, { accepted = false, reason = "invalid_ready_count" }
    end
    if not wholeAtLeast(size, MIN_PARTY_SIZE) or size > maxPartySize then
        return current, { accepted = false, reason = "invalid_party_size" }
    end
    if readyCount < 1 then
        return current, { accepted = false, reason = "platform_empty" }
    end
    if current.countdownEndsAt > now then
        return current, { accepted = false, reason = "already_counting" }
    end

    return {
        partySize = size,
        countdownEndsAt = now + COUNTDOWN_SECONDS,
        launchedAt = 0,
    }, {
        accepted = true,
        partySize = size,
        secondsRemaining = COUNTDOWN_SECONDS,
    }
end

--[[
    Advance the countdown.

    Returns `launch = true` exactly once, on the first tick at or after the
    deadline, and only while someone is still standing on the platform. The
    returned `capacity` is how many of those players may board.
]]
function LobbyDeparture.tick(state: State, now: number, readyCount: any): (State, any)
    local current = LobbyDeparture.normalize(state)
    if not finite(now) or not wholeAtLeast(readyCount, 0) then
        return current, { launch = false, reason = "invalid_tick" }
    end
    if current.countdownEndsAt <= 0 then
        return current, { launch = false, reason = "idle" }
    end
    if readyCount < 1 then
        -- Everyone stepped off. Cancel rather than launch an empty party.
        return LobbyDeparture.create(), { launch = false, reason = "platform_emptied" }
    end
    if now < current.countdownEndsAt then
        return current, { launch = false, reason = "counting" }
    end

    return { partySize = 0, countdownEndsAt = 0, launchedAt = now }, {
        launch = true,
        capacity = math.min(current.partySize, readyCount),
        partySize = current.partySize,
    }
end

function LobbyDeparture.cancel(state: State): State
    local _ = LobbyDeparture.normalize(state)
    return LobbyDeparture.create()
end

function LobbyDeparture.snapshot(state: State, now: number): Snapshot
    local current = LobbyDeparture.normalize(state)
    if not finite(now) or current.countdownEndsAt <= now then
        return { partySize = current.partySize, counting = false, secondsRemaining = 0 }
    end
    return {
        partySize = current.partySize,
        counting = true,
        secondsRemaining = math.max(0, math.ceil(current.countdownEndsAt - now)),
    }
end

return table.freeze(LobbyDeparture)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">ManyFaceEncounter</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The Many-Face -- Mireglass Fen's first elite.

    It wears a profession. Not yours necessarily: it cycles openly through
    the seven, and whichever it is wearing, it fights with that kit's
    strength and carries that kit's weakness. The catalog calls this
    "cycles visible copied profession", and visible is the whole design --
    the tell is never hidden, only brief. You cannot out-damage it wearing
    the wrong answer; you wait for the face that its current guard cannot
    cover, and you commit.

    Concretely: each face has a counter, expressed as a plain interaction
    at one of three fen mirrors. Strike it while its face is countered and
    the blow lands full; strike it uncountered and the mirror-guard turns
    most of it away. It changes face on its own clock, so the fight is
    read-and-time rather than lever-and-burst -- deliberately unlike the
    Foreman Echo, whose fight is order, and the Iron Widow's, whose fight
    is tempo.

    Same contract as every elite: profession-independent (the counters are
    mirrors anyone can turn), solo-passable, one reward per participant
    per run through a deterministic transaction id, disable-able, and
    every mutation server-called.
]]

local ManyFaceEncounter = {}

export type Status = "disabled" | "dormant" | "wearing" | "countered" | "complete"

export type State = {
    faceIndex: number,
    counteredUntil: number,
    health: number,
    manifestHash: string,
    mirrorsTurned: { [string]: boolean },
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    status: Status,
}

local MAX_HEALTH = 340
-- The seven faces, in the order it cycles them. It never hides which one
-- it is wearing; the pressure is that the window is short.
local FACES = table.freeze({
    "profession_forager",
    "profession_builder",
    "profession_scout",
    "profession_cook",
    "profession_healer",
    "profession_engineer",
    "profession_beastkeeper",
})
local MIRROR_IDS = table.freeze({
    mirror_left = true,
    mirror_center = true,
    mirror_right = true,
})
-- Turning the right mirror strips the face for this long. Long enough to
-- reach it, short enough that you must already be moving.
local COUNTER_SECONDS = 7
-- What an uncountered blow is worth against the mirror-guard.
local GUARDED_FRACTION = 0.25

local MIRROR_SPRAY = table.freeze({
    attackId = "many_face_mirror_spray",
    attackName = "MIRROR SPRAY",
    damage = 22,
    instruction = "GET OUT OF THE GLASS RING",
    radius = 11,
    shape = "circle",
    windup = 1.35,
})

local BORROWED_REACH = table.freeze({
    attackId = "many_face_borrowed_reach",
    attackName = "BORROWED REACH",
    damage = 28,
    instruction = "CLEAR THE LINE — IT HAS SOMEONE'S LANCE",
    length = 30,
    shape = "lane",
    width = 7,
    windup = 1.2,
})

ManyFaceEncounter.Id = "elite_many_face"
ManyFaceEncounter.MaxHealth = MAX_HEALTH
ManyFaceEncounter.Faces = FACES
ManyFaceEncounter.MirrorIds = MIRROR_IDS
ManyFaceEncounter.CounterSeconds = COUNTER_SECONDS
ManyFaceEncounter.GuardedFraction = GUARDED_FRACTION
ManyFaceEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_mirror_reed",
})
ManyFaceEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3,
    counteredAttackCooldownSeconds = 4.4,
    faceSeconds = 12,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.mirrorsTurned = table.clone(state.mirrorsTurned)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

--[[
    Which mirror answers the face it is currently wearing. Deterministic
    from the face index, so a player can learn it -- the fight rewards
    recognition, not luck.
]]
function ManyFaceEncounter.counterFor(faceIndex: number): string
    local mirrors = { "mirror_left", "mirror_center", "mirror_right" }
    return mirrors[(faceIndex - 1) % #mirrors + 1]
end

function ManyFaceEncounter.faceAt(faceIndex: number): string
    return FACES[(faceIndex - 1) % #FACES + 1]
end

function ManyFaceEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Many-Face run ID is required")
    assert(manifestHash ~= "", "Many-Face manifest hash is required")
    return {
        counteredUntil = 0,
        faceIndex = 1,
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        mirrorsTurned = {},
        participants = {},
        revision = 0,
        runId = runId,
        status = if enabled then "dormant" else "disabled",
    }
end

function ManyFaceEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.status = "wearing"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState, { accepted = true, activated = true, reason = "activated" }
end

function ManyFaceEncounter.join(state: State, userId: number): State
    if state.status ~= "wearing" and state.status ~= "countered" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

--[[
    Turn a fen mirror. The right one for the face it is wearing strips the
    guard for a window; a wrong one throws its own reflection back and
    does nothing but cost you the walk.
]]
function ManyFaceEncounter.turnMirror(
    state: State,
    userId: number,
    mirrorId: any,
    now: number
): (State, any)
    if state.status ~= "wearing" and state.status ~= "countered" then
        return state, { accepted = false, reason = state.status }
    end
    if type(mirrorId) ~= "string" or MIRROR_IDS[mirrorId] ~= true then
        return state, { accepted = false, reason = "unknown_mirror" }
    end
    local wanted = ManyFaceEncounter.counterFor(state.faceIndex)
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.mirrorsTurned[mirrorId] = true
    if mirrorId ~= wanted then
        nextState.revision += 1
        return nextState, { accepted = false, reason = "wrong_mirror" }
    end
    nextState.status = "countered"
    nextState.counteredUntil = now + COUNTER_SECONDS
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            counteredUntil = nextState.counteredUntil,
            face = ManyFaceEncounter.faceAt(state.faceIndex),
            reason = "face_countered",
        }
end

--[[
    It changes face on its own clock. Changing face restores the guard,
    resets which mirrors have been turned, and is the reason a player who
    dithers loses their window rather than their run.
]]
function ManyFaceEncounter.cycleFace(state: State): (State, any)
    if state.status ~= "wearing" and state.status ~= "countered" then
        return state, { accepted = false, reason = state.status }
    end
    local nextState = cloneState(state)
    nextState.faceIndex = (state.faceIndex % #FACES) + 1
    nextState.status = "wearing"
    nextState.counteredUntil = 0
    nextState.mirrorsTurned = {}
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            counter = ManyFaceEncounter.counterFor(nextState.faceIndex),
            face = ManyFaceEncounter.faceAt(nextState.faceIndex),
            reason = "face_changed",
        }
end

-- The counter window closing is the same event as the face resuming its
-- guard; the service calls this on its tick.
function ManyFaceEncounter.expire(state: State, now: number): State
    if state.status ~= "countered" or now < state.counteredUntil then
        return state
    end
    local nextState = cloneState(state)
    nextState.status = "wearing"
    nextState.counteredUntil = 0
    nextState.revision += 1
    return nextState
end

--[[
    A strike always lands -- the question is how much of it survives the
    mirror-guard. Countered: full. Guarded: a quarter, floored at 1, so a
    player who never reads a face still converges, very slowly, rather
    than being locked out of the fight entirely.
]]
function ManyFaceEncounter.strike(
    state: State,
    userId: number,
    amount: number,
    now: number
): (State, any)
    assert(amount > 0 and amount <= 100, "Many-Face strike amount is invalid")
    if state.status ~= "wearing" and state.status ~= "countered" then
        return state, { accepted = false, reason = state.status }
    end
    local countered = state.status == "countered" and now < state.counteredUntil
    local applied = if countered then amount else math.max(1, math.floor(amount * GUARDED_FRACTION))

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.health = math.max(0, state.health - applied)
    if nextState.health <= 0 then
        nextState.status = "complete"
        nextState.counteredUntil = 0
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            countered = countered,
            damage = applied,
            health = nextState.health,
            reason = if nextState.status == "complete"
                then "completed"
                elseif countered then "damaged"
                else "guarded",
        }
end

function ManyFaceEncounter.attack(attackIndex: number, faceIndex: number): any
    if faceIndex % 2 == 0 and attackIndex % 2 == 0 then
        return BORROWED_REACH
    end
    return MIRROR_SPRAY
end

function ManyFaceEncounter.snapshot(state: State, userId: number, now: number): any
    local countered = state.status == "countered" and now < state.counteredUntil
    local face = ManyFaceEncounter.faceAt(state.faceIndex)
    local instruction = if countered
        then "THE FACE IS STRIPPED — STRIKE NOW"
        elseif
            state.status == "wearing"
        then "IT WEARS ANOTHER'S FACE — TURN THE ANSWERING MIRROR"
        elseif state.status == "complete" then "THE FACES ARE ITS OWN AGAIN"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE MIRROR COURT"
    return {
        active = state.status == "wearing" or state.status == "countered",
        complete = state.status == "complete",
        countered = countered,
        counteredUntil = if countered then state.counteredUntil else 0,
        displayName = "THE MANY-FACE",
        enabled = state.status ~= "disabled",
        face = face,
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, math.floor((MAX_HEALTH - state.health) / (MAX_HEALTH / 3)) + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        status = state.status,
    }
end

function ManyFaceEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        ManyFaceEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(ManyFaceEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">MemoryFragments</string>
          <string name="Source"><![CDATA[--!strict
--[[
    Memory fragments -- Bramblewake's chapter-one story, told in the world.

    The world bible's premise has never reached the player: light is memory
    made shareable, the Long Night is the accumulated remainder of memories a
    machine took because nobody could carry them, and the missing keeper Orin
    Vale pulled seven seals deliberately. The player has been carrying the
    eighth since the prologue without ever being told what it is.

    A fragment is a remembered moment held by a place. Recovering one is a
    single interaction on an object that is already standing there -- the four
    authored story vignettes and the four points of interest -- so this adds
    meaning to built content rather than new clutter to walk past.

    The arc is three acts:

      I.  What the forest kept -- the evacuation, told by the people who
          failed it. Each one lands on a resident who is standing in
          Emberhollow right now (Ena's orchard, Pip's grandfather's mill,
          Tomas's bridge), so the town stops being scenery.
      II. The keeper's trail -- Orin came through here, and what he was
          actually doing was neither theft nor madness.
      III. Your part in it -- why the eighth seal is yours, and where the
          trail goes next. Gated behind chapter one, because it is the
          answer, and because the last fragment sits at the exit gate: the
          player learns what Chapter II is on their way home from finishing
          Chapter I.

    Everything here is content and pure logic. The server owns the collected
    set on the profile; a client never decides what it has found.
]]

local MemoryFragments = {}

export type Fragment = {
    id: string,
    title: string,
    foundAt: string,
    -- Where the shard physically sits. The builder resolves these against the
    -- world it just built, so content owns placement and the builder owns
    -- geometry: "story:<landmark>", "poi:<poi id>", or a named site.
    anchorKey: string,
    act: number,
    body: string,
    -- Fragments that only exist once the chapter is resolved. They are the
    -- payoff and the hook, and both would be nonsense read early.
    requiresChapterOne: boolean,
}

export type CollectResult = {
    accepted: boolean,
    reason: string?,
    fragment: Fragment?,
}

local function fragment(definition: Fragment): Fragment
    return table.freeze(definition)
end

local LIST: { Fragment } = table.freeze({
    -- ACT I -- What the forest kept
    fragment({
        id = "fragment_last_harvest",
        anchorKey = "story:last_harvest",
        title = "THE LAST HARVEST",
        foundAt = "Sunken Orchard",
        act = 1,
        requiresChapterOne = false,
        body = "They brought it in anyway. Every apple, every root, knowing the "
            .. "carts left at dawn and the cellar stayed behind. Ena Moss's "
            .. "grandmother wrote the count in the ledger, and underneath it "
            .. "she wrote: we did not waste it, we only failed to carry it. "
            .. "The orchard has been holding that harvest ever since.",
    }),
    fragment({
        id = "fragment_road_they_left",
        anchorKey = "story:evacuation_cart",
        title = "THE ROAD THEY LEFT",
        foundAt = "Hollow Farm",
        act = 1,
        requiresChapterOne = false,
        body = "Someone counted children at this bend. Counted twice, because "
            .. "the first count came up one short and the second came up "
            .. "right, and nobody afterward could agree which had been the "
            .. "mistake. The road remembers the counting. It does not "
            .. "remember the name it could not find.",
    }),
    fragment({
        id = "fragment_last_repair",
        anchorKey = "story:last_repair",
        title = "THE LAST REPAIR",
        foundAt = "Windmill Copse",
        act = 1,
        requiresChapterOne = false,
        body = "The mill was still turning when the last cart left. That was "
            .. "deliberate. A man named Ol' Wren stayed behind to keep it "
            .. "turning, so anyone still walking would have something to "
            .. "steer by. He is not in the arrival rolls at Emberhollow. The "
            .. "sails turned eleven more days. Pip has never been told.",
    }),
    fragment({
        id = "fragment_lost_crossing",
        anchorKey = "story:lost_crossing",
        title = "THE LOST CROSSING",
        foundAt = "Tangle Bridge",
        act = 1,
        requiresChapterOne = false,
        body = "The bridge went down under the third cart, not the first. "
            .. "Tomas Reed was quartermaster that night, and he had loaded "
            .. "the heavy stores last so the families could cross first. He "
            .. "has never once told that story as a thing he got right.",
    }),

    -- ACT II -- The keeper's trail
    fragment({
        id = "fragment_house_that_answered",
        anchorKey = "poi:poi_bw_reedstead_ruin",
        title = "THE HOUSE THAT ANSWERED",
        foundAt = "Reedstead Ruin",
        act = 2,
        requiresChapterOne = false,
        body = "This house kept answering its door for two winters after "
            .. "nobody lived in it. Not haunted -- remembered. The Long Night "
            .. "does not only take. Sometimes it holds a habit so tightly "
            .. "that the habit goes on without the person.",
    }),
    fragment({
        id = "fragment_what_moths_carry",
        anchorKey = "poi:poi_bw_mothwell",
        title = "WHAT THE MOTHS CARRY",
        foundAt = "Mothwell",
        act = 2,
        requiresChapterOne = false,
        body = "Light-moths carry a little of whatever light they hatched "
            .. "from. These hatched from evacuation lanterns. Follow enough "
            .. "of them and you are walking the road as it was walked, at the "
            .. "pace it was walked, behind people who are no longer there.",
    }),
    fragment({
        id = "fragment_keeper_came_through",
        anchorKey = "poi:poi_bw_sapglass_grove",
        title = "THE KEEPER CAME THROUGH",
        foundAt = "Sapglass Grove",
        act = 2,
        requiresChapterOne = false,
        body = "He tapped these trees and left the vials full, which is not "
            .. "what a thief does. The sap in them has gone to glass, and "
            .. "inside the glass is light that does not flicker. Orin Vale "
            .. "was testing whether a memory could be held outside a lantern. "
            .. "It can. That is the frightening part.",
    }),
    fragment({
        id = "fragment_what_orin_said",
        anchorKey = "poi:poi_bw_root_chapel",
        title = "WHAT ORIN SAID AT THE SEAL",
        foundAt = "Root Chapel",
        act = 2,
        requiresChapterOne = false,
        body = "I am not stealing them, he said. I am letting them out. The "
            .. "chapel heard it and kept it, the way roots keep everything. "
            .. "The machine has been eating what people could not carry -- "
            .. "seven towns' worth of grief, filed where nobody has to feel "
            .. "it. I have felt it, he said. Somebody had to.",
    }),

    -- ACT III -- Your part in it
    fragment({
        id = "fragment_eighth_seal",
        anchorKey = "site:warden_seal",
        title = "THE EIGHTH SEAL",
        foundAt = "The Warden's Seal",
        act = 3,
        requiresChapterOne = true,
        body = "He woke the Stag on purpose -- not to guard the seal against "
            .. "you, but to guard it for you, until someone arrived who would "
            .. "open it slowly. The eighth was never his to take. It answers "
            .. "to whoever chooses to carry it. You picked it up on the first "
            .. "morning without being asked, and it has been answering ever "
            .. "since.",
    }),
    fragment({
        id = "fragment_bell_beneath_iron",
        anchorKey = "site:wayhome",
        title = "A BELL, FAR UNDER",
        foundAt = "Wayhome Gate",
        act = 3,
        requiresChapterOne = true,
        body = "There is a bell ringing under Ironroot Delve. Nobody is "
            .. "pulling it. The shift-bell rang three times a day for forty "
            .. "years, and the crews who answered it were owed wages "
            .. "Emberhollow never paid; now it rings on time in an empty "
            .. "shaft. Orin went that way. He is walking one town's debt at a "
            .. "time, and the next question waiting for you is what a town "
            .. "owes the people whose labour built it. Bring an answer.",
    }),
})

local BY_ID: { [string]: Fragment } = {}
for _, entry in LIST do
    BY_ID[entry.id] = entry
end
table.freeze(BY_ID)

MemoryFragments.List = LIST
MemoryFragments.Count = #LIST

function MemoryFragments.byId(id: string): Fragment?
    return BY_ID[id]
end

function MemoryFragments.isKnown(id: string): boolean
    return BY_ID[id] ~= nil
end

--[[
    Normalize a stored collected set.

    Anything not in the current catalog is dropped, exactly the way gear and
    quest state already drop unknown IDs, so a retired fragment cannot keep
    occupying a player's archive count forever.
]]
function MemoryFragments.normalize(value: any): { [string]: boolean }
    local result: { [string]: boolean } = {}
    if type(value) ~= "table" then
        return result
    end
    for id, collected in value do
        if type(id) == "string" and collected == true and BY_ID[id] ~= nil then
            result[id] = true
        end
    end
    return result
end

--[[
    Recover one fragment.

    Pure and idempotent: recovering the same fragment twice is accepted once
    and reports the repeat, so a duplicated remote or a second tap can never
    double-count the archive.
]]
function MemoryFragments.collect(
    collected: { [string]: boolean },
    id: string,
    chapterResolved: boolean
): ({ [string]: boolean }, CollectResult)
    local entry = BY_ID[id]
    if entry == nil then
        return collected, { accepted = false, reason = "unknown_fragment" }
    end
    if entry.requiresChapterOne and not chapterResolved then
        return collected, { accepted = false, reason = "chapter_unresolved" }
    end
    if collected[id] == true then
        return collected, { accepted = false, reason = "already_recovered", fragment = entry }
    end
    local nextCollected = table.clone(collected)
    nextCollected[id] = true
    return nextCollected, { accepted = true, fragment = entry }
end

--[[
    What the Memory Archive shows.

    Recovered fragments read in authored order so the story assembles rather
    than arriving as a shuffled list. Missing ones are named by where they
    are, never hidden behind a question mark: the pull is "there is more to
    know and I know where to look", not a checklist with the labels torn off.
]]
function MemoryFragments.snapshot(
    collected: { [string]: boolean },
    chapterResolved: boolean
): {
    total: number,
    found: number,
    entries: { any },
    nextHint: string?,
}
    local entries = {}
    local found = 0
    local total = 0
    local nextHint: string? = nil
    for _, entry in LIST do
        local locked = entry.requiresChapterOne and not chapterResolved
        if not locked then
            total += 1
            local recovered = collected[entry.id] == true
            if recovered then
                found += 1
            elseif nextHint == nil then
                nextHint = entry.foundAt
            end
            table.insert(entries, {
                id = entry.id,
                title = entry.title,
                foundAt = entry.foundAt,
                act = entry.act,
                recovered = recovered,
                body = if recovered then entry.body else nil,
            })
        end
    end
    return { total = total, found = found, entries = entries, nextHint = nextHint }
end

return table.freeze(MemoryFragments)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">MireglassEnemies</string>
          <string name="Source"><![CDATA[--!strict

--[[
    Mireglass Fen's six standard enemies, in the shared definition shape.

    The Delve's roster is fast and positional: it uses straight lines and
    open plate. The Fen's is patient and deceptive. Almost nothing here
    closes on you at speed -- lurkers wait in water that looks empty,
    mirrorlings return the last thing you did, leeches attach and drain
    what you need to run, false friends call in a resident's voice, and
    the bog bell simply summons until somebody interrupts it. Its danger
    is misplaced trust, so its numbers are built around low speed, long
    telegraphs and effects that cost you resources rather than health.

    Two catalog behaviors -- copying a player's last basic attack, and a
    drain an ally can remove -- are approximated with the existing status
    vocabulary rather than invented blind, and recorded open for a live
    session, exactly as the Delve's hot zones were.
]]

local MireglassEnemies = {}

export type EnemyDefinition = {
    id: string,
    displayName: string,
    modelKey: string,
    health: number,
    speed: number,
    attackRange: number,
    attackCooldown: number,
    playerDamage: number,
    lanternDamage: number,
    strikeRange: number,
    strikeDamage: number,
    attackId: string,
    attackName: string,
    instruction: string,
    shape: "circle" | "lane",
    radius: number?,
    width: number?,
    length: number?,
    windup: number,
    stationary: boolean,
    targetMode: "lantern" | "player",
    frontShield: boolean,
    frontalStrikeDamage: number?,
    flankStrikeDamage: number?,
    statusEffect: ("drowsy" | "spark_theft")?,
    statusDuration: number?,
    statusMultiplier: number?,
    statusLanternDamage: number?,
}

local function freezeDefinition(definition: EnemyDefinition): EnemyDefinition
    return table.freeze(definition)
end

local DEFINITIONS: { [string]: EnemyDefinition } = {
    -- It is already there, in water you have looked at twice.
    enemy_reed_lurker = freezeDefinition({
        id = "enemy_reed_lurker",
        displayName = "Reed Lurker",
        modelKey = "reed_lurker",
        health = 105,
        speed = 5.4,
        attackRange = 9,
        attackCooldown = 2.4,
        playerDamage = 30,
        lanternDamage = 6,
        strikeRange = 9,
        strikeDamage = 36,
        attackId = "reed_lurker_lunge",
        attackName = "LURKER LUNGE",
        instruction = "BACK OUT OF THE SHALLOWS",
        shape = "circle",
        radius = 7,
        width = nil,
        length = nil,
        windup = 0.85,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- It gives back what you last gave, a beat late.
    enemy_mirrorling = freezeDefinition({
        id = "enemy_mirrorling",
        displayName = "Mirrorling",
        modelKey = "mirrorling",
        health = 90,
        speed = 6,
        attackRange = 11,
        attackCooldown = 3,
        playerDamage = 24,
        lanternDamage = 5,
        strikeRange = 10,
        strikeDamage = 34,
        attackId = "mirrorling_return",
        attackName = "RETURNED BLOW",
        instruction = "DO NOT STAND WHERE YOU JUST STRUCK",
        shape = "circle",
        radius = 8,
        width = nil,
        length = nil,
        windup = 1.45,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- It costs you the thing you need to leave: your legs.
    enemy_mire_leech = freezeDefinition({
        id = "enemy_mire_leech",
        displayName = "Mire Leech",
        modelKey = "mire_leech",
        health = 70,
        speed = 4.6,
        attackRange = 7,
        attackCooldown = 2.8,
        playerDamage = 12,
        lanternDamage = 3,
        strikeRange = 8,
        strikeDamage = 42,
        attackId = "mire_leech_latch",
        attackName = "LEECH LATCH",
        instruction = "SHAKE IT OFF — KEEP MOVING",
        shape = "circle",
        radius = 6,
        width = nil,
        length = nil,
        windup = 1,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "drowsy",
        statusDuration = 8,
        statusMultiplier = 0.68,
        statusLanternDamage = nil,
    }),
    -- It calls in a voice from town, and it is patient about it.
    enemy_false_friend = freezeDefinition({
        id = "enemy_false_friend",
        displayName = "False Friend",
        modelKey = "false_friend",
        health = 115,
        speed = 5,
        attackRange = 10,
        attackCooldown = 3.2,
        playerDamage = 28,
        lanternDamage = 10,
        strikeRange = 10,
        strikeDamage = 34,
        attackId = "false_friend_embrace",
        attackName = "FALSE WELCOME",
        instruction = "IT IS NOT WHO IT SOUNDS LIKE — KEEP AWAY",
        shape = "circle",
        radius = 9,
        width = nil,
        length = nil,
        windup = 1.6,
        stationary = false,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = "spark_theft",
        statusDuration = 6,
        statusMultiplier = nil,
        statusLanternDamage = 8,
    }),
    -- A single exact line across still water. Stand out of it.
    enemy_glass_heron = freezeDefinition({
        id = "enemy_glass_heron",
        displayName = "Glass Heron",
        modelKey = "glass_heron",
        health = 80,
        speed = 3.2,
        attackRange = 30,
        attackCooldown = 3.6,
        playerDamage = 34,
        lanternDamage = 8,
        strikeRange = 10,
        strikeDamage = 38,
        attackId = "glass_heron_strike",
        attackName = "HERON STRIKE",
        instruction = "STEP OUT OF ITS LINE",
        shape = "lane",
        radius = nil,
        width = 4,
        length = 30,
        windup = 1.7,
        stationary = true,
        targetMode = "player",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    -- It does not fight. It rings, and the fen answers, until you stop it.
    enemy_bog_bell = freezeDefinition({
        id = "enemy_bog_bell",
        displayName = "Bog Bell",
        modelKey = "bog_bell",
        health = 140,
        speed = 0,
        attackRange = 18,
        attackCooldown = 4.4,
        playerDamage = 16,
        lanternDamage = 20,
        strikeRange = 12,
        strikeDamage = 36,
        attackId = "bog_bell_toll",
        attackName = "THE TOLLING",
        instruction = "SILENCE THE BELL BEFORE IT FINISHES",
        shape = "circle",
        radius = 15,
        width = nil,
        length = nil,
        windup = 2,
        stationary = true,
        targetMode = "lantern",
        frontShield = false,
        frontalStrikeDamage = nil,
        flankStrikeDamage = nil,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
}

local ORDER = table.freeze({
    "enemy_reed_lurker",
    "enemy_mirrorling",
    "enemy_mire_leech",
    "enemy_false_friend",
    "enemy_glass_heron",
    "enemy_bog_bell",
})

function MireglassEnemies.get(enemyId: string): EnemyDefinition?
    return DEFINITIONS[enemyId]
end

function MireglassEnemies.require(enemyId: string): EnemyDefinition
    local definition = DEFINITIONS[enemyId]
    assert(definition ~= nil, string.format("unknown Mireglass enemy ID %q", enemyId))
    return definition
end

function MireglassEnemies.order(): { string }
    return table.clone(ORDER)
end

function MireglassEnemies.all(): { EnemyDefinition }
    local result: { EnemyDefinition } = {}
    for _, enemyId in ORDER do
        table.insert(result, DEFINITIONS[enemyId])
    end
    return result
end

return table.freeze(MireglassEnemies)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">MusicCatalog</string>
          <string name="Source"><![CDATA[--!strict

local MusicCatalog = {}

export type Track = {
    id: string,
    assetId: number,
    name: string,
    creator: string,
    duration: number,
    volume: number,
    intensity: number,
}

export type RegionScore = {
    day: Track,
    dusk: Track,
    night: Track,
}

local function track(
    id: string,
    assetId: number,
    name: string,
    creator: string,
    duration: number,
    volume: number,
    intensity: number
): Track
    return table.freeze({
        id = id,
        assetId = assetId,
        name = name,
        creator = creator,
        duration = duration,
        volume = volume,
        intensity = intensity,
    })
end

local REGIONS: { [string]: RegionScore } = {
    region_emberhollow = table.freeze({
        day = track(
            "music_emberhollow_day",
            110126070795458,
            "Light On The Meadow",
            "Epic Fantasy Music",
            235,
            0.18,
            0.22
        ),
        dusk = track(
            "music_emberhollow_dusk",
            101993543714380,
            "Dusk in the Glade",
            "Epic Fantasy Music",
            228,
            0.18,
            0.52
        ),
        -- Night in Emberhollow is a defence, not a lullaby: this is the
        -- phase creatures come for the lantern. "The Night's Serenade" was
        -- pretty and completely at odds with what is happening on screen.
        -- Slightly louder than the day and dusk cues, because it should
