        role = "resource",
        visual = "salvage_flats",
        tags = { "resource", "wreck" },
        poiSocket = true,
        eventSocket = true,
        partBudget = 44,
        lightBudget = 2,
        effectBudget = 2,
    }),
    frozenDefinition({
        id = "module_tr_saltworks",
        displayName = "Saltworks",
        role = "resource",
        visual = "saltworks",
        tags = { "resource", "safe" },
        poiSocket = true,
        eventSocket = true,
        partBudget = 42,
        lightBudget = 2,
        effectBudget = 2,
    }),
    frozenDefinition({
        id = "module_tr_kelp_racks",
        displayName = "Kelp Racks",
        role = "resource",
        visual = "kelp_racks",
        tags = { "resource", "water" },
        poiSocket = true,
        eventSocket = true,
        partBudget = 40,
        lightBudget = 2,
        effectBudget = 2,
    }),
    frozenDefinition({
        id = "module_tr_amberglass_shoal",
        displayName = "Amberglass Shoal",
        role = "resource",
        visual = "amberglass_shoal",
        tags = { "resource", "risk" },
