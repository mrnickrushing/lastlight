        CFrame.new(20, 3, -48),
        BARK,
        Enum.Material.Wood
    )
    stump.Shape = Enum.PartType.Cylinder
    stump.CFrame *= CFrame.Angles(0, 0, math.pi / 2)
    local heart = part(
        interactables,
        "HeartwoodCore",
        Vector3.new(3.2, 3.2, 3.2),
