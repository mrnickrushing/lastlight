local pointsOfInterest = {
    frozenDefinition({
        id = "poi_tr_lighthouse_stump",
        displayName = "Lighthouse Stump",
        visual = "lighthouse_stump",
        tags = { "story", "warning" },
        detail = "The tower is gone above the second gallery. The lamp room "
            .. "washed up four miles east, still bolted to its floor.",
    }),
    frozenDefinition({
        id = "poi_tr_ship_names_wall",
        displayName = "Wall of Names",
        visual = "ship_names_wall",
        tags = { "story", "resident" },
        detail = "Every hull the reach has taken, cut into the sea wall. "
            .. "The last three were added in the same hand, on the same day.",
    }),
    frozenDefinition({
        id = "poi_tr_still_water",
        displayName = "The Still Water",
        visual = "still_water",
        tags = { "mystery", "risk" },
        detail = "A circle of flat calm the storm does not touch, and no "
            .. "gull will cross. Whatever holds it has held for years.",
    }),
    frozenDefinition({
        id = "poi_tr_beached_keel",
        displayName = "Beached Keel",
        visual = "beached_keel",
        tags = { "wreck", "resource" },
        detail = "A hull laid open like a ribcage, picked clean of iron. "
            .. "Somebody has been sleeping in the forward hold.",
    }),
    frozenDefinition({
        id = "poi_tr_signal_kite",
        displayName = "Signal Kite",
        visual = "signal_kite",
        tags = { "story", "warning" },
        detail = "A storm kite still flying on a wire nobody has touched "
            .. "in a season, spelling the same warning to an empty coast.",
    }),
    frozenDefinition({
        id = "poi_tr_glass_beach",
        displayName = "Glass Beach",
        visual = "glass_beach",
        tags = { "resource", "mystery" },
        detail = "Lightning struck this sand often enough to make a floor "
            .. "of it. It rings underfoot and it is warm after dark.",
    }),
    frozenDefinition({
        id = "poi_tr_pilots_chair",
        displayName = "Pilot's Chair",
        visual = "pilots_chair",
        tags = { "story", "sanctuary" },
        detail = "Bolted to the rock facing the channel, worn smooth. "
            .. "Whoever sat here watched every ship in and did not leave.",
    }),
    frozenDefinition({
        id = "poi_tr_anchor_field",
        displayName = "Anchor Field",
        visual = "anchor_field",
        tags = { "wreck", "warning" },
        detail = "Thirty anchors set in a row on the tideline, flukes up. "
            .. "Not lost -- planted, by somebody who wanted them found.",
    }),
    frozenDefinition({
        id = "poi_tr_gull_watch",
        displayName = "Gull Watch",
        visual = "gull_watch",
        tags = { "warning", "safe" },
        detail = "The colony leaves this ledge a full minute before the "
            .. "lightning turns. The birds have never once been wrong.",
    }),
    frozenDefinition({
        id = "poi_tr_rope_locker",
        displayName = "Rope Locker",
        visual = "rope_locker",
        tags = { "resource", "resident" },
        detail = "Coils enough to rig a fleet, kept dry and kept coiled, "
            .. "by someone who still expects the fleet.",
    }),
    frozenDefinition({
        id = "poi_tr_drowned_chapel_bell",
        displayName = "Drowned Chapel Bell",
        visual = "drowned_chapel_bell",
        tags = { "story", "mystery" },
        detail = "It rings at the turn of the tide, underwater, and the "
            .. "sound arrives through the soles of your feet.",
    }),
    frozenDefinition({
        id = "poi_tr_last_boat",
        displayName = "The Last Boat",
        visual = "last_boat",
        tags = { "story", "sanctuary" },
        detail = "Provisioned, rigged and never launched. The mooring line "
            .. "was cut from the shore side, by somebody staying behind.",
    }),
}

