      <Item class="LocalScript" referent="72">
        <Properties>
          <string name="Name">LastLightClient</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local root = ReplicatedStorage:WaitForChild("LastLight", 8)
assert(root ~= nil, "Last Light shared root did not replicate before client bootstrap timeout")

local Config = require(root.Config)
local AmbientMotion = require(root.AmbientMotion)
local ProfessionCatalog = require(root.ProfessionCatalog)
local RuntimeIds = require(root.RuntimeIds)
local AmbientController = require(script.Controllers.AmbientController)
local HUDController = require(script.Controllers.HUDController)
local InputController = require(script.Controllers.InputController)
local InteractionController = require(script.Controllers.InteractionController)
local WorldMotionController = require(script.Controllers.WorldMotionController)

local runtime =
    ReplicatedStorage:WaitForChild(RuntimeIds.FolderName, Config.BootstrapTimeoutSeconds)
assert(runtime ~= nil, "Last Light runtime did not replicate before client bootstrap timeout")

local actionRequest =
    runtime:WaitForChild(RuntimeIds.Remotes.ActionRequest, Config.BootstrapTimeoutSeconds)
local stateChanged =
    runtime:WaitForChild(RuntimeIds.Remotes.StateChanged, Config.BootstrapTimeoutSeconds)
local getState = runtime:WaitForChild(RuntimeIds.Remotes.GetState, Config.BootstrapTimeoutSeconds)
assert(actionRequest ~= nil and actionRequest:IsA("RemoteEvent"), "missing ActionRequest")
assert(stateChanged ~= nil and stateChanged:IsA("RemoteEvent"), "missing StateChanged")
assert(getState ~= nil and getState:IsA("RemoteFunction"), "missing GetState")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui", Config.BootstrapTimeoutSeconds)
assert(playerGui ~= nil and playerGui:IsA("PlayerGui"), "PlayerGui unavailable")

local hud = HUDController.new(playerGui, ProfessionCatalog.list())
local ambient = AmbientController.new(RuntimeIds.AmbientMoteTag)
local worldMotion = WorldMotionController.new(
    RuntimeIds.AmbientMotionTag,
    RuntimeIds.AmbientLightTag,
    AmbientMotion
)
local interaction = InteractionController.new(RuntimeIds.InteractionTag, hud)

local function send(kind: string, fields: { [string]: any }?)
    local payload = fields or {}
    payload.schemaVersion = 1
    payload.kind = kind
    actionRequest:FireServer(payload)
end

InputController.new(hud, function()
    local interactionId = interaction:currentInteractionId()
    if interactionId ~= nil then
        send(RuntimeIds.Actions.Interact, { interactionId = interactionId })
    end
end, function()
    send(RuntimeIds.Actions.UseTool)
end, function(enabled: boolean)
    send(RuntimeIds.Actions.Sprint, { enabled = enabled })
end, function()
    send(RuntimeIds.Actions.Dodge)
end, function()
    send(RuntimeIds.Actions.ProfessionAbility)
end, function()
    hud:setProfessionMenuOpen(true)
end, function()
    send(RuntimeIds.Actions.UseGear, { itemId = "gear_amber_charm" })
end, function()
    send(RuntimeIds.Actions.UseGear, { itemId = "gear_meadow_satchel" })
end)

hud:setCompactHandler(function(enabled: boolean)
    send(RuntimeIds.Actions.CompactHud, { enabled = enabled })
end)

hud:setProfessionHandler(function(professionId: string)
    send(RuntimeIds.Actions.SelectProfession, { professionId = professionId })
end)

hud:setEquipHandler(function(itemId: string)
    send(RuntimeIds.Actions.EquipGear, { itemId = itemId })
end)

stateChanged.OnClientEvent:Connect(function(snapshot: any)
    hud:update(snapshot)
    ambient:setPhase(tostring(snapshot.phase or "day"))
    worldMotion:setPhase(tostring(snapshot.phase or "day"))
end)

task.spawn(function()
    local ok, snapshot = pcall(function()
        return getState:InvokeServer()
    end)
    if ok and snapshot ~= nil then
        hud:update(snapshot)
        ambient:setPhase(tostring(snapshot.phase or "day"))
        worldMotion:setPhase(tostring(snapshot.phase or "day"))
    end
end)

print(string.format("[Last Light] Client boot %s", Config.BuildVersion))
]]></string>
        </Properties>
        <Item class="Folder" referent="73">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">AmbientController</string>
              <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local AmbientController = {}
AmbientController.__index = AmbientController

type MoteState = {
    basePosition: Vector3,
    baseTransparency: number,
    phaseOffset: number,
    visible: boolean,
}

export type AmbientController = typeof(setmetatable(
    {} :: {
        _tag: string,
        _motes: { [BasePart]: MoteState },
        _phase: string,
        _elapsed: number,
        _connection: RBXScriptConnection?,
    },
    AmbientController
))

local ACTIVE_DISTANCE = 125
local UPDATE_INTERVAL = 1 / 24

local function phaseOffsetFor(instance: Instance): number
    local position = if instance:IsA("BasePart") then instance.Position else Vector3.zero
    return math.abs(position.X * 0.071 + position.Y * 0.137 + position.Z * 0.043) % (math.pi * 2)
end

function AmbientController.new(tag: string): AmbientController
    local self = setmetatable({
        _tag = tag,
        _motes = {},
        _phase = "day",
        _elapsed = 0,
        _connection = nil,
    }, AmbientController)

    local function register(instance: Instance)
        if not instance:IsA("BasePart") or self._motes[instance] ~= nil then
            return
        end
        self._motes[instance] = {
            basePosition = instance.Position,
            baseTransparency = instance.Transparency,
            phaseOffset = phaseOffsetFor(instance),
            visible = false,
        }
    end
    local function unregister(instance: Instance)
        if instance:IsA("BasePart") then
            self._motes[instance] = nil
        end
    end

    for _, instance in CollectionService:GetTagged(tag) do
        register(instance)
    end
    CollectionService:GetInstanceAddedSignal(tag):Connect(register)
    CollectionService:GetInstanceRemovedSignal(tag):Connect(unregister)

    local accumulator = 0
    self._connection = RunService.RenderStepped:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < UPDATE_INTERVAL then
            return
        end
        local elapsed = accumulator
        accumulator = 0
        self:_step(elapsed)
    end)
    return self
end

function AmbientController.setPhase(self: AmbientController, phase: string)
    self._phase = string.lower(phase)
end

function AmbientController._step(self: AmbientController, deltaTime: number)
    self._elapsed += deltaTime
    local camera = Workspace.CurrentCamera
    if camera == nil then
        return
    end
    local cameraPosition = camera.CFrame.Position
    local night = self._phase == "night"
    local dusk = self._phase == "dusk"
    local amplitude = if night then 0.92 elseif dusk then 0.68 else 0.42
    local transparencyBias = if night then -0.08 elseif dusk then -0.03 else 0.14

    for mote, state in self._motes do
        if mote.Parent == nil then
            self._motes[mote] = nil
            continue
        end
        local active = (state.basePosition - cameraPosition).Magnitude <= ACTIVE_DISTANCE
        if active then
            local wave = self._elapsed + state.phaseOffset
            mote.Position = state.basePosition
                + Vector3.new(
                    math.sin(wave * 0.83) * amplitude,
                    math.sin(wave * 1.17) * amplitude * 0.45,
                    math.cos(wave * 0.71) * amplitude
                )
            mote.Transparency = math.clamp(
                state.baseTransparency + transparencyBias + math.sin(wave * 1.7) * 0.08,
                0.04,
                0.72
            )
            state.visible = true
        elseif state.visible then
            mote.Position = state.basePosition
            mote.Transparency = math.clamp(state.baseTransparency + transparencyBias, 0.04, 0.72)
            state.visible = false
        end
    end
end

return AmbientController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")

local HUDController = {}
HUDController.__index = HUDController

local function createItemIcon(parent: Instance, itemId: string, size: number): ViewportFrame
    local viewport = Instance.new("ViewportFrame")
    viewport.Name = "ItemIcon"
    viewport.Size = UDim2.fromOffset(size, size)
    viewport.Position = UDim2.fromOffset(6, 5)
    viewport.BackgroundColor3 = Color3.fromRGB(20, 31, 29)
    viewport.BackgroundTransparency = 0.12
    viewport.BorderSizePixel = 0
    viewport.Ambient = Color3.fromRGB(210, 220, 210)
    viewport.LightColor = Color3.fromRGB(255, 220, 160)
    viewport.ZIndex = parent:IsA("GuiObject") and parent.ZIndex + 1 or 1
    viewport.Parent = parent

    local world = Instance.new("WorldModel")
    world.Parent = viewport
    local camera = Instance.new("Camera")
    camera.CFrame = CFrame.new(0, 0.4, 6) * CFrame.Angles(0, math.rad(18), 0)
    camera.FieldOfView = 28
    camera.Parent = viewport
    viewport.CurrentCamera = camera

    local function shape(name: string, dimensions: Vector3, position: Vector3, color: Color3)
        local object = Instance.new("Part")
        object.Name = name
        object.Anchored = true
        object.CanCollide = false
        object.Size = dimensions
        object.Position = position
        object.Color = color
        object.Material = Enum.Material.SmoothPlastic
        object.Parent = world
        return object
    end

    if itemId == "gear_meadow_satchel" then
        shape(
            "Bag",
            Vector3.new(2.5, 1.8, 1.2),
            Vector3.new(0, 0, 0),
            Color3.fromRGB(133, 176, 108)
        )
        shape(
            "Flap",
            Vector3.new(2.1, 0.25, 1.25),
            Vector3.new(0, 0.95, -0.05),
            Color3.fromRGB(94, 128, 78)
        )
        shape(
            "Strap",
            Vector3.new(0.25, 2.6, 0.25),
            Vector3.new(0, 0.15, 0.7),
            Color3.fromRGB(73, 48, 36)
        )
    elseif itemId == "gear_amber_charm" then
        local gem = shape(
            "Amber",
            Vector3.new(1.4, 1.4, 1.4),
            Vector3.new(0, 0, 0),
            Color3.fromRGB(255, 181, 76)
        )
        gem.Shape = Enum.PartType.Ball
        local ring = shape(
            "Ring",
            Vector3.new(0.28, 2.2, 2.2),
            Vector3.new(0, 0, 0),
            Color3.fromRGB(94, 206, 176)
        )
        ring.Shape = Enum.PartType.Cylinder
        ring.Orientation = Vector3.new(0, 0, 90)
    elseif itemId == "gear_ironroot_hood" then
        shape(
            "Hood",
            Vector3.new(2.4, 1.8, 1.8),
            Vector3.new(0, 0.1, 0),
            Color3.fromRGB(76, 101, 88)
        )
        shape(
            "Rim",
            Vector3.new(2.6, 0.25, 1.9),
            Vector3.new(0, -0.82, -0.1),
            Color3.fromRGB(44, 62, 54)
        )
    else
        shape(
            "BootLeft",
            Vector3.new(0.9, 1.7, 1.8),
            Vector3.new(-0.65, -0.05, 0),
            Color3.fromRGB(142, 112, 84)
        )
        shape(
            "BootRight",
            Vector3.new(0.9, 1.7, 1.8),
            Vector3.new(0.65, -0.05, 0),
            Color3.fromRGB(116, 86, 63)
        )
    end
    return viewport
end

local COLORS = {
    ink = Color3.fromRGB(14, 22, 21),
    panel = Color3.fromRGB(20, 31, 29),
    panelSoft = Color3.fromRGB(28, 43, 39),
    cream = Color3.fromRGB(244, 230, 197),
    muted = Color3.fromRGB(178, 194, 183),
    amber = Color3.fromRGB(255, 181, 76),
    green = Color3.fromRGB(91, 166, 116),
    danger = Color3.fromRGB(220, 86, 71),
    blue = Color3.fromRGB(104, 177, 190),
}

local function corner(parent: Instance, radius: number)
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, radius)
    uiCorner.Parent = parent
end

local function stroke(parent: Instance, color: Color3, transparency: number)
    local uiStroke = Instance.new("UIStroke")
    uiStroke.Color = color
    uiStroke.Transparency = transparency
    uiStroke.Thickness = 1.5
    uiStroke.Parent = parent
end

local function textLabel(
    parent: Instance,
    name: string,
    text: string,
    size: UDim2,
    position: UDim2,
    textSize: number,
    color: Color3,
    alignment: Enum.TextXAlignment?
): TextLabel
    local label = Instance.new("TextLabel")
    label.Name = name
    label.BackgroundTransparency = 1
    label.Size = size
    label.Position = position
    label.Font = Enum.Font.GothamMedium
    label.Text = text
    label.TextColor3 = color
    label.TextSize = textSize
    label.TextWrapped = true
    label.TextXAlignment = alignment or Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = parent
    return label
end

local function actionButton(
    parent: Instance,
    name: string,
    text: string,
    size: number,
    position: UDim2,
    anchor: Vector2
): TextButton
    local button = Instance.new("TextButton")
    button.Name = name
    button.AnchorPoint = anchor
    button.Position = position
    button.Size = UDim2.fromOffset(size, size)
    button.AutoButtonColor = true
    button.BackgroundColor3 = COLORS.panel
    button.BackgroundTransparency = 0.04
    button.Font = Enum.Font.GothamBold
    button.Text = text
    button.TextColor3 = COLORS.cream
    button.TextSize = 18
    button.TextWrapped = true
    button.ZIndex = 10
    button.Parent = parent
    corner(button, math.floor(size / 2))
    stroke(button, COLORS.amber, 0.1)
    return button
end

export type HUDController = typeof(setmetatable(
    {} :: {
        _gui: ScreenGui,
        _scale: UIScale,
        _phaseFrame: Frame,
        _phase: TextLabel,
        _objectiveFrame: Frame,
        _objective: TextLabel,
        _detail: TextLabel,
        _progress: TextLabel,
        _mara: TextLabel,
        _resource: TextLabel,
        _health: TextLabel,
        _staminaFrame: Frame,
        _staminaFill: Frame,
        _staminaText: TextLabel,
        _toast: TextLabel,
        _lanternFrame: Frame,
        _lanternFill: Frame,
        _lanternText: TextLabel,
        _blackoutFrame: Frame,
        _blackoutFill: Frame,
        _blackoutTitle: TextLabel,
        _blackoutDetail: TextLabel,
        _eliteFrame: Frame,
        _eliteFill: Frame,
        _eliteTitle: TextLabel,
        _eliteDetail: TextLabel,
        _allyFrame: Frame,
        _allyTitle: TextLabel,
        _allyDetail: TextLabel,
        _threatFrame: Frame,
        _threatTitle: TextLabel,
        _threatDetail: TextLabel,
        _downedFrame: Frame,
        _downedFill: Frame,
        _downedTimer: TextLabel,
        _downedDetail: TextLabel,
        _downedAlly: TextLabel,
        _primary: TextButton,
        _tool: TextButton,
        _sprint: TextButton,
        _dodge: TextButton,
        _ability: TextButton,
        _compact: TextButton,
        _professionButton: TextButton,
        _progressButton: TextButton,
        _useCharm: TextButton,
        _useSatchel: TextButton,
        _professionOverlay: Frame,
        _professionPanel: Frame,
        _professionCards: { [string]: TextButton },
        _professionOrder: { string },
        _professionClose: TextButton,
        _progressOverlay: Frame,
        _progressText: TextLabel,
        _equipmentButtons: { [string]: TextButton },
        _currentState: any,
        _interactionLabel: string?,
        _interactionAvailable: boolean,
        _inputMode: string,
        _compactEnabled: boolean,
        _playerDowned: boolean,
        _combatContext: boolean,
        _professionMenuOpen: boolean,
        _professionSwitchable: boolean,
        _lastToastRevision: number,
        _lastPhase: string?,
        _onCompact: ((boolean) -> ())?,
        _onProfessionSelected: ((string) -> ())?,
        _onEquip: ((string) -> ())?,
    },
    HUDController
))

