      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">BramblewakeEnemies</string>
          <string name="Source"><![CDATA[--!strict

local BramblewakeEnemies = {}

export type AttackShape = "circle" | "lane"
export type TargetMode = "lantern" | "player"
export type StatusEffect = "drowsy" | "spark_theft"

export type EnemyDefinition = {
    id: string,
    displayName: string,
    modelKey: string,
    health: number,
    speed: number,
    attackRange: number,
    attackCooldown: number,
    playerDamage: number,
    lanternDamage: number,
    strikeRange: number,
    strikeDamage: number,
    attackId: string,
    attackName: string,
    instruction: string,
    shape: AttackShape,
    radius: number?,
    width: number?,
    length: number?,
    windup: number,
    stationary: boolean,
    targetMode: TargetMode,
    frontShield: boolean,
    frontalStrikeDamage: number?,
    flankStrikeDamage: number?,
    statusEffect: StatusEffect?,
    statusDuration: number?,
    statusMultiplier: number?,
    statusLanternDamage: number?,
}

local function freezeDefinition(definition: EnemyDefinition): EnemyDefinition
    return table.freeze(definition)
end

local DEFINITIONS: { [string]: EnemyDefinition } = {
    enemy_rootling = freezeDefinition({
        id = "enemy_rootling",
        displayName = "Rootling",
        modelKey = "rootling",
        health = 100,
