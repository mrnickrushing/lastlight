  <Item class="Workspace" referent="79">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-80</float>
      <token name="ModelStreamingBehavior">2</token>
      <bool name="NeedsPivotMigration">false</bool>
      <token name="PlayerScriptsUseInputActionSystem">2</token>
      <bool name="StreamingEnabled">true</bool>
      <token name="StreamingIntegrityMode">3</token>
      <int name="StreamingMinRadius">64</int>
      <int name="StreamingTargetRadius">1024</int>
    </Properties>
