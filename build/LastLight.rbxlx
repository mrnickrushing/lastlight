      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">NightSchedule</string>
          <string name="Source"><![CDATA[--!strict

local NightSchedule = {}

export type Beat = {
    at: number,
    kind: "spawn" | "warning" | "breach",
    enemyId: string?,
}

local BEATS: { Beat } = {
    { at = 0, kind = "warning", enemyId = nil },
    { at = 4, kind = "spawn", enemyId = "enemy_rootling" },
    { at = 22, kind = "spawn", enemyId = "enemy_briarback" },
    { at = 40, kind = "spawn", enemyId = "enemy_zombie" },
    { at = 56, kind = "breach", enemyId = nil },
    { at = 58, kind = "spawn", enemyId = "enemy_hollow_crow" },
    { at = 76, kind = "spawn", enemyId = "enemy_snapvine" },
    { at = 94, kind = "spawn", enemyId = "enemy_bark_ram" },
}

function NightSchedule.beats(duration: number): { Beat }
    local result: { Beat } = {}
    for _, beat in BEATS do
        if beat.at < duration then
            table.insert(result, table.clone(beat))
        end
    end
    return result
end

function NightSchedule.pending(duration: number, elapsed: number): { Beat }
    local result: { Beat } = {}
    for _, beat in NightSchedule.beats(duration) do
        if beat.at >= elapsed then
            table.insert(result, beat)
        end
    end
    return result
end

return table.freeze(NightSchedule)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">OldGrowthEncounter</string>
          <string name="Source"><![CDATA[--!strict

local OldGrowthEncounter = {}

export type Status = "disabled" | "dormant" | "vulnerable" | "shielded" | "complete"

export type State = {
    carriers: { [string]: number },
    health: number,
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    shieldIndex: number,
    status: Status,
}

local MAX_HEALTH = 360
local FIRE_CARRY_SECONDS = 15
local SHIELD_THRESHOLDS = table.freeze({ 240, 120 })

local ROOT_LANE = table.freeze({
    attackId = "old_growth_root_lane",
    attackName = "CATHEDRAL ROOTS",
    damage = 20,
    instruction = "CLEAR THE ROOT LANE",
    length = 32,
    rootedDuration = 1.6,
    rootedMultiplier = 0.35,
    shape = "lane",
    width = 9,
    windup = 1.35,
})

local CANOPY_FALL = table.freeze({
    attackId = "old_growth_canopy_fall",
    attackName = "CANOPY FALL",
    damage = 28,
    instruction = "LEAVE THE FALL RING",
    radius = 10,
    shape = "circle",
    windup = 1.55,
})

OldGrowthEncounter.Id = "elite_old_growth"
OldGrowthEncounter.MaxHealth = MAX_HEALTH
OldGrowthEncounter.FireCarrySeconds = FIRE_CARRY_SECONDS
OldGrowthEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_amber_sap",
})
OldGrowthEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3,
    markedAttackCooldownMultiplier = 1.35,
    markedStrikeDamage = 40,
    shieldedAttackCooldownSeconds = 4.2,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.carriers = table.clone(state.carriers)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

function OldGrowthEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Old Growth run ID is required")
    assert(manifestHash ~= "", "Old Growth manifest hash is required")
    return {
        carriers = {},
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        shieldIndex = 0,
        status = if enabled then "dormant" else "disabled",
    }
end

function OldGrowthEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.status = "vulnerable"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            activated = true,
            reason = "activated",
        }
end

function OldGrowthEncounter.join(state: State, userId: number): State
    if state.status ~= "vulnerable" and state.status ~= "shielded" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function OldGrowthEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Old Growth strike amount is invalid")
    if state.status ~= "vulnerable" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local nextHealth = math.max(0, state.health - amount)
    local threshold = SHIELD_THRESHOLDS[state.shieldIndex + 1]
    local shieldStarted = threshold ~= nil and nextHealth <= threshold
    if shieldStarted then
        nextState.health = threshold
        nextState.shieldIndex += 1
        nextState.status = "shielded"
    else
        nextState.health = nextHealth
        if nextHealth <= 0 then
            nextState.status = "complete"
            nextState.carriers = {}
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            reason = if nextState.status == "complete"
                then "completed"
                elseif shieldStarted then "shield_started"
                else "damaged",
            shieldStarted = shieldStarted,
        }
end

function OldGrowthEncounter.takeFire(state: State, userId: number, now: number): (State, any)
    if state.status ~= "shielded" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local key = participantKey(userId)
    for carrierKey, expiresAt in state.carriers do
        if carrierKey ~= key and now < expiresAt then
            return state,
                {
                    accepted = false,
                    reason = "fire_claimed",
                }
        end
    end
    local nextState = cloneState(state)
    nextState.carriers[key] = now + FIRE_CARRY_SECONDS
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            expiresAt = nextState.carriers[key],
            reason = "fire_taken",
        }
end

function OldGrowthEncounter.burnHeart(state: State, userId: number, now: number): (State, any)
    if state.status ~= "shielded" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local key = participantKey(userId)
    local expiresAt = state.carriers[key]
    if expiresAt == nil or now >= expiresAt then
        return state,
            {
                accepted = false,
                reason = "fire_required",
            }
    end
    local nextState = cloneState(state)
    nextState.carriers = {}
    nextState.participants[key] = true
    nextState.status = "vulnerable"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = "shield_burned",
            shieldIndex = nextState.shieldIndex,
        }
end

function OldGrowthEncounter.expire(state: State, now: number): State
    local expired = false
    local nextState = cloneState(state)
    for key, expiresAt in nextState.carriers do
        if now >= expiresAt then
            nextState.carriers[key] = nil
            expired = true
        end
    end
    if expired then
        nextState.revision += 1
        return nextState
    end
    return state
end

function OldGrowthEncounter.attack(attackIndex: number, shieldIndex: number): any
    if shieldIndex >= 1 and attackIndex % 2 == 0 then
        return CANOPY_FALL
    end
    return ROOT_LANE
end

function OldGrowthEncounter.snapshot(state: State, userId: number, now: number): any
    local expiresAt = state.carriers[tostring(userId)] or 0
    local carryingFire = now < expiresAt
    local instruction = if state.status == "shielded"
        then if carryingFire then "CARRY FIRE TO THE ROOT HEART" else "TAKE LANTERN FIRE"
        elseif state.status == "vulnerable" then "STRIKE THE AMBER HEART"
        elseif state.status == "complete" then "OLD GROWTH CLEANSED"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE OLD GROWTH ARENA"
    return {
        active = state.status == "vulnerable" or state.status == "shielded",
        carryingFire = carryingFire,
        complete = state.status == "complete",
        displayName = "OLD GROWTH",
        enabled = state.status ~= "disabled",
        fireExpiresAt = if carryingFire then expiresAt else 0,
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, state.shieldIndex + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        shielded = state.status == "shielded",
        shieldIndex = state.shieldIndex,
        status = state.status,
    }
end

function OldGrowthEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        OldGrowthEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(OldGrowthEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">PerformanceBudget</string>
          <string name="Source"><![CDATA[--!strict

--[[
    The performance budgets from docs/TECHNICAL_ARCHITECTURE.md, as data.

    Milestone 3's exit gate asks that "target device meets frame, memory, join,
    and network budgets for a 30-minute run." That sentence is only checkable
    if the budgets are numbers and the run produces samples, so both live here:
    the thresholds the architecture doc already fixed, and the arithmetic that
    turns a pile of samples into a verdict.

    Three things this module deliberately does:

      * It judges a tail, not an average. A 30-minute run that averages 50 FPS
        while stuttering through every night is a run that failed, and a mean
        hides exactly that. Each metric names the percentile that decides it --
        the low tail when higher is better, the high tail when lower is worse.
      * A metric with no samples is never "ok". An unmeasured budget reports
        `incomplete`, because the failure this gate exists to catch is claiming
        a pass for something nobody looked at.
      * It is pure. No Roblox services, no players, no clock. Whatever samples
        it, from the server or from a client, hands it numbers.

    The numbers are the architecture doc's, not new ones. Where that doc gave a
    qualitative hard threshold rather than a figure, the reading taken here is
    marked so it can be argued with instead of being quietly invented.
]]

local Config = require("./Config")

local PerformanceBudget = {}

export type Direction = "higher_is_better" | "lower_is_better"
export type Verdict = "ok" | "watch" | "breach" | "incomplete"

export type Definition = {
    id: string,
    label: string,
    unit: string,
    direction: Direction,
    target: number,
    hard: number,
    -- The percentile that decides this metric's verdict: the tail where the
    -- bad samples live.
    percentile: number,
    source: string,
}

export type Summary = {
    id: string,
    count: number,
    discarded: number,
    min: number,
    max: number,
    mean: number,
    p50: number,
    value: number,
    verdict: Verdict,
}

export type Report = {
    verdict: Verdict,
    metrics: { Summary },
    missing: { string },
}

local ORDER: { string } = {
    "join_seconds",
    "client_fps",
    "frame_spike_ms",
    "server_heartbeat_hz",
    "client_memory_headroom",
    "remote_actions_per_second",
}

local DEFINITIONS: { [string]: Definition } = {
    join_seconds = {
        id = "join_seconds",
        label = "Interactive join, warm network",
        unit = "s",
        direction = "lower_is_better",
        target = 5,
        hard = 8,
        percentile = 95,
        source = "TECHNICAL_ARCHITECTURE.md performance budgets",
    },
    client_fps = {
        id = "client_fps",
        label = "Client frame rate, normal play",
        unit = "FPS",
        direction = "higher_is_better",
        target = 45,
        hard = 30,
        -- "Sustained < 30 FPS" is the doc's failure case. The 5th percentile
        -- is the reading of "sustained": a fifth of a second in twenty spent
        -- below the line is a stutter, a twentieth of the whole run below it
        -- is the run being slow.
        percentile = 5,
        source = "TECHNICAL_ARCHITECTURE.md performance budgets",
    },
    frame_spike_ms = {
        id = "frame_spike_ms",
        label = "Client frame time spikes",
        unit = "ms",
        direction = "lower_is_better",
        target = 50,
        hard = 100,
        percentile = 95,
        source = "TECHNICAL_ARCHITECTURE.md performance budgets",
    },
    server_heartbeat_hz = {
        id = "server_heartbeat_hz",
        label = "Server heartbeat",
        unit = "Hz",
        direction = "higher_is_better",
        target = 30,
        hard = 20,
        percentile = 5,
        source = "TECHNICAL_ARCHITECTURE.md performance budgets",
    },
    client_memory_headroom = {
        id = "client_memory_headroom",
        label = "Client memory headroom",
        unit = "ratio",
        direction = "higher_is_better",
        target = 0.2,
        -- The doc's hard threshold here is "OOM/reload risk", which is a
        -- consequence rather than a number. Half the target is the reading
        -- taken: below a tenth of the device's memory free, a Roblox client
        -- is one asset load from being killed. Argue with this figure before
        -- the slice closes -- it is the one budget here nobody measured yet.
        hard = 0.1,
        percentile = 5,
        source = "TECHNICAL_ARCHITECTURE.md, numeric reading of OOM risk",
    },
    remote_actions_per_second = {
        id = "remote_actions_per_second",
        label = "Remote traffic, actions per client",
        unit = "/s",
        direction = "lower_is_better",
        -- The action limiter already owns this budget, so the budget is the
        -- limiter's own configuration rather than a second opinion: sustained
        -- traffic at the rate, never above the burst ceiling.
        target = Config.ActionRatePerSecond,
        hard = Config.ActionRatePerSecond * 2,
        percentile = 95,
        source = "Config.ActionRatePerSecond",
    },
}

local SEVERITY: { [string]: number } = {
    ok = 0,
    watch = 1,
    incomplete = 2,
    breach = 3,
}

local function finite(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function PerformanceBudget.order(): { string }
    return table.clone(ORDER)
end

function PerformanceBudget.definition(metricId: string): Definition
    local definition = DEFINITIONS[metricId]
    assert(definition ~= nil, string.format("unknown performance metric %q", tostring(metricId)))
    return definition
end

function PerformanceBudget.isValidMetric(value: any): boolean
    return type(value) == "string" and DEFINITIONS[value] ~= nil
end

-- Where a single sample falls against its budget. Used for live warnings while
-- a run is in progress; the verdict that closes the gate comes from summarize.
function PerformanceBudget.classify(metricId: string, value: number): Verdict
    local definition = PerformanceBudget.definition(metricId)
    if not finite(value) then
        return "incomplete"
    end
    if definition.direction == "higher_is_better" then
        if value >= definition.target then
            return "ok"
        elseif value >= definition.hard then
            return "watch"
        end
        return "breach"
    end
    if value <= definition.target then
        return "ok"
    elseif value <= definition.hard then
        return "watch"
    end
    return "breach"
end

function PerformanceBudget.percentile(sorted: { number }, percentile: number): number
    local count = #sorted
    assert(count > 0, "percentile needs at least one sample")
    if count == 1 then
        return sorted[1]
    end
    local rank = (percentile / 100) * (count - 1) + 1
    local low = math.floor(rank)
    local high = math.ceil(rank)
    if low == high then
        return sorted[low]
    end
    return sorted[low] + (sorted[high] - sorted[low]) * (rank - low)
end

function PerformanceBudget.summarize(metricId: string, samples: { number }): Summary?
    local definition = PerformanceBudget.definition(metricId)

    -- A NaN would sort unpredictably and an infinity would swallow the tail,
    -- so garbage is counted and dropped rather than allowed to decide a gate.
    local clean = {}
    local discarded = 0
    for _, sample in samples do
        if finite(sample) then
            table.insert(clean, sample)
        else
            discarded += 1
        end
    end
    if #clean == 0 then
        return nil
    end
    table.sort(clean)

    local total = 0
    for _, sample in clean do
        total += sample
    end
    local value = PerformanceBudget.percentile(clean, definition.percentile)

    return {
        id = metricId,
        count = #clean,
        discarded = discarded,
        min = clean[1],
        max = clean[#clean],
        mean = total / #clean,
        p50 = PerformanceBudget.percentile(clean, 50),
        value = value,
        verdict = PerformanceBudget.classify(metricId, value),
    }
end

--[[
    Roll every metric into one verdict.

    A metric with no samples lands in `missing` and forces the report to
    `incomplete`, which outranks `watch` deliberately: a budget nobody measured
    is a worse position to close a milestone from than one measured and found
    merely close to the line.
]]
function PerformanceBudget.report(samplesByMetric: { [string]: { number } }): Report
    local metrics: { Summary } = {}
    local missing: { string } = {}
    local worst = "ok"

    for _, metricId in ORDER do
        local samples = samplesByMetric[metricId]
        local summary = if samples == nil
            then nil
            else PerformanceBudget.summarize(metricId, samples)
        if summary == nil then
            table.insert(missing, metricId)
        else
            table.insert(metrics, summary)
            if SEVERITY[summary.verdict] > SEVERITY[worst] then
                worst = summary.verdict
            end
        end
    end

    if #missing > 0 and SEVERITY.incomplete > SEVERITY[worst] then
        worst = "incomplete"
    end

    return {
        verdict = worst :: Verdict,
        metrics = metrics,
        missing = missing,
    }
end

-- One line per metric, in the order the architecture doc lists them, for the
-- admin readout at the end of a run.
function PerformanceBudget.format(report: Report): { string }
    local lines = {}
    for _, summary in report.metrics do
        local definition = PerformanceBudget.definition(summary.id)
        table.insert(
            lines,
            string.format(
                "%s %s: p%d %.1f%s (target %.1f, hard %.1f, n=%d)",
                string.upper(summary.verdict),
                definition.label,
                definition.percentile,
                summary.value,
                definition.unit,
                definition.target,
                definition.hard,
                summary.count
            )
        )
    end
    for _, metricId in report.missing do
        table.insert(
            lines,
            string.format("INCOMPLETE %s: no samples", PerformanceBudget.definition(metricId).label)
        )
    end
    return lines
end

--[[
    Validate a client's self-reported frame and memory sample.

    Client-reported numbers are diagnostic and never authoritative: nothing
    here grants a player anything, so a lying client only corrupts its own row
    in the report. That is still worth refusing rather than clamping -- a
    rejected sample is visible in the discard count, while a clamped one turns
    into a plausible-looking data point that quietly moves a percentile.

    Returns nil for anything malformed or outside the range a real device can
    physically produce.
]]
function PerformanceBudget.sanitizeClientReport(payload: any): any
    if type(payload) ~= "table" or payload.schemaVersion ~= 1 then
        return nil
    end

    local fps = payload.fps
    local spikeMs = payload.spikeMs
    local memoryMb = payload.memoryMb
    if not finite(fps) or not finite(spikeMs) or not finite(memoryMb) then
        return nil
    end

    -- No device renders a thousand frames a second, stalls for a minute and
    -- keeps running, or addresses 32 GB from a Roblox client.
    if fps <= 0 or fps > 1000 then
        return nil
    end
    if spikeMs < 0 or spikeMs > 60000 then
        return nil
    end
    if memoryMb <= 0 or memoryMb > 32768 then
        return nil
    end

    local fieldCount = 0
    for key in payload do
        fieldCount += 1
        if fieldCount > 4 or type(key) ~= "string" then
            return nil
        end
    end

    return {
        fps = fps,
        spikeMs = spikeMs,
        memoryMb = memoryMb,
    }
end

-- Memory headroom as a fraction of the baseline device's ceiling. Clamped to
-- zero rather than going negative: a client over the ceiling is at zero
-- headroom, and how far over tells the gate nothing it does not already know.
function PerformanceBudget.memoryHeadroom(memoryMb: number, ceilingMb: number): number
    assert(finite(ceilingMb) and ceilingMb > 0, "memory ceiling must be positive")
    if not finite(memoryMb) or memoryMb < 0 then
        return 0 / 0
    end
    return math.max(0, 1 - memoryMb / ceilingMb)
end

return table.freeze(PerformanceBudget)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
