        frontShield = true,
        frontalStrikeDamage = 8,
        flankStrikeDamage = 40,
        statusEffect = nil,
        statusDuration = nil,
        statusMultiplier = nil,
        statusLanternDamage = nil,
    }),
    enemy_zombie = freezeDefinition({
        id = "enemy_zombie",
        displayName = "Hollow Zombie",
        modelKey = "zombie",
        health = 68,
        speed = 6.8,
        attackRange = 12,
        attackCooldown = 2.7,
        playerDamage = 12,
        lanternDamage = 4,
        strikeRange = 11,
        strikeDamage = 34,
        attackId = "zombie_rot_miasma",
        attackName = "ROT MIASMA",
        instruction = "LEAVE THE MIASMA",
