        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Registry</string>
            <string name="Source"><![CDATA[--!strict

local Registry = {}
Registry.__index = Registry

export type Definition = {
    id: string,
    kind: string,
    version: number,
    enabled: boolean,
    displayNameKey: string,
    analyticsKey: string,
    assetBundle: string,
    featureFlag: string?,
    tags: { string },
    dependencies: { string },
}

export type Issue = {
    id: string?,
    field: string,
    message: string,
}

export type Registry = typeof(setmetatable(
    {} :: {
        _byId: { [string]: Definition },
        _ids: { string },
    },
    Registry
))

local allowedFields: { [string]: boolean } = {
    id = true,
    kind = true,
    version = true,
    enabled = true,
    displayNameKey = true,
    analyticsKey = true,
    assetBundle = true,
    featureFlag = true,
    tags = true,
    dependencies = true,
}

local function addIssue(issues: { Issue }, id: string?, field: string, message: string)
    table.insert(issues, {
        id = id,
        field = field,
        message = message,
    })
end

local function validateStringArray(issues: { Issue }, id: string?, field: string, value: any)
    if type(value) ~= "table" then
        addIssue(issues, id, field, "must be an array")
        return
    end

    local seen: { [string]: boolean } = {}
    for index, item in value do
        if type(index) ~= "number" or type(item) ~= "string" or item == "" then
            addIssue(issues, id, field, "must contain only non-empty strings")
            return
        end

        if seen[item] then
            addIssue(issues, id, field, string.format("contains duplicate value %q", item))
            return
        end
        seen[item] = true
    end
end

local function validateDefinition(issues: { Issue }, definition: any)
    if type(definition) ~= "table" then
        addIssue(issues, nil, "definition", "must be a table")
        return
    end

    local id = if type(definition.id) == "string" then definition.id else nil
    for field in definition do
        if not allowedFields[field] then
            addIssue(issues, id, field, "is not allowed by content schema version 1")
        end
    end

    for _, field in { "id", "kind", "displayNameKey", "analyticsKey", "assetBundle" } do
        if type(definition[field]) ~= "string" or definition[field] == "" then
            addIssue(issues, id, field, "must be a non-empty string")
        end
    end

    if type(definition.id) == "string" and type(definition.kind) == "string" then
        local expectedPrefix = definition.kind .. "_"
        if string.sub(definition.id, 1, #expectedPrefix) ~= expectedPrefix then
            addIssue(issues, id, "id", string.format("must use the %s prefix", expectedPrefix))
        end
        if
            string.match(definition.id, "^[a-z][a-z0-9_]*$") == nil
            or string.find(definition.id, "__", 1, true) ~= nil
            or string.sub(definition.id, -1) == "_"
        then
            addIssue(issues, id, "id", "must be lowercase snake case")
        end
    end

    if
        type(definition.version) ~= "number"
        or definition.version < 1
        or definition.version % 1 ~= 0
    then
        addIssue(issues, id, "version", "must be a positive integer")
    end

    if type(definition.enabled) ~= "boolean" then
        addIssue(issues, id, "enabled", "must be a boolean")
    end

    if
        definition.featureFlag ~= nil
        and (type(definition.featureFlag) ~= "string" or definition.featureFlag == "")
    then
        addIssue(issues, id, "featureFlag", "must be nil or a non-empty string")
    end

    validateStringArray(issues, id, "tags", definition.tags)
    validateStringArray(issues, id, "dependencies", definition.dependencies)
end

function Registry.validate(definitions: { any }): (boolean, { Issue })
    local issues: { Issue } = {}
    local ids: { [string]: boolean } = {}

    for _, definition in definitions do
        validateDefinition(issues, definition)
        if type(definition) == "table" and type(definition.id) == "string" then
            if ids[definition.id] then
                addIssue(issues, definition.id, "id", "is duplicated")
            end
            ids[definition.id] = true
        end
    end

    for _, definition in definitions do
        if type(definition) == "table" and type(definition.dependencies) == "table" then
            for _, dependency in definition.dependencies do
                if type(dependency) == "string" and not ids[dependency] then
                    addIssue(
                        issues,
                        definition.id,
                        "dependencies",
                        "references missing " .. dependency
                    )
                end
            end
        end
    end

    return #issues == 0, issues
end

function Registry.new(definitions: { Definition }): Registry
    local valid, issues = Registry.validate(definitions)
    if not valid then
        local first = issues[1]
        error(
            string.format(
                "invalid content registry at %s.%s: %s",
                first.id or "<unknown>",
                first.field,
                first.message
            )
        )
    end

    local byId: { [string]: Definition } = {}
    local ids: { string } = {}
    for _, definition in definitions do
        local immutable = table.clone(definition)
        immutable.tags = table.freeze(table.clone(definition.tags))
        immutable.dependencies = table.freeze(table.clone(definition.dependencies))
        byId[definition.id] = table.freeze(immutable)
        table.insert(ids, definition.id)
    end
    table.sort(ids)

    return setmetatable({
        _byId = byId,
        _ids = ids,
    }, Registry)
end

function Registry.get(self: Registry, id: string): Definition?
    return self._byId[id]
end

function Registry.has(self: Registry, id: string): boolean
    return self._byId[id] ~= nil
end

function Registry.count(self: Registry): number
    return #self._ids
end

function Registry.ids(self: Registry): { string }
    return table.clone(self._ids)
end

function Registry.byKind(self: Registry, kind: string): { Definition }
    local matches: { Definition } = {}
    for _, id in self._ids do
        local definition = self._byId[id]
        if definition.kind == kind then
            table.insert(matches, definition)
        end
    end

    return matches
end

return table.freeze(Registry)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Crafting</string>
          <string name="Source"><![CDATA[--!strict

local CraftingCatalog = require("./CraftingCatalog")

local Crafting = {}

local MAX_GEAR_COUNT = 999999

function Crafting.default(): { [string]: number }
    return {}
end

function Crafting.normalizeGear(value: any): { [string]: number }
    local gear: { [string]: number } = {}
    if type(value) ~= "table" then
        return gear
    end
    for itemId, count in value do
        if CraftingCatalog.isKnownOutputItem(itemId) and type(count) == "number" and count >= 0 then
            gear[itemId] = math.clamp(math.floor(count), 0, MAX_GEAR_COUNT)
        end
    end
    return gear
end

-- Deducts a recipe's material cost and grants one of its output item, or
-- leaves both inputs untouched if the recipe is unknown or unaffordable.
-- Materials and gear are validated and cloned independently of SaveSchema so
-- this stays testable as a pure transaction, the same way ExpeditionInventory
-- keeps its own reward/settlement math out of the profile module.
function Crafting.craft(
    materials: { [string]: number },
    gear: { [string]: number },
    recipeId: any
): ({ [string]: number }, { [string]: number }, any)
    if not CraftingCatalog.isValid(recipeId) then
        return materials,
            gear,
            {
                applied = false,
                reason = "unknown_recipe",
            }
    end

    local recipe = CraftingCatalog.get(recipeId) :: CraftingCatalog.Recipe
    for materialId, amount in recipe.materials do
        if (materials[materialId] or 0) < amount then
            return materials,
                gear,
                {
                    applied = false,
                    reason = "insufficient_materials",
                    recipeId = recipeId,
                }
        end
    end

    local nextMaterials = table.clone(materials)
    for materialId, amount in recipe.materials do
        nextMaterials[materialId] = nextMaterials[materialId] - amount
    end

    local nextGear = table.clone(gear)
    nextGear[recipe.outputItemId] =
        math.min(MAX_GEAR_COUNT, (nextGear[recipe.outputItemId] or 0) + 1)

    return nextMaterials,
        nextGear,
        {
            applied = true,
            itemId = recipe.outputItemId,
            recipeId = recipeId,
        }
end

-- Consumes exactly one owned unit of a crafted item, or leaves gear
-- untouched if the item ID is unknown or none are owned. Deliberately
-- doesn't know what using the item does — that effect lives in whichever
-- service applies it — this only owns the atomic decrement.
function Crafting.useItem(gear: { [string]: number }, itemId: any): ({ [string]: number }, any)
    if not CraftingCatalog.isKnownOutputItem(itemId) then
        return gear, {
            applied = false,
            reason = "unknown_item",
        }
    end

    local owned = gear[itemId] or 0
    if owned < 1 then
        return gear,
            {
                applied = false,
                itemId = itemId,
                reason = "not_owned",
            }
    end

    local nextGear = table.clone(gear)
    nextGear[itemId] = owned - 1
    return nextGear, {
        applied = true,
        itemId = itemId,
    }
end

return table.freeze(Crafting)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">CraftingCatalog</string>
          <string name="Source"><![CDATA[--!strict

local CraftingCatalog = {}

export type Recipe = {
    id: string,
    displayName: string,
    outputItemId: string,
    outputDisplayName: string,
    materials: { [string]: number },
}

local ORDER = table.freeze({
    "recipe_meadow_satchel",
    "recipe_amber_charm",
    "recipe_ironroot_hood",
    "recipe_bramble_boots",
})

local DEFINITIONS: { [string]: Recipe } = {
    recipe_meadow_satchel = table.freeze({
        id = "recipe_meadow_satchel",
        displayName = "MEADOW SATCHEL",
        outputItemId = "gear_meadow_satchel",
        outputDisplayName = "Meadow Satchel",
        materials = table.freeze({
            material_meadow_fiber = 3,
            material_heartwood = 2,
        }),
    }),
    recipe_amber_charm = table.freeze({
        id = "recipe_amber_charm",
        displayName = "AMBER CHARM",
        outputItemId = "gear_amber_charm",
        outputDisplayName = "Amber Charm",
        materials = table.freeze({
            material_amber_sap = 2,
            material_brightcap = 2,
        }),
    }),
    recipe_ironroot_hood = table.freeze({
        id = "recipe_ironroot_hood",
        displayName = "IRONROOT HOOD",
        outputItemId = "gear_ironroot_hood",
        outputDisplayName = "Ironroot Hood",
        materials = table.freeze({
            material_heartwood = 5,
            material_amber_sap = 3,
        }),
    }),
    recipe_bramble_boots = table.freeze({
        id = "recipe_bramble_boots",
        displayName = "BRAMBLE BOOTS",
        outputItemId = "gear_bramble_boots",
        outputDisplayName = "Bramble Boots",
        materials = table.freeze({
            material_meadow_fiber = 5,
            material_brightcap = 3,
        }),
    }),
}

function CraftingCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function CraftingCatalog.get(id: string): Recipe?
    return DEFINITIONS[id]
end

function CraftingCatalog.list(): { Recipe }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

function CraftingCatalog.isKnownOutputItem(itemId: any): boolean
    if type(itemId) ~= "string" then
        return false
    end
    for _, id in ORDER do
        if DEFINITIONS[id].outputItemId == itemId then
            return true
        end
    end
    return false
end

CraftingCatalog.Ids = table.freeze({
    MeadowSatchel = "recipe_meadow_satchel",
    AmberCharm = "recipe_amber_charm",
    IronrootHood = "recipe_ironroot_hood",
    BrambleBoots = "recipe_bramble_boots",
})

return table.freeze(CraftingCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">EnemyAttackFlow</string>
          <string name="Source"><![CDATA[--!strict

local EnemyAttackFlow = {}

export type Channel = {
    endsAt: number,
    startedAt: number,
    targetUserId: number,
}
export type Conditions = {
    clearPath: boolean,
    inImpactArea: boolean,
    targetCanAct: boolean,
    targetPresent: boolean,
}
export type DecisionStatus = "cancel" | "miss" | "pending" | "resolve"
export type Decision = {
    reason: string?,
    remaining: number?,
    status: DecisionStatus,
}

local function finiteNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function wholeNonNegative(value: any): boolean
    return finiteNumber(value) and value >= 0 and value == math.floor(value)
end

function EnemyAttackFlow.create(targetUserId: number, now: number, windup: number): Channel
    assert(wholeNonNegative(targetUserId), "attack target user ID is invalid")
    assert(finiteNumber(now), "attack start time is invalid")
    assert(finiteNumber(windup) and windup > 0, "attack windup is invalid")
    return table.freeze({
        endsAt = now + windup,
        startedAt = now,
        targetUserId = targetUserId,
    })
end

function EnemyAttackFlow.evaluate(channel: Channel, now: number, conditions: Conditions): Decision
    assert(finiteNumber(now), "attack evaluation time is invalid")
    if conditions.targetPresent ~= true then
        return {
            reason = "target_left",
            status = "cancel",
        }
    end
    if conditions.targetCanAct ~= true then
        return {
            reason = "target_cannot_act",
            status = "cancel",
        }
    end
    if now < channel.endsAt then
        return {
            remaining = channel.endsAt - now,
            status = "pending",
        }
    end
    if conditions.inImpactArea ~= true then
        return {
            reason = "target_evaded_area",
            status = "miss",
        }
    end
    if conditions.clearPath ~= true then
        return {
            reason = "target_reached_cover",
            status = "miss",
        }
    end
    return {
        status = "resolve",
    }
end

return table.freeze(EnemyAttackFlow)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">EnemyCombatRules</string>
          <string name="Source"><![CDATA[--!strict

local EnemyCombatRules = {}

function EnemyCombatRules.contains(
    shape: string,
    localX: number,
    localZ: number,
    radius: number?,
    width: number?,
    length: number?
): boolean
    if shape == "circle" then
        local resolvedRadius = math.max(0, radius or 0)
        return localX * localX + localZ * localZ <= resolvedRadius * resolvedRadius
    end
    if shape == "lane" then
        local halfWidth = math.max(0, width or 0) * 0.5
        local halfLength = math.max(0, length or 0) * 0.5
        return math.abs(localX) <= halfWidth and math.abs(localZ) <= halfLength
    end
    return false
end

function EnemyCombatRules.strikeDamage(definition: any, facingDot: number): (number, string)
    if definition.frontShield == true then
        if facingDot >= 0.25 then
            return math.max(0, definition.frontalStrikeDamage or 0), "shielded"
        end
        return math.max(0, definition.flankStrikeDamage or definition.strikeDamage), "flanked"
    end
    return math.max(0, definition.strikeDamage or 0), "hit"
end

return table.freeze(EnemyCombatRules)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">EnemyMotion</string>
          <string name="Source"><![CDATA[--!strict

local EnemyMotion = {}

export type Pose = {
    height: number,
    pitch: number,
    roll: number,
}

local HOVERING = table.freeze({
    hollow_crow = true,
    pollen_wisp = true,
})

local function profile(modelKey: string): (number, number)
    if HOVERING[modelKey] then
        return 0.52, 2.45
    elseif modelKey == "bark_ram" then
        return 0.13, 7.2
    elseif modelKey == "briarback" then
        return 0.11, 5.4
    elseif modelKey == "snapvine" then
        return 0.08, 1.8
    end
    return 0.15, 6.2
end

function EnemyMotion.pose(
    elapsed: number,
    modelKey: string,
    state: string,
    attackProgress: number?
): Pose
    local amplitude, frequency = profile(modelKey)
    local wave = elapsed * frequency
    local hovering = HOVERING[modelKey] == true
    local height = if hovering
        then math.sin(wave) * amplitude
        elseif state == "moving" then math.abs(math.sin(wave)) * amplitude
        else math.sin(wave * 0.42) * amplitude * 0.28
    local pitch = if state == "moving" then math.sin(wave) * math.rad(1.8) else 0
    local roll = if hovering
        then math.sin(wave * 0.63) * math.rad(3.2)
        else math.sin(wave * 0.5) * math.rad(1.1)

    if state == "attacking" then
        local progress = math.clamp(attackProgress or 0, 0, 1)
        local anticipation = math.sin(progress * math.pi * 0.5)
        height += if hovering then anticipation * 0.26 else -anticipation * 0.08
        pitch -= anticipation * math.rad(if modelKey == "bark_ram" then 13 else 8)
        roll *= 1 - anticipation * 0.7
    end

    return {
        height = height,
        pitch = pitch,
        roll = roll,
    }
end

return table.freeze(EnemyMotion)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Environment</string>
          <string name="Source"><![CDATA[--!strict

local Environment = {}

export type Name = "local" | "test" | "staging" | "production"

export type ResolveInput = {
    isStudio: boolean,
    placeId: number,
    requested: string?,
    productionPlaceIds: { number },
}

local validNames: { [string]: boolean } = {
    ["local"] = true,
    test = true,
    staging = true,
    production = true,
}

local function contains(values: { number }, target: number): boolean
    for _, value in values do
        if value == target then
            return true
        end
    end

    return false
end

function Environment.isValid(value: string): boolean
    return validNames[value] == true
end

function Environment.resolve(input: ResolveInput): (Name?, string?)
    local requested = input.requested
    if requested ~= nil and not Environment.isValid(requested) then
        return nil, string.format("unknown environment %q", requested)
    end

    if input.isStudio then
        if requested == "test" then
            return "test", nil
        end

        if requested == nil or requested == "local" then
            return "local", nil
        end

        return nil, "staging and production environments cannot run in Roblox Studio"
    end

    local isProductionPlace = contains(input.productionPlaceIds, input.placeId)
    if isProductionPlace then
        if requested ~= nil and requested ~= "production" then
            return nil, "a production place cannot boot with a non-production environment"
        end

        return "production", nil
    end

    if requested == "production" then
        return nil, "production requires the current place ID in ProductionPlaceIds"
    end

    if requested == "local" or requested == "test" then
        return nil, "local and test environments require Roblox Studio"
    end

    return "staging", nil
end

return table.freeze(Environment)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Equipment</string>
          <string name="Source"><![CDATA[--!strict

local Equipment = {}

export type Equipped = { [string]: string? }

type Definition = {
    slot: string,
    displayName: string,
    description: string,
    damageReduction: number,
    staminaRegenMultiplier: number,
}

local DEFINITIONS: { [string]: Definition } = {
    gear_ironroot_hood = table.freeze({
        slot = "head",
        displayName = "IRONROOT HOOD",
        description = "Softens incoming damage by 5%.",
        damageReduction = 0.05,
        staminaRegenMultiplier = 1,
    }),
    gear_bramble_boots = table.freeze({
        slot = "feet",
        displayName = "BRAMBLE BOOTS",
        description = "Recover stamina 10% faster.",
        damageReduction = 0,
        staminaRegenMultiplier = 1.1,
    }),
}

function Equipment.default(): Equipped
    return {}
end

function Equipment.normalize(value: any): Equipped
    local result: Equipped = {}
    if type(value) ~= "table" then
        return result
    end
    for slot, itemId in value do
        if type(slot) == "string" and type(itemId) == "string" and DEFINITIONS[itemId] ~= nil then
            local definition = DEFINITIONS[itemId]
            if definition.slot == slot then
                result[slot] = itemId
            end
        end
    end
    return result
end

function Equipment.get(itemId: any): any
    return if type(itemId) == "string" then DEFINITIONS[itemId] else nil
end

function Equipment.isKnown(itemId: any): boolean
    return type(itemId) == "string" and DEFINITIONS[itemId] ~= nil
end

function Equipment.equip(
    gear: { [string]: number },
    equipped: Equipped,
    itemId: any
): (Equipped, any)
    local definition = Equipment.get(itemId)
    if definition == nil then
        return equipped, { applied = false, reason = "unknown_equipment" }
    end
    if (gear[itemId] or 0) < 1 then
        return equipped, { applied = false, reason = "not_owned" }
    end
    local nextEquipped = Equipment.normalize(equipped)
    nextEquipped[definition.slot] = itemId
    return nextEquipped,
        {
            applied = true,
            itemId = itemId,
            slot = definition.slot,
        }
end

function Equipment.unequip(equipped: Equipped, slot: any): (Equipped, any)
    if type(slot) ~= "string" then
        return equipped, { applied = false, reason = "invalid_slot" }
    end
    local nextEquipped = Equipment.normalize(equipped)
    if nextEquipped[slot] == nil then
        return equipped, { applied = false, reason = "empty_slot" }
    end
    nextEquipped[slot] = nil
    return nextEquipped, { applied = true, slot = slot }
end

function Equipment.stats(equipped: Equipped): any
    local damageReduction = 0
    local staminaRegenMultiplier = 1
    for _, itemId in Equipment.normalize(equipped) do
        if type(itemId) == "string" then
            local definition = DEFINITIONS[itemId]
            if definition ~= nil then
                damageReduction += definition.damageReduction
                staminaRegenMultiplier *= definition.staminaRegenMultiplier
            end
        end
    end
    return {
        damageReduction = math.clamp(damageReduction, 0, 0.25),
        staminaRegenMultiplier = math.clamp(staminaRegenMultiplier, 0.75, 1.5),
    }
end

function Equipment.list(): { any }
    local result = {}
    for itemId, definition in DEFINITIONS do
        table.insert(result, {
            itemId = itemId,
            slot = definition.slot,
            displayName = definition.displayName,
            description = definition.description,
        })
    end
    table.sort(result, function(a, b)
        return a.itemId < b.itemId
    end)
    return result
end

return table.freeze(Equipment)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ExpeditionEventFlow</string>
          <string name="Source"><![CDATA[--!strict

local ExpeditionEventFlow = {}

local INTERACTION_PREFIX = "exp_event:"

local function findStep(definition: any, stepId: string): any?
    for _, step in definition.steps do
        if step.id == stepId then
            return step
        end
    end
    return nil
end

local function participantList(participants: { [string]: boolean }): { string }
    local result = {}
    for participantId in participants do
        table.insert(result, participantId)
    end
    table.sort(result)
    return result
end

function ExpeditionEventFlow.validateDefinition(definition: any): (boolean, { string })
    local issues = {}
    local function issue(message: string)
        table.insert(issues, message)
    end

    if type(definition) ~= "table" then
        return false, { "event definition must be a table" }
    end
    if type(definition.id) ~= "string" or string.sub(definition.id, 1, 9) ~= "event_bw_" then
        issue("event ID must use the Bramblewake event namespace")
    end
    if type(definition.displayName) ~= "string" or definition.displayName == "" then
        issue("event must have a display name")
    end
    if type(definition.objective) ~= "string" or definition.objective == "" then
        issue("event must have an objective")
    end
    if type(definition.detail) ~= "string" or definition.detail == "" then
        issue("event must have player guidance")
    end
    if
        type(definition.durationSeconds) ~= "number"
        or definition.durationSeconds < 30
        or definition.durationSeconds > 300
    then
        issue("event duration must be between 30 and 300 seconds")
    end
    if definition.defaultSolution ~= true then
        issue("event must have a profession-independent solution")
    end
    if definition.criticalPathBlocking ~= false then
        issue("event must not block the expedition critical path")
    end
    if
        type(definition.minimumRouteSpace) ~= "number"
        or definition.minimumRouteSpace < 8
        or definition.minimumRouteSpace > 48
    then
        issue("event route-space requirement is invalid")
    end
    if type(definition.startConditions) ~= "table" or #definition.startConditions == 0 then
        issue("event must declare start conditions")
    end
    if type(definition.incompatibleEvents) ~= "table" then
        issue("event must declare incompatible events")
    end
    if type(definition.failureResolution) ~= "string" or definition.failureResolution == "" then
        issue("event must declare a safe failure resolution")
    end
    if type(definition.localizationKey) ~= "string" or definition.localizationKey == "" then
        issue("event must declare a localization key")
    end
    if type(definition.analyticsId) ~= "string" or definition.analyticsId == "" then
        issue("event must declare an analytics ID")
    end
    if type(definition.killSwitchFlag) ~= "string" or definition.killSwitchFlag == "" then
        issue("event must declare a kill-switch flag")
    end

    local steps = definition.steps
    if type(steps) ~= "table" or #steps < 2 or #steps > 6 then
        issue("event must contain between two and six interaction steps")
    else
        local seenSteps: { [string]: boolean } = {}
        for _, step in steps do
            if type(step.id) ~= "string" or step.id == "" then
                issue("event step must have an ID")
            elseif seenSteps[step.id] then
                issue("event step IDs must be unique")
            else
                seenSteps[step.id] = true
            end
            if type(step.actionText) ~= "string" or step.actionText == "" then
                issue("event step must have action text")
            end
            if type(step.objectText) ~= "string" or step.objectText == "" then
                issue("event step must have object text")
            end
            local offset = step.offset
            if
                type(offset) ~= "table"
                or type(offset.x) ~= "number"
                or type(offset.y) ~= "number"
                or type(offset.z) ~= "number"
            then
                issue("event step must have a numeric world offset")
            end
        end
    end

    local reward = definition.reward
    if
        type(reward) ~= "table"
        or type(reward.materialId) ~= "string"
        or string.sub(reward.materialId, 1, 9) ~= "material_"
        or type(reward.amount) ~= "number"
        or reward.amount < 1
        or reward.amount ~= math.floor(reward.amount)
    then
        issue("event must declare a positive whole-material reward")
    end

    return #issues == 0, issues
end

function ExpeditionEventFlow.interactionId(eventId: string, stepId: string): string
    return INTERACTION_PREFIX .. eventId .. ":" .. stepId
end

function ExpeditionEventFlow.transactionId(
    runId: string,
    manifestHash: string,
    eventId: string
): string
    return string.format("event_reward:%s:%s:%s", runId, manifestHash, eventId)
end

function ExpeditionEventFlow.create(
    definition: any,
    runId: string,
    manifestHash: string,
    enabled: boolean?
): any
    local valid, issues = ExpeditionEventFlow.validateDefinition(definition)
    assert(valid, table.concat(issues, "; "))
    assert(type(runId) == "string" and runId ~= "", "expedition run ID is required")
    assert(type(manifestHash) == "string" and manifestHash ~= "", "manifest hash is required")

    local isEnabled = enabled ~= false and definition.enabled == true
    return {
        eventId = definition.id,
        runId = runId,
        manifestHash = manifestHash,
        status = if isEnabled then "dormant" else "disabled",
        progress = 0,
        total = #definition.steps,
        revision = 0,
        startedAt = nil,
        expiresAt = nil,
        completedAt = nil,
        failedAt = nil,
        completedSteps = {},
        participants = {},
        rewardTransactionId = nil,
    }
end

function ExpeditionEventFlow.expire(state: any, _definition: any, now: number): boolean
    if state.status ~= "active" or type(state.expiresAt) ~= "number" or now < state.expiresAt then
        return false
    end

    state.status = "failed"
    state.failedAt = now
    state.revision += 1
    return true
end

function ExpeditionEventFlow.contribute(
    state: any,
    definition: any,
    stepId: string,
    participantId: string,
    now: number
): any
    if state.eventId ~= definition.id then
        return {
            accepted = false,
            changed = false,
            reason = "event_mismatch",
        }
    end
    if state.status == "disabled" then
        return {
            accepted = false,
            changed = false,
            reason = "event_disabled",
        }
    end
    if findStep(definition, stepId) == nil then
        return {
            accepted = false,
            changed = false,
            reason = "unknown_step",
        }
    end
    if ExpeditionEventFlow.expire(state, definition, now) then
        return {
            accepted = false,
            changed = true,
            failed = true,
            reason = "event_expired",
        }
    end
    if state.status == "failed" then
        return {
            accepted = false,
            changed = false,
            reason = "event_failed",
        }
    end
    if state.completedSteps[stepId] == true then
        return {
            accepted = true,
            changed = false,
            duplicate = true,
            reason = "step_already_complete",
        }
    end
    if state.status == "completed" then
        return {
            accepted = true,
            changed = false,
            duplicate = true,
            reason = "event_already_complete",
        }
    end

    local started = false
    if state.status == "dormant" then
        state.status = "active"
        state.startedAt = now
        state.expiresAt = now + definition.durationSeconds
        started = true
    end

    state.completedSteps[stepId] = true
    state.participants[participantId] = true
    state.progress += 1
    state.revision += 1

    local completed = state.progress == state.total
    if completed then
        state.status = "completed"
        state.completedAt = now
        state.rewardTransactionId =
            ExpeditionEventFlow.transactionId(state.runId, state.manifestHash, state.eventId)
    end

    return {
        accepted = true,
        changed = true,
        completed = completed,
        started = started,
        progress = state.progress,
        total = state.total,
        rewardTransactionId = state.rewardTransactionId,
    }
end

function ExpeditionEventFlow.snapshot(state: any, definition: any, now: number): any
    local timeRemaining = nil
    if state.status == "active" and type(state.expiresAt) == "number" then
        timeRemaining = math.max(0, math.ceil(state.expiresAt - now))
    end

    return {
        eventId = state.eventId,
        displayName = definition.displayName,
        status = state.status,
        objective = definition.objective,
        detail = definition.detail,
        completionMessage = definition.completionMessage,
        failureMessage = definition.failureMessage,
        failureResolution = definition.failureResolution,
        progress = state.progress,
        total = state.total,
        revision = state.revision,
        timeRemaining = timeRemaining,
        reward = definition.reward,
        rewardTransactionId = state.rewardTransactionId,
        participants = participantList(state.participants),
    }
end

return table.freeze(ExpeditionEventFlow)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">ExpeditionGenerator</string>
          <string name="Source"><![CDATA[--!strict

local Catalog = require("./Content/Definitions/BramblewakeExpedition")
local ExpeditionEventFlow = require("./ExpeditionEventFlow")

local ExpeditionGenerator = {}

local RANDOM_MODULUS = 2147483647
local RANDOM_MULTIPLIER = 16807
local HASH_MULTIPLIER = 33

local ROUTES = {
    { 0, 0, 1, 1, 0, 0, 3, 3, 0, 0, 0 },
    { 0, 0, 3, 3, 0, 0, 1, 1, 0, 0, 0 },
    { 1, 1, 0, 0, 0, 3, 3, 0, 0, 1, 1 },
    { 0, 1, 1, 0, 0, 0, 3, 3, 3, 0, 0 },
}

local DIRECTION_X = { 0, 1, 0, -1 }
local DIRECTION_Z = { -1, 0, 1, 0 }

local function normalizeSeed(seed: number): number
    local normalized = math.floor(math.abs(seed)) % RANDOM_MODULUS
    return if normalized == 0 then 1 else normalized
end

local function randomSource(seed: number): (number) -> number
    local state = normalizeSeed(seed)
    return function(maximum: number): number
        state = (state * RANDOM_MULTIPLIER) % RANDOM_MODULUS
        return (state % maximum) + 1
    end
end

local function shuffled(values: { any }, random: (number) -> number): { any }
    local result = table.clone(values)
    for index = #result, 2, -1 do
        local other = random(index)
        result[index], result[other] = result[other], result[index]
    end
    return result
end

local function indexDefinitions(definitions: { any }): { [string]: any }
    local byId: { [string]: any } = {}
    for _, definition in definitions do
        byId[definition.id] = definition
    end
    return byId
end

local MODULES_BY_ID = indexDefinitions(Catalog.Modules)
local POIS_BY_ID = indexDefinitions(Catalog.PointsOfInterest)
local EVENTS_BY_ID = indexDefinitions(Catalog.Events)

local function hashText(hash: number, value: string): number
    local result = hash
    for index = 1, #value do
        result = (result * HASH_MULTIPLIER + string.byte(value, index)) % RANDOM_MODULUS
    end
    return result
end

function ExpeditionGenerator.computeHash(manifest: any): string
    local hash = hashText(5381, tostring(manifest.regionId))
    hash = hashText(hash, ":" .. tostring(manifest.version))
    for _, placement in manifest.modules do
        local fields = string.format(
            "|%s:%d:%d:%d:%s:%s",
            placement.moduleId,
            placement.cellX,
            placement.cellZ,
            placement.rotation,
            placement.poiId or "-",
            placement.eventId or "-"
        )
        hash = hashText(hash, fields)
    end
    return string.format("%08x", hash)
end

local function placeContent(manifest: any, random: (number) -> number)
    local poiDefinitions = shuffled(Catalog.PointsOfInterest, random)
    local eventDefinitions = shuffled(Catalog.Events, random)
    local occupied: { [number]: boolean } = {}

    local poiPlacements = shuffled(manifest.modules, random)
    local poiIndex = 1
    for _, placement in poiPlacements do
        local moduleDefinition = MODULES_BY_ID[placement.moduleId]
        if moduleDefinition.poiSocket and not occupied[placement.index] then
            placement.poiId = poiDefinitions[poiIndex].id
            occupied[placement.index] = true
            poiIndex += 1
            if poiIndex > #poiDefinitions then
                break
            end
        end
    end

    local eventPlacements = shuffled(manifest.modules, random)
    local eventIndex = 1
    for _, placement in eventPlacements do
        local moduleDefinition = MODULES_BY_ID[placement.moduleId]
        if moduleDefinition.eventSocket and not occupied[placement.index] then
            placement.eventId = eventDefinitions[eventIndex].id
            occupied[placement.index] = true
            eventIndex += 1
            if eventIndex > #eventDefinitions then
                break
            end
        end
    end
end

local function assemble(seed: number, attempt: number, source: string, fixed: boolean): any
    local random = randomSource(seed + attempt * 7919)
    local middle = {}
    for index = 2, #Catalog.Modules - 1 do
        table.insert(middle, Catalog.Modules[index])
    end
    if not fixed then
        middle = shuffled(middle, random)
    end

    local sequence = { Catalog.Modules[1] }
    for _, definition in middle do
        table.insert(sequence, definition)
    end
    table.insert(sequence, Catalog.Modules[#Catalog.Modules])

    local route = if fixed then ROUTES[1] else ROUTES[random(#ROUTES)]
    local modules = {}
    local cellX = 0
    local cellZ = 0
    for index, definition in sequence do
        local direction = if index <= #route then route[index] else route[#route]
        table.insert(modules, {
            index = index,
            moduleId = definition.id,
            cellX = cellX,
            cellZ = cellZ,
            rotation = direction * 90,
        })
        if index <= #route then
            cellX += DIRECTION_X[direction + 1]
            cellZ += DIRECTION_Z[direction + 1]
        end
    end

    local manifest = {
        version = Catalog.Version,
        regionId = Catalog.RegionId,
        seed = normalizeSeed(seed),
        source = source,
        attempts = attempt,
        modules = modules,
    }
    placeContent(manifest, random)
    manifest.hash = ExpeditionGenerator.computeHash(manifest)
    return manifest
end

function ExpeditionGenerator.validate(manifest: any): (boolean, { string })
    local issues: { string } = {}
    local function issue(message: string)
        table.insert(issues, message)
    end

    if type(manifest) ~= "table" then
        return false, { "manifest must be a table" }
    end
    if manifest.version ~= Catalog.Version then
        issue("manifest version does not match the Bramblewake catalog")
    end
    if manifest.regionId ~= Catalog.RegionId then
        issue("manifest region is not Bramblewake")
    end
    if type(manifest.modules) ~= "table" or #manifest.modules ~= Catalog.ModuleCount then
        issue(string.format("manifest must contain %d modules", Catalog.ModuleCount))
        return false, issues
    end

    local seenModules: { [string]: boolean } = {}
    local seenCells: { [string]: boolean } = {}
    local seenPois: { [string]: boolean } = {}
    local seenEvents: { [string]: boolean } = {}
    local tagCounts: { [string]: number } = {}
    local totalParts = 0
    local totalLights = 0
    local totalEffects = 0

    for index, placement in manifest.modules do
        if placement.index ~= index then
            issue(string.format("module %d has an invalid sequence index", index))
        end
        local definition = MODULES_BY_ID[placement.moduleId]
        if definition == nil then
            issue(string.format("module %d references unknown content", index))
        else
            if definition.enabled ~= true then
                issue("manifest contains a disabled module")
            end
            if definition.defaultTraversal ~= true then
                issue("critical path requires a profession or premium traversal ability")
            end
            if seenModules[definition.id] then
                issue("module content repeats in the representative slice")
            end
            seenModules[definition.id] = true
            totalParts += definition.partBudget
            totalLights += definition.lightBudget
            totalEffects += definition.effectBudget
            for _, tag in definition.tags do
                tagCounts[tag] = (tagCounts[tag] or 0) + 1
            end
        end

        if type(placement.cellX) ~= "number" or type(placement.cellZ) ~= "number" then
            issue(string.format("module %d has invalid cell coordinates", index))
        else
            local cellKey = string.format("%d:%d", placement.cellX, placement.cellZ)
            if seenCells[cellKey] then
                issue("route overlaps a previously occupied streaming cell")
            end
            seenCells[cellKey] = true
            if index > 1 then
                local previous = manifest.modules[index - 1]
                local distance = math.abs(placement.cellX - previous.cellX)
                    + math.abs(placement.cellZ - previous.cellZ)
                if distance ~= 1 then
                    issue(string.format("module %d is disconnected from the critical path", index))
                end
            end
        end

        if placement.poiId ~= nil then
            if POIS_BY_ID[placement.poiId] == nil then
                issue("manifest references an unknown point of interest")
            elseif POIS_BY_ID[placement.poiId].enabled ~= true then
                issue("manifest contains a disabled point of interest")
            elseif seenPois[placement.poiId] then
                issue("point of interest repeats in one expedition")
            elseif definition ~= nil and not definition.poiSocket then
                issue("point of interest occupies an incompatible module")
            end
            seenPois[placement.poiId] = true
        end
        if placement.eventId ~= nil then
            local eventDefinition = EVENTS_BY_ID[placement.eventId]
            if eventDefinition == nil then
                issue("manifest references an unknown event")
            elseif eventDefinition.enabled ~= true then
                issue("manifest contains a disabled event")
            elseif seenEvents[placement.eventId] then
                issue("event repeats in one expedition")
            elseif definition ~= nil and not definition.eventSocket then
                issue("event occupies an incompatible module")
            else
                local contractValid, contractIssues =
                    ExpeditionEventFlow.validateDefinition(eventDefinition)
                if not contractValid then
                    issue("event contract is invalid: " .. table.concat(contractIssues, ", "))
                end
                if eventDefinition.minimumRouteSpace > Catalog.CellSize - 24 then
                    issue("event route-space requirement exceeds its module clearing")
                end
            end
            if placement.poiId ~= nil then
                issue("event and point of interest overlap the same module")
            end
            seenEvents[placement.eventId] = true
        end
    end

    local firstDefinition = MODULES_BY_ID[manifest.modules[1].moduleId]
    local lastDefinition = MODULES_BY_ID[manifest.modules[#manifest.modules].moduleId]
    if firstDefinition == nil or firstDefinition.role ~= "arrival" then
        issue("critical path does not begin at an arrival module")
    end
    if lastDefinition == nil or lastDefinition.role ~= "extraction" then
        issue("critical path does not end at an extraction module")
    end

    local poiCount = 0
    for _ in seenPois do
        poiCount += 1
    end
    local eventCount = 0
    for _ in seenEvents do
        eventCount += 1
    end
    if poiCount ~= Catalog.PointOfInterestCount then
        issue(
            string.format("manifest must place %d points of interest", Catalog.PointOfInterestCount)
        )
    end
    if eventCount ~= Catalog.EventCount then
        issue(string.format("manifest must place %d events", Catalog.EventCount))
    end

    local requiredTags = Catalog.RequiredTags :: { [string]: number }
    for tag, minimum in requiredTags do
        if (tagCounts[tag] or 0) < minimum then
            issue(string.format("manifest does not meet the %s module minimum", tag))
        end
    end
    for _, moduleId in Catalog.RequiredModuleIds do
        if not seenModules[moduleId] then
            issue("manifest is missing required module " .. moduleId)
        end
    end
    if totalParts > Catalog.PartBudget then
        issue("manifest exceeds the regional part budget")
    end
    if totalLights > Catalog.LightBudget then
        issue("manifest exceeds the regional light budget")
    end
    if totalEffects > Catalog.EffectBudget then
        issue("manifest exceeds the regional effect budget")
    end
    if manifest.hash ~= ExpeditionGenerator.computeHash(manifest) then
        issue("manifest hash does not match its content")
    end

    return #issues == 0, issues
end

function ExpeditionGenerator.generate(seed: number, forceFallback: boolean?): any
    local normalizedSeed = normalizeSeed(seed)
    if not forceFallback then
        for attempt = 1, 3 do
            local manifest = assemble(normalizedSeed, attempt, "generated", false)
            local valid = ExpeditionGenerator.validate(manifest)
            if valid then
                return manifest
            end
        end
    end

    local fallback = assemble(normalizedSeed, 3, "known_good_fallback", true)
    local valid, issues = ExpeditionGenerator.validate(fallback)
    assert(valid, "known-good Bramblewake fallback is invalid: " .. table.concat(issues, "; "))
    return fallback
end

function ExpeditionGenerator.moduleDefinition(moduleId: string): any
    return MODULES_BY_ID[moduleId]
end

function ExpeditionGenerator.pointOfInterestDefinition(poiId: string): any
    return POIS_BY_ID[poiId]
end

function ExpeditionGenerator.eventDefinition(eventId: string): any
    return EVENTS_BY_ID[eventId]
end

return table.freeze(ExpeditionGenerator)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">ExpeditionInventory</string>
          <string name="Source"><![CDATA[--!strict

local ExpeditionInventory = {}

local MAX_MATERIAL_STACK = 999999
local MAX_REWARD_AMOUNT = 100
local MAX_REWARD_TRANSACTIONS = 512
local MAX_SETTLEMENTS = 128
local HASH_MODULUS = 2147483647
local HASH_MULTIPLIER = 33

local KNOWN_MATERIALS = table.freeze({
    material_amber_sap = true,
    material_brightcap = true,
    material_heartwood = true,
    material_meadow_fiber = true,
    material_spring_clay = true,
})

local function hashText(hash: number, value: string): number
    local result = hash
    for index = 1, #value do
        result = (result * HASH_MULTIPLIER + string.byte(value, index)) % HASH_MODULUS
    end
    return result
end

local function validMaterialId(materialId: any): boolean
    return type(materialId) == "string" and KNOWN_MATERIALS[materialId] == true
end

local function validTransactionId(transactionId: any): boolean
    return type(transactionId) == "string" and transactionId ~= "" and #transactionId <= 180
end

local function cloneInventory(inventory: any): any
    return {
        materials = table.clone(inventory.materials),
        expeditionRewards = table.clone(inventory.expeditionRewards),
        rewardOrder = table.clone(inventory.rewardOrder),
        settlements = table.clone(inventory.settlements),
        settlementOrder = table.clone(inventory.settlementOrder),
    }
end

local function makeRewardSpace(inventory: any): boolean
    while #inventory.rewardOrder >= MAX_REWARD_TRANSACTIONS do
        local removeIndex = nil
        for index, transactionId in inventory.rewardOrder do
            local record = inventory.expeditionRewards[transactionId]
            if record ~= nil and record.status == "settled" then
                removeIndex = index
                break
            end
        end
        if removeIndex == nil then
            return false
        end
        local removedTransactionId = table.remove(inventory.rewardOrder, removeIndex)
        inventory.expeditionRewards[removedTransactionId] = nil
    end
    return true
end

local function normalizeMaterials(value: any): { [string]: number }
    local materials: { [string]: number } = {}
    if type(value) ~= "table" then
        return materials
    end
    for materialId, amount in value do
        if validMaterialId(materialId) and type(amount) == "number" and amount >= 0 then
            materials[materialId] = math.clamp(math.floor(amount), 0, MAX_MATERIAL_STACK)
        end
    end
    return materials
end

local function normalizeTransactionIds(value: any): { string }
    local transactionIds = {}
    local seen: { [string]: boolean } = {}
    if type(value) ~= "table" then
        return transactionIds
    end
    for _, transactionId in value do
        if #transactionIds >= MAX_REWARD_TRANSACTIONS then
            break
        end
        if validTransactionId(transactionId) and not seen[transactionId] then
            seen[transactionId] = true
            table.insert(transactionIds, transactionId)
        end
    end
    return transactionIds
end

function ExpeditionInventory.default(): any
    return {
        materials = {},
        expeditionRewards = {},
        rewardOrder = {},
        settlements = {},
        settlementOrder = {},
    }
end

function ExpeditionInventory.normalize(value: any): any
    local inventory = ExpeditionInventory.default()
    if type(value) ~= "table" then
        return inventory
    end

    inventory.materials = normalizeMaterials(value.materials)
    if type(value.expeditionRewards) == "table" and type(value.rewardOrder) == "table" then
        for _, transactionId in value.rewardOrder do
            if #inventory.rewardOrder >= MAX_REWARD_TRANSACTIONS then
                break
            end
            local record = value.expeditionRewards[transactionId]
            if
                validTransactionId(transactionId)
                and type(record) == "table"
                and validMaterialId(record.materialId)
                and type(record.amount) == "number"
                and record.amount >= 1
                and record.amount <= MAX_REWARD_AMOUNT
                and (record.status == "unbanked" or record.status == "settled")
                and inventory.expeditionRewards[transactionId] == nil
            then
                inventory.expeditionRewards[transactionId] = {
                    amount = math.floor(record.amount),
                    grantedAt = if type(record.grantedAt) == "number"
                        then math.floor(record.grantedAt)
                        else 0,
                    manifestHash = if type(record.manifestHash) == "string"
                        then string.sub(record.manifestHash, 1, 32)
                        else "unknown",
                    materialId = record.materialId,
                    settledBy = if type(record.settledBy) == "string"
                        then string.sub(record.settledBy, 1, 180)
                        else nil,
                    status = record.status,
                }
                table.insert(inventory.rewardOrder, transactionId)
            end
        end
    end

    if type(value.settlements) == "table" and type(value.settlementOrder) == "table" then
        for _, settlementId in value.settlementOrder do
            if #inventory.settlementOrder >= MAX_SETTLEMENTS then
                break
            end
            local record = value.settlements[settlementId]
            if
                validTransactionId(settlementId)
                and type(record) == "table"
                and inventory.settlements[settlementId] == nil
            then
                inventory.settlements[settlementId] = {
                    manifestHash = if type(record.manifestHash) == "string"
                        then string.sub(record.manifestHash, 1, 32)
                        else "unknown",
                    materials = normalizeMaterials(record.materials),
                    rewardTransactionIds = normalizeTransactionIds(record.rewardTransactionIds),
                    settledAt = if type(record.settledAt) == "number"
                        then math.floor(record.settledAt)
                        else 0,
                }
                table.insert(inventory.settlementOrder, settlementId)
            end
        end
    end
    return inventory
end

function ExpeditionInventory.addUnbanked(
    inventory: any,
    transactionId: string,
    manifestHash: string,
    reward: any,
    now: number
): (any, any)
    if not validTransactionId(transactionId) then
        return inventory,
            {
                applied = false,
                reason = "invalid_transaction",
            }
    end
    if
        type(reward) ~= "table"
        or not validMaterialId(reward.materialId)
        or type(reward.amount) ~= "number"
        or reward.amount < 1
        or reward.amount > MAX_REWARD_AMOUNT
        or reward.amount ~= math.floor(reward.amount)
    then
        return inventory,
            {
                applied = false,
                reason = "invalid_reward",
            }
    end

    local existing = inventory.expeditionRewards[transactionId]
    if existing ~= nil then
        return inventory,
            {
                applied = false,
                duplicate = true,
                record = table.clone(existing),
            }
    end
    local nextInventory = cloneInventory(inventory)
    if not makeRewardSpace(nextInventory) then
        return inventory,
            {
                applied = false,
                reason = "unbanked_pouch_full",
            }
    end
    local record = {
        amount = reward.amount,
        grantedAt = math.floor(now),
        manifestHash = string.sub(manifestHash, 1, 32),
        materialId = reward.materialId,
        settledBy = nil,
        status = "unbanked",
    }
    nextInventory.expeditionRewards[transactionId] = record
    table.insert(nextInventory.rewardOrder, transactionId)
    return nextInventory, {
        applied = true,
        record = table.clone(record),
    }
end

function ExpeditionInventory.pending(inventory: any): any
    local materials: { [string]: number } = {}
    local rewards = {}
    local transactionIds = {}
    for _, transactionId in inventory.rewardOrder do
        local record = inventory.expeditionRewards[transactionId]
        if record ~= nil and record.status == "unbanked" then
            materials[record.materialId] = (materials[record.materialId] or 0) + record.amount
            table.insert(transactionIds, transactionId)
            table.insert(rewards, {
                amount = record.amount,
                manifestHash = record.manifestHash,
                materialId = record.materialId,
                transactionId = transactionId,
            })
        end
    end
    table.sort(transactionIds)
    table.sort(rewards, function(left: any, right: any): boolean
        return left.transactionId < right.transactionId
    end)

    local hash = 5381
    for _, transactionId in transactionIds do
        hash = hashText(hash, "|" .. transactionId)
    end
    return {
        count = #transactionIds,
        fingerprint = string.format("%08x", hash),
        materials = materials,
        rewards = rewards,
        transactionIds = transactionIds,
    }
end

function ExpeditionInventory.settlementId(
    runId: string,
    userId: number,
    pendingFingerprint: string
): string
    assert(type(runId) == "string" and runId ~= "", "expedition run ID is required")
    assert(userId > 0, "settlement user ID is invalid")
    return string.format(
        "expedition_settlement:%s:%d:%s",
        string.sub(runId, 1, 64),
        userId,
        pendingFingerprint
    )
end

function ExpeditionInventory.settle(
    inventory: any,
    settlementId: string,
    manifestHash: string,
    now: number
): (any, any)
    if not validTransactionId(settlementId) then
        return inventory,
            {
                applied = false,
                reason = "invalid_settlement",
            }
    end
    local existing = inventory.settlements[settlementId]
    if existing ~= nil then
        return inventory,
            {
                applied = false,
                duplicate = true,
                record = table.clone(existing),
            }
    end

    local pending = ExpeditionInventory.pending(inventory)
    if pending.count == 0 then
        return inventory, {
            applied = false,
            empty = true,
        }
    end

    local nextInventory = cloneInventory(inventory)
    for materialId, amount in pending.materials do
        nextInventory.materials[materialId] =
            math.min(MAX_MATERIAL_STACK, (nextInventory.materials[materialId] or 0) + amount)
    end
    for _, transactionId in pending.transactionIds do
        local record = table.clone(nextInventory.expeditionRewards[transactionId])
        record.status = "settled"
        record.settledBy = settlementId
        nextInventory.expeditionRewards[transactionId] = record
    end

    local settlementRecord = {
        manifestHash = string.sub(manifestHash, 1, 32),
        materials = table.clone(pending.materials),
        rewardTransactionIds = table.clone(pending.transactionIds),
        settledAt = math.floor(now),
    }
    nextInventory.settlements[settlementId] = settlementRecord
    table.insert(nextInventory.settlementOrder, settlementId)
    if #nextInventory.settlementOrder > MAX_SETTLEMENTS then
        local oldest = table.remove(nextInventory.settlementOrder, 1)
        nextInventory.settlements[oldest] = nil
    end

    return nextInventory,
        {
            applied = true,
            record = table.clone(settlementRecord),
        }
end

function ExpeditionInventory.hasSettlement(inventory: any, settlementId: string): boolean
    return inventory.settlements[settlementId] ~= nil
end

function ExpeditionInventory.hasReward(inventory: any, transactionId: string): boolean
    return inventory.expeditionRewards[transactionId] ~= nil
end

function ExpeditionInventory.findSettlementForRewards(
    inventory: any,
    rewardTransactionIds: { string }
): (string?, any?)
    if #rewardTransactionIds == 0 then
        return nil, nil
    end
    local wanted: { [string]: boolean } = {}
    for _, transactionId in rewardTransactionIds do
        wanted[transactionId] = true
    end
    for index = #inventory.settlementOrder, 1, -1 do
        local settlementId = inventory.settlementOrder[index]
        local record = inventory.settlements[settlementId]
        local found = 0
        if record ~= nil then
            for _, transactionId in record.rewardTransactionIds do
                if wanted[transactionId] then
                    found += 1
                end
            end
        end
        if found == #rewardTransactionIds then
            return settlementId, table.clone(record)
        end
    end
    return nil, nil
end

return table.freeze(ExpeditionInventory)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">ExpeditionRewardLedger</string>
          <string name="Source"><![CDATA[--!strict

local ExpeditionRewardLedger = {}

function ExpeditionRewardLedger.create(): any
    return {
        users = {},
    }
end

function ExpeditionRewardLedger.grant(
    ledger: any,
    userId: number,
    transactionId: string,
    manifestHash: string,
    reward: any
): (boolean, any)
    assert(type(userId) == "number" and userId > 0, "reward user ID is invalid")
    assert(
        type(transactionId) == "string" and transactionId ~= "",
        "reward transaction ID is required"
    )
    assert(
        type(reward) == "table"
            and type(reward.materialId) == "string"
            and string.sub(reward.materialId, 1, 9) == "material_"
            and type(reward.amount) == "number"
            and reward.amount >= 1
            and reward.amount == math.floor(reward.amount),
        "reward contract is invalid"
    )

    local userLedger = ledger.users[userId]
    if userLedger == nil then
        userLedger = {
            materials = {},
            settlements = {},
            transactions = {},
        }
        ledger.users[userId] = userLedger
    end
    local prior = userLedger.transactions[transactionId]
    if prior ~= nil then
        return false, table.clone(prior)
    end

    local result = {
        amount = reward.amount,
        manifestHash = manifestHash,
        materialId = reward.materialId,
        settled = false,
        transactionId = transactionId,
        userId = userId,
    }
    userLedger.transactions[transactionId] = result
    userLedger.materials[reward.materialId] = (userLedger.materials[reward.materialId] or 0)
        + reward.amount
    return true, table.clone(result)
end

function ExpeditionRewardLedger.pending(ledger: any, userId: number): any
    local userLedger = ledger.users[userId]
    local rewards = {}
    local transactionIds = {}
    if userLedger ~= nil then
        for transactionId, record in userLedger.transactions do
            if record.settled ~= true then
                table.insert(transactionIds, transactionId)
                table.insert(rewards, {
                    amount = record.amount,
                    manifestHash = record.manifestHash,
                    materialId = record.materialId,
                    transactionId = transactionId,
                })
            end
        end
    end
    table.sort(transactionIds)
    table.sort(rewards, function(left: any, right: any): boolean
        return left.transactionId < right.transactionId
    end)
    return {
        materials = if userLedger == nil then {} else table.clone(userLedger.materials),
        rewards = rewards,
        transactionCount = #transactionIds,
        transactionIds = transactionIds,
    }
end

function ExpeditionRewardLedger.settle(
    ledger: any,
    userId: number,
    settlementId: string,
    transactionIds: { string }
): (boolean, any)
    local userLedger = ledger.users[userId]
    if userLedger == nil then
        return false, {
            empty = true,
        }
    end
    local existing = userLedger.settlements[settlementId]
    if existing ~= nil then
        return false, table.clone(existing)
    end

    local settledIds = {}
    for _, transactionId in transactionIds do
        local record = userLedger.transactions[transactionId]
        if record ~= nil and record.settled ~= true then
            record.settled = true
            userLedger.materials[record.materialId] =
                math.max(0, (userLedger.materials[record.materialId] or 0) - record.amount)
            table.insert(settledIds, transactionId)
        end
    end
    local result = {
        settlementId = settlementId,
        transactionIds = settledIds,
    }
    userLedger.settlements[settlementId] = result
    return #settledIds > 0, table.clone(result)
end

function ExpeditionRewardLedger.snapshot(ledger: any, userId: number): any
    return ExpeditionRewardLedger.pending(ledger, userId)
end

return table.freeze(ExpeditionRewardLedger)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">NightSchedule</string>
          <string name="Source"><![CDATA[--!strict

local NightSchedule = {}

export type Beat = {
    at: number,
    kind: "spawn" | "warning" | "breach",
    enemyId: string?,
}

local BEATS: { Beat } = {
    { at = 0, kind = "warning", enemyId = nil },
    { at = 4, kind = "spawn", enemyId = "enemy_rootling" },
    { at = 22, kind = "spawn", enemyId = "enemy_briarback" },
    { at = 40, kind = "spawn", enemyId = "enemy_pollen_wisp" },
    { at = 56, kind = "breach", enemyId = nil },
    { at = 58, kind = "spawn", enemyId = "enemy_hollow_crow" },
    { at = 76, kind = "spawn", enemyId = "enemy_snapvine" },
    { at = 94, kind = "spawn", enemyId = "enemy_bark_ram" },
}

function NightSchedule.beats(duration: number): { Beat }
    local result: { Beat } = {}
    for _, beat in BEATS do
        if beat.at < duration then
            table.insert(result, table.clone(beat))
        end
    end
    return result
end

function NightSchedule.pending(duration: number, elapsed: number): { Beat }
    local result: { Beat } = {}
    for _, beat in NightSchedule.beats(duration) do
        if beat.at >= elapsed then
            table.insert(result, beat)
        end
    end
    return result
end

return table.freeze(NightSchedule)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">OldGrowthEncounter</string>
          <string name="Source"><![CDATA[--!strict

local OldGrowthEncounter = {}

export type Status = "disabled" | "dormant" | "vulnerable" | "shielded" | "complete"

export type State = {
    carriers: { [string]: number },
    health: number,
    manifestHash: string,
    participants: { [string]: boolean },
    revision: number,
    runId: string,
    shieldIndex: number,
    status: Status,
}

local MAX_HEALTH = 360
local FIRE_CARRY_SECONDS = 15
local SHIELD_THRESHOLDS = table.freeze({ 240, 120 })

local ROOT_LANE = table.freeze({
    attackId = "old_growth_root_lane",
    attackName = "CATHEDRAL ROOTS",
    damage = 20,
    instruction = "CLEAR THE ROOT LANE",
    length = 32,
    rootedDuration = 1.6,
    rootedMultiplier = 0.35,
    shape = "lane",
    width = 9,
    windup = 1.35,
})

local CANOPY_FALL = table.freeze({
    attackId = "old_growth_canopy_fall",
    attackName = "CANOPY FALL",
    damage = 28,
    instruction = "LEAVE THE FALL RING",
    radius = 10,
    shape = "circle",
    windup = 1.55,
})

OldGrowthEncounter.Id = "elite_old_growth"
OldGrowthEncounter.MaxHealth = MAX_HEALTH
OldGrowthEncounter.FireCarrySeconds = FIRE_CARRY_SECONDS
OldGrowthEncounter.Reward = table.freeze({
    amount = 3,
    materialId = "material_amber_sap",
})
OldGrowthEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3,
    markedAttackCooldownMultiplier = 1.35,
    markedStrikeDamage = 40,
    shieldedAttackCooldownSeconds = 4.2,
    strikeDamage = 34,
})

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.carriers = table.clone(state.carriers)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "participant user ID is invalid")
    return tostring(userId)
end

function OldGrowthEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Old Growth run ID is required")
    assert(manifestHash ~= "", "Old Growth manifest hash is required")
    return {
        carriers = {},
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        participants = {},
        revision = 0,
        runId = runId,
        shieldIndex = 0,
        status = if enabled then "dormant" else "disabled",
    }
end

function OldGrowthEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.status = "vulnerable"
    nextState.participants[participantKey(userId)] = true
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            activated = true,
            reason = "activated",
        }
end

function OldGrowthEncounter.join(state: State, userId: number): State
    if state.status ~= "vulnerable" and state.status ~= "shielded" then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function OldGrowthEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Old Growth strike amount is invalid")
    if state.status ~= "vulnerable" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local nextHealth = math.max(0, state.health - amount)
    local threshold = SHIELD_THRESHOLDS[state.shieldIndex + 1]
    local shieldStarted = threshold ~= nil and nextHealth <= threshold
    if shieldStarted then
        nextState.health = threshold
        nextState.shieldIndex += 1
        nextState.status = "shielded"
    else
        nextState.health = nextHealth
        if nextHealth <= 0 then
            nextState.status = "complete"
            nextState.carriers = {}
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            reason = if nextState.status == "complete"
                then "completed"
                elseif shieldStarted then "shield_started"
                else "damaged",
            shieldStarted = shieldStarted,
        }
end

function OldGrowthEncounter.takeFire(state: State, userId: number, now: number): (State, any)
    if state.status ~= "shielded" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local key = participantKey(userId)
    for carrierKey, expiresAt in state.carriers do
        if carrierKey ~= key and now < expiresAt then
            return state,
                {
                    accepted = false,
                    reason = "fire_claimed",
                }
        end
    end
    local nextState = cloneState(state)
    nextState.carriers[key] = now + FIRE_CARRY_SECONDS
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            expiresAt = nextState.carriers[key],
            reason = "fire_taken",
        }
end

function OldGrowthEncounter.burnHeart(state: State, userId: number, now: number): (State, any)
    if state.status ~= "shielded" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local key = participantKey(userId)
    local expiresAt = state.carriers[key]
    if expiresAt == nil or now >= expiresAt then
        return state,
            {
                accepted = false,
                reason = "fire_required",
            }
    end
    local nextState = cloneState(state)
    nextState.carriers = {}
    nextState.participants[key] = true
    nextState.status = "vulnerable"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            reason = "shield_burned",
            shieldIndex = nextState.shieldIndex,
        }
end

function OldGrowthEncounter.expire(state: State, now: number): State
    local expired = false
    local nextState = cloneState(state)
    for key, expiresAt in nextState.carriers do
        if now >= expiresAt then
            nextState.carriers[key] = nil
            expired = true
        end
    end
    if expired then
        nextState.revision += 1
        return nextState
    end
    return state
end

function OldGrowthEncounter.attack(attackIndex: number, shieldIndex: number): any
    if shieldIndex >= 1 and attackIndex % 2 == 0 then
        return CANOPY_FALL
    end
    return ROOT_LANE
end

function OldGrowthEncounter.snapshot(state: State, userId: number, now: number): any
    local expiresAt = state.carriers[tostring(userId)] or 0
    local carryingFire = now < expiresAt
    local instruction = if state.status == "shielded"
        then if carryingFire then "CARRY FIRE TO THE ROOT HEART" else "TAKE LANTERN FIRE"
        elseif state.status == "vulnerable" then "STRIKE THE AMBER HEART"
        elseif state.status == "complete" then "OLD GROWTH CLEANSED"
        elseif state.status == "disabled" then "ELITE TEMPORARILY DORMANT"
        else "ENTER THE OLD GROWTH ARENA"
    return {
        active = state.status == "vulnerable" or state.status == "shielded",
        carryingFire = carryingFire,
        complete = state.status == "complete",
        displayName = "OLD GROWTH",
        enabled = state.status ~= "disabled",
        fireExpiresAt = if carryingFire then expiresAt else 0,
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        phase = math.min(3, state.shieldIndex + 1),
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        shielded = state.status == "shielded",
        shieldIndex = state.shieldIndex,
        status = state.status,
    }
end

function OldGrowthEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        OldGrowthEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(OldGrowthEncounter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">ProfessionCatalog</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = {}

export type Definition = {
    id: string,
    displayName: string,
    shortName: string,
    role: string,
    abilityId: string,
    abilityName: string,
    abilityDescription: string,
    cooldownSeconds: number,
    activeSeconds: number,
    effectAmount: number,
    effectRadius: number,
}

local ORDER = table.freeze({
    "profession_scout",
    "profession_warden",
    "profession_engineer",
    "profession_medic",
})

local DEFINITIONS: { [string]: Definition } = {
    profession_scout = table.freeze({
        id = "profession_scout",
        displayName = "SCOUT",
        shortName = "SCOUT",
        role = "TRACK · REVEAL · SLOW",
        abilityId = "ability_foxfire_mark",
        abilityName = "FOXFIRE MARK",
        abilityDescription = "Mark and slow the nearest Rootling for the whole team.",
        cooldownSeconds = 16,
        activeSeconds = 8,
        effectAmount = 35,
        effectRadius = 55,
    }),
    profession_warden = table.freeze({
        id = "profession_warden",
        displayName = "WARDEN",
        shortName = "WARDEN",
        role = "GUARD · HOLD · PROTECT",
        abilityId = "ability_lantern_guard",
        abilityName = "LANTERN GUARD",
        abilityDescription = "Reduce incoming Rootling damage for a short window.",
        cooldownSeconds = 20,
        activeSeconds = 6,
        effectAmount = 60,
        effectRadius = 0,
    }),
    profession_engineer = table.freeze({
        id = "profession_engineer",
        displayName = "ENGINEER",
        shortName = "ENGINEER",
        role = "REPAIR · BUILD · CONTROL",
        abilityId = "ability_emergency_patch",
        abilityName = "EMERGENCY PATCH",
        abilityDescription = "Restore the First Lantern while defending it nearby.",
        cooldownSeconds = 18,
        activeSeconds = 0,
        effectAmount = 18,
        effectRadius = 30,
    }),
    profession_medic = table.freeze({
        id = "profession_medic",
        displayName = "MEDIC",
        shortName = "MEDIC",
        role = "HEAL · RESCUE · SUSTAIN",
        abilityId = "ability_guiding_pulse",
        abilityName = "GUIDING PULSE",
        abilityDescription = "Heal yourself and active allies in a nearby pulse.",
        cooldownSeconds = 24,
        activeSeconds = 0,
        effectAmount = 22,
        effectRadius = 28,
    }),
}

function ProfessionCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function ProfessionCatalog.get(id: string): Definition?
    return DEFINITIONS[id]
end

function ProfessionCatalog.list(): { Definition }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

ProfessionCatalog.Ids = table.freeze({
    Scout = "profession_scout",
    Warden = "profession_warden",
    Engineer = "profession_engineer",
    Medic = "profession_medic",
})

return table.freeze(ProfessionCatalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">ProfessionMastery</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = require("./ProfessionCatalog")

local ProfessionMastery = {}

export type Entry = {
    xp: number,
    level: number,
}

export type State = { [string]: Entry }

local MAX_LEVEL = 10
local XP_PER_LEVEL = 100

function ProfessionMastery.default(): State
    return {}
end

function ProfessionMastery.normalize(value: any): State
    local result: State = {}
    if type(value) ~= "table" then
        return result
    end
    for _, definition in ProfessionCatalog.list() do
        local raw = value[definition.id]
        if type(raw) == "table" then
            local xp = if type(raw.xp) == "number" then math.max(0, math.floor(raw.xp)) else 0
            local level = math.clamp(math.floor(xp / XP_PER_LEVEL) + 1, 1, MAX_LEVEL)
            result[definition.id] = { xp = xp, level = level }
        end
    end
    return result
end

function ProfessionMastery.award(state: State, professionId: any, amount: number): (State, any)
    if not ProfessionCatalog.isValid(professionId) or type(amount) ~= "number" or amount <= 0 then
        return state, { applied = false, reason = "invalid_mastery_award" }
    end
    local nextState = ProfessionMastery.normalize(state)
    local current = nextState[professionId] or {
        xp = 0,
        level = 1,
    }
    local nextXp = math.min(MAX_LEVEL * XP_PER_LEVEL, current.xp + math.floor(amount))
    local nextLevel = math.clamp(math.floor(nextXp / XP_PER_LEVEL) + 1, 1, MAX_LEVEL)
    nextState[professionId] = { xp = nextXp, level = nextLevel }
    return nextState,
        {
            applied = true,
            professionId = professionId,
            xp = nextXp,
            level = nextLevel,
            leveledUp = nextLevel > current.level,
        }
end

function ProfessionMastery.snapshot(state: State): { [string]: Entry }
    return ProfessionMastery.normalize(state)
end

ProfessionMastery.MaxLevel = MAX_LEVEL
ProfessionMastery.XpPerLevel = XP_PER_LEVEL

return table.freeze(ProfessionMastery)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">ProfessionState</string>
          <string name="Source"><![CDATA[--!strict

local ProfessionCatalog = require("./ProfessionCatalog")

local ProfessionState = {}

export type State = {
    selectedId: string?,
    cooldownReadyAt: number,
    activeUntil: number,
    revision: number,
}

local function validNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function ProfessionState.create(selectedId: string?, now: number): State
    assert(validNumber(now), "profession state time is invalid")
    return {
        selectedId = if ProfessionCatalog.isValid(selectedId) then selectedId else nil,
        cooldownReadyAt = now,
        activeUntil = now,
        revision = 0,
    }
end

function ProfessionState.select(
    state: State,
    professionId: string,
    now: number,
    canSwitch: boolean
): (State, any)
    if not ProfessionCatalog.isValid(professionId) then
        return state,
            {
                accepted = false,
                changed = false,
                reason = "unknown_profession",
            }
    end
    if not canSwitch then
        return state,
            {
                accepted = false,
                changed = false,
                reason = "switch_unavailable",
            }
    end
    if state.selectedId == professionId then
        return state,
            {
                accepted = true,
                changed = false,
                reason = "already_selected",
            }
    end

    local nextState: State = table.clone(state)
    nextState.selectedId = professionId
    nextState.cooldownReadyAt = math.max(state.cooldownReadyAt, now)
    nextState.activeUntil = now
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            changed = true,
            reason = "selected",
        }
end

function ProfessionState.canUse(state: State, now: number, canAct: boolean): any
    if not canAct then
        return {
            accepted = false,
            reason = "player_cannot_act",
        }
    end
    local professionId = state.selectedId
    if professionId == nil then
        return {
            accepted = false,
            reason = "profession_required",
        }
    end
    local definition = ProfessionCatalog.get(professionId)
    if definition == nil then
        return {
            accepted = false,
            reason = "unknown_profession",
        }
    end
    if now < state.cooldownReadyAt then
        return {
            accepted = false,
            reason = "cooldown",
            remaining = state.cooldownReadyAt - now,
        }
    end
    return {
        accepted = true,
        definition = definition,
    }
end

function ProfessionState.commitAbility(state: State, now: number): (State, any)
    local professionId = state.selectedId
    local definition = if professionId == nil then nil else ProfessionCatalog.get(professionId)
    assert(definition ~= nil, "cannot commit a profession ability without a valid profession")

    local nextState: State = table.clone(state)
    nextState.cooldownReadyAt = now + definition.cooldownSeconds
    nextState.activeUntil = now + definition.activeSeconds
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            abilityId = definition.abilityId,
            activeUntil = nextState.activeUntil,
            cooldownReadyAt = nextState.cooldownReadyAt,
        }
end

function ProfessionState.mitigatesDamage(state: State, now: number): boolean
    return state.selectedId == ProfessionCatalog.Ids.Warden and now < state.activeUntil
end

function ProfessionState.snapshot(state: State, now: number): any
    local definition = if state.selectedId == nil
        then nil
        else ProfessionCatalog.get(state.selectedId)
    return {
        selectedId = state.selectedId,
        displayName = if definition == nil then nil else definition.displayName,
        abilityId = if definition == nil then nil else definition.abilityId,
        abilityName = if definition == nil then nil else definition.abilityName,
        abilityDescription = if definition == nil then nil else definition.abilityDescription,
        cooldownReadyAt = state.cooldownReadyAt,
        cooldownSeconds = if definition == nil then 0 else definition.cooldownSeconds,
        activeUntil = state.activeUntil,
        ready = definition ~= nil and now >= state.cooldownReadyAt,
        revision = state.revision,
    }
end

return table.freeze(ProfessionState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">QuestCatalog</string>
          <string name="Source"><![CDATA[--!strict

local QuestCatalog = {}

export type Objective = {
    kind: string,
    threshold: number,
}

export type Reward = {
    materialId: string,
    amount: number,
}

export type Quest = {
    id: string,
    displayName: string,
    objective: Objective,
    reward: Reward,
}

local ORDER = table.freeze({
    "quest_survive_three_nights",
    "quest_first_craft",
    "quest_bramblewake_veteran",
})

local DEFINITIONS: { [string]: Quest } = {
    quest_survive_three_nights = table.freeze({
        id = "quest_survive_three_nights",
        displayName = "THREE NIGHTS SURVIVED",
        objective = table.freeze({ kind = "survive_nights", threshold = 3 }),
        reward = table.freeze({ materialId = "material_heartwood", amount = 5 }),
    }),
    quest_first_craft = table.freeze({
        id = "quest_first_craft",
        displayName = "FIRST CRAFT",
        objective = table.freeze({ kind = "craft_items", threshold = 1 }),
        reward = table.freeze({ materialId = "material_amber_sap", amount = 3 }),
    }),
    quest_bramblewake_veteran = table.freeze({
        id = "quest_bramblewake_veteran",
        displayName = "BRAMBLEWAKE VETERAN",
        objective = table.freeze({ kind = "bramblewake_settlements", threshold = 3 }),
        reward = table.freeze({ materialId = "material_brightcap", amount = 3 }),
    }),
}

function QuestCatalog.isValid(id: any): boolean
    return type(id) == "string" and DEFINITIONS[id] ~= nil
end

function QuestCatalog.get(id: string): Quest?
    return DEFINITIONS[id]
end

function QuestCatalog.list(): { Quest }
    local result = {}
    for _, id in ORDER do
        table.insert(result, DEFINITIONS[id])
    end
    return result
end

return table.freeze(QuestCatalog)
]]></string>
        </Properties>
