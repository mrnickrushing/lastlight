        "OPEN",
        "Field Book",
        nil
    )
end

function WorldService.Init(self: WorldService, context: any)
    self._runtimeIds = context.runtimeIds
    self:_configureLighting()

    local existing = workspace:FindFirstChild(self._runtimeIds.WorldName)
    if existing ~= nil then
        existing:Destroy()
    end

    local world = Instance.new("Model")
    world.Name = self._runtimeIds.WorldName
    world:SetAttribute("WorldVersion", "bramblewake-blackout-v6")
    world:SetAttribute("Ready", false)
    world.Parent = workspace
    self._world = world

    self:_buildEnvironment(world)

    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "ArrivalSpawn"
    spawn.Size = Vector3.new(12, 1, 12)
    spawn.CFrame = CFrame.new(0, 1, 0)
    spawn.Transparency = 1
    spawn.Anchored = true
    spawn.CanCollide = true
    spawn.Neutral = true
    spawn.Duration = 0
    spawn.Parent = world
    self._spawn = spawn

    self:_buildMara(world)
    self:_buildInteractables(world)

    world:SetAttribute("Ready", true)
end

function WorldService.Start(self: WorldService)
    local function bindPlayer(player: Player)
        player:SetAttribute("LastLightInExpedition", false)
        player:SetAttribute("LastLightExpeditionTransition", false)
        self._characterRoots[player] = nil
        local function bindCharacter(character: Model)
            self._characterRoots[player] = nil
            task.defer(function()
                local root = character:WaitForChild("HumanoidRootPart", 5)
                if player.Character == character and root:IsA("BasePart") then
                    self._characterRoots[player] = root
                end
            end)
        end
        player.CharacterAdded:Connect(function(character: Model)
            player:SetAttribute("LastLightInExpedition", false)
            player:SetAttribute("LastLightExpeditionTransition", false)
            bindCharacter(character)
        end)
        local character = player.Character
        if character ~= nil then
            bindCharacter(character)
        end
    end
    Players.PlayerAdded:Connect(bindPlayer)
    for _, player in Players:GetPlayers() do
        bindPlayer(player)
    end

    Players.PlayerRemoving:Connect(function(player: Player)
        self._characterRoots[player] = nil
    end)

    local accumulator = 0
    RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.5 then
            return
        end
        accumulator = 0

        for _, player in Players:GetPlayers() do
            local character = player.Character
            local root = self._characterRoots[player]
            if
                character ~= nil
                and root ~= nil
                and root.Parent ~= nil
                and root.Position.Y < -18
            then
                local recovery = if player:GetAttribute("LastLightInExpedition") == true
                        and self._expeditionEntry ~= nil
                    then self._expeditionEntry
                    else self:spawnCFrame()
                character:PivotTo(recovery :: CFrame)
            end
        end
    end)

    self._logger:info("world_started", {
        interactions = self:interactionCount(),
        worldVersion = "bramblewake-blackout-v6",
    })
end

function WorldService.interaction(self: WorldService, interactionId: string): ProximityPrompt?
    return self._interactions[interactionId]
end

function WorldService.interactionCount(self: WorldService): number
    local count = 0
    for _ in self._interactions do
        count += 1
    end
    return count
end

function WorldService.isInRange(
    _self: WorldService,
    player: Player,
    prompt: ProximityPrompt
): boolean
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    local target = prompt.Parent
    if root == nil or not root:IsA("BasePart") or target == nil or not target:IsA("BasePart") then
        return false
    end
    return (root.Position - target.Position).Magnitude <= prompt.MaxActivationDistance + 3
end

function WorldService.buildBarricade(self: WorldService, animated: boolean?)
    if self._barricadeBuilt then
        return
    end
    self._barricadeBuilt = true
    local world = assert(self._world, "world service has not initialized")
    local shouldAnimate = animated == true

    local prompt = self._interactions[self._runtimeIds.InteractionIds.Barricade]
    if prompt ~= nil then
        -- Tutorial progress is per player but this model is shared. Keep the
        -- prompt alive so a player still at `build` can submit their own
        -- action after somebody else constructed the server-wide barricade;
        -- HUDController hides it for every stage that no longer needs it.
        prompt.Enabled = true
        local target = prompt.Parent
        if target ~= nil and target:IsA("BasePart") then
            target.CanCollide = false
            target.CanQuery = true
            TweenService
                :Create(
                    target,
                    TweenInfo.new(if shouldAnimate then 0.35 else 0),
                    { Transparency = 1 }
                )
                :Play()
            local label = target:FindFirstChild("WorldLabel")
            if label ~= nil then
                label:Destroy()
            end
        end
    end

    for index = -4, 4 do
        local height = if index % 2 == 0 then 8 else 7
        local targetCFrame = CFrame.new(-20 + index * 1.8, height / 2, -88)
            * CFrame.Angles(0, 0, math.rad(index * 2))
        local stake = part(
            world,
            "BarricadeStake",
            Vector3.new(1.3, height, 1.3),
            if shouldAnimate then targetCFrame - Vector3.new(0, height + 1, 0) else targetCFrame,
            BARK,
            Enum.Material.WoodPlanks,
            not shouldAnimate
        )
        if shouldAnimate then
            stake.Transparency = 0.2
            task.delay((index + 4) * 0.055, function()
                if stake.Parent == nil then
                    return
                end
                TweenService
                    :Create(
                        stake,
                        TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                        { CFrame = targetCFrame, Transparency = 0 }
                    )
                    :Play()
                task.delay(0.36, function()
                    if stake.Parent ~= nil then
                        stake.CanCollide = true
                        stake.CanQuery = true
                        stake.CanTouch = true
                    end
                end)
            end)
        end
    end
    for level = 1, 2 do
        local targetCFrame = CFrame.new(-20, 2 + level * 2.2, -87.3)
            * CFrame.Angles(0, 0, math.rad(if level == 1 then 8 else -8))
        local brace = part(
            world,
            "BarricadeBrace",
            Vector3.new(18, 1, 1),
            if shouldAnimate then targetCFrame + Vector3.new(0, 0, 5) else targetCFrame,
            Color3.fromRGB(105, 69, 45),
            Enum.Material.WoodPlanks,
            not shouldAnimate
        )
        if shouldAnimate then
            brace.Transparency = 0.2
            task.delay(0.55 + level * 0.12, function()
                if brace.Parent == nil then
                    return
                end
                TweenService
                    :Create(
                        brace,
                        TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                        { CFrame = targetCFrame, Transparency = 0 }
                    )
                    :Play()
                task.delay(0.3, function()
                    if brace.Parent ~= nil then
                        brace.CanCollide = true
                        brace.CanQuery = true
                        brace.CanTouch = true
                    end
                end)
            end)
        end
    end

    if shouldAnimate then
        task.delay(0.9, function()
            if world.Parent == nil then
                return
            end
            local pulse = part(
                world,
                "BarricadeCompletePulse",
                Vector3.new(0.14, 4, 4),
                CFrame.new(-20, 0.18, -88) * CFrame.Angles(0, 0, math.rad(90)),
                AMBER,
                Enum.Material.Glass,
                false
            )
            pulse.Shape = Enum.PartType.Cylinder
            pulse.Transparency = 0.45
            pulse.CastShadow = false
            TweenService:Create(
                pulse,
                TweenInfo.new(0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { Size = Vector3.new(0.14, 20, 20), Transparency = 1 }
            ):Play()
            task.delay(0.55, function()
                if pulse.Parent ~= nil then
                    pulse:Destroy()
                end
            end)
        end)
    end
end

function WorldService.moveMara(self: WorldService, destination: Vector3)
    local mara = self._mara
    if mara == nil or mara.PrimaryPart == nil then
        return
    end

    task.spawn(function()
        local start = mara:GetPivot()
        local target = CFrame.new(destination)
        for step = 1, 30 do
            mara:PivotTo(start:Lerp(target, step / 30))
            task.wait(0.035)
        end
    end)
end

function WorldService.setBeaconVisible(self: WorldService, visible: boolean)
    local beacon = self._beacon
    if beacon == nil then
        return
    end
    local becomingVisible = visible and beacon.Transparency >= 0.95
    TweenService:Create(
        beacon,
        TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Transparency = if visible then 0.16 else 1 }
    ):Play()
    beacon.CanQuery = visible
    local prompt = self._interactions[self._runtimeIds.InteractionIds.Beacon]
    if prompt ~= nil then
        prompt.Enabled = visible
    end
    local light = beacon:FindFirstChildOfClass("PointLight")
    if light == nil then
        light = Instance.new("PointLight")
        light.Color = beacon.Color
        light.Brightness = 2.2
        light.Range = 34
        light.Shadows = false
        light.Parent = beacon
    end
    light.Enabled = visible
    if visible and beacon:FindFirstChild("WorldLabel") == nil then
        addBillboard(beacon, "THE BRAMBLEWAKE REMEMBERS", CREAM)
    end

    local world = self._world
    if world ~= nil then
        for _, descendant in world:GetDescendants() do
            if descendant:IsA("BasePart") and descendant.Name == "DawnPathMarker" then
                TweenService
                    :Create(
                        descendant,
                        TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                        { Transparency = if visible then 0.12 else 1 }
                    )
                    :Play()
            end
        end
    end

    if becomingVisible then
        local pulse = part(
            assert(beacon.Parent, "beacon parent is missing"),
            "DawnRevealPulse",
            Vector3.new(0.16, 5, 5),
            CFrame.new(beacon.Position - Vector3.new(0, 5.95, 0))
                * CFrame.Angles(0, 0, math.rad(90)),
            FOXFIRE,
            Enum.Material.Neon,
            false
        )
        pulse.Shape = Enum.PartType.Cylinder
        pulse.Transparency = 0.16
        pulse.CastShadow = false
        TweenService:Create(
            pulse,
            TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = Vector3.new(0.16, 34, 34), Transparency = 1 }
        ):Play()
        task.delay(1.25, function()
            if pulse.Parent ~= nil then
                pulse:Destroy()
            end
        end)
    end
end

function WorldService.setLanternHealth(self: WorldService, health: number)
    local flame = self._lantern
    if flame == nil then
        return
    end
    local clamped = math.clamp(health, 0, 100)
    local previous = self._lanternVisualHealth
    self._lanternVisualHealth = clamped
    local strength = clamped / 100
    local danger = Color3.fromRGB(255, 104, 76)
    local targetColor = danger:Lerp(AMBER, strength)
    local targetSize = Vector3.new(1.8, 2.6, 1.8):Lerp(Vector3.new(3.4, 5, 3.4), strength)

    TweenService:Create(
        flame,
        TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Color = targetColor, Size = targetSize }
    ):Play()
    local light = flame:FindFirstChildOfClass("PointLight")
    if light ~= nil then
        TweenService
            :Create(light, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Brightness = 0.7 + strength * 2.3,
                Color = targetColor,
                Range = 18 + strength * 24,
            })
            :Play()
    end
    local world = self._world
    if world ~= nil then
        world:SetAttribute("FirstLanternHealth", clamped)
    end

    if math.abs(previous - clamped) < 1 then
        return
    end
    local pulse = part(
        assert(flame.Parent, "First Lantern parent is missing"),
        if clamped < previous then "LanternDamagePulse" else "LanternRepairPulse",
        targetSize,
        flame.CFrame,
        if clamped < previous then danger else FOXFIRE,
        Enum.Material.Glass,
        false
    )
    pulse.Shape = Enum.PartType.Ball
    pulse.Transparency = 0.58
    pulse.CastShadow = false
    TweenService:Create(
        pulse,
        TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = targetSize * 1.65, Transparency = 1 }
    ):Play()
    task.delay(0.5, function()
        if pulse.Parent ~= nil then
            pulse:Destroy()
        end
    end)
end

function WorldService.setTownConsequence(self: WorldService, consequence: any)
    self._townConsequence = consequence
    local world = self._world
    if world == nil or type(consequence) ~= "table" then
        return
    end
    local existing = world:FindFirstChild("TownConsequenceBanner")
    if existing ~= nil then
        existing:Destroy()
    end
    local banner = part(
        world,
        "TownConsequenceBanner",
        Vector3.new(12, 3.5, 0.6),
        CFrame.new(0, 6, -8),
        if consequence.tier >= 2 then Color3.fromRGB(104, 187, 166) else AMBER,
        Enum.Material.WoodPlanks,
        false
    )
    addBillboard(banner, string.format("TIER %d · %s", consequence.tier, consequence.title), CREAM)
    banner:SetAttribute("Consequence", consequence.detail)
    world:SetAttribute("TownTier", consequence.tier)
    world:SetAttribute("TownDecision", tostring(consequence.decision or "unresolved"))
    world:SetAttribute("WardenOutcome", tostring(consequence.wardenOutcome or "unresolved"))
end

function WorldService.buildBramblewake(
    self: WorldService,
    manifest: any,
    generator: any,
    catalog: any
): any
    local world = assert(self._world, "world service has not initialized")
    for interactionId, prompt in self._interactions do
        local actionId = prompt:GetAttribute("ActionId")
        if
            actionId == self._runtimeIds.Actions.ExpeditionEvent
            or actionId == self._runtimeIds.Actions.Extract
            or actionId == self._runtimeIds.Actions.OldGrowthFire
            or actionId == self._runtimeIds.Actions.WardenStagChoice
            or actionId == self._runtimeIds.Actions.BramblewakeBlackout
        then
            self._interactions[interactionId] = nil
        end
    end
    self._eventSockets = {}
    self._eventTargets = {}
    self._oldGrowthArena = nil
    self._wardenStagArena = nil
    self._blackoutArena = nil

    local result = BramblewakeBuilder.build(world, manifest, generator, catalog, self._runtimeIds)
    self._expeditionEntry = result.entryCFrame
    self._expeditionManifest = manifest
    self._expeditionModuleCenters = result.moduleCenters
    self._eventSockets = result.eventSockets
    self._oldGrowthArena = result.eliteArena
    self._wardenStagArena = result.bossArena
    self._blackoutArena = result.blackout
    self:_registerInteraction(
        result.extractionTarget,
        self._runtimeIds.InteractionIds.Wayhome,
        self._runtimeIds.Actions.Extract,
        "BANK & RETURN",
        "Wayhome Gate",
        nil,
        nil
    )
    for _, descriptor in result.eventInteractions do
        self:_registerInteraction(
            descriptor.target,
            descriptor.interactionId,
            self._runtimeIds.Actions.ExpeditionEvent,
            descriptor.actionText,
            descriptor.objectText,
            nil,
            nil
        )
        local prompt = self._interactions[descriptor.interactionId]
        prompt:SetAttribute("EventId", descriptor.eventId)
        prompt:SetAttribute("EventStepId", descriptor.stepId)
        local targets = self._eventTargets[descriptor.eventId]
        if targets == nil then
            targets = {}
            self._eventTargets[descriptor.eventId] = targets
        end
        targets[descriptor.stepId] = descriptor.target
    end
    self:_registerInteraction(
        result.eliteArena.fireSource,
        self._runtimeIds.InteractionIds.OldGrowthFireSource,
        self._runtimeIds.Actions.OldGrowthFire,
        "TAKE FIRE",
        "Lantern Fire",
        nil,
        nil
    )
    self:_registerInteraction(
        result.eliteArena.rootHeart,
        self._runtimeIds.InteractionIds.OldGrowthHeart,
        self._runtimeIds.Actions.OldGrowthFire,
        "BURN SHIELD",
        "Root Heart",
        nil,
        nil
    )
    self:setOldGrowthPresentation("dormant")
    for _, descriptor in result.bossArena.interactions do
        self:_registerInteraction(
            descriptor.target,
            descriptor.interactionId,
            self._runtimeIds.Actions.WardenStagChoice,
            descriptor.actionText,
            descriptor.objectText,
            nil,
            descriptor.holdDuration
        )
    end
    self:setWardenStagPresentation({
        brokenAntlers = {},
        cleansedNodes = {},
        status = "locked",
    })
    for _, descriptor in result.blackout.interactions do
        self:_registerInteraction(
            descriptor.target,
            descriptor.interactionId,
            self._runtimeIds.Actions.BramblewakeBlackout,
            descriptor.actionText,
            descriptor.objectText,
            nil,
            descriptor.holdDuration
        )
    end
    self:setBlackoutPresentation({
        deliveredNodes = {},
        status = "dormant",
    })
    world:SetAttribute("ExpeditionReady", true)
    world:SetAttribute("ExpeditionManifestHash", manifest.hash)
    world:SetAttribute("ExpeditionEventInteractions", #result.eventInteractions)
    return result
end

function WorldService.blackoutArena(self: WorldService): any
    return self._blackoutArena
end

function WorldService.setBlackoutPresentation(self: WorldService, state: any)
    local arena = self._blackoutArena
    local world = self._world
    if arena == nil then
        return
    end
    local status = tostring(state.status)
    local relay = status == "relay"
    local resolution = status == "resolution"
    local complete = status == "complete"
    local deliveredNodes = if type(state.deliveredNodes) == "table"
        then state.deliveredNodes
        else {}

    arena.fireSource.Color = if relay then AMBER else Color3.fromRGB(94, 83, 64)
    arena.fireSource.Material = if relay then Enum.Material.Neon else Enum.Material.SmoothPlastic
    arena.fireSource.Transparency = if relay then 0.1 else 0.58
    local firePrompt = self._interactions[self._runtimeIds.InteractionIds.BlackoutFireSource]
    if firePrompt ~= nil then
        firePrompt.Enabled = relay
    end

    for nodeId, target in arena.relayNodes do
        local delivered = deliveredNodes[nodeId] == true
        target.Color = if delivered
            then FOXFIRE
            elseif relay then Color3.fromRGB(255, 137, 72)
            else Color3.fromRGB(70, 91, 72)
        target.Material = if delivered or relay
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        target.Transparency = if delivered then 0.28 elseif relay then 0.12 else 0.58
        local prompt = target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = relay
            prompt.ActionText = if delivered then "TAKE ROOTFIRE" else "DELIVER ROOTFIRE"
            prompt.ObjectText = if delivered then "Lit Living Root" else "Unlit Living Root"
        end
        local nextMarker = target:FindFirstChild("BlackoutNextMarker")
        if nodeId == state.nextNodeId and relay and not delivered then
            local marker = if nextMarker ~= nil and nextMarker:IsA("BillboardGui")
                then nextMarker
                else Instance.new("BillboardGui")
            marker.Name = "BlackoutNextMarker"
            marker.Adornee = target
            marker.AlwaysOnTop = true
            marker.LightInfluence = 0
            marker.Size = UDim2.fromOffset(150, 32)
            marker.StudsOffsetWorldSpace = Vector3.new(0, 4.8, 0)
            marker.MaxDistance = 70
            marker.Parent = target
            local markerText = marker:FindFirstChild("MarkerText")
            if markerText == nil or not markerText:IsA("TextLabel") then
                markerText = Instance.new("TextLabel")
                markerText.Name = "MarkerText"
                markerText.BackgroundColor3 = Color3.fromRGB(12, 31, 25)
                markerText.BackgroundTransparency = 0.08
                markerText.BorderSizePixel = 0
                markerText.Font = Enum.Font.GothamBold
                markerText.Size = UDim2.fromScale(1, 1)
                markerText.TextColor3 = Color3.fromRGB(172, 255, 205)
                markerText.TextSize = 13
                markerText.Text = "▼  NEXT ROOT"
                markerText.Parent = marker
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 8)
                corner.Parent = markerText
            end
        elseif nextMarker ~= nil then
            nextMarker:Destroy()
        end
        for _, rootedWall in arena.model:GetChildren() do
            if
                rootedWall:IsA("BasePart")
                and rootedWall.Name == "RootedWall"
                and rootedWall:GetAttribute("BlackoutNodeId") == nodeId
            then
                rootedWall.Color = if delivered then Color3.fromRGB(52, 90, 61) else BARK
                rootedWall.Transparency = if delivered then 0.48 else 0
            end
        end
    end

    for decisionId, target in arena.decisions do
        target.Material = if resolution or complete
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        target.Transparency = if resolution then 0.08 elseif complete then 0.3 else 0.68
        local prompt = target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = resolution
        end
        if complete then
            target:SetAttribute("Selected", state.decision == decisionId)
            if state.decision ~= decisionId then
                target.Transparency = 0.78
            end
        end
    end

    if world ~= nil then
        world:SetAttribute(
            "BlackoutActive",
            relay or status == "old_growth" or status == "warden" or resolution
        )
        world:SetAttribute("BlackoutStatus", status)
        world:SetAttribute("BlackoutRevision", tonumber(state.revision) or 0)
    end
end

function WorldService.setBlackoutLighting(self: WorldService, active: boolean)
    self._blackoutLightingActive = active
    local world = self._world
    if world ~= nil then
        world:SetAttribute("BlackoutLighting", active)
    end
    local effect = Lighting:FindFirstChild("LastLightBlackoutColor")
    if not active then
        if effect ~= nil then
            effect:Destroy()
        end
        -- Restore the current town phase; the cycle may have advanced while
        -- the Blackout owned shared Lighting.
        if self._dusk and not self._night then
            self:_applyDuskLighting()
        else
            self:_applyTownLighting(self._night)
        end
        return
    end
    Lighting.Brightness = 1.8
    Lighting.Ambient = Color3.fromRGB(48, 62, 72)
    Lighting.OutdoorAmbient = Color3.fromRGB(38, 52, 68)
    Lighting.ExposureCompensation = -0.05
    local color = if effect ~= nil and effect:IsA("ColorCorrectionEffect")
        then effect
        else Instance.new("ColorCorrectionEffect")
    color.Name = "LastLightBlackoutColor"
    color.Brightness = 0.04
    color.Contrast = 0.04
    color.Saturation = -0.05
    color.TintColor = Color3.fromRGB(164, 205, 186)
    color.Parent = Lighting
end

function WorldService.oldGrowthArena(self: WorldService): any
    return self._oldGrowthArena
end

function WorldService.setOldGrowthPresentation(self: WorldService, status: string)
    local arena = self._oldGrowthArena
    if arena == nil then
        return
    end
    local shielded = status == "shielded"
    local complete = status == "complete"
    arena.fireSource.Color = if shielded then AMBER else Color3.fromRGB(96, 87, 68)
    arena.fireSource.Material = if shielded then Enum.Material.Neon else Enum.Material.SmoothPlastic
    arena.fireSource.Transparency = if shielded then 0.12 else 0.58
    arena.rootHeart.Color = if complete
        then FOXFIRE
        elseif shielded then Color3.fromRGB(255, 117, 74)
        else Color3.fromRGB(83, 102, 82)
    arena.rootHeart.Material = if shielded or complete
        then Enum.Material.Neon
        else Enum.Material.SmoothPlastic
    arena.rootHeart.Transparency = if shielded or complete then 0.14 else 0.58

    local firePrompt = self._interactions[self._runtimeIds.InteractionIds.OldGrowthFireSource]
    local heartPrompt = self._interactions[self._runtimeIds.InteractionIds.OldGrowthHeart]
    if firePrompt ~= nil then
        firePrompt.Enabled = shielded
    end
    if heartPrompt ~= nil then
        heartPrompt.Enabled = shielded
    end
end

function WorldService.wardenStagArena(self: WorldService): any
    return self._wardenStagArena
end

function WorldService.setWardenStagPresentation(self: WorldService, state: any)
    local arena = self._wardenStagArena
    if arena == nil then
        return
    end
    local status = tostring(state.status)
    local cleansing = status == "cleansing"
    local vulnerable = status == "vulnerable"
    local complete = status == "complete"
    local enabled = status ~= "disabled"
    local cleansedNodes = if type(state.cleansedNodes) == "table" then state.cleansedNodes else {}
    local brokenAntlers = if type(state.brokenAntlers) == "table" then state.brokenAntlers else {}

    arena.seal.Color = if complete
        then FOXFIRE
        elseif vulnerable then AMBER
        elseif cleansing then Color3.fromRGB(132, 186, 126)
        elseif status == "dormant" then Color3.fromRGB(94, 154, 133)
        else Color3.fromRGB(77, 88, 79)
    arena.seal.Material = if complete
            or vulnerable
            or cleansing
        then Enum.Material.Neon
        else Enum.Material.SmoothPlastic
    arena.seal.Transparency = if enabled then 0.24 else 0.72

    for nodeId, target in arena.nodes do
        local cleansed = cleansedNodes[nodeId] == true
        target.Color = if cleansed
            then FOXFIRE
            elseif cleansing then AMBER
            else Color3.fromRGB(80, 99, 82)
        target.Material = if cleansed or cleansing
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        target.Transparency = if cleansed then 0.46 elseif cleansing then 0.12 else 0.56
        local interactionId = target:GetAttribute("InteractionId")
        local prompt = if type(interactionId) == "string"
            then self._interactions[interactionId]
            else target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = cleansing and not cleansed
        end
    end

    for antlerId, target in arena.antlers do
        local broken = brokenAntlers[antlerId] == true
        target.Color = if broken
            then Color3.fromRGB(91, 78, 67)
            elseif cleansing then Color3.fromRGB(255, 166, 106)
            else Color3.fromRGB(145, 145, 126)
        target.Material = if cleansing and not broken
            then Enum.Material.Neon
            else Enum.Material.SmoothPlastic
        target.Transparency = if broken then 0.78 elseif cleansing then 0.14 else 0.58
        local prompt = target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = cleansing and not broken
        end
    end
end

function WorldService.setExpeditionEventsEnabled(self: WorldService, enabled: boolean)
    self._eventsEnabled = enabled
    local world = self._world
    if world ~= nil then
        world:SetAttribute("ExpeditionEventsEnabled", enabled)
    end
    for _, prompt in self._interactions do
        if prompt:GetAttribute("ActionId") == self._runtimeIds.Actions.ExpeditionEvent then
            prompt.Enabled = enabled
        end
    end
end

function WorldService.setExpeditionEventState(self: WorldService, eventId: string, state: any)
    local socket = self._eventSockets[eventId]
    if socket ~= nil then
        socket:SetAttribute("Dormant", state.status == "dormant")
        socket:SetAttribute("Status", state.status)
        socket:SetAttribute("Progress", state.progress)
        socket:SetAttribute("ProgressTotal", state.total)
        socket:SetAttribute("Revision", state.revision)
    end

    local targets = self._eventTargets[eventId]
    if targets == nil then
        return
    end
    local eventCanProgress = self._eventsEnabled
        and (state.status == "dormant" or state.status == "active")
    for stepId, target in targets do
        local complete = state.completedSteps[stepId] == true
        target:SetAttribute(
            "EventStepState",
            if complete then "complete" else if eventCanProgress then "available" else state.status
        )
        if complete then
            target.Color = FOXFIRE
            target.Material = Enum.Material.Neon
            target.Transparency = 0.12
        elseif state.status == "failed" or state.status == "disabled" then
            target.Color = Color3.fromRGB(83, 91, 83)
            target.Material = Enum.Material.SmoothPlastic
            target.Transparency = 0.5
        end
        local prompt = target:FindFirstChildOfClass("ProximityPrompt")
        if prompt ~= nil then
            prompt.Enabled = eventCanProgress and not complete
        end
    end
end

function WorldService.enterBramblewake(self: WorldService, player: Player): boolean
    local entry = self._expeditionEntry
    local character = player.Character
    if entry == nil or character == nil then
        return false
    end
    if player:GetAttribute("LastLightExpeditionTransition") == true then
        return true
    end

    player:SetAttribute("LastLightInExpedition", true)
    player:SetAttribute("LastLightExpeditionTransition", true)
    task.spawn(function()
        local streamFinished = false
        task.spawn(function()
            pcall(function()
                player:RequestStreamAroundAsync(entry.Position)
            end)
            streamFinished = true
        end)

        local deadline = os.clock() + 5
        while not streamFinished and os.clock() < deadline and player.Parent ~= nil do
            task.wait(0.1)
        end

        local activeCharacter = player.Character
        if
            player.Parent ~= nil
            and player:GetAttribute("LastLightInExpedition") == true
            and activeCharacter ~= nil
        then
            activeCharacter:PivotTo(entry)
        end
        player:SetAttribute("LastLightExpeditionTransition", false)
    end)
    return true
end

function WorldService.exitBramblewake(self: WorldService, player: Player): boolean
    local character = player.Character
    if character == nil then
        return false
    end
    if player:GetAttribute("LastLightExpeditionTransition") == true then
        return true
    end

    local destination = self:spawnCFrame()
    player:SetAttribute("LastLightInExpedition", false)
    player:SetAttribute("LastLightExpeditionTransition", true)
    task.spawn(function()
        local streamFinished = false
        task.spawn(function()
            pcall(function()
                player:RequestStreamAroundAsync(destination.Position)
            end)
            streamFinished = true
        end)

        local deadline = os.clock() + 5
        while not streamFinished and os.clock() < deadline and player.Parent ~= nil do
            task.wait(0.1)
        end

        local activeCharacter = player.Character
        if player.Parent ~= nil and activeCharacter ~= nil then
            activeCharacter:PivotTo(destination)
        end
        player:SetAttribute("LastLightExpeditionTransition", false)
    end)
    return true
end

function WorldService.expeditionSnapshot(self: WorldService, player: Player): any
    local manifest = self._expeditionManifest
    if manifest == nil or player:GetAttribute("LastLightInExpedition") ~= true then
        return {
            active = false,
        }
    end

    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    local closestIndex = 1
    local closestDistance = math.huge
    if root ~= nil and root:IsA("BasePart") then
        for _, moduleCenter in self._expeditionModuleCenters do
            local distance = (root.Position - moduleCenter.position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closestIndex = moduleCenter.index
            end
        end
    end

    local placement = manifest.modules[closestIndex]
    return {
        active = true,
        eventId = placement.eventId,
        manifestHash = manifest.hash,
        moduleId = placement.moduleId,
        moduleIndex = closestIndex,
        moduleTotal = #manifest.modules,
        poiId = placement.poiId,
        seed = manifest.seed,
        source = manifest.source,
    }
end

function WorldService._setDuskSignals(self: WorldService, visible: boolean)
    for _, signal in self._duskSignals do
        if signal.Parent ~= nil then
            TweenService
                :Create(
                    signal,
                    TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {
                        Transparency = if visible
                            then tonumber(signal:GetAttribute("DuskTransparency")) or 0.1
                            else 1,
                    }
                )
                :Play()
        end
    end
end

function WorldService._applyDuskLighting(_self: WorldService)
    Lighting.ClockTime = 18.15
    Lighting.Brightness = 1.42
    Lighting.Ambient = Color3.fromRGB(49, 46, 52)
    Lighting.OutdoorAmbient = Color3.fromRGB(72, 61, 65)
    Lighting.ExposureCompensation = -0.36
    local atmosphere = Lighting:FindFirstChild("LastLightAtmosphere")
    if atmosphere ~= nil and atmosphere:IsA("Atmosphere") then
        atmosphere.Color = Color3.fromRGB(164, 143, 133)
        atmosphere.Decay = Color3.fromRGB(42, 42, 54)
        atmosphere.Density = 0.4
        atmosphere.Haze = 2.15
        atmosphere.Glare = 0.13
    end
    local tone = Lighting:FindFirstChild("LastLightTone")
    if tone ~= nil and tone:IsA("ColorCorrectionEffect") then
        tone.Brightness = -0.05
        tone.Contrast = 0.28
        tone.Saturation = -0.08
        tone.TintColor = Color3.fromRGB(237, 205, 188)
    end
    local bloom = Lighting:FindFirstChild("LastLightBloom")
    if bloom ~= nil and bloom:IsA("BloomEffect") then
        bloom.Intensity = 0.4
        bloom.Threshold = 0.78
    end
end

function WorldService.setDusk(self: WorldService, enabled: boolean)
    self._dusk = enabled
    self:_setDuskSignals(enabled)
    if self._blackoutLightingActive or self._night then
        return
    end
    if enabled then
        self:_applyDuskLighting()
    else
        self:_applyTownLighting(false)
    end
end

-- Raw property application shared by the cycle and Blackout restore path, so
-- day and night always return to the same authored values.
function WorldService._applyTownLighting(_self: WorldService, night: boolean)
    local atmosphere = Lighting:FindFirstChild("LastLightAtmosphere")
    local tone = Lighting:FindFirstChild("LastLightTone")
    local bloom = Lighting:FindFirstChild("LastLightBloom")
    local depth = Lighting:FindFirstChild("LastLightDepth")

    if night then
        Lighting.ClockTime = 0.15
        Lighting.Brightness = 0.82
        Lighting.Ambient = NIGHT_AMBIENT
        Lighting.OutdoorAmbient = Color3.fromRGB(18, 27, 47)
        Lighting.ExposureCompensation = -0.62
        if atmosphere ~= nil and atmosphere:IsA("Atmosphere") then
            atmosphere.Color = Color3.fromRGB(82, 106, 126)
            atmosphere.Decay = Color3.fromRGB(12, 18, 36)
            atmosphere.Density = 0.48
            atmosphere.Haze = 2.35
            atmosphere.Glare = 0.08
        end
        if tone ~= nil and tone:IsA("ColorCorrectionEffect") then
            tone.Brightness = -0.08
            tone.Contrast = 0.32
            tone.Saturation = -0.16
            tone.TintColor = Color3.fromRGB(183, 205, 231)
        end
        if bloom ~= nil and bloom:IsA("BloomEffect") then
            bloom.Intensity = 0.48
            bloom.Threshold = 0.72
        end
        if depth ~= nil and depth:IsA("DepthOfFieldEffect") then
            depth.FarIntensity = 0.34
            depth.FocusDistance = 72
        end
    else
        Lighting.ClockTime = 6.65
        Lighting.Brightness = 2.05
        Lighting.Ambient = DAY_AMBIENT
        Lighting.OutdoorAmbient = Color3.fromRGB(72, 91, 84)
        Lighting.ExposureCompensation = -0.18
        if atmosphere ~= nil and atmosphere:IsA("Atmosphere") then
            atmosphere.Color = Color3.fromRGB(166, 185, 174)
            atmosphere.Decay = Color3.fromRGB(43, 63, 61)
            atmosphere.Density = 0.34
            atmosphere.Haze = 1.9
            atmosphere.Glare = 0.2
        end
        if tone ~= nil and tone:IsA("ColorCorrectionEffect") then
            tone.Brightness = -0.03
            tone.Contrast = 0.24
            tone.Saturation = -0.04
            tone.TintColor = Color3.fromRGB(232, 238, 224)
        end
        if bloom ~= nil and bloom:IsA("BloomEffect") then
            bloom.Intensity = 0.34
            bloom.Threshold = 0.82
        end
        if depth ~= nil and depth:IsA("DepthOfFieldEffect") then
            depth.FarIntensity = 0.28
            depth.FocusDistance = 95
        end
    end
end

function WorldService.setNight(self: WorldService, enabled: boolean)
    self._night = enabled
    if enabled then
        self._dusk = false
        self:_setDuskSignals(false)
    end
    -- The recurring town cycle and the Blackout are timed independently and
    -- can now be active at once (an earlier decision deliberately keeps
    -- Bramblewake entry unblocked regardless of the town's night count).
    -- Let the Blackout's own dramatic presentation own shared Lighting while
    -- it's active instead of the two fighting over the same properties every
    -- time either one ticks; setBlackoutLighting(false) restores whichever
    -- of these this flag says is current once it ends.
    if self._blackoutLightingActive then
        return
    end
    self:_applyTownLighting(enabled)
end

function WorldService.spawnCFrame(self: WorldService): CFrame
    local spawn = assert(self._spawn, "arrival spawn has not initialized")
    return spawn.CFrame + Vector3.new(0, 5, 0)
end

function WorldService.lanternPosition(self: WorldService): Vector3
    return assert(self._lantern, "First Lantern has not initialized").Position
end

function WorldService.enemySpawnPosition(_self: WorldService): Vector3
    return Vector3.new(0, 2, -153)
end

return table.freeze(WorldService)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="65">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">BramblewakeBuilder</string>
            <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")

local BramblewakeBuilder = {}

local GRASS = Color3.fromRGB(40, 74, 48)
local DEEP_GRASS = Color3.fromRGB(18, 45, 34)
local PATH = Color3.fromRGB(79, 64, 44)
local BARK = Color3.fromRGB(58, 38, 29)
local DARK_BARK = Color3.fromRGB(32, 25, 23)
local STONE = Color3.fromRGB(58, 67, 63)
local AMBER = Color3.fromRGB(255, 178, 71)
local FOXFIRE = Color3.fromRGB(94, 206, 176)
local MEADOW = Color3.fromRGB(151, 123, 59)
local CREAM = Color3.fromRGB(244, 230, 197)
local MOSS = Color3.fromRGB(52, 83, 49)
local WET_EARTH = Color3.fromRGB(61, 50, 36)
local FOG_GLASS = Color3.fromRGB(119, 149, 143)

local ORIGIN = Vector3.new(1600, 0, -230)

local function part(
    parent: Instance,
    name: string,
    size: Vector3,
    cframe: CFrame,
    color: Color3,
    material: Enum.Material,
    canCollide: boolean?
): Part
    local instance = Instance.new("Part")
    instance.Name = name
    instance.Size = size
    instance.CFrame = cframe
    instance.Color = color
    instance.Material = material
    instance.Anchored = true
    instance.CanCollide = canCollide ~= false
    instance.CanTouch = instance.CanCollide
    instance.CastShadow = true
    instance.TopSurface = Enum.SurfaceType.Smooth
    instance.BottomSurface = Enum.SurfaceType.Smooth
    instance.Parent = parent
    return instance
end

local function orb(
    parent: Instance,
    name: string,
    position: Vector3,
    size: number,
    color: Color3,
    material: Enum.Material
): Part
    local instance = part(
        parent,
        name,
        Vector3.new(size, size, size),
        CFrame.new(position),
        color,
        material,
        false
    )
    instance.Shape = Enum.PartType.Ball
    return instance
end

local function light(target: BasePart, color: Color3, brightness: number, range: number)
    local pointLight = Instance.new("PointLight")
    pointLight.Color = color
    pointLight.Brightness = brightness
    pointLight.Range = range
    pointLight.Shadows = true
    pointLight.Parent = target
end

local function surfaceGrain(target: BasePart, color: Color3, transparency: number)
    local decal = Instance.new("Decal")
    decal.Name = "MaterialVariation"
    decal.Color3 = color
    decal.Transparency = transparency
    decal.Face = Enum.NormalId.Top
    decal.Parent = target
end

local function groundPatch(
    parent: Instance,
    center: Vector3,
    size: Vector3,
    color: Color3,
    material: Enum.Material
)
    local patch = part(
        parent,
        "BramblewakeGroundPatch",
        size,
        CFrame.new(center + Vector3.new(0, 0.18, 0)) * CFrame.Angles(0, center.X * 0.011, 0),
        color,
        material,
        false
    )
    patch.Transparency = 0.07
    patch.CanQuery = false
    return patch
end

local function fernCluster(parent: Instance, center: Vector3, scale: number)
    for blade = 1, 6 do
        local angle = (blade / 6) * math.pi * 2
        local frond = part(
            parent,
            "BrambleFern",
            Vector3.new(0.32 * scale, 0.18 * scale, 2.9 * scale),
            CFrame.new(
                center
                    + Vector3.new(
                        math.cos(angle) * 0.65 * scale,
                        0.55 * scale,
                        math.sin(angle) * 0.65 * scale
                    )
            ) * CFrame.Angles(math.rad(23), angle, math.rad(math.sin(angle) * 8)),
            if blade % 2 == 0 then MOSS else Color3.fromRGB(35, 69, 43),
            Enum.Material.Grass,
            false
        )
        frond.CanQuery = false
    end
end

local function rootTangle(parent: Instance, center: Vector3, scale: number, seed: number)
    local random = Random.new(seed)
    for root = 1, 4 do
        local angle = random:NextNumber(0, math.pi * 2)
        local length = random:NextNumber(7, 13) * scale
        local tangle = part(
            parent,
            "ExposedWetRoot",
            Vector3.new(0.7 * scale, length, 0.7 * scale),
            CFrame.new(
                center
                    + Vector3.new(
                        math.cos(angle) * 2.2 * scale,
                        0.65 * scale,
                        math.sin(angle) * 2.2 * scale
                    )
            )
                * CFrame.Angles(math.rad(84), angle, math.rad(random:NextNumber(-10, 10))),
            if root % 2 == 0 then DARK_BARK else BARK,
            Enum.Material.Wood,
            false
        )
        tangle.Shape = Enum.PartType.Cylinder
        tangle.CanQuery = false
    end
end

local function lowMist(parent: Instance, center: Vector3, size: Vector3, transparency: number)
    local mist = part(
        parent,
        "BlueGroundMist",
        size,
        CFrame.new(center + Vector3.new(0, 1.2, 0)),
        FOG_GLASS,
        Enum.Material.Glass,
        false
    )
    mist.Transparency = transparency
    mist.CastShadow = false
    mist.CanQuery = false
end

local function fireflyCluster(
    parent: Instance,
    center: Vector3,
    color: Color3,
    count: number,
    spread: number,
    seed: number,
    ambientMoteTag: string?
)
    local random = Random.new(seed)
    for _ = 1, count do
        local mote = orb(
            parent,
            "BrambleMote",
            center
                + Vector3.new(
                    random:NextNumber(-spread, spread),
                    random:NextNumber(1.8, 8),
                    random:NextNumber(-spread, spread)
                ),
            random:NextNumber(0.14, 0.32),
            color,
            Enum.Material.Neon
        )
        mote.Transparency = random:NextNumber(0.05, 0.3)
        mote.CanQuery = false
        if ambientMoteTag ~= nil then
            CollectionService:AddTag(mote, ambientMoteTag)
        end
    end
end

local function billboard(target: BasePart, text: string, color: Color3)
    local gui = Instance.new("BillboardGui")
    gui.Name = "LandmarkLabel"
    gui.Adornee = target
    gui.AlwaysOnTop = false
    gui.LightInfluence = 0.35
    gui.MaxDistance = 55
    gui.Size = UDim2.fromOffset(190, 40)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 3.8, 0)
    gui.Parent = target

    local label = Instance.new("TextLabel")
    label.BackgroundColor3 = Color3.fromRGB(14, 24, 21)
    label.BackgroundTransparency = 0.2
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = text
    label.TextColor3 = color
    label.TextScaled = false
    label.TextSize = 12
    label.TextWrapped = true
    label.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
end

local function _objectIcon(target: BasePart, kind: string, color: Color3)
    local gui = Instance.new("BillboardGui")
    gui.Name = "ObjectIcon"
    gui.Adornee = target
    gui.AlwaysOnTop = true
    gui.LightInfluence = 0
    gui.Size = UDim2.fromOffset(42, 42)
    gui.StudsOffsetWorldSpace = Vector3.new(0, 5.8, 0)
    gui.MaxDistance = 72
    gui.Parent = target

    local glyph = Instance.new("TextLabel")
    glyph.Name = "IconGlyph"
    glyph.BackgroundColor3 = Color3.fromRGB(10, 21, 19)
    glyph.BackgroundTransparency = 0.05
    glyph.BorderSizePixel = 0
    glyph.Size = UDim2.fromScale(1, 1)
    glyph.Font = Enum.Font.GothamBold
    glyph.Text = if kind == "rootfire"
        then "✦"
        elseif kind == "livingroot" or kind == "root" then "✤"
        elseif kind == "wayhome" then "⌂"
        elseif kind == "event" or kind == "step" then "!"
        elseif kind == "antler" then "♢"
        else "✦"
    glyph.TextColor3 = color
    glyph.TextScaled = true
    glyph.ZIndex = 10
    glyph.Parent = gui
    local glyphCorner = Instance.new("UICorner")
    glyphCorner.CornerRadius = UDim.new(0, 10)
    glyphCorner.Parent = glyph

    local viewport = Instance.new("ViewportFrame")
    viewport.Size = UDim2.fromScale(1, 1)
    viewport.BackgroundColor3 = Color3.fromRGB(15, 27, 24)
    viewport.BackgroundTransparency = 0.08
    viewport.BorderSizePixel = 0
    viewport.Ambient = Color3.fromRGB(210, 224, 212)
    viewport.LightColor = Color3.fromRGB(255, 214, 146)
    viewport.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = viewport
    local worldModel = Instance.new("WorldModel")
    worldModel.Parent = viewport
    local camera = Instance.new("Camera")
    camera.CFrame = CFrame.new(0, 0.2, 6)
    camera.FieldOfView = 28
    camera.Parent = viewport
    viewport.CurrentCamera = camera

    local icon = Instance.new("Part")
    icon.Name = kind .. "Icon"
    icon.Anchored = true
    icon.CanCollide = false
    icon.CanQuery = false
    icon.Size = if kind == "rootfire"
        then Vector3.new(1.4, 1.8, 1.4)
        else Vector3.new(1.8, 1.8, 1.8)
    icon.Position = Vector3.new(0, 0, 0)
    icon.Color = color
    icon.Material = Enum.Material.Neon
    icon.Shape = if kind == "rootfire" then Enum.PartType.Ball else Enum.PartType.Cylinder
    icon.Parent = worldModel
end

-- Interactable identity is authored by the physical world prop itself. Keep
-- this compatibility hook for older callers without adding floating UI cards.
local function objectIcon(_target: BasePart, _kind: string, _color: Color3) end

local function destinationRing(parent: Instance, center: Vector3, color: Color3, radius: number)
    for index = 1, 8 do
        local angle = (index / 8) * math.pi * 2
        local marker = orb(
            parent,
            "DestinationMarker",
            center + Vector3.new(math.cos(angle) * radius, 0.35, math.sin(angle) * radius),
            0.28,
            color,
            Enum.Material.Neon
        )
        marker.CanQuery = false
    end
end

local function tree(parent: Instance, position: Vector3, scale: number)
    local trunk = part(
        parent,
        "BrambleTrunk",
        Vector3.new(2.4 * scale, 14 * scale, 2.4 * scale),
        CFrame.new(position + Vector3.new(0, 7 * scale, 0)),
        BARK,
        Enum.Material.Wood
    )
    for side = -1, 1, 2 do
        local branch = part(
            parent,
            "BrambleBranch",
            Vector3.new(0.65 * scale, 5 * scale, 0.65 * scale),
            CFrame.new(position + Vector3.new(side * 2.3 * scale, 7 * scale, 0))
                * CFrame.Angles(0, 0, math.rad(side * 48)),
            BARK,
            Enum.Material.Wood,
            false
        )
        branch.CanQuery = false
    end
    for layer = 1, 2 do
        local crownPosition = position + Vector3.new(0, (11 + layer * 4.2) * scale, 0)
        local crownSize =
            Vector3.new((11 - layer * 1.5) * scale, (7 - layer) * scale, (11 - layer * 1.5) * scale)
        for half = 1, 2 do
            local crown = part(
                parent,
                "BrambleCrown",
                crownSize,
                CFrame.new(crownPosition)
                    * CFrame.Angles(0, if half == 1 then 0.15 else math.pi + 0.15, 0),
                if layer == 1 then DEEP_GRASS else GRASS,
                Enum.Material.Grass,
                false
            )
            crown.Shape = Enum.PartType.Wedge
            crown.CanQuery = false
        end
    end
    trunk.CanQuery = false
end

local function rootArch(parent: Instance, center: Vector3, scale: number)
    for side = -1, 1, 2 do
        part(
            parent,
            "LivingRoot",
            Vector3.new(2.4 * scale, 18 * scale, 2.4 * scale),
            CFrame.new(center + Vector3.new(side * 10 * scale, 8 * scale, side * 10 * scale))
                * CFrame.Angles(0, 0, math.rad(-side * 18)),
            BARK,
            Enum.Material.Wood
        )
    end
    part(
        parent,
        "RootCrown",
        Vector3.new(29 * scale, 2.8 * scale, 3 * scale),
        CFrame.new(center + Vector3.new(0, 17 * scale, 0)) * CFrame.Angles(0, math.rad(45), 0),
        DARK_BARK,
        Enum.Material.Wood
    )
end

local function lantern(parent: Instance, position: Vector3, scale: number, ambientLightTag: string?)
    part(
        parent,
        "FoxfirePost",
        Vector3.new(0.8 * scale, 6 * scale, 0.8 * scale),
        CFrame.new(position + Vector3.new(0, 3 * scale, 0)),
        BARK,
        Enum.Material.Wood
    )
    local glow = orb(
        parent,
        "FoxfireGlow",
        position + Vector3.new(0, 6.4 * scale, 0),
        2.1 * scale,
        FOXFIRE,
        Enum.Material.Neon
    )
    light(glow, FOXFIRE, 1.8, 18 * scale)
    if ambientLightTag ~= nil then
        CollectionService:AddTag(glow, ambientLightTag)
    end
end

local function pathArm(parent: Instance, center: Vector3, neighbor: Vector3)
    local delta = neighbor - center
    local target = center + delta.Unit * 38
    local midpoint = (center + target) / 2 + Vector3.new(0, 0.28, 0)
    part(
        parent,
        "CriticalPath",
        Vector3.new(14, 0.5, (target - center).Magnitude + 4),
        CFrame.lookAt(midpoint, target),
        PATH,
        Enum.Material.Ground
    )
end

local function window(parent: Instance, position: Vector3, rotation: number)
    local frame = part(
        parent,
        "FarmWindowFrame",
        Vector3.new(3.8, 2.6, 0.35),
        CFrame.new(position) * CFrame.Angles(0, rotation, 0),
        DARK_BARK,
        Enum.Material.WoodPlanks,
        false
    )
    local pane = part(
        parent,
        "FarmWindowGlow",
        Vector3.new(2.8, 1.7, 0.15),
        CFrame.new(position + Vector3.new(0, 0, -0.22)) * CFrame.Angles(0, rotation, 0),
        Color3.fromRGB(255, 196, 103),
        Enum.Material.Glass,
        false
    )
    pane.Transparency = 0.18
    local cross = part(
        parent,
        "FarmWindowCross",
        Vector3.new(0.18, 2.1, 0.2),
        CFrame.new(position + Vector3.new(0, 0, -0.32)) * CFrame.Angles(0, rotation, 0),
        CREAM,
        Enum.Material.Wood,
        false
    )
    cross.CanQuery = false
    frame.CanQuery = false
end

local function fence(parent: Instance, start: Vector3, count: number, spacing: number)
    for index = 0, count - 1 do
        local position = start + Vector3.new(index * spacing, 0, 0)
        part(
            parent,
            "FieldFencePost",
            Vector3.new(0.6, 2.8, 0.6),
            CFrame.new(position + Vector3.new(0, 1.4, 0)),
            BARK,
            Enum.Material.Wood
        )
        if index < count - 1 then
            part(
                parent,
                "FieldFenceRail",
                Vector3.new(spacing + 0.2, 0.35, 0.35),
                CFrame.new(position + Vector3.new(spacing / 2, 1.1, 0)),
                DARK_BARK,
                Enum.Material.WoodPlanks,
                false
            )
            part(
                parent,
                "FieldFenceRail",
                Vector3.new(spacing + 0.2, 0.35, 0.35),
                CFrame.new(position + Vector3.new(spacing / 2, 2.0, 0)),
                DARK_BARK,
                Enum.Material.WoodPlanks,
                false
            )
        end
    end
end

local function moduleDressing(parent: Instance, center: Vector3, seed: number, runtimeIds: any)
    local random = Random.new(seed)
    groundPatch(
        parent,
        center,
        Vector3.new(42, 0.28, 42),
        Color3.fromRGB(35, 61, 42),
        Enum.Material.LeafyGrass
    )
    groundPatch(
        parent,
        center + Vector3.new(0, 0.02, 0),
        Vector3.new(25, 0.22, 25),
        WET_EARTH,
        Enum.Material.Mud
    )
    lowMist(parent, center, Vector3.new(56, 1.4, 56), 0.84)
    for index = 1, 13 do
        local angle = random:NextNumber(0, math.pi * 2)
        local radius = random:NextNumber(12, 31)
        local position = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        local stone = orb(
            parent,
            "TrailStone",
            position + Vector3.new(0, 0.55, 0),
            random:NextNumber(1.2, 2.6),
            if index % 2 == 0 then STONE else Color3.fromRGB(75, 85, 72),
            Enum.Material.Slate
        )
        stone.CFrame *= CFrame.Angles(0.15, angle, 0.1)
        stone.CanQuery = false
        if index % 3 == 0 then
            rootTangle(
                parent,
                position + Vector3.new(1, 0, -1),
                random:NextNumber(0.65, 1.1),
                seed + index
            )
        end
    end
    for index = 1, 10 do
        local angle = random:NextNumber(0, math.pi * 2)
        local radius = random:NextNumber(7, 28)
        local position = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        if index % 2 == 0 then
            fernCluster(parent, position, random:NextNumber(0.7, 1.25))
        else
            local tuft = orb(
                parent,
                "MossLight",
                position + Vector3.new(0, 0.6, 0),
                0.42,
                if index % 3 == 0 then FOXFIRE else AMBER,
                Enum.Material.Neon
            )
            tuft.Transparency = 0.2
            tuft.CanQuery = false
            CollectionService:AddTag(tuft, runtimeIds.AmbientLightTag)
        end
    end
    fireflyCluster(
        parent,
        center + Vector3.new(0, 0, 5),
        FOXFIRE,
        5,
        24,
        seed + 1301,
        runtimeIds.AmbientMoteTag
    )
end

local function buildFarm(parent: Instance, center: Vector3)
    local housePosition = center + Vector3.new(21, 5.5, 20)
    part(
        parent,
        "Farmhouse",
        Vector3.new(16, 11, 12),
        CFrame.new(housePosition),
        Color3.fromRGB(92, 66, 46),
        Enum.Material.WoodPlanks
    )
    local roof = part(
        parent,
        "RainDarkRoof",
        Vector3.new(20, 2, 8.5),
        CFrame.new(housePosition + Vector3.new(0, 7.2, -4.2)) * CFrame.Angles(0, 0, math.rad(-24)),
        DARK_BARK,
        Enum.Material.Slate
    )
    roof.CanQuery = false
    local roof2 = part(
        parent,
        "RainDarkRoof",
        Vector3.new(20, 2, 8.5),
        CFrame.new(housePosition + Vector3.new(0, 7.2, 4.2)) * CFrame.Angles(0, 0, math.rad(24)),
        DARK_BARK,
        Enum.Material.Slate
    )
    roof2.CanQuery = false
    part(
        parent,
        "FarmDoor",
        Vector3.new(3.2, 5.4, 0.35),
        CFrame.new(housePosition + Vector3.new(0, -2.8, -6.2)),
        DARK_BARK,
        Enum.Material.WoodPlanks,
        false
    )
    window(parent, housePosition + Vector3.new(-5, 1.3, -6.25), 0)
    window(parent, housePosition + Vector3.new(5, 1.3, -6.25), 0)
    part(
        parent,
        "FarmChimney",
        Vector3.new(2.2, 5, 2.2),
        CFrame.new(housePosition + Vector3.new(4.5, 9, 1.5)),
        STONE,
        Enum.Material.Brick,
        false
    )
    fence(parent, center + Vector3.new(-31, 0, 24), 6, 4.8)
    for index = 1, 3 do
        local bale = part(
            parent,
            "HayBale",
            Vector3.new(3.4, 2.2, 2.2),
            CFrame.new(center + Vector3.new(-28 + index * 3.8, 1.1, 17)),
            MEADOW,
            Enum.Material.Fabric,
            false
        )
        bale.Shape = Enum.PartType.Cylinder
        bale.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    end
    for row = -1, 1 do
        part(
            parent,
            "OldFieldRow",
            Vector3.new(3, 0.8, 28),
            CFrame.new(center + Vector3.new(-18 + row * 6, 0.2, 9)),
            MEADOW,
            Enum.Material.Ground,
            false
        )
    end
end

local function buildWindmill(parent: Instance, center: Vector3, ambientMotionTag: string)
    local tower = part(
        parent,
        "WindmillTower",
        Vector3.new(9, 30, 9),
        CFrame.new(center + Vector3.new(22, 15, 20)),
        Color3.fromRGB(105, 84, 61),
        Enum.Material.WoodPlanks
    )
    local hub = orb(
        parent,
        "WindmillHub",
        tower.Position + Vector3.new(0, 8, -5),
        3,
        STONE,
        Enum.Material.Metal
    )
    local cap = part(
        parent,
        "WindmillCap",
        Vector3.new(11, 3, 11),
        CFrame.new(tower.Position + Vector3.new(0, 16, 0)),
        DARK_BARK,
        Enum.Material.Slate,
        false
    )
    cap.Shape = Enum.PartType.Cylinder
    cap.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    for side = -1, 1, 2 do
        part(
            parent,
            "WindmillBrace",
            Vector3.new(1.1, 28, 1.1),
            CFrame.new(tower.Position + Vector3.new(side * 3.3, 0, -4.6))
                * CFrame.Angles(0, 0, math.rad(side * 9)),
            DARK_BARK,
            Enum.Material.Wood,
            false
        )
    end
    local rotor = Instance.new("Model")
    rotor.Name = "WindmillRotor"
    rotor:SetAttribute("MotionKind", "rotor")
    rotor:SetAttribute("MotionSpeed", 0.3)
    rotor.Parent = parent
    local rotorPivot = part(
        rotor,
        "WindmillRotorPivot",
        Vector3.new(0.2, 0.2, 0.2),
        CFrame.new(hub.Position),
        STONE,
        Enum.Material.SmoothPlastic,
        false
    )
    rotorPivot.Transparency = 1
    rotorPivot.CanQuery = false
    rotorPivot.CastShadow = false
    rotor.PrimaryPart = rotorPivot
    for angle = 0, 3 do
        part(
            rotor,
            "WindmillSail",
            Vector3.new(2, 19, 0.8),
            CFrame.new(hub.Position) * CFrame.Angles(0, 0, angle * math.pi / 2),
            CREAM,
            Enum.Material.Fabric,
            false
        )
        part(
            rotor,
            "WindmillSailArm",
            Vector3.new(0.7, 16, 1.2),
            CFrame.new(hub.Position) * CFrame.Angles(0, 0, angle * math.pi / 2 + math.pi / 4),
            BARK,
            Enum.Material.Wood,
            false
        )
    end
    CollectionService:AddTag(rotor, ambientMotionTag)
end

local function buildModuleVisual(parent: Instance, visual: string, center: Vector3, runtimeIds: any)
    if visual == "lantern_gate" then
        rootArch(parent, center, 1)
        lantern(parent, center + Vector3.new(-14, 0, 13), 1, runtimeIds.AmbientLightTag)
        lantern(parent, center + Vector3.new(14, 0, 13), 1, runtimeIds.AmbientLightTag)
    elseif visual == "root_arch" then
        rootArch(parent, center + Vector3.new(0, 0, -7), 0.9)
        for offset = -1, 1, 2 do
            orb(
                parent,
                "Brightcap",
                center + Vector3.new(offset * 15, 1.1, 12),
                2.2,
                FOXFIRE,
                Enum.Material.Neon
            )
        end
    elseif visual == "orchard" then
        for x = -1, 1 do
            for z = -1, 1 do
                tree(parent, center + Vector3.new(x * 17, 0, z * 17), 0.68)
            end
        end
    elseif visual == "foxglove" then
        for index = 1, 8 do
            local side = if index % 2 == 0 then 1 else -1
            local glow = orb(
                parent,
                "Foxglove",
                center + Vector3.new(side * (12 + index), 1.2, -26 + index * 6),
                1.4,
                if index % 3 == 0 then AMBER else FOXFIRE,
                Enum.Material.Neon
            )
            glow.CanQuery = false
        end
    elseif visual == "farm" then
        buildFarm(parent, center)
    elseif visual == "briar_ring" then
        for index = 1, 8 do
            local angle = (index / 8) * math.pi * 2 + math.pi / 8
            part(
                parent,
                "BriarSpine",
                Vector3.new(1.4, 10, 1.4),
                CFrame.new(center + Vector3.new(math.cos(angle) * 25, 4, math.sin(angle) * 25))
                    * CFrame.Angles(math.rad(18), 0, -angle),
                DARK_BARK,
                Enum.Material.Wood
            )
        end
    elseif visual == "sapfall" then
        for index = -2, 2 do
            local stone = orb(
                parent,
                "SapglassStone",
                center + Vector3.new(index * 8, 2, 17 + math.abs(index) * 2),
                4.5,
                STONE,
                Enum.Material.Slate
            )
            local sap = orb(
                parent,
                "AmberSap",
                stone.Position + Vector3.new(0, 3.2, 0),
                1.8,
                AMBER,
                Enum.Material.Neon
            )
            if index == 0 then
                light(sap, AMBER, 1.7, 18)
            end
        end
    elseif visual == "windmill" then
        buildWindmill(parent, center, runtimeIds.AmbientMotionTag)
    elseif visual == "bridge" then
        for index = -4, 4 do
            part(
                parent,
                "RootBridgePlank",
                Vector3.new(7, 0.8, 4.5),
                CFrame.new(center + Vector3.new(19, 1 + math.abs(index) * 0.2, index * 4.4)),
                Color3.fromRGB(121, 83, 52),
                Enum.Material.WoodPlanks
            )
        end
    elseif visual == "moth_meadow" then
        part(
            parent,
            "MeadowGold",
            Vector3.new(46, 0.7, 46),
            CFrame.new(center + Vector3.new(0, 0.1, 0)),
            MEADOW,
            Enum.Material.Grass
        )
        for index = 1, 10 do
            local angle = index * 2.4
            local moth = orb(
                parent,
                "LanternMoth",
                center
                    + Vector3.new(
                        math.cos(angle) * (8 + index),
                        3 + (index % 4),
                        math.sin(angle) * (8 + index)
                    ),
                0.65,
                FOXFIRE,
                Enum.Material.Neon
            )
            CollectionService:AddTag(moth, runtimeIds.AmbientMoteTag)
        end
    elseif visual == "old_growth" then
        part(
            parent,
            "OldGrowthTrunk",
            Vector3.new(15, 48, 15),
            CFrame.new(center + Vector3.new(22, 23, 22)),
            DARK_BARK,
            Enum.Material.Wood
        )
        for index = 1, 5 do
            local angle = (index / 5) * math.pi * 2
            part(
                parent,
                "CathedralRoot",
                Vector3.new(4, 30, 5),
                CFrame.new(
                    center + Vector3.new(22 + math.cos(angle) * 10, 10, 22 + math.sin(angle) * 10)
                ) * CFrame.Angles(math.rad(24), 0, -angle),
                BARK,
                Enum.Material.Wood
            )
        end
    elseif visual == "wayhome_gate" then
        rootArch(parent, center, 1.15)
        local beacon =
            orb(parent, "WayhomeLight", center + Vector3.new(0, 8, 0), 6, AMBER, Enum.Material.Neon)
        light(beacon, AMBER, 3, 36)
        billboard(beacon, "WAYHOME GATE", CREAM)
        objectIcon(beacon, "wayhome", AMBER)
    end
end

local function buildPointOfInterest(
    parent: Instance,
    center: Vector3,
    definition: any,
    runtimeIds: any
)
    local anchor = part(
        parent,
        "PointOfInterest",
        Vector3.new(9, 2, 9),
        CFrame.new(center + Vector3.new(-21, 1, -18)),
        STONE,
        Enum.Material.Slate
    )
    anchor:SetAttribute("ContentId", definition.id)
    anchor:SetAttribute("DisplayName", definition.displayName)
    CollectionService:AddTag(anchor, runtimeIds.ExpeditionPointOfInterestTag)
    local memory = orb(
        parent,
        "MemoryLight",
        anchor.Position + Vector3.new(0, 4, 0),
        3.2,
        FOXFIRE,
        Enum.Material.Neon
    )
    light(memory, FOXFIRE, 1.4, 18)
    billboard(memory, string.upper(definition.displayName), FOXFIRE)
    objectIcon(memory, "memory", FOXFIRE)
    for index = 1, 6 do
        local angle = (index / 6) * math.pi * 2
        local marker = orb(
            parent,
            "MemoryRune",
            anchor.Position + Vector3.new(math.cos(angle) * 5.5, 0.45, math.sin(angle) * 5.5),
            0.35,
            FOXFIRE,
            Enum.Material.Neon
        )
        marker.CanQuery = false
    end
end

local function buildEventSocket(
    parent: Instance,
    center: Vector3,
    definition: any,
    runtimeIds: any
): any
    local anchor = part(
        parent,
        "EventSocket",
        Vector3.new(7, 1, 7),
        CFrame.new(center + Vector3.new(22, 0.5, -19)),
        Color3.fromRGB(99, 72, 48),
        Enum.Material.WoodPlanks
    )
    anchor:SetAttribute("ContentId", definition.id)
    anchor:SetAttribute("DisplayName", definition.displayName)
    anchor:SetAttribute("Dormant", true)
    anchor:SetAttribute("Status", "dormant")
    anchor:SetAttribute("Progress", 0)
    anchor:SetAttribute("ProgressTotal", #definition.steps)
    CollectionService:AddTag(anchor, runtimeIds.ExpeditionEventTag)
    billboard(anchor, string.upper(definition.displayName), AMBER)
    objectIcon(anchor, "event", AMBER)
    destinationRing(parent, anchor.Position, AMBER, 5.5)

    if definition.visual == "wagon" then
        part(
            parent,
            "LostWagon",
            Vector3.new(10, 5, 7),
            CFrame.new(anchor.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0.35, 0.14),
            Color3.fromRGB(104, 69, 42),
            Enum.Material.WoodPlanks
        )
    elseif definition.visual == "hedge" then
        part(
            parent,
            "MovingHedge",
            Vector3.new(18, 9, 5),
            CFrame.new(anchor.Position + Vector3.new(0, 4.5, 0)),
            DEEP_GRASS,
            Enum.Material.Grass
        )
    elseif definition.visual == "root_bridge" then
        rootArch(parent, anchor.Position, 0.52)
    end

    local interactions = {}
    for index, step in definition.steps do
        local offset = step.offset
        local position = anchor.Position + Vector3.new(offset.x, offset.y, offset.z)
        local target: Part
        if definition.visual == "foxlight" then
            target = orb(parent, "Foxlight_" .. step.id, position, 2.2, FOXFIRE, Enum.Material.Neon)
            target.Transparency = 0.16
            light(target, FOXFIRE, 1.1, 14)
            part(
                parent,
                "FoxlightStem_" .. step.id,
                Vector3.new(0.35, 2.2, 0.35),
                CFrame.new(position - Vector3.new(0, 1.4, 0)) * CFrame.Angles(0, 0, math.rad(12)),
                DARK_BARK,
                Enum.Material.Wood,
                false
            )
        elseif definition.visual == "root_bridge" then
            target = orb(parent, "RootKnot_" .. step.id, position, 2.7, AMBER, Enum.Material.Wood)
            target.Shape = Enum.PartType.Cylinder
            target.CFrame *= CFrame.Angles(0, 0, math.rad(90))
            target.Size = Vector3.new(1.5, 2.7, 1.5)
            for rootIndex = -1, 1 do
                part(
                    parent,
                    "RootBridgeBranch_" .. step.id,
                    Vector3.new(0.45, 2.8, 0.45),
                    CFrame.new(position + Vector3.new(rootIndex * 0.8, 0.4, 0.8))
                        * CFrame.Angles(math.rad(34), 0, math.rad(rootIndex * 18)),
                    BARK,
                    Enum.Material.Wood,
                    false
                )
            end
        elseif definition.visual == "wagon" then
            target = part(
                parent,
                "WagonBrace_" .. step.id,
                Vector3.new(2.8, 1.4, 2.8),
                CFrame.new(position) * CFrame.Angles(0, index * 0.55, math.rad(8)),
                AMBER,
                Enum.Material.WoodPlanks,
                false
            )
        else
            target = part(
                parent,
                "HedgeLatch_" .. step.id,
                Vector3.new(1.4, 3.2, 1.4),
                CFrame.new(position) * CFrame.Angles(0, 0, math.rad(index * 8 - 16)),
                AMBER,
                Enum.Material.WoodPlanks,
                false
            )
        end
        target.CastShadow = false
        objectIcon(target, "step", AMBER)
        target:SetAttribute("EventId", definition.id)
        target:SetAttribute("EventStepId", step.id)
        target:SetAttribute("EventStepState", "available")
        CollectionService:AddTag(target, runtimeIds.ExpeditionEventStepTag)
        table.insert(interactions, {
            actionText = step.actionText,
            eventId = definition.id,
            interactionId = runtimeIds.eventInteractionId(definition.id, step.id),
            objectText = step.objectText,
            stepId = step.id,
            target = target,
        })
    end

    return {
        interactions = interactions,
        socket = anchor,
    }
end

local function buildBackdrop(parent: Instance, centers: { Vector3 })
    local folder = Instance.new("Folder")
    folder.Name = "RegionalBackdrop"
    folder.Parent = parent

    local average = Vector3.zero
    for _, center in centers do
        average += center
    end
    average /= #centers

    lowMist(folder, average + Vector3.new(0, 0, 0), Vector3.new(680, 2.2, 680), 0.88)
    for ring = 1, 2 do
        for index = 1, 18 do
            local angle = (index / 18) * math.pi * 2 + ring * 0.09
            local radius = 230 + ring * 70 + (index % 4) * 18
            local height = 52 + (index % 5) * 16 + ring * 8
            local spire = part(
                folder,
                "DistantRootSpire",
                Vector3.new(10 + ring * 4, height, 10 + ring * 4),
                CFrame.new(
                    average
                        + Vector3.new(
                            math.cos(angle) * radius,
                            height / 2 - 3,
                            math.sin(angle) * radius
                        )
                ) * CFrame.Angles(math.rad(8 + ring * 2), 0, -angle),
                if ring == 1 then Color3.fromRGB(32, 45, 39) else Color3.fromRGB(24, 35, 34),
                Enum.Material.Wood
            )
            spire.Transparency = if ring == 1 then 0.08 else 0.18
            if index % 6 == 0 then
                local glow = orb(
                    folder,
                    "DistantSapGlow",
                    spire.Position + Vector3.new(0, height * 0.28, 0),
                    1.3,
                    FOXFIRE,
                    Enum.Material.Neon
                )
                glow.Transparency = 0.38
                glow.CanQuery = false
            end
        end
    end
end

local function isOccupied(center: Vector3, centers: { Vector3 }): boolean
    for _, existing in centers do
        if (existing - center).Magnitude < 1 then
            return true
        end
    end
    return false
end

local function annexCenter(
    oldGrowthCenter: Vector3,
    centers: { Vector3 },
    cellSize: number
): Vector3
    for _, direction in
        {
            Vector3.new(1, 0, 0),
            Vector3.new(0, 0, 1),
            Vector3.new(-1, 0, 0),
            Vector3.new(0, 0, -1),
        }
    do
        local candidate = oldGrowthCenter + direction * cellSize
        if not isOccupied(candidate, centers) then
            return candidate
        end
    end
    error("Old Growth has no free neighbor for the Warden's Seal")
end

local function buildWardenSeal(
    parent: Instance,
    oldGrowthCenter: Vector3,
    centers: { Vector3 },
    cellSize: number,
    runtimeIds: any
): any
    local center = annexCenter(oldGrowthCenter, centers, cellSize)
    local arena = Instance.new("Model")
    arena.Name = "WardenSealAnnex"
    arena:SetAttribute("BossId", "boss_warden_stag")
    arena:SetAttribute("ContentId", "arena_bw_warden_seal")
    arena.Parent = parent
    pcall(function()
        arena.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    end)

    pathArm(arena, oldGrowthCenter, center)
    pathArm(arena, center, oldGrowthCenter)
    part(
        arena,
        "WardenSealGround",
        Vector3.new(66, 5, 66),
        CFrame.new(center + Vector3.new(0, -2.5, 0)),
        Color3.fromRGB(38, 68, 48),
        Enum.Material.Grass
    )
    part(
        arena,
        "MemorySeal",
        Vector3.new(38, 1.1, 38),
        CFrame.new(center + Vector3.new(0, 0.15, 0)),
        STONE,
        Enum.Material.Slate
    )

    local seal = orb(
        arena,
        "WardenMemorySeal",
        center + Vector3.new(0, 1.5, 0),
        7,
        Color3.fromRGB(87, 119, 101),
        Enum.Material.SmoothPlastic
    )
    seal.Shape = Enum.PartType.Cylinder
    seal.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    seal.Size = Vector3.new(1.2, 7, 7)
    seal.Transparency = 0.52
    billboard(seal, "WARDEN'S SEAL · CLEANSE OLD GROWTH", CREAM)
    objectIcon(seal, "seal", FOXFIRE)

    local nodeDefinitions = {
        {
            direction = Vector3.new(0, 0, -1),
            interactionId = runtimeIds.InteractionIds.WardenStagRootNorth,
            nodeId = "root_node_north",
            suffix = "North",
        },
        {
            direction = Vector3.new(1, 0, 0),
            interactionId = runtimeIds.InteractionIds.WardenStagRootEast,
            nodeId = "root_node_east",
            suffix = "East",
        },
        {
            direction = Vector3.new(0, 0, 1),
            interactionId = runtimeIds.InteractionIds.WardenStagRootSouth,
            nodeId = "root_node_south",
            suffix = "South",
        },
        {
            direction = Vector3.new(-1, 0, 0),
            interactionId = runtimeIds.InteractionIds.WardenStagRootWest,
            nodeId = "root_node_west",
            suffix = "West",
        },
    }
    local nodes = {}
    local interactions = {}
    for _, definition in nodeDefinitions do
        local node = orb(
            arena,
            "LivingRootNode" .. definition.suffix,
            center + definition.direction * 22 + Vector3.new(0, 3, 0),
            5,
            Color3.fromRGB(80, 116, 83),
            Enum.Material.SmoothPlastic
        )
        node.Shape = Enum.PartType.Cylinder
        node.CFrame *= CFrame.Angles(0, 0, math.rad(90))
        node.Size = Vector3.new(2.6, 4.8, 2.6)
        node.Transparency = 0.34
        node:SetAttribute("BossId", "boss_warden_stag")
        node:SetAttribute("BossInteraction", "cleanse_root")
        node:SetAttribute("BossNodeId", definition.nodeId)
        CollectionService:AddTag(node, runtimeIds.ExpeditionBossTag)
        billboard(node, string.upper(string.gsub(definition.nodeId, "_", " ")), CREAM)
        objectIcon(node, "root", FOXFIRE)
        nodes[definition.nodeId] = node
        table.insert(interactions, {
            actionText = "CLEANSE ROOT",
            holdDuration = 0.6,
            interactionId = definition.interactionId,
            objectText = "Living Root Node",
            target = node,
        })
    end

    local antlers = {}
    for _, definition in
        {
            {
                antlerId = "antler_left",
                interactionId = runtimeIds.InteractionIds.WardenStagAntlerLeft,
                side = -1,
            },
            {
                antlerId = "antler_right",
                interactionId = runtimeIds.InteractionIds.WardenStagAntlerRight,
                side = 1,
            },
        }
    do
        local target = part(
            arena,
            if definition.side < 0 then "MemoryAntlerLeft" else "MemoryAntlerRight",
            Vector3.new(2.2, 9, 2.2),
            CFrame.new(center + Vector3.new(definition.side * 12, 4.5, 8))
                * CFrame.Angles(0, 0, math.rad(definition.side * 24)),
            Color3.fromRGB(194, 199, 173),
            Enum.Material.SmoothPlastic,
            false
        )
        target.Transparency = 0.2
        target:SetAttribute("BossId", "boss_warden_stag")
        target:SetAttribute("BossInteraction", "break_antler")
        target:SetAttribute("BossAntlerId", definition.antlerId)
        CollectionService:AddTag(target, runtimeIds.ExpeditionBossTag)
        billboard(target, "BREAK ANTLER · CHANGES FOREST", Color3.fromRGB(255, 166, 106))
        objectIcon(target, "antler", Color3.fromRGB(255, 166, 106))
        antlers[definition.antlerId] = target
        table.insert(interactions, {
            actionText = "BREAK ANTLER",
            holdDuration = 1.1,
            interactionId = definition.interactionId,
            objectText = "Harmful Shortcut",
            target = target,
        })
    end

    for index = 1, 10 do
        local angle = (index / 10) * math.pi * 2
        if math.abs(math.sin(angle)) > 0.32 then
            part(
                arena,
                "SealRootPillar",
                Vector3.new(3, 18 + (index % 3) * 4, 3),
                CFrame.new(
                    center
                        + Vector3.new(
                            math.cos(angle) * 31,
                            8 + (index % 3) * 2,
                            math.sin(angle) * 31
                        )
                ) * CFrame.Angles(math.rad(9), 0, -angle),
                if index % 2 == 0 then BARK else DARK_BARK,
                Enum.Material.Wood
            )
        end
    end
    for side = -1, 1, 2 do
        tree(arena, center + Vector3.new(side * 27, 0, -27), 1.25)
    end

    return {
        antlers = antlers,
        center = center,
        interactions = interactions,
        model = arena,
        nodes = nodes,
        seal = seal,
    }
end

local function buildBlackoutLayer(
    parent: Instance,
    centers: { Vector3 },
    bossCenter: Vector3,
    runtimeIds: any
): any
    local layer = Instance.new("Model")
    layer.Name = "BramblewakeBlackoutLayer"
    layer:SetAttribute("BlackoutId", "blackout_bramblewake")
    layer:SetAttribute("ContentId", "blackout_bw_rootfire_relay")
    layer.Parent = parent
    pcall(function()
        layer.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
    end)

    local sourceCenter = assert(centers[1], "Blackout fire source center is missing")
    local fireSource = orb(
        layer,
        "BlackoutLanternFire",
        sourceCenter + Vector3.new(13, 4, 13),
        5,
        Color3.fromRGB(94, 83, 64),
        Enum.Material.SmoothPlastic
    )
    fireSource.Shape = Enum.PartType.Cylinder
    fireSource.CFrame *= CFrame.Angles(0, 0, math.rad(90))
    fireSource.Size = Vector3.new(2.2, 4.8, 2.2)
    fireSource.Color = DARK_BARK
    fireSource.Material = Enum.Material.Wood
    local sourceFlame = orb(
        layer,
        "BlackoutLanternFlame",
        fireSource.Position + Vector3.new(0, 2.7, 0),
        2.1,
        AMBER,
        Enum.Material.Neon
    )
    light(sourceFlame, AMBER, 1.8, 16)
    fireSource:SetAttribute("BlackoutInteraction", "take_fire")
    CollectionService:AddTag(fireSource, runtimeIds.ExpeditionBlackoutTag)
    billboard(fireSource, "BLACKOUT FIRE · CARRY TO LIVING ROOTS", CREAM)
    objectIcon(fireSource, "rootfire", AMBER)

    local interactions = {
        {
            actionText = "TAKE ROOTFIRE",
            holdDuration = 0.45,
            interactionId = runtimeIds.InteractionIds.BlackoutFireSource,
            objectText = "Blackout Lantern",
            target = fireSource,
        },
    }
    local relayNodes = {}
    for _, definition in
        {
            {
                center = assert(centers[3], "Blackout farm relay center is missing"),
                interactionId = runtimeIds.InteractionIds.BlackoutRootFarm,
                label = "FARM ROOT",
                nodeId = "blackout_root_farm",
            },
            {
                center = assert(centers[7], "Blackout mill relay center is missing"),
                interactionId = runtimeIds.InteractionIds.BlackoutRootMill,
                label = "MILL ROOT",
                nodeId = "blackout_root_mill",
            },
            {
                center = assert(centers[10], "Blackout cathedral relay center is missing"),
                interactionId = runtimeIds.InteractionIds.BlackoutRootCathedral,
                label = "CATHEDRAL ROOT",
                nodeId = "blackout_root_cathedral",
            },
        }
    do
        local node = orb(
            layer,
            "BlackoutRelay_" .. definition.label,
            definition.center + Vector3.new(-14, 3.5, -12),
            6,
            Color3.fromRGB(70, 91, 72),
            Enum.Material.SmoothPlastic
        )
        node.Shape = Enum.PartType.Cylinder
        node.CFrame *= CFrame.Angles(0, 0, math.rad(90))
        node.Size = Vector3.new(2.4, 5.8, 2.4)
        node.Color = DARK_BARK
        node.Material = Enum.Material.Wood
        local relayCore = orb(
            layer,
            "BlackoutRelayCore_" .. definition.label,
            node.Position + Vector3.new(0, 3.2, 0),
            1.8,
            FOXFIRE,
            Enum.Material.Neon
        )
        light(relayCore, FOXFIRE, 1.1, 12)
        node:SetAttribute("BlackoutInteraction", "deliver_fire")
        node:SetAttribute("BlackoutNodeId", definition.nodeId)
        CollectionService:AddTag(node, runtimeIds.ExpeditionBlackoutTag)
        billboard(node, definition.label .. " · NEEDS CARRIED FIRE", CREAM)
        objectIcon(node, "livingroot", FOXFIRE)
        relayNodes[definition.nodeId] = node
        table.insert(interactions, {
            actionText = "DELIVER ROOTFIRE",
            holdDuration = 0.7,
            interactionId = definition.interactionId,
            objectText = definition.label,
            target = node,
        })

        for rootIndex = -1, 1 do
            local rootedWall = part(
                layer,
                "RootedWall",
                Vector3.new(3.5, 14 + (rootIndex + 1) * 2, 3.5),
                CFrame.new(node.Position + Vector3.new(rootIndex * 5.5, 5 + (rootIndex + 1), 4.5))
                    * CFrame.Angles(math.rad(rootIndex * 8), 0, math.rad(rootIndex * 10)),
                DARK_BARK,
                Enum.Material.Wood,
                true
            )
            rootedWall:SetAttribute("BlackoutNodeId", definition.nodeId)
        end
    end

    local decisions = {}
    for _, definition in
        {
            {
                color = MEADOW,
                decisionId = "restore_farmland",
                interactionId = runtimeIds.InteractionIds.BlackoutDecisionFarmland,
                label = "RESTORE FARMLAND",
                offset = Vector3.new(-16, 2.5, 16),
            },
            {
                color = Color3.fromRGB(71, 139, 84),
                decisionId = "wild_regrowth",
                interactionId = runtimeIds.InteractionIds.BlackoutDecisionWild,
                label = "ALLOW WILD REGROWTH",
                offset = Vector3.new(0, 2.5, 20),
            },
            {
                color = FOXFIRE,
                decisionId = "shared_agroforest",
                interactionId = runtimeIds.InteractionIds.BlackoutDecisionShared,
                label = "CREATE SHARED AGROFOREST",
                offset = Vector3.new(16, 2.5, 16),
            },
        }
    do
        local seedling = orb(
            layer,
            "GreenwardChoice_" .. definition.decisionId,
            bossCenter + definition.offset,
            5,
            definition.color,
            Enum.Material.SmoothPlastic
        )
        seedling.Transparency = 0.58
        seedling:SetAttribute("BlackoutInteraction", "chapter_decision")
        seedling:SetAttribute("BlackoutDecisionId", definition.decisionId)
        CollectionService:AddTag(seedling, runtimeIds.ExpeditionBlackoutTag)
        billboard(seedling, definition.label, CREAM)
        decisions[definition.decisionId] = seedling
        table.insert(interactions, {
            actionText = "VOTE " .. definition.label,
            holdDuration = 1.1,
            interactionId = definition.interactionId,
            objectText = "Permanent Greenward Choice",
            target = seedling,
        })
    end

    return {
        decisions = decisions,
        fireSource = fireSource,
        interactions = interactions,
        model = layer,
        relayNodes = relayNodes,
    }
end

function BramblewakeBuilder.build(
    parent: Instance,
    manifest: any,
    generator: any,
    catalog: any,
    runtimeIds: any
): any
    local existing = parent:FindFirstChild("BramblewakeExpedition")
    if existing ~= nil then
        existing:Destroy()
    end

    local expedition = Instance.new("Model")
    expedition.Name = "BramblewakeExpedition"
    expedition:SetAttribute("RegionId", manifest.regionId)
    expedition:SetAttribute("ManifestHash", manifest.hash)
    expedition:SetAttribute("Seed", manifest.seed)
    expedition:SetAttribute("Source", manifest.source)
    expedition:SetAttribute("Ready", false)
    expedition.Parent = parent

    local centers: { Vector3 } = {}
    local eventInteractions = {}
    local eventSockets: { [string]: BasePart } = {}
    local eliteArena = nil
    local oldGrowthCenter: Vector3? = nil
    local extractionTarget: BasePart? = nil
    for _, placement in manifest.modules do
        centers[placement.index] = ORIGIN
            + Vector3.new(placement.cellX * catalog.CellSize, 0, placement.cellZ * catalog.CellSize)
    end

    for _, placement in manifest.modules do
        local definition = generator.moduleDefinition(placement.moduleId)
        local center = centers[placement.index]
        local module = Instance.new("Model")
        module.Name = string.format("Module_%02d", placement.index)
        module:SetAttribute("ContentId", placement.moduleId)
        module:SetAttribute("DisplayName", definition.displayName)
        module:SetAttribute("SequenceIndex", placement.index)
        module:SetAttribute("CellX", placement.cellX)
        module:SetAttribute("CellZ", placement.cellZ)
        module.Parent = expedition
        pcall(function()
            module.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
        end)
        CollectionService:AddTag(module, runtimeIds.ExpeditionModuleTag)

        local cell = part(
            module,
            "StreamingCellCollision",
            Vector3.new(catalog.CellSize, 5, catalog.CellSize),
            CFrame.new(center + Vector3.new(0, -2.5, 0)),
            if placement.index % 2 == 0 then GRASS else Color3.fromRGB(43, 72, 49),
            Enum.Material.LeafyGrass
        )
        surfaceGrain(cell, Color3.fromRGB(23, 38, 31), 0.82)
        local clearing = part(
            module,
            "PathClearing",
            Vector3.new(26, 0.55, 26),
            CFrame.new(center + Vector3.new(0, 0.25, 0)),
            WET_EARTH,
            Enum.Material.Mud
        )
        clearing.Reflectance = 0.03
        if placement.index > 1 then
            pathArm(module, center, centers[placement.index - 1])
        end
        if placement.index < #manifest.modules then
            pathArm(module, center, centers[placement.index + 1])
        end

        moduleDressing(module, center, manifest.seed + placement.index * 97, runtimeIds)

        for cornerIndex = 1, 4 do
            local x = if cornerIndex == 1 or cornerIndex == 4 then -27 else 27
            local z = if cornerIndex <= 2 then -27 else 27
            tree(module, center + Vector3.new(x, 0, z), 0.62 + (cornerIndex % 2) * 0.08)
        end
        buildModuleVisual(module, definition.visual, center, runtimeIds)
        if definition.eliteId == "elite_old_growth" then
            oldGrowthCenter = center
            local fireSource = orb(
                module,
                "OldGrowthFireSource",
                center + Vector3.new(-20, 3.4, -12),
                4.2,
                AMBER,
                Enum.Material.SmoothPlastic
            )
            fireSource.Transparency = 0.48
            fireSource:SetAttribute("EliteId", definition.eliteId)
            fireSource:SetAttribute("EliteInteraction", "fire_source")
            billboard(fireSource, "LANTERN FIRE", CREAM)
            objectIcon(fireSource, "rootfire", AMBER)

            local rootHeart = orb(
                module,
                "OldGrowthRootHeart",
                center + Vector3.new(20, 4.2, 12),
                5.2,
                FOXFIRE,
                Enum.Material.SmoothPlastic
            )
            rootHeart.Transparency = 0.56
            rootHeart:SetAttribute("EliteId", definition.eliteId)
            rootHeart:SetAttribute("EliteInteraction", "root_heart")
            billboard(rootHeart, "ROOT HEART", CREAM)
            objectIcon(rootHeart, "root", FOXFIRE)
            CollectionService:AddTag(fireSource, runtimeIds.ExpeditionEliteTag)
            CollectionService:AddTag(rootHeart, runtimeIds.ExpeditionEliteTag)
            eliteArena = {
                center = center,
                fireSource = fireSource,
                rootHeart = rootHeart,
            }
        end
        if definition.role == "extraction" then
            local target = module:FindFirstChild("WayhomeLight")
            assert(
                target ~= nil and target:IsA("BasePart"),
                "Wayhome Gate is missing its extraction target"
            )
            target:SetAttribute("ContentId", placement.moduleId)
            target:SetAttribute("ExtractionId", "extraction_bw_wayhome")
            CollectionService:AddTag(target, runtimeIds.ExpeditionExtractionTag)
            extractionTarget = target
            destinationRing(module, target.Position, AMBER, 7)
        end

        if placement.poiId ~= nil then
            buildPointOfInterest(
                module,
                center,
                generator.pointOfInterestDefinition(placement.poiId),
                runtimeIds
            )
        elseif placement.eventId ~= nil then
            local eventResult = buildEventSocket(
                module,
                center,
                generator.eventDefinition(placement.eventId),
                runtimeIds
            )
            eventSockets[placement.eventId] = eventResult.socket
            for _, interaction in eventResult.interactions do
                table.insert(eventInteractions, interaction)
            end
        end

        if placement.index == 1 then
            local marker = orb(
                module,
                "BramblewakeArrival",
                center + Vector3.new(0, 5, 0),
                4,
                FOXFIRE,
                Enum.Material.Neon
            )
            marker.Transparency = 0.25
            billboard(marker, "BRAMBLEWAKE WOODS", CREAM)
        end
    end

    local bossArena = buildWardenSeal(
        expedition,
        assert(oldGrowthCenter, "Old Growth center is missing"),
        centers,
        catalog.CellSize,
        runtimeIds
    )
    local blackout = buildBlackoutLayer(expedition, centers, bossArena.center, runtimeIds)
    buildBackdrop(expedition, centers)

    local generatedParts = 0
    for _, descendant in expedition:GetDescendants() do
        if descendant:IsA("BasePart") then
            generatedParts += 1
        end
    end
    expedition:SetAttribute("GeneratedPartCount", generatedParts)
    expedition:SetAttribute("ModuleCount", #manifest.modules)
    expedition:SetAttribute("PointOfInterestCount", catalog.PointOfInterestCount)
    expedition:SetAttribute("EventCount", catalog.EventCount)
    expedition:SetAttribute("EventInteractionCount", #eventInteractions)
    expedition:SetAttribute("ExtractionReady", extractionTarget ~= nil)
    expedition:SetAttribute("BossArenaReady", bossArena ~= nil)
    expedition:SetAttribute("BlackoutLayerReady", blackout ~= nil)
    expedition:SetAttribute("Ready", true)

    local moduleCenters = {}
    for index, center in centers do
        table.insert(moduleCenters, {
            index = index,
            moduleId = manifest.modules[index].moduleId,
            position = center,
        })
    end
    return {
        model = expedition,
        entryCFrame = CFrame.new(centers[1] + Vector3.new(0, 5, 0)),
        extractionTarget = assert(extractionTarget, "Bramblewake extraction target is missing"),
        eventInteractions = eventInteractions,
        eventSockets = eventSockets,
        eliteArena = assert(eliteArena, "Old Growth elite arena is missing"),
        bossArena = bossArena,
        blackout = blackout,
        moduleCenters = moduleCenters,
        partCount = generatedParts,
    }
end

return table.freeze(BramblewakeBuilder)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">BramblewakeEnemyBuilder</string>
            <string name="Source"><![CDATA[--!strict

local BramblewakeEnemyBuilder = {}

local function part(
    parent: Model,
    name: string,
    size: Vector3,
    offset: Vector3,
    color: Color3,
    material: Enum.Material,
    shape: Enum.PartType?,
    rotation: CFrame?
): Part
    local item = Instance.new("Part")
    item.Name = name
    item.Size = size
    item.CFrame = CFrame.new(offset) * (rotation or CFrame.identity)
    item.Color = color
    item.Material = material
    item.Anchored = true
    item.CanCollide = false
    item.CanQuery = true
    item.CanTouch = false
    item.CastShadow = true
    item.TopSurface = Enum.SurfaceType.Smooth
    item.BottomSurface = Enum.SurfaceType.Smooth
    item.Shape = shape or Enum.PartType.Block
    item.Parent = parent
    return item
end

local function addEye(parent: Model, offset: Vector3, color: Color3)
    part(
        parent,
        "ReadableEye",
        Vector3.new(0.58, 0.58, 0.34),
        offset,
        color,
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
end

local function rootling(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "RootCore",
        Vector3.new(4.5, 5.4, 3.4),
        origin,
        Color3.fromRGB(48, 38, 31),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "MossCrown",
        Vector3.new(5.4, 2.1, 2.6),
        origin + Vector3.new(0, 3.2, 0),
        Color3.fromRGB(51, 78, 54),
        Enum.Material.Grass,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        part(
            model,
            "RootArm",
            Vector3.new(1.1, 5.5, 1.1),
            origin + Vector3.new(side * 2.5, 0.2, 0),
            Color3.fromRGB(65, 48, 37),
            Enum.Material.Wood,
            nil,
            CFrame.Angles(0, 0, math.rad(side * 28))
        )
        addEye(model, origin + Vector3.new(side * 0.72, 0.8, -1.62), Color3.fromRGB(255, 143, 91))
    end
    return core
end

local function briarback(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BriarbackCore",
        Vector3.new(6.8, 4.2, 7.2),
        origin + Vector3.new(0, 0.4, 0),
        Color3.fromRGB(64, 47, 36),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "FrontShield",
        Vector3.new(7.8, 5.4, 1.1),
        origin + Vector3.new(0, 0.7, -3.4),
        Color3.fromRGB(47, 68, 50),
        Enum.Material.Slate,
        nil,
        CFrame.Angles(math.rad(-8), 0, 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "ShieldTusk",
            Vector3.new(3.3, 0.9, 0.9),
            origin + Vector3.new(side * 2.8, 0.5, -4.5),
            Color3.fromRGB(208, 188, 138),
            Enum.Material.Wood,
            Enum.PartType.Cylinder,
            CFrame.Angles(0, math.rad(90), math.rad(side * 8))
        )
        part(
            model,
            "BriarLeg",
            Vector3.new(1.4, 3.5, 1.4),
            origin + Vector3.new(side * 2.2, -2, 1.6),
            Color3.fromRGB(55, 42, 34),
            Enum.Material.Wood,
            nil,
            CFrame.Angles(0, 0, math.rad(side * 8))
        )
        addEye(model, origin + Vector3.new(side * 1.05, 1.2, -4.02), Color3.fromRGB(255, 196, 99))
    end
    for x = -1, 1, 2 do
        part(
            model,
            "BackThorn",
            Vector3.new(0.8, 3.4, 0.8),
            origin + Vector3.new(x * 1.7, 3, 0.6),
            Color3.fromRGB(97, 72, 43),
            Enum.Material.Wood,
            nil,
            CFrame.Angles(0, 0, math.rad(x * 25))
        )
    end
    return core
end

local function pollenWisp(model: Model, origin: Vector3): Part
    local hoverOrigin = origin + Vector3.new(0, 4.5, 0)
    local core = part(
        model,
        "PollenHeart",
        Vector3.new(3.2, 3.2, 3.2),
        hoverOrigin,
        Color3.fromRGB(255, 211, 91),
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    for index = 1, 6 do
        local angle = (index - 1) * math.pi / 3
        local offset = Vector3.new(math.cos(angle) * 2.7, math.sin(angle) * 2.7, 0.3)
        part(
            model,
            "PollenPetal",
            Vector3.new(2.4, 1.1, 0.7),
            hoverOrigin + offset,
            Color3.fromRGB(231, 181, 83),
            Enum.Material.SmoothPlastic,
            Enum.PartType.Ball,
            CFrame.Angles(0, 0, angle)
        )
    end
    part(
        model,
        "DrowsyTrail",
        Vector3.new(1.5, 4.5, 1.5),
        hoverOrigin + Vector3.new(0, -3.1, 0),
        Color3.fromRGB(120, 163, 105),
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    ).Transparency =
        0.35
    addEye(model, hoverOrigin + Vector3.new(0, 0.3, -1.58), Color3.fromRGB(37, 45, 39))
    return core
end

local function hollowCrow(model: Model, origin: Vector3): Part
    local hoverOrigin = origin + Vector3.new(0, 5, 0)
    local core = part(
        model,
        "HollowCrowCore",
        Vector3.new(3.6, 3.8, 4.5),
        hoverOrigin,
        Color3.fromRGB(31, 35, 42),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        CFrame.Angles(math.rad(-12), 0, 0)
    )
    for side = -1, 1, 2 do
        part(
            model,
            "CrowWing",
            Vector3.new(7.8, 0.65, 3.4),
            hoverOrigin + Vector3.new(side * 4.2, 0.25, 0.5),
            Color3.fromRGB(42, 47, 55),
            Enum.Material.Slate,
            nil,
            CFrame.Angles(0, math.rad(side * 10), math.rad(side * 12))
        )
        addEye(
            model,
            hoverOrigin + Vector3.new(side * 0.72, 0.65, -2.12),
            Color3.fromRGB(126, 211, 194)
        )
    end
    part(
        model,
        "CrowBeak",
        Vector3.new(1.5, 1.1, 3.3),
        hoverOrigin + Vector3.new(0, 0.1, -3.35),
        Color3.fromRGB(183, 154, 83),
        Enum.Material.Wood,
        nil,
        CFrame.Angles(math.rad(-12), 0, 0)
    )
    part(
        model,
        "StolenSpark",
        Vector3.new(1.1, 1.1, 1.1),
        hoverOrigin + Vector3.new(0, -2.2, 0.2),
        Color3.fromRGB(255, 203, 97),
        Enum.Material.Neon,
        Enum.PartType.Ball,
        nil
    )
    return core
end

local function snapvine(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "SnapvineRoot",
        Vector3.new(4.6, 2.2, 4.6),
        origin,
        Color3.fromRGB(59, 46, 35),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "VineStem",
        Vector3.new(6.5, 1.8, 1.8),
        origin + Vector3.new(0, 3.6, 0),
        Color3.fromRGB(57, 91, 53),
        Enum.Material.Grass,
        Enum.PartType.Cylinder,
        CFrame.Angles(0, 0, math.rad(90))
    )
    for side = -1, 1, 2 do
        part(
            model,
            "SnapJaw",
            Vector3.new(5.5, 1.5, 4.2),
            origin + Vector3.new(0, 6.2 + side * 0.9, -0.9),
            if side < 0 then Color3.fromRGB(73, 111, 62) else Color3.fromRGB(91, 126, 65),
            Enum.Material.Grass,
            nil,
            CFrame.Angles(math.rad(side * 15), 0, 0)
        )
        addEye(model, origin + Vector3.new(side * 1.2, 6.4, -3), Color3.fromRGB(255, 116, 82))
        for index = 1, 2 do
            part(
                model,
                "JawThorn",
                Vector3.new(0.55, 1.5, 0.55),
                origin + Vector3.new(side * index * 1.25, 6.1, -3.15),
                Color3.fromRGB(221, 205, 151),
                Enum.Material.Wood,
                nil,
                CFrame.Angles(math.rad(70), 0, math.rad(side * 15))
            )
        end
    end
    return core
end

local function barkRam(model: Model, origin: Vector3): Part
    local core = part(
        model,
        "BarkRamCore",
        Vector3.new(7.5, 5.8, 8.4),
        origin + Vector3.new(0, 0.5, 0),
        Color3.fromRGB(65, 49, 38),
        Enum.Material.Wood,
        Enum.PartType.Ball,
        nil
    )
    part(
        model,
        "RamBrow",
        Vector3.new(6.2, 3.6, 3),
        origin + Vector3.new(0, 1.5, -4.1),
        Color3.fromRGB(54, 70, 50),
        Enum.Material.Slate,
        Enum.PartType.Ball,
        nil
    )
    for side = -1, 1, 2 do
        part(
            model,
            "RamHorn",
            Vector3.new(6.2, 1.5, 1.5),
            origin + Vector3.new(side * 3.2, 2.2, -5.1),
            Color3.fromRGB(219, 195, 139),
            Enum.Material.Wood,
            Enum.PartType.Cylinder,
            CFrame.Angles(0, math.rad(90), math.rad(side * 13))
        )
        for front = -1, 1, 2 do
            part(
                model,
                "RamLeg",
                Vector3.new(1.7, 4.2, 1.7),
                origin + Vector3.new(side * 2.45, -2.6, front * 2.35),
                Color3.fromRGB(57, 43, 34),
                Enum.Material.Wood,
                nil,
                CFrame.Angles(0, 0, math.rad(side * 4))
            )
        end
        addEye(model, origin + Vector3.new(side * 1.15, 1.8, -5.38), Color3.fromRGB(255, 152, 91))
    end
    part(
        model,
        "MossBack",
        Vector3.new(6.5, 1.5, 6),
        origin + Vector3.new(0, 3.5, 0.6),
        Color3.fromRGB(62, 91, 55),
        Enum.Material.Grass,
        Enum.PartType.Ball,
        nil
    )
    return core
end

function BramblewakeEnemyBuilder.build(definition: any, origin: Vector3, target: Vector3): Model
    local model = Instance.new("Model")
    model.Name = definition.displayName:gsub("%s+", "")
    model:SetAttribute("EnemyId", definition.id)
    model:SetAttribute("EnemyDisplayName", definition.displayName)
    model:SetAttribute("EnemyHealth", definition.health)
    model:SetAttribute("EnemyMaxHealth", definition.health)

    local core: Part
    if definition.modelKey == "briarback" then
        core = briarback(model, origin)
    elseif definition.modelKey == "pollen_wisp" then
        core = pollenWisp(model, origin)
    elseif definition.modelKey == "hollow_crow" then
        core = hollowCrow(model, origin)
    elseif definition.modelKey == "snapvine" then
        core = snapvine(model, origin)
    elseif definition.modelKey == "bark_ram" then
        core = barkRam(model, origin)
    else
        core = rootling(model, origin)
    end
    model.PrimaryPart = core

    local highlight = Instance.new("Highlight")
    highlight.Name = "ThreatOutline"
    highlight.FillColor = Color3.fromRGB(80, 29, 29)
    highlight.FillTransparency = 0.76
    highlight.OutlineColor = Color3.fromRGB(255, 143, 91)
    highlight.OutlineTransparency = 0.16
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = model

    local flatTarget = Vector3.new(target.X, core.Position.Y, target.Z)
    if (flatTarget - core.Position).Magnitude > 0.01 then
        model:PivotTo(CFrame.lookAt(core.Position, flatTarget))
    end
    return model
end

return table.freeze(BramblewakeEnemyBuilder)
]]></string>
