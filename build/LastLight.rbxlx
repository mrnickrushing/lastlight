end

function HUDController.setCompactHandler(self: HUDController, callback: (boolean) -> ())
    self._onCompact = callback
end

function HUDController._setSelectedPartySize(self: HUDController, size: number?)
    self._selectedPartySize = size
    for index, button in self._lobbySizeButtons do
        local chosen = index == size
        button.BackgroundColor3 = if chosen
            then Color3.fromRGB(37, 68, 55)
            else Color3.fromRGB(31, 40, 44)
        button.TextColor3 = if chosen then COLORS.amber else COLORS.cream
    end
end

function HUDController.setLobbyDepartHandler(self: HUDController, callback: (number, string) -> ())
    self._onLobbyDepart = callback
    for size, button in self._lobbySizeButtons do
        button.Activated:Connect(function()
            --[[
                The press is two things at once, and it used to be only one.
                Sending the departure request was always here; showing that a
                number was chosen was not, so a press made off the platform --
                which the server correctly refuses -- left the panel looking
                exactly as it had before it. That is the "nothing happens, no
                number is selected" the owner reported twice. The contract row
                one line below has always marked its choice; the size row now
                speaks the same language.
            ]]
            self:_setSelectedPartySize(size)
            local handler = self._onLobbyDepart
            if handler ~= nil then
                handler(size, self._selectedContractId)
            end
        end)
    end
    for contractId, button in self._contractButtons do
        button.Activated:Connect(function()
            self._selectedContractId = contractId
            for otherId, otherButton in self._contractButtons do
                otherButton.BackgroundColor3 = if otherId == contractId
                    then Color3.fromRGB(37, 68, 55)
                    else Color3.fromRGB(31, 40, 44)
            end
        end)
    end
end

-- Mara's last line stays up for a few seconds. Long enough to read at a
-- glance, short enough that it never becomes furniture.
local MARA_LINE_SECONDS = 7

--[[
    Dodge has no button on touch.

    Visibility was being decided in three separate places -- the input-mode
    handler, the combat-state branch, and the main update -- and each one
    re-enabled it, so removing it from any single site never stuck. They all
    ask here now. Dodge itself is untouched and still LeftAlt or gamepad B;
    only the on-screen button is gone, because on a phone it was one more
    thing to find mid-telegraph.
]]
function HUDController._dodgeButtonVisible(self: HUDController): boolean
    if self._inputMode == "touch" then
        return false
    end
    return not self._playerDowned and self._combatContext == true
end

function HUDController._maraLineIsFresh(self: HUDController): boolean
    return self._maraShownAt > 0 and (os.clock() - self._maraShownAt) < MARA_LINE_SECONDS
end

function HUDController._updateLobby(self: HUDController, state: any)
    local lobby = state.lobby
    if type(lobby) ~= "table" or state.departed == true then
        self._lobbyFrame.Visible = false
        return
    end
    -- The departure panel is a control for the platform in front of you, not
    -- a HUD fixture. `departed` only flips for players who leave through the
    -- platform, so anyone who walks out of the yard another way carried this
    -- panel through the tutorial, the night defense, and the entire
    -- expedition. Show it only within sight of the platform it operates.
    local platform = self._departurePlatformPart
    if platform == nil or platform.Parent == nil then
        platform = workspace:FindFirstChild("DeparturePlatform", true)
        self._departurePlatformPart = platform
    end
    --[[
        The distance gate works from the platform's POSITION, not the
        instance: under streaming, walking far enough from the lodge
        unloads the platform on this client, and a nil instance used to
        fail the gate open -- the panel followed the player across the
        whole town once the lodge streamed out, which is the exact
        carried-panel bug the gate was added to end. A position survives
        streaming; it is cached the first time the platform is seen and
        the platform never moves.
    ]]
    if platform ~= nil and platform:IsA("BasePart") then
        self._departurePlatformPosition = platform.Position
    end
    local platformPosition = self._departurePlatformPosition
    local character = game:GetService("Players").LocalPlayer.Character
    local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
    if platformPosition ~= nil and root ~= nil and root:IsA("BasePart") then
        local offset = root.Position - platformPosition
        if Vector3.new(offset.X, 0, offset.Z).Magnitude > 46 then
            self._lobbyFrame.Visible = false
            return
        end
    end
    self._lobbyFrame.Visible = true
    if lobby.counting then
        self._lobbyTitle.Text = string.format("DEPARTING IN %d", lobby.secondsRemaining)
        self._lobbyDetail.Text =
            string.format("%d ON THE PLATFORM * PARTY OF %d", lobby.readyCount, lobby.partySize)
        self._lobbySizes.Visible = false
    else
        self._lobbyTitle.Text = "DEPARTURE"
        local chosen = self._selectedPartySize
        self._lobbyDetail.Text = if chosen ~= nil and lobby.readyCount <= 0
            then string.format("PARTY OF %d * STAND ON THE PLATFORM", chosen)
            elseif chosen ~= nil then string.format(
                "%d ON THE PLATFORM * PARTY OF %d",
                lobby.readyCount,
                chosen
            )
            elseif lobby.readyCount > 0 then string.format(
                "%d ON THE PLATFORM * CHOOSE PARTY SIZE",
                lobby.readyCount
            )
            else "STAND ON THE PLATFORM TO DEPART"
        self._lobbySizes.Visible = true
        local maximum = if type(lobby.maxPartySize) == "number" then lobby.maxPartySize else 8
        for size, button in self._lobbySizeButtons do
            button.Visible = size <= maximum
        end
    end
end

function HUDController.setLoadoutHandlers(
    self: HUDController,
    onSave: (number) -> (),
    onApply: (number) -> ()
)
    for slot = 1, 3 do
        self._loadoutButtons["save_" .. slot].Activated:Connect(function()
            onSave(slot)
        end)
        self._loadoutButtons["apply_" .. slot].Activated:Connect(function()
            onApply(slot)
        end)
    end
end

function HUDController.setProfessionHandler(self: HUDController, callback: (string) -> ())
    self._onProfessionSelected = callback
end

function HUDController.setProfessionMenuOpen(self: HUDController, open: boolean)
    local shouldOpen = open and self._professionSwitchable and not self._playerDowned
    self._professionMenuOpen = shouldOpen
    self._professionOverlay.Visible = shouldOpen
    if shouldOpen then
        local profession = if self._currentState == nil then nil else self._currentState.profession
        local selectedId = if type(profession) == "table" then profession.selectedId else nil
        local selectedCard = if type(selectedId) == "string"
            then self._professionCards[selectedId]
            else nil
        if selectedCard == nil then
            local firstId = self._professionOrder[1]
            selectedCard = if firstId == nil then nil else self._professionCards[firstId]
        end
        if selectedCard ~= nil then
            GuiService.SelectedObject = selectedCard
        end
    elseif
        GuiService.SelectedObject ~= nil
        and GuiService.SelectedObject:IsDescendantOf(self._professionPanel)
    then
        GuiService.SelectedObject = nil
    end
end

function HUDController.toggleProfessionMenu(self: HUDController)
    self:setProfessionMenuOpen(not self._professionMenuOpen)
end

function HUDController.isProfessionMenuOpen(self: HUDController): boolean
    return self._professionMenuOpen
end

function HUDController.setInputMode(self: HUDController, mode: string)
    self._inputMode = mode
    self._sprint.Visible = mode == "touch" and not self._playerDowned
    self._dodge.Visible = self:_dodgeButtonVisible()
    self:setInteraction(self._interactionLabel, self._interactionAvailable)
    self._tool.Text = if mode == "keyboard"
        then "CLICK\nSTRIKE"
        elseif mode == "gamepad" then "RT\nSTRIKE"
        else "STRIKE"
    self:_updateCombatClock()
    self:_updateProfessionClock()
end

function HUDController._updateCombatClock(self: HUDController)
    local state = self._currentState
    if state == nil then
        return
    end
    local combat = state.combat
    if type(combat) ~= "table" then
        self._staminaFrame.Visible = false
        self._dodge.Visible = self:_dodgeButtonVisible()
        return
    end

    local now = workspace:GetServerTimeNow()
    local stamina = math.max(0, tonumber(combat.stamina) or 0)
    local maxStamina = math.max(1, tonumber(combat.maxStamina) or 100)
    local dodgeCost = math.max(1, tonumber(combat.dodgeCost) or 35)
    local dodgeReadyAt = tonumber(combat.dodgeReadyAt) or 0
    local dodgeActiveUntil = tonumber(combat.dodgeActiveUntil) or 0
    local drowsyUntil = tonumber(combat.drowsyUntil) or 0
    local rootedUntil = tonumber(combat.rootedUntil) or 0
    local cooldownRemaining = math.max(0, dodgeReadyAt - now)
    local drowsyRemaining = math.max(0, drowsyUntil - now)
    local drowsy = combat.drowsy == true and drowsyRemaining > 0
    local rootedRemaining = math.max(0, rootedUntil - now)
    local rooted = combat.rooted == true and rootedRemaining > 0
    local combatEnabled = combat.enabled ~= false
    local dodgeActive = combatEnabled and now < dodgeActiveUntil
    local ready = combatEnabled
        and not self._playerDowned
        and cooldownRemaining <= 0
        and stamina >= dodgeCost

    self._staminaFill.Size = UDim2.new(math.clamp(stamina / maxStamina, 0, 1), -8, 1, -8)
    self._staminaFill.BackgroundColor3 = if rooted
        then COLORS.amber
        elseif drowsy then COLORS.amber
        elseif stamina < dodgeCost then COLORS.danger
        elseif stamina < maxStamina * 0.55 then COLORS.amber
        else COLORS.blue
    self._staminaText.Text = if rooted
        then string.format("ROOTED %.1fs · STAMINA %d", rootedRemaining, stamina)
        elseif drowsy then string.format(
            "DROWSY %.1fs · STAMINA %d",
            drowsyRemaining,
            stamina
        )
        elseif stamina < dodgeCost then string.format("LOW STAMINA · %d", stamina)
        else string.format("STAMINA · %d", stamina)
    self._staminaText.TextColor3 = if rooted
            or drowsy
            or stamina < maxStamina * 0.45
        then COLORS.cream
        else COLORS.ink
    self._staminaFrame.Visible = not self._playerDowned
        and (
            self._combatContext
            or rooted
            or drowsy
            or stamina < maxStamina
            or cooldownRemaining > 0
        )

    self._dodge.Active = ready
    self._dodge.AutoButtonColor = ready
    self._dodge.BackgroundColor3 = if dodgeActive
        then COLORS.green
        elseif ready then COLORS.panel
        else Color3.fromRGB(42, 48, 45)
    self._dodge.TextColor3 = if ready or dodgeActive then COLORS.cream else COLORS.muted
    local prefix = if self._inputMode == "keyboard"
        then "ALT\n"
        elseif self._inputMode == "gamepad" then "B\n"
        else ""
    self._dodge.Text = if dodgeActive
        then "DODGE\nACTIVE"
        elseif not combatEnabled then "DODGE\nOFF"
        elseif cooldownRemaining > 0 then string.format("DODGE\n%.1fs", cooldownRemaining)
        elseif stamina < dodgeCost then "DODGE\nLOW"
        else prefix .. "DODGE"
end

function HUDController._updateProfessionClock(self: HUDController)
    local state = self._currentState
    if state == nil then
        return
    end
    --[[
        The hound's order button follows the hound, not the profession: a
        keeper standing in town has one, a keeper mid-expedition does not,
        and the server is the one that knows which.
    ]]
    local companion = state.companion
    local hasCompanion = type(companion) == "table" and companion.present == true
    self._companion.Visible = hasCompanion
    if hasCompanion then
        self._companionMode = if companion.mode == "stay" then "stay" else "follow"
        -- the button names the order it will give, not the state it is in
        self._companion.Text = if self._companionMode == "follow" then "STAY" else "FOLLOW"
    end

    local profession = state.profession
    if type(profession) ~= "table" or profession.enabled == false then
        self._professionButton.Visible = false
        self._ability.Visible = false
        self:setProfessionMenuOpen(false)
        return
    end

    local selectedId = if type(profession.selectedId) == "string"
        then profession.selectedId
        else nil
    local displayName = if type(profession.displayName) == "string"
        then profession.displayName
        else nil
    self._professionSwitchable = profession.switchable == true
    self._professionButton.Visible = state.tutorialComplete == true
    self._professionButton.Active = self._professionSwitchable
    self._professionButton.AutoButtonColor = self._professionSwitchable
    self._professionButton.BackgroundColor3 = if self._professionSwitchable
        then COLORS.panel
        else Color3.fromRGB(42, 48, 45)
    self._professionButton.TextColor3 = if self._professionSwitchable
        then COLORS.amber
        else COLORS.muted
    -- "Profession", not "kit": kit is reserved for the purchasable
    -- character kits (docs/CHARACTER_KITS_SPEC.md), and selling one word
    -- while the HUD uses it for a free system would be a bait.
    self._professionButton.Text = if displayName == nil
        then "PROFESSION"
        else "ROLE · " .. displayName

    for professionId, card in self._professionCards do
        local selected = professionId == selectedId
        local baseText = tostring(card:GetAttribute("BaseText") or "")
        card.Text = if selected then "✓ EQUIPPED\n" .. baseText else baseText
        card.BackgroundColor3 = if selected then Color3.fromRGB(37, 68, 55) else COLORS.panelSoft
        card.TextColor3 = if selected then COLORS.cream else COLORS.muted
        local cardStroke = card:FindFirstChildOfClass("UIStroke")
        if cardStroke ~= nil then
            cardStroke.Color = if selected then COLORS.amber else COLORS.cream
            cardStroke.Transparency = if selected then 0.08 else 0.7
            cardStroke.Thickness = if selected then 2.5 else 1.5
        end
    end

    if not self._professionSwitchable and self._professionMenuOpen then
        self:setProfessionMenuOpen(false)
    end
    if selectedId == nil then
        self._ability.Visible = false
        return
    end

    local now = workspace:GetServerTimeNow()
    local readyAt = tonumber(profession.cooldownReadyAt) or 0
    local activeUntil = tonumber(profession.activeUntil) or 0
    local remaining = math.max(0, readyAt - now)
    local active = now < activeUntil
    local ready = profession.enabled ~= false and not self._playerDowned and remaining <= 0
    local abilityName = string.upper(tostring(profession.abilityName or "ABILITY"))
    local compactAbilityName = string.gsub(abilityName, " ", "\n", 1)
    local prefix = if self._inputMode == "keyboard"
        then "Q\n"
        elseif self._inputMode == "gamepad" then "L1\n"
        else ""

    self._ability.Visible = not self._playerDowned
    self._ability.Active = ready
    self._ability.AutoButtonColor = ready
    self._ability.BackgroundColor3 = if active
        then COLORS.green
        elseif ready then COLORS.panel
        else Color3.fromRGB(42, 48, 45)
    self._ability.TextColor3 = if ready or active then COLORS.cream else COLORS.muted
    self._ability.Text = if active
        then string.format("%s\n%.1fs", compactAbilityName, math.max(0, activeUntil - now))
        elseif remaining > 0 then string.format("%s\n%.1fs", compactAbilityName, remaining)
        else prefix .. compactAbilityName
end

-- Each craftable item gets its own fixed button rather than a picker, the
-- same one-button-one-outcome choice the crafting benches themselves use;
-- a button simply disappears once its item count reaches zero.
function HUDController._updateGear(self: HUDController)
    local state = self._currentState
    local gear = if type(state) == "table" and type(state.gear) == "table" then state.gear else nil
    local tutorialComplete = type(state) == "table" and state.tutorialComplete == true
    local charmCount = if gear ~= nil then tonumber(gear.gear_amber_charm) or 0 else 0
    local satchelCount = if gear ~= nil then tonumber(gear.gear_meadow_satchel) or 0 else 0

    self._useCharm.Visible = tutorialComplete and not self._playerDowned and charmCount > 0
    self._useCharm.Text = string.format("CHARM ×%d", charmCount)
    self._useSatchel.Visible = tutorialComplete and not self._playerDowned and satchelCount > 0
    self._useSatchel.Text = string.format("SATCHEL ×%d", satchelCount)
end

function HUDController._updateProgress(self: HUDController)
    local state = self._currentState
    if type(state) ~= "table" then
        self._progressButton.Visible = false
        return
    end
    local complete = state.tutorialComplete == true
    self._progressButton.Visible = complete and not self._playerDowned
    --[[
        The Field Book reads like a book now, not a debug dump: amber section
        headers with rules under them, muted secondary detail, and empty
        sections that say something human. Everything stays one RichText
        label, so the change is presentation only. escape() guards the angle
        brackets because entry text flows into markup.
    ]]
    local function escape(text: string): string
        return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
    end
    local function header(title: string): string
        return string.format(
            '<font color="#FFBA5C"><b>%s</b></font>\n<font color="#8A7A62">━━━━━━━━━━━━━━━━━━</font>',
            escape(title)
        )
    end
    local function muted(text: string): string
        return string.format('<font color="#B8A88F">%s</font>', escape(text))
    end
    local lines = { header("RECIPES") }
    if #(state.recipes or {}) == 0 then
        table.insert(lines, muted("Nothing learned yet — find a workbench."))
    end
    for _, recipe in state.recipes or {} do
        local materials = {}
        for materialId, amount in recipe.materials do
            table.insert(
                materials,
                string.format("%s ×%d", string.gsub(materialId, "material_", ""), amount)
            )
        end
        table.insert(
            lines,
            string.format(
                "• %s  %s",
                escape(recipe.displayName),
                muted(table.concat(materials, ", "))
            )
        )
    end
    table.insert(lines, "")
    table.insert(lines, header("QUESTS"))
    if #(state.quests or {}) == 0 then
        table.insert(lines, muted("No open quests."))
    end
    for _, quest in state.quests or {} do
        local status = if quest.claimed
            then "CLAIMED"
            else string.format("%d/%d", quest.progress, quest.threshold)
        table.insert(lines, string.format("• %s  ·  %s", escape(quest.displayName), status))
    end
    --[[
        The Memory Archive.

        Missing fragments are listed by the place that holds them rather than
        hidden behind a blank, because the pull this system is for is "there
        is more to know and I know where to look" -- not a checklist with the
        labels torn off. Recovered ones show their text, so the archive is
        where the chapter can actually be read back.
    ]]
    local archive = state.memoryArchive
    if type(archive) == "table" then
        table.insert(lines, "")
        table.insert(
            lines,
            header(
                string.format(
                    "MEMORY ARCHIVE · %d / %d RECOVERED",
                    tonumber(archive.found) or 0,
                    tonumber(archive.total) or 0
                )
            )
        )
        for _, entry in archive.entries or {} do
            if entry.recovered then
                table.insert(lines, string.format("• <b>%s</b>", escape(tostring(entry.title))))
                table.insert(lines, muted("    " .. tostring(entry.body)))
            else
                table.insert(
                    lines,
                    muted(string.format("• unfound · %s", string.upper(tostring(entry.foundAt))))
                )
            end
        end
    end
    local residentLife = state.residentLife
    if type(residentLife) == "table" and type(residentLife.residents) == "table" then
        table.insert(lines, "")
        table.insert(lines, header("RESIDENTS"))
        local townHost = state.townHost
        if type(townHost) == "table" and townHost.role == "visitor" then
            table.insert(
                lines,
                muted(
                    string.format(
                        "You are a guest in %s's Emberhollow — your help carries, your damage doesn't.",
                        tostring(townHost.hostName or "a founder")
                    )
                )
            )
        end
        if type(residentLife.crisis) == "table" then
            table.insert(
                lines,
                string.format(
                    '<font color="#FF8A5C"><b>%s</b></font>  ·  %s',
                    escape(tostring(residentLife.crisis.title)),
                    muted(tostring(residentLife.crisis.detail))
                )
            )
        end
        for _, resident in residentLife.residents do
            if resident.present then
                local name = string.upper(
                    (string.gsub(string.gsub(tostring(resident.residentId), "npc_", ""), "_", " "))
                )
                local status = if resident.injured then "RESTING — check on them" else "working"
                table.insert(
                    lines,
                    string.format(
                        "• %s  ·  %s  ·  %s  ·  %s",
                        escape(name),
                        escape(tostring(resident.title)),
                        muted(status),
                        muted(
                            string.format("%s · %d", tostring(resident.bondTitle), resident.bond)
                        )
                    )
                )
            end
        end
    end
    local decorations = state.decorations
    if type(decorations) == "table" and (tonumber(decorations.cap) or 0) > 0 then
        table.insert(
            lines,
            muted(
                string.format(
                    "Decorations placed · %d / %d — marked spots around town take materials.",
                    tonumber(decorations.count) or 0,
                    tonumber(decorations.cap) or 0
                )
            )
        )
    end
    table.insert(lines, "")
    table.insert(lines, header("PROFESSION MASTERY"))
    for professionId, mastery in state.mastery or {} do
        table.insert(
            lines,
            string.format(
                "• %s  ·  RANK %d  ·  %s",
                string.upper(string.gsub(professionId, "profession_", "")),
                mastery.level,
                muted(string.format("%d XP", mastery.xp))
            )
        )
    end
    local equipped = state.equipped or {}
    table.insert(lines, "")
    table.insert(lines, header("LOADOUT"))
    if equipped.head == nil and equipped.feet == nil then
        table.insert(lines, muted("Nothing equipped yet — craft gear at the workbenches."))
    else
        table.insert(
            lines,
            string.format(
                "• HEAD  ·  %s\n• FEET  ·  %s",
                escape(tostring(equipped.head or "empty")),
                escape(tostring(equipped.feet or "empty"))
            )
        )
    end
    self._progressText.Text = table.concat(lines, "\n")
    local gear = state.gear or {}
    local care = if type(state.gearCare) == "table" then state.gearCare else {}
    for itemId, button in self._equipmentButtons do
        local count = tonumber(gear[itemId]) or 0
        button.Visible = self._progressOverlay.Visible and count > 0
        local label =
            string.format("%s ×%d", tostring(button:GetAttribute("BaseLabel") or "EQUIP"), count)
        local note = care[itemId]
        if type(note) == "table" then
            if type(note.trait) == "string" then
                label ..= " · " .. note.trait
            end
            if note.condition == "worn" then
                label ..= " · WORN"
            elseif note.condition == "failing" then
                label ..= " · FAILING"
            end
        end
        button.Text = label
    end
    local whetTarget = state.whetTarget
    if type(whetTarget) == "table" and type(whetTarget.itemId) == "string" then
        self._whetItemId = whetTarget.itemId
        self._whetButton.Text = tostring(whetTarget.label or "WHET")
        self._whetButton.Visible = self._progressOverlay.Visible
    else
        self._whetItemId = nil
        self._whetButton.Visible = false
    end
end

function HUDController.setInteraction(self: HUDController, label: string?, available: boolean)
    self._interactionLabel = label
    self._interactionAvailable = available
    if self._playerDowned then
        self._primary.Active = false
        self._primary.AutoButtonColor = false
        self._primary.BackgroundColor3 = Color3.fromRGB(42, 48, 45)
        self._primary.TextColor3 = COLORS.muted
        self._primary.Text = "DOWNED"
        return
    end
    self._primary.Active = available
    self._primary.AutoButtonColor = available
    self._primary.BackgroundColor3 = if available then COLORS.panel else Color3.fromRGB(42, 48, 45)
    self._primary.TextColor3 = if available then COLORS.cream else COLORS.muted
    local prefix = if self._inputMode == "keyboard"
        then "E · "
        elseif self._inputMode == "gamepad" then "X · "
        else ""
    self._primary.Text = if available and label ~= nil then prefix .. label else "FIND"
end

function HUDController.canInteractAction(self: HUDController, actionId: string): boolean
    local state = self._currentState
    if type(state) ~= "table" then
        return false
    end
    local stage = state.stage
    if stage == "complete" then
        return true
    end
    if stage == "arrive" then
        return actionId == "rescue"
    elseif stage == "gather" then
        return actionId == "gather"
    elseif stage == "choose_tool" then
        return actionId == "choose_tool"
    elseif stage == "build" then
        return actionId == "build"
    elseif stage == "prepare" then
        return actionId == "prepare"
    elseif stage == "reveal" then
        return actionId == "reveal"
    end
    -- During defense, revive and encounter interactions remain valid while
    -- the tutorial is advanced by the server's phase system.
    return actionId ~= "rescue"
        and actionId ~= "gather"
        and actionId ~= "choose_tool"
        and actionId ~= "build"
        and actionId ~= "prepare"
        and actionId ~= "reveal"
end

function HUDController._applyCompact(self: HUDController)
    self._detail.Visible = not self._compactEnabled
    self._mara.Visible = self:_maraLineIsFresh()
        and not self._compactEnabled
        and not self._playerDowned
    self._objective.Position = if self._compactEnabled
        then UDim2.fromOffset(14, 31)
        else UDim2.fromOffset(14, 32)
    self._compact.TextColor3 = if self._compactEnabled then COLORS.amber else COLORS.muted
    self:_layout()
end

function HUDController._layout(self: HUDController)
    local camera = workspace.CurrentCamera
    local viewport = if camera == nil then Vector2.new(1280, 720) else camera.ViewportSize
    --[[
        Treat any touch device, and any short viewport, as the touch layout.

        Deciding on width alone put a landscape phone -- wide but only ~430
        points tall -- on the desktop layout, which tucks the objective panel
        into the top-left corner that Roblox's own menu, chat, and microphone
        buttons already occupy.
    ]]
    local narrow = viewport.X < 700 or viewport.Y < 560 or UserInputService.TouchEnabled
    local scale = math.clamp(math.min(viewport.X, viewport.Y) / 720, 0.78, 1)
    self._scale.Scale = scale
    self._canvas.Size = UDim2.fromScale(1 / scale, 1 / scale)

    if narrow then
        self._objectiveFrame.Position = UDim2.fromOffset(18, 70)
        self._objectiveFrame.Size = UDim2.fromOffset(470, if self._compactEnabled then 78 else 112)
        self._resource.Position = UDim2.fromOffset(18, if self._compactEnabled then 158 else 218)
        self._compact.Size = UDim2.fromOffset(44, 38)
        self._compact.Text = if self._compactEnabled then "+" else "−"
        --[[
            Keep the middle of a phone screen clear.

            These rails used to start at 212 and chain down to 434, which on a
            ~640-point phone viewport is the exact band the creature you are
            trying to tap stands in -- the owner's report was that the fight
            UI hid the monsters. They now begin just under the objective card
            and stay in the top third, so the play area below them belongs to
            the world.
        ]]
        self._lanternFrame.Position = UDim2.new(0.5, 0, 0, 150)
        -- Tucked under the objective panel on the left rather than spanning
        -- the screen at eye level. At full width it sat straight across the
        -- middle of the view for the whole nine minutes of a Blackout.
        self._blackoutFrame.Position = UDim2.fromOffset(18, 196)
        self._blackoutFrame.Size = UDim2.fromOffset(470, 70)
        self._blackoutFrame.AnchorPoint = Vector2.new(0, 0)
        self._eliteFrame.Position =
            UDim2.new(0.5, 0, 0, if self._blackoutFrame.Visible then 222 else 150)
        self._eliteFrame.Size = UDim2.new(1, -36, 0, 64)
        self._allyFrame.Position = UDim2.new(
            0.5,
            0,
            0,
            if self._eliteFrame.Visible
                then (if self._blackoutFrame.Visible then 292 else 220)
                elseif self._blackoutFrame.Visible then 222
                elseif self._lanternFrame.Visible then 192
                else 150
        )
        self._allyFrame.Size = UDim2.new(1, -36, 0, 58)
        --[[
            Bottom-anchored on touch, not stacked under the objective rails:
            with the Blackout and elite rails both up, the old chain pushed
            the red telegraph banner to y=292+, which on a tablet is the
            middle of the fight -- the owner's screenshot had it lying
            across the Old Growth's trunk. The band above the action row is
            dead space on touch, and a warning about your feet belongs near
            them.
        ]]
        self._threatFrame.AnchorPoint = Vector2.new(0.5, 1)
        self._threatFrame.Position = UDim2.new(0.5, 0, 1, -206)
        self._threatFrame.Size = UDim2.new(1, -36, 0, 60)
        self._downedFrame.Size = UDim2.new(1, -36, 0, 90)
        local professionY = if self._compactEnabled then 158 else 218
        self._professionButton.Position = UDim2.new(1, -18, 0, professionY)
        self._useCharm.Position = UDim2.new(1, -18, 0, professionY + 46)
        self._useSatchel.Position = UDim2.new(1, -18, 0, professionY + 92)
        self._professionPanel.Size = UDim2.new(1, -24, 0, 440)
        --[[
            Thumb cluster, bottom-right, stacked in two rows.

            Laid out in one row these ran far enough across the screen to sit
            over the character and the ground the player is aiming at. The
            primary action keeps the corner; strike, dodge, and ability sit
            inboard and one row up, which keeps every control inside a right
            thumb's reach without any of them covering the play area. Run stays
            on the left, clear of Roblox's own thumbstick.
        ]]
        --[[
            One bottom row, inset from BOTH corners.

            Roblox owns the bottom corners on touch: the thumbstick sits
            bottom-left and the jump button bottom-right. Putting the primary
            action in the bottom-right corner stacked it directly on top of
            jump. The row starts well inboard of jump and ends well inboard of
            the thumbstick, so every control is thumb-reachable without
            fighting a Roblox one, and none of them sit over the character.
        ]]
        -- Run sits immediately left of Roblox's jump button, where a right
        -- thumb already is. Ability keeps the next slot along. Dodge is gone
        -- on touch: it is still LeftAlt on a keyboard, but as a button it was
        -- one more thing to find mid-telegraph on a small screen.
        -- Clear of Roblox's jump button, which owns roughly the rightmost 200
        -- points. The canvas is scaled by 0.78, so these offsets shrink by
        -- that much on screen -- -170 looked clear here and landed on top of
        -- jump on the device.
        -- Run sits hard against Roblox's jump button on the right, where the
        -- owner asked for it: the thumb that jumps is the thumb that sprints.
        -- Everything else steps further inboard from there.
        self._sprint.Position = UDim2.new(1, -212, 1, -150)
        self._ability.Position = UDim2.new(1, -300, 1, -34)
        self._primary.Position = UDim2.new(1, -410, 1, -34)
        self._tool.Position = UDim2.new(1, -520, 1, -34)
        self._dodge.Position = UDim2.new(1, -630, 1, -34)
    else
        self._objectiveFrame.Position = UDim2.fromOffset(18, 18)
        self._objectiveFrame.Size = if self._compactEnabled
            then UDim2.fromOffset(284, 76)
            else UDim2.fromOffset(326, 132)
        self._resource.Position = UDim2.fromOffset(18, 164)
        self._compact.Size = UDim2.fromOffset(118, 38)
        self._compact.Text = if self._compactEnabled then "EXPAND" else "COMPACT"
        self._lanternFrame.Position = UDim2.new(0.5, 0, 0, 66)
        self._blackoutFrame.Position = UDim2.new(0.5, 0, 0, 66)
        self._blackoutFrame.Size = UDim2.fromOffset(420, 64)
        self._eliteFrame.Position =
            UDim2.new(0.5, 0, 0, if self._blackoutFrame.Visible then 138 else 66)
        self._eliteFrame.Size = UDim2.fromOffset(420, 70)
        self._allyFrame.Position = UDim2.new(
            0.5,
            0,
            0,
            if self._eliteFrame.Visible
                then (if self._blackoutFrame.Visible then 216 else 144)
                elseif self._blackoutFrame.Visible then 138
                elseif self._lanternFrame.Visible then 108
                else 66
        )
        self._allyFrame.Size = UDim2.fromOffset(330, 64)
        self._threatFrame.AnchorPoint = Vector2.new(0.5, 0)
        self._threatFrame.Position = UDim2.fromScale(0.5, 0.32)
        self._threatFrame.Size = UDim2.fromOffset(330, 66)
        self._downedFrame.Size = UDim2.fromOffset(540, 90)
        self._professionButton.Position = UDim2.new(1, -18, 0, 64)
        self._useCharm.Position = UDim2.new(1, -18, 0, 110)
        self._useSatchel.Position = UDim2.new(1, -18, 0, 156)
        self._professionPanel.Size = UDim2.fromOffset(640, 440)
        self._ability.Position = UDim2.new(1, -346, 1, -40)
    end
end

function HUDController._presentPhase(self: HUDController, phase: string)
    local accent = if phase == "DUSK"
        then Color3.fromRGB(255, 164, 91)
        elseif phase == "NIGHT" then Color3.fromRGB(174, 211, 255)
        elseif phase == "REVEAL" then Color3.fromRGB(172, 255, 205)
        else COLORS.amber

    self._phase.TextColor3 = accent
    local phaseStroke = self._phaseFrame:FindFirstChildOfClass("UIStroke")
    if phaseStroke ~= nil then
        phaseStroke.Color = accent
    end

    local scale = self._phaseFrame:FindFirstChild("PhasePulse")
    if scale == nil then
        scale = Instance.new("UIScale")
        scale.Name = "PhasePulse"
        scale.Parent = self._phaseFrame
    end
    if scale:IsA("UIScale") then
        scale.Scale = 1.06
        TweenService:Create(
            scale,
            TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Scale = 1 }
        ):Play()
    end
    self._phase.TextTransparency = 0.22
    TweenService:Create(
        self._phase,
        TweenInfo.new(0.34, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { TextTransparency = 0 }
    ):Play()
end

function HUDController._updateClock(self: HUDController)
    local state = self._currentState
    if state == nil then
        return
    end

    local phase = string.upper(tostring(state.phase or "day"))
    if phase ~= self._lastPhase then
        self._lastPhase = phase
        self:_presentPhase(phase)
    end
    local phaseEndsAt = tonumber(state.phaseEndsAt) or 0
    local blackout = state.blackout
    local blackoutVisible = type(blackout) == "table"
        and blackout.status ~= "dormant"
        and blackout.status ~= "disabled"
        and not self._playerDowned
    local clockText: string
    if blackoutVisible and blackout.status ~= "complete" then
        local targetEndsAt = tonumber(blackout.targetEndsAt) or 0
        local remaining = math.max(0, math.ceil(targetEndsAt - workspace:GetServerTimeNow()))
        clockText = if remaining > 0
            then string.format("BLACKOUT · %02d:%02d", math.floor(remaining / 60), remaining % 60)
            else "BLACKOUT · OVERTIME"
    elseif blackoutVisible then
        clockText = "DAWN · CHAPTER I"
    elseif phaseEndsAt > 0 then
        local remaining = math.max(0, math.ceil(phaseEndsAt - workspace:GetServerTimeNow()))
        -- "LEFT" because "DAY · 02:58" reads as three in the morning, not as
        -- a countdown. Two glyphs of clarity beat two glyphs of mystery.
        clockText =
            string.format("%s · %02d:%02d LEFT", phase, math.floor(remaining / 60), remaining % 60)
    else
        clockText = if phase == "REVEAL" then "DAWN · FIRST LIGHT" else phase .. " · MORNING"
    end
    if self._phase.Text ~= clockText then
        self._phase.Text = clockText
    end
    self:_updateCombatClock()
    self:_updateProfessionClock()

    if blackoutVisible then
        local duration = math.max(1, tonumber(blackout.duration) or 1)
        local targetEndsAt = tonumber(blackout.targetEndsAt) or 0
        local startedAt = targetEndsAt - duration
        local elapsed = if targetEndsAt <= 0
            then tonumber(blackout.elapsed) or 0
            else math.max(0, workspace:GetServerTimeNow() - startedAt)
        self._blackoutFill.Size = UDim2.fromScale(math.clamp(elapsed / duration, 0, 1), 1)
        self._blackoutFill.BackgroundColor3 = if blackout.status == "complete"
            then COLORS.green
            elseif blackout.overtime then COLORS.danger
            else COLORS.blue
        self._blackoutTitle.Text = string.format(
            "BRAMBLEWAKE BLACKOUT · %s · %d/%d",
            tostring(blackout.stageLabel or "STAGE"),
            tonumber(blackout.stage) or 0,
            tonumber(blackout.stageCount) or 4
        )
        if blackout.status == "relay" then
            if blackout.carryingFire then
                local fireRemaining = math.max(
                    0,
                    (tonumber(blackout.fireExpiresAt) or 0) - workspace:GetServerTimeNow()
                )
                self._blackoutDetail.Text = string.format(
                    "CARRY ROOTFIRE %.1fs → %s · %d/%d",
                    fireRemaining,
                    tostring(blackout.nextNodeLabel or "NEXT ROOT"),
                    tonumber(blackout.deliveredNodes) or 0,
                    tonumber(blackout.relayRequired) or 3
                )
            else
                self._blackoutDetail.Text = string.format(
                    "TAKE ROOTFIRE → %s · %d/%d",
                    tostring(blackout.nextNodeLabel or "NEXT ROOT"),
                    tonumber(blackout.deliveredNodes) or 0,
                    tonumber(blackout.relayRequired) or 3
                )
            end
        elseif blackout.status == "old_growth" then
            self._blackoutDetail.Text = "ROOTED WALLS · CLEANSE OLD GROWTH"
        elseif blackout.status == "warden" then
            self._blackoutDetail.Text = "WARDEN'S SEAL · CLEANSE OR BREAK ANTLERS"
        elseif blackout.status == "resolution" then
            self._blackoutDetail.Text = if blackout.vote == nil
                then "VOTE: FARMLAND · WILD · SHARED AGROFOREST"
                else "VOTE RECORDED · WAITING FOR ACTIVE TRAVELERS"
        else
            local decision = string.upper(
                (string.gsub(tostring(blackout.decision or "chapter resolved"), "_", " "))
            )
            local outcome = string.upper(tostring(blackout.wardenOutcome or "remembered"))
            self._blackoutDetail.Text = decision .. " · FOREST " .. outcome
        end
        self._blackoutDetail.TextColor3 = if blackout.status == "complete"
            then COLORS.green
            elseif blackout.overtime then COLORS.danger
            else COLORS.blue
    end
    self._blackoutFrame.Visible = blackoutVisible

    local boss = state.boss
    local elite = state.elite
    local apex = if type(boss) == "table"
            and (boss.active == true or boss.complete == true)
        then boss
        else elite
    local bossView = apex == boss and type(boss) == "table"
    if type(apex) == "table" and not self._playerDowned then
        local health = math.max(0, tonumber(apex.health) or 0)
        local maxHealth = math.max(1, tonumber(apex.maxHealth) or 1)
        local apexPhase = math.clamp(tonumber(apex.phase) or 1, 1, 3)
        self._eliteTitle.Text = string.format(
            "%s · PHASE %d/3 · %d/%d",
            if bossView then "WARDEN STAG" else "OLD GROWTH",
            apexPhase,
            health,
            maxHealth
        )
        self._eliteFill.Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1)
        self._eliteFill.BackgroundColor3 = if apex.complete
            then COLORS.green
            elseif bossView and apex.exposed ~= true then COLORS.blue
            elseif apex.shielded then COLORS.danger
            else COLORS.amber
        if apex.complete then
            self._eliteDetail.Text = if bossView
                then if apex.outcome == "preserved"
                    then "CALMED · FOREST ALLY PRESERVED · +5 AMBER SAP"
                    elseif apex.outcome == "harmed" then "DEFEATED · FOREST HARMED · +5 AMBER SAP"
                    else "DEFEATED · FOREST SCARRED · +5 AMBER SAP"
                elseif apex.rewardEligible then "CLEANSED · +3 AMBER SAP UNBANKED"
                else "CLEANSED · CONTINUE TO WAYHOME"
            self._eliteDetail.TextColor3 = COLORS.green
        elseif bossView and apex.exposed then
            self._eliteDetail.Text = "HEART EXPOSED · STRIKE THE MEMORY SEAL"
            self._eliteDetail.TextColor3 = COLORS.amber
        elseif bossView then
            self._eliteDetail.Text = string.format(
                "ROOTS %d/%d · PRESERVE: CLEANSE · ANTLERS %d/2",
                tonumber(apex.cleansedNodes) or 0,
                tonumber(apex.rootNodesRequired) or 0,
                tonumber(apex.antlersBroken) or 0
            )
            self._eliteDetail.TextColor3 = if (tonumber(apex.antlersBroken) or 0) > 0
                then COLORS.danger
                else COLORS.blue
        elseif apex.carryingFire then
            local fireRemaining =
                math.max(0, (tonumber(apex.fireExpiresAt) or 0) - workspace:GetServerTimeNow())
            self._eliteDetail.Text =
                string.format("FIRE %.1fs · REACH THE ROOT HEART", fireRemaining)
            self._eliteDetail.TextColor3 = COLORS.amber
        elseif apex.shielded then
            self._eliteDetail.Text = "SHIELDED · TAKE LANTERN FIRE"
            self._eliteDetail.TextColor3 = COLORS.danger
        else
            self._eliteDetail.Text = "EXPOSED · STRIKE THE AMBER HEART"
            self._eliteDetail.TextColor3 = COLORS.amber
        end
        self._eliteFrame.Visible = apex.active == true or apex.complete == true
    else
        self._eliteFrame.Visible = false
    end
    self._lanternFrame.Visible = state.nightActive == true
        and not self._eliteFrame.Visible
        and not blackoutVisible

    local threat = state.threat
    if type(threat) == "table" and not self._playerDowned then
        local remaining =
            math.max(0, (tonumber(threat.resolvesAt) or 0) - workspace:GetServerTimeNow())
        local enemyName = tostring(threat.enemyName or "THREAT")
        local attackName = tostring(threat.displayName or "ATTACK")
        local title = if string.find(attackName, enemyName, 1, true) ~= nil
            then attackName
            else enemyName .. " · " .. attackName
        local shape = if threat.shape == "lane" then "LANE" else "RING"
        self._threatTitle.Text = "!! " .. title
        self._threatDetail.Text = string.format(
            "%s · %s · %.1fs",
            shape,
            tostring(threat.instruction or "MOVE"),
            remaining
        )
        self._threatFrame.Visible = remaining > 0
    else
        self._threatFrame.Visible = false
    end

    local survival = state.survival
    if type(survival) ~= "table" then
        return
    end
    local selfState = survival.self
    if type(selfState) == "table" and selfState.downed == true then
        local bleedoutAt = tonumber(selfState.bleedoutAt) or 0
        local remaining = math.max(0, math.ceil(bleedoutAt - workspace:GetServerTimeNow()))
        local downedDuration = math.max(1, tonumber(selfState.downedDuration) or remaining)
        self._downedTimer.Text =
            string.format("%02d:%02d", math.floor(remaining / 60), remaining % 60)
        self._downedFill.Size = UDim2.fromScale(math.clamp(remaining / downedDuration, 0, 1), 1)
        local nearest = selfState.nearestAlly
        self._downedAlly.Text = if type(nearest) == "table"
            then string.format(
                "HELP ACTIVE · %s %dm · %s",
                tostring(nearest.direction or "UNKNOWN"),
                tonumber(nearest.distance) or 0,
                string.upper(tostring(nearest.displayName or "ALLY"))
            )
            else "HELP SIGNAL ACTIVE · NO ALLY NEARBY"
    end
    local ally = survival.ally
    if type(ally) == "table" and not self._playerDowned then
        local bleedoutAt = tonumber(ally.bleedoutAt) or 0
        local remaining = math.max(0, math.ceil(bleedoutAt - workspace:GetServerTimeNow()))
        self._allyTitle.Text = "✚ ALLY DOWN · "
            .. string.upper(tostring(ally.displayName or "ALLY"))
        self._allyDetail.Text = string.format(
            "%s · %dm · %02ds%s",
            tostring(ally.direction or "UNKNOWN"),
            tonumber(ally.distance) or 0,
            remaining,
            if ally.reviveEndsAt ~= nil then " · REVIVING" else ""
        )
    end
end

function HUDController.update(self: HUDController, state: any)
    if type(state) ~= "table" or state.status ~= "ready" then
        return
    end
    self._currentState = state
    self:_updateLobby(state)
    local action = state.action
    if type(action) == "table" and action.active == true then
        self._actionFrame.Visible = true
        self._actionLabel.Text = tostring(action.label) .. "..."
        self._actionFill.Size = UDim2.fromScale(math.clamp(tonumber(action.alpha) or 0, 0, 1), 1)
    else
        self._actionFrame.Visible = false
    end
    -- Sprint is a toggle, not a hold, so the button has to show which it is.
    local combat = state.combat
    local running = type(combat) == "table" and combat.sprinting == true
    self._sprint.Text = if running then "RUNNING" else "RUN"
    self._sprint.BackgroundColor3 = if running then COLORS.blue else COLORS.panel
    local survival = state.survival
    local selfSurvival = if type(survival) == "table" then survival.self else nil
    self._playerDowned = type(selfSurvival) == "table" and selfSurvival.downed == true
    local elite = state.elite
    local boss = state.boss
    local blackout = state.blackout
    local eliteActive = type(elite) == "table" and elite.active == true
    local bossActive = type(boss) == "table" and boss.active == true
    local blackoutActive = type(blackout) == "table" and blackout.active == true
    self._combatContext = state.nightActive == true
        or state.expeditionActive == true
        or eliteActive
        or bossActive
        or blackoutActive
    local ally = if type(survival) == "table" then survival.ally else nil
    self._downedFrame.Visible = self._playerDowned
    self._allyFrame.Visible = type(ally) == "table" and not self._playerDowned
    self._toast.Position = if self._playerDowned
        then UDim2.new(0.5, 0, 1, -264)
        else UDim2.new(0.5, 0, 1, -222)
    -- In the lobby the story has not started: the objective card was
    -- already reading "FREE MARA" over the departure panel, pointing at a
    -- woman in a town the player had not left for. The card and the guide
    -- line belong to the world past the platform.
    local departedWorld = state.departed == true
    self._objectiveFrame.Visible = departedWorld
    self._mara.Visible = departedWorld
    self._objective.Text = tostring(state.objective or "")
    self._detail.Text = tostring(state.detail or "")
    self._progress.Text = string.format(
        "%s · %d / %d",
        tostring(state.trailName or "FIRST LIGHT"),
        tonumber(state.progress) or 0,
        tonumber(state.progressTotal) or 8
    )
    --[[
        Mara speaks and then stops.

        Her line used to sit on screen permanently, which turned a character
        remark into a permanent HUD element and left it contradicting whatever
        the player was doing minutes later. It now appears when she has
        something new to say and fades a few seconds afterwards; walking back
        to her produces a fresh line, which shows it again.
    ]]
    -- The guide line has a speaker now: Mara in town, the traveler's own
    -- inner voice out in the expedition, where she is not. An empty line
    -- stays silent even when the speaker changes -- otherwise crossing the
    -- gate would flash a bare "You:" with nothing after it.
    local guideText = tostring(state.mara or "")
    local maraLine = tostring(state.guideSpeaker or "Mara") .. ": " .. guideText
    if maraLine ~= self._maraText and guideText ~= "" then
        self._maraText = maraLine
        self._maraShownAt = os.clock()
        self._mara.Text = maraLine
        self._mara.TextTransparency = 0
    end
    --[[
        The held pill: what is in your hand right now. A weapon in the
        equipment slot outranks the starter tool, matching the visual on the
        character and the strike numbers on the server.
    ]]
    local equipped = state.equipped
    local heldWeapon = if type(equipped) == "table" and equipped.weapon ~= nil then "BOW" else nil
    self._resource.Text = string.format(
        "HEARTWOOD · %d%s",
        tonumber(state.resources) or 0,
        if heldWeapon ~= nil
            then "  ·  🏹 " .. heldWeapon
            elseif state.selectedTool ~= nil then "  ·  " .. string.upper(
                tostring(state.selectedTool)
            )
            else ""
    )
    local nightActive = state.nightActive == true
    local health = if type(selfSurvival) == "table"
        then tonumber(selfSurvival.health) or 100
        else 100
    local maxHealth = if type(selfSurvival) == "table"
        then tonumber(selfSurvival.maxHealth) or 100
        else 100
    self._health.Text = string.format("HEALTH · %d / %d", health, maxHealth)
    self._health.TextColor3 = if health <= 35 then COLORS.danger else COLORS.cream
    self._health.Visible = not self._playerDowned and (nightActive or health < maxHealth)
    self._resource.Visible = not nightActive
        and not blackoutActive
        and ((tonumber(state.resources) or 0) > 0 or state.selectedTool ~= nil)
    -- FIND and STRIKE now live on the world objects: tap the stump, tap the
    -- creature. Dead buttons cost the thing a phone screen has least of, so
    -- they stay hidden. Run, dodge, and ability remain because they have no
    -- target to tap.
    self._primary.Visible = false
    self._tool.Visible = false
        and (nightActive or eliteActive or bossActive or blackoutActive)
        and not self._playerDowned
    self._sprint.Visible = self._inputMode == "touch" and not self._playerDowned
    self._dodge.Visible = self:_dodgeButtonVisible()
    self:_updateProfessionClock()
    self:_updateGear()
    self:_updateProgress()
    local eliteVisible = (type(boss) == "table" and (boss.active == true or boss.complete == true))
        or (type(elite) == "table" and (elite.active == true or elite.complete == true))
    eliteVisible = eliteVisible and not self._playerDowned
    self._eliteFrame.Visible = eliteVisible
    local blackoutVisible = type(blackout) == "table"
        and blackout.status ~= "dormant"
        and blackout.status ~= "disabled"
        and not self._playerDowned
    self._blackoutFrame.Visible = blackoutVisible
    self._lanternFrame.Visible = nightActive and not eliteVisible and not blackoutVisible
    local lanternHealth = math.clamp(tonumber(state.lanternHealth) or 100, 0, 100)
    self._lanternFill.Size = UDim2.new(lanternHealth / 100, -8, 1, -8)
    self._lanternFill.BackgroundColor3 = if lanternHealth <= 35 then COLORS.danger else COLORS.amber
    self._lanternText.Text = string.format("LIGHT · %d%%", lanternHealth)
    self._lanternText.TextColor3 = if lanternHealth <= 55 then COLORS.cream else COLORS.ink

    if state.compactHud ~= nil and state.compactHud ~= self._compactEnabled then
        self._compactEnabled = state.compactHud == true
        self:_applyCompact()
    end
    self._mara.Visible = self:_maraLineIsFresh()
        and not self._compactEnabled
        and not self._playerDowned
    self:setInteraction(self._interactionLabel, self._interactionAvailable)
    self:_layout()
    self:_updateCombatClock()

    local revision = tonumber(state.toastRevision) or 0
    if revision > self._lastToastRevision and state.toast ~= nil then
        self._lastToastRevision = revision
        self._toast.Text = tostring(state.toast)
        self._toast.Visible = true
        local captured = revision
        task.delay(3.2, function()
            if self._lastToastRevision == captured then
                self._toast.Visible = false
            end
        end)
    end

    self:_updateClock()
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="147">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict

local UserInputService = game:GetService("UserInputService")

local InputController = {}
InputController.__index = InputController

export type InputController = typeof(setmetatable(
    {} :: {
        _hud: any,
        _context: Instance?,
        _connections: { RBXScriptConnection },
        _running: boolean,
    },
    InputController
))

local function addKeyBinding(action: Instance, name: string, keyCode: Enum.KeyCode)
    local binding = Instance.new("InputBinding")
    binding.Name = name
    binding.KeyCode = keyCode
    binding.DisplayName = keyCode.Name
    binding.Parent = action
end

local function addTouchBinding(action: Instance, name: string, button: GuiButton)
    local binding = Instance.new("InputBinding")
    binding.Name = name
    binding.UIButton = button
    binding.DisplayName = name
    binding.Parent = action
end

local function createBoolAction(
    context: Instance,
    name: string,
    keys: { { name: string, key: Enum.KeyCode } },
    button: GuiButton
): Instance
    local action = Instance.new("InputAction")
    action.Name = name
    action.Type = Enum.InputActionType.Bool
    action.Parent = context
    for _, binding in keys do
        addKeyBinding(action, binding.name, binding.key)
    end
    addTouchBinding(action, "Touch", button)
    return action
end

function InputController.new(
    hud: any,
    onInteract: () -> (),
    onUseTool: () -> (),
    onSprint: (boolean) -> (),
    onDodge: () -> (),
    onProfessionAbility: () -> (),
    onProfessionMenu: () -> (),
    onUseCharm: () -> (),
    onUseSatchel: () -> ()
): InputController
    local self = setmetatable({
        _hud = hud,
        _context = nil,
        _connections = {},
        _running = false,
    }, InputController)

    local ok = pcall(function()
        local context = Instance.new("InputContext")
        context.Name = "LastLightPlayContext"
        context.Priority = 2000
        context.Sink = false
        context.Enabled = true
        context.Parent = hud:gui()
        self._context = context

        local interact = createBoolAction(context, "Interact", {
            { name = "Keyboard", key = Enum.KeyCode.E },
            { name = "Gamepad", key = Enum.KeyCode.ButtonX },
        }, hud:primaryButton())
        local tool = createBoolAction(context, "UseTool", {
            { name = "Mouse", key = Enum.KeyCode.MouseLeftButton },
            { name = "Gamepad", key = Enum.KeyCode.ButtonR2 },
        }, hud:toolButton())
        local sprint = createBoolAction(context, "Sprint", {
            { name = "Keyboard", key = Enum.KeyCode.LeftShift },
            { name = "Gamepad", key = Enum.KeyCode.ButtonL3 },
        }, hud:sprintButton())
        local dodge = createBoolAction(context, "Dodge", {
            { name = "Keyboard", key = Enum.KeyCode.LeftAlt },
            { name = "Gamepad", key = Enum.KeyCode.ButtonB },
        }, hud:dodgeButton())
        local professionAbility = createBoolAction(context, "ProfessionAbility", {
            { name = "Keyboard", key = Enum.KeyCode.Q },
            { name = "Gamepad", key = Enum.KeyCode.ButtonL1 },
        }, hud:abilityButton())
        local professionMenu = createBoolAction(context, "ProfessionMenu", {
            { name = "Keyboard", key = Enum.KeyCode.P },
            { name = "Gamepad", key = Enum.KeyCode.DPadUp },
        }, hud:professionButton())
        local useCharm = createBoolAction(context, "UseAmberCharm", {
            { name = "Keyboard", key = Enum.KeyCode.C },
            { name = "Gamepad", key = Enum.KeyCode.ButtonY },
        }, hud:useCharmButton())
        local useSatchel = createBoolAction(context, "UseMeadowSatchel", {
            { name = "Keyboard", key = Enum.KeyCode.V },
            { name = "Gamepad", key = Enum.KeyCode.DPadDown },
        }, hud:useSatchelButton())

        table.insert(
            self._connections,
            (interact :: any).Pressed:Connect(function()
                if not hud:isProfessionMenuOpen() then
                    onInteract()
                end
            end)
        )
        table.insert(
            self._connections,
            (tool :: any).Pressed:Connect(function()
                if not hud:isProfessionMenuOpen() then
                    onUseTool()
                end
            end)
        )
        table.insert(
            self._connections,
            (sprint :: any).Pressed:Connect(function()
                if not hud:isProfessionMenuOpen() then
                    self._running = not self._running
                    onSprint(self._running)
                end
            end)
        )
        table.insert(
            self._connections,
            (dodge :: any).Pressed:Connect(function()
                if hud:isProfessionMenuOpen() then
                    hud:setProfessionMenuOpen(false)
                else
                    onDodge()
                end
            end)
        )
        table.insert(
            self._connections,
            (professionAbility :: any).Pressed:Connect(function()
                if not hud:isProfessionMenuOpen() then
                    onProfessionAbility()
                end
            end)
        )
        table.insert(self._connections, (professionMenu :: any).Pressed:Connect(onProfessionMenu))
        table.insert(
            self._connections,
            (useCharm :: any).Pressed:Connect(function()
                if not hud:isProfessionMenuOpen() then
                    onUseCharm()
                end
            end)
        )
        table.insert(
            self._connections,
            (useSatchel :: any).Pressed:Connect(function()
                if not hud:isProfessionMenuOpen() then
                    onUseSatchel()
                end
            end)
        )
    end)

    if not ok then
        for _, connection in self._connections do
            connection:Disconnect()
        end
        table.clear(self._connections)
        if self._context ~= nil then
            self._context:Destroy()
            self._context = nil
        end
        self:_installFallback(
            onInteract,
            onUseTool,
            onSprint,
            onDodge,
            onProfessionAbility,
            onProfessionMenu,
            onUseCharm,
            onUseSatchel
        )
    end

    local function updateInputMode()
        local preferred = UserInputService.PreferredInput
        local mode = if preferred == Enum.PreferredInput.Touch
            then "touch"
            elseif preferred == Enum.PreferredInput.Gamepad then "gamepad"
            else "keyboard"
        hud:setInputMode(mode)
    end
    updateInputMode()
    table.insert(
        self._connections,
        UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(updateInputMode)
    )
    table.insert(
        self._connections,
        UserInputService.InputBegan:Connect(function(input: InputObject, _processed: boolean)
            if input.KeyCode == Enum.KeyCode.Escape and hud:isProfessionMenuOpen() then
                hud:setProfessionMenuOpen(false)
            end
        end)
    )

    return self
end

function InputController._installFallback(
    self: InputController,
    onInteract: () -> (),
    onUseTool: () -> (),
    onSprint: (boolean) -> (),
    onDodge: () -> (),
    onProfessionAbility: () -> (),
    onProfessionMenu: () -> (),
    onUseCharm: () -> (),
    onUseSatchel: () -> ()
)
    table.insert(self._connections, self._hud:primaryButton().Activated:Connect(onInteract))
    table.insert(self._connections, self._hud:toolButton().Activated:Connect(onUseTool))
    table.insert(self._connections, self._hud:dodgeButton().Activated:Connect(onDodge))
    table.insert(
        self._connections,
        self._hud:abilityButton().Activated:Connect(onProfessionAbility)
    )
    table.insert(
        self._connections,
        self._hud:professionButton().Activated:Connect(onProfessionMenu)
    )
    table.insert(self._connections, self._hud:useCharmButton().Activated:Connect(onUseCharm))
    table.insert(self._connections, self._hud:useSatchelButton().Activated:Connect(onUseSatchel))
    table.insert(
        self._connections,
        self._hud:sprintButton().MouseButton1Down:Connect(function()
            self._running = not self._running
            onSprint(self._running)
        end)
    )
    table.insert(
        self._connections,
        UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
            if processed then
                return
            end
            if
                self._hud:isProfessionMenuOpen()
                and (input.KeyCode == Enum.KeyCode.ButtonB or input.KeyCode == Enum.KeyCode.Escape)
            then
                self._hud:setProfessionMenuOpen(false)
            elseif self._hud:isProfessionMenuOpen() then
                return
            elseif input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
                onInteract()
            elseif
                input.KeyCode == Enum.KeyCode.LeftShift
                or input.KeyCode == Enum.KeyCode.ButtonL3
            then
                self._running = not self._running
                onSprint(self._running)
            elseif
                input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.ButtonB
            then
                onDodge()
            elseif
                input.UserInputType == Enum.UserInputType.MouseButton1
                or input.KeyCode == Enum.KeyCode.ButtonR2
            then
                onUseTool()
            elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonL1 then
                onProfessionAbility()
            elseif input.KeyCode == Enum.KeyCode.P or input.KeyCode == Enum.KeyCode.DPadUp then
                onProfessionMenu()
            elseif input.KeyCode == Enum.KeyCode.C or input.KeyCode == Enum.KeyCode.ButtonY then
                onUseCharm()
            elseif input.KeyCode == Enum.KeyCode.V or input.KeyCode == Enum.KeyCode.DPadDown then
                onUseSatchel()
            end
        end)
    )
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="148">
            <Properties>
              <string name="Name">InteractionController</string>
              <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")

local InteractionController = {}
InteractionController.__index = InteractionController

export type InteractionController = typeof(setmetatable(
    {} :: {
        _tag: string,
        _hud: any,
        _shown: { [ProximityPrompt]: boolean },
        _current: ProximityPrompt?,
        _heartbeat: RBXScriptConnection?,
    },
    InteractionController
))

function InteractionController.new(tag: string, hud: any): InteractionController
    local self = setmetatable({
        _tag = tag,
        _hud = hud,
        _shown = {},
        _current = nil,
        _heartbeat = nil,
    }, InteractionController)

    ProximityPromptService.PromptShown:Connect(function(prompt: ProximityPrompt)
        if CollectionService:HasTag(prompt, tag) then
            self._shown[prompt] = true
            self:_select()
        end
    end)
    ProximityPromptService.PromptHidden:Connect(function(prompt: ProximityPrompt)
        self._shown[prompt] = nil
        if self._current == prompt then
            self._current = nil
        end
        self:_select()
    end)

    local accumulator = 0
    self._heartbeat = RunService.RenderStepped:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator >= 0.2 then
            accumulator = 0
            self:_select()
        end
    end)

    return self
end

function InteractionController._select(self: InteractionController)
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    local closest: ProximityPrompt? = nil
    local closestDistance = math.huge

    if root ~= nil and root:IsA("BasePart") then
        for prompt in self._shown do
            local target = prompt.Parent
            local targetUserId = prompt:GetAttribute("TargetUserId")
            local actionId = prompt:GetAttribute("ActionId")
            if
                prompt.Enabled
                and target ~= nil
                and target:IsA("BasePart")
                and targetUserId ~= player.UserId
                and type(actionId) == "string"
                and self._hud:canInteractAction(actionId)
            then
                local distance = (root.Position - target.Position).Magnitude
                if distance < closestDistance then
                    closest = prompt
                    closestDistance = distance
                end
            end
        end
    end

    self._current = closest
    if closest == nil then
        self._hud:setInteraction(nil, false)
    else
        self._hud:setInteraction(string.upper(closest.ActionText), true)
    end
end

function InteractionController.currentInteractionId(self: InteractionController): string?
    local prompt = self._current
    if prompt == nil then
        return nil
    end
    local interactionId = prompt:GetAttribute("InteractionId")
    return if type(interactionId) == "string" then interactionId else nil
end

return InteractionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">MusicController</string>
              <string name="Source"><![CDATA[--!strict

local ContentProvider = game:GetService("ContentProvider")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local MusicController = {}
MusicController.__index = MusicController

export type MusicController = typeof(setmetatable(
    {} :: {
        _catalog: any,
        _group: SoundGroup,
        _slots: { Sound },
        _activeSlot: number,
        _trackId: string?,
        _revision: number,
        _retryConnection: RBXScriptConnection?,
    },
    MusicController
))

local CROSSFADE_SECONDS = 3.2

local function musicSlot(name: string, group: SoundGroup): Sound
    local sound = Instance.new("Sound")
    sound.Name = name
    sound.Looped = true
    sound.Volume = 0
    sound.SoundGroup = group
    sound.Parent = SoundService
    return sound
end

function MusicController.new(catalog: any): MusicController
    local group = Instance.new("SoundGroup")
    group.Name = "LastLightMusic"
    group.Volume = 0.78
    group.Parent = SoundService

    local self = setmetatable({
        _catalog = catalog,
        _group = group,
        _slots = { musicSlot("MusicA", group), musicSlot("MusicB", group) },
        _activeSlot = 2,
        _trackId = nil,
        _revision = 0,
        _retryConnection = nil,
    }, MusicController)

    -- Some mobile clients defer autoplay until the first real interaction.
    self._retryConnection = UserInputService.InputBegan:Connect(function()
        local active = self._slots[self._activeSlot]
        if self._trackId ~= nil and not active.Playing then
            active:Play()
        end
    end)
    return self
end

function MusicController.setSnapshot(self: MusicController, snapshot: any)
    local nextTrack = self._catalog.resolveSnapshot(snapshot)
    if nextTrack.id == self._trackId then
        return
    end

    self._revision += 1
    local revision = self._revision
    local oldSlotIndex = self._activeSlot
    local nextSlotIndex = if oldSlotIndex == 1 then 2 else 1
    local outgoing = self._slots[oldSlotIndex]
    local incoming = self._slots[nextSlotIndex]
    self._activeSlot = nextSlotIndex
    self._trackId = nextTrack.id

    incoming:Stop()
    incoming.SoundId = "rbxassetid://" .. tostring(nextTrack.assetId)
    incoming.Volume = 0
    incoming:SetAttribute("TrackId", nextTrack.id)
    incoming:SetAttribute("RegionMusic", true)

    task.spawn(function()
        pcall(function()
            ContentProvider:PreloadAsync({ incoming })
        end)
        if revision ~= self._revision then
            return
        end
        incoming:Play()
        TweenService
            :Create(
                incoming,
                TweenInfo.new(CROSSFADE_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                { Volume = nextTrack.volume }
            )
            :Play()
        TweenService
            :Create(
                outgoing,
                TweenInfo.new(CROSSFADE_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                { Volume = 0 }
            )
            :Play()
        task.delay(CROSSFADE_SECONDS + 0.1, function()
            if revision == self._revision then
                outgoing:Stop()
            end
        end)
    end)
end

return MusicController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">ObjectiveMarkerController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Show the player where the current objective is.

    The objective card has always named the task and never the place. "Choose
    a starter tool" says nothing about where the tools are; "gather heartwood"
    says nothing about where the stump is. A new player reads it, looks up at
    a dark valley, and wanders.

    Two things fix that, and this controller owns both:

      - A marker standing over the objective itself, visible through terrain,
        with the distance on it. That is the "something above the objective"
        half.
      - A pointer at the screen edge when the objective is behind or beside
        the player, so there is always a direction to walk. That is the half
        that works when the marker is off-screen entirely, which for an
        objective in a forest is most of the time.

    Both are presentation, driven entirely by the server snapshot: the client
    is told where the objective is, never what counts as done.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ObjectiveMarkerController = {}
ObjectiveMarkerController.__index = ObjectiveMarkerController

export type ObjectiveMarkerController = typeof(setmetatable(
    {} :: {
        _folder: Folder,
        _gui: ScreenGui,
        _pointer: Frame,
        _pointerLabel: TextLabel,
        _markers: { [string]: BillboardGui },
        _anchors: { [string]: Part },
        _targets: { any },
        _connection: RBXScriptConnection?,
    },
    ObjectiveMarkerController
))

local AMBER = Color3.fromRGB(255, 186, 92)
local INK = Color3.fromRGB(18, 14, 11)

function ObjectiveMarkerController.new(playerGui: PlayerGui): ObjectiveMarkerController
    local folder = Instance.new("Folder")
    folder.Name = "LastLightObjectiveMarkers"
    folder.Parent = workspace

    local gui = Instance.new("ScreenGui")
    gui.Name = "LastLightObjectivePointer"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = false
    gui.DisplayOrder = 12
    gui.Parent = playerGui

    local pointer = Instance.new("Frame")
    pointer.Name = "EdgePointer"
    pointer.AnchorPoint = Vector2.new(0.5, 0.5)
    pointer.Size = UDim2.fromOffset(168, 40)
    pointer.BackgroundColor3 = INK
    pointer.BackgroundTransparency = 0.12
    pointer.BorderSizePixel = 0
    pointer.Visible = false
    pointer.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = pointer
    local stroke = Instance.new("UIStroke")
    stroke.Color = AMBER
    stroke.Transparency = 0.35
    stroke.Thickness = 1.5
    stroke.Parent = pointer

    local label = Instance.new("TextLabel")
    label.Name = "PointerLabel"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 15
    label.TextColor3 = AMBER
    label.Text = ""
    label.Parent = pointer

    local self = setmetatable({
        _folder = folder,
        _gui = gui,
        _pointer = pointer,
        _pointerLabel = label,
        _markers = {},
        _anchors = {},
        _targets = {},
        _connection = nil,
    }, ObjectiveMarkerController)

    self._connection = RunService.RenderStepped:Connect(function()
        self:_step()
    end)
    return self
end

function ObjectiveMarkerController._clear(self: ObjectiveMarkerController)
    for _, anchor in self._anchors do
        anchor:Destroy()
    end
    self._anchors = {}
    self._markers = {}
end

--[[
    Take the server's list of objective positions.

    Rebuilt only when the set of interaction IDs actually changes, so the
    markers do not flicker on every snapshot -- the snapshot arrives on any
    state change, several times a second during a night.
]]
function ObjectiveMarkerController.setTargets(self: ObjectiveMarkerController, targets: { any }?)
    local incoming = if type(targets) == "table" then targets else {}
    local changed = #incoming ~= #self._targets
    if not changed then
        for index, target in incoming do
            if
                self._targets[index] == nil
                or self._targets[index].interactionId ~= target.interactionId
            then
                changed = true
                break
            end
        end
    end
    self._targets = incoming
    if not changed then
        -- Positions can still move (Mara walks), so keep anchors in sync.
        for _, target in incoming do
            local anchor = self._anchors[target.interactionId]
            if anchor ~= nil then
                anchor.Position = Vector3.new(target.x, target.y, target.z)
            end
        end
        return
    end

    self:_clear()
    for _, target in incoming do
        local anchor = Instance.new("Part")
        anchor.Name = "ObjectiveAnchor_" .. tostring(target.interactionId)
        anchor.Size = Vector3.new(0.2, 0.2, 0.2)
        anchor.Transparency = 1
        anchor.Anchored = true
        anchor.CanCollide = false
        anchor.CanQuery = false
        anchor.CanTouch = false
        anchor.CastShadow = false
        anchor.Position = Vector3.new(target.x, target.y, target.z)
        anchor.Parent = self._folder

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ObjectiveMarker"
        billboard.Adornee = anchor
        billboard.AlwaysOnTop = true
        billboard.LightInfluence = 0
        billboard.Size = UDim2.fromOffset(184, 46)
        billboard.StudsOffsetWorldSpace = Vector3.new(0, 7.5, 0)
        billboard.MaxDistance = 600
        billboard.Parent = anchor

        local card = Instance.new("Frame")
        card.BackgroundColor3 = INK
        card.BackgroundTransparency = 0.14
        card.BorderSizePixel = 0
        card.Size = UDim2.fromScale(1, 1)
        card.Parent = billboard
        local cardCorner = Instance.new("UICorner")
        cardCorner.CornerRadius = UDim.new(0, 10)
        cardCorner.Parent = card
        local cardStroke = Instance.new("UIStroke")
        cardStroke.Color = AMBER
        cardStroke.Transparency = 0.3
        cardStroke.Thickness = 1.5
        cardStroke.Parent = card

        local text = Instance.new("TextLabel")
        text.Name = "MarkerText"
        text.BackgroundTransparency = 1
        text.Size = UDim2.fromScale(1, 1)
        text.Font = Enum.Font.GothamBold
        text.TextSize = 15
        text.TextColor3 = AMBER
        text.Text = "▼ " .. tostring(target.label or "OBJECTIVE")
        text.Parent = card

        self._anchors[target.interactionId] = anchor
        self._markers[target.interactionId] = billboard
    end
end

function ObjectiveMarkerController._step(self: ObjectiveMarkerController)
    local camera = workspace.CurrentCamera
    local character = Players.LocalPlayer.Character
    local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
    if camera == nil or root == nil or not root:IsA("BasePart") or #self._targets == 0 then
        self._pointer.Visible = false
        return
    end

    -- Point at the nearest objective: with three tool pedestals the useful
    -- direction is the closest one, not an average of them.
    local nearest, nearestDistance = nil, math.huge
    for _, target in self._targets do
        local position = Vector3.new(target.x, target.y, target.z)
        local distance = (position - root.Position).Magnitude
        if distance < nearestDistance then
            nearest = position
            nearestDistance = distance
        end
        local billboard = self._markers[target.interactionId]
        if billboard ~= nil then
            local label = billboard:FindFirstChild("MarkerText", true)
            if label ~= nil and label:IsA("TextLabel") then
                label.Text = string.format(
                    "▼ %s · %dm",
                    tostring(target.label or "OBJECTIVE"),
                    math.floor(distance + 0.5)
                )
            end
        end
    end
    if nearest == nil then
        self._pointer.Visible = false
        return
    end

    local screenPoint, onScreen = camera:WorldToViewportPoint(nearest)
    local viewport = camera.ViewportSize
    if onScreen and screenPoint.Z > 0 then
        -- The world marker is doing the job; an edge pointer as well would be
        -- two things saying the same thing.
        self._pointer.Visible = false
        return
    end

    -- Behind or off to the side: pin a pointer to the screen edge in the
    -- objective's direction, so there is always a way to face.
    local centre = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    local direction = Vector2.new(screenPoint.X, screenPoint.Y) - centre
    if screenPoint.Z <= 0 then
        direction = -direction
    end
    if direction.Magnitude < 0.001 then
        direction = Vector2.new(0, -1)
    end
    direction = direction.Unit
    local margin = 74
    local halfX = math.max(1, viewport.X * 0.5 - margin)
    local halfY = math.max(1, viewport.Y * 0.5 - margin)
    local scale = math.min(
        halfX / math.abs(direction.X == 0 and 0.0001 or direction.X),
        halfY / math.abs(direction.Y == 0 and 0.0001 or direction.Y)
    )
    local edge = centre + direction * scale
    self._pointer.Position = UDim2.fromOffset(edge.X, edge.Y)
    self._pointerLabel.Text = string.format("◄ %dm", math.floor(nearestDistance + 0.5))
    self._pointer.Visible = true
end

return table.freeze(ObjectiveMarkerController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">PerformanceController</string>
              <string name="Source"><![CDATA[--!strict

--[[
    Reports this client's own frame and memory numbers to the server.

    Frame rate, stalls, and memory are the three budgets in
    docs/TECHNICAL_ARCHITECTURE.md that only the client can see, and they are
    the ones the exit gate cares most about, since "target device meets frame,
    memory, join, and network budgets" is a statement about the phone in
    someone's hand rather than about the server.

    What it sends, once per interval:

      * the mean frame rate over the interval, not the instantaneous one, so a
        single lucky frame cannot flatter the sample;
      * the worst single frame in the interval, in milliseconds, which is the
        stutter a player actually felt;
      * total client memory, which the server turns into headroom against the
        baseline device ceiling.

    The interval matters: sampling every frame and sending it would itself be
    the network problem this is supposed to measure.
]]

local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local PerformanceController = {}
PerformanceController.__index = PerformanceController

export type PerformanceController = typeof(setmetatable(
    {} :: {
        _remote: RemoteEvent,
        _interval: number,
        _frames: number,
        _elapsed: number,
        _worstFrameMs: number,
        _connection: RBXScriptConnection?,
    },
    PerformanceController
))

function PerformanceController.new(remote: RemoteEvent, interval: number): PerformanceController
    local self = setmetatable({
        _remote = remote,
        _interval = math.max(1, interval),
        _frames = 0,
        _elapsed = 0,
        _worstFrameMs = 0,
        _connection = nil,
    }, PerformanceController)

    self._connection = RunService.RenderStepped:Connect(function(deltaTime: number)
        self:_step(deltaTime)
    end)
    return self
end

function PerformanceController._step(self: PerformanceController, deltaTime: number)
    self._frames += 1
    self._elapsed += deltaTime
    self._worstFrameMs = math.max(self._worstFrameMs, deltaTime * 1000)

    if self._elapsed < self._interval then
        return
    end

    local fps = self._frames / self._elapsed
    local worstFrameMs = self._worstFrameMs
    self._frames = 0
    self._elapsed = 0
    self._worstFrameMs = 0

    -- A pcall because a failed telemetry send must never be the thing that
    -- breaks someone's session.
    pcall(function()
        self._remote:FireServer({
            schemaVersion = 1,
            fps = fps,
            spikeMs = worstFrameMs,
            memoryMb = Stats:GetTotalMemoryUsageMb(),
        })
    end)
end

function PerformanceController.destroy(self: PerformanceController)
    local connection = self._connection
    if connection ~= nil then
        connection:Disconnect()
        self._connection = nil
    end
end

return table.freeze(PerformanceController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">SfxController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Owns the Sound instances and plays what SfxCatalog decides.

    Thin on purpose: all judgement about when a cue fires lives in the
    catalog's pure resolver where the specs are. This controller only pools
    sounds, rolls a little pitch variation so repetition doesn't grate, and
    enforces each cue's cooldown so a burst of snapshots cannot machine-gun
    a sound.
]]

local SoundService = game:GetService("SoundService")

local SfxController = {}
SfxController.__index = SfxController

export type SfxController = typeof(setmetatable(
    {} :: {
        _catalog: any,
        _group: SoundGroup,
        _sounds: { [string]: { Sound } },
        _nextSlot: { [string]: number },
        _lastPlayedAt: { [string]: number },
        _signature: any,
        _random: Random,
    },
    SfxController
))

-- Two slots per cue: a gather can land while the previous gather's tail is
-- still ringing without cutting it off.
local SLOTS_PER_CUE = 2

-- The catalog arrives injected, the same way MusicController receives its
-- catalog: shared modules live under ReplicatedStorage.LastLight and the
-- bootstrap owns requiring them.
function SfxController.new(catalog: any): SfxController
    local group = Instance.new("SoundGroup")
    group.Name = "LastLightSfx"
    group.Volume = 0.85
    group.Parent = SoundService

    local sounds: { [string]: { Sound } } = {}
    local nextSlot: { [string]: number } = {}
    for id, definition in catalog.Cues do
        local slots = {}
        for slot = 1, SLOTS_PER_CUE do
            local sound = Instance.new("Sound")
            sound.Name = "Sfx_" .. id .. "_" .. slot
            sound.SoundId = definition.soundId
            sound.Volume = definition.volume
            sound.SoundGroup = group
            sound.Parent = group
            table.insert(slots, sound)
        end
        sounds[id] = slots
        nextSlot[id] = 1
    end

    return setmetatable({
        _catalog = catalog,
        _group = group,
        _sounds = sounds,
        _nextSlot = nextSlot,
        _lastPlayedAt = {},
        _signature = nil,
        _random = Random.new(),
    }, SfxController)
end

function SfxController.play(self: SfxController, cueId: string)
    local definition = self._catalog.get(cueId)
    local slots = self._sounds[cueId]
    if definition == nil or slots == nil then
        return
    end
    local now = os.clock()
    local lastAt = self._lastPlayedAt[cueId]
    if lastAt ~= nil and now - lastAt < definition.cooldown then
        return
    end
    self._lastPlayedAt[cueId] = now
    local slot = self._nextSlot[cueId]
    self._nextSlot[cueId] = if slot >= #slots then 1 else slot + 1
    local sound = slots[slot]
    sound:Stop()
    sound.PlaybackSpeed = self._random:NextNumber(definition.minSpeed, definition.maxSpeed)
    sound:Play()
end

--[[
    Feed every server snapshot through. The first one only seeds the
    signature — joining mid-night must not play the night sting.
]]
function SfxController.setSnapshot(self: SfxController, snapshot: any)
    if type(snapshot) ~= "table" then
        return
    end
    local cues, signature = self._catalog.resolveTransitions(self._signature, snapshot)
    self._signature = signature
    for _, cueId in cues do
        self:play(cueId)
    end
end

return table.freeze(SfxController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">TapController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Tapping the world, handled on the client so it works on a phone.

    Tapping objects is this game's interaction model, and it was implemented
    entirely with server-side ClickDetectors. That is reliable for a mouse and
    unreliable for a finger: on touch, Roblox only turns a press into a click
    when its own heuristics decide the gesture was a tap rather than the start
    of a camera drag, and the right-hand side of a phone screen -- where the
    creature you are trying to hit usually is -- is exactly the camera-drag
    region. The owner's report was precise about it: hitting monsters worked
    on a laptop and never on mobile or tablet.

    So the tap is resolved here instead. A press that ends near where it began
    is a tap; anything else was a camera drag and is ignored. The tap is
    raycast into the world, and what it lands on decides which request to
    send. That is all a tap ever does -- the server still decides range,
    damage, validity, and every outcome, exactly as before.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local TapController = {}
TapController.__index = TapController

export type TapController = typeof(setmetatable(
    {} :: {
        _onStrike: () -> (),
        _onInteract: (string) -> (),
        _origins: { [number]: Vector2 },
        _connections: { RBXScriptConnection },
    },
    TapController
))

-- A finger moves a little even on a deliberate tap; a camera drag moves a
-- lot. 14 points separates them without demanding a perfectly still thumb.
local TAP_SLOP_PIXELS = 14
local MAX_TAP_DISTANCE = 220

local function inputKey(input: InputObject): number
    return if input.UserInputType == Enum.UserInputType.Touch then input.KeyCode.Value + 1 else 0
end

--[[
    What did this tap mean?

    Walks up from whatever the ray hit, because the thing under a finger is
    usually a click volume or a mesh part rather than the model that owns the
    meaning. An enemy answers with a strike; anything carrying an interaction
    ID answers with that interaction.
]]
local function resolveTarget(instance: Instance): (string?, string?)
    local node: Instance? = instance
    while node ~= nil and node ~= workspace do
        if node:IsA("Model") and node:FindFirstChild("StrikeClick") ~= nil then
            return "strike", nil
        end
        local name = node.Name
        local interactionId = string.match(name, "^(.+)_ClickVolume$")
        if interactionId ~= nil then
            return "interact", interactionId
        end
        local attribute = node:GetAttribute("InteractionId")
        if type(attribute) == "string" then
            return "interact", attribute
        end
        node = node.Parent
    end
    return nil, nil
end

function TapController.new(onStrike: () -> (), onInteract: (string) -> ()): TapController
    local self = setmetatable({
        _onStrike = onStrike,
        _onInteract = onInteract,
        _origins = {},
        _connections = {},
    }, TapController)

    table.insert(
        self._connections,
        UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
            if processed then
                return
            end
            if
                input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1
            then
                self._origins[inputKey(input)] = Vector2.new(input.Position.X, input.Position.Y)
            end
        end)
    )

    table.insert(
        self._connections,
        UserInputService.InputEnded:Connect(function(input: InputObject, processed: boolean)
            if
                input.UserInputType ~= Enum.UserInputType.Touch
                and input.UserInputType ~= Enum.UserInputType.MouseButton1
            then
                return
            end
            local key = inputKey(input)
            local origin = self._origins[key]
            self._origins[key] = nil
            -- A press that started on a HUD button belongs to that button.
            if processed or origin == nil then
                return
            end
            local ended = Vector2.new(input.Position.X, input.Position.Y)
            if (ended - origin).Magnitude > TAP_SLOP_PIXELS then
                return
            end
            self:_resolve(ended)
        end)
    )
    return self
end

function TapController._resolve(self: TapController, position: Vector2)
    local camera = workspace.CurrentCamera
    local player = Players.LocalPlayer
    local character = player.Character
    if camera == nil or character == nil then
        return
    end
    local ray = camera:ViewportPointToRay(position.X, position.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    local hit = workspace:Raycast(ray.Origin, ray.Direction * MAX_TAP_DISTANCE, params)
    if hit == nil then
        return
    end
    local kind, interactionId = resolveTarget(hit.Instance)
    if kind == "strike" then
        self._onStrike()
    elseif kind == "interact" and interactionId ~= nil then
        self._onInteract(interactionId)
    end
end

function TapController.destroy(self: TapController)
    for _, connection in self._connections do
        connection:Disconnect()
    end
    self._connections = {}
    self._origins = {}
end

return table.freeze(TapController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">VignetteController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Short, local, skippable arrival vignettes.

    When a threat arrives -- the night, the Blackout, an awakening elite or
    boss -- the camera spends a moment on it: a slow push toward the threat
    under letterbox bars with a title card, then control returns. The moment
    is presentation only, and every rule here exists to keep it that way:

    - Camera-only and local. The server never waits, other players never
      pause, and the character keeps its position and physics. Movement input
      still works during the shot; pressing anything also skips it.
    - Short and bounded. No vignette runs past a few seconds, and the arrival
      beats that trigger them all carry more quiet time than that before any
      attack pressure begins.
    - Never while downed, never in compact HUD mode (the documented
      low-effects/accessibility preset), and never twice for one arrival.
    - Restores exactly: the camera returns to the player follow-cam it took
      over from, whatever happened mid-shot.
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local VignetteController = {}
VignetteController.__index = VignetteController

export type Shot = {
    title: string,
    subtitle: string,
    focus: Vector3,
    duration: number,
}

export type VignetteController = typeof(setmetatable(
    {} :: {
        _gui: ScreenGui,
        _topBar: Frame,
        _bottomBar: Frame,
        _title: TextLabel,
        _subtitle: TextLabel,
        _playing: boolean,
        _compact: boolean,
        _skipConnection: RBXScriptConnection?,
    },
    VignetteController
))

local BAR_HEIGHT = 0.14
local EASE = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function VignetteController.new(playerGui: PlayerGui): VignetteController
    local gui = Instance.new("ScreenGui")
    gui.Name = "LastLightVignette"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 40
    gui.Enabled = false
    gui.Parent = playerGui

    local function bar(name: string, anchor: number): Frame
        local frame = Instance.new("Frame")
        frame.Name = name
        frame.BackgroundColor3 = Color3.fromRGB(4, 5, 7)
        frame.BorderSizePixel = 0
        frame.AnchorPoint = Vector2.new(0.5, anchor)
        frame.Position = UDim2.fromScale(0.5, anchor)
        frame.Size = UDim2.fromScale(1, 0)
        frame.Parent = gui
        return frame
    end
    local topBar = bar("TopBar", 0)
    local bottomBar = bar("BottomBar", 1)

    local title = Instance.new("TextLabel")
    title.Name = "VignetteTitle"
    title.BackgroundTransparency = 1
    title.AnchorPoint = Vector2.new(0.5, 1)
    title.Position = UDim2.new(0.5, 0, 1, -8)
    title.Size = UDim2.new(0.9, 0, 0, 40)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 30
    title.TextColor3 = Color3.fromRGB(244, 236, 214)
    title.TextTransparency = 1
    title.Text = ""
    title.Parent = bottomBar

    local subtitle = Instance.new("TextLabel")
    subtitle.Name = "VignetteSubtitle"
    subtitle.BackgroundTransparency = 1
    subtitle.AnchorPoint = Vector2.new(0.5, 0)
    subtitle.Position = UDim2.new(0.5, 0, 1, 6)
    subtitle.Size = UDim2.new(0.9, 0, 0, 22)
    subtitle.Font = Enum.Font.Gotham
    subtitle.TextSize = 15
    subtitle.TextColor3 = Color3.fromRGB(214, 182, 118)
    subtitle.TextTransparency = 1
    subtitle.Text = ""
    subtitle.Parent = bottomBar

    return setmetatable({
        _gui = gui,
        _topBar = topBar,
        _bottomBar = bottomBar,
        _title = title,
        _subtitle = subtitle,
        _playing = false,
        _compact = false,
        _skipConnection = nil,
    }, VignetteController)
end

function VignetteController.setCompact(self: VignetteController, compact: boolean)
    self._compact = compact
end

function VignetteController._restore(self: VignetteController, camera: Camera)
    if self._skipConnection ~= nil then
        self._skipConnection:Disconnect()
        self._skipConnection = nil
    end
    local player = Players.LocalPlayer
    local character = player.Character
    local humanoid = if character ~= nil then character:FindFirstChildOfClass("Humanoid") else nil
    camera.CameraType = Enum.CameraType.Custom
    if humanoid ~= nil then
        camera.CameraSubject = humanoid
    end
    self._gui.Enabled = false
    self._playing = false
end

function VignetteController.play(self: VignetteController, shot: Shot)
    if self._playing or self._compact then
        return
    end
    local player = Players.LocalPlayer
    if player:GetAttribute("LastLightDowned") == true then
        return
    end
    local character = player.Character
    local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
    local camera = workspace.CurrentCamera
    if root == nil or not root:IsA("BasePart") or camera == nil then
        return
    end
    self._playing = true

    -- Frame the threat from the player's side of it, high enough to clear
    -- ground clutter, and push in slowly. All offsets are derived, so the
    -- same shot works in the town square and the expedition.
    local focus = shot.focus
    local toPlayer = root.Position - focus
    local flat = Vector3.new(toPlayer.X, 0, toPlayer.Z)
    local direction = if flat.Magnitude > 1 then flat.Unit else Vector3.new(0, 0, 1)
    -- A wider start and a longer travel, so a five-second shot is still
    -- moving when it ends rather than arriving in two and sitting there.
    local startFrame =
        CFrame.lookAt(focus + direction * 46 + Vector3.new(0, 19, 0), focus + Vector3.new(0, 3, 0))
    local endFrame =
        CFrame.lookAt(focus + direction * 19 + Vector3.new(0, 8, 0), focus + Vector3.new(0, 3, 0))

    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = startFrame

    self._gui.Enabled = true
    self._topBar.Size = UDim2.fromScale(1, 0)
    self._bottomBar.Size = UDim2.fromScale(1, 0)
    self._title.Text = shot.title
    self._subtitle.Text = shot.subtitle
    self._title.TextTransparency = 1
    self._subtitle.TextTransparency = 1

    TweenService:Create(self._topBar, EASE, { Size = UDim2.fromScale(1, BAR_HEIGHT) }):Play()
    TweenService:Create(self._bottomBar, EASE, { Size = UDim2.fromScale(1, BAR_HEIGHT) }):Play()
    TweenService:Create(self._title, EASE, { TextTransparency = 0 }):Play()
    TweenService:Create(self._subtitle, EASE, { TextTransparency = 0.15 }):Play()
    TweenService:Create(
        camera,
        TweenInfo.new(shot.duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        { CFrame = endFrame }
    ):Play()

    local finished = false
    local function finish()
        if finished then
            return
        end
        finished = true
        self:_restore(camera)
    end
    -- Any input returns the camera immediately: the vignette must never cost
    -- a player who wants their hands back more than a keypress.
    self._skipConnection = UserInputService.InputBegan:Connect(function(_input, processed)
        if not processed then
            finish()
        end
    end)
    task.delay(shot.duration, finish)
end

return table.freeze(VignetteController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">WeatherController</string>
              <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local WeatherController = {}
WeatherController.__index = WeatherController

type Streak = {
    drift: number,
    offset: Vector3,
    part: Part,
    speed: number,
}

export type WeatherController = typeof(setmetatable(
    {} :: {
        _profile: any,
        _folder: Folder,
        _streaks: { Streak },
        _active: boolean,
        _phase: string,
        _weather: any,
        _elapsed: number,
        _connection: RBXScriptConnection?,
    },
    WeatherController
))

local MAX_STREAKS = 18
local UPDATE_INTERVAL = 1 / 24
local FLOOR = -12
local CEILING = 28

function WeatherController.new(profile: any): WeatherController
    local folder = Instance.new("Folder")
    folder.Name = "LastLightLocalWeather"
    folder.Parent = Workspace

    local random = Random.new(1847)
    local streaks: { Streak } = {}
    for _ = 1, MAX_STREAKS do
        local streak = Instance.new("Part")
        streak.Name = "BramblewakeRain"
        streak.Anchored = true
        streak.CanCollide = false
        streak.CanQuery = false
        streak.CanTouch = false
        streak.CastShadow = false
        streak.Color = Color3.fromRGB(163, 193, 201)
        streak.Material = Enum.Material.Glass
        streak.Size = Vector3.new(0.045, random:NextNumber(3.8, 6.2), 0.045)
        streak.Transparency = 1
        streak.Parent = folder
        table.insert(streaks, {
            drift = random:NextNumber(-1.8, -0.7),
            offset = Vector3.new(
                random:NextNumber(-28, 28),
                random:NextNumber(FLOOR, CEILING),
                random:NextNumber(-34, 18)
            ),
            part = streak,
            speed = random:NextNumber(44, 62),
        })
    end

    local self = setmetatable({
        _profile = profile,
        _folder = folder,
        _streaks = streaks,
        _active = false,
        _phase = "day",
        _weather = profile.contractWeather(nil),
        _elapsed = 0,
        _connection = nil,
    }, WeatherController)

    local accumulator = 0
    self._connection = RunService.RenderStepped:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < UPDATE_INTERVAL then
            return
        end
        local elapsed = accumulator
        accumulator = 0
        self:_step(elapsed)
    end)
    return self
end

function WeatherController.setContext(
    self: WeatherController,
    expeditionActive: boolean,
    phase: string,
    weatherKind: string?
)
    self._active = expeditionActive
    self._phase = string.lower(phase)
    self._weather = self._profile.contractWeather(weatherKind)
    if not expeditionActive then
        for _, streak in self._streaks do
            streak.part.Transparency = 1
        end
    end
end

function WeatherController._step(self: WeatherController, deltaTime: number)
    if not self._active then
        return
    end
    self._elapsed += deltaTime
    local camera = Workspace.CurrentCamera
    if camera == nil then
        return
    end
    local cameraPosition = camera.CFrame.Position
    local weather = self._weather
    local visibleCount = math.min(
        MAX_STREAKS,
        math.floor(self._profile.streakCount(self._phase) * weather.countScale)
    )
    local weatherColor = Color3.fromRGB(weather.color[1], weather.color[2], weather.color[3])
    for index, streak in self._streaks do
        local nextY = self._profile.wrapHeight(
            streak.offset.Y - streak.speed * weather.speedScale * deltaTime,
            FLOOR,
            CEILING
        )
        streak.offset = Vector3.new(streak.offset.X, nextY, streak.offset.Z)
        local wind = math.sin(self._elapsed * 0.43 + index) * 0.55
        local fallDrift = (CEILING - nextY) * 0.22 * streak.drift
        local position = cameraPosition + streak.offset + Vector3.new(fallDrift + wind, 0, 0)
        streak.part.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(-7))
        streak.part.Color = weatherColor
        streak.part.Transparency = if index <= visibleCount then weather.transparency else 1
    end
end

return WeatherController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">WorldMotionController</string>
              <string name="Source"><![CDATA[--!strict

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local WorldMotionController = {}
WorldMotionController.__index = WorldMotionController

type MotionState = {
    basePivot: CFrame,
    kind: string,
    lastPivot: CFrame,
    poseOffset: CFrame,
    position: Vector3,
    phaseOffset: number,
    speed: number,
    active: boolean,
}

type LightState = {
    baseSize: Vector3,
    baseTransparency: number,
    baseBrightness: number?,
    baseRange: number?,
    phaseOffset: number,
    active: boolean,
}

type SwayState = {
    baseCFrame: CFrame,
    phaseOffset: number,
    position: Vector3,
    active: boolean,
}

export type WorldMotionController = typeof(setmetatable(
    {} :: {
        _motionTag: string,
        _lightTag: string,
        _swayTag: string,
        _ambientMotion: any,
        _motions: { [Model]: MotionState },
        _lights: { [BasePart]: LightState },
        _sways: { [BasePart]: SwayState },
        _phase: string,
        _elapsed: number,
        _connection: RBXScriptConnection?,
    },
    WorldMotionController
))

local ACTIVE_DISTANCE = 190
local SWAY_DISTANCE = 125
local UPDATE_INTERVAL = 1 / 20

local function phaseOffsetFor(instance: Instance): number
    local pivot = if instance:IsA("Model")
        then instance:GetPivot()
        else (instance :: BasePart).CFrame
    local position = pivot.Position
    return math.abs(position.X * 0.053 + position.Y * 0.127 + position.Z * 0.079) % (math.pi * 2)
end

function WorldMotionController.new(
    motionTag: string,
    lightTag: string,
    swayTag: string,
    ambientMotion: any
): WorldMotionController
    local self = setmetatable({
        _motionTag = motionTag,
        _lightTag = lightTag,
        _swayTag = swayTag,
        _ambientMotion = ambientMotion,
        _motions = {},
        _lights = {},
        _sways = {},
        _phase = "day",
        _elapsed = 0,
        _connection = nil,
    }, WorldMotionController)

    local function registerMotion(instance: Instance)
        if not instance:IsA("Model") or self._motions[instance] ~= nil then
            return
        end
        local pivot = instance:GetPivot()
        self._motions[instance] = {
            basePivot = pivot,
            kind = tostring(instance:GetAttribute("MotionKind") or "rotor"),
            lastPivot = pivot,
            poseOffset = CFrame.identity,
            position = pivot.Position,
            phaseOffset = phaseOffsetFor(instance),
            speed = math.max(0, tonumber(instance:GetAttribute("MotionSpeed")) or 0.34),
            active = false,
        }
    end
    local function unregisterMotion(instance: Instance)
        if instance:IsA("Model") then
            self._motions[instance] = nil
        end
    end
    local function registerLight(instance: Instance)
        if not instance:IsA("BasePart") or self._lights[instance] ~= nil then
            return
        end
        local pointLight = instance:FindFirstChildOfClass("PointLight")
        self._lights[instance] = {
            baseSize = instance.Size,
            baseTransparency = instance.Transparency,
            baseBrightness = if pointLight == nil then nil else pointLight.Brightness,
            baseRange = if pointLight == nil then nil else pointLight.Range,
            phaseOffset = phaseOffsetFor(instance),
            active = false,
        }
    end
    local function unregisterLight(instance: Instance)
        if instance:IsA("BasePart") then
            self._lights[instance] = nil
        end
    end
    local function registerSway(instance: Instance)
        if not instance:IsA("BasePart") or self._sways[instance] ~= nil then
            return
        end
        self._sways[instance] = {
            baseCFrame = instance.CFrame,
            phaseOffset = phaseOffsetFor(instance),
            position = instance.Position,
            active = false,
        }
    end
    local function unregisterSway(instance: Instance)
        if instance:IsA("BasePart") then
            self._sways[instance] = nil
        end
    end

    for _, instance in CollectionService:GetTagged(motionTag) do
        registerMotion(instance)
    end
    for _, instance in CollectionService:GetTagged(lightTag) do
        registerLight(instance)
    end
    for _, instance in CollectionService:GetTagged(swayTag) do
        registerSway(instance)
    end
    CollectionService:GetInstanceAddedSignal(motionTag):Connect(registerMotion)
    CollectionService:GetInstanceRemovedSignal(motionTag):Connect(unregisterMotion)
    CollectionService:GetInstanceAddedSignal(lightTag):Connect(registerLight)
    CollectionService:GetInstanceRemovedSignal(lightTag):Connect(unregisterLight)
    CollectionService:GetInstanceAddedSignal(swayTag):Connect(registerSway)
    CollectionService:GetInstanceRemovedSignal(swayTag):Connect(unregisterSway)

    local accumulator = 0
    self._connection = RunService.RenderStepped:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < UPDATE_INTERVAL then
            return
        end
        local elapsed = accumulator
        accumulator = 0
        self:_step(elapsed)
    end)
    return self
end

function WorldMotionController.setPhase(self: WorldMotionController, phase: string)
    self._phase = string.lower(phase)
end

function WorldMotionController._step(self: WorldMotionController, deltaTime: number)
    self._elapsed += deltaTime
    local camera = Workspace.CurrentCamera
    if camera == nil then
        return
    end
    local cameraPosition = camera.CFrame.Position

    for model, state in self._motions do
        if model.Parent == nil then
            self._motions[model] = nil
            continue
        end
        if state.kind == "resident" then
            --[[
                A resident the server has walked somewhere has to be re-based,
                but `current` is the POSED pivot -- base times the bob and turn
                applied last frame. Adopting it wholesale folds that offset into
                the new base, and then the next frame applies the pose on top of
                it again. While the server is moving a resident every frame, as
                the rescue walk does, that compounds once per frame and sinks
                her into the floor. Undoing the last pose first recovers the
                true standing base.
            ]]
            local current = model:GetPivot()
            if (current.Position - state.lastPivot.Position).Magnitude > 0.08 then
                state.basePivot = current * state.poseOffset:Inverse()
                state.lastPivot = current
                state.position = state.basePivot.Position
            end
        end
        local active = (state.position - cameraPosition).Magnitude <= ACTIVE_DISTANCE
        if active then
            local targetPivot: CFrame
            if state.kind == "resident" then
                local pose =
                    self._ambientMotion.residentPose(self._elapsed, state.speed, state.phaseOffset)
                state.poseOffset = CFrame.new(0, pose.height, 0) * CFrame.Angles(0, pose.yaw, 0)
                targetPivot = state.basePivot * state.poseOffset
            else
                local angle =
                    self._ambientMotion.rotorAngle(self._elapsed, state.speed, state.phaseOffset)
                targetPivot = state.basePivot * CFrame.Angles(0, 0, angle)
            end
            model:PivotTo(targetPivot)
            state.lastPivot = targetPivot
            state.active = true
        elseif state.active then
            model:PivotTo(state.basePivot)
            state.lastPivot = state.basePivot
            state.poseOffset = CFrame.identity
            state.active = false
        end
    end

    for glow, state in self._lights do
        if glow.Parent == nil then
            self._lights[glow] = nil
            continue
        end
        local active = (glow.Position - cameraPosition).Magnitude <= ACTIVE_DISTANCE
        local pointLight = glow:FindFirstChildOfClass("PointLight")
        if active then
            local level =
                self._ambientMotion.lightLevel(self._elapsed, state.phaseOffset, self._phase)
            local sizeScale = 0.94 + level * 0.08
            glow.Size = state.baseSize * sizeScale
            -- An opt-in daytime fade for glows whose job is night navigation.
            -- lightLevel floors at 0.58, so the ordinary breathing above can
            -- never take a marker far enough down to stop shouting in
            -- daylight; this can.
            local daylightFade = glow:GetAttribute("DaylightFade")
            local fade = if self._phase == "day" and type(daylightFade) == "number"
                then daylightFade
                else 0
            glow.Transparency = math.clamp(
                state.baseTransparency + (1 - level) * 0.18 + (1 - state.baseTransparency) * fade,
                0.02,
                0.985
            )
            if pointLight ~= nil and state.baseBrightness ~= nil and state.baseRange ~= nil then
                pointLight.Brightness = state.baseBrightness * (0.72 + level * 0.3) * (1 - fade)
                pointLight.Range = state.baseRange * (0.94 + level * 0.05)
            end
            state.active = true
        elseif state.active then
            glow.Size = state.baseSize
            glow.Transparency = state.baseTransparency
            if pointLight ~= nil and state.baseBrightness ~= nil and state.baseRange ~= nil then
                pointLight.Brightness = state.baseBrightness
                pointLight.Range = state.baseRange
            end
            state.active = false
        end
    end

    for foliage, state in self._sways do
        if foliage.Parent == nil then
            self._sways[foliage] = nil
            continue
        end
        local active = (state.position - cameraPosition).Magnitude <= SWAY_DISTANCE
        if active then
            local wind = math.sin(self._elapsed * 1.18 + state.phaseOffset)
            local gust = math.sin(self._elapsed * 0.31 + state.phaseOffset * 0.47)
            local angle = math.rad(1.8 + if self._phase == "night" then 1.1 else 0.4)
            foliage.CFrame = state.baseCFrame
                * CFrame.Angles(wind * angle * 0.22, 0, (wind + gust * 0.35) * angle)
            state.active = true
        elseif state.active then
            foliage.CFrame = state.baseCFrame
            state.active = false
        end
    end
end

return WorldMotionController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
