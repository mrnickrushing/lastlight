        <string name="Name">LastLightServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local root = ReplicatedStorage:WaitForChild("LastLight", 8)
assert(root ~= nil, "Last Light shared root did not replicate before bootstrap timeout")

local Config = require(root.Config)
local BramblewakeExpedition = require(root.Content.Definitions.BramblewakeExpedition)
local CraftingCatalog = require(root.CraftingCatalog)
local Equipment = require(root.Equipment)
local BramblewakeEnemies = require(root.BramblewakeEnemies)
local CombatState = require(root.CombatState)
local EnemyAttackFlow = require(root.EnemyAttackFlow)
local EnemyCombatRules = require(root.EnemyCombatRules)
local EnemyMotion = require(root.EnemyMotion)
local Environment = require(root.Environment)
local ExpeditionEventFlow = require(root.ExpeditionEventFlow)
local ExpeditionGenerator = require(root.ExpeditionGenerator)
local ExpeditionRewardLedger = require(root.ExpeditionRewardLedger)
local NightSchedule = require(root.NightSchedule)
local OldGrowthEncounter = require(root.OldGrowthEncounter)
local WardenStagEncounter = require(root.WardenStagEncounter)
local BramblewakeBlackout = require(root.BramblewakeBlackout)
local ProfessionCatalog = require(root.ProfessionCatalog)
local ProfessionState = require(root.ProfessionState)
local RateLimiter = require(root.RateLimiter)
local ReviveFlow = require(root.ReviveFlow)
local RuntimeIds = require(root.RuntimeIds)
local SaveSchema = require(root.SaveSchema)
local StatusEffectState = require(root.StatusEffectState)
local SurvivalState = require(root.SurvivalState)
local TownNightSchedule = require(root.TownNightSchedule)
local TutorialFlow = require(root.TutorialFlow)
local Registry = require(root.Content.Registry)
local Regions = require(root.Content.Definitions.Regions)

local AnalyticsService = require(script.Services.AnalyticsService)
local EnemyService = require(script.Services.EnemyService)
local ExpeditionService = require(script.Services.ExpeditionService)
local Logger = require(script.Services.Logger)
local FeatureFlagService = require(script.Services.FeatureFlagService)
local NetworkService = require(script.Services.NetworkService)
local OldGrowthService = require(script.Services.OldGrowthService)
local WardenStagService = require(script.Services.WardenStagService)
local BramblewakeBlackoutService = require(script.Services.BramblewakeBlackoutService)
local PhaseService = require(script.Services.PhaseService)
local ProfileService = require(script.Services.ProfileService)
local TownNightService = require(script.Services.TownNightService)
local PlayerSurvivalService = require(script.Services.PlayerSurvivalService)
local PlayerCombatService = require(script.Services.PlayerCombatService)
local ProfessionService = require(script.Services.ProfessionService)
local TutorialService = require(script.Services.TutorialService)
local WorldService = require(script.Services.WorldService)
local ServiceRegistry = require(script.ServiceRegistry)
local BramblewakeEnemyBuilder = require(script.World.BramblewakeEnemyBuilder)
local OldGrowthBuilder = require(script.World.OldGrowthBuilder)
local WardenStagBuilder = require(script.World.WardenStagBuilder)

local environment, environmentError = Environment.resolve({
    isStudio = RunService:IsStudio(),
    placeId = game.PlaceId,
    requested = game:GetAttribute("LastLightEnvironment"),
    productionPlaceIds = Config.ProductionPlaceIds,
})
assert(environment ~= nil, environmentError)

local environmentConfig = Config.Environments[environment]
local logger = Logger.new(environment, environmentConfig.LogLevel)
local featureFlags =
    FeatureFlagService.new(Config.FeatureFlags, environmentConfig.AllowFlagOverrides, logger)
local content = Registry.new(Regions)
local networkService = NetworkService.new(logger)
local profileService = ProfileService.new(logger, environmentConfig.UsePersistentData)
local analyticsService = AnalyticsService.new(logger)
local worldService = WorldService.new(logger)
local expeditionService = ExpeditionService.new(
    logger,
    worldService,
    ExpeditionGenerator,
    BramblewakeExpedition,
    featureFlags,
    ExpeditionEventFlow,
    ExpeditionRewardLedger,
    profileService,
    analyticsService,
    Config.BramblewakePreviewSeed
)
local survivalService = PlayerSurvivalService.new(
    logger,
    Config,
    RuntimeIds,
    ReviveFlow,
    SurvivalState,
    featureFlags,
    worldService,
    analyticsService
)
local combatService = PlayerCombatService.new(
    logger,
    Config,
    CombatState,
    StatusEffectState,
    featureFlags,
    survivalService,
    analyticsService
)
local professionService = ProfessionService.new(
    logger,
    ProfessionCatalog,
    ProfessionState,
    featureFlags,
    profileService,
    survivalService,
    analyticsService
)
local enemyService = EnemyService.new(
    logger,
    Config,
    worldService,
    survivalService,
    combatService,
    EnemyAttackFlow,
    BramblewakeEnemies,
    EnemyCombatRules,
    EnemyMotion,
    BramblewakeEnemyBuilder,
    analyticsService
)
professionService:setEnemyService(enemyService)
enemyService:setProfessionService(professionService)
local oldGrowthService = OldGrowthService.new(
    logger,
    worldService,
    expeditionService,
    survivalService,
    combatService,
    professionService,
    OldGrowthEncounter,
    EnemyAttackFlow,
    EnemyCombatRules,
    OldGrowthBuilder,
    analyticsService,
    featureFlags
)
enemyService:setEliteService(oldGrowthService)
local wardenStagService = WardenStagService.new(
    logger,
    worldService,
    expeditionService,
    survivalService,
    combatService,
    professionService,
    oldGrowthService,
    WardenStagEncounter,
    EnemyAttackFlow,
    EnemyCombatRules,
    WardenStagBuilder,
    analyticsService,
    featureFlags
)
enemyService:setBossService(wardenStagService)
local blackoutService = BramblewakeBlackoutService.new(
    logger,
    Config,
    worldService,
    expeditionService,
    profileService,
    survivalService,
    oldGrowthService,
    wardenStagService,
    BramblewakeBlackout,
    analyticsService,
    featureFlags
)
oldGrowthService:setActivationGate(function(): boolean
    return blackoutService:allowsOldGrowth()
end)
wardenStagService:setUnlockGate(function(): boolean
    return blackoutService:allowsWarden()
end)
local phaseService = PhaseService.new(
    logger,
    worldService,
    enemyService,
    NightSchedule,
    Config.FirstNightDuskSeconds,
    Config.FirstNightSeconds
)
local townNightService = TownNightService.new(
    logger,
    Config,
    worldService,
    enemyService,
    TownNightSchedule,
    featureFlags
)
professionService:setSwitchProvider(function(player: Player): (boolean, string?)
    local profile = profileService:get(player)
    if profile == nil or profile.tutorial.complete ~= true then
        return false, "COMPLETE FIRST LIGHT TO CHOOSE A PROFESSION"
    end
    if phaseService:snapshot().nightActive or townNightService:isNightActive() then
        return false, "RETURN TO DAYLIGHT BEFORE SWITCHING PROFESSION"
    end
    if expeditionService:snapshot(player).active then
        return false, "RETURN THROUGH THE WAYHOME GATE BEFORE SWITCHING"
    end
    return true, nil
end)
local tutorialService = TutorialService.new(
    logger,
    Config,
    RuntimeIds,
    TutorialFlow,
    RateLimiter,
    networkService,
    profileService,
    worldService,
    enemyService,
    survivalService,
    combatService,
    professionService,
    phaseService,
    townNightService,
    expeditionService,
    oldGrowthService,
    wardenStagService,
    blackoutService,
    analyticsService,
    CraftingCatalog,
    Equipment
)

local services = ServiceRegistry.new({
    environment = environment,
    logger = logger,
    featureFlags = featureFlags,
    content = content,
    runtimeIds = RuntimeIds,
    saveSchema = SaveSchema,
})
services:register(featureFlags)
services:register(networkService)
services:register(profileService)
services:register(analyticsService)
services:register(worldService)
services:register(expeditionService)
services:register(survivalService)
services:register(combatService)
services:register(professionService)
services:register(enemyService)
services:register(oldGrowthService)
services:register(wardenStagService)
services:register(blackoutService)
services:register(phaseService)
services:register(townNightService)
services:register(tutorialService)
services:initialize()
services:start()

logger:info("server_boot_complete", {
    build = Config.BuildVersion,
    contentDefinitions = content:count(),
    environment = environment,
    services = services:count(),
})
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">ServiceRegistry</string>
          <string name="Source"><![CDATA[--!strict

local ServiceRegistry = {}
ServiceRegistry.__index = ServiceRegistry

export type Service = {
    Name: string,
    Init: ((self: any, context: any) -> ())?,
    Start: ((self: any) -> ())?,
}

export type Registry = typeof(setmetatable(
    {} :: {
        _context: any,
        _ordered: { Service },
        _byName: { [string]: Service },
        _state: string,
    },
    ServiceRegistry
))

function ServiceRegistry.new(context: any): Registry
    return setmetatable({
        _context = context,
        _ordered = {},
        _byName = {},
        _state = "registering",
    }, ServiceRegistry)
end

function ServiceRegistry.register(self: Registry, service: Service)
    assert(self._state == "registering", "services can only register before initialization")
    assert(type(service.Name) == "string" and service.Name ~= "", "service must have a Name")
    assert(self._byName[service.Name] == nil, "duplicate service " .. service.Name)

    self._byName[service.Name] = service
    table.insert(self._ordered, service)
end

function ServiceRegistry.get(self: Registry, name: string): Service?
    return self._byName[name]
end

function ServiceRegistry.initialize(self: Registry)
    assert(self._state == "registering", "service registry already initialized")
    self._state = "initializing"

    for _, service in self._ordered do
        local initialize = service.Init
        if initialize ~= nil then
            local ok, message = xpcall(function()
                initialize(service, self._context)
            end, debug.traceback)
            if not ok then
                self._state = "failed"
                error(string.format("service %s failed to initialize: %s", service.Name, message))
            end
        end
    end

    self._state = "initialized"
end

function ServiceRegistry.start(self: Registry)
    assert(self._state == "initialized", "services must initialize before start")
    self._state = "starting"

    for _, service in self._ordered do
        local start = service.Start
        if start ~= nil then
            local ok, message = xpcall(function()
                start(service)
            end, debug.traceback)
            if not ok then
                self._state = "failed"
                error(string.format("service %s failed to start: %s", service.Name, message))
            end
        end
    end

    self._state = "started"
end

function ServiceRegistry.state(self: Registry): string
    return self._state
end

function ServiceRegistry.count(self: Registry): number
    return #self._ordered
end

return table.freeze(ServiceRegistry)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="47">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source"><![CDATA[--!strict

local RobloxAnalytics = game:GetService("AnalyticsService")
local RunService = game:GetService("RunService")

local AnalyticsService = {}
AnalyticsService.__index = AnalyticsService
AnalyticsService.Name = "AnalyticsService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type AnalyticsService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _startedAt: { [Player]: number },
        _expeditionStarted: { [Player]: boolean },
    },
    AnalyticsService
))

function AnalyticsService.new(logger: Logger): AnalyticsService
    return setmetatable({
        Name = AnalyticsService.Name,
        _logger = logger,
        _startedAt = {},
        _expeditionStarted = {},
    }, AnalyticsService)
end

function AnalyticsService.Init(_self: AnalyticsService, _context: any) end

function AnalyticsService.Start(_self: AnalyticsService) end

function AnalyticsService.stage(self: AnalyticsService, player: Player, step: number, stage: string)
    if self._startedAt[player] == nil then
        self._startedAt[player] = os.clock()
    end

    self._logger:info("tutorial_funnel_step", {
        player = player.UserId,
        stage = stage,
        step = step,
    })

    if not RunService:IsStudio() then
        local ok, message = pcall(function()
            RobloxAnalytics:LogOnboardingFunnelStepEvent(player, step, stage, {})
        end)
        if not ok then
            self._logger:warn("analytics_funnel_failed", {
                player = player.UserId,
                reason = tostring(message),
                stage = stage,
            })
        end
    end
end

function AnalyticsService.complete(self: AnalyticsService, player: Player)
    local startedAt = self._startedAt[player]
    local elapsed = if startedAt == nil then 0 else math.floor(os.clock() - startedAt)
    self._logger:info("tutorial_completed", {
        durationSeconds = elapsed,
        player = player.UserId,
    })

    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "FirstLightCompleted", math.max(1, elapsed), {})
        end)
    end
end

function AnalyticsService.expeditionStarted(self: AnalyticsService, player: Player, snapshot: any)
    if self._expeditionStarted[player] then
        return
    end
    self._expeditionStarted[player] = true

    self._logger:info("expedition_started", {
        hash = snapshot.manifestHash,
        player = player.UserId,
        region = "region_bramblewake",
        seed = snapshot.seed,
        source = snapshot.source,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "BramblewakeExpeditionStarted", 1, {})
        end)
    end
end

function AnalyticsService.expeditionEventStarted(
    self: AnalyticsService,
    player: Player,
    definition: any,
    manifestHash: string
)
    self._logger:info("expedition_event_started", {
        event = definition.id,
        hash = manifestHash,
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, definition.analyticsId .. "Started", 1, {})
        end)
    end
end

function AnalyticsService.expeditionEventCompleted(
    self: AnalyticsService,
    player: Player,
    definition: any,
    manifestHash: string,
    transactionId: string,
    participantCount: number
)
    self._logger:info("expedition_event_completed", {
        event = definition.id,
        hash = manifestHash,
        participantCount = participantCount,
        player = player.UserId,
        transaction = transactionId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(
                player,
                definition.analyticsId .. "Completed",
                math.max(1, participantCount),
                {}
            )
        end)
    end
end

function AnalyticsService.expeditionEventFailed(
    self: AnalyticsService,
    eventId: string,
    manifestHash: string,
    participantCount: number
)
    self._logger:info("expedition_event_failed", {
        event = eventId,
        hash = manifestHash,
        participantCount = participantCount,
        reason = "expired",
    })
end

function AnalyticsService.expeditionExtracted(
    self: AnalyticsService,
    player: Player,
    manifestHash: string,
    settlementId: string?,
    bankedAmount: number
)
    self._logger:info("expedition_extracted", {
        bankedAmount = bankedAmount,
        hash = manifestHash,
        player = player.UserId,
        settlement = settlementId or "empty",
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(
                player,
                "BramblewakeExtracted",
                math.max(1, bankedAmount),
                {}
            )
        end)
    end
end

function AnalyticsService.expeditionExtractionFailed(
    self: AnalyticsService,
    player: Player,
    manifestHash: string,
    reason: string?
)
    self._logger:warn("expedition_extraction_failed", {
        hash = manifestHash,
        player = player.UserId,
        reason = reason or "unknown",
    })
end

function AnalyticsService.playerDowned(self: AnalyticsService, player: Player, source: string)
    self._logger:info("player_downed", {
        player = player.UserId,
        source = source,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "PlayerDowned", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = source,
            })
        end)
    end
end

function AnalyticsService.playerRevived(
    self: AnalyticsService,
    player: Player,
    reviver: Player,
    duration: number
)
    self._logger:info("player_revived", {
        duration = duration,
        player = player.UserId,
        reviver = reviver.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "PlayerRevived", 1, {})
        end)
    end
end

function AnalyticsService.playerRecovered(self: AnalyticsService, player: Player, reason: string)
    self._logger:info("player_recovered", {
        player = player.UserId,
        reason = reason,
    })
end

function AnalyticsService.combatAction(
    self: AnalyticsService,
    player: Player,
    action: string,
    applied: boolean,
    reason: string?,
    stamina: number
)
    self._logger:info("combat_action", {
        action = action,
        applied = applied,
        player = player.UserId,
        reason = reason or "accepted",
        stamina = math.floor(stamina + 0.5),
    })
    if applied and action == "dodge" and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "CombatDodgeUsed", 1, {})
        end)
    end
end

function AnalyticsService.enemyAttackResult(
    self: AnalyticsService,
    player: Player,
    result: string,
    enemyId: string?
)
    local resolvedEnemyId = string.sub(enemyId or "enemy_unknown", 1, 48)
    self._logger:info("enemy_attack_result", {
        enemy = resolvedEnemyId,
        player = player.UserId,
        result = result,
    })
    if result == "dodged" and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "EnemyAttackDodged", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = resolvedEnemyId,
            })
        end)
    end
end

function AnalyticsService.professionSelected(
    self: AnalyticsService,
    player: Player,
    professionId: string,
    accepted: boolean,
    reason: string?
)
    self._logger:info("profession_selected", {
        accepted = accepted,
        player = player.UserId,
        profession = string.sub(professionId, 1, 32),
        reason = reason or "accepted",
    })
    if accepted and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "ProfessionSelected", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = professionId,
            })
        end)
    end
end

function AnalyticsService.professionAbility(
    self: AnalyticsService,
    player: Player,
    professionId: string,
    accepted: boolean,
    reason: string?,
    affected: number
)
    self._logger:info("profession_ability", {
        accepted = accepted,
        affected = affected,
        player = player.UserId,
        profession = string.sub(professionId, 1, 32),
        reason = reason or "accepted",
    })
    if accepted and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "ProfessionAbilityUsed", math.max(1, affected), {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = professionId,
            })
        end)
    end
end

function AnalyticsService.crafted(
    self: AnalyticsService,
    player: Player,
    recipeId: string,
    accepted: boolean,
    reason: string?
)
    self._logger:info("item_crafted", {
        accepted = accepted,
        player = player.UserId,
        reason = reason or "accepted",
        recipe = string.sub(recipeId, 1, 32),
    })
    if accepted and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "ItemCrafted", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = recipeId,
            })
        end)
    end
end

function AnalyticsService.usedGear(
    self: AnalyticsService,
    player: Player,
    itemId: string,
    accepted: boolean,
    reason: string?
)
    self._logger:info("gear_used", {
        accepted = accepted,
        item = string.sub(itemId, 1, 32),
        player = player.UserId,
        reason = reason or "accepted",
    })
    if accepted and not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "GearUsed", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = itemId,
            })
        end)
    end
end

function AnalyticsService.questClaimed(self: AnalyticsService, player: Player, questId: string)
    self._logger:info("quest_claimed", {
        player = player.UserId,
        quest = string.sub(questId, 1, 48),
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "QuestClaimed", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = questId,
            })
        end)
    end
end

function AnalyticsService.eliteStarted(
    self: AnalyticsService,
    player: Player,
    eliteId: string,
    manifestHash: string
)
    self._logger:info("elite_started", {
        elite = string.sub(eliteId, 1, 48),
        hash = manifestHash,
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "EliteEncounterStarted", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = eliteId,
            })
        end)
    end
end

function AnalyticsService.eliteAttackTelegraphed(
    self: AnalyticsService,
    player: Player,
    eliteId: string,
    attackId: string,
    shape: string,
    windup: number
)
    self._logger:info("elite_attack_telegraphed", {
        attack = string.sub(attackId, 1, 48),
        elite = string.sub(eliteId, 1, 48),
        player = player.UserId,
        shape = shape,
        windup = windup,
    })
end

function AnalyticsService.eliteAttackResult(
    self: AnalyticsService,
    player: Player,
    eliteId: string,
    attackId: string,
    result: string
)
    self._logger:info("elite_attack_result", {
        attack = string.sub(attackId, 1, 48),
        elite = string.sub(eliteId, 1, 48),
        player = player.UserId,
        result = string.sub(result, 1, 32),
    })
end

function AnalyticsService.elitePhase(
    self: AnalyticsService,
    player: Player,
    eliteId: string,
    phase: number,
    result: string
)
    self._logger:info("elite_phase", {
        elite = string.sub(eliteId, 1, 48),
        phase = phase,
        player = player.UserId,
        result = string.sub(result, 1, 32),
    })
end

function AnalyticsService.eliteCompleted(
    self: AnalyticsService,
    player: Player,
    eliteId: string,
    manifestHash: string,
    shieldsBurned: number,
    participantCount: number
)
    self._logger:info("elite_completed", {
        elite = string.sub(eliteId, 1, 48),
        hash = manifestHash,
        participantCount = participantCount,
        player = player.UserId,
        shieldsBurned = shieldsBurned,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(
                player,
                "EliteEncounterCompleted",
                math.max(1, participantCount),
                {
                    [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = eliteId,
                }
            )
        end)
    end
end

function AnalyticsService.bossStarted(
    self: AnalyticsService,
    player: Player,
    bossId: string,
    manifestHash: string
)
    self._logger:info("boss_started", {
        boss = string.sub(bossId, 1, 48),
        hash = manifestHash,
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "BossEncounterStarted", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = bossId,
            })
        end)
    end
end

function AnalyticsService.bossAttackTelegraphed(
    self: AnalyticsService,
    player: Player,
    bossId: string,
    attackId: string,
    shape: string,
    windup: number
)
    self._logger:info("boss_attack_telegraphed", {
        attack = string.sub(attackId, 1, 48),
        boss = string.sub(bossId, 1, 48),
        player = player.UserId,
        shape = shape,
        windup = windup,
    })
end

function AnalyticsService.bossAttackResult(
    self: AnalyticsService,
    player: Player,
    bossId: string,
    attackId: string,
    result: string
)
    self._logger:info("boss_attack_result", {
        attack = string.sub(attackId, 1, 48),
        boss = string.sub(bossId, 1, 48),
        player = player.UserId,
        result = string.sub(result, 1, 32),
    })
end

function AnalyticsService.bossPhase(
    self: AnalyticsService,
    player: Player,
    bossId: string,
    phase: number,
    result: string,
    antlersBroken: number
)
    self._logger:info("boss_phase", {
        antlersBroken = antlersBroken,
        boss = string.sub(bossId, 1, 48),
        phase = phase,
        player = player.UserId,
        result = string.sub(result, 1, 32),
    })
end

function AnalyticsService.bossResult(
    self: AnalyticsService,
    player: Player,
    bossId: string,
    manifestHash: string,
    outcome: string?,
    antlersBroken: number,
    participantCount: number
)
    self._logger:info("boss_result", {
        antlersBroken = antlersBroken,
        boss = string.sub(bossId, 1, 48),
        hash = manifestHash,
        outcome = string.sub(outcome or "unknown", 1, 32),
        participantCount = participantCount,
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(
                player,
                "BossEncounterCompleted",
                math.max(1, participantCount),
                {
                    [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = bossId,
                    [Enum.AnalyticsCustomFieldKeys.CustomField02.Name] = outcome or "unknown",
                }
            )
        end)
    end
end

function AnalyticsService.blackoutStarted(
    self: AnalyticsService,
    player: Player,
    blackoutId: string,
    manifestHash: string,
    duration: number
)
    self._logger:info("blackout_started", {
        blackout = string.sub(blackoutId, 1, 48),
        duration = duration,
        hash = manifestHash,
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "BramblewakeBlackoutStarted", 1, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = blackoutId,
            })
        end)
    end
end

function AnalyticsService.blackoutStage(
    self: AnalyticsService,
    player: Player,
    blackoutId: string,
    stage: string,
    reason: string,
    revision: number
)
    self._logger:info("blackout_stage", {
        blackout = string.sub(blackoutId, 1, 48),
        player = player.UserId,
        reason = string.sub(reason, 1, 48),
        revision = revision,
        stage = string.sub(stage, 1, 32),
    })
end

function AnalyticsService.blackoutResult(
    self: AnalyticsService,
    player: Player,
    blackoutId: string,
    manifestHash: string,
    decision: string?,
    wardenOutcome: string?,
    startedAt: number?,
    completedAt: number
)
    local duration = if startedAt == nil then 0 else math.max(0, completedAt - startedAt)
    self._logger:info("blackout_result", {
        blackout = string.sub(blackoutId, 1, 48),
        decision = string.sub(decision or "unknown", 1, 32),
        duration = math.floor(duration + 0.5),
        hash = manifestHash,
        outcome = string.sub(wardenOutcome or "unknown", 1, 32),
        player = player.UserId,
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(
                player,
                "BramblewakeBlackoutCompleted",
                math.max(1, math.floor(duration + 0.5)),
                {
                    [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = decision or "unknown",
                    [Enum.AnalyticsCustomFieldKeys.CustomField02.Name] = wardenOutcome or "unknown",
                }
            )
        end)
    end
end

function AnalyticsService.chapterCompleted(
    self: AnalyticsService,
    player: Player,
    chapter: number,
    decision: string,
    wardenOutcome: string,
    transactionId: string
)
    self._logger:info("chapter_completed", {
        chapter = chapter,
        decision = string.sub(decision, 1, 32),
        outcome = string.sub(wardenOutcome, 1, 32),
        player = player.UserId,
        transaction = string.sub(transactionId, 1, 160),
    })
    if not RunService:IsStudio() then
        pcall(function()
            RobloxAnalytics:LogCustomEvent(player, "ChapterCompleted", chapter, {
                [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = decision,
                [Enum.AnalyticsCustomFieldKeys.CustomField02.Name] = wardenOutcome,
            })
        end)
    end
end

function AnalyticsService.clear(self: AnalyticsService, player: Player)
    self._startedAt[player] = nil
    self._expeditionStarted[player] = nil
end

return table.freeze(AnalyticsService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">BramblewakeBlackoutService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local BramblewakeBlackoutService = {}
BramblewakeBlackoutService.__index = BramblewakeBlackoutService
BramblewakeBlackoutService.Name = "BramblewakeBlackoutService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type BramblewakeBlackoutService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _worldService: any,
        _expeditionService: any,
        _profileService: any,
        _survivalService: any,
        _oldGrowthService: any,
        _wardenStagService: any,
        _flow: any,
        _analyticsService: any,
        _featureFlags: any,
        _state: any,
        _arena: any,
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
        _lastPublishedSecond: number,
        _persistedUsers: { [number]: boolean },
    },
    BramblewakeBlackoutService
))

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

function BramblewakeBlackoutService.new(
    logger: Logger,
    config: any,
    worldService: any,
    expeditionService: any,
    profileService: any,
    survivalService: any,
    oldGrowthService: any,
    wardenStagService: any,
    flow: any,
    analyticsService: any,
    featureFlags: any
): BramblewakeBlackoutService
    return setmetatable({
        Name = BramblewakeBlackoutService.Name,
        _logger = logger,
        _config = config,
        _worldService = worldService,
        _expeditionService = expeditionService,
        _profileService = profileService,
        _survivalService = survivalService,
        _oldGrowthService = oldGrowthService,
        _wardenStagService = wardenStagService,
        _flow = flow,
        _analyticsService = analyticsService,
        _featureFlags = featureFlags,
        _state = nil,
        _arena = nil,
        _onChanged = nil,
        _heartbeat = nil,
        _lastPublishedSecond = -1,
        _persistedUsers = {},
    }, BramblewakeBlackoutService)
end

function BramblewakeBlackoutService.Init(self: BramblewakeBlackoutService, _context: any)
    local manifest = assert(self._expeditionService:manifest(), "expedition manifest unavailable")
    self._arena = assert(self._worldService:blackoutArena(), "Blackout arena unavailable")
    self._state = self._flow.create(
        self._expeditionService:runId(),
        manifest.hash,
        self._featureFlags:isEnabled("bramblewake_blackout_enabled"),
        self._config.BlackoutNightSeconds
    )
    self._worldService:setBlackoutPresentation(self._state)
end

function BramblewakeBlackoutService.Start(self: BramblewakeBlackoutService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.1 then
            return
        end
        accumulator = 0
        self:_step(workspace:GetServerTimeNow())
    end)
    self._logger:info("bramblewake_blackout_ready", {
        duration = self._config.BlackoutNightSeconds,
        enabled = self._state.status ~= "disabled",
        interval = self._config.BlackoutInterval,
        manifest = self._state.manifestHash,
    })
end

function BramblewakeBlackoutService.setChangedHandler(
    self: BramblewakeBlackoutService,
    callback: (string?) -> ()
)
    self._onChanged = callback
end

function BramblewakeBlackoutService._notify(self: BramblewakeBlackoutService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function BramblewakeBlackoutService._syncCarrierVisuals(
    self: BramblewakeBlackoutService,
    now: number
)
    for _, player in Players:GetPlayers() do
        local snapshot = self._flow.snapshot(self._state, player.UserId, now)
        player:SetAttribute("LastLightCarryingBlackoutFire", snapshot.carryingFire)
        player:SetAttribute("LastLightBlackoutFireExpiresAt", snapshot.fireExpiresAt)
        local root = rootPart(player)
        if root ~= nil then
            local light = root:FindFirstChild("BlackoutCarryLight")
            if snapshot.carryingFire and light == nil then
                local pointLight = Instance.new("PointLight")
                pointLight.Name = "BlackoutCarryLight"
                pointLight.Color = Color3.fromRGB(255, 146, 78)
                pointLight.Brightness = 2.4
                pointLight.Range = 20
                pointLight.Shadows = false
                pointLight.Parent = root
            elseif not snapshot.carryingFire and light ~= nil then
                light:Destroy()
            end
        end
    end
end

function BramblewakeBlackoutService._activeParticipantIds(
    self: BramblewakeBlackoutService
): { number }
    local result = {}
    for _, player in Players:GetPlayers() do
        if
            player:GetAttribute("LastLightInExpedition") == true
            and self._state.participants[tostring(player.UserId)] == true
        then
            table.insert(result, player.UserId)
        end
    end
    table.sort(result)
    return result
end

function BramblewakeBlackoutService._persistResolution(self: BramblewakeBlackoutService)
    if
        self._state.status ~= "complete"
        or self._state.decision == nil
        or self._state.wardenOutcome == nil
    then
        return
    end
    for _, player in Players:GetPlayers() do
        if
            self._state.participants[tostring(player.UserId)] == true
            and self._persistedUsers[player.UserId] ~= true
        then
            local transactionId = self._flow.chapterTransactionId(self._state, player.UserId)
            local result = self._profileService:completeChapterOne(
                player,
                transactionId,
                self._state.decision,
                self._state.wardenOutcome
            )
            if result.accepted and result.applied then
                self._analyticsService:chapterCompleted(
                    player,
                    1,
                    self._state.decision,
                    self._state.wardenOutcome,
                    transactionId
                )
                if result.durable then
                    self._persistedUsers[player.UserId] = true
                end
            elseif
                (result.accepted and result.durable)
                or (not result.accepted and result.reason == "chapter_already_resolved")
            then
                self._persistedUsers[player.UserId] = true
            elseif not result.accepted and result.reason ~= "profile_loading" then
                self._logger:warn("chapter_one_resolution_rejected", {
                    player = player.UserId,
                    reason = result.reason,
                    transaction = transactionId,
                })
            end
        end
    end
end

function BramblewakeBlackoutService._transition(
    self: BramblewakeBlackoutService,
    nextState: any,
    player: Player?,
    stageReason: string,
    toast: string
)
    self._state = nextState
    self._worldService:setBlackoutPresentation(self._state)
    if player ~= nil then
        self._analyticsService:blackoutStage(
            player,
            self._flow.Id,
            self._state.status,
            stageReason,
            self._state.revision
        )
    end
    self:_notify(toast)
end

function BramblewakeBlackoutService._representativePlayer(self: BramblewakeBlackoutService): Player?
    for _, player in Players:GetPlayers() do
        if self._state.participants[tostring(player.UserId)] == true then
            return player
        end
    end
    return nil
end

function BramblewakeBlackoutService._step(self: BramblewakeBlackoutService, now: number)
    if self._state.status == "old_growth" and self._oldGrowthService:isComplete() then
        local nextState, result = self._flow.completeOldGrowth(self._state)
        if result.accepted then
            self:_transition(
                nextState,
                self:_representativePlayer(),
                "old_growth_complete",
                "OLD GROWTH RELEASES THE WARDEN'S SEAL"
            )
        end
    elseif self._state.status == "warden" and self._wardenStagService:isComplete() then
        local outcome = self._wardenStagService:outcome()
        if outcome ~= nil then
            local nextState, result = self._flow.completeWarden(self._state, outcome)
            if result.accepted then
                self:_transition(
                    nextState,
                    self:_representativePlayer(),
                    "warden_complete",
                    "THE GREENWARD AWAITS YOUR VOTE"
                )
            end
        end
    elseif self._state.status == "resolution" then
        local eligibleUserIds = self:_activeParticipantIds()
        local nextState, result = self._flow.reconcileVote(self._state, eligibleUserIds)
        if result.resolved then
            self._state = nextState
            self._worldService:setBlackoutPresentation(self._state)
            self._worldService:setBlackoutLighting(false)
            self:_persistResolution()
            local player = Players:GetPlayerByUserId(eligibleUserIds[1])
            if player ~= nil then
                self._analyticsService:blackoutResult(
                    player,
                    self._flow.Id,
                    self._state.manifestHash,
                    self._state.decision,
                    self._state.wardenOutcome,
                    self._state.startedAt,
                    now
                )
            end
            self:_notify("CHAPTER I RESOLVED — " .. string.upper(self._state.decision))
        end
    elseif self._state.status == "complete" then
        self:_persistResolution()
    end

    self:_syncCarrierVisuals(now)
    if self._state.status ~= "dormant" and self._state.status ~= "disabled" then
        local second = math.floor(now)
        if second ~= self._lastPublishedSecond then
            self._lastPublishedSecond = second
            self:_notify(nil)
        end
    end
end

function BramblewakeBlackoutService.participantEntered(
    self: BramblewakeBlackoutService,
    player: Player
): any
    local story = self._profileService:chapterOneSnapshot(player)
    if self._state.status == "disabled" then
        return {
            accepted = false,
            message = "BLACKOUT PREVIEW DISABLED — BRAMBLEWAKE REMAINS OPEN",
            reason = "disabled",
        }
    end
    if not self._oldGrowthService:enabled() or not self._wardenStagService:enabled() then
        return {
            accepted = false,
            message = "BLACKOUT ENCOUNTERS ARE TEMPORARILY UNAVAILABLE",
            reason = "dependency_disabled",
        }
    end
    if self._state.status == "dormant" then
        if story ~= nil and story.status == "complete" then
            return {
                accepted = true,
                message = "CHAPTER I ALREADY RESOLVED — EXPEDITION OPEN",
                reason = "chapter_complete",
            }
        end
        local nextState, result =
            self._flow.start(self._state, player.UserId, workspace:GetServerTimeNow())
        if result.accepted then
            self._state = nextState
            self._worldService:setBlackoutLighting(true)
            self._worldService:setBlackoutPresentation(self._state)
            self._analyticsService:blackoutStarted(
                player,
                self._flow.Id,
                self._state.manifestHash,
                self._state.duration
            )
            self:_notify("BLACKOUT — CARRY ROOTFIRE BETWEEN LIVING ROOTS")
            return {
                accepted = true,
                message = "BLACKOUT — ROOTFIRE RELAY ACTIVE",
                reason = "started",
            }
        end
    elseif
        self._state.status == "relay"
        or self._state.status == "old_growth"
        or self._state.status == "warden"
        or self._state.status == "resolution"
    then
        self._state = self._flow.join(self._state, player.UserId)
        self._worldService:setBlackoutPresentation(self._state)
        self:_notify(nil)
        return {
            accepted = true,
            message = "JOINED THE ACTIVE BRAMBLEWAKE BLACKOUT",
            reason = "joined",
        }
    elseif self._state.status == "complete" then
        return {
            accepted = true,
            message = "BLACKOUT COMPLETE — CHAPTER RESULT RECORDED",
            reason = "complete",
        }
    end
    return {
        accepted = false,
        message = "BLACKOUT COULD NOT START",
        reason = self._state.status,
    }
end

function BramblewakeBlackoutService.interact(
    self: BramblewakeBlackoutService,
    player: Player,
    prompt: ProximityPrompt
): any
    if
        player:GetAttribute("LastLightInExpedition") ~= true
        or not self._survivalService:canAct(player)
    then
        return {
            accepted = false,
            message = "ENTER BRAMBLEWAKE WHILE ACTIVE",
            reason = "player_unavailable",
        }
    end
    local target = prompt.Parent
    local interaction = if target == nil then nil else target:GetAttribute("BlackoutInteraction")
    local nextState, result
    local now = workspace:GetServerTimeNow()
    if interaction == "take_fire" then
        nextState, result = self._flow.takeFire(self._state, player.UserId, now)
    elseif interaction == "deliver_fire" then
        local nodeId = tostring(target:GetAttribute("BlackoutNodeId"))
        if self._state.deliveredNodes[nodeId] == true then
            nextState, result = self._flow.takeFire(self._state, player.UserId, now)
        else
            nextState, result = self._flow.deliverFire(self._state, player.UserId, nodeId, now)
        end
    elseif interaction == "chapter_decision" then
        nextState, result = self._flow.vote(
            self._state,
            player.UserId,
            tostring(target:GetAttribute("BlackoutDecisionId")),
            self:_activeParticipantIds()
        )
    else
        return {
            accepted = false,
            message = "INVALID BLACKOUT INTERACTION",
            reason = "invalid_interaction",
        }
    end
    if not result.accepted then
        result.message = if result.reason == "fire_required"
                or result.reason == "fire_expired"
            then "TAKE FRESH ROOTFIRE FROM THE BLACKOUT LANTERN"
            elseif result.reason == "already_delivered" then "THAT LIVING ROOT ALREADY HOLDS FIRE"
            elseif
                self._state.status == "resolution"
            then "ONLY ACTIVE BLACKOUT PARTICIPANTS CAN VOTE"
            else "THAT BLACKOUT STEP IS NOT ACTIVE"
        return result
    end

    self._state = nextState
    self._worldService:setBlackoutPresentation(self._state)
    self:_syncCarrierVisuals(now)
    if result.reason == "fire_taken" then
        result.message = string.format(
            "ROOTFIRE TAKEN — DELIVER WITHIN %d SECONDS",
            self._flow.FireCarrySeconds
        )
    elseif result.reason == "fire_delivered" then
        result.message =
            string.format("LIVING ROOT LIT — %d / %d", result.delivered, result.required)
    elseif result.reason == "relay_complete" then
        result.message = "ROOTFIRE RELAY COMPLETE — OLD GROWTH AWAKENS"
        self._analyticsService:blackoutStage(
            player,
            self._flow.Id,
            self._state.status,
            "relay_complete",
            self._state.revision
        )
    elseif result.reason == "vote_recorded" then
        result.message = "GREENWARD VOTE RECORDED — WAITING FOR ACTIVE TRAVELERS"
    elseif result.reason == "resolved" then
        result.message = "CHAPTER I RESOLVED — " .. string.upper(self._state.decision)
        self._worldService:setBlackoutLighting(false)
        self:_persistResolution()
        self._analyticsService:blackoutResult(
            player,
            self._flow.Id,
            self._state.manifestHash,
            self._state.decision,
            self._state.wardenOutcome,
            self._state.startedAt,
            now
        )
    else
        result.message = "BLACKOUT UPDATED"
    end
    self:_notify(result.message)
    return result
end

function BramblewakeBlackoutService.allowsOldGrowth(self: BramblewakeBlackoutService): boolean
    return self._state.status == "old_growth"
end

function BramblewakeBlackoutService.allowsWarden(self: BramblewakeBlackoutService): boolean
    return self._state.status == "warden"
        or self._state.status == "resolution"
        or self._state.status == "complete"
end

function BramblewakeBlackoutService.snapshot(self: BramblewakeBlackoutService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return nil
    end
    local snapshot = self._flow.snapshot(self._state, player.UserId, workspace:GetServerTimeNow())
    snapshot.story = self._profileService:chapterOneSnapshot(player)
    return snapshot
end

return table.freeze(BramblewakeBlackoutService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">EnemyService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local EnemyService = {}
EnemyService.__index = EnemyService
EnemyService.Name = "EnemyService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

type AttackVisual = {
    label: TextLabel,
    marker: Part,
}

type Attack = {
    areaCFrame: CFrame,
    flow: any,
    target: Player,
    visual: AttackVisual,
}

type Enemy = {
    attack: Attack?,
    basePosition: Vector3,
    definition: any,
    facingPosition: Vector3,
    health: number,
    lastAttackAt: number,
    markedUntil: number,
    model: Model,
    spawnedAt: number,
}

export type EnemyService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _config: any,
        _worldService: any,
        _survivalService: any,
        _combatService: any,
        _enemyAttackFlow: any,
        _enemyCatalog: any,
        _enemyCombatRules: any,
        _enemyMotion: any,
        _enemyBuilder: any,
        _analyticsService: any,
        _professionService: any,
        _eliteService: any,
        _bossService: any,
        _active: Enemy?,
        _queue: { string },
        _nextSpawnAt: number,
        _nightActive: boolean,
        _lanternHealth: number,
        _breachMultiplier: number,
        _onChanged: ((string?) -> ())?,
        _heartbeat: RBXScriptConnection?,
    },
    EnemyService
))

local function rootPart(player: Player): BasePart?
    local character = player.Character
    local root = if character == nil then nil else character:FindFirstChild("HumanoidRootPart")
    return if root ~= nil and root:IsA("BasePart") then root else nil
end

function EnemyService.new(
    logger: Logger,
    config: any,
    worldService: any,
    survivalService: any,
    combatService: any,
    enemyAttackFlow: any,
    enemyCatalog: any,
    enemyCombatRules: any,
    enemyMotion: any,
    enemyBuilder: any,
    analyticsService: any
): EnemyService
    return setmetatable({
        Name = EnemyService.Name,
        _logger = logger,
        _config = config,
        _worldService = worldService,
        _survivalService = survivalService,
        _combatService = combatService,
        _enemyAttackFlow = enemyAttackFlow,
        _enemyCatalog = enemyCatalog,
        _enemyCombatRules = enemyCombatRules,
        _enemyMotion = enemyMotion,
        _enemyBuilder = enemyBuilder,
        _analyticsService = analyticsService,
        _professionService = nil,
        _eliteService = nil,
        _bossService = nil,
        _active = nil,
        _queue = {},
        _nextSpawnAt = 0,
        _nightActive = false,
        _lanternHealth = 100,
        _breachMultiplier = 1,
        _onChanged = nil,
        _heartbeat = nil,
    }, EnemyService)
end

function EnemyService.Init(_self: EnemyService, _context: any) end

function EnemyService.Start(self: EnemyService)
    local accumulator = 0
    self._heartbeat = RunService.Heartbeat:Connect(function(deltaTime: number)
        accumulator += deltaTime
        if accumulator < 0.05 then
            return
        end
        local elapsed = accumulator
        accumulator = 0
        self:_step(elapsed)
    end)
end

function EnemyService.setChangedHandler(self: EnemyService, callback: (string?) -> ())
    self._onChanged = callback
end

function EnemyService.setProfessionService(self: EnemyService, professionService: any)
    self._professionService = professionService
end

function EnemyService.setEliteService(self: EnemyService, eliteService: any)
    self._eliteService = eliteService
end

function EnemyService.setBossService(self: EnemyService, bossService: any)
    self._bossService = bossService
end

function EnemyService._activeEncounterService(self: EnemyService): any
    if self._bossService ~= nil and self._bossService:combatActive() then
        return self._bossService
    end
    if self._eliteService ~= nil and self._eliteService:combatActive() then
        return self._eliteService
    end
    return nil
end

function EnemyService._notify(self: EnemyService, toast: string?)
    local callback = self._onChanged
    if callback ~= nil then
        callback(toast)
    end
end

function EnemyService._poseEnemy(
    self: EnemyService,
    enemy: Enemy,
    now: number,
    motionState: string,
    attackProgress: number?
)
    if enemy.model.Parent == nil then
        return
    end
    local pose = self._enemyMotion.pose(
        math.max(0, now - enemy.spawnedAt),
        enemy.definition.modelKey,
        motionState,
        attackProgress
    )
    local position = enemy.basePosition + Vector3.new(0, pose.height, 0)
    local flatFacing = Vector3.new(enemy.facingPosition.X, position.Y, enemy.facingPosition.Z)
    if (flatFacing - position).Magnitude <= 0.01 then
        flatFacing = position + Vector3.new(0, 0, -1)
    end
    enemy.model:PivotTo(
        CFrame.lookAt(position, flatFacing) * CFrame.Angles(pose.pitch, 0, pose.roll)
    )
end

function EnemyService._showSpawnPulse(_self: EnemyService, position: Vector3, color: Color3)
    local pulse = Instance.new("Part")
    pulse.Name = "BramblewakeSpawnPulse"
    pulse.Anchored = true
    pulse.CanCollide = false
    pulse.CanQuery = false
    pulse.CanTouch = false
    pulse.CastShadow = false
    pulse.Shape = Enum.PartType.Cylinder
    pulse.Material = Enum.Material.Neon
    pulse.Color = color
    pulse.Transparency = 0.18
    pulse.Size = Vector3.new(0.16, 4, 4)
    pulse.CFrame = CFrame.new(position + Vector3.new(0, 0.12, 0))
        * CFrame.Angles(0, 0, math.rad(90))
    pulse.Parent = workspace

    local tween = TweenService:Create(
        pulse,
        TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = Vector3.new(0.16, 18, 18),
            Transparency = 1,
        }
    )
    tween:Play()
    task.delay(0.95, function()
        if pulse.Parent ~= nil then
            pulse:Destroy()
        end
    end)
end

function EnemyService._showDamageFeedback(
    self: EnemyService,
    enemy: Enemy,
    damage: number,
    strikeResult: string
)
    local primary = enemy.model.PrimaryPart
    if primary == nil then
        return
    end

    local revision = (tonumber(enemy.model:GetAttribute("HitRevision")) or 0) + 1
    enemy.model:SetAttribute("HitRevision", revision)
    local highlight = enemy.model:FindFirstChild("ThreatOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        highlight.FillColor = Color3.fromRGB(255, 238, 188)
        highlight.FillTransparency = 0.18
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        task.delay(0.13, function()
            if
                enemy.model.Parent ~= nil
                and enemy.model:GetAttribute("HitRevision") == revision
            then
                self:_setMarkedVisual(enemy, workspace:GetServerTimeNow() < enemy.markedUntil)
            end
        end)
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DamageFeedback"
    billboard.Adornee = primary
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 95
    billboard.Size = UDim2.fromOffset(130, 48)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 4.8, 0)
    billboard.Parent = primary

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBlack
    label.Text = if strikeResult == "flanked"
        then string.format("FLANK  -%d", damage)
        elseif strikeResult == "shielded" then string.format("BLOCK  -%d", damage)
        else string.format("-%d", damage)
    label.TextColor3 = if strikeResult == "flanked"
        then Color3.fromRGB(255, 213, 105)
        elseif strikeResult == "shielded" then Color3.fromRGB(169, 201, 188)
        else Color3.fromRGB(255, 238, 205)
    label.TextScaled = true
    label.TextStrokeColor3 = Color3.fromRGB(31, 25, 22)
    label.TextStrokeTransparency = 0.2
    label.Parent = billboard

    TweenService:Create(
        billboard,
        TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { StudsOffsetWorldSpace = Vector3.new(0, 7.2, 0) }
    ):Play()
    TweenService:Create(
        label,
        TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { TextTransparency = 1, TextStrokeTransparency = 1 }
    ):Play()
    task.delay(0.62, function()
        if billboard.Parent ~= nil then
            billboard:Destroy()
        end
    end)
end

function EnemyService._defeatActive(self: EnemyService, enemy: Enemy)
    self:_clearAttack(enemy)
    if self._active == enemy then
        self._active = nil
    end
    enemy.model:SetAttribute("Defeated", true)
    local pivot = enemy.model:GetPivot().Position
    self:_showSpawnPulse(pivot, Color3.fromRGB(255, 194, 105))

    for _, descendant in enemy.model:GetDescendants() do
        if descendant:IsA("BasePart") then
            descendant.CanCollide = false
            descendant.CanQuery = false
            descendant.CanTouch = false
            TweenService
                :Create(
                    descendant,
                    TweenInfo.new(0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                    {
                        Position = descendant.Position + Vector3.new(0, 1.4, 0),
                        Transparency = 1,
                    }
                )
                :Play()
        end
    end
    task.delay(0.55, function()
        if enemy.model.Parent ~= nil then
            enemy.model:Destroy()
        end
    end)
end

function EnemyService._clearAttack(_self: EnemyService, enemy: Enemy)
    local attack = enemy.attack
    if attack == nil then
        return
    end
    if attack.visual.marker.Parent ~= nil then
        attack.visual.marker:Destroy()
    end
    enemy.attack = nil
end

function EnemyService._destroyActive(self: EnemyService)
    local active = self._active
    if active == nil then
        return
    end
    self:_clearAttack(active)
    if active.model.Parent ~= nil then
        active.model:Destroy()
    end
    self._active = nil
end

function EnemyService.startNight(self: EnemyService)
    self:_destroyActive()
    table.clear(self._queue)
    self._nightActive = true
    self._lanternHealth = 100
    self._worldService:setLanternHealth(self._lanternHealth)
    self._breachMultiplier = 1
    self._nextSpawnAt = 0
    self:_notify(nil)
end

function EnemyService.stopNight(self: EnemyService)
    self._nightActive = false
    self:_destroyActive()
    table.clear(self._queue)
    self._lanternHealth = 100
    self._worldService:setLanternHealth(self._lanternHealth)
    self._breachMultiplier = 1
    self._nextSpawnAt = 0
    self:_notify(nil)
end

function EnemyService._spawnPosition(self: EnemyService, definition: any): Vector3
    local origin = self._worldService:enemySpawnPosition()
    if definition.stationary ~= true then
        return origin
    end
    local lantern = self._worldService:lanternPosition()
    local flatDelta = Vector3.new(lantern.X - origin.X, 0, lantern.Z - origin.Z)
    if flatDelta.Magnitude <= 1 then
        return origin
    end
    return origin + flatDelta.Unit * math.min(34, flatDelta.Magnitude * 0.45)
end

function EnemyService._spawnNow(self: EnemyService, enemyId: string): boolean
    if not self._nightActive or self._active ~= nil then
        return false
    end
    local definition = self._enemyCatalog.get(enemyId)
    if definition == nil then
        self._logger:info("enemy_spawn_rejected", { enemy = enemyId, reason = "unknown_enemy" })
        return false
    end

    local origin = self:_spawnPosition(definition)
    self:_showSpawnPulse(
        origin,
        if definition.statusEffect == "spark_theft"
            then Color3.fromRGB(103, 191, 175)
            else Color3.fromRGB(255, 119, 79)
    )
    local model = self._enemyBuilder.build(
        definition,
        origin,
        if definition.targetMode == "player"
            then origin + Vector3.new(0, 0, -10)
            else self._worldService:lanternPosition()
    )
    model.Parent = workspace
    local spawnedAt = workspace:GetServerTimeNow()
    local basePosition = model:GetPivot().Position
    self._active = {
        attack = nil,
        basePosition = basePosition,
        definition = definition,
        facingPosition = if definition.targetMode == "player"
            then basePosition + Vector3.new(0, 0, -10)
            else self._worldService:lanternPosition(),
        health = definition.health,
        lastAttackAt = spawnedAt,
        markedUntil = 0,
        model = model,
        spawnedAt = spawnedAt,
    }
    self._logger:info("bramblewake_enemy_spawned", {
        enemy = definition.id,
        queued = #self._queue,
    })
    self:_notify(string.upper(definition.displayName) .. " ENTERS THE TRAIL")
    return true
end

function EnemyService.spawn(self: EnemyService, enemyId: string?): boolean
    if not self._nightActive then
        return false
    end
    local resolvedId = enemyId or "enemy_rootling"
    if self._enemyCatalog.get(resolvedId) == nil then
        self._logger:info("enemy_spawn_rejected", {
            enemy = resolvedId,
            reason = "unknown_enemy",
        })
        return false
    end
    if self._active ~= nil or workspace:GetServerTimeNow() < self._nextSpawnAt then
        table.insert(self._queue, resolvedId)
        self._logger:info("bramblewake_enemy_queued", {
            enemy = resolvedId,
            position = #self._queue,
        })
        return true
    end
    return self:_spawnNow(resolvedId)
end

function EnemyService._spawnNext(self: EnemyService, now: number)
    if
        not self._nightActive
        or self._active ~= nil
        or #self._queue == 0
        or now < self._nextSpawnAt
    then
        return
    end
    local enemyId = table.remove(self._queue, 1)
    if enemyId ~= nil then
        self:_spawnNow(enemyId)
    end
end

function EnemyService._attackGroundPosition(
    _self: EnemyService,
    enemy: Enemy,
    root: BasePart
): Vector3
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { enemy.model, root.Parent :: Model }
    local result =
        workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, -14, 0), params)
    return if result == nil
        then root.Position - Vector3.new(0, 2.8, 0)
        else result.Position + Vector3.new(0, 0.12, 0)
end

function EnemyService._attackArea(self: EnemyService, enemy: Enemy, root: BasePart): CFrame
    local definition = enemy.definition
    local ground = self:_attackGroundPosition(enemy, root)
    if definition.shape == "circle" or enemy.model.PrimaryPart == nil then
        return CFrame.new(ground)
    end

    local origin = enemy.model.PrimaryPart.Position
    local flatDirection = Vector3.new(root.Position.X - origin.X, 0, root.Position.Z - origin.Z)
    if flatDirection.Magnitude < 0.01 then
        flatDirection = Vector3.new(
            enemy.model.PrimaryPart.CFrame.LookVector.X,
            0,
            enemy.model.PrimaryPart.CFrame.LookVector.Z
        )
    end
    flatDirection = flatDirection.Unit
    local length = definition.length or 0
    local center = Vector3.new(origin.X, ground.Y, origin.Z) + flatDirection * length * 0.5
    return CFrame.lookAt(center, center + flatDirection)
end

function EnemyService._createAttackVisual(
    _self: EnemyService,
    definition: any,
    areaCFrame: CFrame
): AttackVisual
    local marker = Instance.new("Part")
    marker.Name = definition.modelKey .. "AttackWarning"
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.CastShadow = false
    marker.Color = if definition.statusEffect == "drowsy"
        then Color3.fromRGB(218, 184, 86)
        elseif definition.statusEffect == "spark_theft" then Color3.fromRGB(103, 191, 175)
        else Color3.fromRGB(255, 119, 79)
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.52
    if definition.shape == "lane" then
        marker.Size = Vector3.new(definition.width or 0, 0.18, definition.length or 0)
        marker.CFrame = areaCFrame
    else
        local diameter = (definition.radius or 0) * 2
        marker.Shape = Enum.PartType.Cylinder
        marker.Size = Vector3.new(0.18, diameter, diameter)
        marker.CFrame = areaCFrame * CFrame.Angles(0, 0, math.rad(90))
    end
    marker.Parent = workspace

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "AttackLabel"
    billboard.Adornee = marker
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 110
    billboard.Size = UDim2.fromOffset(250, 66)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
    billboard.Parent = marker

    local label = Instance.new("TextLabel")
    label.Name = "Warning"
    label.BackgroundColor3 = Color3.fromRGB(39, 25, 22)
    label.BackgroundTransparency = 0.08
    label.BorderSizePixel = 0
    label.Font = Enum.Font.GothamBold
    label.Size = UDim2.fromScale(1, 1)
    label.Text = definition.attackName .. "\n" .. definition.instruction
    label.TextColor3 = Color3.fromRGB(255, 236, 205)
    label.TextScaled = true
    label.TextStrokeTransparency = 0.72
    label.TextWrapped = true
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = label
    local stroke = Instance.new("UIStroke")
    stroke.Color = marker.Color
    stroke.Thickness = 2
    stroke.Transparency = 0.08
    stroke.Parent = label

    return {
        label = label,
        marker = marker,
    }
end

function EnemyService._startAttack(self: EnemyService, enemy: Enemy, target: Player, now: number)
    local root = rootPart(target)
    if root == nil then
        return
    end
    local areaCFrame = self:_attackArea(enemy, root)
    enemy.facingPosition = root.Position
    enemy.attack = {
        areaCFrame = areaCFrame,
        flow = self._enemyAttackFlow.create(target.UserId, now, enemy.definition.windup),
        target = target,
        visual = self:_createAttackVisual(enemy.definition, areaCFrame),
    }
    enemy.lastAttackAt = now
    self._logger:info("enemy_attack_telegraphed", {
        attack = enemy.definition.attackId,
        enemy = enemy.definition.id,
        player = target.UserId,
        shape = enemy.definition.shape,
        windup = enemy.definition.windup,
    })
    self:_notify(nil)
end

function EnemyService._clearPath(_self: EnemyService, enemy: Enemy, target: Player): boolean
    local character = target.Character
    local root = rootPart(target)
    local origin = enemy.model.PrimaryPart
    if root == nil or origin == nil or character == nil then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { enemy.model }
    local result = workspace:Raycast(origin.Position, root.Position - origin.Position, params)
    return result == nil or result.Instance:IsDescendantOf(character)
end

function EnemyService._insideAttack(
    self: EnemyService,
    enemy: Enemy,
    attack: Attack,
    root: BasePart
): boolean
    local localPosition = attack.areaCFrame:PointToObjectSpace(root.Position)
    return self._enemyCombatRules.contains(
        enemy.definition.shape,
        localPosition.X,
        localPosition.Z,
        enemy.definition.radius,
        enemy.definition.width,
        enemy.definition.length
    )
end

function EnemyService._stepAttack(self: EnemyService, enemy: Enemy, now: number)
    local attack = enemy.attack
    if attack == nil then
        return
    end
    local root = rootPart(attack.target)
    if root ~= nil then
        enemy.facingPosition = root.Position
    end
    local attackDuration = math.max(0.01, attack.flow.endsAt - attack.flow.startedAt)
    self:_poseEnemy(
        enemy,
        now,
        "attacking",
        math.clamp((now - attack.flow.startedAt) / attackDuration, 0, 1)
    )
    local resolving = now >= attack.flow.endsAt
    local decision = self._enemyAttackFlow.evaluate(attack.flow, now, {
        clearPath = not resolving or self:_clearPath(enemy, attack.target),
        inImpactArea = not resolving or (root ~= nil and self:_insideAttack(enemy, attack, root)),
        targetCanAct = self._survivalService:canAct(attack.target),
        targetPresent = attack.target.Parent ~= nil and root ~= nil,
    })
    if decision.status == "pending" then
        attack.visual.label.Text = string.format(
            "%s\n%s · %.1fs",
            enemy.definition.attackName,
            enemy.definition.instruction,
            math.max(0, decision.remaining or 0)
        )
        return
    end

    local target = attack.target
    local enemyId = enemy.definition.id
    self:_clearAttack(enemy)
    if decision.status == "cancel" then
        self._analyticsService:enemyAttackResult(target, decision.reason or "cancelled", enemyId)
        self:_notify(nil)
        return
    end
    if decision.status == "miss" then
        self._analyticsService:enemyAttackResult(target, decision.reason or "missed", enemyId)
        self:_notify(nil)
        return
    end
    if self._combatService:avoidsDamage(target, now) then
        self._analyticsService:enemyAttackResult(target, "dodged", enemyId)
        self:_notify(nil)
        return
    end

    local damage = enemy.definition.playerDamage
    local guarded = false
    if self._professionService ~= nil then
        damage, guarded = self._professionService:mitigateIncomingDamage(target, damage, now)
    end
    damage = self._combatService:mitigateShieldedDamage(target, damage, now)
    local result = self._survivalService:damage(target, damage, enemyId)
    if result.applied and enemy.definition.statusEffect == "drowsy" then
        self._combatService:applyDrowsy(
            target,
            enemy.definition.statusDuration or 0,
            enemy.definition.statusMultiplier or 1
        )
    elseif result.applied and enemy.definition.statusEffect == "spark_theft" then
        self._lanternHealth =
            math.max(18, self._lanternHealth - (enemy.definition.statusLanternDamage or 0))
        self._worldService:setLanternHealth(self._lanternHealth)
    end
    self._analyticsService:enemyAttackResult(
        target,
        if result.applied then (if guarded then "guarded_hit" else "hit") else "blocked",
        enemyId
    )
    if result.downed then
        self:_notify("ALLY DOWN — " .. enemy.definition.attackName)
    elseif guarded and result.applied then
        self:_notify("LANTERN GUARD ABSORBS " .. enemy.definition.attackName)
    elseif result.applied and enemy.definition.statusEffect == "spark_theft" then
        self:_notify("HOLLOW CROW STOLE AN EXPOSED LANTERN SPARK")
    else
        self:_notify(nil)
    end
end

function EnemyService._setMarkedVisual(_self: EnemyService, enemy: Enemy, marked: boolean)
    enemy.model:SetAttribute("LastLightMarked", marked)
    local highlight = enemy.model:FindFirstChild("ThreatOutline")
    if highlight ~= nil and highlight:IsA("Highlight") then
        highlight.FillColor = if marked
            then Color3.fromRGB(41, 91, 74)
            else Color3.fromRGB(80, 29, 29)
        highlight.FillTransparency = if marked then 0.52 else 0.76
        highlight.OutlineColor = if marked
            then Color3.fromRGB(255, 210, 96)
            else Color3.fromRGB(255, 143, 91)
    end
end

function EnemyService._closestPlayer(self: EnemyService, enemy: Enemy): (Player?, number)
    local closestPlayer = nil
    local closestDistance = math.huge
    local primary = enemy.model.PrimaryPart
    if primary == nil then
        return nil, closestDistance
    end
    for _, player in Players:GetPlayers() do
        local root = rootPart(player)
        if
            root ~= nil
            and self._survivalService:canAct(player)
            and player:GetAttribute("LastLightTutorialSurvivalReady") == true
            and player:GetAttribute("LastLightInExpedition") ~= true
        then
            local distance = (root.Position - primary.Position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closestPlayer = player
            end
        end
    end
    return closestPlayer, closestDistance
end

function EnemyService._lanternImpact(self: EnemyService, enemy: Enemy, now: number)
    if now - enemy.lastAttackAt < enemy.definition.attackCooldown then
        return
    end
    enemy.lastAttackAt = now
    self._lanternHealth =
        math.max(0, self._lanternHealth - math.max(0, enemy.definition.lanternDamage))
    if self._lanternHealth <= 0 then
        self._lanternHealth = 18
        local collapsedId = enemy.definition.id
        self:_destroyActive()
        self._nextSpawnAt = now + 2
        self._logger:info("lantern_emergency_restore", { enemy = collapsedId })
        self:_notify("THE LIGHT FLICKERS — MARA RESTORES A SPARK")
    else
        self:_notify(nil)
    end
    self._worldService:setLanternHealth(self._lanternHealth)
end

function EnemyService._step(self: EnemyService, deltaTime: number)
    if not self._nightActive then
        return
    end
    local now = workspace:GetServerTimeNow()
    local enemy = self._active
    if enemy == nil then
        self:_spawnNext(now)
        return
    end
    if enemy.model.Parent == nil then
        self:_clearAttack(enemy)
        self._active = nil
        self._nextSpawnAt = now + 1
        self:_notify(nil)
        return
    end

    if enemy.markedUntil > 0 and now >= enemy.markedUntil then
        enemy.markedUntil = 0
        self:_setMarkedVisual(enemy, false)
        self:_notify(nil)
    end
    if enemy.attack ~= nil then
        self:_stepAttack(enemy, now)
        return
    end

    local closestPlayer, closestDistance = self:_closestPlayer(enemy)
    if
        closestPlayer ~= nil
        and closestDistance <= enemy.definition.attackRange
        and now - enemy.lastAttackAt >= enemy.definition.attackCooldown
    then
        self:_startAttack(enemy, closestPlayer, now)
        return
    end
    if enemy.definition.stationary then
        self:_poseEnemy(enemy, now, "idle", nil)
        return
    end

    local destination = self._worldService:lanternPosition()
    if enemy.definition.targetMode == "player" and closestPlayer ~= nil then
        local targetRoot = rootPart(closestPlayer)
        if targetRoot ~= nil then
            destination = targetRoot.Position
        end
    end
    local flatTarget = Vector3.new(destination.X, enemy.basePosition.Y, destination.Z)
    local delta = flatTarget - enemy.basePosition
    local stoppingDistance = if enemy.definition.targetMode == "player"
        then enemy.definition.attackRange * 0.72
        else 10
    if delta.Magnitude > stoppingDistance then
        local speed = enemy.definition.speed * self._breachMultiplier
        if now < enemy.markedUntil then
            speed *= 0.65
        end
        local distance = math.min(delta.Magnitude - stoppingDistance, speed * deltaTime)
        if distance > 0 then
            enemy.basePosition += delta.Unit * distance
            enemy.facingPosition = flatTarget
            self:_poseEnemy(enemy, now, "moving", nil)
        end
        return
    end

    enemy.facingPosition = flatTarget
    self:_poseEnemy(enemy, now, "idle", nil)

    if enemy.definition.targetMode == "lantern" then
        self:_lanternImpact(enemy, now)
    end
end

function EnemyService._enemyInRange(
    self: EnemyService,
    player: Player,
    range: number
): (Enemy?, string?)
    if not self._nightActive then
        return nil, "NO NIGHT THREAT IS ACTIVE IN DAYLIGHT"
    end
    if not self._survivalService:canAct(player) then
        return nil, "YOU CANNOT TRACK WHILE DOWNED"
    end
    local enemy = self._active
    local root = rootPart(player)
    if enemy == nil or root == nil or enemy.model.PrimaryPart == nil then
        return nil, "NO THREAT CAN BE MARKED"
    end
    if (root.Position - enemy.model.PrimaryPart.Position).Magnitude > range then
        return nil, "MOVE CLOSER TO MARK THE THREAT"
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character :: Model }
    local result =
        workspace:Raycast(root.Position, enemy.model.PrimaryPart.Position - root.Position, params)
    if result ~= nil and not result.Instance:IsDescendantOf(enemy.model) then
        return nil, "THE THREAT IS HIDDEN BEHIND COVER"
    end
    return enemy, nil
end

function EnemyService.canMarkNearest(
    self: EnemyService,
    player: Player,
    range: number
): (boolean, string)
    -- Checked before (not instead of) the town-night branch below: a normal
    -- town night and an active Old Growth/Warden Stag encounter can now run
    -- concurrently (the town cycle repeats independently of Bramblewake), so
    -- _nightActive can no longer be used to infer "no encounter is active."
    local encounterService = self:_activeEncounterService()
    if encounterService ~= nil then
        return encounterService:canMarkNearest(player, range)
    end
    local enemy, reason = self:_enemyInRange(player, range)
    if enemy == nil then
        return false, reason or "NO THREAT CAN BE MARKED"
    end
    return true, "FOXFIRE MARK READY"
end

function EnemyService.markNearest(
    self: EnemyService,
    player: Player,
    range: number,
    duration: number
): (boolean, string)
    local encounterService = self:_activeEncounterService()
    if encounterService ~= nil then
        return encounterService:markNearest(player, range, duration)
    end
    local enemy, reason = self:_enemyInRange(player, range)
    if enemy == nil then
        return false, reason or "NO THREAT CAN BE MARKED"
    end
    enemy.markedUntil = workspace:GetServerTimeNow() + duration
    self:_setMarkedVisual(enemy, true)
    local message = "FOXFIRE MARK — "
        .. string.upper(enemy.definition.displayName)
        .. " REVEALED AND SLOWED"
    self:_notify(message)
    return true, message
end

function EnemyService.canRepairLantern(
    self: EnemyService,
    player: Player,
    range: number
): (boolean, string)
    if not self._nightActive then
        return false, "THE FIRST LANTERN DOES NOT NEED A NIGHT REPAIR"
    end
    if not self._survivalService:canAct(player) then
        return false, "YOU CANNOT REPAIR WHILE DOWNED"
    end
    if self._lanternHealth >= 100 then
        return false, "THE FIRST LANTERN IS ALREADY AT FULL STRENGTH"
    end
    local root = rootPart(player)
    if root == nil or (root.Position - self._worldService:lanternPosition()).Magnitude > range then
        return false, "MOVE CLOSER TO THE FIRST LANTERN"
    end
    return true, "EMERGENCY PATCH READY"
end

function EnemyService.repairLantern(
    self: EnemyService,
    player: Player,
    range: number,
    amount: number
): (boolean, string)
    local allowed, reason = self:canRepairLantern(player, range)
    if not allowed then
        return false, reason
    end
    local previous = self._lanternHealth
    self._lanternHealth = math.min(100, self._lanternHealth + amount)
    self._worldService:setLanternHealth(self._lanternHealth)
    local restored = self._lanternHealth - previous
    local message = string.format("EMERGENCY PATCH — FIRST LANTERN +%d", restored)
    self:_notify(message)
    return true, message
end

function EnemyService.damageNearest(self: EnemyService, player: Player): (boolean, string)
    local encounterService = self:_activeEncounterService()
    if encounterService ~= nil then
        return encounterService:damageNearest(player)
    end
    if not self._nightActive then
        return false, "The tool is calm in daylight."
    end
    if not self._survivalService:canAct(player) then
        return false, "You cannot strike while downed."
    end

    local enemy = self._active
    local root = rootPart(player)
    if enemy == nil or root == nil or enemy.model.PrimaryPart == nil then
        return false, "No threat is close enough."
    end
    local displayName = enemy.definition.displayName
    local primary = enemy.model.PrimaryPart
    local distance = (root.Position - primary.Position).Magnitude
    if distance > enemy.definition.strikeRange then
        return false, "Move closer to the " .. displayName .. "."
    end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = { player.Character :: Model }
    local result = workspace:Raycast(root.Position, primary.Position - root.Position, raycastParams)
    if result ~= nil and not result.Instance:IsDescendantOf(enemy.model) then
        return false, "The " .. displayName .. " is behind cover."
    end

    local directionToPlayer = root.Position - primary.Position
    local facingDot = if directionToPlayer.Magnitude > 0.01
        then primary.CFrame.LookVector:Dot(directionToPlayer.Unit)
        else 1
    local damage, strikeResult = self._enemyCombatRules.strikeDamage(enemy.definition, facingDot)
    enemy.health -= damage
    enemy.model:SetAttribute("EnemyHealth", math.max(0, enemy.health))
    self:_showDamageFeedback(enemy, damage, strikeResult)
    if enemy.health <= 0 then
        local defeatedId = enemy.definition.id
        self:_defeatActive(enemy)
        self._nextSpawnAt = workspace:GetServerTimeNow() + 1.25
        self._logger:info("bramblewake_enemy_defeated", {
            enemy = defeatedId,
            player = player.UserId,
            strikeResult = strikeResult,
        })
        self:_notify(string.upper(displayName) .. " DRIVEN BACK")
        return true, displayName .. " driven back!"
    end

    local remaining = tostring(math.max(0, math.ceil(enemy.health)))
    if strikeResult == "shielded" then
        self:_notify("SHIELD BLOCKED MOST OF THE HIT — FLANK THE BRIARBACK")
        return true, "The front shield absorbs most of the strike. Flank it."
    elseif strikeResult == "flanked" then
        self:_notify("FLANK HIT — " .. string.upper(displayName) .. " " .. remaining)
        return true, "Clean flank hit."
    end
    self:_notify("HIT — " .. string.upper(displayName) .. " " .. remaining)
    return true, "Your tool strikes the " .. displayName .. "."
end

function EnemyService.threatSnapshot(self: EnemyService, viewer: Player): any
    local enemy = self._active
    local attack = if enemy == nil then nil else enemy.attack
    if enemy == nil or attack == nil or attack.target ~= viewer then
        local encounterService = self:_activeEncounterService()
        return if encounterService == nil then nil else encounterService:threatSnapshot(viewer)
    end
    return {
        attackId = enemy.definition.attackId,
        displayName = enemy.definition.attackName,
        enemyName = string.upper(enemy.definition.displayName),
        enemyId = enemy.definition.id,
        instruction = enemy.definition.instruction,
        resolvesAt = attack.flow.endsAt,
        shape = enemy.definition.shape,
    }
end

function EnemyService.setBreach(self: EnemyService)
    self._breachMultiplier = 1.35
    self:_notify("THE ROOTS SURGE — HOLD THE LIGHT")
end

function EnemyService.lanternHealth(self: EnemyService): number
    return self._lanternHealth
end

function EnemyService.activeCount(self: EnemyService): number
    return if self._active == nil then 0 else 1
end

function EnemyService.combatActive(self: EnemyService): boolean
    return (self._nightActive and self._active ~= nil) or self:_activeEncounterService() ~= nil
end

return table.freeze(EnemyService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">ExpeditionService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local ExpeditionService = {}
ExpeditionService.__index = ExpeditionService
ExpeditionService.Name = "ExpeditionService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type ExpeditionService = typeof(setmetatable(
    {} :: {
        Name: string,
        _logger: Logger,
        _worldService: any,
        _generator: any,
        _catalog: any,
        _featureFlags: any,
        _eventFlow: any,
        _rewardLedger: any,
        _profileService: any,
        _analyticsService: any,
        _seed: number,
        _manifest: any,
        _partCount: number,
        _eventStates: { [string]: any },
        _rewardLedgerState: any,
        _eventsEnabled: boolean,
        _runId: string,
    },
    ExpeditionService
))

function ExpeditionService.new(
    logger: Logger,
    worldService: any,
    generator: any,
    catalog: any,
    featureFlags: any,
    eventFlow: any,
    rewardLedger: any,
    profileService: any,
    analyticsService: any,
    seed: number
): ExpeditionService
    return setmetatable({
        Name = ExpeditionService.Name,
        _logger = logger,
        _worldService = worldService,
        _generator = generator,
        _catalog = catalog,
        _featureFlags = featureFlags,
        _eventFlow = eventFlow,
        _rewardLedger = rewardLedger,
        _profileService = profileService,
        _analyticsService = analyticsService,
        _seed = seed,
        _manifest = nil,
        _partCount = 0,
        _eventStates = {},
        _rewardLedgerState = rewardLedger.create(),
        _eventsEnabled = false,
        _runId = "",
    }, ExpeditionService)
end

function ExpeditionService.Init(self: ExpeditionService, _context: any)
    local jobId = game.JobId
    self._runId = if jobId ~= ""
        then jobId
        else string.format("studio_%d_%d", os.time(), math.floor(os.clock() * 1000))
    local requestedSeed = game:GetAttribute("LastLightExpeditionSeed")
    local seed = if type(requestedSeed) == "number" then requestedSeed else self._seed
    local manifest = self._generator.generate(seed)
    local valid, issues = self._generator.validate(manifest)
    assert(valid, "Bramblewake expedition manifest is invalid: " .. table.concat(issues, "; "))

    local result = self._worldService:buildBramblewake(manifest, self._generator, self._catalog)
    self._manifest = manifest
    self._partCount = result.partCount
    self._eventsEnabled = self._featureFlags:isEnabled("bramblewake_events_enabled")
    self._worldService:setExpeditionEventsEnabled(self._eventsEnabled)
    for _, placement in manifest.modules do
        if placement.eventId ~= nil then
            local definition = self._generator.eventDefinition(placement.eventId)
            local state =
                self._eventFlow.create(definition, self._runId, manifest.hash, self._eventsEnabled)
            self._eventStates[placement.eventId] = state
            self._worldService:setExpeditionEventState(placement.eventId, state)
        end
    end
end

function ExpeditionService.Start(self: ExpeditionService)
    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    self._logger:info("expedition_ready", {
        events = self._catalog.EventCount,
        eventInteractions = self._catalog.EventInteractionCount,
        eventsEnabled = self._eventsEnabled,
        hash = manifest.hash,
        modules = #manifest.modules,
        parts = self._partCount,
        pois = self._catalog.PointOfInterestCount,
        runId = self._runId,
        seed = manifest.seed,
        source = manifest.source,
    })
end

function ExpeditionService.enter(self: ExpeditionService, player: Player): boolean
    return self._worldService:enterBramblewake(player)
end

function ExpeditionService._participantCount(_self: ExpeditionService, state: any): number
    local count = 0
    for _ in state.participants do
        count += 1
    end
    return count
end

function ExpeditionService._refreshExpired(self: ExpeditionService, now: number)
    for eventId, state in self._eventStates do
        local definition = self._generator.eventDefinition(eventId)
        if self._eventFlow.expire(state, definition, now) then
            self._worldService:setExpeditionEventState(eventId, state)
            self._analyticsService:expeditionEventFailed(
                eventId,
                state.manifestHash,
                self:_participantCount(state)
            )
        end
    end
end

function ExpeditionService._grant(
    self: ExpeditionService,
    userId: number,
    transactionId: string,
    manifestHash: string,
    reward: any,
    sourceKind: string,
    sourceId: string
): boolean
    local granted = self._rewardLedger.grant(
        self._rewardLedgerState,
        userId,
        transactionId,
        manifestHash,
        reward
    )
    if not granted then
        return false
    end
    local sourceField = if sourceKind == "event" then "event" else "encounter"
    local grantedFields: { [string]: any } = {
        amount = reward.amount,
        material = reward.materialId,
        transaction = transactionId,
        userId = userId,
    }
    grantedFields[sourceField] = sourceId
    self._logger:info("expedition_" .. sourceKind .. "_reward_granted", grantedFields)
    local player = Players:GetPlayerByUserId(userId)
    if player ~= nil then
        local profileResult = self._profileService:grantUnbankedExpeditionReward(
            player,
            transactionId,
            manifestHash,
            reward
        )
        local persistedFields: { [string]: any } = {
            durable = profileResult.durable == true,
            player = userId,
            transaction = transactionId,
        }
        persistedFields[sourceField] = sourceId
        self._logger:info("expedition_" .. sourceKind .. "_reward_persisted", persistedFields)
    end
    return true
end

function ExpeditionService._grantReward(
    self: ExpeditionService,
    userId: number,
    state: any,
    definition: any
): boolean
    local transactionId = state.rewardTransactionId
    if type(transactionId) ~= "string" then
        return false
    end
    return self:_grant(
        userId,
        transactionId,
        state.manifestHash,
        definition.reward,
        "event",
        definition.id
    )
end

function ExpeditionService.grantEncounterReward(
    self: ExpeditionService,
    userId: number,
    encounterId: string,
    transactionId: string,
    reward: any
): boolean
    local validEncounter = string.sub(encounterId, 1, 6) == "elite_"
        or string.sub(encounterId, 1, 5) == "boss_"
    if not validEncounter then
        self._logger:warn("expedition_encounter_reward_rejected", {
            encounter = encounterId,
            reason = "invalid_encounter_id",
            userId = userId,
        })
        return false
    end
    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    return self:_grant(userId, transactionId, manifest.hash, reward, "encounter", encounterId)
end

function ExpeditionService.interact(
    self: ExpeditionService,
    player: Player,
    prompt: ProximityPrompt
): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return {
            accepted = false,
            message = "ENTER BRAMBLEWAKE TO ANSWER THIS EVENT",
            reason = "player_not_in_expedition",
        }
    end

    local eventId = prompt:GetAttribute("EventId")
    local stepId = prompt:GetAttribute("EventStepId")
    if type(eventId) ~= "string" or type(stepId) ~= "string" then
        return {
            accepted = false,
            message = "THAT EVENT MARK IS INVALID",
            reason = "invalid_prompt_contract",
        }
    end
    local state = self._eventStates[eventId]
    local definition = self._generator.eventDefinition(eventId)
    if state == nil or definition == nil then
        return {
            accepted = false,
            message = "THAT EVENT IS NO LONGER AVAILABLE",
            reason = "unknown_event",
        }
    end

    local result =
        self._eventFlow.contribute(state, definition, stepId, tostring(player.UserId), os.clock())
    if result.changed then
        self._worldService:setExpeditionEventState(eventId, state)
    end
    if result.started then
        self._analyticsService:expeditionEventStarted(player, definition, state.manifestHash)
    end
    if result.completed then
        for participantId in state.participants do
            local userId = tonumber(participantId)
            if userId ~= nil then
                self:_grantReward(userId, state, definition)
            end
        end
        self._analyticsService:expeditionEventCompleted(
            player,
            definition,
            state.manifestHash,
            state.rewardTransactionId,
            self:_participantCount(state)
        )
    end

    if result.completed then
        result.message = definition.completionMessage
    elseif result.duplicate then
        result.message = "THAT EVENT MARK IS ALREADY SET"
    elseif result.failed or result.reason == "event_failed" or result.reason == "event_expired" then
        result.message = definition.failureMessage
    elseif result.accepted then
        result.message = string.format(
            "%s — %d/%d",
            string.upper(definition.displayName),
            state.progress,
            state.total
        )
    elseif result.reason == "event_disabled" then
        result.message = "THIS EVENT IS TEMPORARILY DORMANT"
    else
        result.message = "THAT EVENT ACTION WAS REJECTED"
    end

    if not result.accepted then
        self._logger:warn("expedition_event_interaction_rejected", {
            event = eventId,
            player = player.UserId,
            reason = result.reason,
            step = stepId,
        })
    end
    return result
end

function ExpeditionService._combinedPending(self: ExpeditionService, player: Player): any
    local sessionPending = self._rewardLedger.pending(self._rewardLedgerState, player.UserId)
    local profileInventory = self._profileService:inventorySnapshot(player)
    local materials: { [string]: number } = {}
    local rewards = {}
    local seen: { [string]: boolean } = {}
    for _, reward in profileInventory.pendingRewards do
        seen[reward.transactionId] = true
        materials[reward.materialId] = (materials[reward.materialId] or 0) + reward.amount
        table.insert(rewards, reward)
    end
    for _, reward in sessionPending.rewards do
        if not seen[reward.transactionId] then
            seen[reward.transactionId] = true
            materials[reward.materialId] = (materials[reward.materialId] or 0) + reward.amount
            table.insert(rewards, reward)
        end
    end
    table.sort(rewards, function(left: any, right: any): boolean
        return left.transactionId < right.transactionId
    end)
    return {
        banked = profileInventory.banked,
        materials = materials,
        rewards = rewards,
    }
end

function ExpeditionService.extract(self: ExpeditionService, player: Player): any
    if player:GetAttribute("LastLightInExpedition") ~= true then
        return {
            accepted = false,
            message = "YOU ARE NOT INSIDE BRAMBLEWAKE",
            reason = "player_not_in_expedition",
        }
    end

    local manifest = assert(self._manifest, "expedition manifest was not initialized")
    local sessionPending = self._rewardLedger.pending(self._rewardLedgerState, player.UserId)
    local combinedPending = self:_combinedPending(player)
    if #combinedPending.rewards == 0 then
        if not self._worldService:exitBramblewake(player) then
            return {
                accepted = false,
                message = "WAYHOME TRANSITION WILL RETRY",
                reason = "transition_unavailable",
            }
        end
        self._analyticsService:expeditionExtracted(player, manifest.hash, nil, 0)
        return {
            accepted = true,
            banked = combinedPending.banked,
            message = "RETURNING TO EMBERHOLLOW — POUCH EMPTY",
            settlementId = nil,
        }
    end

    local settlement = self._profileService:settleExpedition(
        player,
        self._runId,
        manifest.hash,
        sessionPending.rewards
    )
    if not settlement.accepted then
        self._analyticsService:expeditionExtractionFailed(player, manifest.hash, settlement.reason)
        return {
            accepted = false,
            message = if settlement.reason == "profile_read_only"
                then "PROFILE OFFLINE — REWARDS REMAIN UNBANKED"
                elseif
                    settlement.reason == "save_pending"
                then "BANKING RETRY NEEDED — REWARDS REMAIN UNBANKED"
                else "WAYHOME GATE IS WAITING FOR YOUR PROFILE",
            reason = settlement.reason,
        }
    end

    if settlement.settlementId ~= nil then
        self._rewardLedger.settle(
            self._rewardLedgerState,
            player.UserId,
            settlement.settlementId,
            sessionPending.transactionIds
        )
    end
    if not self._worldService:exitBramblewake(player) then
        return {
            accepted = false,
            message = "REWARDS BANKED — WAYHOME TRANSITION WILL RETRY",
            reason = "transition_unavailable",
        }
    end

    local bankedAmount = 0
    for _, amount in settlement.materials or {} do
        bankedAmount += amount
    end
    self._analyticsService:expeditionExtracted(
        player,
        manifest.hash,
        settlement.settlementId,
        bankedAmount
    )
    return {
        accepted = true,
        banked = settlement.inventory,
        message = if settlement.empty
            then "RETURNING TO EMBERHOLLOW — POUCH EMPTY"
            else string.format("WAYHOME — %d MATERIALS BANKED", bankedAmount),
        settlementId = settlement.settlementId,
    }
end

function ExpeditionService.snapshot(self: ExpeditionService, player: Player): any
    self:_refreshExpired(os.clock())
    local snapshot = self._worldService:expeditionSnapshot(player)
    local inventory = self:_combinedPending(player)
    snapshot.unbankedRewards = inventory.materials
    snapshot.bankedMaterials = inventory.banked
    if not snapshot.active then
        return snapshot
    end

    local moduleDefinition = self._generator.moduleDefinition(snapshot.moduleId)
    local poiDefinition = if snapshot.poiId == nil
        then nil
        else self._generator.pointOfInterestDefinition(snapshot.poiId)
    local eventDefinition = if snapshot.eventId == nil
        then nil
        else self._generator.eventDefinition(snapshot.eventId)
    snapshot.moduleName = moduleDefinition.displayName
    snapshot.pointOfInterestName = if poiDefinition == nil then nil else poiDefinition.displayName
    snapshot.eventName = if eventDefinition == nil then nil else eventDefinition.displayName
    if eventDefinition ~= nil then
        local state = self._eventStates[snapshot.eventId]
        if state ~= nil then
            snapshot.event = self._eventFlow.snapshot(state, eventDefinition, os.clock())
            snapshot.eventRevision = state.revision
        end
    end
    return snapshot
end

function ExpeditionService.manifest(self: ExpeditionService): any
    return self._manifest
end

function ExpeditionService.runId(self: ExpeditionService): string
    return self._runId
end

return table.freeze(ExpeditionService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">FeatureFlagService</string>
            <string name="Source"><![CDATA[--!strict

local FeatureFlagService = {}
FeatureFlagService.__index = FeatureFlagService
FeatureFlagService.Name = "FeatureFlagService"

export type Logger = {
    info: (self: Logger, event: string, fields: { [string]: any }?) -> (),
    warn: (self: Logger, event: string, fields: { [string]: any }?) -> (),
}

export type FeatureFlagService = typeof(setmetatable(
    {} :: {
        Name: string,
        _defaults: { [string]: boolean },
        _overrides: { [string]: boolean },
        _allowOverrides: boolean,
        _logger: Logger,
    },
    FeatureFlagService
))

function FeatureFlagService.new(
    defaults: { [string]: boolean },
    allowOverrides: boolean,
    logger: Logger
): FeatureFlagService
    return setmetatable({
        Name = FeatureFlagService.Name,
        _defaults = table.clone(defaults),
        _overrides = {},
        _allowOverrides = allowOverrides,
        _logger = logger,
    }, FeatureFlagService)
end

function FeatureFlagService.Init(self: FeatureFlagService, _context: any)
    self._logger:info("feature_flags_initialized", {
        count = self:count(),
        overridesAllowed = self._allowOverrides,
    })
end

function FeatureFlagService.Start(self: FeatureFlagService)
    self._logger:info("feature_flags_started")
end

function FeatureFlagService.isEnabled(self: FeatureFlagService, flag: string): boolean
    local override = self._overrides[flag]
    if override ~= nil then
        return override
    end

    local value = self._defaults[flag]
    assert(value ~= nil, string.format("unknown feature flag %q", flag))
    return value
end

function FeatureFlagService.setOverride(
    self: FeatureFlagService,
    flag: string,
    enabled: boolean
): (boolean, string?)
    if not self._allowOverrides then
        self._logger:warn("feature_flag_override_rejected", { flag = flag })
        return false, "overrides are disabled in this environment"
    end

    if self._defaults[flag] == nil then
        return false, "unknown feature flag"
    end

    self._overrides[flag] = enabled
    self._logger:info("feature_flag_overridden", { flag = flag, enabled = enabled })
    return true, nil
end

function FeatureFlagService.clearOverride(self: FeatureFlagService, flag: string)
    self._overrides[flag] = nil
end

function FeatureFlagService.count(self: FeatureFlagService): number
    local count = 0
    for _ in self._defaults do
        count += 1
    end
    return count
end

function FeatureFlagService.snapshot(self: FeatureFlagService): { [string]: boolean }
    local snapshot = table.clone(self._defaults)
    for flag, value in self._overrides do
        snapshot[flag] = value
    end
    return snapshot
end

return table.freeze(FeatureFlagService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Logger</string>
            <string name="Source"><![CDATA[--!strict

local Logger = {}
Logger.__index = Logger

export type Fields = { [string]: any }
export type Sink = (level: string, line: string, fields: Fields) -> ()
export type Logger = typeof(setmetatable(
    {} :: {
        _environment: string,
        _minimumLevel: number,
        _sink: Sink,
    },
    Logger
))

local levels = {
    debug = 1,
    info = 2,
    warn = 3,
    error = 4,
}

local function defaultSink(level: string, line: string, _fields: Fields)
    if level == "warn" or level == "error" then
        warn(line)
    else
        print(line)
    end
end

local function formatFields(fields: Fields): string
    local keys: { string } = {}
    for key in fields do
        table.insert(keys, key)
    end
    table.sort(keys)

    local output: { string } = {}
    for _, key in keys do
        table.insert(output, string.format("%s=%s", key, tostring(fields[key])))
    end

    return table.concat(output, " ")
end

function Logger.new(environment: string, minimumLevel: string, sink: Sink?): Logger
    assert(levels[minimumLevel] ~= nil, "unknown minimum log level")
    return setmetatable({
        _environment = environment,
        _minimumLevel = levels[minimumLevel],
        _sink = sink or defaultSink,
    }, Logger)
end

function Logger._emit(self: Logger, level: string, event: string, fields: Fields?)
    if levels[level] < self._minimumLevel then
        return
    end

    local safeFields = fields or {}
    local suffix = formatFields(safeFields)
    local line =
        string.format("[LastLight][%s][%s] %s", string.upper(level), self._environment, event)
    if suffix ~= "" then
        line ..= " " .. suffix
    end

    self._sink(level, line, safeFields)
end

function Logger.debug(self: Logger, event: string, fields: Fields?)
    self:_emit("debug", event, fields)
end

function Logger.info(self: Logger, event: string, fields: Fields?)
    self:_emit("info", event, fields)
end

function Logger.warn(self: Logger, event: string, fields: Fields?)
    self:_emit("warn", event, fields)
end

function Logger.error(self: Logger, event: string, fields: Fields?)
    self:_emit("error", event, fields)
end

return table.freeze(Logger)
]]></string>
