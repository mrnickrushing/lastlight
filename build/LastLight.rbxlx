      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">SaveSchema</string>
          <string name="Source"><![CDATA[--!strict

local TutorialFlow = require("./TutorialFlow")
local ExpeditionInventory = require("./ExpeditionInventory")
local ProfessionCatalog = require("./ProfessionCatalog")
local Crafting = require("./Crafting")
local Quests = require("./Quests")
local ProfessionMastery = require("./ProfessionMastery")
local Equipment = require("./Equipment")
local TownProgression = require("./TownProgression")

local SaveSchema = {}

export type Tutorial = {
    stage: TutorialFlow.Stage,
    complete: boolean,
    selectedTool: string?,
    completedAt: number?,
}

export type Profile = {
    schemaVersion: number,
    createdAt: number,
    updatedAt: number,
    revision: number,
    tutorial: Tutorial,
    inventory: any,
    profession: {
        selectedId: string?,
        mastery: ProfessionMastery.State,
    },
    story: {
        chapterOne: {
            completedAt: number?,
            decision: string?,
            status: string,
            transactionId: string?,
            wardenOutcome: string?,
        },
    },
    town: {
        nightNumber: number,
    },
    gear: { [string]: number },
    equipped: Equipment.Equipped,
    quests: {
        claimed: { [string]: boolean },
    },
}

local MAX_NIGHT_NUMBER = 1_000_000

local CHAPTER_ONE_DECISIONS = table.freeze({
    restore_farmland = true,
    wild_regrowth = true,
    shared_agroforest = true,
})
local WARDEN_OUTCOMES = table.freeze({
    preserved = true,
    scarred = true,
    harmed = true,
})

function SaveSchema.default(now: number): Profile
    return {
        schemaVersion = 8,
        createdAt = now,
        updatedAt = now,
        revision = 0,
        tutorial = {
            stage = "arrive",
            complete = false,
            selectedTool = nil,
            completedAt = nil,
        },
        inventory = ExpeditionInventory.default(),
        profession = {
            selectedId = nil,
            mastery = ProfessionMastery.default(),
        },
        story = {
            chapterOne = {
                completedAt = nil,
                decision = nil,
                status = "unresolved",
                transactionId = nil,
                wardenOutcome = nil,
            },
        },
        town = {
            nightNumber = 1,
        },
        gear = Crafting.default(),
        equipped = Equipment.default(),
        quests = {
            claimed = Quests.default(),
        },
    }
end

function SaveSchema.normalize(value: any, now: number): Profile
    local profile = SaveSchema.default(now)
    if type(value) ~= "table" then
        return profile
    end

    if type(value.createdAt) == "number" and value.createdAt > 0 then
        profile.createdAt = value.createdAt
    end
    if type(value.updatedAt) == "number" and value.updatedAt > 0 then
        profile.updatedAt = value.updatedAt
    end
    if type(value.revision) == "number" and value.revision >= 0 then
        profile.revision = math.floor(value.revision)
    end

    local tutorial = value.tutorial
    if type(tutorial) == "table" then
        if TutorialFlow.isValidStage(tutorial.stage) then
            profile.tutorial.stage = tutorial.stage
        end
        if tutorial.complete == true or profile.tutorial.stage == "complete" then
            profile.tutorial.complete = true
            profile.tutorial.stage = "complete"
        end
        if
            type(tutorial.selectedTool) == "string"
            and (
                tutorial.selectedTool == "axe"
                or tutorial.selectedTool == "hammer"
                or tutorial.selectedTool == "torch"
            )
        then
            profile.tutorial.selectedTool = tutorial.selectedTool
        end
        if
            profile.tutorial.complete
            and type(tutorial.completedAt) == "number"
            and tutorial.completedAt > 0
        then
            profile.tutorial.completedAt = tutorial.completedAt
        end
    end

    profile.inventory = ExpeditionInventory.normalize(value.inventory)
    local profession = value.profession
    if type(profession) == "table" then
        if ProfessionCatalog.isValid(profession.selectedId) then
            profile.profession.selectedId = profession.selectedId
        end
        profile.profession.mastery = ProfessionMastery.normalize(profession.mastery)
    end
    local story = value.story
    local chapterOne = if type(story) == "table" then story.chapterOne else nil
    if
        type(chapterOne) == "table"
        and chapterOne.status == "complete"
        and CHAPTER_ONE_DECISIONS[chapterOne.decision] == true
        and WARDEN_OUTCOMES[chapterOne.wardenOutcome] == true
        and type(chapterOne.transactionId) == "string"
        and chapterOne.transactionId ~= ""
        and #chapterOne.transactionId <= 160
        and type(chapterOne.completedAt) == "number"
        and chapterOne.completedAt > 0
    then
        profile.story.chapterOne = {
            completedAt = chapterOne.completedAt,
            decision = chapterOne.decision,
            status = "complete",
            transactionId = chapterOne.transactionId,
            wardenOutcome = chapterOne.wardenOutcome,
        }
    end
    local town = value.town
    if
        type(town) == "table"
        and type(town.nightNumber) == "number"
        and town.nightNumber >= 1
        and town.nightNumber <= MAX_NIGHT_NUMBER
        and town.nightNumber == math.floor(town.nightNumber)
    then
        profile.town.nightNumber = town.nightNumber
    end
    profile.gear = Crafting.normalizeGear(value.gear)
    profile.equipped = Equipment.normalize(value.equipped)
    local quests = value.quests
    profile.quests.claimed =
        Quests.normalizeClaimed(if type(quests) == "table" then quests.claimed else nil)

    profile.schemaVersion = 8
    return profile
end

function SaveSchema.withTutorial(
    profile: Profile,
    stage: TutorialFlow.Stage,
    selectedTool: string?,
    now: number
): Profile
    local nextProfile = table.clone(profile)
    nextProfile.tutorial = table.clone(profile.tutorial)
    nextProfile.tutorial.stage = stage
    nextProfile.tutorial.complete = stage == "complete"
    nextProfile.tutorial.selectedTool = selectedTool
    if stage == "complete" then
        if not profile.tutorial.complete or nextProfile.tutorial.completedAt == nil then
            nextProfile.tutorial.completedAt = now
        end
    else
        nextProfile.tutorial.completedAt = nil
    end
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

function SaveSchema.withProfession(profile: Profile, professionId: string, now: number): Profile
    assert(ProfessionCatalog.isValid(professionId), "profession ID is invalid")
    local nextProfile = table.clone(profile)
    nextProfile.profession = table.clone(profile.profession)
    nextProfile.profession.selectedId = professionId
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

function SaveSchema.withMasteryAward(
    profile: Profile,
    professionId: string,
    amount: number,
    now: number
): (Profile, any)
    local nextMastery, result =
        ProfessionMastery.award(profile.profession.mastery, professionId, amount)
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.profession = table.clone(profile.profession)
    nextProfile.profession.mastery = nextMastery
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.withUnbankedExpeditionReward(
    profile: Profile,
    transactionId: string,
    manifestHash: string,
    reward: any,
    now: number
): (Profile, any)
    local nextInventory, result =
        ExpeditionInventory.addUnbanked(profile.inventory, transactionId, manifestHash, reward, now)
    if not result.applied then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.inventory = nextInventory
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.expeditionPending(profile: Profile): any
    return ExpeditionInventory.pending(profile.inventory)
end

function SaveSchema.expeditionSettlementId(
    runId: string,
    userId: number,
    pendingFingerprint: string
): string
    return ExpeditionInventory.settlementId(runId, userId, pendingFingerprint)
end

function SaveSchema.withExpeditionSettlement(
    profile: Profile,
    settlementId: string,
    manifestHash: string,
    now: number
): (Profile, any)
    local nextInventory, result =
        ExpeditionInventory.settle(profile.inventory, settlementId, manifestHash, now)
    if not result.applied then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.inventory = nextInventory
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.hasExpeditionSettlement(profile: Profile, settlementId: string): boolean
    return ExpeditionInventory.hasSettlement(profile.inventory, settlementId)
end

function SaveSchema.hasExpeditionReward(profile: Profile, transactionId: string): boolean
    return ExpeditionInventory.hasReward(profile.inventory, transactionId)
end

function SaveSchema.findExpeditionSettlementForRewards(
    profile: Profile,
    rewardTransactionIds: { string }
): (string?, any?)
    return ExpeditionInventory.findSettlementForRewards(profile.inventory, rewardTransactionIds)
end

function SaveSchema.withChapterOneResolution(
    profile: Profile,
    transactionId: string,
    decision: string,
    wardenOutcome: string,
    now: number
): (Profile, any)
    assert(transactionId ~= "" and #transactionId <= 160, "chapter transaction ID is invalid")
    assert(CHAPTER_ONE_DECISIONS[decision] == true, "chapter decision is invalid")
    assert(WARDEN_OUTCOMES[wardenOutcome] == true, "Warden outcome is invalid")
    local current = profile.story.chapterOne
    if current.status == "complete" then
        return profile,
            {
                applied = false,
                duplicate = current.transactionId == transactionId,
                reason = if current.transactionId == transactionId
                    then "duplicate"
                    else "chapter_already_resolved",
                record = table.clone(current),
            }
    end

    local nextProfile = table.clone(profile)
    nextProfile.story = table.clone(profile.story)
    nextProfile.story.chapterOne = {
        completedAt = now,
        decision = decision,
        status = "complete",
        transactionId = transactionId,
        wardenOutcome = wardenOutcome,
    }
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile,
        {
            applied = true,
            duplicate = false,
            reason = "resolved",
            record = table.clone(nextProfile.story.chapterOne),
        }
end

function SaveSchema.chapterOne(profile: Profile): any
    return table.clone(profile.story.chapterOne)
end

-- The town's night count is server-session state (see TownNightService) that
-- gets pushed out to every connected player's own profile whenever a night
-- completes, so a later server session can resume from whichever returning
-- player's record is highest instead of always restarting at night one.
function SaveSchema.withNightNumber(profile: Profile, nightNumber: number, now: number): Profile
    assert(
        type(nightNumber) == "number"
            and nightNumber >= 1
            and nightNumber <= MAX_NIGHT_NUMBER
            and nightNumber == math.floor(nightNumber),
        "night number is invalid"
    )
    if nightNumber <= profile.town.nightNumber then
        return profile
    end
    local nextProfile = table.clone(profile)
    nextProfile.town = table.clone(profile.town)
    nextProfile.town.nightNumber = nightNumber
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile
end

function SaveSchema.nightNumber(profile: Profile): number
    return profile.town.nightNumber
end

function SaveSchema.withCraftedItem(profile: Profile, recipeId: string, now: number): (Profile, any)
    local nextMaterials, nextGear, result =
        Crafting.craft(profile.inventory.materials, profile.gear, recipeId)
    if not result.applied then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.inventory = table.clone(profile.inventory)
    nextProfile.inventory.materials = nextMaterials
    nextProfile.gear = nextGear
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.gearSnapshot(profile: Profile): { [string]: number }
    return table.clone(profile.gear)
end

function SaveSchema.masterySnapshot(profile: Profile): ProfessionMastery.State
    return ProfessionMastery.snapshot(profile.profession.mastery)
end

function SaveSchema.equippedSnapshot(profile: Profile): Equipment.Equipped
    return Equipment.normalize(profile.equipped)
end

function SaveSchema.equipmentStats(profile: Profile): any
    return Equipment.stats(profile.equipped)
end

function SaveSchema.withEquippedItem(profile: Profile, itemId: string, now: number): (Profile, any)
    local nextEquipped, result = Equipment.equip(profile.gear, profile.equipped, itemId)
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.equipped = nextEquipped
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.withUnequippedItem(profile: Profile, slot: string, now: number): (Profile, any)
    local nextEquipped, result = Equipment.unequip(profile.equipped, slot)
    if not result.applied then
        return profile, result
    end
    local nextProfile = table.clone(profile)
    nextProfile.equipped = nextEquipped
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

function SaveSchema.withUsedGearItem(profile: Profile, itemId: string, now: number): (Profile, any)
    local nextGear, result = Crafting.useItem(profile.gear, itemId)
    if not result.applied then
        return profile, result
    end

    local nextProfile = table.clone(profile)
    nextProfile.gear = nextGear
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, result
end

local function questSignals(profile: Profile): Quests.Signals
    local craftedItems = 0
    for _, count in profile.gear do
        craftedItems += count
    end
    return {
        bramblewakeSettlements = #profile.inventory.settlementOrder,
        craftedItems = craftedItems,
        nightsSurvived = math.max(0, profile.town.nightNumber - 1),
    }
end

-- Opportunistic, not event-driven: call this after any action that could
-- move a quest signal (a night completing, a craft succeeding, an
-- expedition settling). Safe to call anytime, including when nothing is
-- newly claimable — it just returns an empty result list and the same
-- profile reference.
function SaveSchema.checkAndClaimQuests(profile: Profile, now: number): (Profile, { any })
    local nextClaimed, nextMaterials, claimedResults = Quests.checkAndClaim(
        profile.quests.claimed,
        profile.inventory.materials,
        questSignals(profile)
    )
    if #claimedResults == 0 then
        return profile, claimedResults
    end

    local nextProfile = table.clone(profile)
    nextProfile.quests = table.clone(profile.quests)
    nextProfile.quests.claimed = nextClaimed
    nextProfile.inventory = table.clone(profile.inventory)
    nextProfile.inventory.materials = nextMaterials
    nextProfile.updatedAt = now
    nextProfile.revision += 1
    return nextProfile, claimedResults
end

function SaveSchema.questSnapshot(profile: Profile): { any }
    return Quests.snapshot(profile.quests.claimed, questSignals(profile))
end

function SaveSchema.townConsequence(profile: Profile): TownProgression.Consequence
    return TownProgression.resolve(profile)
end

return table.freeze(SaveSchema)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">StatusEffectState</string>
          <string name="Source"><![CDATA[--!strict

local StatusEffectState = {}

export type State = {
    drowsyUntil: number,
    drowsyMultiplier: number,
    rootedUntil: number,
    rootedMultiplier: number,
    shieldUntil: number,
    shieldMultiplier: number,
}

export type Snapshot = {
    drowsy: boolean,
    drowsyUntil: number,
    movementMultiplier: number,
    rooted: boolean,
    rootedUntil: number,
    shielded: boolean,
    shieldUntil: number,
    damageMultiplier: number,
}

function StatusEffectState.create(): State
    return {
        drowsyUntil = 0,
        drowsyMultiplier = 1,
        rootedUntil = 0,
        rootedMultiplier = 1,
        shieldUntil = 0,
        shieldMultiplier = 1,
    }
end

function StatusEffectState.applyDrowsy(
    state: State,
    now: number,
    duration: number,
    multiplier: number
): State
    local nextState = table.clone(state)
    local untilTime = now + math.max(0, duration)
    if untilTime >= state.drowsyUntil then
        nextState.drowsyUntil = untilTime
        nextState.drowsyMultiplier = math.clamp(multiplier, 0.25, 1)
    end
    return nextState
end

function StatusEffectState.applyRooted(
    state: State,
    now: number,
    duration: number,
    multiplier: number
): State
    local nextState = table.clone(state)
    local untilTime = now + math.max(0, duration)
    if untilTime >= state.rootedUntil then
        nextState.rootedUntil = untilTime
        nextState.rootedMultiplier = math.clamp(multiplier, 0.25, 1)
    end
    return nextState
end

-- Reduces incoming damage for a short window, the same duration+multiplier
-- shape applyDrowsy/applyRooted already use for movement, just applied to
-- damage instead. Kept independent of ProfessionService's Warden-only
-- mitigateIncomingDamage so an item-granted shield can stack with (rather
-- than replace) a profession's own guard ability.
function StatusEffectState.applyShield(
    state: State,
    now: number,
    duration: number,
    multiplier: number
): State
    local nextState = table.clone(state)
    local untilTime = now + math.max(0, duration)
    if untilTime >= state.shieldUntil then
        nextState.shieldUntil = untilTime
        nextState.shieldMultiplier = math.clamp(multiplier, 0.1, 1)
    end
    return nextState
end

function StatusEffectState.clear(_state: State): State
    return StatusEffectState.create()
end

function StatusEffectState.snapshot(state: State, now: number): Snapshot
    local active = now < state.drowsyUntil
    local rooted = now < state.rootedUntil
    local shielded = now < state.shieldUntil
    local movementMultiplier = 1
    if active then
        movementMultiplier = math.min(movementMultiplier, state.drowsyMultiplier)
    end
    if rooted then
        movementMultiplier = math.min(movementMultiplier, state.rootedMultiplier)
    end
    return {
        drowsy = active,
        drowsyUntil = if active then state.drowsyUntil else 0,
        movementMultiplier = movementMultiplier,
        rooted = rooted,
        rootedUntil = if rooted then state.rootedUntil else 0,
        shielded = shielded,
        shieldUntil = if shielded then state.shieldUntil else 0,
        damageMultiplier = if shielded then state.shieldMultiplier else 1,
    }
end

return table.freeze(StatusEffectState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">SurvivalState</string>
          <string name="Source"><![CDATA[--!strict

local Config = require("./Config")

local SurvivalState = {}

export type Status = "active" | "downed"
export type State = {
    bleedoutAt: number?,
    downedAt: number?,
    health: number,
    invulnerableUntil: number,
    maxHealth: number,
    revision: number,
    status: Status,
}
export type TransitionResult = {
    applied: boolean,
    damage: number?,
    healed: number?,
    downed: boolean?,
    health: number?,
    reason: string?,
}
export type Snapshot = {
    bleedoutAt: number?,
    downed: boolean,
    downedDuration: number,
    health: number,
    invulnerable: boolean,
    maxHealth: number,
    revision: number,
    timeRemaining: number,
}

local MAX_HEALTH = Config.MaxHealth
local DOWNED_SECONDS = Config.DownedSeconds
local REVIVE_HEALTH = Config.ReviveHealth
local RECOVERY_HEALTH = Config.RecoveryHealth
local REVIVE_INVULNERABILITY_SECONDS = Config.ReviveInvulnerabilitySeconds
local RECOVERY_INVULNERABILITY_SECONDS = Config.RecoveryInvulnerabilitySeconds

local function validNumber(value: any): boolean
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function SurvivalState.create(now: number): State
    assert(validNumber(now), "survival state time is invalid")
    return {
        health = MAX_HEALTH,
        maxHealth = MAX_HEALTH,
        status = "active",
        downedAt = nil,
        bleedoutAt = nil,
        invulnerableUntil = now,
        revision = 0,
    }
end

function SurvivalState.damage(state: State, amount: number, now: number): (State, TransitionResult)
    if not validNumber(amount) or amount <= 0 or amount ~= math.floor(amount) then
        return state,
            {
                applied = false,
                reason = "invalid_damage",
            }
    end
    if state.status ~= "active" then
        return state, {
            applied = false,
            reason = "player_downed",
        }
    end
    if now < state.invulnerableUntil then
        return state, {
            applied = false,
            reason = "invulnerable",
        }
    end

    local nextState: State = table.clone(state)
    nextState.health = math.max(0, state.health - amount)
    nextState.revision += 1
    local downed = nextState.health == 0
    if downed then
        nextState.status = "downed"
        nextState.downedAt = now
        nextState.bleedoutAt = now + DOWNED_SECONDS
    end
    return nextState,
        {
            applied = true,
            damage = math.min(amount, state.health),
            downed = downed,
        }
end

function SurvivalState.heal(state: State, amount: number): (State, TransitionResult)
    if not validNumber(amount) or amount <= 0 or amount ~= math.floor(amount) then
        return state, {
            applied = false,
            reason = "invalid_heal",
        }
    end
    if state.status ~= "active" then
        return state, {
            applied = false,
            reason = "player_downed",
        }
    end
    if state.health >= state.maxHealth then
        return state, {
            applied = false,
            reason = "full_health",
        }
    end

    local nextState: State = table.clone(state)
    nextState.health = math.min(state.maxHealth, state.health + amount)
    nextState.revision += 1
    return nextState,
        {
            applied = true,
            healed = nextState.health - state.health,
            health = nextState.health,
        }
end

function SurvivalState.revive(state: State, now: number): (State, TransitionResult)
    if state.status ~= "downed" then
        return state,
            {
                applied = false,
                reason = "player_not_downed",
            }
    end
    if type(state.bleedoutAt) ~= "number" or now >= state.bleedoutAt then
        return state,
            {
                applied = false,
                reason = "bleedout_expired",
            }
    end

    local nextState: State = table.clone(state)
    nextState.health = REVIVE_HEALTH
    nextState.status = "active"
    nextState.downedAt = nil
    nextState.bleedoutAt = nil
    nextState.invulnerableUntil = now + REVIVE_INVULNERABILITY_SECONDS
    nextState.revision += 1
    return nextState, {
        applied = true,
        health = nextState.health,
    }
end

function SurvivalState.recover(state: State, now: number): (State, TransitionResult)
    if state.status ~= "downed" then
        return state,
            {
                applied = false,
                reason = "player_not_downed",
            }
    end
    if type(state.bleedoutAt) ~= "number" or now < state.bleedoutAt then
        return state,
            {
                applied = false,
                reason = "bleedout_active",
            }
    end

    local nextState: State = table.clone(state)
    nextState.health = RECOVERY_HEALTH
    nextState.status = "active"
    nextState.downedAt = nil
    nextState.bleedoutAt = nil
    nextState.invulnerableUntil = now + RECOVERY_INVULNERABILITY_SECONDS
    nextState.revision += 1
    return nextState, {
        applied = true,
        health = nextState.health,
    }
end

function SurvivalState.safeRetreat(state: State, now: number): (State, TransitionResult)
    if state.status ~= "downed" then
        return state,
            {
                applied = false,
                reason = "player_not_downed",
            }
    end

    local nextState: State = table.clone(state)
    nextState.health = RECOVERY_HEALTH
    nextState.status = "active"
    nextState.downedAt = nil
    nextState.bleedoutAt = nil
    nextState.invulnerableUntil = now + RECOVERY_INVULNERABILITY_SECONDS
    nextState.revision += 1
    return nextState, {
        applied = true,
        health = nextState.health,
    }
end

function SurvivalState.respawn(state: State, now: number): State
    local nextState: State = table.clone(state)
    nextState.health = RECOVERY_HEALTH
    nextState.status = "active"
    nextState.downedAt = nil
    nextState.bleedoutAt = nil
    nextState.invulnerableUntil = now + RECOVERY_INVULNERABILITY_SECONDS
    nextState.revision += 1
    return nextState
end

function SurvivalState.canAct(state: State): boolean
    return state.status == "active" and state.health > 0
end

function SurvivalState.snapshot(state: State, now: number): Snapshot
    local bleedoutAt = if type(state.bleedoutAt) == "number" then state.bleedoutAt else nil
    return {
        bleedoutAt = bleedoutAt,
        downed = state.status == "downed",
        downedDuration = DOWNED_SECONDS,
        health = state.health,
        invulnerable = now < state.invulnerableUntil,
        maxHealth = state.maxHealth,
        revision = state.revision,
        timeRemaining = if bleedoutAt == nil then 0 else math.max(0, math.ceil(bleedoutAt - now)),
    }
end

SurvivalState.Constants = table.freeze({
    DownedSeconds = DOWNED_SECONDS,
    MaxHealth = MAX_HEALTH,
    RecoveryHealth = RECOVERY_HEALTH,
    ReviveHealth = REVIVE_HEALTH,
})

return table.freeze(SurvivalState)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">TownNightSchedule</string>
          <string name="Source"><![CDATA[--!strict

local TownNightSchedule = {}

export type Beat = {
    at: number,
    kind: "spawn" | "warning" | "breach",
    enemyId: string?,
    theme: string?,
}

-- The same six-enemy Bramblewake roster the authored first night uses. Normal
-- nights reuse it rather than adding new content: escalating pressure comes
-- from wave count, not new enemies, until a later production pass adds
-- night-specific variety.
local ROSTER: { string } = {
    "enemy_rootling",
    "enemy_briarback",
    "enemy_pollen_wisp",
    "enemy_hollow_crow",
    "enemy_snapvine",
    "enemy_bark_ram",
}

local MIN_WAVES = 3
local MAX_WAVES = 8
local THEMES = table.freeze({ "EMBERFALL", "MIRETIDE", "ROOTMOON", "ASHEN VEIL" })

function TownNightSchedule.theme(nightNumber: number): string
    assert(nightNumber >= 1 and nightNumber == math.floor(nightNumber), "night number is invalid")
    return THEMES[(nightNumber - 1) % #THEMES + 1]
end

function TownNightSchedule.waveCount(nightNumber: number): number
    assert(
        nightNumber >= 1 and nightNumber == math.floor(nightNumber),
        "night number must be a positive integer"
    )
    return math.clamp(MIN_WAVES - 1 + nightNumber, MIN_WAVES, MAX_WAVES)
end

-- Deterministic by design (no randomness) so a night's wave layout is fully
-- reproducible and testable, matching this project's existing expedition and
-- first-night schedules.
function TownNightSchedule.beats(duration: number, nightNumber: number): { Beat }
    assert(duration > 0, "duration must be positive")
    local waves = TownNightSchedule.waveCount(nightNumber)
    local theme = TownNightSchedule.theme(nightNumber)
    local result: { Beat } = { { at = 0, kind = "warning", enemyId = nil, theme = theme } }

    local windowStart = duration * 0.05
    local windowEnd = duration * 0.85
    local span = math.max(windowEnd - windowStart, 0)
    local breachAfterWave = math.ceil(waves / 2)
    local lastValidAt = math.max(duration - 1, 0)

    for index = 1, waves do
        local at = if waves == 1
            then windowStart
            else windowStart + span * (index - 1) / (waves - 1)
        at = math.min(at, lastValidAt)
        local rosterIndex = (index - 1 + nightNumber - 1) % #ROSTER + 1
        local enemyId = ROSTER[rosterIndex]
        table.insert(result, { at = at, kind = "spawn", enemyId = enemyId, theme = theme })
        if index == breachAfterWave then
            table.insert(result, {
                at = math.min(at + 1, lastValidAt),
                kind = "breach",
                enemyId = nil,
                theme = theme,
            })
        end
    end

    table.sort(result, function(a, b)
        return a.at < b.at
    end)
    return result
end

function TownNightSchedule.pending(duration: number, nightNumber: number, elapsed: number): { Beat }
    local result: { Beat } = {}
    for _, beat in TownNightSchedule.beats(duration, nightNumber) do
        if beat.at >= elapsed then
            table.insert(result, beat)
        end
    end
    return result
end

return table.freeze(TownNightSchedule)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">TownProgression</string>
          <string name="Source"><![CDATA[--!strict

local TownProgression = {}

export type Consequence = {
    tier: number,
    title: string,
    detail: string,
    decision: string?,
    wardenOutcome: string?,
}

function TownProgression.resolve(profile: any): Consequence
    local chapter = if type(profile) == "table" and type(profile.story) == "table"
        then profile.story.chapterOne
        else nil
    local town = if type(profile) == "table" and type(profile.town) == "table"
        then profile.town
        else nil
    local nights = if town ~= nil and type(town.nightNumber) == "number"
        then town.nightNumber
        else 1
    local tier = math.clamp(math.floor(math.max(0, nights - 1) / 3), 0, 3)
    local decision = if type(chapter) == "table" then chapter.decision else nil
    local outcome = if type(chapter) == "table" then chapter.wardenOutcome else nil
    if type(chapter) == "table" and chapter.status == "complete" then
        tier = math.max(1, tier)
    end
    local title = if decision == "restore_farmland"
        then "FARMLAND RENEWED"
        elseif decision == "wild_regrowth" then "WILD REGROWTH"
        elseif decision == "shared_agroforest" then "SHARED AGROFOREST"
        else "EMBERHOLLOW AWAKENS"
    local detail = if outcome == "preserved"
        then "The Warden's mercy keeps the old paths open."
        elseif outcome == "scarred" then "Scored roots mark a harder road through the forest."
        elseif outcome == "harmed" then "Broken antlers leave the town under a watchful shadow."
        else "Every safe night makes the lantern town stronger."
    return {
        tier = tier,
        title = title,
        detail = detail,
        decision = decision,
        wardenOutcome = outcome,
    }
end

return table.freeze(TownProgression)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">TutorialFlow</string>
          <string name="Source"><![CDATA[--!strict

local TutorialFlow = {}

export type Stage =
    "arrive"
    | "gather"
    | "choose_tool"
    | "build"
    | "prepare"
    | "survive"
    | "reveal"
    | "complete"

export type Definition = {
    index: number,
    action: string?,
    next: Stage?,
    objective: string,
    detail: string,
    mara: string,
}

local ORDER: { Stage } = {
    "arrive",
    "gather",
    "choose_tool",
    "build",
    "prepare",
    "survive",
    "reveal",
    "complete",
}

local DEFINITIONS: { [Stage]: Definition } = {
    arrive = {
        index = 1,
        action = "rescue",
        next = "gather",
        objective = "FREE MARA",
        detail = "Follow the lantern path to the fallen roots.",
        mara = "Over here! The roots tighten when the light fades.",
    },
    gather = {
        index = 2,
        action = "gather",
        next = "choose_tool",
        objective = "GATHER HEARTWOOD",
        detail = "Collect 3 Heartwood from the glowing stump.",
        mara = "Heartwood remembers sunlight. We can build with it.",
    },
    choose_tool = {
        index = 3,
        action = "choose_tool",
        next = "build",
        objective = "CHOOSE A STARTER TOOL",
        detail = "Axe, hammer, or torch — this choice is not permanent.",
        mara = "Choose what feels right. Emberhollow needs every kind of helper.",
    },
    build = {
        index = 4,
        action = "build",
        next = "prepare",
        objective = "BUILD THE BARRICADE",
        detail = "Use 3 Heartwood at the marked construction plot.",
        mara = "Place the braces toward the dark trail.",
    },
    prepare = {
        index = 5,
        action = "prepare",
        next = "survive",
        objective = "LIGHT THE FIRST LANTERN",
        detail = "Start the two-minute defense when you are ready.",
        mara = "Night is close. Light the lantern when you are ready.",
    },
    survive = {
        index = 6,
        action = nil,
        next = "reveal",
        objective = "KEEP THE LIGHT ALIVE",
        detail = "Defend the lantern until dawn.",
        mara = "Stay in the light. Rootlings hate a steady flame.",
    },
    reveal = {
        index = 7,
        action = "reveal",
        next = "complete",
        objective = "FOLLOW THE FIRST LIGHT",
        detail = "Reach the dawn beacon and reveal Bramblewake.",
        mara = "The lantern knows your name. Go—see what it remembered.",
    },
    complete = {
        index = 8,
        action = nil,
        next = nil,
        objective = "EMBERHOLLOW REMEMBERS YOU",
        detail = "First Light complete. The wider world is now ahead.",
        mara = "You brought the morning back. Welcome home.",
    },
}

function TutorialFlow.isValidStage(value: any): boolean
    return type(value) == "string" and DEFINITIONS[value :: Stage] ~= nil
end

function TutorialFlow.definition(stage: Stage): Definition
    local definition = DEFINITIONS[stage]
    assert(definition ~= nil, string.format("unknown tutorial stage %q", tostring(stage)))
    return definition
end

function TutorialFlow.advance(stage: Stage, action: string): (Stage?, string?)
    local definition = TutorialFlow.definition(stage)
    if definition.action == nil then
        return nil, "stage does not accept a player action"
    end
    if action ~= definition.action then
        return nil, string.format("expected %s", definition.action)
    end
    return definition.next, nil
end

function TutorialFlow.advanceSystem(stage: Stage): (Stage?, string?)
    if stage ~= "survive" then
        return nil, "only survive advances from a system event"
    end
    return "reveal", nil
end

function TutorialFlow.progress(stage: Stage): (number, number)
    return TutorialFlow.definition(stage).index, #ORDER
end

function TutorialFlow.order(): { Stage }
    return table.clone(ORDER)
end

return table.freeze(TutorialFlow)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict

export type EnvironmentName = "local" | "test" | "staging" | "production"
export type LogLevel = "debug" | "info" | "warn" | "error"
export type LogFields = { [string]: any }

export type Logger = {
    debug: (self: Logger, event: string, fields: LogFields?) -> (),
    info: (self: Logger, event: string, fields: LogFields?) -> (),
    warn: (self: Logger, event: string, fields: LogFields?) -> (),
    error: (self: Logger, event: string, fields: LogFields?) -> (),
}

export type FeatureFlagReader = {
    isEnabled: (self: FeatureFlagReader, flag: string) -> boolean,
}

export type ServiceContext = {
    environment: EnvironmentName,
    logger: Logger,
    featureFlags: FeatureFlagReader,
}

export type Service = {
    Name: string,
    Init: ((self: any, context: ServiceContext) -> ())?,
    Start: ((self: any) -> ())?,
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">WardenStagEncounter</string>
          <string name="Source"><![CDATA[--!strict

local WardenStagEncounter = {}

export type Status = "disabled" | "locked" | "dormant" | "cleansing" | "vulnerable" | "complete"

export type State = {
    antlersBroken: number,
    brokenAntlers: { [string]: boolean },
    cleansedNodes: { [string]: boolean },
    health: number,
    manifestHash: string,
    outcome: string?,
    participants: { [string]: boolean },
    phase: number,
    phaseAntlerBroken: boolean,
    revision: number,
    runId: string,
    status: Status,
}

local MAX_HEALTH = 480
local PHASE_THRESHOLDS = table.freeze({ 320, 160, 0 })
local ROOTS_REQUIRED = table.freeze({ 2, 3, 4 })
local ROOT_NODE_IDS = table.freeze({
    root_node_north = true,
    root_node_east = true,
    root_node_south = true,
    root_node_west = true,
})
local ANTLER_IDS = table.freeze({
    antler_left = true,
    antler_right = true,
})

local ROOTBOUND_CHARGE = table.freeze({
    attackId = "warden_stag_rootbound_charge",
    attackName = "ROOTBOUND CHARGE",
    damage = 24,
    instruction = "CLEAR THE CHARGE LANE",
    length = 42,
    rootedDuration = 1.2,
    rootedMultiplier = 0.45,
    shape = "lane",
    width = 11,
    windup = 1.55,
})

local ANTLER_ARC = table.freeze({
    attackId = "warden_stag_antler_arc",
    attackName = "ANTLER ARC",
    damage = 28,
    instruction = "LEAVE THE ANTLER RING",
    radius = 11,
    shape = "circle",
    windup = 1.7,
})

local MEMORY_STAMPEDE = table.freeze({
    attackId = "warden_stag_memory_stampede",
    attackName = "MEMORY STAMPEDE",
    damage = 32,
    instruction = "CROSS OUT OF THE MEMORY LANE",
    length = 48,
    rootedDuration = 1.5,
    rootedMultiplier = 0.38,
    shape = "lane",
    width = 14,
    windup = 1.9,
})

WardenStagEncounter.Id = "boss_warden_stag"
WardenStagEncounter.MaxHealth = MAX_HEALTH
WardenStagEncounter.RootNodeIds = ROOT_NODE_IDS
WardenStagEncounter.AntlerIds = ANTLER_IDS
WardenStagEncounter.Reward = table.freeze({
    amount = 5,
    materialId = "material_amber_sap",
})
WardenStagEncounter.Tuning = table.freeze({
    attackCooldownSeconds = 3.5,
    cleansingAttackCooldownSeconds = 4.4,
    markedAttackCooldownMultiplier = 1.35,
    markedStrikeDamage = 46,
    strikeDamage = 40,
})

local function participantKey(userId: number): string
    assert(userId > 0 and userId == math.floor(userId), "boss participant user ID is invalid")
    return tostring(userId)
end

local function cloneState(state: State): State
    local nextState = table.clone(state)
    nextState.brokenAntlers = table.clone(state.brokenAntlers)
    nextState.cleansedNodes = table.clone(state.cleansedNodes)
    nextState.participants = table.clone(state.participants)
    return nextState
end

local function countKeys(values: { [string]: boolean }): number
    local count = 0
    for _, value in values do
        if value then
            count += 1
        end
    end
    return count
end

local function isActive(status: Status): boolean
    return status == "cleansing" or status == "vulnerable"
end

function WardenStagEncounter.create(runId: string, manifestHash: string, enabled: boolean): State
    assert(runId ~= "", "Warden Stag run ID is required")
    assert(manifestHash ~= "", "Warden Stag manifest hash is required")
    return {
        antlersBroken = 0,
        brokenAntlers = {},
        cleansedNodes = {},
        health = MAX_HEALTH,
        manifestHash = manifestHash,
        outcome = nil,
        participants = {},
        phase = 1,
        phaseAntlerBroken = false,
        revision = 0,
        runId = runId,
        status = if enabled then "locked" else "disabled",
    }
end

function WardenStagEncounter.unlock(state: State): (State, any)
    if state.status ~= "locked" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.status = "dormant"
    nextState.revision += 1
    return nextState, {
        accepted = true,
        reason = "unlocked",
    }
end

function WardenStagEncounter.activate(state: State, userId: number): (State, any)
    if state.status ~= "dormant" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    nextState.status = "cleansing"
    nextState.revision += 1
    return nextState, {
        accepted = true,
        reason = "activated",
    }
end

function WardenStagEncounter.join(state: State, userId: number): State
    if not isActive(state.status) then
        return state
    end
    local key = participantKey(userId)
    if state.participants[key] then
        return state
    end
    local nextState = cloneState(state)
    nextState.participants[key] = true
    nextState.revision += 1
    return nextState
end

function WardenStagEncounter.cleanseRoot(state: State, userId: number, nodeId: string): (State, any)
    if state.status ~= "cleansing" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    if ROOT_NODE_IDS[nodeId] ~= true then
        return state,
            {
                accepted = false,
                reason = "invalid_root_node",
            }
    end
    if state.cleansedNodes[nodeId] then
        return state,
            {
                accepted = false,
                reason = "already_cleansed",
            }
    end

    local nextState = cloneState(state)
    nextState.cleansedNodes[nodeId] = true
    nextState.participants[participantKey(userId)] = true
    local cleansed = countKeys(nextState.cleansedNodes)
    local required = ROOTS_REQUIRED[nextState.phase]
    local exposed = cleansed >= required
    if exposed then
        nextState.status = "vulnerable"
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            cleansed = cleansed,
            exposed = exposed,
            reason = if exposed then "heart_exposed" else "root_cleansed",
            required = required,
        }
end

function WardenStagEncounter.breakAntler(
    state: State,
    userId: number,
    antlerId: string
): (State, any)
    if state.status ~= "cleansing" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end
    if ANTLER_IDS[antlerId] ~= true then
        return state,
            {
                accepted = false,
                reason = "invalid_antler",
            }
    end
    if state.phaseAntlerBroken then
        return state,
            {
                accepted = false,
                reason = "phase_antler_already_broken",
            }
    end
    if state.brokenAntlers[antlerId] then
        return state,
            {
                accepted = false,
                reason = "antler_already_broken",
            }
    end

    local nextState = cloneState(state)
    nextState.brokenAntlers[antlerId] = true
    nextState.antlersBroken += 1
    nextState.phaseAntlerBroken = true
    nextState.participants[participantKey(userId)] = true
    nextState.status = "vulnerable"
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            antlersBroken = nextState.antlersBroken,
            exposed = true,
            reason = "antler_broken",
        }
end

function WardenStagEncounter.strike(state: State, userId: number, amount: number): (State, any)
    assert(amount > 0 and amount <= 100, "Warden Stag strike amount is invalid")
    if state.status ~= "vulnerable" then
        return state, {
            accepted = false,
            reason = state.status,
        }
    end

    local nextState = cloneState(state)
    nextState.participants[participantKey(userId)] = true
    local threshold = PHASE_THRESHOLDS[state.phase]
    nextState.health = math.max(threshold, state.health - amount)
    local phaseFinished = nextState.health <= threshold
    if phaseFinished then
        if state.phase >= #PHASE_THRESHOLDS then
            nextState.health = 0
            nextState.status = "complete"
            nextState.outcome = if nextState.antlersBroken == 0
                then "preserved"
                elseif nextState.antlersBroken >= 2 then "harmed"
                else "scarred"
        else
            nextState.phase += 1
            nextState.phaseAntlerBroken = false
            nextState.cleansedNodes = {}
            nextState.status = "cleansing"
        end
    end
    nextState.revision += 1
    return nextState,
        {
            accepted = true,
            completed = nextState.status == "complete",
            damage = state.health - nextState.health,
            health = nextState.health,
            outcome = nextState.outcome,
            phase = nextState.phase,
            phaseFinished = phaseFinished,
            reason = if nextState.status == "complete"
                then "completed"
                elseif phaseFinished then "next_phase"
                else "damaged",
        }
end

function WardenStagEncounter.attack(attackIndex: number, phase: number): any
    if phase >= 3 then
        return if attackIndex % 2 == 0 then ANTLER_ARC else MEMORY_STAMPEDE
    elseif phase == 2 and attackIndex % 2 == 0 then
        return ANTLER_ARC
    end
    return ROOTBOUND_CHARGE
end

function WardenStagEncounter.snapshot(state: State, userId: number): any
    local cleansed = countKeys(state.cleansedNodes)
    local required = ROOTS_REQUIRED[state.phase] or ROOTS_REQUIRED[#ROOTS_REQUIRED]
    local instruction = if state.status == "cleansing"
        then string.format(
            "CLEANSE LIVING ROOTS %d/%d · BREAKING ANTLERS CHANGES THE FOREST",
            cleansed,
            required
        )
        elseif state.status == "vulnerable" then "HEART EXPOSED · STRIKE THE MEMORY SEAL"
        elseif state.status == "complete" then if state.outcome == "preserved"
            then "WARDEN STAG CALMED · FOREST ALLY PRESERVED"
            elseif state.outcome == "harmed" then "WARDEN STAG DEFEATED · FOREST HARMED"
            else "WARDEN STAG DEFEATED · FOREST SCARRED"
        elseif state.status == "dormant" then "ENTER THE WARDEN'S SEAL"
        elseif state.status == "locked" then "CLEANSE OLD GROWTH TO OPEN THE WARDEN'S SEAL"
        elseif state.status == "disabled" then "WARDEN STAG TEMPORARILY DORMANT"
        else "WARDEN STAG"
    return {
        active = isActive(state.status),
        antlersBroken = state.antlersBroken,
        choiceAvailable = state.status == "cleansing" and state.antlersBroken < 2,
        cleansedNodes = cleansed,
        complete = state.status == "complete",
        displayName = "WARDEN STAG",
        enabled = state.status ~= "disabled",
        exposed = state.status == "vulnerable",
        health = state.health,
        instruction = instruction,
        maxHealth = MAX_HEALTH,
        outcome = state.outcome,
        phase = state.phase,
        rewardEligible = state.participants[tostring(userId)] == true,
        revision = state.revision,
        rootNodesRequired = required,
        status = state.status,
    }
end

function WardenStagEncounter.rewardTransactionId(state: State, userId: number): string
    return string.format(
        "%s:%s:%s:%d",
        WardenStagEncounter.Id,
        state.runId,
        state.manifestHash,
        userId
    )
end

return table.freeze(WardenStagEncounter)
]]></string>
