{
  "name": "LastLightTest",
  "tree": {
    "$className": "DataModel",
    "AssetService": {
      "$properties": {
        "AllowInsertFreeAssets": true
      }
    },
    "ReplicatedFirst": {
      "$path": "src/first"
    },
    "ReplicatedStorage": {
      "LastLight": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "LastLightServer": {
        "$path": "src/server"
      },
      "LastLightTests": {
        "$path": "tests/studio"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "LastLightClient": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "ModelStreamingBehavior": "Improved",
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 1024,
        "PlayerScriptsUseInputActionSystem": "Enabled",
        "FallenPartsDestroyHeight": -80
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
