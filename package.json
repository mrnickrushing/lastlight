{
  "name": "lastlight",
  "private": true,
  "version": "0.31.0",
  "description": "Source, validation, and production blueprint for the Roblox game Last Light.",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate-plan.mjs && python3 scripts/validate_mesh_assets.py",
    "format": "stylua src tests scripts/verify-build.luau",
    "format:check": "stylua --check src tests scripts/verify-build.luau",
    "lint": "selene src tests scripts/verify-build.luau",
    "typecheck": "node scripts/typecheck.mjs",
    "test:luau": "lune run tests/run",
    "verify:build": "lune run scripts/verify-build",
    "test": "npm run check && npm run format:check && npm run lint && npm run typecheck && npm run test:luau && npm run build && npm run verify:build"
  },
  "engines": {
    "node": ">=20"
  }
}
