    ["story.the_delve_is_worked_in_short"] = "The Delve is worked in short shifts now, and nobody goes deep.",
    ["story.half_the_delve_breathes_the_other"] = "Half the Delve breathes. The other half is bricked up and marked.",
    ["story.the_fen_is_quiet_and_the"] = "The Fen is quiet, and the light in it stays where it is put.",
    ["story.the_fen_is_watched_what_is"] = "The Fen is watched. What is under it is held rather than gone.",
    ["story.the_fen_went_dark_all_at"] = "The Fen went dark all at once, and the water has not settled since.",
    ["story.the_harbour_takes_boats_again_two"] = "The harbour takes boats again. Two came in this spring.",
    ["story.the_channel_silted_where_the_tide"] = "The channel silted where the tide dropped, and only small craft use it.",
    ["story.there_is_no_harbour_mouth_any"] = "There is no harbour mouth any more, only a bay with a bad memory.",
    ["story.there_is_still_something_living_in"] = "There is still something living in the Vale, and it keeps to itself.",
    ["story.the_vale_is_emptier_every_year"] = "The Vale is emptier every year, but it is not empty.",
    ["story.nothing_calls_in_the_vale_now"] = "Nothing calls in the Vale now. The quiet up there is total.",
    ["story.every_true_face_in_the_crown"] = "Every true face in the Crown is still standing, and people go to read them.",
    ["story.some_of_the_crown_s_dead"] = "Some of the Crown's dead are still named. The rest are rubble nobody sorts.",
    ["story.the_crown_is_clean_stone_there"] = "The Crown is clean stone. There is no record left of who was in it.",
    ["story.the_lantern_road_still_runs_and"] = "The lantern road still runs, and there is always somebody below it.",
    ["story.there_is_no_lantern_road_the"] = "There is no lantern road. The nights are only nights now.",
    ["story.everyone_carries_a_piece_of_it"] = "Everyone carries a piece of it. No road, and nothing at the bottom.",
    ["story.the_lantern_kept"] = "THE LANTERN KEPT",
    ["story.the_lantern_put_out"] = "THE LANTERN PUT OUT",
    ["story.the_lantern_shared"] = "THE LANTERN SHARED",
    ["story.the_gate_went_first_and_the"] = "The gate went first, and the copy of this town burned from the road in.",
    ["story.it_came_up_the_road_past"] = "It came up the road, past the posts nobody could spare, into the middle.",
    ["story.it_reached_the_hearth_in_a"] = "It reached the hearth. In a town that was never lived in, that still mattered.",
    ["story.n_came_back_up_n_did"] = "%s came back up. %s did not, and everybody knows which.",
    ["story.n_came_back_up_with_you"] = "%s came back up with you.",
    ["story.nobody_came_back_up_with_you"] = "Nobody came back up with you. There was light for one.",
    ["story.emberhollow_is_still_standing_and_its"] = "Emberhollow is still standing, and its story is not written yet.",
    ["story.the_story_so_far"] = "THE STORY SO FAR",
    ["story.the_last_harvest"] = "THE LAST HARVEST",
    ["story.sunken_orchard"] = "Sunken Orchard",
    ["story.they_brought_it_in_anyway_every"] = "They brought it in anyway. Every apple, every root, knowing the carts left at dawn and the cellar stayed behind. Ena Moss's grandmother wrote the count in the ledger, and underneath it she wrote: we did not waste it, we only failed to carry it. The orchard has been holding that harvest ever since.",
    ["story.the_road_they_left"] = "THE ROAD THEY LEFT",
    ["story.someone_counted_children_at_this_bend"] = "Someone counted children at this bend. Counted twice, because the first count came up one short and the second came up right, and nobody afterward could agree which had been the mistake. The road remembers the counting. It does not remember the name it could not find.",
    ["story.the_last_repair"] = "THE LAST REPAIR",
    ["story.windmill_copse"] = "Windmill Copse",
    ["story.the_mill_was_still_turning_when"] = "The mill was still turning when the last cart left. That was deliberate. A man named Ol' Wren stayed behind to keep it turning, so anyone still walking would have something to steer by. He is not in the arrival rolls at Emberhollow. The sails turned eleven more days. Pip has never been told.",
    ["story.the_lost_crossing"] = "THE LOST CROSSING",
    ["story.tangle_bridge"] = "Tangle Bridge",
    ["story.the_bridge_went_down_under_the"] = "The bridge went down under the third cart, not the first. Tomas Reed was quartermaster that night, and he had loaded the heavy stores last so the families could cross first. He has never once told that story as a thing he got right.",
    ["story.the_house_that_answered"] = "THE HOUSE THAT ANSWERED",
    ["story.reedstead_ruin"] = "Reedstead Ruin",
    ["story.this_house_kept_answering_its_door"] = "This house kept answering its door for two winters after nobody lived in it. Not haunted -- remembered. The Long Night does not only take. Sometimes it holds a habit so tightly that the habit goes on without the person.",
    ["story.what_the_moths_carry"] = "WHAT THE MOTHS CARRY",
    ["story.light_moths_carry_a_little_of"] = "Light-moths carry a little of whatever light they hatched from. These hatched from evacuation lanterns. Follow enough of them and you are walking the road as it was walked, at the pace it was walked, behind people who are no longer there.",
    ["story.the_keeper_came_through"] = "THE KEEPER CAME THROUGH",
    ["story.sapglass_grove"] = "Sapglass Grove",
    ["story.he_tapped_these_trees_and_left"] = "He tapped these trees and left the vials full, which is not what a thief does. The sap in them has gone to glass, and inside the glass is light that does not flicker. Orin Vale was testing whether a memory could be held outside a lantern. It can. That is the frightening part.",
    ["story.what_orin_said_at_the_seal"] = "WHAT ORIN SAID AT THE SEAL",
    ["story.i_am_not_stealing_them_he"] = "I am not stealing them, he said. I am letting them out. The chapel heard it and kept it, the way roots keep everything. The machine has been eating what people could not carry -- seven towns' worth of grief, filed where nobody has to feel it. I have felt it, he said. Somebody had to.",
    ["story.the_eighth_seal"] = "THE EIGHTH SEAL",
    ["story.the_warden_s_seal"] = "The Warden's Seal",
    ["story.he_woke_the_stag_on_purpose"] = "He woke the Stag on purpose -- not to guard the seal against you, but to guard it for you, until someone arrived who would open it slowly. The eighth was never his to take. It answers to whoever chooses to carry it. You picked it up on the first morning without being asked, and it has been answering ever since.",
    ["story.a_bell_far_under"] = "A BELL, FAR UNDER",
    ["story.there_is_a_bell_ringing_under"] = "There is a bell ringing under Ironroot Delve. Nobody is pulling it. The shift-bell rang three times a day for forty years, and the crews who answered it were owed wages Emberhollow never paid; now it rings on time in an empty shaft. Orin went that way. He is walking one town's debt at a time, and the next question waiting for you is what a town owes the people whose labour built it. Bring an answer.",
    ["story.the_last_shift"] = "THE LAST SHIFT",
    ["story.the_wall_still_shows_a_shift"] = "The wall still shows a shift that went down and did not come up, and somebody kept chalking it forward. The names are in a steady hand for the first month and a shaking one after.",
    ["story.what_the_air_took"] = "WHAT THE AIR TOOK",
    ["story.they_kept_birds_because_a_bird"] = "They kept birds because a bird stops singing before a person stops standing. The cage came out crushed and empty, and somebody carried it all the way up rather than leave it.",
    ["story.the_last_crossing"] = "THE LAST CROSSING",
    ["story.the_ferryman_s_tally_runs_to"] = "The ferryman's tally runs to the day the water rose and then stops mid-column. He did not stop counting because he left. He stopped because there was nobody on the far bank to count.",
    ["story.what_looked_back"] = "WHAT LOOKED BACK",
    ["story.the_still_pool"] = "The Still Pool",
    ["story.every_account_of_this_water_agrees"] = "Every account of this water agrees on one detail and disagrees on everything else: whatever you see in it is doing what you are doing, a half-second late.",
    ["story.the_signal_book"] = "THE SIGNAL BOOK",
    ["story.lighthouse_stump"] = "Lighthouse Stump",
    ["story.the_tower_is_a_stump_and"] = "The tower is a stump and the lamp is gone, but the log survived: every light shown from this coast for sixty years. The last was for a ship already down, shown all night anyway.",
    ["story.where_the_big_boats_went"] = "WHERE THE BIG BOATS WENT",
    ["story.anchors_from_boats_too_big_for"] = "Anchors from boats too big for this water now, laid out in rows. Somebody cut the year beside each one, and the years stop within a season of each other.",
    ["story.who_cut_the_rope"] = "WHO CUT THE ROPE",
    ["story.bell_without_a_rope"] = "Bell Without a Rope",
    ["story.the_abbey_rang_for_anyone_still"] = "The abbey rang for anyone still alive in the valley. Somebody decided that calling the living was also calling the other thing, and went round every bell with a knife.",
    ["story.the_fire_they_kept"] = "THE FIRE THEY KEPT",
    ["story.the_cold_hearth"] = "The Cold Hearth",
    ["story.the_great_fire_was_tended_in"] = "The great fire was tended in shifts for nine years without going out. The wood beside it is still stacked and still dry, which means it did not go out for want of anyone trying.",
    ["story.the_last_ovation"] = "THE LAST OVATION",
    ["story.the_last_ovation_2"] = "The Last Ovation",
    ["story.they_were_watching_something_right_up"] = "They were watching something right up until the end, and every one of them is turned the same way. Whatever it was, it was worth not running from.",
    ["story.the_name_wall"] = "The Name Wall",
    ["story.official_names_cut_deep_and_formal"] = "Official names cut deep and formal, and under each one, small and scratched, the name the person actually went by. Somebody came back with a nail and corrected the whole wall.",
    ["story.the_last_street"] = "The Last Street",
    ["story.emberhollow_exactly_down_to_the_crack"] = "Emberhollow, exactly, down to the crack in the board outside the inn. Nobody has ever lived here and every lamp is lit.",
    ["story.the_three_posts"] = "The Three Posts",
    ["story.gate_road_and_hearth_and_not"] = "Gate, road and hearth, and not enough of you to stand at all three. Whichever one is empty is the one it comes through.",
    ["story.not_a_stair_and_not_a"] = "Not a stair and not a shaft. The road simply keeps going after the ground has stopped, and the lamps go with it.",
    ["story.the_held_light"] = "The Held Light",
    ["story.two_people_down_here_and_light"] = "Two people down here and light enough to bring out one. Both of them have worked out the arithmetic already.",
    ["story.the_first_lantern"] = "The First Lantern",
    ["story.the_one_every_other_lantern_was"] = "The one every other lantern was lit from, still burning, with nothing feeding it that anyone can see.",
    ["story.the_long_record"] = "The Long Record",
    ["story.names_in_one_hand_going_back"] = "Names, in one hand, going back further than the town does. The last page is this year and it is not finished.",
    ["story.a_chair_at_the_bottom_of"] = "A chair at the bottom of the light, facing up the way you came. Whatever has been sitting in it stands when you arrive.",
    ["story.the_last_street_2"] = "THE LAST STREET",
    ["story.hold_two_posts_the_third_is"] = "HOLD TWO POSTS — THE THIRD IS GOING TO FALL",
    ["story.it_is_walking_into_a_copy"] = "It is walking into a copy of your town, and you cannot stand everywhere at once.",
    ["story.the_way_down"] = "THE WAY DOWN",
    ["story.follow_it_down_every_mark_costs"] = "FOLLOW IT DOWN — EVERY MARK COSTS LIGHT",
    ["story.it_does_not_run_it_withdraws"] = "It does not run. It withdraws, at exactly the speed you are willing to spend light following it.",
    ["story.the_held_light_2"] = "THE HELD LIGHT",
    ["story.neither_of_them_will_ask_you"] = "Neither of them will ask you to pick them. That is the worst part of it.",
    ["story.look_at_all_of_it_before"] = "LOOK AT ALL OF IT BEFORE YOU DECIDE ANYTHING",
    ["story.nothing_here_attacks_this_is_the"] = "Nothing here attacks. This is the game explaining itself, and it takes as long as a player wants it to.",
    ["story.the_seat"] = "THE SEAT",
    ["story.three_things_can_be_done_and"] = "Three things can be done and none of them undoes what is already gone.",
    ["story.the_light_stays_where_it_is"] = "The light stays where it is and keeps being fed. Emberhollow survives every night it has left, and somebody is always down here.",
    ["story.the_light_goes_out_and_the"] = "The light goes out and the nights stop being hunted. So does every lantern above it, and the town has to learn the dark.",
    ["story.the_light_is_broken_up_and"] = "The light is broken up and carried out a piece at a time. No lantern town any more, and no single thing left to sit at the bottom of it.",
    ["expedition.standard_sweep"] = "STANDARD SWEEP",
    ["expedition.the_woods_as_they_are_even"] = "The woods as they are. Even trade.",
    ["expedition.quiet_roads"] = "QUIET ROADS",
